---
// src/pages/flotacion/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
---

<BaseLayout 
  title="Mecanismos para Celdas de Flotación y Acondicionadores | SMAT Minerals"
  description="Mecanismos para celdas de flotación, acondicionadores de pulpa, cabezales motrices, flechas, rotores y estatores."
  lang="es"
>
  <section class="page-hero">
    <div class="container">
      <span class="badge badge-copper">FLOTACIÓN Y ACONDICIONAMIENTO</span>
      <h1>Mecanismos para Celdas de Flotación y Acondicionadores</h1>
      <p style="font-size: 1.08rem; max-width: 720px; color: var(--smat-text-secondary);">
        Mecanismos completos de agitación, acondicionadores de pulpa, cabezales de transmisión, tubos de aire y conjuntos rotor-estator en hule y poliuretano.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="flotation" lang="es" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div class="card">
          <h3>Mecanismos para Celdas de Flotación y Acondicionadores</h3>
          <p>
            Conjuntos motrices completos (cabezal porta-rodamientos vertical, polea, columna de aire concéntrica y flecha) para bancos de flotación Rougher, Cleaner y Scavenger, así como mecanismos para tanques acondicionadores de reactivos.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Capacidad:</strong> 50 ft³ a 300 ft³</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/flotacion/celdas/" class="btn btn-outline">Ficha Técnica</a>
            <a href="/#rfq?equipo=celda_flotacion" class="btn btn-primary">Cotizar →</a>
          </div>
        </div>

        <div class="card">
          <h3>Rotores, Estatores, Propelas y Flechas</h3>
          <p>
            Impulsores/rotores, difusores/estatores y propelas de acondicionador recubiertos en hule natural moldeado o poliuretano para resistir la abrasión de la pulpa mineral y mantener la dispersión de aire.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Material:</strong> Hule y Poliuretano</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/flotacion/mecanismos/" class="btn btn-outline">Ficha Técnica</a>
            <a href="/#rfq?equipo=rotor_estator" class="btn btn-primary">Cotizar →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="background: #f8fafc; border: 1px solid var(--smat-border-strong); padding: 2.25rem; text-align: center;">
        <h2 style="margin-bottom: 0.6rem;">Solicitar Cotización de Mecanismos o Acondicionadores</h2>
        <p style="max-width: 600px; margin: 0 auto 1.25rem; color: var(--smat-text-secondary);">
          Indique el volumen de su celda o tanque acondicionador y las piezas que requiere cotizar.
        </p>
        <a href="/#rfq?equipo=celda_flotacion" class="btn btn-primary">Solicitar Cotización →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 3rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.65rem; }
</style>
