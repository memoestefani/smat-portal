---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlotationCalculatorIsland from '../../components/islands/FlotationCalculatorIsland.astro';

const title = 'Mecanismos para Celdas de Flotación y Acondicionadores | SMAT Minerals';
const description = 'Mecanismos para celdas de flotación, acondicionadores de pulpa, cabezales motrices, flechas, rotores y estatores.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/flotacion/"
  alternateEsPath="/flotacion/"
  alternateEnPath="/en/flotation/"
>
  <FlotationCalculatorIsland locale="es" variant="hub" mode="standalone" />
</BaseLayout>
