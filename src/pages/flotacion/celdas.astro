---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlotationCalculatorIsland from '../../components/islands/FlotationCalculatorIsland.astro';

const title = 'Mecanismos para Celdas de Flotación y Acondicionadores (50 a 300 ft³) | SMAT Minerals';
const description = 'Mecanismos para celdas de flotación y acondicionadores (50 a 300 ft³) para circuitos Rougher, Cleaner y Scavenger. Durango, México.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/flotacion/celdas/"
  alternateEsPath="/flotacion/celdas/"
  alternateEnPath="/en/flotation/cells/"
>
  <FlotationCalculatorIsland locale="es" variant="cells" mode="standalone" />
</BaseLayout>
