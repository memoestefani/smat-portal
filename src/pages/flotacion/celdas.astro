---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import rolesData from '../../../data/roles.json';

const flotVertical = rolesData.verticals.find((v) => v.id === 'flotacion');
const celdaRole = flotVertical?.capex?.find((r) => r.role_id === 'celda_completa');
const criteria = celdaRole?.decision_criteria;
---

<BaseLayout 
  title="Mecanismos para Celdas de Flotación y Acondicionadores (50 a 300 ft³) | SMAT Minerals"
  description="Mecanismos para celdas de flotación y acondicionadores (50 a 300 ft³) para circuitos Rougher, Cleaner y Scavenger. Durango, México."
  lang="es"
  canonicalPath="/flotacion/celdas/"
  alternateEsPath="/flotacion/celdas/"
  alternateEnPath="/en/flotation/cells/"
>
  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-opex">[PRESUPUESTO OPERATIVO: MECANISMOS SUSPENDIDOS Y RETROFIT DROP-IN • 50 A 300 FT³]</span>
      <h1>Mecanismos para Celdas de Flotación y Acondicionadores</h1>
      <p class="subtitle">Conjuntos de transmisión, eje hueco, tubo de tiro e impulsor-difusor para celdas de 50 a 300 ft³ (1.4 a 8.5 m³) y tanques acondicionadores sin demoler tanques ni obra civil.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <div style="margin-bottom: 1.75rem;">
          <TechnicalDiagrams type="flotation" lang="es" />
        </div>
        <h2>Ingeniería de Dispersión de Aire y Suspensión de Pulpa</h2>
        <p>
          Los mecanismos para celdas de flotación y acondicionadores SMAT Minerals están diseñados para maximizar el contacto partícula-burbuja y mantener en suspensión los sólidos gruesos sin zonas muertas en el fondo del tanque.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Parámetro de Operación</th>
              <th>Especificación Técnica SMAT</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Rango de Capacidad de Celda</td>
              <td>50 ft³ (1.4 m³), 100 ft³ (2.8 m³), 200 ft³ (5.6 m³), 300 ft³ (8.5 m³)</td>
            </tr>
            <tr>
              <td>Configuración de Circuitos</td>
              <td>Acondicionamiento de reactivos, desbaste (Rougher), limpieza (Cleaner) y barrido (Scavenger)</td>
            </tr>
            <tr>
              <td>Tipo de Aireación</td>
              <td>Auto-aspirante o asistida por aire de baja presión con dispersión radial uniforme</td>
            </tr>
            <tr>
              <td>Componentes del Mecanismo</td>
              <td>Cabezal de rodamientos, poleas, eje hueco bridado, tubo de tiro, impulsor y difusor</td>
            </tr>
            <tr>
              <td>Materiales en Contacto Húmedo</td>
              <td>Poliuretano moldeado y Hule Natural resistente a colectores y espumantes</td>
            </tr>
            <tr>
              <td>Rango de Potencia y Capacidad Nominal</td>
              <td>{celdaRole?.power_range || '15 HP a 60 HP por mecanismo'} • {celdaRole?.flow_range || 'Circuitos de 200 a 1,500 t/d'}</td>
            </tr>
            <tr>
              <td>Cinética de Flotación JKMRC (Gorain 1997)</td>
              <td>Flujo Superficial de Burbuja S<sub>b</sub> = 6 J<sub>g</sub> / d<sub>32</sub> (50–65 s<sup>-1</sup>) con constante cinética k = P · S<sub>b</sub> · R<sub>f</sub></td>
            </tr>
            <tr>
              <td>Modelos #18 SP, #24 y #30 (Candado G4)</td>
              <td>Reemplazo Drop-In en 5 zonas (#01 Cabezal, #02 Eje Hueco, #03 Tubo de Tiro, #04 Rotor Estrella, #05 Difusor/Estator) con línea base Anti-Morita [I<sub>motor</sub>, u<sub>rotor</sub>, S<sub>b</sub> ≥ 50 s<sup>-1</sup>]</td>
            </tr>
          </tbody>
        </table>

        <!-- Reporte de Despiece en 5 Zonas (#18 SP / #24 / #30) y Válvulas Avenida 4 -->
        <div class="flotation-5zone-box" data-cell-dropin-matrix="gorain-1997" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #f8fafc; color: var(--smat-text-primary); border: 1px solid #cbd5e1; border-left: 4px solid #7c2d12;">
          <span class="badge badge-copper">PLANO 3 · DESPIECE EN 5 ZONAS (#18 SP, #24, #30) Y VÁLVULAS DE LODOS (AVENIDA 4)</span>
          <h3 style="margin: 0.65rem 0 0.5rem; font-size: 1.08rem; color: var(--smat-text-primary);">Reemplazo Drop-In Sin Modificar Tanque ni Cabezal Existente (Anti-Morita)</h3>
          <p style="font-size: 0.88rem; color: #334155; margin-bottom: 0.85rem;">
            Cada kit rotor-estator SMAT preserva el número de bombeo de aire N<sub>Q</sub> (0.22–0.26) y el flujo superficial de burbuja S<sub>b</sub> = 6 J<sub>g</sub> / d<sub>32</sub> ≥ 50 s<sup>-1</sup> (Gorain 1997 · <code>evaluateFlotationCellHydrodynamics</code>), verificando amperaje I<sub>motor</sub> y velocidad periférica v<sub>tip</sub> (6.0–7.5 m/s) antes y después del montaje.
          </p>
          <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
            <a href="/productos/mecanismo-suspendido-flotacion-18sp/" class="btn btn-outline" style="font-size:0.8rem;">SMAT-FLOT-MECH-18SP · Mecanismo Suspendido (#18 SP, #24, #30) →</a>
            <a href="/productos/mecanismo-suspendido-flotacion-18sp/" class="btn btn-outline" style="font-size:0.8rem;">SMAT-FLOT-MECH-18SP · Kit Rotor + Estator (#18 SP) →</a>
          </div>
        </div>

        {criteria && (
          <div class="decision-criteria-panel" data-testid="role-decision-criteria" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid #9a3412;">
            <span class="badge badge-copper">CRITERIOS DE DECISIÓN METALÚRGICA • ROLES.JSON</span>
            <h3 style="margin: 0.45rem 0 0.75rem; font-size: 1.08rem; color: var(--smat-text-primary);">Matriz de Selección de Mecanismo y Acondicionador ({celdaRole?.series})</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem; font-size: 0.88rem;">
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: var(--smat-text-primary); margin-bottom: 0.25rem;">Variables de Pulpa Requeridas</strong>
                <span style="color: #334155;">{criteria.required_slurry_vars_es}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #7c2d12; margin-bottom: 0.25rem;">Regla de Mecanismo y Elastómero Drop-In</strong>
                <span style="color: #334155;">{criteria.metallurgy_rule_es}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #14532d; margin-bottom: 0.25rem;">Riesgo Operativo Mitigado</strong>
                <span style="color: #334155;">{criteria.risk_avoided_es}</span>
              </div>
            </div>
          </div>
        )}

        <div class="flotation-selector-box" data-testid="flotation-contextual-selector" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #fffbeb; border: 1px solid #fde68a;">
          <span class="badge badge-copper">PRE-SELECCIÓN CONTEXTUAL • PUENTE A COTIZADOR</span>
          <h3 style="margin: 0.45rem 0 0.5rem; font-size: 1.05rem; color: var(--smat-text-primary);">Seleccione Volumen de Celda y Condición Operativa</h3>
          <p style="font-size: 0.88rem; color: #475569; margin-bottom: 0.85rem;">
            Pre-cargue directamente la capacidad de celda (50 a 300 ft³) y el régimen químico/abrasivo en la mesa de trabajo RFQ:
          </p>
          <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
            <a href="/cotizar/?circuito=flotacion&equipo=celda_flotacion&serie=50ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">50 ft³ (1.4 m³) • Sulfuros</a>
            <a href="/cotizar/?circuito=flotacion&equipo=celda_flotacion&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">100 ft³ (2.8 m³) • Sulfuros</a>
            <a href="/cotizar/?circuito=flotacion&equipo=celda_flotacion&serie=200ft&flot_condition=reactivos_espuma#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">200 ft³ (5.6 m³) • Reactivos / Espuma</a>
            <a href="/cotizar/?circuito=flotacion&equipo=celda_flotacion&serie=300ft&flot_condition=arena_gruesa_fondo#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">300 ft³ (8.5 m³) • Arena Gruesa Fondo</a>
          </div>
        </div>

        <SharePurchasing 
          roleTitle="Mecanismo para Celda de Flotación y Acondicionador"
          series="Capacidades de 50 a 300 ft³ (1.4 a 8.5 m³)"
          metallurgy="Flecha Central Acero 4140, Impulsor y Difusor en Poliuretano 85–95 Shore A / Hule R55 (Sin Obra Civil)"
          specs="Mecanismo suspendido completo con cabezal de rodamientos, eje de aireación, tubo de tiro e impulsor-difusor."
          roleId="celda_flotacion"
          circuit="flotacion"
          lang="es"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">ATENCIÓN TÉCNICA EN DURANGO</span>
            <h3>¿Requiere mecanismos para celdas de flotación o acondicionadores?</h3>
            <p>Solicite su cotización indicando capacidad de celda (ft³) o dimensiones del tanque acondicionador.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/cotizar/?circuito=flotacion&equipo=celda_flotacion&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-primary btn-lg">
              Solicitar Cotización →
            </a>
            <a href="https://wa.me/526183670664?text=Hola%20SMAT%20Minerals,%20requiero%20cotizar%20Mecanismos%20para%20Celdas%20de%20Flotaci%C3%B3n%20y%20Acondicionadores" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              Cotizar por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #1e293b;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #1e293b;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--smat-copper-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #1e293b;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #1e293b;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
