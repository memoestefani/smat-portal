---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import rolesData from '../../../data/roles.json';

const flotVertical = rolesData.verticals.find((v) => v.id === 'flotacion');
const mecRole = flotVertical?.opex?.find((r) => r.role_id === 'mecanismos_flotacion');
const criteria = mecRole?.decision_criteria;
---

<BaseLayout 
  title="Impulsores, Difusores y Repuestos de Flotación | SMAT Minerals"
  description="Impulsores, difusores y ejes revestidos en poliuretano moldeado y hule vulcanizado para mecanismos de celdas de flotación y acondicionadores en Durango."
  lang="es"
  canonicalPath="/flotacion/mecanismos/"
  alternateEsPath="/flotacion/mecanismos/"
  alternateEnPath="/en/flotation/mechanisms/"
>
  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">REFACCIONES DE FLOTACIÓN • POLIURETANO Y HULE</span>
      <h1>Impulsores y Difusores de Flotación</h1>
      <p class="subtitle">Repuestos en poliuretano y hule para mecanismos de celdas de flotación y acondicionadores.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <div style="margin-bottom: 1.75rem;">
          <TechnicalDiagrams type="flotation" lang="es" />
        </div>
        <h2>Geometría de Impulsor y Difusor</h2>
        <p>
          El desgaste en las aristas del impulsor y difusor aumenta el diámetro de burbuja y reduce la recuperación de concentrado. SMAT Minerals suministra repuestos con alma metálica y recubrimiento en poliuretano o hule resistente a reactivos.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Característica</th>
              <th>Especificación SMAT</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Geometría de Impulsor</td>
              <td>Álabes de dispersión con ángulo de corte hidrodinámico para generación de micro-burbujas</td>
            </tr>
            <tr>
              <td>Difusor / Estator</td>
              <td>Campana difusora con placas radiales estabilizadoras de turbulencia</td>
            </tr>
            <tr>
              <td>Recubrimientos</td>
              <td>Poliuretano moldeado o Hule Natural de 60-65 Shore A</td>
            </tr>
            <tr>
              <td>Compatibilidad</td>
              <td>Intercambiabilidad dimensional para mecanismos de celdas de 50 a 300 ft³ y acondicionadores</td>
            </tr>
            <tr>
              <td>Invariante Cinético de Cizalladura (S<sub>b</sub>)</td>
              <td>Mantiene radio de corte hidrodinámico para S<sub>b</sub> = 6 J<sub>g</sub> / d<sub>32</sub> ≥ 55 s<sup>-1</sup> sin colapso de micro-burbuja</td>
            </tr>
          </tbody>
        </table>

        {criteria && (
          <div class="decision-criteria-panel" data-testid="role-decision-criteria" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid #9a3412;">
            <span class="badge badge-copper">CRITERIOS DE DECISIÓN METALÚRGICA • ROLES.JSON</span>
            <h3 style="margin: 0.45rem 0 0.75rem; font-size: 1.08rem; color: var(--smat-text-primary);">Matriz de Selección de Rotor, Estator y Flecha ({mecRole?.series})</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem; font-size: 0.88rem;">
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: var(--smat-text-primary); margin-bottom: 0.25rem;">Variables de Operación Requeridas</strong>
                <span style="color: #334155;">{criteria.required_slurry_vars_es}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #7c2d12; margin-bottom: 0.25rem;">Regla de Elastómero y Eje</strong>
                <span style="color: #334155;">{criteria.metallurgy_rule_es}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #14532d; margin-bottom: 0.25rem;">Riesgo Metalúrgico Mitigado</strong>
                <span style="color: #334155;">{criteria.risk_avoided_es}</span>
              </div>
            </div>
          </div>
        )}

        <div class="flotation-selector-box" data-testid="flotation-contextual-selector" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #fffbeb; border: 1px solid #fde68a;">
          <span class="badge badge-copper">PRE-SELECCIÓN CONTEXTUAL • PUENTE A COTIZADOR</span>
          <h3 style="margin: 0.45rem 0 0.5rem; font-size: 1.05rem; color: var(--smat-text-primary);">Cotizar Rotor / Estator por Capacidad y Condición</h3>
          <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.65rem;">
            <a href="/cotizar/?circuito=flotacion&equipo=rotor_estator&serie=50ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Rotor/Estator 50 ft³ • Sulfuros</a>
            <a href="/cotizar/?circuito=flotacion&equipo=rotor_estator&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Rotor/Estator 100 ft³ • Sulfuros</a>
            <a href="/cotizar/?circuito=flotacion&equipo=rotor_estator&serie=200ft&flot_condition=reactivos_espuma#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Rotor/Estator 200 ft³ • Reactivos</a>
            <a href="/cotizar/?circuito=flotacion&equipo=rotor_estator&serie=300ft&flot_condition=arena_gruesa_fondo#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Rotor/Estator 300 ft³ • Arena Gruesa</a>
          </div>
        </div>

        <SharePurchasing 
          roleTitle="Impulsor y Difusor de Celda de Flotación"
          series="Compatibilidad con celdas de 50 a 300 ft³"
          metallurgy="Poliuretano Resistente a Reactivos de Flotación / Hule Natural"
          specs="Impulsor y difusor con alma de acero y recubrimiento resistente a la abrasión de pulpa y ataque químico de colectores."
          roleId="rotor_estator"
          circuit="flotacion"
          lang="es"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">ATENCIÓN TÉCNICA EN DURANGO</span>
            <h3>¿Requiere impulsores, difusores o ejes para sus celdas de flotación?</h3>
            <p>Solicite su cotización indicando capacidad de celda o modelo de mecanismo.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/cotizar/?circuito=flotacion&equipo=rotor_estator&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-primary btn-lg">
              Solicitar Cotización →
            </a>
            <a href="https://wa.me/526183670664?text=Hola%20SMAT%20Minerals,%20requiero%20cotizar%20Impulsor%20y%20Difusor%20de%20Flotaci%C3%B3n" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              Cotizar por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--smat-copper-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
