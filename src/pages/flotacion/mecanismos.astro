---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
---

<BaseLayout 
  title="Rotores, Estatores y Mecanismos de Flotación | SMAT Minerals"
  description="Refaccionamiento de rotores y estatores revestidos en poliuretano moldeado y caucho vulcanizado para celdas de flotación desde Almacén Durango."
  lang="es"
  canonicalPath="/flotacion/mecanismos/"
  alternateEsPath="/flotacion/mecanismos/"
  alternateEnPath="/en/flotation/mechanisms/"
>
  <Header slot="header" lang="es" currentPath="/flotacion/mecanismos/" alternatePath="/en/flotation/mechanisms/" />

  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">OPEX • STOCK EN ALMACÉN DURANGO</span>
      <h1>Rotores y Estatores de Flotación</h1>
      <p class="subtitle">Mecanismos suspendidos de repuesto de alta durabilidad para mantener la cinética de recuperación de concentrado.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <h2>Restauración Cinética del Borde del Rotor</h2>
        <p>
          El redondeo por abrasión en las aristas de dispersión del rotor produce un agrandamiento del tamaño medio de burbuja y un colapso en la tasa de recuperación de flotación. SMAT Minerals suministra repuestos con insertos de alma de acero balanceados y revestimiento en poliuretano de alta resiliencia química y mecánica.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Característica</th>
              <th>Especificación SMAT</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Geometría de Rotor</td>
              <td>Dedos y álabes de vórtice con ángulo de cizallamiento hidrodinámico optimizado</td>
            </tr>
            <tr>
              <td>Estator / Difusor</td>
              <td>Campana estatora con placas estabilizadoras de turbulencia para zona quieta de espumas</td>
            </tr>
            <tr>
              <td>Revestimientos</td>
              <td>Poliuretano moldeado por inyección o Caucho Natural de 60-65 Shore A</td>
            </tr>
            <tr>
              <td>Compatibilidad</td>
              <td>Intercambiabilidad dimensional con mecanismos de celdas estándar de 50 a 300 ft³</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Rotor y Estator de Celda de Flotación"
          series="Compatibilidad con celdas de 50 a 300 ft³"
          metallurgy="Poliuretano Resistente a Reactivos de Flotación / Caucho Natural"
          specs="Rotor y estator equilibrados dinámicamente con alta resistencia al corte de pulpa y ataque químico de colectores."
          lang="es"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">DESPACHO INMEDIATO DESDE DURANGO</span>
            <h3>¿Requiere rotores, estatores o conos difusores de reemplazo?</h3>
            <p>Emita de inmediato su requisición técnica formal con balanceo dinámico e inserto de poliuretano.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/?equipo=rotor_estator#rfq" class="btn btn-primary btn-lg">
              Cotizar Mecanismo de Flotación en Consola Central →
            </a>
            <a href="https://wa.me/526183670664?text=Hola%20SMAT%20Minerals,%20requiero%20cotizar%20Rotor%20y%20Estator%20de%20Flotaci%C3%B3n" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              Consultar Stock en Almacén por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton lang="es" />
  <Footer slot="footer" lang="es" />
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
