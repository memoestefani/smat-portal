---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlotationCalculatorIsland from '../../components/islands/FlotationCalculatorIsland.astro';

const title = 'Impulsores, Difusores y Repuestos de Flotación | SMAT Minerals';
const description = 'Impulsores, difusores y ejes revestidos en poliuretano moldeado y hule vulcanizado para mecanismos de celdas de flotación y acondicionadores en Durango.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/flotacion/mecanismos/"
  alternateEsPath="/flotacion/mecanismos/"
  alternateEnPath="/en/flotation/mechanisms/"
>
  <FlotationCalculatorIsland locale="es" variant="mechanisms" mode="standalone" />
</BaseLayout>
