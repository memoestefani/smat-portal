---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EquipmentHubIsland from '../../components/islands/EquipmentHubIsland.astro';

const title = 'Equipos de Proceso para Plantas de Beneficio | SMAT Minerals';
const description = 'Suministro de Equipos de Proceso para proyectos, ampliaciones y modernización de circuitos: Mecanismos para Celdas de Flotación y Acondicionadores (50 a 300 ft³), Filtros Prensa (800 a 1500 mm, 16 bar) y Bombas Completas para Lodos.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/equipos/"
  alternateEsPath="/equipos/"
  alternateEnPath="/en/process-equipment/"
>
  <EquipmentHubIsland locale="es" />
</BaseLayout>
