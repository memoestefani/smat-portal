---
// src/pages/en/catalog/[code].astro
// Decisión 4-B: Atomic Universal Spare Part Technical Sheet with Anti-Scraping Guard
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import atomicParts from '../../../../data/atomic_parts.json';

export function getStaticPaths() {
  return atomicParts.map((part) => ({
    params: { code: part.code },
    props: { part }
  }));
}

const { part } = Astro.props;
const siteUrl = 'https://smatminerals.com';
const canonicalPath = `/en/catalog/${part.code}/`;
const alternateEsPath = `/catalogo/${part.code}/`;

const title = `${part.part_number} — ${part.name_en} | SMAT Minerals`;
const description = `Spare part ${part.part_number}: ${part.type_en} for ${part.frame} frame in ${part.metallurgy} alloy with ${part.hardness} hardness. Verified direct dispatch from Durango Central Warehouse.`;

const waText = encodeURIComponent(`Hello SMAT Minerals, I require quotation and stock availability at Durango Central Warehouse for part ${part.part_number} (Frame ${part.frame}).`);
const waUrl = `https://wa.me/526183670664?text=${waText}`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${part.part_number} — ${part.name_en}`,
  "image": `${siteUrl}/images/og-card.jpg`,
  "description": part.summary_en,
  "sku": part.part_number,
  "mpn": part.part_number,
  "brand": {
    "@type": "Brand",
    "name": "SMAT Minerals"
  },
  "material": part.metallurgy,
  "offers": {
    "@type": "Offer",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "name": "SMAT Minerals",
      "url": siteUrl
    }
  }
};
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath={canonicalPath}
  alternateEsPath={alternateEsPath}
  alternateEnPath={canonicalPath}
>
  <Header slot="header" lang="en" currentPath={canonicalPath} alternatePath={alternateEsPath} />

  <main class="part-page-main">
    <div class="container">
      
      <!-- B2B Breadcrumb Navigation -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumbs">
        <a href="/en/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/en/catalog/">Catalog</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{part.part_number}</span>
      </nav>

      <div class="part-layout-grid">
        <!-- Left Column: Formal Technical Specification -->
        <article class="part-spec-card">
          <div class="spec-header">
            <span class="part-badge">UNIVERSAL STANDARD SPARE</span>
            <h1 class="part-title">{part.part_number}</h1>
            <p class="part-subtitle">{part.name_en}</p>
          </div>

          <div class="spec-body">
            <p class="part-lead">{part.summary_en}</p>

            <h2 class="section-title">Metallurgical Specifications & Dimensional Interchangeability</h2>
            <div class="table-responsive">
              <table class="spec-table">
                <tbody>
                  <tr>
                    <th>Universal Code:</th>
                    <td><strong>{part.part_number}</strong></td>
                  </tr>
                  <tr>
                    <th>Compatible Frame:</th>
                    <td>Slurry pump frame {part.frame}</td>
                  </tr>
                  <tr>
                    <th>Component Type:</th>
                    <td>{part.type_en}</td>
                  </tr>
                  <tr>
                    <th>Metallurgy:</th>
                    <td>{part.metallurgy}</td>
                  </tr>
                  <tr>
                    <th>Verified Hardness:</th>
                    <td><span class="hardness-badge">{part.hardness}</span></td>
                  </tr>
                  {part.vanes > 0 && (
                    <tr>
                      <th>Vane Geometry:</th>
                      <td>{part.vanes} closed vanes with dynamic expeller back vanes</td>
                    </tr>
                  )}
                  <tr>
                    <th>Critical Application:</th>
                    <td>{part.circuit_en}</td>
                  </tr>
                  <tr>
                    <th>Assembly Guarantee:</th>
                    <td>{part.fit_guarantee_en}</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Yard Verification Protocol in Durango -->
            <div class="assurance-block">
              <div class="assurance-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 11 12 14 22 4"/></svg>
              </div>
              <div class="assurance-text">
                <h3>1:1 Dimensional Fit & Dynamic Balance Assurance</h3>
                <p>
                  Every {part.part_number} unit is physically matched against standard frame dimensions before dispatch from our Durango Central Warehouse. We ensure 100% drop-in interchangeability with industry-standard frames. Should a standard replacement part fail to fit your pump casing, it is immediately swapped from our floor stock.
                </p>
              </div>
            </div>

            <!-- Anti-Scraping Confidentiality Notice -->
            <div class="anti-scraping-notice">
              <span class="notice-label">CONFIDENTIAL ENGINEERING NOTICE:</span>
              <p>
                Fine-tolerance manufacturing prints and complete internal dimensional matrices are kept off public tables to safeguard intellectual property. Detailed mechanical drawings and compliance dossiers are shared privately with authorized mine plant engineering and procurement teams.
              </p>
            </div>
          </div>
        </article>

        <!-- Right Column: Fast-Track Action Dock (WhatsApp & RFQ) -->
        <aside class="part-action-dock">
          <div class="action-card">
            <span class="dock-badge">IN-COUNTRY STOCK</span>
            <h3>Requisition for {part.part_number}</h3>
            <p class="dock-desc">
              Direct consultation with our engineering team in Durango, Mexico for prompt pricing, stock allocation, and direct carrier dispatch to your mine site.
            </p>

            <div class="dock-ctas">
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp-king">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                <span>Check Availability via WhatsApp</span>
              </a>

              <a href={`/en/#rfq?codigo=${part.part_number}&circuito=bombeo`} class="btn btn-rfq-wizard">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                <span>Generate Formal RFQ / A4 Slip</span>
              </a>
            </div>

            <div class="dock-facts">
              <div class="fact-item">
                <span class="fact-label">Distribution Hub:</span>
                <span class="fact-val">Durango, Dgo., Mexico</span>
              </div>
              <div class="fact-item">
                <span class="fact-label">Collection Method:</span>
                <span class="fact-val">Warehouse yard pickup or freight</span>
              </div>
              <div class="fact-item">
                <span class="fact-label">Tax Compliance:</span>
                <span class="fact-val">Local Mexican CFDI / OPEX billing</span>
              </div>
            </div>
          </div>
        </aside>
      </div>

    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <WhatsAppButton lang="en" />
  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .part-page-main {
    padding: 2.5rem 0 4.5rem;
    background-color: #f8fafc;
    min-height: 85vh;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #64748b;
    margin-bottom: 2rem;
  }

  .breadcrumb-nav a {
    color: #475569;
    text-decoration: none;
    font-weight: 500;
  }

  .breadcrumb-nav a:hover {
    color: var(--smat-copper-accent);
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: #cbd5e1;
  }

  .breadcrumb-current {
    color: #0f172a;
    font-weight: 700;
  }

  .part-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 992px) {
    .part-layout-grid {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
  }

  .part-spec-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  .part-badge {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    border-radius: 4px;
    color: var(--smat-copper-accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .part-title {
    font-family: var(--smat-font-editorial);
    font-size: 2.5rem;
    line-height: 1.1;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }

  .part-subtitle {
    font-size: 1.25rem;
    color: #475569;
    margin-bottom: 1.75rem;
    font-weight: 500;
  }

  .part-lead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #334155;
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1rem;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 0.5rem;
  }

  .table-responsive {
    overflow-x: auto;
    margin-bottom: 2rem;
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .spec-table th,
  .spec-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #f1f5f9;
    text-align: left;
  }

  .spec-table th {
    width: 32%;
    color: #64748b;
    font-weight: 600;
    background-color: #f8fafc;
  }

  .spec-table td {
    color: #1e293b;
  }

  .hardness-badge {
    display: inline-block;
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 700;
  }

  .assurance-block {
    display: flex;
    gap: 1.25rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--smat-copper-accent);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .assurance-icon {
    color: var(--smat-copper-accent);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .assurance-text h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }

  .assurance-text p {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.55;
    margin: 0;
  }

  .anti-scraping-notice {
    background: #fffbeb;
    border: 1px solid #fef3c7;
    border-radius: 8px;
    padding: 1.25rem;
    font-size: 0.85rem;
    color: #92400e;
    line-height: 1.5;
  }

  .notice-label {
    font-weight: 800;
    display: block;
    margin-bottom: 0.25rem;
  }

  .anti-scraping-notice p {
    margin: 0;
  }

  /* Right Dock */
  .part-action-dock {
    position: sticky;
    top: 2rem;
  }

  .action-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  }

  .dock-badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background: #dcfce7;
    border: 1px solid #bbf7d0;
    border-radius: 4px;
    color: #166534;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .action-card h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }

  .dock-desc {
    font-size: 0.9rem;
    color: #64748b;
    line-height: 1.5;
    margin-bottom: 1.75rem;
  }

  .dock-ctas {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.95rem 1.25rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
    text-align: center;
  }

  .btn-whatsapp-king {
    background: #0f172a;
    color: #ffffff;
    border: 1px solid #0f172a;
  }

  .btn-whatsapp-king:hover {
    background: var(--smat-copper-accent);
    border-color: var(--smat-copper-accent);
    color: #ffffff;
  }

  .btn-rfq-wizard {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }

  .btn-rfq-wizard:hover {
    border-color: #0f172a;
    background: #f8fafc;
  }

  .dock-facts {
    border-top: 1px solid #e2e8f0;
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .fact-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    color: #64748b;
  }

  .fact-val {
    font-weight: 600;
    color: #1e293b;
    text-align: right;
  }
</style>
