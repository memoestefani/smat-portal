---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductDetailIsland from '../../../components/islands/ProductDetailIsland.astro';
import atomicParts from '../../../../data/atomic_parts.json';
import { resolveParentSkuForAtomicCode } from '../../../scripts/quickProductsCatalog.js';

export function getStaticPaths() {
  return atomicParts.map((part) => ({
    params: { code: part.code },
    props: { part, routeSlug: part.code, altEsSlug: part.code },
  }));
}

const { part, routeSlug, altEsSlug } = Astro.props;
const parentSku = resolveParentSkuForAtomicCode(part.part_number || part.code);
const canonicalPath = `/en/catalog/${routeSlug || part.code}/`;
const title = `${part.part_number} — ${part.name_en} | SMAT Minerals`;
const description = `Spare part ${part.part_number}: ${part.type_en} in ${part.metallurgy} alloy (${part.hardness}). Direct dispatch from Durango Central Warehouse.`;
---

<BaseLayout title={title} description={description} lang="en" canonicalPath={canonicalPath} alternateEsPath={`/catalogo/${altEsSlug || part.code}/`} alternateEnPath={canonicalPath}>
  <ProductDetailIsland
    sku={parentSku}
    lang="en"
    canonicalSlug={routeSlug}
    atomicPart={part}
    primaryPhotoOverride={part.photo_webp}
  />
</BaseLayout>
