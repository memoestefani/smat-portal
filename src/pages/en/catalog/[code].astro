---
// src/pages/en/catalog/[code].astro
// Decisión 4-B: Atomic Universal Spare Part Technical Sheet with Anti-Scraping Guard
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../../scripts/workbenchBus.js';
import atomicParts from '../../../../data/atomic_parts.json';

export function getStaticPaths() {
  const basePaths = atomicParts.map((part) => ({
    params: { code: part.code },
    props: { part, routeSlug: part.code, altEsSlug: part.code }
  }));

  const findPart = (num: string) => atomicParts.find((p) => p.part_number === num) || atomicParts[0];
  const alloySuffixedCodes = [
    { code: 'd4147a05', part: findPart('E4147') },
    { code: 'd4083a05', part: findPart('E4083') },
    { code: 'd4110a05', part: { ...findPart('E4083'), name_es: 'Voluta Monolítica en Alto Cromo Cr27% (6x4" — A05)', name_en: 'Monolithic High-Chrome Volute Liner (6x4" — A05)' } },
    { code: 'd4041a05', part: findPart('E4132') },
    { code: 'd4018r55', part: findPart('D4018') },
    { code: 'd4032r55', part: findPart('E4132') },
    { code: 'd4028a05', part: findPart('D4028') },
    { code: 'd4029a05', part: findPart('D4029') },
    { code: 'd005m', part: findPart('DAM005') },
    { code: 'd3147-a05', part: findPart('D3147') },
    { code: 'd3147-r55', part: { ...findPart('D3147'), metallurgy: 'Anti-Abrasive Natural Rubber R55 Elastomer (55 Shore A)', hardness: '55 ± 5 Shore A (Rebound ≥ 70%)' } },
    { code: 'e4147-a05', part: findPart('E4147') },
    { code: 'e4147-r55', part: { ...findPart('E4147'), metallurgy: 'Anti-Abrasive Natural Rubber R55 Elastomer (55 Shore A)', hardness: '55 ± 5 Shore A (Rebound ≥ 70%)' } },
    { code: 'f6147-a05', part: findPart('F6147') },
    { code: 'dam028-a05', part: findPart('DAM028') },
    { code: 'eam028-a05', part: findPart('EAM028') },
    { code: 'e4083-a05', part: findPart('E4083') },
    { code: 'e4083-r55', part: { ...findPart('E4083'), metallurgy: 'Anti-Abrasive Natural Rubber R55 Elastomer (55 Shore A)', hardness: '55 ± 5 Shore A (Rebound ≥ 70%)' } }
  ];
  const descriptiveAliases = [
    { slugEs: 'impulsor-5-alabes', slugEn: '5-vane-impeller', part: findPart('E4147') },
    { slugEs: 'cuello-succion', slugEn: 'suction-throatbush', part: findPart('E4083') },
    { slugEs: 'voluta-revestimiento', slugEn: 'volute-liner', part: { ...findPart('E4083'), name_es: 'Revestimiento de Voluta Bipartida (6x4" — A05)', name_en: 'Split Volute Casing Liner (6x4" — A05)', type_es: 'Revestimiento de Voluta en Contacto Húmedo (Lote 5:5:4)', type_en: 'Wet-End Volute Liner (5:5:4 Lot)' } },
    { slugEs: 'expulsor-centrifugo', slugEn: 'centrifugal-expeller', part: findPart('EAM028') },
    { slugEs: 'cartucho-rodamientos', slugEn: 'bearing-assembly-cartridge', part: { ...findPart('DAM005'), name_es: 'Cartucho de Rodamientos Completo (Bearing Assembly 6x4")', name_en: 'Complete Bearing Assembly Cartridge (6x4")', type_es: 'Conjunto Motriz Ensamblado (Estación 01)', type_en: 'Complete Assembled Drive Cartridge (Station 01)' } },
    { slugEs: 'anillo-expulsor', slugEn: 'expeller-ring', part: findPart('D4029') },
    { slugEs: 'camisa-flecha', slugEn: 'shaft-sleeve', part: findPart('D075C21') },
    { slugEs: 'empaque-prensaestopa', slugEn: 'gland-packing', part: { ...findPart('D075C21'), name_es: 'Empaquetadura Trenzada PTFE/Grafito y Prensaestopa (6x4")', name_en: 'Braided PTFE/Graphite Gland Packing & Follower (6x4")', type_es: 'Sellado de Caja de Estopas (Estación 02)', type_en: 'Stuffing Box Gland Seal (Station 02)' } },
    { slugEs: 'flecha-principal', slugEn: 'main-shaft', part: { ...findPart('DAM005'), name_es: 'Flecha Principal en Acero SAE 4140 Rectificado (6x4")', name_en: 'Precision-Ground SAE 4140 Alloy Main Shaft (6x4")', type_es: 'Eje Motriz de Transmisión (Estación 01)', type_en: 'Main Drive Shaft (Station 01)' } },
    { slugEs: 'sellos-laberinto', slugEn: 'labyrinth-seals', part: { ...findPart('DAM005'), name_es: 'Sellos de Laberinto Purgantes y Deflectores en Inox (6x4")', name_en: 'Grease-Purged Stainless Labyrinth Seals & Flingers (6x4")', type_es: 'Protección Hermética de Cartucho ISO 281 (Estación 01)', type_en: 'ISO 281 Cartridge Hermetic Protection (Station 01)' } },
    { slugEs: 'plato-cubierta', slugEn: 'cover-plate-liner', part: findPart('D4018') },
    { slugEs: 'plato-marco', slugEn: 'frame-plate-liner', part: findPart('E4132') }
  ];

  const alloyPaths = alloySuffixedCodes.map((entry) => ({
    params: { code: entry.code },
    props: { part: entry.part, routeSlug: entry.code, altEsSlug: entry.code }
  }));

  const aliasPaths = descriptiveAliases.map((a) => ({
    params: { code: a.slugEn },
    props: { part: a.part, routeSlug: a.slugEn, altEsSlug: a.slugEs }
  }));

  return [...basePaths, ...alloyPaths, ...aliasPaths];
}

const { part, routeSlug, altEsSlug } = Astro.props;
const fullSpec: any = getAtomicPartSpecs(part.part_number, (part as any).pipe_size || '6x4') || part;
const sanitizeOemFrameText = (str: string) =>
  String(str || '')
    .replace(/4\/3\s*C/gi, '4x3')
    .replace(/6\/4\s*D/gi, '6x4')
    .replace(/8\/6\s*E/gi, '8x6')
    .replace(/\b[CDE][- ]frame\b/gi, 'standard frame');
const cleanNameEn = sanitizeOemFrameText(part.name_en);
const cleanSummaryEn = sanitizeOemFrameText(part.summary_en);
const cleanCircuitEn = sanitizeOemFrameText(part.circuit_en);
const pipeSizeUpper = String(fullSpec.pipe_size || '6x4').toUpperCase();
const nioshModeLabelEn = fullSpec.niosh_ergonomic_tier === 'MANUAL_1P_SAFE'
  ? `1-Operator Manual Safe (${fullSpec.niosh_handling_mode} • LI=${fullSpec.niosh_lifting_index_shaft})`
  : (fullSpec.niosh_ergonomic_tier === 'ASSISTED_SHAFT_MOUNT_2P'
    ? `2-Person Assisted Shaft Mount (${fullSpec.niosh_handling_mode} • LI=${fullSpec.niosh_lifting_index_shaft} vs RWL=${fullSpec.niosh_rwl_shaft_kg} kg)`
    : `Hoist / Crane Mandatory (${fullSpec.niosh_handling_mode} • LI=${fullSpec.niosh_lifting_index_shaft} ≥ 23 kg)`);
const rfqDeepLink = `/en/quote/?codigo=${part.part_number}&circuito=bombeo&equipo=${fullSpec.role || 'impulsor'}&serie=${fullSpec.pipe_size || '6x4'}&peso_kg=${fullSpec.weight_kg}&estacion=S${fullSpec.station_number}#rfq`;
const siteUrl = 'https://smatminerals.com';
const canonicalPath = `/en/catalog/${routeSlug || part.code}/`;
const alternateEsPath = `/catalogo/${altEsSlug || part.code}/`;

const title = `${part.part_number} — ${cleanNameEn} | SMAT Minerals`;
const description = `Spare part ${part.part_number}: ${part.type_en} for Standard Frame (${pipeSizeUpper}) in ${part.metallurgy} alloy with ${part.hardness} hardness. Verified direct dispatch from Durango Central Warehouse.`;

const waText = encodeURIComponent(`Hello SMAT Minerals, I require quotation and stock availability at Durango Central Warehouse for part ${part.part_number} (Standard Frame ${pipeSizeUpper}).`);
const waUrl = `https://wa.me/526183670664?text=${waText}`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${part.part_number} — ${cleanNameEn}`,
  "image": `${siteUrl}/images/og-card.jpg`,
  "description": cleanSummaryEn,
  "sku": part.part_number,
  "mpn": part.part_number,
  "brand": {
    "@type": "Brand",
    "name": "SMAT Minerals"
  },
  "material": part.metallurgy,
  "offers": {
    "@type": "Offer",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "name": "SMAT Minerals",
      "url": siteUrl
    }
  }
};
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath={canonicalPath}
  alternateEsPath={alternateEsPath}
  alternateEnPath={canonicalPath}
>
  <main class="part-page-main">
    <div class="container">
      
      <!-- B2B Breadcrumb Navigation -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumbs">
        <a href="/en/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/en/catalog/">Catalog</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{part.part_number}</span>
      </nav>

      <div class="part-layout-grid">
        <!-- Left Column: Formal Technical Specification -->
        <article class="part-spec-card">
          <div class="spec-header">
            <span class="part-badge">UNIVERSAL STANDARD SPARE</span>
            <h1 class="part-title">{part.part_number}</h1>
            <p class="part-subtitle">{cleanNameEn}</p>
          </div>

          <div class="spec-body">
            <!-- Stratum 1: Direct Action + 3-Horizon Harmonic JRP Card (s, c, S) -->
            <div id="stratum1-atomic-code-card" data-stratum-1-instrument style="display:flex; flex-wrap:wrap; gap:0.65rem; align-items:center; margin-bottom:1rem; padding:0.75rem 0.9rem; background:#f8fafc; border:1px solid #cbd5e1; border-radius:8px;">
              <a href={rfqDeepLink} class="btn btn-primary" style="min-height:48px; padding:0.55rem 1rem; font-size:0.86rem;">Quote {part.part_number} →</a>
              <button
                type="button"
                class="btn btn-rfq-wizard"
                data-add-tray-sku={part.part_number === 'DAM005' ? 'SMAT-PUMP-BRG-005M' : `SMAT-PUMP-${part.part_number}`}
                data-tray-part-code={part.part_number}
                data-tray-title={part.name_en}
                data-tray-series={pipeSizeUpper}
                data-tray-material={part.part_number === 'DAM005' ? 'GGG40' : 'A05'}
                data-tray-circuit="bombeo"
                data-tray-source="catalog_code_stratum1"
                style="min-height:48px; padding:0.55rem 1rem; font-size:0.86rem;"
              >
                + Add {part.part_number} to Tray
              </button>
            </div>

            <div data-jrp-window-card data-jrp-criticality="normal" style="margin-bottom:1.25rem; padding:0.95rem 1.05rem; background:#f8fafc; border:1.5px solid #cbd5e1; border-left:4px solid #0c4a6e; border-radius:8px;">
              <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:0.5rem; margin-bottom:0.55rem;">
                <span class="font-mono-tech" style="font-size:0.74rem; font-weight:800; color:#0c4a6e;">HARMONIC PREVENTIVE WINDOW (T₀/2 • T₀ • 2T₀)</span>
                <span class="font-mono-tech" data-jrp-telemetry-badge style="font-size:0.74rem; font-weight:700; color:#334155;">Session Pulp SG 1.45 • d50 280 µm</span>
              </div>
              <div style="display:flex; flex-wrap:wrap; gap:0.45rem; align-items:center; margin-bottom:0.65rem;">
                <span style="font-size:0.78rem; font-weight:700; color:#1e293b;">Criticality Mode:</span>
                <button type="button" data-jrp-criticality-toggle="normal" aria-pressed="true" style="padding:0.35rem 0.75rem; border:1px solid #0c4a6e; border-radius:6px; background:#0c4a6e; color:#ffffff; font-size:0.76rem; font-weight:700; cursor:pointer; min-height:48px;">Normal (1.0×)</button>
                <button type="button" data-jrp-criticality-toggle="paro_planta" aria-pressed="false" style="padding:0.35rem 0.75rem; border:1px solid #94a3b8; border-radius:6px; background:#ffffff; color:#0f172a; font-size:0.76rem; font-weight:700; cursor:pointer; min-height:48px;">Plant Shutdown (0.75×)</button>
                <span class="font-mono-tech" data-jrp-window-days style="margin-left:auto; font-size:0.78rem; font-weight:800; color:#064e3b;">90 d window</span>
                <span class="font-mono-tech" data-jrp-severity style="font-size:0.75rem; color:#334155;">1.00× (1.00×)</span>
              </div>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:0.55rem; margin-bottom:0.6rem;">
                <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.5rem 0.65rem;">
                  <span style="font-size:0.68rem; font-weight:800; color:#334155; display:block;">SHAFT SLEEVE (T₀/2)</span>
                  <strong data-jrp-sleeve-day style="font-size:0.95rem; color:#0f172a;">Day 90</strong>
                </div>
                <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.5rem 0.65rem;">
                  <span style="font-size:0.68rem; font-weight:800; color:#334155; display:block;">IMPELLER + THROAT (T₀)</span>
                  <strong data-jrp-impeller-day style="font-size:0.95rem; color:#0f172a;">Day 150</strong>
                </div>
                <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.5rem 0.65rem;">
                  <span style="font-size:0.68rem; font-weight:800; color:#334155; display:block;">VOLUTE + LINER (2T₀)</span>
                  <strong data-jrp-volute-day style="font-size:0.95rem; color:#0f172a;">Day 180</strong>
                </div>
              </div>
              <div style="display:flex; flex-wrap:wrap; gap:0.6rem; align-items:center; justify-content:space-between;">
                <span data-jrp-policy-summary style="font-size:0.78rem; color:#334155;">Harmonic coupled replacement to minimize unplanned downtime.</span>
                <button
                  type="button"
                  class="btn btn-rfq-wizard"
                  data-add-coupled-pair-btn
                  data-pair-primary-sku={part.part_number === 'DAM005' ? 'SMAT-PUMP-BRG-005M' : `SMAT-PUMP-${part.part_number}`}
                  data-pair-primary-title={part.name_en}
                  data-pair-secondary-sku="SMAT-PUMP-TB-083"
                  data-pair-secondary-title="1:1 Matched Throatbush (Suction Liner)"
                  data-pair-series={pipeSizeUpper}
                  data-pair-material={part.part_number === 'DAM005' ? 'GGG40' : 'A05'}
                  style="min-height:48px; padding:0.45rem 0.85rem; font-size:0.8rem;"
                >
                  + Add Coupled Pair to Tray
                </button>
              </div>
            </div>

            <p class="part-lead">{cleanSummaryEn}</p>

            <!-- 3 Semantic Physical Engineering Cards (Miller's Law ≤ 3 metrics per card) -->
            <div class="atomic-engineering-cards" data-testid="atomic-engineering-cards" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:0.85rem; margin-bottom:1.75rem;">
              <div class="atomic-eng-card" style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:8px; padding:0.9rem;">
                <span class="font-mono-tech" style="font-size:0.7rem; font-weight:800; color:#7c2d12; display:block; margin-bottom:0.35rem;">[1. MASS & NIOSHRIGGING]</span>
                <div style="font-size:1.15rem; font-weight:800; color:#0f172a;" data-testid="spec-weight-kg">{fullSpec.weight_kg} kg</div>
                <div style="font-size:0.78rem; color:#334155; margin-top:0.2rem;" data-testid="spec-niosh-mode">{nioshModeLabelEn}</div>
                <div class="font-mono-tech" style="font-size:0.72rem; color:#475569; margin-top:0.2rem;">Wall thickness: <strong data-testid="spec-wall-thickness">{fullSpec.wall_thickness_mm} mm</strong></div>
              </div>
              <div class="atomic-eng-card" style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:8px; padding:0.9rem;">
                <span class="font-mono-tech" style="font-size:0.7rem; font-weight:800; color:#0c4a6e; display:block; margin-bottom:0.35rem;">[2. HYDRAULIC GEOMETRY]</span>
                <div style="font-size:1.15rem; font-weight:800; color:#0f172a;" data-testid="spec-impeller-dia">
                  {fullSpec.impeller_diameter_mm ? `∅D₂ = ${fullSpec.impeller_diameter_mm} mm` : `Series ${pipeSizeUpper} (Standard Frame ${pipeSizeUpper})`}
                </div>
                <div style="font-size:0.78rem; color:#334155; margin-top:0.2rem;" data-testid="spec-max-particle">
                  {fullSpec.max_particle_mm ? `Max sphere passage: ${fullSpec.max_particle_mm} mm` : `Direct shaft / seal fit series ${pipeSizeUpper}`}
                </div>
                <div class="font-mono-tech" style="font-size:0.72rem; color:#475569; margin-top:0.2rem;">SMAT Code: <strong>{fullSpec.smat_code}</strong></div>
              </div>
              <div class="atomic-eng-card" style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:8px; padding:0.9rem;">
                <span class="font-mono-tech" style="font-size:0.7rem; font-weight:800; color:#14532d; display:block; margin-bottom:0.35rem;">[3. BOM ASSEMBLY STATION]</span>
                <div style="font-size:1.15rem; font-weight:800; color:#0f172a;" data-testid="spec-station-number">Station 0{fullSpec.station_number} (S{fullSpec.station_number})</div>
                <div style="font-size:0.78rem; color:#334155; margin-top:0.2rem;" data-testid="spec-assembly-note">{fullSpec.assembly_order_note}</div>
              </div>
            </div>

            <h2 class="section-title">Metallurgical Specifications & Dimensional Interchangeability</h2>
            <div class="table-responsive">
              <table class="spec-table">
                <tbody>
                  <tr>
                    <th>Universal Code:</th>
                    <td><strong>{part.part_number}</strong> ({fullSpec.smat_code})</td>
                  </tr>
                  <tr>
                    <th>Compatible Frame & Pipe Series:</th>
                    <td>Slurry pump Standard Frame ({pipeSizeUpper})</td>
                  </tr>
                  <tr>
                    <th>Component Type:</th>
                    <td>{part.type_en}</td>
                  </tr>
                  <tr>
                    <th>Metallurgy:</th>
                    <td>{part.metallurgy}</td>
                  </tr>
                  <tr>
                    <th>Verified Hardness:</th>
                    <td><span class="hardness-badge">{part.hardness}</span></td>
                  </tr>
                  {part.vanes > 0 && (
                    <tr>
                      <th>Vane Geometry:</th>
                      <td>{part.vanes} closed vanes with dynamic expeller back vanes</td>
                    </tr>
                  )}
                  <tr>
                    <th>Critical Application:</th>
                    <td>{cleanCircuitEn}</td>
                  </tr>
                  <tr>
                    <th>Assembly Guarantee:</th>
                    <td>{part.fit_guarantee_en} (Linked Kits: #{(part.kit_ids || [1]).join(', #')})</td>
                  </tr>
                  <tr data-iso7810-ref="0.76mm">
                    <th>Everyday Physical Scale (ISO/IEC 7810):</th>
                    <td>{part.everyday_equivalence_en ? `${part.everyday_equivalence_en} • ` : ''}Optimal reference axial clearance δ = 0.76 mm (exact thickness of 1 standard ISO 7810 bank card).</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Yard Verification Protocol in Durango -->
            <div class="assurance-block">
              <div class="assurance-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 11 12 14 22 4"/></svg>
              </div>
              <div class="assurance-text">
                <h3>1:1 Dimensional Fit Assurance (ISO 2768-m)</h3>
                <p>
                  Every {part.part_number} unit is physically matched against standard frame dimensions before dispatch from our Durango Central Warehouse. We ensure 100% drop-in interchangeability with industry-standard frames. Should a standard replacement part deviate from confirmed drawings, priority replacement is coordinated under our Durango supply regime.
                </p>
              </div>
            </div>

            <!-- Anti-Scraping Confidentiality Notice -->
            <div class="anti-scraping-notice">
              <span class="notice-label">CONFIDENTIAL ENGINEERING NOTICE:</span>
              <p>
                Fine-tolerance manufacturing prints and complete internal dimensional matrices are kept off public tables to safeguard intellectual property. Detailed mechanical drawings and compliance dossiers are shared privately with authorized mine plant engineering and procurement teams.
              </p>
            </div>
          </div>
        </article>

        <!-- Right Column: Fast-Track Action Dock (WhatsApp & RFQ) -->
        <aside class="part-action-dock">
          <div class="action-card">
            <span class="dock-badge">DURANGO SUPPLY REGIME</span>
            <h3>Requisition for {part.part_number}</h3>
            <p class="dock-desc">
              Direct consultation with our engineering team in Durango, Mexico for prompt pricing, stock allocation, and direct carrier dispatch to your mine site.
            </p>

            <div class="dock-ctas">
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp-king">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                <span>Check Availability via WhatsApp</span>
              </a>

              <a href={rfqDeepLink} class="btn btn-rfq-wizard" data-testid="btn-atomic-rfq">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                <span>Generate Formal RFQ / A4 Slip</span>
              </a>

              <button
                type="button"
                class="btn btn-rfq-wizard"
                data-add-atomic-to-tray
                data-atomic-code={part.part_number}
                data-name-es={part.name_es}
                data-name-en={part.name_en}
                data-weight-kg={fullSpec.weight_kg}
              >
                <span>+ Add {part.part_number} to B2B Tray</span>
              </button>
              <p data-atomic-tray-msg hidden style="margin:0; font-size:0.82rem; font-weight:700; color:#065f46;"></p>
            </div>

            {part.part_number === 'DAM005' && (
              <div
                data-core-tradein-widget="DAM005"
                style="margin-top: 1rem; padding: 0.85rem; border-radius: 10px; background: #ecfdf5; border: 1px solid #10b981; font-size: 0.78rem; color: #064e3b;"
              >
                <div style="font-family: var(--font-mono-tech, monospace); font-weight: 800; color: #065f46; margin-bottom: 0.35rem;">
                  ♻️ DAM005 CORE TRADE-IN PROGRAM (-22% CREDIT)
                </div>
                <div style="display: grid; grid-template-columns: 1fr; gap: 0.45rem; margin-bottom: 0.4rem;">
                  <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 700;">
                    <span>Used Housing Condition</span>
                    <select data-tradein-condition data-core-tradein-condition style="padding: 0.35rem 0.45rem; border: 1px solid #059669; border-radius: 6px; background: #ffffff; color: #0f172a; font-size: 0.75rem;">
