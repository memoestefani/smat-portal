<script>
  import { addTrayItem } from '../../../scripts/requisitionTrayBus.js';
  import { initCoreTradeInWidgets } from '../../../scripts/vendorPassportAndTradeInController.js';
  import { initHarmonicJrpWindowAndPairCard } from '../../../scripts/catalogDropInAndJrpProjector.js';

  function bootCatalogCodeSheetEn() {
    if (typeof document === 'undefined') return;
    initCoreTradeInWidgets(document, 'en');
    initHarmonicJrpWindowAndPairCard(document, 'en');
    const btn = document.querySelector('[data-add-atomic-to-tray]') as HTMLButtonElement | null;
    const msg = document.querySelector('[data-atomic-tray-msg]') as HTMLElement | null;
    if (btn && btn.dataset.atomicTrayBound !== '1') {
      btn.dataset.atomicTrayBound = '1';
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-atomic-code') || 'E4147';
        const updated = addTrayItem({
          skuId: code,
          atomicCode: code,
          nameEs: btn.getAttribute('data-name-es') || code,
          nameEn: btn.getAttribute('data-name-en') || code,
          unitWeightKg: Number(btn.getAttribute('data-weight-kg')) || 18.0,
          qty: 1,
          criticalityMode: 'PARO_DE_LINEA'
        });
        if (msg) {
          msg.hidden = false;
          msg.textContent = `✓ ${code} added to B2B Tray (${updated.items.length} active items).`;
        }
      });
    }
  }
  bootCatalogCodeSheetEn();
  document.addEventListener('astro:page-load', bootCatalogCodeSheetEn);
</script>

