---
// src/pages/en/process-equipment/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import CircuitNavigator from '../../../components/CircuitNavigator.astro';
import DualHubView from '../../../components/DualHubView.astro';
import CaseCards from '../../../components/CaseCards.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
---

<BaseLayout
  title="Process Equipment for Mineral Concentrator Plants | SMAT Minerals"
  description="Supply of Process Equipment for capital projects, plant expansions, and circuit upgrades: Flotation Cell Mechanisms & Conditioners (50 to 300 ft³), Filter Presses (800 to 1500 mm, 16 bar), and Complete Slurry Pump Packages."
  lang="en"
  canonicalPath="/en/process-equipment/"
  alternateEsPath="/equipos/"
  alternateEnPath="/en/process-equipment/"
>
  <section class="page-hero">
    <div class="container">
      <span class="badge badge-copper">DOOR 1 • CAPITAL PROJECTS, EXPANSIONS & CIRCUITS</span>
      <h1>Process Equipment</h1>
      <p style="font-size: 1.06rem; max-width: 780px; color: var(--smat-text-secondary);">
        Engineering and supply of core process equipment for grinding, flotation concentration, and tailings dewatering circuits: <strong>Flotation Cell Mechanisms & Conditioners (50 to 300 ft³)</strong>, <strong>Recessed-Chamber Filter Presses (800 to 1500 mm, up to 16 bar)</strong>, and <strong>Complete Horizontal & Vertical Slurry Pump Packages</strong>.
      </p>
      <div style="display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.25rem;">
        <a href="/en/quote/?equipo=celda_flotacion#rfq" class="btn btn-primary">Quote Process Equipment →</a>
        <a href="/en/pumping/" class="btn btn-outline">Go to Slurry Pumps & Spare Parts →</a>
      </div>
    </div>
  </section>

  <section class="section" id="stage-diagnostic">
    <div class="container">
      <div class="process-equipment-grid">
        <!-- Equipment 1: Flotation Cell Mechanisms & Conditioners -->
        <article class="card equipment-block">
          <div class="equipment-block-header">
            <span class="badge badge-copper">CONCENTRATION CIRCUIT • 50 TO 300 FT³</span>
            <h2>Flotation Cell Mechanisms & Pulp Conditioners</h2>
            <p style="color: var(--smat-text-secondary);">
              Complete drive heads, concentric alloy steel shafts, standpipes, stator diffusers, rotor impellers, and high-intensity pulp conditioners for <strong>Rougher, Cleaner, and Scavenger</strong> flotation banks.
            </p>
          </div>
          <TechnicalDiagrams diagram="flotation" lang="en" />
          <div class="specs-strip">
            <div><strong>Cell Capacities:</strong> 50 ft³, 100 ft³, 160 ft³, and 300 ft³</div>
            <div><strong>Aeration:</strong> Self-aspirated or low-pressure forced air</div>
            <div><strong>Wear Elastomers:</strong> Abrasion-resistant natural rubber and molded Polyurethane</div>
          </div>
          <div class="equipment-actions">
            <a href="/en/flotation/" class="btn btn-outline">View Flotation Line</a>
            <a href="/en/flotation/cells/" class="btn btn-outline">50-300 ft³ Mechanisms</a>
            <a href="/en/flotation/mechanisms/" class="btn btn-outline">Rotors & Stators</a>
            <a href="/en/quote/?equipo=celda_flotacion#rfq" class="btn btn-primary">Quote Flotation Mechanism →</a>
          </div>
        </article>

        <!-- Equipment 2: Recessed-Chamber Filter Presses -->
        <article class="card equipment-block">
          <div class="equipment-block-header">
            <span class="badge badge-copper">CONCENTRATE & DRY TAILINGS FILTRATION • 800 TO 1500 MM</span>
            <h2>Recessed-Chamber Filter Presses (Up to 16 bar)</h2>
            <p style="color: var(--smat-text-secondary);">
              Complete heavy-duty structural steel filter presses with automatic electro-hydraulic closure, virgin copolymer polypropylene plate packs, and needle-felt filter cloths for process water recovery and dry-stack tailings.
            </p>
          </div>
          <TechnicalDiagrams diagram="filter" lang="en" />
          <div class="specs-strip">
            <div><strong>Plate Formats:</strong> 800×800 mm, 1000×1000 mm, 1200×1200 mm, and 1500×1500 mm</div>
            <div><strong>Operating Pressure:</strong> Up to 16 bar with manifold cake air-blow</div>
            <div><strong>Residual Cake Moisture:</strong> 10% to 14% depending on concentrate or tailings PSD</div>
          </div>
          <div class="equipment-actions">
            <a href="/en/filtration/" class="btn btn-outline">View Filtration Line</a>
            <a href="/en/filtration/press/" class="btn btn-outline">800-1500 mm Filter Presses</a>
            <a href="/en/filtration/parts/" class="btn btn-outline">Filter Plates & Cloths</a>
            <a href="/en/quote/?equipo=filtro_prensa#rfq" class="btn btn-primary">Quote Filter Press →</a>
          </div>
        </article>

        <!-- Equipment 3: Complete Project Slurry Pump Packages -->
        <article class="card equipment-block">
          <div class="equipment-block-header">
            <span class="badge badge-copper">PROJECT SLURRY PUMPING • 1.5X1" TO 14X12"</span>
            <h2>Complete Horizontal & Vertical Slurry Pump Packages</h2>
            <p style="color: var(--smat-text-secondary);">
              Complete centrifugal slurry pumps mounted on structural steel skids with assembled <strong>Bearing Assembly / Housing</strong> cartridge, V-belt drive guard, and wet-end configured in High Chrome (≥650 HB), Natural Rubber, or Polyurethane.
            </p>
          </div>
          <TechnicalDiagrams diagram="pump" lang="en" />
          <TechnicalDiagrams diagram="drive_arrangements" lang="en" compact={true} />
          <div class="specs-strip">
            <div><strong>Discharge Sizes:</strong> From 1.5x1" up to 14x12"</div>
            <div><strong>Drive Arrangements:</strong> CV (Overhead), ZVZ (Rear), CRZ (Side-by-Side) & DC (Direct Inline)</div>
            <div><strong>Shaft Sealing:</strong> Dry centrifugal expeller and stuffing box (no mechanical seals)</div>
            <div><strong>Operational Spares:</strong> Available under <a href="/en/pumping/">Slurry Pumps & Spare Parts</a></div>
          </div>
          <div class="equipment-actions">
            <a href="/en/pumping/skid/#drive-arrangements" class="btn btn-outline">View CV / ZVZ / CRZ / DC Drives</a>
            <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="btn btn-outline">View Pump Assembly & Exploded BOM</a>
            <a href="/en/quote/?equipo=skid_bomba&transmision=CV#rfq" class="btn btn-primary">Quote CV Arrangement Skid →</a>
            <a href="/en/quote/?equipo=skid_bomba&transmision=DC#rfq" class="btn btn-primary">Quote Direct DC Skid →</a>
          </div>
        </article>
      </div>

      <SharePurchasing
        roleTitle="Process Equipment for Concentrator Plant (Flotation / Filtration / Pumping)"
        specs="Flotation Mechanisms 50-300 ft³, Filter Presses 800-1500 mm (16 bar), and Project Slurry Pumps 1.5x1 to 14x12"
        metallurgy="Structural Steel / High Chrome A05 (≥650 HB) / Copolymer Polypropylene / Elastomers"
        series="SMAT Capital Projects Line"
        roleId="celda_flotacion"
        circuit="flotacion"
        lang="en"
      />
    </div>
  </section>

  <section id="stage-2">
    <details class="equipos-circuit-appendix" id="equipos-circuit-appendix">
      <summary class="equipos-circuit-appendix__summary container">
        <span>P&ID Circuit Diagram, CAPEX/OPEX Matrix & Field Engineering Cases</span>
        <span class="equipos-circuit-appendix__badge">EXPAND P&ID APPENDIX ▾</span>
      </summary>
      <div class="container" style="padding-top: 1.25rem; padding-bottom: 0.5rem;">
        <div class="equipos-segmented-control" role="tablist" aria-label="Circuit View Selector (1 Active at a Time)">
          <button type="button" role="tab" aria-selected="true" class="equipos-seg-btn is-active" data-equipos-view-btn="pid">
            1. Interactive P&amp;ID Circuit Map
          </button>
          <button type="button" role="tab" aria-selected="false" class="equipos-seg-btn" data-equipos-view-btn="hub">
            2. Dual Role / Circuit Matrix
          </button>
          <button type="button" role="tab" aria-selected="false" class="equipos-seg-btn" data-equipos-view-btn="cases">
            3. Plant Engineering Cases
          </button>
        </div>
      </div>

      <div data-equipos-view-panel="pid">
        <section class="section" style="background-color: #ffffff; border-top: 1px solid var(--smat-border-light); border-bottom: 1px solid var(--smat-border-light);">
          <div class="container">
            <CircuitNavigator lang="en" />
          </div>
        </section>
      </div>

      <div data-equipos-view-panel="hub" style="display:none">
        <DualHubView lang="en" />
      </div>

      <div data-equipos-view-panel="cases" style="display:none">
        <CaseCards lang="en" />
      </div>
    </details>
  </section>

  <script>
    const viewBtns = Array.from(document.querySelectorAll('[data-equipos-view-btn]'));
    const viewPanels = Array.from(document.querySelectorAll('[data-equipos-view-panel]'));
    function activateEquiposView(targetView: string) {
      viewBtns.forEach((btn) => {
        const isMatch = btn.getAttribute('data-equipos-view-btn') === targetView;
        btn.classList.toggle('is-active', isMatch);
        btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });
      viewPanels.forEach((panel) => {
        const isMatch = panel.getAttribute('data-equipos-view-panel') === targetView;
        (panel as HTMLElement).style.display = isMatch ? 'block' : 'none';
      });
    }
    viewBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-equipos-view-btn') || 'pid';
        activateEquiposView(target);
      });
    });
  </script>
</BaseLayout>

<style>
  .page-hero {
    background-color: #ffffff;
    color: var(--smat-text-primary);
    padding: 3rem 0;
    border-bottom: 2px solid var(--smat-copper-accent);
  }
  .page-hero h1 {
    color: var(--smat-text-primary);
    margin-top: 0.65rem;
  }
  .process-equipment-grid {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }
  .equipment-block {
    padding: 2rem;
    border: 1px solid var(--smat-border-strong);
    background: #ffffff;
  }
  .equipment-block-header h2 {
    margin: 0.5rem 0 0.65rem;
    color: var(--smat-text-primary);
  }
  .specs-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem;
    background: var(--smat-bg-canvas);
    border: 1px solid var(--smat-border-light);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1.25rem 0;
    font-size: 0.88rem;
    color: var(--smat-text-secondary);
  }
  .equipment-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .equipos-circuit-appendix {
    border-top: 1px solid var(--smat-border-strong);
    background-color: #f8fafc;
  }
  .equipos-circuit-appendix__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1rem;
    cursor: pointer;
    font-weight: 800;
    color: var(--smat-text-primary);
    list-style: none;
  }
  .equipos-circuit-appendix__summary::-webkit-details-marker {
    display: none;
  }
  .equipos-circuit-appendix__badge {
    background-color: #f0f9ff;
    color: #082f49;
    border: 1px solid #bae6fd;
    font-family: var(--smat-font-mono);
    font-size: 0.76rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
  }
  .equipos-segmented-control {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    background: #e2e8f0;
    padding: 0.3rem;
    border-radius: 10px;
    border: 1px solid var(--smat-border-light);
  }
  .equipos-seg-btn {
    border: none;
    background: transparent;
    color: #1e293b;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.55rem 1rem;
    border-radius: 7px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .equipos-seg-btn.is-active {
    background: #0f172a;
    color: #ffffff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.25);
  }
</style>
