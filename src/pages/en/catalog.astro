---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Official Digital Catalog 2026 | Slurry Pumps, Flotation Cells & Filter Presses | SMAT Minerals";
const description = "Technical digital catalog of heavy abrasive slurry centrifugal pumps, mechanical flotation cells, tailings filter presses and A05 replacement wear spares dispatched from Durango, Mexico.";
---

<BaseLayout title={title} description={description} lang="en">
  <div class="catalog-page-container">
    
    <!-- Top Action Bar -->
    <div class="catalog-action-bar no-print">
      <div class="action-bar-left">
        <a href="/en/" class="btn-back">← Back to Home</a>
        <span class="catalog-edition-pill">EXECUTIVE EDITION 2026</span>
      </div>
      <div class="action-bar-right">
        <button type="button" class="btn-action btn-print" onclick="window.print()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          <span>Print / Save Catalog PDF (A4)</span>
        </button>
        <a href="/en/#rfq" class="btn-action btn-rfq">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Generate Requisition</span>
        </a>
      </div>
    </div>

    <!-- Official Letterhead Header (Visible in Web & Print) -->
    <header class="catalog-official-header">
      <div class="header-brand-block">
        <h1 class="brand-title">SMAT MINERALS</h1>
        <span class="brand-tagline">HEAVY MECHANICAL ENGINEERING & MINING EQUIPMENT SUPPLY</span>
        <span class="brand-location">Fiscal HQ: Mariano Salas #114, Durango, Mexico. CP 34166 | Durango Central Warehouse</span>
      </div>
      <div class="header-meta-block">
        <span class="doc-badge">OFFICIAL TECHNICAL CATALOG</span>
        <span class="doc-code">REF: SMAT-CAT-2026-EN</span>
        <span class="doc-contact">Phone: +52 (618) 810-4408 • ventas@smatminerals.com</span>
      </div>
    </header>

    <div class="catalog-intro-banner no-print">
      <div class="intro-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
      </div>
      <div class="intro-text">
        <strong>Digital Catalog for Mining Buyers & Process Engineers</strong>
        <p>Review dimensional series, metallurgical specifications, and complete equipment or wear replacement options for grinding, flotation, and tailings dewatering circuits. Save or print this document in clean PDF format using the top button to share internally.</p>
      </div>
    </div>

    <!-- SECTION 1: SLURRY & ABRASIVE PUMPING SYSTEMS -->
    <section class="catalog-section" id="pumping">
      <div class="section-title-wrap">
        <span class="section-num">01</span>
        <div>
          <h2>Heavy Abrasive Slurry Pumping Systems</h2>
          <span class="section-subtitle">Complete skid mounted packages and severe wear spare parts for slurry duties</span>
        </div>
      </div>

      <div class="catalog-grid-2">
        <div class="catalog-card">
          <div class="card-tag">Complete Skid Package with Motor & Skid</div>
          <h3>Centrifugal Slurry Pumps on Structural Skid</h3>
          <p class="card-desc">Fully integrated heavy slurry pumping packages mounted on reinforced ASTM A36 C-channel base frames, paired with standard 3-phase electric motors (WEG/Siemens), calculated industrial V-belt drives with OSHA guards, and dynamic shop balancing in Durango prior to dispatch.</p>
          <ul class="card-specs">
            <li><strong>Dimensional Series:</strong> 4x3 C, 6x4 D, 8x6 E, 10x8 F (Industry Standard Interchangeability).</li>
            <li><strong>Flow Capacity:</strong> 50 to 1,200 m³/h @ Total dynamic heads up to 80 meters per single stage.</li>
            <li><strong>Power Range:</strong> 30 HP to 250 HP TEFC 3-phase electric motor.</li>
            <li><strong>Interchangeability:</strong> 1:1 dimensional fit with standard ANSI flanges and bedplates.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/en/?equipo=skid_bomba#rfq" class="btn-card-quote">Quote Skid Pump →</a>
          </div>
        </div>

        <div class="catalog-card">
          <div class="card-tag">Critical Wet-End Wear Spares</div>
          <h3>Impellers, Volute Liners & Shaft Sealing</h3>
          <p class="card-desc">Critical wet-end wear parts cast in High Chrome 27% Chromium white iron or molded in pressure-vulcanized natural rubber for maximum service life under severe erosion and gouging abrasion.</p>
          <ul class="card-specs">
            <li><strong>High Chrome A05 Metallurgy:</strong> ASTM A532 Class III Type A, Minimum 650 HB (58-62 HRC).</li>
            <li><strong>Elastomers:</strong> Pressure-vulcanized 60 Shore A natural rubber for fine solids and reagents.</li>
            <li><strong>Impellers:</strong> Closed 4 and 5-vane impellers with dynamic back pump-out vanes.</li>
            <li><strong>Sealing:</strong> Flushless centrifugal expeller dynamic seals and heavy-duty stuffing boxes.</li>
            <li><strong>Bearings:</strong> Heavy-duty Timken tapered roller bearing cartridges (L10 > 50,000 hrs).</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/en/?equipo=impulsor#rfq" class="btn-card-quote">Quote Wear Spares →</a>
          </div>
        </div>
      </div>

      <!-- Rapid Parametric Matrix Table (Decision 2-A) -->
      <div class="catalog-table-wrap" id="parametric-matrix">
        <div class="table-header-flex">
          <div>
            <h4 class="table-title">Rapid Parametric Matrix — Slurry Pumping Series (4x3 to 10x8)</h4>
            <span class="table-subtitle">Consolidated dimensional frames, max solids passage (Top Size), power ratings, and flow ranges (<15s inspection)</span>
          </div>
          <span class="matrix-badge">1:1 FIT STANDARD</span>
        </div>

        <!-- Mini-Diagram Eschematic SVG Mounting Dimensions (Decision 2-A & 4-A) -->
        <div class="mounting-diagram-box no-print" id="pump-mounting-diagram">
          <div class="diagram-meta">
            <span class="diagram-tag">SCHEMATIC FIT & ANCHORAGE DIAGRAM (1:1 ANSI STANDARD)</span>
            <small>Hover over any table row below to highlight live bench dimensional callouts in real time.</small>
          </div>
          <div class="diagram-flex">
            <svg class="pump-svg-scheme" viewBox="0 0 340 120" width="100%" height="120" aria-label="Slurry pump dimensional schematic">
              <defs>
                <marker id="dim-arrow-c-en" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                  <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#c25e00" />
                </marker>
                <marker id="dim-arrow-blue-en" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                  <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#2563eb" />
                </marker>
              </defs>
              <rect x="50" y="85" width="240" height="20" rx="3" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
              <circle cx="70" cy="95" r="4" fill="#64748b" />
              <circle cx="270" cy="95" r="4" fill="#64748b" />
              <line x1="70" y1="112" x2="270" y2="112" stroke="#c25e00" stroke-width="1.5" stroke-dasharray="3,3" marker-start="url(#dim-arrow-c-en)" marker-end="url(#dim-arrow-c-en)" />
              <text x="170" y="109" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#c25e00" text-anchor="middle" font-weight="bold" class="svg-dim-c pro-tabular-nums">Dim C: Hold-Down Bolt Centers</text>
              <circle cx="120" cy="55" r="32" fill="#cbd5e1" stroke="#475569" stroke-width="1.5" />
              <rect x="25" y="43" width="15" height="24" rx="2" fill="#94a3b8" stroke="#334155" stroke-width="1.5" />
              <line x1="40" y1="55" x2="90" y2="55" stroke="#334155" stroke-width="1.5" />
              <text x="20" y="38" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#0f172a" font-weight="bold" class="svg-dim-a pro-tabular-nums">Ø A (Suction)</text>
              <rect x="108" y="8" width="24" height="15" rx="2" fill="#94a3b8" stroke="#334155" stroke-width="1.5" />
              <line x1="120" y1="23" x2="120" y2="55" stroke="#334155" stroke-width="1.5" />
              <text x="140" y="18" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#0f172a" font-weight="bold" class="svg-dim-b pro-tabular-nums">Ø B (Discharge)</text>
              <line x1="295" y1="55" x2="295" y2="85" stroke="#2563eb" stroke-width="1.5" marker-start="url(#dim-arrow-blue-en)" marker-end="url(#dim-arrow-blue-en)" />
              <text x="300" y="73" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#2563eb" font-weight="bold" class="svg-dim-d pro-tabular-nums">Dim D</text>
            </svg>
            <div class="diagram-legend">
              <span class="legend-item"><strong>Ø A:</strong> Suction flange nominal diameter (4" to 10")</span>
              <span class="legend-item"><strong>Ø B:</strong> Discharge flange nominal diameter (3" to 8")</span>
              <span class="legend-item"><strong>Dim C:</strong> Baseplate anchor bolt center-to-center</span>
              <span class="legend-item"><strong>Dim D:</strong> Shaft centerline height from concrete pad</span>
            </div>
          </div>
        </div>

        <table class="catalog-table pro-tabular-nums" id="parametric-pumps-table">
          <thead>
            <tr>
              <th>Series / Frame</th>
              <th>Suction × Discharge</th>
              <th>Operating Flow</th>
              <th>Dynamic Head (TDH)</th>
              <th>Top Size (Max Solids)</th>
              <th>Motor Power</th>
              <th>Metallurgy / Hardness</th>
              <th>Plant Application</th>
              <th class="no-print">Quick Action</th>
            </tr>
          </thead>
          <tbody>
            <tr class="dim-row" data-dimension="dim-c" data-series="4x3C">
              <td><span class="series-pill">4x3 C</span></td>
              <td>4" (100 mm) × 3" (75 mm)</td>
              <td>50 – 180 m³/h</td>
              <td>10 – 45 m</td>
              <td><strong>28 mm</strong></td>
              <td>30 – 50 HP (22-37 kW)</td>
              <td>A05 (>650 HB) / Rubber</td>
              <td>Flotation feed, sumps, and fine tailings transfer.</td>
              <td class="no-print"><a href="/en/#rfq?equipo=skid_bomba&serie=4x3" class="btn-table-cta">Quote 4x3 →</a></td>
            </tr>
            <tr class="dim-row" data-dimension="dim-c" data-series="6x4D">
              <td><span class="series-pill highlight">6x4 D</span></td>
              <td>6" (150 mm) × 4" (100 mm)</td>
              <td>150 – 450 m³/h</td>
              <td>15 – 60 m</td>
              <td><strong>45 mm</strong></td>
              <td>50 – 100 HP (37-75 kW)</td>
              <td>A05 (>650 HB)</td>
              <td>SAG / Ball mill discharge to cyclone clusters (200-600 t/d).</td>
              <td class="no-print"><a href="/en/#rfq?equipo=skid_bomba&serie=6x4" class="btn-table-cta">Quote 6x4 →</a></td>
            </tr>
            <tr class="dim-row" data-dimension="dim-c" data-series="8x6E">
              <td><span class="series-pill">8x6 E</span></td>
              <td>8" (200 mm) × 6" (150 mm)</td>
              <td>350 – 900 m³/h</td>
              <td>20 – 70 m</td>
              <td><strong>63 mm</strong></td>
              <td>100 – 200 HP (75-150 kW)</td>
              <td>A05 (>650 HB)</td>
              <td>Primary grinding circuit discharge and thickened tailings.</td>
              <td class="no-print"><a href="/en/#rfq?equipo=skid_bomba&serie=8x6" class="btn-table-cta">Quote 8x6 →</a></td>
            </tr>
            <tr class="dim-row" data-dimension="dim-c" data-series="10x8F">
              <td><span class="series-pill">10x8 F</span></td>
              <td>10" (250 mm) × 8" (200 mm)</td>
              <td>700 – 1,200 m³/h</td>
              <td>25 – 80 m</td>
              <td><strong>86 mm</strong></td>
              <td>150 – 250 HP (110-185 kW)</td>
              <td>A05 (>650 HB) / Rubber</td>
              <td>Large throughput tailings disposal and plants >1,500 t/d.</td>
              <td class="no-print"><a href="/en/#rfq?equipo=skid_bomba&serie=10x8" class="btn-table-cta">Quote 10x8 →</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- SECTION 2: MINERAL FLOTATION CELLS -->
    <section class="catalog-section" id="flotation">
      <div class="section-title-wrap">
        <span class="section-num">02</span>
        <div>
          <h2>Mechanical Mineral Flotation Line</h2>
          <span class="section-subtitle">Complete cells and replacement rotor/stator mechanisms for Rougher, Cleaner and Scavenger circuits</span>
        </div>
      </div>

      <div class="catalog-grid-2">
        <div class="catalog-card">
          <div class="card-tag">Flotation Cells & Mechanism Assembly</div>
          <h3>Sub-Aerated Mechanical Flotation Cells (50 to 300 ft³)</h3>
          <p class="card-desc">Welded structural ASTM A36 steel tanks with U-shaped bottom profiles to prevent sanding, heavy-duty drive shafts, matched V-belt drives, and tailings discharge boxes with pneumatic or manual dart valves.</p>
          <ul class="card-specs">
            <li><strong>Available Volumes:</strong> 50 ft³ (1.4 m³), 100 ft³ (2.8 m³), 200 ft³ (5.6 m³), 300 ft³ (8.5 m³).</li>
            <li><strong>Configuration:</strong> Cascade banks of 2 to 6 interconnected cells.</li>
            <li><strong>Aeration:</strong> Hollow shaft self-aspiration or low-pressure blower feed.</li>
            <li><strong>Froth Control:</strong> Rotating paddle scrapers and adjustable overflow weirs.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/en/?equipo=celda_flotacion#rfq" class="btn-card-quote">Quote Flotation Bank →</a>
          </div>
        </div>

        <div class="catalog-card">
          <div class="card-tag">OpEx • Mechanism Replacement</div>
          <h3>Wear Rotors & Stators</h3>
          <p class="card-desc">Hydrodynamic mechanisms cast in mining-grade polyurethane or resilient natural rubber, dynamically balanced for homogenous bubble dispersion and maximum metallurgical recovery.</p>
          <ul class="card-specs">
            <li><strong>Materials:</strong> Reagent-resistant polyurethane and vulcanized natural rubber.</li>
            <li><strong>Rotors:</strong> High-shear finger geometry maximizing air-slurry interfacial area.</li>
            <li><strong>Stators:</strong> Radial baffles damping vortex energy to create a quiescent surface froth zone.</li>
            <li><strong>Compatibility:</strong> 1:1 drop-in replacement mechanisms for standard industrial cells.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/en/?equipo=rotor_estator#rfq" class="btn-card-quote">Quote Mechanisms →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: FILTRATION & TAILINGS DEWATERING -->
    <section class="catalog-section" id="filtration">
      <div class="section-title-wrap">
        <span class="section-num">03</span>
        <div>
          <h2>Solid-Liquid Filtration & Tailings Dewatering</h2>
          <span class="section-subtitle">High-pressure hydraulic filter presses and filter consumables for dry tailings stacking</span>
        </div>
      </div>

      <div class="catalog-grid-2">
        <div class="catalog-card">
          <div class="card-tag">Tailings Filter Presses</div>
          <h3>Automated Hydraulic Filter Presses</h3>
          <p class="card-desc">High-pressure dewatering systems designed for concentrate and thickened tailings filtration, producing dry filter cakes with 12% to 16% residual moisture for sustainable dry stacking and maximum process water recycling.</p>
          <ul class="card-specs">
            <li><strong>Plate Dimensions:</strong> 800 x 800 mm, 1000 x 1000 mm, 1250 x 1250 mm, 1500 x 1500 mm.</li>
            <li><strong>Feed Pressure:</strong> Up to 16 bar slurry injection.</li>
            <li><strong>Hydraulic Clamping:</strong> Double-acting hydraulic cylinder with up to 350 bar clamping force.</li>
            <li><strong>Automation:</strong> Touch HMI / PLC control panel for cake washing, air blowdown, and plate shifting.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/en/?equipo=filtro_prensa#rfq" class="btn-card-quote">Quote Filter Press →</a>
          </div>
        </div>

        <div class="catalog-card">
          <div class="card-tag">OpEx • Consumables & Plates</div>
          <h3>Polypropylene Plates & Woven Filter Cloths</h3>
          <p class="card-desc">Recessed chamber and membrane squeeze plates molded from 100% virgin high-density polypropylene, paired with synthetic woven filter fabrics engineered for high mechanical tensile strength.</p>
          <ul class="card-specs">
            <li><strong>Plates:</strong> Recessed chamber and inflatable membrane plates for moisture squeeze.</li>
            <li><strong>Filter Cloths:</strong> Monofilament, multifilament, and composite fabrics calibrated to slurry P80.</li>
            <li><strong>Chemical Resistance:</strong> Chemically inert to acidic pH, cyanide, and flotation reagents.</li>
            <li><strong>Spares & Accessories:</strong> Slurry diaphragm gauges, gaskets, and heavy slurry feed pumps.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/en/?equipo=placas_telas#rfq" class="btn-card-quote">Quote Plates & Cloths →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: WAREHOUSE PROTOCOL & DISPATCH -->
    <section class="catalog-section" id="logistics">
      <div class="section-title-wrap">
        <span class="section-num">04</span>
        <div>
          <h2>Quality Protocol, Central Warehouse & Logistics</h2>
          <span class="section-subtitle">Physical inspection in Durango, dynamic balancing and reliable mine delivery modes</span>
        </div>
      </div>

      <div class="trust-charter-grid">
        <div class="trust-box">
          <span class="t-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
          </span>
          <h4>Shop Dynamic Bench Balancing</h4>
          <p>Every impeller and flotation rotor dispatched from SMAT Minerals undergoes concentricity inspection and dynamic balancing on our Durango test bench prior to packaging, reducing vibration.</p>
        </div>

        <div class="trust-box">
          <span class="t-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
          </span>
          <h4>High Chrome 27% (A05) Metallurgy</h4>
          <p>Alloy castings with verified 27% Chromium content (A05) and hardness over 650 HB (Brinell) to withstand high-quartz abrasive mineral impact and heavy slurry duty.</p>
        </div>

        <div class="trust-box">
          <span class="t-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="16" height="13" x="1" y="3" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </span>
          <h4>3 Nationwide Dispatch Modes</h4>
          <p>1. Direct warehouse pickup in Durango (scheduled and released with formal folio).<br/>2. Consolidated national freight carrier (nearest destination terminal).<br/>3. Dedicated direct truckload or multimodal maritime link to remote / peninsular sites.</p>
        </div>

        <div class="trust-box">
          <span class="t-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <h4>Dedicated Technical Support</h4>
          <p>Customer service hours: Monday to Friday 08:00 to 18:00 CST. Dedicated hotline for plant shutdown emergency requirements.</p>
        </div>
      </div>
    </section>

    <!-- Official Catalog Footer -->
    <footer class="catalog-official-footer">
      <div class="footer-contacts">
        <strong>SMAT MINERALS — Heavy Mining Equipment Supply & Hydraulic Engineering</strong>
        <p>Fiscal HQ: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo., Mexico. CP 34166 | Central Warehouse: Durango, Mexico | Phone: +52 (618) 810-4408 | ventas@smatminerals.com</p>
      </div>
      <div class="footer-cta no-print">
        <a href="/en/#rfq" class="btn-footer-rfq">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Generate Serialized Spec Online</span>
        </a>
      </div>
    </footer>

  </div>
</BaseLayout>

<style>
  .catalog-page-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    font-family: var(--smat-font-ui);
    color: var(--smat-text-primary);
  }

  /* Top Action Bar */
  .catalog-action-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--smat-border-medium);
    border-radius: var(--smat-radius-md);
    padding: 0.75rem 1.25rem;
    margin-bottom: 2rem;
    box-shadow: var(--smat-shadow-sm);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .action-bar-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-back {
    color: var(--smat-text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .btn-back:hover { color: var(--smat-copper-accent); }

  .catalog-edition-pill {
    font-size: 0.7rem;
    font-weight: 800;
    font-family: var(--smat-font-mono);
    background: #0f172a;
    color: #f8fafc;
    padding: 0.2rem 0.55rem;
    border-radius: var(--smat-radius-sm);
  }

  .action-bar-right {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.95rem;
    border-radius: var(--smat-radius-sm);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-print {
    background: #f1f5f9;
    border: 1px solid var(--smat-border-medium);
    color: var(--smat-text-primary);
  }

  .btn-print:hover {
    background: #e2e8f0;
    border-color: var(--smat-text-primary);
  }

