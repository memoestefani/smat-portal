---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DualHubView from '../../components/DualHubView.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import atomicParts from '../../../data/atomic_parts.json';

const title = "Official Technical Catalog 2026 | Slurry Pumps, Flotation Mechanisms, Filter Presses & Scales | SMAT Minerals";
const description = "Technical digital catalog with CAD diagrams of slurry pumps, wet-end wear lots (High Chrome, Rubber & Polyurethane), Bearing Assembly / Housing, flotation mechanisms, filter presses and Marcy pulp density scales.";
---

<BaseLayout title={title} description={description} lang="en">
  <div class="catalog-page-container">
    
    <!-- Top Action Bar -->
    <div class="catalog-action-bar no-print">
      <div class="action-bar-left">
        <a href="/en/" class="btn-back">← Back to Home</a>
        <span class="catalog-edition-pill">TECHNICAL EDITION V3.2 • 2026</span>
      </div>
      <div class="action-bar-right">
        <button type="button" class="btn-action btn-print" onclick="window.print()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          <span>Print / Save Catalog PDF (A4)</span>
        </button>
        <a href="/en/#rfq" class="btn-action btn-rfq">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Generate Requisition</span>
        </a>
      </div>
    </div>

    <!-- Official Letterhead Header (Visible in Web & Print) -->
    <header class="catalog-official-header">
      <div class="header-brand-block">
        <h1 class="brand-title">SMAT MINERALS</h1>
        <span class="brand-tagline">SLURRY PUMPS, WET-END PARTS, FLOTATION, FILTER PRESSES & PULP SCALES</span>
        <span class="brand-location">Fiscal HQ: Mariano Salas #114, Durango, Mexico. CP 34166 | Durango Central Warehouse</span>
      </div>
      <div class="header-meta-block">
        <span class="doc-badge">TECHNICAL CATALOG WITH CAD DIAGRAMS</span>
        <span class="doc-code">REF: SMAT-CAT-2026-EN</span>
        <span class="doc-contact">Phone: +52 (618) 810-4408 • Hotline: +52 (618) 367-0664 • ventas@smatminerals.com</span>
      </div>
    </header>

    <div class="catalog-intro-banner no-print">
      <div class="intro-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
      </div>
      <div class="intro-text">
        <strong>Technical Catalog with Exploded CAD Diagrams for Plant Engineering & Mining Procurement</strong>
        <p>Review horizontal slurry pumps (1.5x1" to 14x12"), balanced wet-end wear lots (e.g. 5 impellers, 5 throatbushes, and 4 volute liners in High Chrome, Rubber, and Polyurethane), complete <strong>Bearing Assembly / Housing</strong> units, mechanisms for flotation cells and pulp conditioners, filter presses (800 to 1500 mm), and Marcy-type pulp density scales.</p>
      </div>
    </div>

    <!-- SECTION 1: SLURRY PUMPS & WET-END WEAR PARTS -->
    <section class="catalog-section" id="pumping">
      <div class="section-title-wrap">
        <span class="section-num">01</span>
        <div>
          <h2>Slurry Pumps & Wet-End Wear Parts (Pumping Circuit)</h2>
          <span class="section-subtitle">Horizontal slurry pumps, 5-5-4 wet-end lots in High Chrome, Rubber & Polyurethane, and complete Bearing Assembly / Housing</span>
        </div>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <TechnicalDiagrams diagram="pump" lang="en" />
      </div>

      <div class="catalog-grid-2">
        <div class="catalog-card">
          <div class="card-tag">Horizontal Slurry Pumps & Drive End</div>
          <h3>Slurry Pumps (1.5x1" to 14x12") & Bearing Assembly / Housing</h3>
          <p class="card-desc">Heavy-duty horizontal centrifugal slurry pumps for mill discharge, cyclone feed, flotation, and tailings transfer, paired with complete assembled <strong>Bearing Assembly / Housing</strong> units ready for fast drop-in installation.</p>
          <ul class="card-specs">
            <li><strong>Pump Size Range:</strong> From 1.5x1" up to 14x12" (4x3 C, 6x4 D, 8x6 E, 10x8 F series with 1:1 dimensional interchangeability).</li>
            <li><strong>Bearing Assembly / Housing:</strong> Complete assembled cartridge (cylindrical housing, alloy steel shaft, Timken tapered roller bearings, and labyrinth end seals).</li>
            <li><strong>Shaft Sealing:</strong> Dry centrifugal expeller and stuffing box with lantern ring. <strong>We do not supply mechanical seals</strong> due to severe slurry corrosion and abrasion.</li>
            <li><strong>Interchangeability:</strong> 1:1 dimensional fit with standard ANSI flanges and bedplates.</li>
          </ul>
          <div class="card-footer-action no-print" style="display:flex; gap:1rem; flex-wrap:wrap;">
            <a href="/en/#rfq?equipo=skid_bomba" class="btn-card-quote">Quote Slurry Pump →</a>
            <a href="/en/#rfq?equipo=soporte" class="btn-card-quote">Quote Bearing Assembly →</a>
          </div>
        </div>

        <div class="catalog-card">
          <div class="card-tag">Balanced Wet-End Lot Supply (5 – 5 – 4)</div>
          <h3>Impellers, Throatbushes & Volutes (High Chrome, Rubber & Polyurethane)</h3>
          <p class="card-desc">Wet-end wear parts supplied in balanced plant maintenance lots matched to real component wear ratios (for example: <strong>5 Impellers + 5 Throatbushes + 4 Volute Liners</strong>) to prevent clearance mismatch and recirculation.</p>
          <ul class="card-specs">
            <li><strong>Available Materials:</strong> High Chrome 27% Cr white iron (ASTM A532 ≥650 HB), pressure-vulcanized natural rubber, and mining-grade polyurethane.</li>
            <li><strong>Impellers:</strong> Closed 5-vane and wide-passage impellers with back pump-out vanes to relieve stuffing box pressure.</li>
            <li><strong>Throatbushes & Liners:</strong> Adjustable suction throatbushes (front clearance take-up), volute liners, and frame plate liner inserts (FPL).</li>
            <li><strong>Shop Balancing:</strong> Verified hardness and ISO 1940 G2.5 dynamic balancing in Durango.</li>
          </ul>
          <div class="card-footer-action no-print" style="display:flex; gap:1rem; flex-wrap:wrap;">
            <a href="/en/#rfq?equipo=revestimientos" class="btn-card-quote">Quote Wet-End Lot (5-5-4) →</a>
            <a href="/en/#rfq?equipo=impulsor" class="btn-card-quote">Quote Impellers →</a>
          </div>
        </div>
      </div>

      <div class="catalog-grid-2" style="margin-bottom: 1.5rem;">
        <div>
          <TechnicalDiagrams diagram="liners" lang="en" compact={true} />
        </div>
        <div>
          <TechnicalDiagrams diagram="bearing" lang="en" compact={true} />
        </div>
      </div>

      <!-- Rapid Parametric Matrix Table (Decision 2-A) -->
      <div class="catalog-table-wrap" id="parametric-matrix">
        <div class="table-header-flex">
          <div>
            <h4 class="table-title">Rapid Parametric Matrix — Slurry Pumping Series (4x3 to 10x8)</h4>
            <span class="table-subtitle">Consolidated dimensional frames, max solids passage (Top Size), power ratings, and flow ranges (&lt;15s inspection)</span>
          </div>
          <span class="matrix-badge">1:1 FIT STANDARD</span>
        </div>

        <!-- Mini-Diagram Eschematic SVG Mounting Dimensions (Decision 2-A & 4-A) -->
        <div class="mounting-diagram-box no-print" id="pump-mounting-diagram">
          <div class="diagram-meta">
            <span class="diagram-tag">SCHEMATIC FIT & ANCHORAGE DIAGRAM (1:1 ANSI STANDARD)</span>
            <small>Hover over any table row below to highlight live bench dimensional callouts in real time.</small>
          </div>
          <div class="diagram-flex">
            <svg class="pump-svg-scheme" viewBox="0 0 340 120" width="100%" height="120" aria-label="Slurry pump dimensional schematic">
              <defs>
                <marker id="dim-arrow-c-en" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                  <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#c25e00" />
                </marker>
                <marker id="dim-arrow-blue-en" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                  <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#2563eb" />
                </marker>
              </defs>
              <rect x="50" y="85" width="240" height="20" rx="3" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
              <circle cx="70" cy="95" r="4" fill="#64748b" />
              <circle cx="270" cy="95" r="4" fill="#64748b" />
              <line x1="70" y1="112" x2="270" y2="112" stroke="#c25e00" stroke-width="1.5" stroke-dasharray="3,3" marker-start="url(#dim-arrow-c-en)" marker-end="url(#dim-arrow-c-en)" />
              <text x="170" y="109" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#c25e00" text-anchor="middle" font-weight="bold" class="svg-dim-c pro-tabular-nums">Dim C: Hold-Down Bolt Centers</text>
              <circle cx="120" cy="55" r="32" fill="#cbd5e1" stroke="#475569" stroke-width="1.5" />
              <rect x="25" y="43" width="15" height="24" rx="2" fill="#94a3b8" stroke="#334155" stroke-width="1.5" />
              <line x1="40" y1="55" x2="90" y2="55" stroke="#334155" stroke-width="1.5" />
              <text x="20" y="38" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#0f172a" font-weight="bold" class="svg-dim-a pro-tabular-nums">Ø A (Suction)</text>
              <rect x="108" y="8" width="24" height="15" rx="2" fill="#94a3b8" stroke="#334155" stroke-width="1.5" />
              <line x1="120" y1="23" x2="120" y2="55" stroke="#334155" stroke-width="1.5" />
              <text x="140" y="18" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#0f172a" font-weight="bold" class="svg-dim-b pro-tabular-nums">Ø B (Discharge)</text>
              <line x1="295" y1="55" x2="295" y2="85" stroke="#2563eb" stroke-width="1.5" marker-start="url(#dim-arrow-blue-en)" marker-end="url(#dim-arrow-blue-en)" />
              <text x="300" y="73" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#2563eb" font-weight="bold" class="svg-dim-d pro-tabular-nums">Dim D</text>
            </svg>
            <div class="diagram-legend">
              <span class="legend-item"><strong>Ø A:</strong> Suction flange nominal diameter (4" to 10")</span>
              <span class="legend-item"><strong>Ø B:</strong> Discharge flange nominal diameter (3" to 8")</span>
              <span class="legend-item"><strong>Dim C:</strong> Baseplate anchor bolt center-to-center</span>
              <span class="legend-item"><strong>Dim D:</strong> Shaft centerline height from concrete pad</span>
            </div>
          </div>
        </div>

        <table class="catalog-table pro-tabular-nums" id="parametric-pumps-table">
          <thead>
            <tr>
              <th>Series / Frame</th>
              <th>Suction × Discharge</th>
              <th>Operating Flow</th>
              <th>Dynamic Head (TDH)</th>
              <th>Top Size (Max Solids)</th>
              <th>Motor Power</th>
              <th>Wet-End Materials</th>
              <th>Plant Application</th>
              <th class="no-print">Quick Action</th>
            </tr>
          </thead>
          <tbody>
            <tr class="dim-row" data-dimension="dim-c" data-series="4x3C">
              <td><span class="series-pill">4x3 C</span></td>
              <td>4" (100 mm) × 3" (75 mm)</td>
              <td>50 – 180 m³/h</td>
              <td>10 – 45 m</td>
              <td><strong>28 mm</strong></td>
              <td>30 – 50 HP (22-37 kW)</td>
              <td>High Chrome (&gt;650 HB) / Rubber / Polyurethane</td>
              <td>Flotation feed, sumps, and fine tailings transfer.</td>
              <td class="no-print"><a href="/en/#rfq?equipo=skid_bomba&serie=4x3" class="btn-table-cta">Quote 4x3 →</a></td>
            </tr>
            <tr class="dim-row" data-dimension="dim-c" data-series="6x4D">
              <td><span class="series-pill highlight">6x4 D</span></td>
              <td>6" (150 mm) × 4" (100 mm)</td>
              <td>150 – 450 m³/h</td>
              <td>15 – 60 m</td>
              <td><strong>45 mm</strong></td>
              <td>50 – 100 HP (37-75 kW)</td>
              <td>High Chrome (&gt;650 HB) / Rubber / Polyurethane</td>
              <td>SAG / Ball mill discharge to cyclone clusters (200-600 t/d).</td>
              <td class="no-print"><a href="/en/#rfq?equipo=skid_bomba&serie=6x4" class="btn-table-cta">Quote 6x4 →</a></td>
            </tr>
            <tr class="dim-row" data-dimension="dim-c" data-series="8x6E">
              <td><span class="series-pill">8x6 E</span></td>
              <td>8" (200 mm) × 6" (150 mm)</td>
              <td>350 – 900 m³/h</td>
              <td>20 – 70 m</td>
              <td><strong>63 mm</strong></td>
              <td>100 – 200 HP (75-150 kW)</td>
              <td>High Chrome (&gt;650 HB) / Rubber</td>
              <td>Primary grinding circuit discharge and thickened tailings.</td>
              <td class="no-print"><a href="/en/#rfq?equipo=skid_bomba&serie=8x6" class="btn-table-cta">Quote 8x6 →</a></td>
            </tr>
            <tr class="dim-row" data-dimension="dim-c" data-series="10x8F">
              <td><span class="series-pill">10x8 F</span></td>
              <td>10" (250 mm) × 8" (200 mm)</td>
              <td>700 – 1,200 m³/h</td>
              <td>25 – 80 m</td>
              <td><strong>86 mm</strong></td>
              <td>150 – 250 HP (110-185 kW)</td>
              <td>High Chrome (&gt;650 HB) / Rubber</td>
              <td>Large throughput tailings disposal and plants &gt;1,500 t/d.</td>
              <td class="no-print"><a href="/en/#rfq?equipo=skid_bomba&serie=10x8" class="btn-table-cta">Quote 10x8 →</a></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Atomic Part Technical Sheets (atomic_parts.json) -->
      <div class="atomic-parts-catalog-block" id="atomic-part-sheets">
        <div class="table-header-flex">
          <div>
            <h4 class="table-title">Universal Part Number Technical Sheets (Impellers, Throatbushes & Expeller Rings)</h4>
            <span class="table-subtitle">Select any universal part code to view its individual metallurgical specification, verified hardness, and 1:1 dimensional fit</span>
          </div>
          <span class="matrix-badge">6 ATOMIC SHEETS</span>
        </div>
        <div class="atomic-parts-grid">
          {atomicParts.map((part) => (
            <div class="atomic-part-card">
              <div class="atomic-part-top">
                <span class="series-pill highlight">{part.part_number}</span>
                <span class="atomic-frame-badge">Frame {part.frame}</span>
              </div>
              <strong class="atomic-part-title">{part.name_en}</strong>
              <p class="atomic-part-desc">{part.type_en} • {part.hardness}</p>
              <div class="atomic-part-actions no-print">
                <a href={`/en/catalog/${part.code}/`} class="btn-table-cta">View Sheet {part.part_number} →</a>
                <a href={`/en/#rfq?codigo=${part.part_number}&circuito=bombeo`} class="btn-card-quote">Quote →</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION 2: MECHANISMS FOR FLOTATION CELLS & CONDITIONERS -->
    <section class="catalog-section" id="flotation">
      <div class="section-title-wrap">
        <span class="section-num">02</span>
        <div>
          <h2>Mechanisms for Flotation Cells & Pulp Conditioners</h2>
          <span class="section-subtitle">Drive heads, shafts, standpipes, pulp conditioners, and rotor/stator mechanisms (50 to 300 ft³)</span>
        </div>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <TechnicalDiagrams diagram="flotation" lang="en" />
      </div>

      <div class="catalog-grid-2">
        <div class="catalog-card">
          <div class="card-tag">Complete Drive Mechanisms & Conditioners</div>
          <h3>Mechanisms for Flotation Cells & Conditioning Tanks (50 to 300 ft³)</h3>
          <p class="card-desc">Complete vertical drive assemblies (upper bearing housing, grooved V-belt sheave, concentric air standpipe with control valve, and alloy steel shaft) for Rougher, Cleaner, and Scavenger banks, plus agitation mechanisms for pulp conditioning tanks.</p>
          <ul class="card-specs">
            <li><strong>Cell Volumes:</strong> 50 ft³ (1.4 m³), 100 ft³ (2.8 m³), 200 ft³ (5.6 m³), 300 ft³ (8.5 m³).</li>
            <li><strong>Pulp Conditioners:</strong> Axial circulation mechanisms with central draft tube and elastomer-lined propeller.</li>
            <li><strong>Aeration:</strong> Hollow standpipe self-aspiration or low-pressure forced air feed.</li>
            <li><strong>Mounting:</strong> Direct bolt-on replacement onto existing cell structural bridges.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/en/#rfq?equipo=celda_flotacion" class="btn-card-quote">Quote Mechanism or Conditioner →</a>
          </div>
        </div>

        <div class="catalog-card">
          <div class="card-tag">Rubber & Polyurethane Wear Parts</div>
          <h3>Rotors, Stators, Propellers & Shafts</h3>
          <p class="card-desc">Hydrodynamic rotors, stators/diffusers, and conditioner propellers molded over steel cores in high-resilience natural rubber or mining-grade polyurethane.</p>
          <ul class="card-specs">
            <li><strong>Materials:</strong> Vulcanized natural rubber (60-65 Shore A) and reagent-resistant polyurethane.</li>
            <li><strong>Rotors:</strong> Radial star geometry maximizing air-slurry shear without elastomer delamination.</li>
            <li><strong>Stators:</strong> Stabilizing radial blades damping vortex energy to preserve a quiescent froth zone.</li>
            <li><strong>Compatibility:</strong> 1:1 drop-in replacement mechanisms for standard industrial flotation cells.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/en/#rfq?equipo=rotor_estator" class="btn-card-quote">Quote Rotors & Stators →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: FILTER PRESSES, PLATES & FILTER CLOTHS -->
    <section class="catalog-section" id="filtration">
      <div class="section-title-wrap">
        <span class="section-num">03</span>
        <div>
          <h2>Filter Presses, Filter Plates & Cloths (Concentrate & Tailings Filtration)</h2>
          <span class="section-subtitle">Recessed chamber filter presses (800 to 1500 mm), virgin polypropylene plates, and needle-felt filter cloths</span>
        </div>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <TechnicalDiagrams diagram="filter" lang="en" />
      </div>

      <div class="catalog-grid-2">
        <div class="catalog-card">
          <div class="card-tag">Recessed Chamber Filter Presses</div>
          <h3>Electro-Hydraulic Filter Presses (800 mm to 1500 mm)</h3>
          <p class="card-desc">Heavy-duty recessed chamber filter presses engineered for mineral concentrate and thickened tailings dewatering (up to 16 bar slurry feed pressure), delivering solid filter cakes with low residual moisture and high process water recovery.</p>
          <ul class="card-specs">
            <li><strong>Plate Dimensions:</strong> Recessed chamber sizes of 800 x 800 mm, 1000 x 1000 mm, 1250 x 1250 mm, and 1500 x 1500 mm.</li>
            <li><strong>Filtration Pressure:</strong> Up to 16 bar slurry feed pressure.</li>
            <li><strong>Hydraulic Clamping:</strong> Double-acting hydraulic cylinder (up to 350 bar) with HPU and pressure-holding check valves.</li>
            <li><strong>Operation:</strong> Moving follower head, reinforced side bars, and automatic plate shifter.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/en/#rfq?equipo=filtro_prensa" class="btn-card-quote">Quote Filter Press →</a>
          </div>
        </div>

        <div class="catalog-card">
          <div class="card-tag">Filter Plates & Cloths</div>
          <h3>Virgin Polypropylene Plates & Needle-Felt Filter Cloths</h3>
          <p class="card-desc">Recessed chamber filter plates molded from virgin copolymer polypropylene and laser-cut needle-felt filter cloths with thermally sealed edges.</p>
          <ul class="card-specs">
            <li><strong>Filter Plates:</strong> High-density virgin copolymer polypropylene for 800 mm to 1500 mm chambers.</li>
            <li><strong>Filter Cloths:</strong> Needle-felt and monofilament/multifilament fabrics calibrated to mineral P80 (barrel neck, grommets, and velcro).</li>
            <li><strong>Chemical Resistance:</strong> Inert to acidic/alkaline pH and flotation reagents.</li>
            <li><strong>Hydraulic Spares:</strong> Cylinder seal kits, valves, slurry feed pumps, and diaphragm pressure gauges.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/en/#rfq?equipo=placas_telas" class="btn-card-quote">Quote Plates & Cloths →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: PULP DENSITY SCALES (MARCY TYPE) -->
    <section class="catalog-section" id="scales">
      <div class="section-title-wrap">
        <span class="section-num">04</span>
        <div>
          <h2>Pulp Density & % Solids Scales (Marcy Type)</h2>
          <span class="section-subtitle">Direct-reading metallurgical instrumentation for grinding, classification, and flotation control</span>
        </div>
      </div>

      <div class="catalog-grid-2" style="align-items: center;">
        <div class="catalog-card">
          <div class="card-tag">Plant Metallurgical Control</div>
          <h3>Direct-Reading Hanging Pulp Density Scale with 1000 cm³ Container</h3>
          <p class="card-desc">Direct-reading mechanical hanging scale to determine pulp specific gravity, sample weight in grams, and percent solids by weight instantaneously without manual tables or calculations.</p>
          <ul class="card-specs">
            <li><strong>Calibrated Container (1000 cm³):</strong> Available in stainless steel or clear acrylic with lateral overflow holes and bottom drain plug.</li>
            <li><strong>12 Interchangeable Dials:</strong> Cover dry mineral specific gravity ranges from SG 1.2 up to SG 7.8.</li>
            <li><strong>Zero Tare Adjustment:</strong> Top zeroing knob calibrated with the container filled with 1000 g of clean water.</li>
            <li><strong>Application:</strong> Mill discharge, hydrocyclone overflow/underflow, flotation feed, and thickeners.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/en/#rfq?equipo=balanza_marcy" class="btn-card-quote">Quote Pulp Scale →</a>
          </div>
        </div>

        <div>
          <TechnicalDiagrams diagram="marcy" lang="en" />
        </div>
      </div>
    </section>

    <!-- INTERACTIVE 9-ROLE MATRIX & METALLURGICAL RULES (data/roles.json) -->
    <DualHubView lang="en" />

    <!-- SECTION 5: WAREHOUSE PROTOCOL & DISPATCH -->
    <section class="catalog-section" id="logistics">
      <div class="section-title-wrap">
        <span class="section-num">05</span>
        <div>
          <h2>Quality Protocol, Central Warehouse & Logistics</h2>
          <span class="section-subtitle">Physical inspection in Durango, dynamic balancing and reliable mine delivery modes</span>
        </div>
      </div>

      <div class="trust-charter-grid">
        <div class="trust-box">
          <span class="t-icon">
