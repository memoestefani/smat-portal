<script is:inline>
  (function() {
    var table = document.getElementById('parametric-pumps-table');
    var svg = document.querySelector('.pump-svg-scheme');
    if (!table || !svg) return;

    var rows = table.querySelectorAll('tbody tr');
    var dimA = svg.querySelector('.svg-dim-a');
    var dimB = svg.querySelector('.svg-dim-b');
    var dimC = svg.querySelector('.svg-dim-c');
    var dimD = svg.querySelector('.svg-dim-d');

    var seriesDims = {
      '4x3 C': { a: 'Ø 100mm (4")', b: 'Ø 75mm (3")', c: 'Dim C: 420mm', d: 'Dim D: 280mm' },
      '6x4 D': { a: 'Ø 150mm (6")', b: 'Ø 100mm (4")', c: 'Dim C: 580mm', d: 'Dim D: 355mm' },
      '8x6 E': { a: 'Ø 200mm (8")', b: 'Ø 150mm (6")', c: 'Dim C: 740mm', d: 'Dim D: 450mm' },
      '10x8 F': { a: 'Ø 250mm (10")', b: 'Ø 200mm (8")', c: 'Dim C: 920mm', d: 'Dim D: 560mm' }
    };

    rows.forEach(function(row) {
      var seriesPill = row.querySelector('.series-pill');
      var seriesKey = seriesPill ? seriesPill.textContent.trim() : '';
      var data = seriesDims[seriesKey];

      row.addEventListener('mouseenter', function() {
        if (!data) return;
        if (dimA) { dimA.textContent = data.a; dimA.style.fill = 'var(--apple-accent-blue, #38bdf8)'; dimA.style.fontWeight = 'bold'; }
        if (dimB) { dimB.textContent = data.b; dimB.style.fill = 'var(--apple-accent-blue, #38bdf8)'; dimB.style.fontWeight = 'bold'; }
        if (dimC) { dimC.textContent = data.c; dimC.style.fill = 'var(--apple-accent-blue, #38bdf8)'; dimC.style.fontWeight = 'bold'; }
        if (dimD) { dimD.textContent = data.d; dimD.style.fill = 'var(--apple-accent-blue, #38bdf8)'; dimD.style.fontWeight = 'bold'; }
        svg.style.borderColor = 'var(--apple-accent-blue, #38bdf8)';
        svg.style.boxShadow = '0 0 12px rgba(56, 189, 248, 0.2)';
        svg.style.transition = 'all 150ms cubic-bezier(0.16, 1, 0.3, 1)';
      });

      row.addEventListener('mouseleave', function() {
        if (dimA) { dimA.textContent = 'Ø A (Suction)'; dimA.style.fill = ''; }
        if (dimB) { dimB.textContent = 'Ø B (Discharge)'; dimB.style.fill = ''; }
        if (dimC) { dimC.textContent = 'Dim C: Hold-Down Bolt Centers'; dimC.style.fill = '#c25e00'; }
        if (dimD) { dimD.textContent = 'Dim D'; dimD.style.fill = '#2563eb'; }
        svg.style.borderColor = '';
        svg.style.boxShadow = '';
      });
    });

    // Persistencia de serie seleccionada en sessionStorage (Decisión 10-C)
    document.querySelectorAll('.btn-table-cta, .btn-card-quote').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var href = btn.getAttribute('href') || '';
        if (href.includes('serie=')) {
          var sMatch = href.match(/serie=([^&#]+)/);
          if (sMatch && sMatch[1]) {
            try { sessionStorage.setItem('smat_catalog_selected', JSON.stringify({ serie: sMatch[1] })); } catch(e){}
          }
        }
      });
    });
  })();
</script>

