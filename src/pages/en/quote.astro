---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteWizard from '../../components/QuoteWizard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
---

<BaseLayout
  title="Request a Quote for Process Equipment, Spare Parts & Process Control"
  description="Official technical requisition console and Durand-Condolios hydraulic simulator by SMAT Minerals in Durango, Mexico. Process equipment, slurry pumps, spare parts, and metallurgical control."
  lang="en"
  canonicalPath="/en/quote/"
  alternateEsPath="/cotizar/"
  alternateEnPath="/en/quote/"
>
  <section class="quote-route-banner no-print">
    <div class="container">
      <nav class="doors-breadcrumb" aria-label="Quick navigation to the 3 supply lines">
        <a href="/en/" class="crumb-home">← Home</a>
        <span class="crumb-sep">/</span>
        <a href="/en/process-equipment/" class="crumb-door">1. Process Equipment</a>
        <span class="crumb-sep">•</span>
        <a href="/en/pumping/" class="crumb-door">2. Slurry Pumps & Spare Parts</a>
        <span class="crumb-sep">•</span>
        <a href="/en/process-control/" class="crumb-door">3. Process Control</a>
      </nav>
      <div class="quote-route-heading">
        <span class="route-pill">
          <span class="live-dot"></span>
          ENGINEERING & REQUISITION CONSOLE • DURANGO CENTRAL WAREHOUSE
        </span>
        <h1>SMAT Technical Quote & Process Simulator</h1>
        <p>
          Configure your requisition for <strong>Process Equipment</strong>, <strong>Slurry Pumps & Spare Parts</strong>, or <strong>Process Control</strong>. Generate a printable A4 spec sheet, SAP TSV table, or send your request directly to our engineering team in Durango.
        </p>
      </div>
    </div>
  </section>

  <div class="quote-workbench-shell">
    <QuoteWizard lang="en" />
  </div>

  <div class="container no-print">
    <div class="quote-extension-links">
      <a href="/en/pumping/" class="extension-card">
        <span class="ext-badge">P&ID</span>
        <div>
          <strong>Process Circuit Diagrams &amp; Pump Assembly</strong>
          <small>Review the 5 pump assembly stations, 5-5-4 wear lots, and V-Belt drive arrangements.</small>
        </div>
      </a>
      <a href="/en/diagnostics/" class="extension-card">
        <span class="ext-badge">DIAGNOSTICS</span>
        <div>
          <strong>Field Failure &amp; Wear Diagnostics</strong>
          <small>Identify cavitation, internal recirculation, or shaft vibration and pre-load the exact spare part.</small>
        </div>
      </a>
    </div>
    <FaqAccordion lang="en" compact={true} />
  </div>
</BaseLayout>

<style>
  .quote-route-banner {
    background: var(--smat-navy-deep, #051B2E);
    color: #f8fafc;
    padding: 2rem 0 1.75rem;
    border-bottom: 2px solid var(--smat-copper-accent, #c25e00);
  }
  .doors-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1rem;
    font-family: var(--smat-font-mono, monospace);
    font-size: 0.76rem;
  }
  .doors-breadcrumb a {
    color: #cbd5e1;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(15, 23, 42, 0.45);
    transition: all 0.15s ease;
  }
  .doors-breadcrumb a:hover {
    color: #ffffff;
    border-color: #38bdf8;
    background: rgba(13, 120, 198, 0.25);
  }
  .crumb-sep {
    color: #64748b;
  }
  .route-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--smat-font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #fdba74;
    background: rgba(194, 94, 0, 0.18);
    border: 1px solid rgba(251, 146, 60, 0.35);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.65rem;
  }
  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
  }
  .quote-route-heading h1 {
    font-family: var(--smat-font-editorial);
    font-size: clamp(1.6rem, 2.8vw, 2.25rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }
  .quote-route-heading p {
    font-size: 0.98rem;
    color: #cbd5e1;
    max-width: 780px;
    line-height: 1.55;
    margin: 0;
  }
  .quote-route-heading strong {
    color: #ffffff;
  }
  .quote-workbench-shell {
    background: #ffffff;
    border-bottom: 1px solid var(--smat-border-light, #e2e8f0);
  }
  .quote-extension-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .extension-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: #ffffff;
    border: 1px solid var(--smat-border-medium, #cbd5e1);
    border-radius: 8px;
    text-decoration: none;
    color: var(--smat-text-primary, #090d16);
  }
  .extension-card strong {
    display: block;
    font-size: 0.92rem;
    margin-bottom: 0.2rem;
  }
  .extension-card small {
    font-size: 0.8rem;
    color: var(--smat-text-secondary, #1e293b);
  }
  .ext-badge {
    font-family: var(--smat-font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 800;
    color: #ffffff;
    background: var(--smat-navy-deep, #051B2E);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    white-space: nowrap;
  }
  @media (max-width: 768px) {
    .quote-route-banner {
      padding: 0.85rem 0 0.75rem;
    }
    .doors-breadcrumb {
      margin-bottom: 0.45rem;
      font-size: 0.68rem;
    }
    .route-pill {
      font-size: 0.64rem;
      padding: 0.15rem 0.5rem;
      margin-bottom: 0.35rem;
    }
    .quote-route-heading h1 {
      font-size: 1.3rem;
      margin-bottom: 0.25rem;
    }
    .quote-route-heading p {
      font-size: 0.82rem;
      line-height: 1.38;
    }
  }
</style>

