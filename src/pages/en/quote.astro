---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteWizard from '../../components/QuoteWizard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
---

<BaseLayout
  title="Request a Quote for Process Equipment, Spare Parts & Process Control"
  description="Official technical requisition console and Durand-Condolios hydraulic simulator by SMAT Minerals in Durango, Mexico. Process equipment, slurry pumps, spare parts, and metallurgical control."
  lang="en"
  canonicalPath="/en/quote/"
  alternateEsPath="/cotizar/"
  alternateEnPath="/en/quote/"
>
  <div class="quote-workbench-shell" data-canonical-single-entry="quote-wizard">
    <QuoteWizard lang="en" />
  </div>

  <section class="container no-print quote-resources-flat" id="quote-faq-resources-drawer" aria-label="Diagnostics guides and FAQs">
    <div class="quote-extension-links">
      <a href="/en/pumping/" class="extension-card">
        <span class="ext-badge">P&amp;ID</span>
        <div>
          <strong>Process Circuit Diagrams &amp; Pump Assembly</strong>
          <small>Review the 5 pump assembly stations, 5-5-4 wear lots, and V-Belt drive arrangements.</small>
        </div>
      </a>
      <a href="/en/diagnostics/" class="extension-card">
        <span class="ext-badge">DIAGNOSTICS</span>
        <div>
          <strong>Field Failure &amp; Wear Diagnostics</strong>
          <small>Identify cavitation, internal recirculation, or shaft vibration and pre-load the exact spare part.</small>
        </div>
      </a>
    </div>
    <FaqAccordion lang="en" compact={true} />
  </section>
</BaseLayout>

<style>
  .quote-route-banner {
    background: var(--smat-navy-deep, #051B2E);
    color: #f8fafc;
    padding: 0.85rem 0 0.75rem;
    border-bottom: 2px solid var(--smat-copper-accent, #c25e00);
  }
  .doors-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.45rem;
    font-family: var(--smat-font-mono, monospace);
    font-size: 0.76rem;
  }
  .doors-breadcrumb a {
    color: #cbd5e1;
    text-decoration: none;
    min-height: 48px;
    min-width: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(15, 23, 42, 0.45);
    transition: all 0.15s ease;
    box-sizing: border-box;
  }
  .doors-breadcrumb a:hover {
    color: #ffffff;
    border-color: #38bdf8;
    background: rgba(13, 120, 198, 0.25);
  }
  .crumb-sep {
    color: #64748b;
  }
  .quote-workbench-shell {
    background: #ffffff;
    border-bottom: 1px solid var(--smat-border-light, #e2e8f0);
  }
  .quote-extension-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .extension-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: #ffffff;
    border: 1px solid var(--smat-border-medium, #cbd5e1);
    border-radius: 8px;
    text-decoration: none;
    color: var(--smat-text-primary, #090d16);
  }
  .extension-card strong {
    display: block;
    font-size: 0.92rem;
    margin-bottom: 0.2rem;
  }
  .extension-card small {
    font-size: 0.8rem;
    color: var(--smat-text-secondary, #1e293b);
  }
  .ext-badge {
    font-family: var(--smat-font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 800;
    color: #ffffff;
    background: var(--smat-navy-deep, #051B2E);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    white-space: nowrap;
  }
  @media (max-width: 768px) {
    .quote-route-banner {
      padding: 0.35rem 0 0.3rem;
    }
    .doors-breadcrumb {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-bottom: 0.2rem;
      font-size: 0.62rem;
      gap: 0.25rem;
    }
    .doors-breadcrumb::-webkit-scrollbar {
      display: none;
    }
    .doors-breadcrumb a {
      flex: 0 0 auto;
      white-space: nowrap;
      padding: 0.15rem 0.35rem;
    }
    .route-pill {
      display: none;
    }
    .quote-route-heading h1 {
      font-size: 1rem;
      margin-bottom: 0.1rem;
    }
    .quote-route-heading p {
      display: none;
    }
  }
</style>

