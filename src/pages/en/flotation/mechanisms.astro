---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import rolesData from '../../../../data/roles.json';

const flotVertical = rolesData.verticals.find((v) => v.id === 'flotacion');
const mecRole = flotVertical?.opex?.find((r) => r.role_id === 'mecanismos_flotacion');
const criteria = mecRole?.decision_criteria;
---

<BaseLayout 
  title="Flotation Impellers, Diffusers & Mechanism Spares | SMAT Minerals"
  description="Replacement impellers, diffusers, and shafts molded in polyurethane and vulcanized rubber for flotation cell mechanisms and conditioners in Durango."
  lang="en"
  canonicalPath="/en/flotation/mechanisms/"
  alternateEsPath="/flotacion/mecanismos/"
  alternateEnPath="/en/flotation/mechanisms/"
>
  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">FLOTATION SPARES • POLYURETHANE & RUBBER</span>
      <h1>Flotation Impellers & Diffusers</h1>
      <p class="subtitle">Polyurethane and rubber replacement components for flotation cell mechanisms and conditioners.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <div style="margin-bottom: 1.75rem;">
          <TechnicalDiagrams type="flotation" lang="en" />
        </div>
        <h2>Impeller & Diffuser Geometry</h2>
        <p>
          Abrasive wear on impeller and diffuser edges enlarges bubble diameter and reduces mineral concentrate recovery. SMAT Minerals supplies replacement components with steel skeletal cores coated in reagent-resistant polyurethane or natural rubber.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>SMAT Specification</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Impeller Geometry</td>
              <td>Dispersion blades with hydrodynamic shear angles optimized for fine bubble generation</td>
            </tr>
            <tr>
              <td>Diffuser / Stator</td>
              <td>Surrounding diffuser hood with radial stabilizing baffles</td>
            </tr>
            <tr>
              <td>Lining Elastomers</td>
              <td>Molded Polyurethane or 60-65 Shore A Natural Rubber</td>
            </tr>
            <tr>
              <td>Compatibility</td>
              <td>Dimensional interchangeability for 50 to 300 ft³ flotation cell mechanisms and conditioners</td>
            </tr>
            <tr>
              <td>Hydrodynamic Shear Invariant (S<sub>b</sub>)</td>
              <td>Maintains blade tip shear radius for S<sub>b</sub> = 6 J<sub>g</sub> / d<sub>32</sub> ≥ 55 s<sup>-1</sup> without micro-bubble coalescence</td>
            </tr>
          </tbody>
        </table>

        {criteria && (
          <div class="decision-criteria-panel" data-testid="role-decision-criteria" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid #9a3412;">
            <span class="badge badge-copper">METALLURGICAL DECISION CRITERIA • ROLES.JSON</span>
            <h3 style="margin: 0.45rem 0 0.75rem; font-size: 1.08rem; color: var(--smat-text-primary);">Rotor, Stator & Shaft Selection Matrix ({mecRole?.series})</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem; font-size: 0.88rem;">
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: var(--smat-text-primary); margin-bottom: 0.25rem;">Required Slurry Variables</strong>
                <span style="color: #334155;">{criteria.required_slurry_vars_en}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #7c2d12; margin-bottom: 0.25rem;">Elastomer & Shaft Rule</strong>
                <span style="color: #334155;">{criteria.metallurgy_rule_en}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #14532d; margin-bottom: 0.25rem;">Metallurgical Risk Mitigated</strong>
                <span style="color: #334155;">{criteria.risk_avoided_en}</span>
              </div>
            </div>
          </div>
        )}

        <div class="flotation-selector-box" data-testid="flotation-contextual-selector" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #fffbeb; border: 1px solid #fde68a;">
          <span class="badge badge-copper">CONTEXTUAL PRE-SELECTION • WORKBENCH BRIDGE</span>
          <h3 style="margin: 0.45rem 0 0.5rem; font-size: 1.05rem; color: var(--smat-text-primary);">Quote Rotor / Stator by Cell Capacity & Duty</h3>
          <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.65rem;">
            <a href="/en/quote/?circuito=flotacion&equipo=rotor_estator&serie=50ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Rotor/Stator 50 ft³ • Sulfides</a>
            <a href="/en/quote/?circuito=flotacion&equipo=rotor_estator&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Rotor/Stator 100 ft³ • Sulfides</a>
            <a href="/en/quote/?circuito=flotacion&equipo=rotor_estator&serie=200ft&flot_condition=reactivos_espuma#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Rotor/Stator 200 ft³ • Reagents</a>
            <a href="/en/quote/?circuito=flotacion&equipo=rotor_estator&serie=300ft&flot_condition=arena_gruesa_fondo#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Rotor/Stator 300 ft³ • Coarse Sand</a>
          </div>
        </div>

        <SharePurchasing 
          roleTitle="Flotation Cell Impeller & Diffuser"
          series="Compatibility with 50 to 300 ft³ cells"
          metallurgy="Reagent-Resistant Polyurethane / Natural Rubber"
          specs="Impeller and diffuser with steel core and elastomer coating resistant to slurry abrasion and collector chemical attack."
          roleId="rotor_estator"
          circuit="flotacion"
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">TECHNICAL ENGINEERING IN DURANGO</span>
            <h3>Need replacement impellers, diffusers, or shafts for your flotation cells?</h3>
            <p>Request a formal quote specifying cell capacity or mechanism model.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/quote/?circuito=flotacion&equipo=rotor_estator&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-primary btn-lg">
              Request Quotation →
            </a>
            <a href="https://wa.me/526183670664?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20Flotation%20Impeller%20and%20Diffuser" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Quote via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--smat-copper-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
