---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
---

<BaseLayout 
  title="Flotation Rotors, Stators & Mechanisms | SMAT Minerals"
  description="Replacement rotors and stators molded in high-resilience polyurethane and vulcanized rubber for mechanical flotation cells from our Durango facility, Mexico."
  lang="en"
  canonicalPath="/en/flotation/mechanisms/"
  alternateEsPath="/flotacion/mecanismos/"
  alternateEnPath="/en/flotation/mechanisms/"
>
  <Header slot="header" lang="en" currentPath="/en/flotation/mechanisms/" alternatePath="/flotacion/mecanismos/" />

  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">OPEX • DURANGO FACILITY STOCK</span>
      <h1>Flotation Rotors & Stators</h1>
      <p class="subtitle">High-durability replacement suspended mechanisms to restore mineral concentrate recovery kinetics.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <h2>Restoring Bubble Dispersal & Kinetic Shear</h2>
        <p>
          Abrasive rounding on rotor dispersal fingertips enlarges mean bubble diameter ($d_{32}$) and triggers severe loss in froth-phase mineral recovery. SMAT Minerals supplies replacement mechanisms featuring balanced steel skeletal inserts coated with premium wear-resistant and collector-resistant polyurethane.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>SMAT Specification</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Rotor Geometry</td>
              <td>Finger vanes with hydrodynamic vortex shear angles optimized for fine bubble shearing</td>
            </tr>
            <tr>
              <td>Stator Diffuser</td>
              <td>Surrounding stator hood with anti-vortex radial baffles creating a quiescent top froth zone</td>
            </tr>
            <tr>
              <td>Lining Elastomers</td>
              <td>High-resilience injection-molded polyurethane or 60-65 Shore A Natural Rubber</td>
            </tr>
            <tr>
              <td>Compatibility</td>
              <td>Direct dimensional retrofit for standard 50 to 300 ft³ sub-aerated cell mechanisms</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Flotation Cell Rotor & Stator Mechanism"
          series="Retrofit fit for 50 to 300 ft³ cells"
          metallurgy="Reagent-Resistant Polyurethane / Vulcanized Rubber"
          specs="Dynamically balanced rotor and stator with high shear abrasion and collector chemical resistance."
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">IMMEDIATE DISPATCH FROM DURANGO FACILITY</span>
            <h3>Need replacement rotors, stators, or diffuser cones?</h3>
            <p>Generate your official technical requisition with dynamic balancing and polyurethane insert specifications.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/?equipo=rotor_estator#rfq" class="btn btn-primary btn-lg">
              Quote Flotation Mechanism in Central Workbench →
            </a>
            <a href="https://wa.me/526183670664?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20Flotation%20Rotor%20and%20Stator" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Inquire Plant Stock via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton lang="en" />
  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
