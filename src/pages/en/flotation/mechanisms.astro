---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
---

<BaseLayout 
  title="Flotation Impellers, Diffusers & Mechanism Spares | SMAT Minerals"
  description="Replacement impellers, diffusers, and shafts molded in polyurethane and vulcanized rubber for flotation cell mechanisms and conditioners in Durango."
  lang="en"
  canonicalPath="/en/flotation/mechanisms/"
  alternateEsPath="/flotacion/mecanismos/"
  alternateEnPath="/en/flotation/mechanisms/"
>
  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">FLOTATION SPARES • POLYURETHANE & RUBBER</span>
      <h1>Flotation Impellers & Diffusers</h1>
      <p class="subtitle">Polyurethane and rubber replacement components for flotation cell mechanisms and conditioners.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <div style="margin-bottom: 1.75rem;">
          <TechnicalDiagrams type="flotation" lang="en" />
        </div>
        <h2>Impeller & Diffuser Geometry</h2>
        <p>
          Abrasive wear on impeller and diffuser edges enlarges bubble diameter and reduces mineral concentrate recovery. SMAT Minerals supplies replacement components with steel skeletal cores coated in reagent-resistant polyurethane or natural rubber.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>SMAT Specification</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Impeller Geometry</td>
              <td>Dispersion blades with hydrodynamic shear angles optimized for fine bubble generation</td>
            </tr>
            <tr>
              <td>Diffuser / Stator</td>
              <td>Surrounding diffuser hood with radial stabilizing baffles</td>
            </tr>
            <tr>
              <td>Lining Elastomers</td>
              <td>Molded Polyurethane or 60-65 Shore A Natural Rubber</td>
            </tr>
            <tr>
              <td>Compatibility</td>
              <td>Dimensional interchangeability for 50 to 300 ft³ flotation cell mechanisms and conditioners</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Flotation Cell Impeller & Diffuser"
          series="Compatibility with 50 to 300 ft³ cells"
          metallurgy="Reagent-Resistant Polyurethane / Natural Rubber"
          specs="Impeller and diffuser with steel core and elastomer coating resistant to slurry abrasion and collector chemical attack."
          roleId="rotor_estator"
          circuit="flotacion"
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">TECHNICAL ENGINEERING IN DURANGO</span>
            <h3>Need replacement impellers, diffusers, or shafts for your flotation cells?</h3>
            <p>Request a formal quote specifying cell capacity or mechanism model.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/?equipo=rotor_estator#rfq" class="btn btn-primary btn-lg">
              Request Quotation →
            </a>
            <a href="https://wa.me/526183670664?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20Flotation%20Impeller%20and%20Diffuser" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Quote via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
