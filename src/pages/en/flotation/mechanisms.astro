---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FlotationCalculatorIsland from '../../../components/islands/FlotationCalculatorIsland.astro';

const title = 'Flotation Impellers, Diffusers & Mechanism Spares | SMAT Minerals';
const description = 'Replacement impellers, diffusers, and shafts molded in polyurethane and vulcanized rubber for flotation cell mechanisms and conditioners in Durango.';
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath="/en/flotation/mechanisms/"
  alternateEsPath="/flotacion/mecanismos/"
  alternateEnPath="/en/flotation/mechanisms/"
>
  <FlotationCalculatorIsland locale="en" variant="mechanisms" mode="standalone" />
</BaseLayout>
