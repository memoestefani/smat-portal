---
// src/pages/en/flotation/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import CircuitNavigator from '../../../components/CircuitNavigator.astro';
---

<BaseLayout 
  title="Flotation Cell Mechanisms & Conditioners | SMAT Minerals"
  description="Flotation cell agitation mechanisms, pulp conditioners, drive heads, shafts, rotors, and stators."
  lang="en"
>
  <section class="page-hero">
    <div class="container">
      <span class="badge badge-copper">FLOTATION & CONDITIONING</span>
      <h1>Flotation Cell Mechanisms & Conditioners</h1>
      <p style="font-size: 1.08rem; max-width: 720px; color: var(--smat-text-secondary);">
        Complete agitation mechanisms, pulp conditioners, drive heads, standpipes, and rubber or polyurethane rotor-stator assemblies.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="flotation" lang="en" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div class="card">
          <h3>Flotation Cell Mechanisms & Conditioners</h3>
          <p>
            Complete drive assemblies (vertical bearing housing, pulley drive, concentric air standpipe, and shaft) for Rougher, Cleaner, and Scavenger flotation banks, as well as agitation mechanisms for reagent conditioning tanks.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Capacity:</strong> 50 ft³ to 300 ft³ • 15 to 60 HP • 200 to 1,500 t/d</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/en/flotation/cells/" data-subroute-link="/en/flotation/cells/" class="btn btn-outline">Technical Datasheet</a>
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-primary">Quote →</a>
          </div>
        </div>

        <div class="card">
          <h3>Rotors, Stators, Propellers & Shafts</h3>
          <p>
            Impellers/rotors, diffusers/stators, and conditioner propellers molded in natural rubber or polyurethane to resist mineral slurry abrasion and sustain micro-bubble dispersion.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Material:</strong> Rubber & Polyurethane • $S_b = 6 J_g / d_{32}$</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/en/flotation/mechanisms/" class="btn btn-outline">Technical Datasheet</a>
            <a href="/en/products/suspended-flotation-mechanism-18sp/" class="btn btn-outline">Quick-Checkout SMAT-FLOT-MECH-18SP →</a>
            <a href="/en/quote/?circuito=flotacion&equipo=rotor_estator&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-primary">Quote →</a>
          </div>
        </div>
      </div>

      <!-- Drop-In Anti-Morita Geometric Compatibility Matrix (MVP v3.0 · D8) -->
      <div class="card" id="flotation-dropin-matrix" style="margin-top: 2rem; padding: 1.75rem;">
        <span class="badge badge-copper" style="margin-bottom: 0.5rem;">1:1 HYDRODYNAMIC INTERCHANGEABILITY • D8</span>
        <h2 style="margin-bottom: 0.5rem;">Drop-In Geometric Compatibility Matrix (Rotor-Stator & Drive Heads)</h2>
        <p style="color: var(--smat-text-secondary); margin-bottom: 1.25rem;">
          Direct drop-in replacement on existing flotation banks without modifying standpipe flanges or bolt-circle diameters. Preserves critical tip speed v<sub>tip</sub> and superficial gas velocity J<sub>g</sub> to prevent dead zones and coarse sulfide sanding.
        </p>
        <div style="overflow-x: auto;">
          <table class="spec-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
            <thead>
              <tr style="border-bottom: 2px solid #cbd5e1; text-align: left; background: #f8fafc;">
                <th style="padding: 0.65rem;">Cell Architecture (Universal Industry Standard)</th>
                <th style="padding: 0.65rem;">Nominal Volume</th>
                <th style="padding: 0.65rem;">D<sub>r</sub> / D<sub>s</sub> Ratio</th>
                <th style="padding: 0.65rem;">Pumping Number (N<sub>Q</sub>)</th>
                <th style="padding: 0.65rem;">Tip Speed (v<sub>tip</sub>)</th>
                <th style="padding: 0.65rem;">Air Dispersion (J<sub>g</sub>)</th>
                <th style="padding: 0.65rem;">Direct SKU</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid #e2e8f0;">
                <td style="padding: 0.65rem;"><strong>Self-Aspirating 1+1 Mechanical Sub-Aeration Cells</strong></td>
                <td style="padding: 0.65rem;">50 ft³ – 100 ft³</td>
                <td style="padding: 0.65rem;"><code>0.70 ± 0.02</code></td>
                <td style="padding: 0.65rem;"><code>0.22</code></td>
                <td style="padding: 0.65rem;"><code>6.1 – 6.6 m/s</code></td>
                <td style="padding: 0.65rem;"><code>1.2 – 1.5 cm/s</code></td>
                <td style="padding: 0.65rem;"><a href="/en/products/suspended-flotation-mechanism-18sp/">SMAT-FLOT-MECH-18SP →</a></td>
              </tr>
              <tr style="border-bottom: 1px solid #e2e8f0;">
                <td style="padding: 0.65rem;"><strong>Forced-Air Industrial TankCell Type (Star Rotor)</strong></td>
                <td style="padding: 0.65rem;">100 ft³ – 300 ft³</td>
                <td style="padding: 0.65rem;"><code>0.72 ± 0.02</code></td>
                <td style="padding: 0.65rem;"><code>0.26</code></td>
                <td style="padding: 0.65rem;"><code>6.3 – 6.8 m/s</code></td>
                <td style="padding: 0.65rem;"><code>1.4 – 1.8 cm/s</code></td>
                <td style="padding: 0.65rem;"><a href="/en/products/suspended-flotation-mechanism-18sp/">SMAT-FLOT-MECH-18SP →</a></td>
              </tr>
              <tr>
                <td style="padding: 0.65rem;"><strong>High-Intensity Reagent Conditioning Tanks</strong></td>
                <td style="padding: 0.65rem;">5x5 ft – 12x12 ft</td>
                <td style="padding: 0.65rem;"><code>0.68 ± 0.02</code></td>
                <td style="padding: 0.65rem;"><code>0.48</code></td>
                <td style="padding: 0.65rem;"><code>5.8 – 6.4 m/s</code></td>
                <td style="padding: 0.65rem;"><code>Axial Circulation</code></td>
                <td style="padding: 0.65rem;"><a href="/en/products/suspended-flotation-mechanism-18sp/">SMAT-FLOT-MECH-18SP →</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background-color: #ffffff; border-top: 1px solid var(--smat-border-light); border-bottom: 1px solid var(--smat-border-light);">
    <div class="container">
      <CircuitNavigator lang="en" defaultCircuit="flotacion_polimetalica" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="background: #f8fafc; border: 1px solid var(--smat-border-strong); padding: 2.25rem; text-align: center;">
        <h2 style="margin-bottom: 0.6rem;">Request a Quotation for Mechanisms or Conditioners</h2>
        <p style="max-width: 600px; margin: 0 auto 1.25rem; color: var(--smat-text-secondary);">
          Specify your flotation cell or conditioning tank volume and the components you need to quote.
        </p>
        <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-primary">Request Quotation →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 3rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.65rem; }
</style>
