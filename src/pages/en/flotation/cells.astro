---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import rolesData from '../../../../data/roles.json';

const flotVertical = rolesData.verticals.find((v) => v.id === 'flotacion');
const celdaRole = flotVertical?.capex?.find((r) => r.role_id === 'celda_completa');
const criteria = celdaRole?.decision_criteria;
---

<BaseLayout 
  title="Mechanisms for Flotation Cells & Conditioners (50 to 300 ft³) | SMAT Minerals"
  description="Complete mechanisms for flotation cells and conditioners (50 to 300 ft³) for Rougher, Cleaner, and Scavenger circuits. Durango, Mexico."
  lang="en"
  canonicalPath="/en/flotation/cells/"
  alternateEsPath="/flotacion/celdas/"
  alternateEnPath="/en/flotation/cells/"
>
  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-opex">[OPERATING BUDGET: SUSPENDED MECHANISMS & DROP-IN RETROFIT • 50 TO 300 FT³]</span>
      <h1>Mechanisms for Flotation Cells & Conditioners</h1>
      <p class="subtitle">Bearing housings, hollow aeration shafts, standpipes, and impeller-diffuser assemblies for 50 to 300 ft³ (1.4 to 8.5 m³) cells and conditioning tanks without tank demolition or civil works.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <div style="margin-bottom: 1.75rem;">
          <TechnicalDiagrams type="flotation" lang="en" />
        </div>
        <h2>Air Dispersion & Slurry Suspension Engineering</h2>
        <p>
          SMAT Minerals mechanisms for flotation cells and conditioners are engineered to maximize particle-bubble collision and keep coarse solids in uniform suspension without dead zones on the tank floor.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Operating Parameter</th>
              <th>SMAT Technical Specification</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Cell Capacity Range</td>
              <td>50 ft³ (1.4 m³), 100 ft³ (2.8 m³), 200 ft³ (5.6 m³), 300 ft³ (8.5 m³)</td>
            </tr>
            <tr>
              <td>Circuit Configuration</td>
              <td>Reagent conditioning, roughing, cleaning, and scavenging duty stages</td>
            </tr>
            <tr>
              <td>Aeration Mode</td>
              <td>Self-aspirating or low-pressure air assisted with homogeneous radial dispersion</td>
            </tr>
            <tr>
              <td>Mechanism Components</td>
              <td>Bearing housing, sheaves, flanged hollow shaft, standpipe, impeller, and diffuser</td>
            </tr>
            <tr>
              <td>Wetted Materials</td>
              <td>Molded Polyurethane and Natural Rubber resistant to collectors and frothers</td>
            </tr>
            <tr>
              <td>Power Rating & Throughput Range</td>
              <td>{celdaRole?.power_range || '15 HP to 60 HP per mechanism'} • {celdaRole?.flow_range || '200 to 1,500 t/d circuits'}</td>
            </tr>
            <tr>
              <td>JKMRC Flotation Kinetics (Gorain 1997)</td>
              <td>Bubble Surface Area Flux S<sub>b</sub> = 6 J<sub>g</sub> / d<sub>32</sub> (50–65 s<sup>-1</sup>) with first-order rate constant k = P · S<sub>b</sub> · R<sub>f</sub></td>
            </tr>
            <tr>
              <td>#18 SP, #24 & #30 Mechanisms (Gate G4)</td>
              <td>5-Zone Drop-In Replacement (#01 Bearing Pod, #02 Hollow Shaft, #03 Standpipe, #04 Star Rotor, #05 Stator Hood) with Anti-Morita baseline [I<sub>motor</sub>, u<sub>rotor</sub>, S<sub>b</sub> ≥ 50 s<sup>-1</sup>]</td>
            </tr>
          </tbody>
        </table>

        <!-- 5-Zone Exploded Report (#18 SP / #24 / #30) -->
        <div class="flotation-5zone-box" data-cell-dropin-matrix="gorain-1997" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #f8fafc; color: var(--smat-text-primary); border: 1px solid #cbd5e1; border-left: 4px solid #7c2d12;">
          <span class="badge badge-copper">PLANE 3 · 5-ZONE EXPLODED REPORT (#18 SP, #24, #30) · GATE G4</span>
          <h3 style="margin: 0.65rem 0 0.5rem; font-size: 1.08rem; color: var(--smat-text-primary);">Drop-In Replacement Without Tank or Drive Modification (Anti-Morita)</h3>
          <p style="font-size: 0.88rem; color: #334155; margin-bottom: 0.85rem;">
            Every SMAT rotor-stator kit preserves the air pumping number N<sub>Q</sub> (0.22–0.26) and bubble surface area flux <var>S</var><sub>b</sub> = 6 <var>J</var><sub>g</sub> / <var>d</var><sub>32</sub> ≥ 50 s<sup>-1</sup> (Gorain 1997), auditing motor current I<sub>motor</sub> and tip speed v<sub>tip</sub> (6.0–7.5 m/s) before and after installation.
          </p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.65rem; margin-bottom: 0.85rem; padding: 0.85rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.82rem;">
            <label style="display: flex; flex-direction: column; gap: 0.25rem; font-weight: 600;">
              <span>Model / Rotor Ø (m):</span>
              <select id="celdas-dia-select" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                <option value="0.46">#18 SP (Ø 0.46 m · 50 ft³)</option>
                <option value="0.61" selected>#24 (Ø 0.61 m · 100 ft³)</option>
                <option value="0.76">#30 (Ø 0.76 m · 300 ft³)</option>
              </select>
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.25rem; font-weight: 600;">
              <span>Gas Velocity J<sub>g</sub> (cm/s):</span>
              <input type="number" id="celdas-jg-input" min="0.6" max="3.0" step="0.1" value="1.5" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.25rem; font-weight: 600;">
              <span>Sauter Bubble d<sub>32</sub> (mm):</span>
              <input type="number" id="celdas-d32-input" min="0.9" max="2.8" step="0.1" value="1.6" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.25rem; font-weight: 600;">
              <span>Rotor Speed (RPM):</span>
              <input type="number" id="celdas-rpm-input" min="120" max="380" step="5" value="215" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
          </div>
          <div id="celdas-gorain-readout" style="margin-bottom: 0.85rem; padding: 0.65rem 0.85rem; border-radius: 6px; background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; font-family: var(--smat-font-mono); font-size: 0.82rem; font-weight: 700;">
            S<sub>b</sub> = <span id="celdas-sb-output">56.25</span> s<sup>-1</sup> · v<sub>tip</sub> = <span id="celdas-vtip-output">6.87</span> m/s · k = <span id="celdas-k-output">1.185</span> min<sup>-1</sup> (Gorain ≥ 50 s<sup>-1</sup> OPTIMAL)
          </div>
          <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
            <a href="/en/products/suspended-flotation-mechanism-18sp/" class="btn btn-outline" style="font-size:0.8rem;">SMAT-FLOT-MECH-18SP · Suspended Mechanism (#18 SP, #24, #30) →</a>
            <a href="/en/products/flotation-rotor-stator-kit/" class="btn btn-outline" style="font-size:0.8rem;">SMAT-FLOT-MECH-18SP · Rotor + Stator Kit (#18 SP) →</a>
          </div>
        </div>

        {criteria && (
          <div class="decision-criteria-panel" data-testid="role-decision-criteria" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid #9a3412;">
            <span class="badge badge-copper">METALLURGICAL DECISION CRITERIA • ROLES.JSON</span>
            <h3 style="margin: 0.45rem 0 0.75rem; font-size: 1.08rem; color: var(--smat-text-primary);">Mechanism & Conditioner Selection Matrix ({celdaRole?.series})</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem; font-size: 0.88rem;">
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: var(--smat-text-primary); margin-bottom: 0.25rem;">Required Slurry Variables</strong>
                <span style="color: #334155;">{criteria.required_slurry_vars_en}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #7c2d12; margin-bottom: 0.25rem;">Mechanism & Drop-In Elastomer Rule</strong>
                <span style="color: #334155;">{criteria.metallurgy_rule_en}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #14532d; margin-bottom: 0.25rem;">Operational Risk Mitigated</strong>
                <span style="color: #334155;">{criteria.risk_avoided_en}</span>
              </div>
            </div>
          </div>
        )}

        <div class="flotation-selector-box" data-testid="flotation-contextual-selector" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #fffbeb; border: 1px solid #fde68a;">
          <span class="badge badge-copper">CONTEXTUAL PRE-SELECTION • WORKBENCH BRIDGE</span>
          <h3 style="margin: 0.45rem 0 0.5rem; font-size: 1.05rem; color: var(--smat-text-primary);">Select Cell Volume & Operating Duty</h3>
          <p style="font-size: 0.88rem; color: #475569; margin-bottom: 0.85rem;">
            Pre-populate cell capacity (50 to 300 ft³) and chemical/abrasion regime directly in the RFQ quotation workbench:
          </p>
          <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=50ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">50 ft³ (1.4 m³) • Sulfides</a>
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">100 ft³ (2.8 m³) • Sulfides</a>
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=200ft&flot_condition=reactivos_espuma#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">200 ft³ (5.6 m³) • Reagents / Froth</a>
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=300ft&flot_condition=arena_gruesa_fondo#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">300 ft³ (8.5 m³) • Coarse Floor Sand</a>
          </div>
        </div>

        <SharePurchasing 
          roleTitle="Mechanism for Flotation Cell & Conditioner"
          series="Capacities from 50 to 300 ft³ (1.4 to 8.5 m³)"
          metallurgy="Balanced 4140 Steel Shaft, Polyurethane 85–95 Shore A / R55 Rubber Impeller & Diffuser (Zero Civil Works)"
          specs="Complete suspended mechanism with bearing housing, hollow aeration shaft, standpipe, and impeller-diffuser."
          roleId="celda_flotacion"
          circuit="flotacion"
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">TECHNICAL ENGINEERING IN DURANGO</span>
            <h3>Need mechanisms for flotation cells or conditioning tanks?</h3>
            <p>Request a formal quote specifying cell capacity (ft³) or conditioning tank dimensions.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-primary btn-lg">
              Request Quotation →
            </a>
            <a href="https://wa.me/526183670664?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20Mechanisms%20for%20Flotation%20Cells%20and%20Conditioners" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Quote via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { calculateFlotationGorainKineticRate } from '../../../scripts/slurryEngine.js';

  function initFlotationCellsGorainPanelEn() {
    const diaEl = document.getElementById('celdas-dia-select') as HTMLSelectElement | null;
    const jgEl = document.getElementById('celdas-jg-input') as HTMLInputElement | null;
    const d32El = document.getElementById('celdas-d32-input') as HTMLInputElement | null;
    const rpmEl = document.getElementById('celdas-rpm-input') as HTMLInputElement | null;
    const sbOut = document.getElementById('celdas-sb-output');
    const vtipOut = document.getElementById('celdas-vtip-output');
    const kOut = document.getElementById('celdas-k-output');
    const readoutBox = document.getElementById('celdas-gorain-readout');

    function updateGorain() {
      if (!diaEl || !jgEl || !d32El || !rpmEl) return;
      const res = calculateFlotationGorainKineticRate({
        rotorDiaM: Number(diaEl.value) || 0.61,
        jgCmS: Number(jgEl.value) || 1.5,
        d32Mm: Number(d32El.value) || 1.6,
        rotorRpm: Number(rpmEl.value) || 215
      });
      if (sbOut) sbOut.textContent = String(res.sbInverseSeconds);
      if (vtipOut) vtipOut.textContent = String(res.tipSpeedMS);
      if (kOut) kOut.textContent = String(res.rateConstantMin);
      if (readoutBox) {
        readoutBox.style.background = res.gorainCompliant ? '#ecfdf5' : '#fffbeb';
        readoutBox.style.color = res.gorainCompliant ? '#065f46' : '#92400e';
      }
    }

    [diaEl, jgEl, d32El, rpmEl].forEach((el) => {
      el?.addEventListener('input', updateGorain);
      el?.addEventListener('change', updateGorain);
    });
    updateGorain();
  }

  initFlotationCellsGorainPanelEn();
</script>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #1e293b;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #1e293b;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--smat-copper-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #1e293b;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #1e293b;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
