---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import rolesData from '../../../../data/roles.json';

const flotVertical = rolesData.verticals.find((v) => v.id === 'flotacion');
const celdaRole = flotVertical?.capex?.find((r) => r.role_id === 'celda_completa');
const criteria = celdaRole?.decision_criteria;
---

<BaseLayout 
  title="Mechanisms for Flotation Cells & Conditioners (50 to 300 ft³) | SMAT Minerals"
  description="Complete mechanisms for flotation cells and conditioners (50 to 300 ft³) for Rougher, Cleaner, and Scavenger circuits. Durango, Mexico."
  lang="en"
  canonicalPath="/en/flotation/cells/"
  alternateEsPath="/flotacion/celdas/"
  alternateEnPath="/en/flotation/cells/"
>
  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-capex">CONCENTRATION CIRCUIT • 50 TO 300 FT³</span>
      <h1>Mechanisms for Flotation Cells & Conditioners</h1>
      <p class="subtitle">Bearing housings, hollow aeration shafts, standpipes, and impeller-diffuser assemblies for 50 to 300 ft³ (1.4 to 8.5 m³) cells and conditioning tanks.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <div style="margin-bottom: 1.75rem;">
          <TechnicalDiagrams type="flotation" lang="en" />
        </div>
        <h2>Air Dispersion & Slurry Suspension Engineering</h2>
        <p>
          SMAT Minerals mechanisms for flotation cells and conditioners are engineered to maximize particle-bubble collision and keep coarse solids in uniform suspension without dead zones on the tank floor.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Operating Parameter</th>
              <th>SMAT Technical Specification</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Cell Capacity Range</td>
              <td>50 ft³ (1.4 m³), 100 ft³ (2.8 m³), 200 ft³ (5.6 m³), 300 ft³ (8.5 m³)</td>
            </tr>
            <tr>
              <td>Circuit Configuration</td>
              <td>Reagent conditioning, roughing, cleaning, and scavenging duty stages</td>
            </tr>
            <tr>
              <td>Aeration Mode</td>
              <td>Self-aspirating or low-pressure air assisted with homogeneous radial dispersion</td>
            </tr>
            <tr>
              <td>Mechanism Components</td>
              <td>Bearing housing, sheaves, flanged hollow shaft, standpipe, impeller, and diffuser</td>
            </tr>
            <tr>
              <td>Wetted Materials</td>
              <td>Molded Polyurethane and Natural Rubber resistant to collectors and frothers</td>
            </tr>
            <tr>
              <td>Power Rating & Throughput Range</td>
              <td>{celdaRole?.power_range || '15 HP to 60 HP per mechanism'} • {celdaRole?.flow_range || '200 to 1,500 t/d circuits'}</td>
            </tr>
            <tr>
              <td>JKMRC Flotation Kinetics (Gorain 1997)</td>
              <td>Bubble Surface Area Flux S<sub>b</sub> = 6 J<sub>g</sub> / d<sub>32</sub> (50–65 s<sup>-1</sup>) with first-order rate constant k = P · S<sub>b</sub> · R<sub>f</sub></td>
            </tr>
          </tbody>
        </table>

        {criteria && (
          <div class="decision-criteria-panel" data-testid="role-decision-criteria" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid #9a3412;">
            <span class="badge badge-copper">METALLURGICAL DECISION CRITERIA • ROLES.JSON</span>
            <h3 style="margin: 0.45rem 0 0.75rem; font-size: 1.08rem; color: var(--smat-text-primary);">Cell & Conditioner Selection Matrix ({celdaRole?.series})</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem; font-size: 0.88rem;">
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: var(--smat-text-primary); margin-bottom: 0.25rem;">Required Slurry Variables</strong>
                <span style="color: #334155;">{criteria.required_slurry_vars_en}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #7c2d12; margin-bottom: 0.25rem;">Tank & Lining Specification Rule</strong>
                <span style="color: #334155;">{criteria.metallurgy_rule_en}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #14532d; margin-bottom: 0.25rem;">Operational Risk Mitigated</strong>
                <span style="color: #334155;">{criteria.risk_avoided_en}</span>
              </div>
            </div>
          </div>
        )}

        <div class="flotation-selector-box" data-testid="flotation-contextual-selector" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #fffbeb; border: 1px solid #fde68a;">
          <span class="badge badge-copper">CONTEXTUAL PRE-SELECTION • WORKBENCH BRIDGE</span>
          <h3 style="margin: 0.45rem 0 0.5rem; font-size: 1.05rem; color: var(--smat-text-primary);">Select Cell Volume & Operating Duty</h3>
          <p style="font-size: 0.88rem; color: #475569; margin-bottom: 0.85rem;">
            Pre-populate cell capacity (50 to 300 ft³) and chemical/abrasion regime directly in the RFQ quotation workbench:
          </p>
          <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=50ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">50 ft³ (1.4 m³) • Sulfides</a>
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">100 ft³ (2.8 m³) • Sulfides</a>
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=200ft&flot_condition=reactivos_espuma#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">200 ft³ (5.6 m³) • Reagents / Froth</a>
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=300ft&flot_condition=arena_gruesa_fondo#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">300 ft³ (8.5 m³) • Coarse Floor Sand</a>
          </div>
        </div>

        <SharePurchasing 
          roleTitle="Mechanism for Flotation Cell & Conditioner"
          series="Capacities from 50 to 300 ft³ (1.4 to 8.5 m³)"
          metallurgy="A36 Structural Steel, Polyurethane / Rubber Impeller & Diffuser"
          specs="Complete suspended mechanism with bearing housing, hollow aeration shaft, standpipe, and impeller-diffuser."
          roleId="celda_flotacion"
          circuit="flotacion"
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">TECHNICAL ENGINEERING IN DURANGO</span>
            <h3>Need mechanisms for flotation cells or conditioning tanks?</h3>
            <p>Request a formal quote specifying cell capacity (ft³) or conditioning tank dimensions.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq" class="btn btn-primary btn-lg">
              Request Quotation →
            </a>
            <a href="https://wa.me/526183670664?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20Mechanisms%20for%20Flotation%20Cells%20and%20Conditioners" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Quote via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--smat-copper-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
