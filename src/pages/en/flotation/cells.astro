---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
---

<BaseLayout 
  title="Complete Mechanical Flotation Cells (50 to 300 ft³) | SMAT Minerals"
  description="Sub-aerated mechanical flotation cells for Rougher, Cleaner, and Scavenger circuits in cylindrical and rectangular tanks with high-kinetic mechanisms."
  lang="en"
  canonicalPath="/en/flotation/cells/"
  alternateEsPath="/flotacion/celdas/"
  alternateEnPath="/en/flotation/cells/"
>
  <Header slot="header" lang="en" currentPath="/en/flotation/cells/" alternatePath="/flotacion/celdas/" />

  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-capex">CAPEX • ACTIVE COMMERCIAL LINE</span>
      <h1>Complete Mechanical Flotation Cells</h1>
      <p class="subtitle">Standard volumes from 50 to 300 ft³ (1.4 to 8.5 m³) for maximum mineral concentrate recovery.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <h2>High-Kinetic Hydrodynamic Tank & Mechanism Geometry</h2>
        <p>
          SMAT Minerals flotation cells are an active commercial product line engineered to maximize collision frequency between hydrophobic mineral particles and micro-fine air bubbles. Deep U-shaped bottom profiles eliminate dead zones and prevent coarse sand settling along tank floors.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Operating Parameter</th>
              <th>SMAT Technical Specification</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Capacity Range</td>
              <td>50 ft³ (1.4 m³), 100 ft³ (2.8 m³), 200 ft³ (5.6 m³), 300 ft³ (8.5 m³)</td>
            </tr>
            <tr>
              <td>Circuit Configuration</td>
              <td>Roughing, cleaning, and scavenging duty stages</td>
            </tr>
            <tr>
              <td>Aeration Mode</td>
              <td>Self-aspirating or low-pressure blower assisted with homogeneous radial dispersion</td>
            </tr>
            <tr>
              <td>Tank & Launders</td>
              <td>Heavy structural steel welded tank with adjustable perimeter froth launder and dart valves</td>
            </tr>
            <tr>
              <td>Pulp Level Control</td>
              <td>Tailings junction box with automated pneumatic or manual dart level actuators</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Complete Mechanical Flotation Cell"
          series="Capacities from 50 to 300 ft³ (1.4 to 8.5 m³)"
          metallurgy="A36 Structural Steel Tank, Polyurethane / Rubber Mechanism"
          specs="Complete mechanical flotation cell with tank, suspended mechanism, hollow aeration shaft, concentrate launder, and dart valve level control."
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">INSTANT QUOTE DIRECT FROM CENTRAL FACILITY</span>
            <h3>Need flotation cells to expand your mineral recovery circuit?</h3>
            <p>Configure your project for individual cells or full flotation banks with official serialized requisition.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/?equipo=celda_flotacion#rfq" class="btn btn-primary btn-lg">
              Quote Flotation Cell in Central Workbench →
            </a>
            <a href="https://wa.me/526183670664?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20Flotation%20Cells" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Inquire Availability via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton lang="en" />
  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
