---
// src/pages/en/thank-you.astro
// Decisión 7-A: Formal Printable Requisition Sheet (@media print) for ERPs (SAP Ariba / Coupa / Oracle)
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Formal Requisition Receipt & Quotation Folio"
  description="Formal engineering requisition receipt with institutional folio for corporate purchasing departments and enterprise ERP systems."
  lang="en"
  canonicalPath="/en/thank-you/"
  alternateEsPath="/acuse/"
  alternateEnPath="/en/thank-you/"
>
  <main class="ack-main">
    <div class="container ack-container">
      
      <!-- Executive Printable Requisition Sheet -->
      <div class="requisition-sheet" id="print-sheet">
        <!-- Corporate Printable Letterhead -->
        <div class="sheet-header">
          <div class="company-brand">
            <span class="brand-logo-text">SMAT MINERALS</span>
            <span class="brand-legacy">Mineral Processing Equipment & Critical Spares</span>
            <span class="brand-address">Fiscal HQ: Mariano Salas #114, Durango, Mexico ZIP 34166 • Durango Central Warehouse</span>
            <span class="brand-contact">Phone: +52 (618) 810-4408 / 4428 • ventas@smatminerals.com • smatminerals.com</span>
          </div>
          <div class="folio-box">
            <span class="folio-label">REQUISITION FOLIO</span>
            <strong class="folio-value" id="display-folio">SMAT-2026-RFQ</strong>
            <span class="folio-date" id="display-date">Issue Date</span>
            <span class="folio-status" id="display-urgency">STATUS: RECEIVED</span>
          </div>
        </div>

        <div class="sheet-divider"></div>

        <div class="sheet-title-bar">
          <h2 id="dossier-title">FORMAL ENGINEERING REQUISITION & QUOTATION RECEIPT</h2>
          <span class="badge-sla" id="dossier-order-code">PRIORITY cμ TRIAGE • DURANGO WAREHOUSE FIT CHECK</span>
        </div>

        <!-- Applicant & Mine Unit Information Table -->
        <div class="sheet-section">
          <h3 class="section-title">1. APPLICANT & MINING FACILITY DETAILS</h3>
          <table class="sheet-table">
            <tbody>
              <tr>
                <th style="width: 25%;">Applicant Name / Role:</th>
                <td style="width: 35%;" id="field-name">Not specified</td>
                <th style="width: 20%;">Mine / Company:</th>
                <td style="width: 20%;" id="field-company">Not specified</td>
              </tr>
              <tr>
                <th>Phone / WhatsApp:</th>
                <td id="field-phone">Not specified</td>
                <th>Corporate Email:</th>
                <td id="field-email">Not specified</td>
              </tr>
              <tr>
                <th>Delivery Destination:</th>
                <td colspan="3" id="field-destination">Durango Central Warehouse / Folio Scheduled Pickup</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Technical Specification Requested Table -->
        <div class="sheet-section">
          <h3 class="section-title">2. COMPONENT / EQUIPMENT SPECIFICATION</h3>
          <table class="sheet-table">
            <tbody>
              <tr>
                <th style="width: 25%;">Line / Component:</th>
                <td style="width: 35%;" id="field-role" class="highlight-spec">Equipment under review</td>
                <th style="width: 20%;">SMAT / Part Code:</th>
                <td style="width: 20%; font-family: monospace; font-weight: 700;" id="field-code">To be assigned on review</td>
              </tr>
              <tr>
                <th>Internal Reference / Tag:</th>
                <td id="field-client-ref">No nameplate reference declared</td>
                <th>Field Dimensions (Tape Measure):</th>
                <td id="field-dimensions">1:1 pattern check at Durango warehouse</td>
              </tr>
              <tr>
                <th>Process Slurry Notes:</th>
                <td colspan="3" id="field-details">Technical review in accordance with engineering protocols.</td>
              </tr>
              <tr>
                <th>Hydraulic Memory (Durand):</th>
                <td colspan="3" id="field-hydraulics">Hydraulic calculation subject to plant flow rate and % solids confirmation.</td>
              </tr>
              <tr>
                <th>Metallurgy, Drive & Station:</th>
                <td colspan="3" id="field-material-drive">High Chrome ASTM A532 Cr27% (>600 HB) • ZVZ Drive • Station S4 (Wet-End)</td>
              </tr>
              <tr>
                <th>Axial Clearance (δ) & Kinematics:</th>
                <td colspan="3" id="field-clearance-kinematics">δ = 0.75 mm (Optimal, Δη_v = -0.3%) • u₂ ≤ 24.5 m/s • Certified ISO 281 L₁₀ₕ life</td>
              </tr>
              <tr id="row-field-metrology">
                <th>Metrological Memory (Lab):</th>
                <td colspan="3" id="field-metrology">No laboratory pre-calibration attached (Marcy Scale / Bond / Filter Press).</td>
              </tr>
              <tr>
                <th>Continuity & Slurry Profile:</th>
                <td colspan="3" id="field-tco">Operational continuity assessment at Durango Central Warehouse.</td>
              </tr>
              <tr>
                <th>Requisition Type:</th>
                <td id="field-type">Wear Spare Part / Operational Continuity</td>
                <th>Warehouse Inspection:</th>
                <td>Durango Central Warehouse (ISO 2768-m Geometric Triplet A, B, C Fit Check)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Technical Protocol & Durango Central Warehouse Verification (Decisions 1-C, 2-C and 6-C) -->
        <div class="sheet-section terms-section">
          <h3 class="section-title">3. TECHNICAL PROTOCOL & QUALITY CONTROL AT CENTRAL WAREHOUSE</h3>
          <p class="terms-text">
            This document certifies formal intake of your procurement requisition under the unique institutional folio. All rotating assemblies, impellers, and pump casings supplied by SMAT Minerals include certified High Chrome 27% (A05) melt metallurgy with guaranteed hardness &gt;650 HB (ASTM A532 HRC &ge; 58), ISO 2768-m geometric triplet (A, B, C) dimensional fit verification, and priority cμ triage at SMAT Durango facilities (Fiscal HQ: Mariano Salas #114).
          </p>
          <div class="coyote-seal-notice facility-guarantee-notice" id="vendor-passport-section">
            <strong>Central Warehouse Validity &amp; B2B Vendor Passport Clause:</strong> This technical proposal and operational backing are valid for components inspected and dispatched from Durango Central Warehouse (Incoterms EXW / DAP Durango • UNSPSC 40151500 / 20121500 / 40161500 / 41111500 • ASTM A532 Cr27 Melt Cert HRC &ge; 58). Complete equipment and coupled packages are built-to-order based on customer slurry variables; common wear parts maintain continuous inventory rotation.
          </div>
          <pre id="sap-plaintext-block" style="margin: 1rem 0 0; padding: 0.85rem; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; font-family: monospace; font-size: 0.76rem; color: #0f172a; overflow-x: auto; white-space: pre-wrap;">FOLIO: SMAT-2026-RFQ | DETERMINISTIC FNV-1a ORDER</pre>
          <div class="signatures-row">
            <div class="sig-block">
              <span class="sig-line"></span>
              <span class="sig-caption">Application Engineering & Sales<br />SMAT Minerals Mexico</span>
            </div>
            <div class="sig-block">
              <span class="sig-line"></span>
              <span class="sig-caption">Requisition Receipt<br />Purchasing / Maintenance Dept.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Screen Actions (Hidden on Print) -->
      <div class="screen-actions no-print">
        <button type="button" class="btn btn-primary btn-print" id="print-btn" onclick="window.print()">
          Print / Save as PDF (SAP / Coupa)
        </button>
        <button type="button" class="btn btn-secondary" id="copy-sap-acuse-btn">
          Copy SAP / Ariba Text
        </button>
        <button type="button" class="btn btn-secondary" id="download-tsv-acuse-btn">
          Download TSV / Excel
        </button>
        <button type="button" class="btn btn-secondary" id="download-vendor-vcard-btn">
          Vendor Passport (.vcf)
        </button>
        <button type="button" class="btn btn-secondary" id="download-vendor-json-btn">
          ERP Onboarding (.json)
        </button>
        <a href="/en/quote/?reorder=1&tray=SKU-QC-01:1:PARO_DE_LINEA#rfq" class="btn btn-secondary" id="reorder-ss-link">
          1-Click (s, S) Policy Reorder
        </a>
        <a href="/en/" class="btn btn-secondary">
          Return Home
        </a>
        <a href="https://wa.me/526183670664" class="btn btn-emergency" target="_blank" rel="noopener noreferrer">
          Immediate Follow-up via WhatsApp
        </a>
      </div>

    </div>
  </main>
</BaseLayout>

<script is:inline>
  (function() {
    function populateSheet() {
      const urlParams = new URLSearchParams(window.location.search);
      let cached = {};
      let wbV2 = {};
      let trayState = { items: [], coreReturnEnabled: false };
      try {
        const raw = sessionStorage.getItem('smat_last_rfq_payload');
        if (raw) cached = JSON.parse(raw) || {};
      } catch (_e) {}
      try {
        const rawV2 = localStorage.getItem('smat_workbench_state_v2') || localStorage.getItem('smat_workbench_session');
        if (rawV2) wbV2 = JSON.parse(rawV2) || {};
      } catch (_e) {}
      try {
        const rawTray = localStorage.getItem('smat_requisition_tray_v3');
        if (rawTray) trayState = JSON.parse(rawTray) || { items: [], coreReturnEnabled: false };
      } catch (_e) {}

      // Bidirectional PutGet Hydration from ?reorder=1&tray=... or ?sku=... (SLICE-V31-09 · D6 & D9)
      const trayQueryParam = urlParams.get('tray') || '';
      const skuQueryParam = urlParams.get('sku') || '';
      if (trayQueryParam) {
        const parsedItems = trayQueryParam.split(',').map((s) => s.trim()).filter(Boolean).map((entry) => {
          const [id, qtyStr, crit] = entry.split(':');
          return {
            id: String(id || 'SKU-QC-01').toUpperCase(),
            skuId: String(id || 'SKU-QC-01').toUpperCase(),
            qty: Math.max(1, Number(qtyStr) || 1),
            criticalityMode: crit === 'STOCK_SS' ? 'STOCK_SS' : 'PARO_DE_LINEA'
          };
        });
        if (parsedItems.length > 0) {
          trayState.items = parsedItems;
          try {
            localStorage.setItem('smat_requisition_tray_v3', JSON.stringify(trayState));
          } catch (_e) {}
        }
      } else if (skuQueryParam && (!Array.isArray(trayState.items) || trayState.items.length === 0)) {
        trayState.items = [{ id: skuQueryParam.toUpperCase(), skuId: skuQueryParam.toUpperCase(), qty: 1, criticalityMode: 'PARO_DE_LINEA' }];
      }

      const traySummary = Array.isArray(trayState.items) && trayState.items.length > 0
        ? trayState.items.map((i) => `${i.id}x${i.qty || 1}`).join(', ')
        : '';
      if (traySummary) {
        wbV2.traySkuSummary = traySummary;
        wbV2.clientRef = wbV2.clientRef || traySummary;
        try {
          localStorage.setItem('smat_workbench_state_v2', JSON.stringify(wbV2));
        } catch (_e) {}
      }

      const computeFnv1aOrderHash = (seedStr) => {
        let h = 0x811c9dc5;
        for (let i = 0; i < seedStr.length; i++) {
          h ^= seedStr.charCodeAt(i);
          h = Math.imul(h, 0x01000193) >>> 0;
        }
        return 'SMAT-ORD-' + h.toString(16).toUpperCase().padStart(8, '0').slice(0, 6);
      };

      const folio = urlParams.get('folio') || cached.folio || wbV2.folio || 'SMAT-' + new Date().getFullYear() + '-' + Math.floor(1000 + Math.random() * 9000);
      const nombre = urlParams.get('nombre') || urlParams.get('name') || cached.nombre || wbV2.name || 'Plant Engineer / Requisitioner';
      const empresa = urlParams.get('empresa') || urlParams.get('company') || cached.empresa || wbV2.company || 'Registered Mining Operation';
      const telefono = urlParams.get('telefono') || urlParams.get('phone') || cached.telefono || wbV2.phone || '+52 (618) 810-4408';
      const correo = urlParams.get('correo') || urlParams.get('email') || cached.correo || wbV2.email || 'ventas@smatminerals.com';
      const equipo = urlParams.get('equipo') || urlParams.get('role') || cached.equipo || wbV2.equipTitle || 'Critical Slurry Pumping Wear Replacement';
      const codigo = urlParams.get('codigo') || cached.codigo_smat || wbV2.equipCode || '';
      const pieza = urlParams.get('pieza') || cached.codigo_pieza_atomica || wbV2.atomicPartCode || '';
      const refCliente = urlParams.get('ref_cliente') || cached.referencia_cliente || wbV2.clientRef || 'No internal reference declared';
      const medidas = urlParams.get('medidas') || cached.medidas_flexometro || '1:1 dimensional verification at Durango Warehouse';
      const perfilPulpa = urlParams.get('perfil_pulpa') || cached.perfil_pulpa_mina || '';
      const phVal = urlParams.get('ph') || cached.pulp_ph || wbV2.pulpPh || '7.5';
      const flVal = urlParams.get('fl') || cached.durand_fl || wbV2.durandFactorFL || '';
      const cvVal = urlParams.get('cv') || cached.solids_cv_pct || wbV2.solidsVolumetricPercent || '';
      const vRecVal = urlParams.get('v_rec') || cached.recommended_velocity_ms || wbV2.recommendedPipeVelocityMs || '';
      const erVal = urlParams.get('eff_ratio_er') || cached.eff_ratio_er || wbV2.eff_ratio_er || '0.88';
      const impLifeVal = urlParams.get('impeller_life_h') || cached.impeller_life_h || wbV2.impeller_life_h || '2800';
      const wearRatioVal = urlParams.get('wear_life_ratio') || cached.wear_life_ratio || wbV2.wear_life_ratio || '3.8';
      const pAtmMcaVal = urlParams.get('p_atm_mca') || cached.p_atm_mca || wbV2.p_atm_mca || '7.98';
      const deltaNpshVal = urlParams.get('delta_npsh_m') || cached.delta_npsh_m || wbV2.delta_npsh_m || '2.35';
      const motorDeratingVal = urlParams.get('motor_derating_iec') || cached.motor_derating_iec || wbV2.motor_derating_iec || '0.920';
      const kMotorAltVal = urlParams.get('k_motor_alt') || cached.k_motor_alt || wbV2.k_motor_alt || '1.24';
      const pipeVelLossVal = urlParams.get('pipe_vel_loss_pct') || cached.pipe_vel_loss_pct || wbV2.pipe_vel_loss_pct || '0.3';
      const gateClassVal = urlParams.get('gate_classification') || cached.gate_classification || wbV2.gate_classification || 'STANDARD_PROJECT';
      const hidraulicaBase = urlParams.get('hidraulica') || cached.memoria_hidraulica_durand || 'Hydraulic calculation subject to plant flow rate and % solids confirmation.';
      const hidraulicaExtras = [
        `pH = ${phVal}`,
        flVal ? `F_L = ${flVal}` : '',
        cvVal ? `C_v = ${cvVal}%` : '',
        vRecVal ? `v_rec = ${vRecVal} m/s` : '',
        `η_r = ${erVal}`,
        `Impeller Life = ${impLifeVal} h (${wearRatioVal}x)`,
        `P_atm = ${pAtmMcaVal} mca (ΔNPSH = -${deltaNpshVal} m)`,
        `f_IEC = ${motorDeratingVal} (K_motor,alt = ${kMotorAltVal}x)`
      ].filter(Boolean).join(' | ');
      const hidraulica = hidraulicaBase.includes('K_motor,alt') ? hidraulicaBase : `${hidraulicaBase} (${hidraulicaExtras})`;
      const tco = urlParams.get('tco') || cached.proyeccion_tco || '';
      const detalles = urlParams.get('detalles') || urlParams.get('specs') || cached.especificacion_tecnica || wbV2.notes || 'Technical requisition subject to Durango yard dimensional inspection.';
      const destino = urlParams.get('destino') || cached.modalidad_logistica || 'Durango Central Warehouse Pickup (Folio Scheduled)';
      const urgencia = urlParams.get('urgencia') || (cached.urgencia && cached.urgencia.includes('PARO') ? 'paro' : (wbV2.urgency || 'proyecto'));
      const material = urlParams.get('material') || cached.material_bombeo || wbV2.pump_material || wbV2.selectedMaterial || 'alto_cromo_cr27';
      const transmision = urlParams.get('transmision') || urlParams.get('arreglo') || cached.arreglo_transmision || wbV2.drive_arrangement || wbV2.driveArrangement || 'ZVZ';
      const estacion = urlParams.get('estacion') || cached.estacion_armado || wbV2.stationCode || 'S4';
      const sealBranch = urlParams.get('seal_branch') || cached.rama_sellado || wbV2.seal_branch || wbV2.sealBranch || 'expeller_dry';
      const pesoKg = urlParams.get('peso_kg') || cached.peso_pieza_kg || wbV2.partMassKg || wbV2.weight_kg || '';
      const claroMm = urlParams.get('claro_mm') || cached.claro_axial_mm || wbV2.clearance_mm || wbV2.clearanceMm || '0.75';
      const b2Mm = urlParams.get('b2_mm') || cached.ancho_impulsor_b2_mm || wbV2.b2_mm || wbV2.impellerExitWidthMm || '48';
      const capCKn = urlParams.get('cap_c_kn') || cached.capacidad_rodamiento_c_kn || wbV2.cap_c_kn || wbV2.dynamicCapacityCkN || '185';
      const trustBoundaryId = urlParams.get('trust_boundary_id') || cached.trust_boundary_id || wbV2.trust_boundary_id || 'NONE';
      const deltaEtaV = urlParams.get('delta_eta_v') || cached.perdida_eficiencia_vol_pct || wbV2.volumetricEfficiencyDropPct || '0.3';
      const u2Ms = urlParams.get('u2_ms') || cached.velocidad_periferica_u2_ms || wbV2.tipSpeedU2Ms || '22.4';
      const n2Rpm = urlParams.get('n2_rpm') || cached.n2_rpm || (wbV2.kinematics && wbV2.kinematics.pumpRpm) || '1149';
      const frKn = urlParams.get('fr_kn') || cached.fr_kn || (wbV2.kinematics && wbV2.kinematics.beltRadialLoadKn) || '5.20';
      const floodImm = urlParams.get('inmunidad_sumidero') || cached.inmunidad_sumidero || (wbV2.kinematics && wbV2.kinematics.sumpFloodImmunity) || 'HIGH';
      const structReason = urlParams.get('razon_estructural') || cached.razon_estructural || (wbV2.clearance_eval && (wbV2.clearance_eval.structuralReasonEn || wbV2.clearance_eval.structuralReasonEs)) || '';
      const l10h = urlParams.get('l10h') || cached.vida_rodamiento_l10h || wbV2.l10hHours || '38500';
      const rhopVal = urlParams.get('rhop') || cached.densidad_mineral_rhop || wbV2.oreDensitySg || '';
      const libUmVal = urlParams.get('lib_um') || wbV2.lib_um || '';
      const gradeVal = urlParams.get('grade') || wbV2.grade || '';
      const airPsiVal = urlParams.get('air_psi') || wbV2.air_psi || '';
      const rrNVal = urlParams.get('rr_n') || wbV2.rr_n || '';
      const retP80Val = urlParams.get('ret_p80') || wbV2.ret_p80 || '';
      const metrologiaBase = urlParams.get('metrologia') || cached.memoria_metrologica || '';
      const metroExtras = [
        libUmVal ? `d_l=${libUmVal} µm` : '',
        gradeVal ? `a_L=${gradeVal}%` : '',
        airPsiVal ? `P_air=${airPsiVal} PSI` : '',
        rrNVal ? `n=${rrNVal}` : '',
        retP80Val ? `R(P80)=${retP80Val}%` : ''
      ].filter(Boolean).join(' | ');
      const metrologia = metrologiaBase
        ? (metroExtras && !metrologiaBase.includes('d_l=') ? `${metrologiaBase} (${metroExtras})` : metrologiaBase)
        : (rhopVal ? `Ore density ρ_p = ${rhopVal} t/m³ calibrated at metrology station${metroExtras ? ' (' + metroExtras + ')' : ''}.` : 'No laboratory pre-calibration attached (Marcy Scale / Bond / Filter Press).');

      const elFolio = document.getElementById('display-folio');
      if (elFolio) elFolio.textContent = folio;

      const elDate = document.getElementById('display-date');
      if (elDate) {
        const now = new Date();
        elDate.textContent = now.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
      }

      const elUrgency = document.getElementById('display-urgency');
      if (elUrgency) {
        elUrgency.textContent = urgencia === 'paro' ? 'PRIORITY: PLANT SHUTDOWN' : 'PRIORITY: SCHEDULED PROJECT';
        if (urgencia === 'paro') elUrgency.style.color = '#ef4444';
      }

      const setText = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      const fullCode = [codigo, pieza ? `[Part: ${pieza}]` : '', traySummary ? `[Tray: ${traySummary}]` : ''].filter(Boolean).join(' ') || 'SMAT-STD (1:1 Fit)';
      const orderHashCode = computeFnv1aOrderHash(`${fullCode}|${material}|${transmision}|${estacion}`);
      setText('dossier-order-code', `${orderHashCode} • PRIORITY cμ TRIAGE DURANGO HUB`);
      if (traySummary) {
        setText('dossier-title', `FORMAL ENGINEERING REQUISITION & QUOTATION RECEIPT (${traySummary})`);
      }
      const fullTcoAndProfile = [
        perfilPulpa ? `Mineral Profile: ${perfilPulpa}` : '',
        tco ? `Operational Impact: ${tco}` : '',
        trayState.coreReturnEnabled ? 'Circular Economy Core Trade-In: -22% on DAM005 Cartridge (INV-SMAT-SCI-06)' : ''
      ].filter(Boolean).join(' • ') || 'Operational continuity assessment at Durango Central Warehouse.';

      setText('field-name', nombre);
      setText('field-company', empresa);
      setText('field-phone', telefono);
      setText('field-email', correo);
      setText('field-destination', destino);
      setText('field-role', equipo);
      setText('field-code', fullCode);
      setText('field-client-ref', refCliente);
      setText('field-dimensions', medidas);
      setText('field-details', detalles);
      setText('field-hydraulics', hidraulica);
      const matLabel = material === 'hule_natural'
        ? 'Anti-Abrasion Natural Rubber R55 (55–65 Shore A)'
        : (material === 'poliuretano'
          ? 'Mining Polyurethane U01 (85–95 Shore A)'
          : ((material === 'ceramica_sic' || material === 'carburo_silicio')
            ? 'Sintered Silicon Carbide SiC (≥2200 HV, Mohs 9.2, K_Ic=4.1 MPa·√m)'
            : 'High Chrome ASTM A532 Cr27% (>600 HB)'));
      const sealLabel = sealBranch === 'gland_water' ? 'S5b Flushed Gland Packing' : 'S5a Dry Centrifugal Expeller';
      const wNum = Number(pesoKg) || 0;
      const liShaft = wNum > 0 ? (wNum / 11.1).toFixed(2) : '0.00';
      const nioshTier = wNum >= 23
        ? `HOIST_REQUIRED: Mandatory Hoist / Crane (≥23 kg NIOSH, LI_shaft=${liShaft})`
        : (wNum > 11.1
          ? `ASSISTED_SHAFT_MOUNT_2P: 2-Tech Assisted Shaft Mount (11.1–23 kg Waters-NIOSH, RWL_shaft=11.1 kg, LI_shaft=${liShaft})`
          : `MANUAL_SAFE_1P: Safe 1-Tech Manual Handling (≤11.1 kg Waters-NIOSH, LI_shaft=${liShaft})`);
      const nioshLabel = pesoKg ? ` • Weight: ${pesoKg} kg (${nioshTier})` : '';
      setText('field-material-drive', `${matLabel} • V-Belt Drive: ${transmision} (Sump: ${floodImm}) • Station: ${estacion} (${sealLabel})${nioshLabel}`);
      setText('field-clearance-kinematics', `Axial Clearance δ = ${claroMm} mm (b₂ = ${b2Mm} mm, Δη_v = -${deltaEtaV}%, Δv_pipe = -${pipeVelLossVal}%) • n₂ = ${n2Rpm} RPM • u₂ = ${u2Ms} m/s • F_r = ${frKn} kN • C = ${capCKn} kN (ISO 281 Life L₁₀ₕ = ${Number(l10h).toLocaleString('en-US')} h)${structReason ? ' • ' + structReason : ''}`);
      setText('field-metrology', metrologia);
      setText('field-tco', fullTcoAndProfile);
      setText('field-type', `${urgencia === 'paro' ? 'Emergency Plant Shutdown' : 'Formal Equipment Requisition / Project'} [${gateClassVal}${trustBoundaryId !== 'NONE' ? ' • ' + trustBoundaryId : ''}]`);

      const sapBlockText = [
        `FOLIO: ${folio} | ORDER_HASH: ${orderHashCode} | GATE: ${gateClassVal} | BOUNDARY: ${trustBoundaryId}`,
        `COMPANY: ${empresa} | REQUESTER: ${nombre}`,
        `EQUIPMENT: ${equipo} (${fullCode})`,
        `METALLURGY & DRIVE: ${matLabel} | ${transmision} (Sump: ${floodImm}) | ${estacion} (${sealLabel})${nioshLabel}`,
        `HYDRAULICS & ALTITUDE: ${hidraulica}`,
        `KINEMATICS: delta=${claroMm}mm (b2=${b2Mm}mm, dEtaV=-${deltaEtaV}%, dvPipe=-${pipeVelLossVal}%), n2=${n2Rpm}RPM, u2=${u2Ms}m/s, Fr=${frKn}kN, C=${capCKn}kN, L10h=${l10h}h${structReason ? ' | ' + structReason : ''}`,
        `METROLOGY: ${metrologia}`
      ].join('\n');
      setText('sap-plaintext-block', sapBlockText);

      const copySapBtn = document.getElementById('copy-sap-acuse-btn');
      if (copySapBtn) {
        copySapBtn.onclick = async () => {
          try {
            await navigator.clipboard.writeText(sapBlockText);
            copySapBtn.textContent = 'SAP Text Copied';
          } catch (_e) {}
        };
      }

      const dlTsvBtn = document.getElementById('download-tsv-acuse-btn');
      if (dlTsvBtn) {
        dlTsvBtn.onclick = () => {
          const headers = ['Folio', 'Gate', 'Boundary', 'Company', 'Requester', 'Equipment', 'Code', 'Material', 'Drive', 'Sump_Immunity', 'Station', 'Seal', 'Weight_kg', 'NIOSH_Waters_Tier', 'Clearance_mm', 'b2_mm', 'n2_RPM', 'u2_ms', 'Fr_kN', 'Capacity_C_kN', 'L10h_h', 'Er_Cave', 'Impeller_Life_h', 'Delta_NPSH_m', 'Derating_IEC', 'K_Motor_Alt', 'Pipe_Vel_Loss_pct', 'Structural_Reason', 'Hydraulics', 'Metrology'];
          const row = [folio, gateClassVal, trustBoundaryId, empresa, nombre, equipo, fullCode, matLabel, transmision, floodImm, estacion, sealLabel, pesoKg || '0', nioshTier, claroMm, b2Mm, n2Rpm, u2Ms, frKn, capCKn, l10h, erVal, impLifeVal, deltaNpshVal, motorDeratingVal, kMotorAltVal, pipeVelLossVal, structReason, hidraulica, metrologia];
          const tsv = headers.join('\t') + '\n' + row.map(v => String(v || '').replace(/[\t\r\n]+/g, ' ')).join('\t') + '\n';
          const blob = new Blob(['\uFEFF' + tsv], { type: 'text/tab-separated-values;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${folio}_SAP_ERP.tsv`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        };
      }

      const vcardBtn = document.getElementById('download-vendor-vcard-btn');
      if (vcardBtn) {
        vcardBtn.onclick = () => {
          const vcf = [
            'BEGIN:VCARD',
            'VERSION:3.0',
            'FN:SMAT Minerals S.A. de C.V.',
            'ORG:SMAT Minerals S.A. de C.V.;Application Engineering & Mining Supply',
            'TEL;TYPE=WORK,VOICE:+52-618-810-4408',
            'TEL;TYPE=CELL,VOICE:+52-618-367-0664',
            'EMAIL;TYPE=PREF,INTERNET:ventas@smatminerals.com',
            'ADR;TYPE=WORK:;;Mariano Salas #114, Col. Nueva Vizcaya;Durango;DGO;34080;Mexico',
            'NOTE:UNSPSC 40151500 / 20121500 / 40161500 / 41111500 | Incoterms EXW/DAP Durango | ASTM A532 Cr27 HRC >= 58',
            'END:VCARD'
          ].join('\r\n');
          const blob = new Blob([vcf], { type: 'text/vcard;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'SMAT_Minerals_Vendor_Passport.vcf';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        };
      }

      const jsonBtn = document.getElementById('download-vendor-json-btn');
      if (jsonBtn) {
        jsonBtn.onclick = () => {
          const payload = {
            schema: 'smat.vendor.passport.v3',
            companyName: 'SMAT Minerals S.A. de C.V.',
            industrialHub: 'Mariano Salas #114, Durango, DGO, C.P. 34080, Mexico',
            incoterms: ['EXW Durango', 'DAP Mine Site'],
            unspscCodes: ['40151500', '20121500', '40161500', '41111500'],
            metallurgyCert: 'ASTM A532 Class III Type A Cr27 >= 650 HB / HRC >= 58'
          };
          const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'SMAT_Minerals_Vendor_Passport.json';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        };
      }

      const reorderLink = document.getElementById('reorder-ss-link');
      if (reorderLink) {
        try {
          const trayRaw = localStorage.getItem('smat_requisition_tray_v3');
          if (trayRaw) {
            const parsedTray = JSON.parse(trayRaw);
            if (parsedTray && Array.isArray(parsedTray.items) && parsedTray.items.length > 0) {
              const ser = parsedTray.items.map(i => `${encodeURIComponent(i.id)}:${i.qty}:STOCK_SS`).join(',');
              reorderLink.setAttribute('href', `/en/quote/?reorder=1&tray=${ser}#rfq`);
            }
          }
        } catch (_e) {}
      }
    }

    populateSheet();
    document.addEventListener('astro:page-load', populateSheet);
  })();
</script>

