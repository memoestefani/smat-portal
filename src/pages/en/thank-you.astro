---
// src/pages/en/thank-you.astro
// Canonical Bilingual Island AcuseSheetIsland (lang="en") without nested <main> (SLICE-V53-01)
import BaseLayout from '../../layouts/BaseLayout.astro';
import AcuseSheetIsland from '../../components/islands/AcuseSheetIsland.astro';
---

<BaseLayout
  title="Formal Requisition Receipt & Quotation Folio"
  description="Formal engineering requisition receipt with institutional folio for corporate purchasing departments and enterprise ERP systems."
  lang="en"
  canonicalPath="/en/thank-you/"
  alternateEsPath="/acuse/"
  alternateEnPath="/en/thank-you/"
>
  <AcuseSheetIsland lang="en" />
</BaseLayout>

<script>
  import { initAcuseSheetController, enrichTrayItemsPreservingMetadata } from '../../scripts/acuseSheetController.js';
  /* Canonical PutGet hydration (material === 'poliuretano' | 'ceramica_sic', Waters-NIOSH RWL_shaft = 11.1 kg) */
  initAcuseSheetController('en', { enrichTrayItemsPreservingMetadata });
</script>

<style>
  @media print {
    :global(#print-btn) {
      display: none !important;
    }
  }
</style>
