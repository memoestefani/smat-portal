---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import rolesData from '../../../../data/roles.json';

const filtVertical = rolesData.verticals.find((v) => v.id === 'filtracion');
const prensaRole = filtVertical?.capex?.find((r) => r.role_id === 'prensa_completa');
const criteria = prensaRole?.decision_criteria;
---

<BaseLayout 
  title="Filter Presses | SMAT Minerals"
  description="Hydraulic filter presses (up to 16 bar) for concentrate filtration and dry tailings dewatering with 800 to 1500 mm plates. Durango, Mexico."
  lang="en"
  canonicalPath="/en/filtration/press/"
  alternateEsPath="/filtracion/prensa/"
  alternateEnPath="/en/filtration/press/"
>
  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-capex">FILTRATION EQUIPMENT • 800 TO 1500 MM</span>
      <h1>Filter Presses</h1>
      <p class="subtitle">Hydraulic filtration equipment for mineral concentrates and dry tailings dewatering.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <div style="margin-bottom: 1.75rem;">
          <TechnicalDiagrams type="filter" lang="en" />
        </div>
        <h2>Filter Press Specifications</h2>
        <p>
          SMAT Minerals filter presses achieve residual cake moistures between 12% and 16%, enabling efficient concentrate handling and process water recovery.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Design Parameter</th>
              <th>SMAT Technical Specification</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Plate Size Range</td>
              <td>Recessed chamber and membrane squeeze plates from 800 x 800 mm to 1500 x 1500 mm</td>
            </tr>
            <tr>
              <td>Hydraulic Clamping Force</td>
              <td>Heavy hydraulic cylinder delivering clamping pressure up to 350 bar</td>
            </tr>
            <tr>
              <td>Filtration Pressure</td>
              <td>Slurry feed pressures from 8 bar to 16 bar</td>
            </tr>
            <tr>
              <td>Plate Shifting Mechanism</td>
              <td>Automated transfer carriage plate shifting or simultaneous block-opening system</td>
            </tr>
            <tr>
              <td>Control</td>
              <td>PLC control cabinet managing feed, press, and air-blow cake discharge cycles</td>
            </tr>
            <tr>
              <td>Electro-Hydraulic Power & Cycle Times</td>
              <td>{prensaRole?.power_range} • {prensaRole?.flow_range}</td>
            </tr>
            <tr>
              <td>Darcy-Ruth Cake Compressibility (Tiller 1975)</td>
              <td>Specific resistance α = α<sub>0</sub> (ΔP)<sup>s</sup> (s = 0.65) with 16 bar secondary squeeze for &lt; 15% moisture</td>
            </tr>
          </tbody>
        </table>

        {criteria && (
          <div class="decision-criteria-panel" data-testid="role-decision-criteria" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid #9a3412;">
            <span class="badge badge-copper">METALLURGICAL DECISION CRITERIA • ROLES.JSON</span>
            <h3 style="margin: 0.45rem 0 0.75rem; font-size: 1.08rem; color: var(--smat-text-primary);">Filter Press Selection Matrix ({prensaRole?.series})</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem; font-size: 0.88rem;">
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: var(--smat-text-primary); margin-bottom: 0.25rem;">Required Slurry Variables</strong>
                <span style="color: #334155;">{criteria.required_slurry_vars_en}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #7c2d12; margin-bottom: 0.25rem;">Chamber & Compression Rule</strong>
                <span style="color: #334155;">{criteria.metallurgy_rule_en}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #14532d; margin-bottom: 0.25rem;">Geotechnical & Operational Risk Mitigated</strong>
                <span style="color: #334155;">{criteria.risk_avoided_en}</span>
              </div>
            </div>
          </div>
        )}

        <div class="filtration-selector-box" data-testid="filtration-contextual-selector" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #fffbeb; border: 1px solid #fde68a;">
          <span class="badge badge-copper">CONTEXTUAL PRE-SELECTION • WORKBENCH BRIDGE</span>
          <h3 style="margin: 0.45rem 0 0.5rem; font-size: 1.05rem; color: var(--smat-text-primary);">Select Plate Size & Dewatering Duty</h3>
          <p style="font-size: 0.88rem; color: #475569; margin-bottom: 0.85rem;">
            Pre-populate recessed chamber plate size (800 to 2000 mm) and dewatering objective directly in the RFQ quotation workbench:
          </p>
          <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
            <a href="/en/quote/?circuito=filtracion&equipo=filtro_prensa&serie=800&filt_condition=ciclo_lento#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">800×800 mm Plates • Concentrates</a>
            <a href="/en/quote/?circuito=filtracion&equipo=filtro_prensa&serie=1200&filt_condition=jales_secos#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">1200×1200 mm Plates • Dry Tailings</a>
            <a href="/en/quote/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">1500×1500 mm Plates • Dry Stacking</a>
            <a href="/en/quote/?circuito=filtracion&equipo=filtro_prensa&serie=2000&filt_condition=jales_secos#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">2000×2000 mm Plates • High Tonnage</a>
          </div>
        </div>

        <SharePurchasing 
          roleTitle="Filter Press"
          series="Plates 800x800 to 1500x1500 mm (Pressure up to 16 bar)"
          metallurgy="Heavy Structural Steel Side Beams, Virgin Polypropylene Plates"
          specs="Hydraulic filter press with clamping cylinder, virgin polypropylene plate pack, and filter cloths."
          roleId="filtro_prensa"
          circuit="filtracion"
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">TECHNICAL ENGINEERING IN DURANGO</span>
            <h3>Need a filter press for concentrates or tailings dewatering?</h3>
            <p>Request a formal quote specifying plate dimensions or tonnage per shift.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/quote/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-primary btn-lg">
              Request Quotation →
            </a>
            <a href="https://wa.me/526183670664?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20Filter%20Presses" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Quote via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--smat-copper-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
