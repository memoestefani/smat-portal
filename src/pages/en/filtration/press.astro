---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FiltrationCalculatorIsland from '../../../components/islands/FiltrationCalculatorIsland.astro';

const title = 'Filter Presses | SMAT Minerals';
const description = 'Hydraulic filter presses (up to 16 bar) for concentrate filtration and dry tailings dewatering with 800 to 1500 mm plates. Durango, Mexico.';
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath="/en/filtration/press/"
  alternateEsPath="/filtracion/prensa/"
  alternateEnPath="/en/filtration/press/"
>
  <FiltrationCalculatorIsland locale="en" variant="press" mode="standalone" />
</BaseLayout>
