---
// src/pages/en/filtration/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import CircuitNavigator from '../../../components/CircuitNavigator.astro';
---

<BaseLayout 
  title="Filter Presses | SMAT Minerals"
  description="Recessed-chamber filter presses from 800 mm to 1500 mm, polypropylene filter plates, filter cloths, and hydraulic spares."
  lang="en"
>
  <section class="page-hero">
    <div class="container">
      <span class="badge badge-copper">FILTRATION & DEWATERING</span>
      <h1>Filter Presses</h1>
      <p style="font-size: 1.08rem; max-width: 720px; color: var(--smat-text-secondary);">
        Recessed-chamber filter presses, polypropylene filter plates, filter cloths, and hydraulic spares for mineral concentrates and tailings.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="filter" lang="en" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div class="card">
          <h3>Filter Presses</h3>
          <p>
            Recessed-chamber plate filter presses with electro-hydraulic closure for mineral concentrate and tailings dewatering, rated up to 16 bar pressing cycles.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Recessed chamber:</strong> 800 mm to 1500 mm • Up to 16 bar • 20–40 min cycles</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/en/filtration/press/" class="btn btn-outline">Technical Datasheet</a>
            <a href="/en/quote/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-primary">Quote</a>
          </div>
        </div>

        <div class="card">
          <h3>Filter Plates, Cloths & Hydraulic Spares</h3>
          <p style="font-family: var(--smat-font-mono); font-size: 0.82rem; color: var(--smat-copper-accent); font-weight: 700; margin-bottom: 0.35rem;">
            Recessed chamber from 800 mm to 1500 mm • $\alpha = \alpha_0 (\Delta P)^s$
          </p>
          <h4 style="margin: 0 0 0.5rem 0; font-size: 1rem;">Filter Cloths & Polypropylene Plates</h4>
          <p>
            Laser-cut filter cloths with thermally sealed edges and high-chemical-resistance polypropylene plates.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Material:</strong> Virgin Copolymer Polypropylene & Needle Felt</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/en/filtration/parts/" class="btn btn-outline">Technical Datasheet</a>
            <a href="/en/products/filter-press-cloths/" class="btn btn-outline">Cloths SKU-QC-17 →</a>
            <a href="/en/products/filter-press-polypropylene-plates/" class="btn btn-outline">Plates SKU-QC-18 →</a>
            <a href="/en/quote/?circuito=filtracion&equipo=placas_telas&serie=1500&filt_condition=fuga_chorreo#rfq" class="btn btn-primary">Quote</a>
          </div>
        </div>
      </div>

      <!-- SEMARNAT NOM-141 Dry Stacking & Polypropylene Plate Timoshenko Flexure Verifier (MVP v3.0 · D8) -->
      <div class="card" id="nom141-plate-flexure-verifier" style="margin-top: 2rem; padding: 1.75rem;">
        <span class="badge badge-copper" style="margin-bottom: 0.5rem;">SEMARNAT NOM-141 COMPLIANCE &amp; TIMOSHENKO FLEXURE • D8</span>
        <h2 style="margin-bottom: 0.5rem;">Polypropylene Plate Asymmetric Flexure &amp; Dry Stacking Cake Verifier</h2>
        <p style="color: var(--smat-text-secondary); margin-bottom: 1.25rem;">
          Evaluate maximum bending stress (σ<sub>max</sub>) under clogged feed ports and verify structural safety factor alongside dry-stacking residual cake moisture (&le; 16%).
        </p>

        <div class="grid-2" style="gap: 1.5rem; align-items: start;">
          <div style="display: grid; gap: 0.75rem;">
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Slurry Feed Pressure (bar):</span>
              <input type="number" id="filt-pressure-bar" min="4" max="25" step="1" value="12" style="width: 100px; padding: 0.4rem;" />
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Clogged Feed Ports (0 to 4):</span>
              <input type="number" id="filt-clogged-ports" min="0" max="4" step="1" value="0" style="width: 100px; padding: 0.4rem;" />
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Square Plate Format (mm):</span>
              <select id="filt-plate-width" style="width: 130px; padding: 0.4rem;">
                <option value="800">800 x 800 mm</option>
                <option value="1000">1000 x 1000 mm</option>
                <option value="1200" selected>1200 x 1200 mm</option>
                <option value="1500">1500 x 1500 mm</option>
              </select>
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Plate Web Thickness (mm):</span>
              <input type="number" id="filt-plate-thickness" min="45" max="110" step="5" value="65" style="width: 100px; padding: 0.4rem;" />
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Target Cake Moisture (%):</span>
              <input type="number" id="filt-cake-moisture" min="8" max="26" step="0.5" value="14" style="width: 100px; padding: 0.4rem;" />
            </label>
          </div>

          <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1.25rem;">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-bottom: 1rem;">
              <div>
                <span style="font-size: 0.72rem; font-weight: 800; color: #475569; display: block;">TIMOSHENKO STRESS (σ<sub>max</sub>)</span>
                <strong id="filt-res-stress" style="font-family: var(--smat-font-mono); font-size: 1.25rem;">3.54 MPa</strong>
              </div>
              <div>
                <span style="font-size: 0.72rem; font-weight: 800; color: #475569; display: block;">SAFETY FACTOR (FS)</span>
                <strong id="filt-res-fs" style="font-family: var(--smat-font-mono); font-size: 1.25rem;">4.10</strong>
              </div>
            </div>
            <p id="filt-res-summary" style="font-size: 0.88rem; line-height: 1.5; margin: 0 0 1rem; padding: 0.75rem; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 6px; color: #065f46; font-weight: 600;">
              Safe structural operation. Meets NOM-141 dry stacking cake criteria.
            </p>
            <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
              <a href="/en/products/filter-press-polypropylene-plates/" class="btn btn-primary">Configure PP Plates (SKU-QC-18) →</a>
              <a href="/en/products/filter-press-cloths/" class="btn btn-outline">Configure Cloths (SKU-QC-17) →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background-color: #ffffff; border-top: 1px solid var(--smat-border-light); border-bottom: 1px solid var(--smat-border-light);">
    <div class="container">
      <CircuitNavigator lang="en" defaultCircuit="jales_filtracion" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="background: #f8fafc; border: 1px solid var(--smat-border-strong); padding: 2.25rem; text-align: center;">
        <h2 style="margin-bottom: 0.6rem;">Request a Quotation for Filter Presses, Plates, or Cloths</h2>
        <p style="max-width: 600px; margin: 0 auto 1.25rem; color: var(--smat-text-secondary);">
          Specify your plate dimensions (800 to 1500 mm) or required filter press capacity.
        </p>
        <a href="/en/quote/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-primary">Request Quotation →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { evaluateFilterPressPlateDeflection } from '../../../scripts/slurryEngine.js';

  const pEl = document.getElementById('filt-pressure-bar') as HTMLInputElement | null;
  const cEl = document.getElementById('filt-clogged-ports') as HTMLInputElement | null;
  const wEl = document.getElementById('filt-plate-width') as HTMLSelectElement | null;
  const tEl = document.getElementById('filt-plate-thickness') as HTMLInputElement | null;
  const mEl = document.getElementById('filt-cake-moisture') as HTMLInputElement | null;
  const stressEl = document.getElementById('filt-res-stress');
  const fsEl = document.getElementById('filt-res-fs');
  const sumEl = document.getElementById('filt-res-summary');

  function updatePlateFlexure() {
    if (!pEl || !cEl || !wEl || !tEl || !mEl) return;
    const res = evaluateFilterPressPlateDeflection({
      feedPressureBar: Number(pEl.value) || 12,
      cloggedPortsCount: Number(cEl.value) || 0,
      plateWidthMm: Number(wEl.value) || 1200,
      plateThicknessMm: Number(tEl.value) || 65,
      cakeMoistureTargetPct: Number(mEl.value) || 14
    });
    if (stressEl) stressEl.textContent = `${res.maxBendingStressMpa} MPa`;
    if (fsEl) fsEl.textContent = `${res.flexuralSafetyFactor}`;
    if (sumEl) {
      sumEl.textContent = res.summaryEs;
      sumEl.style.background = res.isPlateCrackingRisk ? '#fef2f2' : '#ecfdf5';
      sumEl.style.color = res.isPlateCrackingRisk ? '#991b1b' : '#065f46';
    }
  }

  [pEl, cEl, wEl, tEl, mEl].forEach((el) => {
    if (el) el.addEventListener('input', updatePlateFlexure);
    if (el) el.addEventListener('change', updatePlateFlexure);
  });
  updatePlateFlexure();
</script>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 3rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.65rem; }
</style>
