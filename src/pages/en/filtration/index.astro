---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FiltrationCalculatorIsland from '../../../components/islands/FiltrationCalculatorIsland.astro';

const title = 'Filter Presses | SMAT Minerals';
const description = 'Recessed-chamber filter presses from 800 mm to 1500 mm, polypropylene filter plates, filter cloths, and hydraulic spares.';
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath="/en/filtration/"
  alternateEsPath="/filtracion/"
  alternateEnPath="/en/filtration/"
>
  <FiltrationCalculatorIsland locale="en" variant="hub" mode="standalone" />
</BaseLayout>
