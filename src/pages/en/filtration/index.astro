---
// src/pages/en/filtration/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import CircuitNavigator from '../../../components/CircuitNavigator.astro';
---

<BaseLayout 
  title="Filter Presses | SMAT Minerals"
  description="Recessed-chamber filter presses from 800 mm to 1500 mm, polypropylene filter plates, filter cloths, and hydraulic spares."
  lang="en"
>
  <section class="page-hero">
    <div class="container">
      <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0.5rem;">
        <h1 style="margin:0;">Filter Presses — Timoshenko Flexure &amp; NOM-141 Dry Cake</h1>
        <span class="badge badge-copper">FILTRATION &amp; DEWATERING</span>
      </div>
      <p style="font-size: 0.94rem; max-width: 760px; color: var(--smat-text-secondary); margin: 0.35rem 0 0;">
        Calibrate feed pressure (up to 16 bar), plate dimensions (800–1500 mm), and dry-stacking residual moisture (&le; 16%) before requesting a press or spares quote.
      </p>
    </div>
  </section>

  <section class="section" id="filtration-main-section">
    <div class="container">
      <!-- Stratum 1: SEMARNAT NOM-141 Dry Stacking & Polypropylene Plate Timoshenko Flexure Verifier -->
      <div class="card" id="nom141-plate-flexure-verifier" data-smat-calc="filtration" data-stratum-1-instrument style="margin-top: 0; margin-bottom: 1.75rem; padding: 1.5rem; border: 1.5px solid #cbd5e1;">
        <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0.5rem; margin-bottom:0.5rem;">
          <span class="badge badge-copper">SEMARNAT NOM-141 COMPLIANCE &amp; TIMOSHENKO FLEXURE</span>
          <div style="display:flex; flex-wrap:wrap; gap:0.4rem; align-items:center;">
            <span id="filt-nom141-badge" style="font-family:var(--smat-font-mono); font-size:0.72rem; font-weight:800; padding:0.2rem 0.55rem; border-radius:4px; background:#ecfdf5; border:1px solid #10b981; color:#065f46;">NOM-141 ≤16% Compliant</span>
            <span id="filt-shifter-sku-badge" style="font-family:var(--smat-font-mono); font-size:0.72rem; font-weight:800; padding:0.2rem 0.55rem; border-radius:4px; background:#eff6ff; border:1px solid #93c5fd; color:#1e40af;">SKU: SMAT-FILT-SHIFTER-CHAIN</span>
          </div>
        </div>
        <h2 style="margin-bottom: 0.4rem;">Polypropylene Plate Asymmetric Flexure &amp; Dry Stacking Cake Verifier</h2>
        <p style="color: var(--smat-text-secondary); margin-bottom: 1.1rem; font-size: 0.92rem;">
          Evaluate maximum bending stress (σ<sub>max</sub>) under clogged feed ports and verify structural safety factor alongside dry-stacking residual cake moisture (&le; 16%).
        </p>

        <div class="grid-2" style="gap: 1.5rem; align-items: start;">
          <div style="display: grid; gap: 0.75rem;">
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Slurry Feed Pressure (bar):</span>
              <input type="number" id="filt-pressure-bar" min="4" max="25" step="1" value="12" style="width: 100px; padding: 0.4rem;" />
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Clogged Feed Ports (0 to 4):</span>
              <input type="number" id="filt-clogged-ports" min="0" max="4" step="1" value="0" style="width: 100px; padding: 0.4rem;" />
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Square Plate Format (mm):</span>
              <select id="filt-plate-width" style="width: 130px; padding: 0.4rem;">
                <option value="800">800 x 800 mm</option>
                <option value="1000">1000 x 1000 mm</option>
                <option value="1200" selected>1200 x 1200 mm</option>
                <option value="1500">1500 x 1500 mm</option>
              </select>
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Plate Web Thickness (mm):</span>
              <input type="number" id="filt-plate-thickness" min="45" max="110" step="5" value="65" style="width: 100px; padding: 0.4rem;" />
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Target Cake Moisture (%):</span>
              <input type="number" id="filt-cake-moisture" min="8" max="26" step="0.5" value="14" style="width: 100px; padding: 0.4rem;" />
            </label>
          </div>

          <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1.25rem;">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-bottom: 0.65rem;">
              <div>
                <span style="font-size: 0.72rem; font-weight: 800; color: #475569; display: block;">TIMOSHENKO STRESS (σ<sub>max</sub>)</span>
                <strong id="filt-res-stress" style="font-family: var(--smat-font-mono); font-size: 1.25rem;">3.54 MPa</strong>
              </div>
              <div>
                <span style="font-size: 0.72rem; font-weight: 800; color: #475569; display: block;">SAFETY FACTOR (FS)</span>
                <strong id="filt-res-fs" style="font-family: var(--smat-font-mono); font-size: 1.25rem;">FS 4.10</strong>
              </div>
            </div>
            <div id="filt-res-secondary" style="font-family: var(--smat-font-mono); font-size: 0.78rem; color: #334155; margin-bottom: 0.85rem; padding: 0.45rem 0.65rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px;">
              ΔP_asym = 0.216 MPa · σ_adm = 14.5 MPa · 45 cyc/d · 512 t/d (18.0 + 12 = 30.0 min)
            </div>
            <p id="filt-res-summary" style="font-size: 0.88rem; line-height: 1.5; margin: 0 0 1rem; padding: 0.75rem; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 6px; color: #065f46; font-weight: 600;">
              Safe structural operation. Meets NOM-141 dry stacking cake criteria.
            </p>
            <div style="display: flex; gap: 0.65rem; flex-wrap: wrap; align-items: center;">
              <a href="/en/quote/?circuito=filtracion&equipo=placas_telas&serie=1200&filt_condition=jales_secos#rfq" class="btn btn-primary" data-quote-base="/en/quote/" style="min-height:48px; display:inline-flex; align-items:center;">Quote Calibrated →</a>
              <button
                type="button"
                class="btn btn-outline btn-avenue-tray"
                data-vertical-tray-btn
                data-add-tray-sku="SMAT-FILT-CLOTH-PLATE"
                data-tray-part-code="PP-1200"
                data-tray-title="PP Filter Plates &amp; Cloths 1200 mm (16 bar)"
                data-tray-series="1200"
                data-tray-material="PP"
                data-tray-circuit="filtracion"
                data-tray-source="filtration_stratum1_calc"
                style="min-height:48px;"
              >+ Add Plates/Cloths to Tray</button>
              <a href="/en/products/filter-press-cloths-and-pp-plates-16bar/" class="btn btn-outline">Cloths &amp; Plates →</a>
              <a href="/en/products/filter-press-plate-shifter-and-chains/" class="btn btn-outline">Plate Shifter →</a>
            </div>
          </div>
        </div>
      </div>

      <TechnicalDiagrams diagram="filter" lang="en" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div class="card">
          <h3>Filter Presses</h3>
          <p>
            Recessed-chamber plate filter presses with electro-hydraulic closure for mineral concentrate and tailings dewatering, rated up to 16 bar pressing cycles.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Recessed chamber:</strong> 800 mm to 1500 mm • Up to 16 bar • 20–40 min cycles</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/en/filtration/press/" class="btn btn-outline">Technical Datasheet</a>
            <a href="/en/quote/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-primary">Quote</a>
          </div>
        </div>

        <div class="card">
          <h3>Filter Plates, Cloths & Hydraulic Spares</h3>
          <p style="font-family: var(--smat-font-mono); font-size: 0.82rem; color: var(--smat-copper-accent); font-weight: 700; margin-bottom: 0.35rem;">
            Recessed chamber from 800 mm to 1500 mm • <var>α</var> = <var>α</var><sub>0</sub> (Δ<var>P</var>)<sup><var>s</var></sup>
          </p>
          <h4 style="margin: 0 0 0.5rem 0; font-size: 1rem;">Filter Cloths & Polypropylene Plates</h4>
          <p>
            Laser-cut filter cloths with thermally sealed edges and high-chemical-resistance polypropylene plates.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Material:</strong> Virgin Copolymer Polypropylene & Needle Felt</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/en/filtration/parts/" data-subroute-link="/en/filtration/parts/" class="btn btn-outline">Technical Datasheet</a>
            <a href="/en/products/filter-press-cloths-and-pp-plates-16bar/" class="btn btn-outline">Cloths & Plates SMAT-FILT-CLOTH-PLATE →</a>
            <a href="/en/products/filter-press-plate-shifter-and-chains/" class="btn btn-outline">Plate Shifter SMAT-FILT-SHIFTER-CHAIN →</a>
            <a href="/en/quote/?circuito=filtracion&equipo=placas_telas&serie=1500&filt_condition=fuga_chorreo#rfq" class="btn btn-primary">Quote</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <section class="section" style="background-color: #ffffff; border-top: 1px solid var(--smat-border-light); border-bottom: 1px solid var(--smat-border-light);">
    <div class="container">
      <CircuitNavigator lang="en" defaultCircuit="jales_filtracion" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="background: #f8fafc; border: 1px solid var(--smat-border-strong); padding: 2.25rem; text-align: center;">
        <h2 style="margin-bottom: 0.6rem;">Request a Quotation for Filter Presses, Plates, or Cloths</h2>
        <p style="max-width: 600px; margin: 0 auto 1.25rem; color: var(--smat-text-secondary);">
          Specify your plate dimensions (800 to 1500 mm) or required filter press capacity.
        </p>
        <a href="/en/quote/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-primary">Request Quotation →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { evaluateFilterPressPlateDeflection } from '../../../scripts/slurryEngine.js';
  import { bindCanonicalFiltrationCalculator } from '../../../scripts/verticalCalculatorsAndLabelsBridge.js';
  import { saveEngineeringContextSnapshot } from '../../../scripts/wizardCircuitPhysicsController.js';
  const deps = { evaluateFilterPressPlateDeflection, saveEngineeringContextSnapshot };
  bindCanonicalFiltrationCalculator(document, 'en', deps);
  document.addEventListener('astro:page-load', () => bindCanonicalFiltrationCalculator(document, 'en', deps));
</script>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 0.9rem 0 0.85rem; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin: 0.25rem 0 0; font-size: 1.65rem; }
  @media (max-width: 640px) {
    .page-hero { padding: 0.65rem 0; }
    .page-hero h1 { font-size: 1.32rem; margin: 0.15rem 0; }
    #filtration-main-section { padding-top: 0.65rem; }
  }
</style>
