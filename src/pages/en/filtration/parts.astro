---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import rolesData from '../../../../data/roles.json';

const filtVertical = rolesData.verticals.find((v) => v.id === 'filtracion');
const repRole = filtVertical?.opex?.find((r) => r.role_id === 'repuestos_prensa');
const criteria = repRole?.decision_criteria;
---

<BaseLayout 
  title="Filter Plates, Cloths & Hydraulic Spares | SMAT Minerals"
  description="Laser-cut filter cloths with thermal perimeter sealing and high-chemical-resistance polypropylene plates (800 to 1500 mm)."
  lang="en"
  canonicalPath="/en/filtration/parts/"
  alternateEsPath="/filtracion/repuestos/"
  alternateEnPath="/en/filtration/parts/"
>
  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">RECESSED CHAMBER • 800 MM TO 1500 MM</span>
      <h1>Filter Plates, Cloths & Hydraulic Spares</h1>
      <p class="subtitle">Laser-cut filter cloths with thermal perimeter sealing and high-chemical-resistance polypropylene plates.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <div style="margin-bottom: 1.75rem;">
          <TechnicalDiagrams type="filter" lang="en" />
        </div>
        <h2>Filter Cloths & Polypropylene Plates</h2>
        <p>
          Laser-cut filter cloths with thermal perimeter sealing and high-chemical-resistance polypropylene plates for 800 mm to 1500 mm recessed chambers.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Replacement Part</th>
              <th>Material & Engineering Specifications</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Recessed Chamber Plates</td>
              <td>Virgin Copolymer Polypropylene (800 x 800 mm to 1500 x 1500 mm) with high chemical resistance</td>
            </tr>
            <tr>
              <td>Membrane Squeeze Plates</td>
              <td>Thermoplastic elastomer (TPE) membrane plates for secondary cake air-blow and squeeze</td>
            </tr>
            <tr>
              <td>Filter Cloths</td>
              <td>Virgin Copolymer Polypropylene and Needled Felt laser-cut with thermal perimeter sealing</td>
            </tr>
            <tr>
              <td>Hydraulic Spares & Seals</td>
              <td>Cylinders, hydraulic seals, perimeter gaskets, and center/corner feed necks</td>
            </tr>
            <tr>
              <td>Filter Medium Resistance (R<sub>m</sub>)</td>
              <td>Monofilament/multifilament weave calibrated per Darcy-Ruth law to minimize cloth blinding (ΔR<sub>m</sub>) and edge weeping</td>
            </tr>
          </tbody>
        </table>

        {criteria && (
          <div class="decision-criteria-panel" data-testid="role-decision-criteria" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid #9a3412;">
            <span class="badge badge-copper">METALLURGICAL DECISION CRITERIA • ROLES.JSON</span>
            <h3 style="margin: 0.45rem 0 0.75rem; font-size: 1.08rem; color: var(--smat-text-primary);">Plates & Filter Cloths Selection Matrix ({repRole?.series})</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem; font-size: 0.88rem;">
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: var(--smat-text-primary); margin-bottom: 0.25rem;">Required Slurry Variables</strong>
                <span style="color: #334155;">{criteria.required_slurry_vars_en}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #7c2d12; margin-bottom: 0.25rem;">Weave & Thermal Sealing Rule</strong>
                <span style="color: #334155;">{criteria.metallurgy_rule_en}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #14532d; margin-bottom: 0.25rem;">Operational Risk Mitigated</strong>
                <span style="color: #334155;">{criteria.risk_avoided_en}</span>
              </div>
            </div>
          </div>
        )}

        <div class="filtration-selector-box" data-testid="filtration-contextual-selector" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #fffbeb; border: 1px solid #fde68a;">
          <span class="badge badge-copper">CONTEXTUAL PRE-SELECTION • WORKBENCH BRIDGE</span>
          <h3 style="margin: 0.45rem 0 0.5rem; font-size: 1.05rem; color: var(--smat-text-primary);">Quote Plates & Cloths by Dimension & Symptom</h3>
          <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.65rem;">
            <a href="/en/quote/?circuito=filtracion&equipo=placas_telas&serie=800&filt_condition=fuga_chorreo#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">800 mm Plates/Cloths • Edge Weeping</a>
            <a href="/en/quote/?circuito=filtracion&equipo=placas_telas&serie=1200&filt_condition=ciclo_lento#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">1200 mm Plates/Cloths • Slow Cycle</a>
            <a href="/en/quote/?circuito=filtracion&equipo=placas_telas&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">1500 mm Plates/Cloths • Dry Tailings</a>
            <a href="/en/quote/?circuito=filtracion&equipo=placas_telas&serie=2000&filt_condition=jales_secos#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">2000 mm Plates/Cloths • Large Format</a>
          </div>
        </div>

        <SharePurchasing 
          roleTitle="Filter Plates, Cloths & Hydraulic Spares"
          series="Recessed chamber from 800 mm to 1500 mm"
          metallurgy="Virgin Copolymer Polypropylene & Needled Felt"
          specs="Laser-cut filter cloths with thermal perimeter sealing and high-chemical-resistance polypropylene plates."
          roleId="placas_telas"
          circuit="filtracion"
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">TECHNICAL ENGINEERING IN DURANGO</span>
            <h3>Need filter plates, cloths, or hydraulic spares?</h3>
            <p>Request a formal quote specifying plate dimensions (800 to 1500 mm) and feed port position.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/quote/?circuito=filtracion&equipo=placas_telas&serie=1500&filt_condition=fuga_chorreo#rfq" class="btn btn-primary btn-lg">
              Request Quotation →
            </a>
            <a href="https://wa.me/526183670664?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20Filter%20Plates%20and%20Cloths" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Quote via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--smat-copper-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
