---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FiltrationCalculatorIsland from '../../../components/islands/FiltrationCalculatorIsland.astro';

const title = 'Filter Plates, Cloths & Hydraulic Spares | SMAT Minerals';
const description = 'Laser-cut filter cloths with thermal perimeter sealing and high-chemical-resistance polypropylene plates (800 to 1500 mm).';
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath="/en/filtration/parts/"
  alternateEsPath="/filtracion/repuestos/"
  alternateEnPath="/en/filtration/parts/"
>
  <FiltrationCalculatorIsland locale="en" variant="parts" mode="standalone" />
</BaseLayout>
