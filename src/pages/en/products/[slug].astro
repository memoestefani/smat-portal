---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductQuickCard from '../../../components/ProductQuickCard.astro';
import { getAllStaticProductRouteEntries, getQuickProductBySlugOrAlias } from '../../../scripts/quickProductsCatalog.js';
import '../../../styles/productSlugSolar.css';

export function getStaticPaths() {
  const entries = getAllStaticProductRouteEntries('en');
  return entries.map((entry) => ({
    params: { slug: entry.routeSlug },
    props: {
      sku: entry.sku,
      isCanonical: entry.isCanonical,
      canonicalSlug: entry.canonicalSlug
    }
  }));
}

const { sku, canonicalSlug } = Astro.props;
const pageTitle = `${sku.title_en} | Fast Checkout SMAT Minerals`;
const pageDescription = `${sku.summary_en} Drop-In Cross Reference: ${sku.oem_cross_ref}. Hardness: ${sku.hardness_spec}.`;
const canonicalPath = `/en/products/${canonicalSlug || sku.slug_en}/`;
const sat = sku.sat_tuple || {
  clave_prod_serv: '40142000',
  clave_unidad: 'H87',
  fraccion_arancelaria: '8413.91.99.00'
};
const triplet = sku.geometric_triplet_mm || {
  a_id_mm: 100,
  b_od_mm: 400,
  c_thickness_mm: 80,
  tolerance_std: 'ISO 2768-m',
  label_en: 'A: Bore ID 100 mm | B: Outer OD 400 mm | C: Thickness 80 mm'
};

const nioshBadges: Record<string, { label: string; cls: string }> = {
  MANUAL_SAFE: {
    label: '🟢 Safe Manual Handling (< 11.1 kg NIOSH)',
    cls: 'smat-slug-badge--emerald'
  },
  ASSISTED_SHAFT_MOUNT_2P: {
    label: '🟡 2-Operator Assisted Mount (11.1–23.0 kg NIOSH)',
    cls: 'smat-slug-badge--amber'
  },
  HOIST_REQUIRED: {
    label: '🔴 Mechanical Hoist Required (> 23.0 kg NOM-036-1-STPS)',
    cls: 'smat-slug-badge--rose'
  }
};
const niosh = nioshBadges[sku.niosh_mode] || nioshBadges.HOIST_REQUIRED;
const hasAtomicPumpCodes = Array.isArray(sku.atomic_codes) && sku.atomic_codes.length > 0;
const castCodeLabel = hasAtomicPumpCodes ? sku.atomic_codes.join(', ') : sku.id;
const coupledSku = getQuickProductBySlugOrAlias(sku.coupled_pair_sku);
const telemetryLabelsByVerticalEn: Record<string, { sg: string; d50: string; life: string }> = {
  control: {
    sg: 'Density / SG Range (Marcy)',
    d50: 'Sieve Aperture Range (ASTM E11)',
    life: 'Calibration Cycle / Service Life'
  },
  filtracion: {
    sg: 'Filter Press Feed Density',
    d50: 'Cake Particle Cut (d50)',
    life: 'Typical Cloth / Plate Service Life'
  },
  flotacion: {
    sg: 'Cell Slurry Density',
    d50: 'Liberation Particle Size (d80)',
    life: 'Rotor-Stator Operating Wear Life'
  },
  clasificacion: {
    sg: 'Cyclone / Screen Feed Density',
    d50: 'Cut Size d50c',
    life: 'SiC Apex / PU Screen Wear Life'
  }
};
const telLabels = telemetryLabelsByVerticalEn[sku.vertical] || {
  sg: 'Slurry Density (Marcy SG)',
  d50: 'Cut Size d50c',
  life: 'Typical Plant Wear Life'
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalPath}
  canonicalPath={canonicalPath}
  alternateEsPath={`/productos/${sku.slug_es}/`}
  alternateEnPath={`/en/products/${sku.slug_en}/`}
  lang="en"
>
  <main class="smat-slug-main">
    <!-- Breadcrumb & language switcher -->
    <nav class="smat-slug-breadcrumb" aria-label="Breadcrumb">
      <div class="smat-slug-breadcrumb-links">
        <a href="/en/" class="smat-slug-nav-link">Home</a>
        <span>/</span>
        <a href="/en/catalog/" class="smat-slug-nav-link">19-SKU Catalog</a>
        <span>/</span>
        <span class="smat-slug-breadcrumb-current">{sku.id}</span>
      </div>
      <a href={`/productos/${sku.slug_es}/`} class="smat-slug-lang-switch">
        <span>ES</span>
        <span>Ficha en Español →</span>
      </a>
    </nav>

    <!-- Plane 1 Header: < 30s identification -->
    <header class="smat-slug-header">
      <div class="smat-slug-badge-row">
        <span class="smat-slug-badge smat-slug-badge--amber">
          {sku.id} · {sku.vertical.toUpperCase()} · GATE {sku.gate_lock || 'G1'}
        </span>
        <span class={`smat-slug-badge ${niosh.cls}`}>
          {niosh.label}
        </span>
        <span class="smat-slug-badge smat-slug-badge--neutral">
          Dry Mass: {sku.mass_kg} kg
        </span>
      </div>

      <h1 class="smat-slug-h1">
        {sku.title_en}
      </h1>
      <p class="smat-slug-lead">
        {sku.summary_en}
      </p>

      <!-- Stratum 1: 3-Horizon Harmonic JRP Card (s, c, S) + Synchronized Coupled Pair -->
      <div id="stratum1-slug-card" data-jrp-window-card data-jrp-criticality="normal" data-stratum-1-instrument style="margin:0.5rem 0 0.75rem 0; padding:0.9rem 1rem; background:#f8fafc; border:1.5px solid #cbd5e1; border-left:4px solid #0c4a6e; border-radius:8px;">
        <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
          <span style="font-family:var(--smat-font-mono, monospace); font-size:0.74rem; font-weight:800; color:#0c4a6e;">HARMONIC PREVENTIVE WINDOW (T₀/2 • T₀ • 2T₀)</span>
          <span data-jrp-telemetry-badge style="font-family:var(--smat-font-mono, monospace); font-size:0.74rem; font-weight:700; color:#334155;">Session Pulp SG 1.45 • d50 280 µm</span>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:0.45rem; align-items:center; margin-bottom:0.6rem;">
          <span style="font-size:0.78rem; font-weight:700; color:#1e293b;">Criticality Mode:</span>
          <button type="button" data-jrp-criticality-toggle="normal" aria-pressed="true" style="padding:0.35rem 0.75rem; border:1px solid #0c4a6e; border-radius:6px; background:#0c4a6e; color:#ffffff; font-size:0.76rem; font-weight:700; cursor:pointer; min-height:48px;">Normal (1.0×)</button>
          <button type="button" data-jrp-criticality-toggle="paro_planta" aria-pressed="false" style="padding:0.35rem 0.75rem; border:1px solid #94a3b8; border-radius:6px; background:#ffffff; color:#0f172a; font-size:0.76rem; font-weight:700; cursor:pointer; min-height:48px;">Plant Shutdown (0.75×)</button>
          <span data-jrp-window-days style="margin-left:auto; font-family:var(--smat-font-mono, monospace); font-size:0.78rem; font-weight:800; color:#064e3b;">90 d window</span>
          <span data-jrp-severity style="font-family:var(--smat-font-mono, monospace); font-size:0.75rem; color:#334155;">1.00× (1.00×)</span>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:0.55rem; margin-bottom:0.6rem;">
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.5rem 0.65rem;">
            <span style="font-size:0.68rem; font-weight:800; color:#334155; display:block;">SHAFT SLEEVE (T₀/2)</span>
            <strong data-jrp-sleeve-day style="font-size:0.95rem; color:#0f172a;">Day 90</strong>
          </div>
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.5rem 0.65rem;">
            <span style="font-size:0.68rem; font-weight:800; color:#334155; display:block;">IMPELLER + THROAT (T₀)</span>
            <strong data-jrp-impeller-day style="font-size:0.95rem; color:#0f172a;">Day 150</strong>
          </div>
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:0.5rem 0.65rem;">
            <span style="font-size:0.68rem; font-weight:800; color:#334155; display:block;">VOLUTE + LINER (2T₀)</span>
            <strong data-jrp-volute-day style="font-size:0.95rem; color:#0f172a;">Day 180</strong>
          </div>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:0.6rem; align-items:center; justify-content:space-between;">
          <span data-jrp-policy-summary style="font-size:0.78rem; color:#334155;">Harmonic coupled replacement to minimize unplanned downtime.</span>
          <div style="display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center;">
            <button
              type="button"
              class="btn btn-outline"
              data-add-tray-sku={sku.id}
              data-tray-part-code={sku.atomic_codes?.[0] || sku.id}
              data-tray-title={sku.title_en}
              data-tray-series={(sku as any).series || '6x4'}
              data-tray-material={sku.default_material || 'A05'}
              data-tray-circuit={sku.vertical || 'bombeo'}
              data-tray-source="product_slug_stratum1"
              style="min-height:48px; padding:0.45rem 0.85rem; font-size:0.8rem;"
            >+ Add {sku.id} to Tray</button>
            <button
              type="button"
              class="btn btn-primary"
              data-add-coupled-pair-btn
              data-pair-primary-sku={sku.id}
              data-pair-primary-title={sku.title_en}
              data-pair-secondary-sku={sku.coupled_pair_sku || 'SMAT-PUMP-TB-083'}
              data-pair-secondary-title={coupledSku ? coupledSku.title_en : (sku.coupled_pair_sku || 'SMAT-PUMP-TB-083')}
              data-pair-series={(sku as any).series || '6x4'}
              data-pair-material={sku.default_material || 'A05'}
              style="min-height:48px; padding:0.45rem 0.85rem; font-size:0.8rem;"
            >+ Add Coupled Pair to Tray</button>
          </div>
        </div>
      </div>

      <div class="smat-slug-kpi-grid">
        <div class="smat-slug-kpi-box">
          <div class="smat-slug-kpi-label">Zero-OEM Drop-In Cross Reference</div>
          <div class="smat-slug-kpi-value smat-slug-kpi-value--amber">{sku.oem_cross_ref}</div>
        </div>
        <div class="smat-slug-kpi-box">
          <div class="smat-slug-kpi-label">Certified Metallurgy / Hardness</div>
          <div class="smat-slug-kpi-value">{sku.hardness_spec}</div>
        </div>
        <div class="smat-slug-kpi-box">
          <div class="smat-slug-kpi-label">Preventive Reorder Window (JRP)</div>
          <div class="smat-slug-kpi-value smat-slug-kpi-value--sky">Every {sku.reorder_window_days} days · Pair: {sku.coupled_pair_sku}</div>
        </div>
      </div>
    </header>

    <!-- 2-Column Body: 3-in-1 ProductQuickCard + Dual B2B Checkout -->
    <div class="smat-slug-layout-grid">
      <div class="smat-slug-col-left">
        <ProductQuickCard sku={sku} lang="en" mode="media-only" />

        <!-- 3-Step Plant Validation Box -->
        <section class="smat-slug-validation-card">
          <h2 class="smat-slug-section-kicker smat-slug-section-kicker--emerald">
            📋 How to Validate Your Part in Plant in 3 Steps (Zero Downtime Risk)
          </h2>
          <ol class="smat-slug-steps-grid">
            <li class="smat-slug-step-item">
              <strong class="smat-slug-step-title">STEP 1 · CAST / TAG CODE</strong>
              Check the identifier on your equipment ({castCodeLabel}) or send us a yard photo via WhatsApp.
            </li>
            <li class="smat-slug-step-item">
              <strong class="smat-slug-step-title">STEP 2 · TRIPLET (A, B, C)</strong>
              Confirm with caliper or tape: <span class="smat-slug-mono-inline">{triplet.label_en}</span> ({triplet.tolerance_std || 'ISO 2768-m'}).
            </li>
            <li class="smat-slug-step-item">
              <strong class="smat-slug-step-title">STEP 3 · 0.76 MM SCALE</strong>
              During assembly, set clearance or seating using 1 standard ISO/IEC 7810 bank card (0.76 mm).
            </li>
          </ol>
        </section>

        <!-- Coupled Telemetry Hooks -->
        <section class="smat-slug-telemetry-card">
          <h2 class="smat-slug-section-kicker">
            Recommended Metallurgical Operating Window
          </h2>
          <div class="smat-slug-telemetry-grid">
            <div class="smat-slug-telemetry-box">
              <div class="smat-slug-telemetry-label">{telLabels.sg}</div>
              <div class="smat-slug-telemetry-val smat-slug-telemetry-val--amber">
                {sku.telemetry_hooks.marcy_sg_range[0]} – {sku.telemetry_hooks.marcy_sg_range[1]} t/m³
              </div>
            </div>
            <div class="smat-slug-telemetry-box">
              <div class="smat-slug-telemetry-label">{telLabels.d50}</div>
              <div class="smat-slug-telemetry-val smat-slug-telemetry-val--sky">
                {sku.telemetry_hooks.plitt_d50_um_range[0]} – {sku.telemetry_hooks.plitt_d50_um_range[1]} µm
              </div>
            </div>
            <div class="smat-slug-telemetry-box">
              <div class="smat-slug-telemetry-label">{telLabels.life}</div>
              <div class="smat-slug-telemetry-val smat-slug-telemetry-val--emerald">
                {sku.telemetry_hooks.wear_life_hours_range[0]} – {sku.telemetry_hooks.wear_life_hours_range[1]} h
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Right Column: Dual Checkout Lane (< 25,000 MXN Petty Cash vs > 25,000 MXN SAP PO) -->
      <aside class="smat-slug-checkout-aside">
        <div class="smat-slug-aside-head">
          <span class="smat-slug-aside-kicker">
            Dual B2B Checkout (Zero Login)
          </span>
          <span class="smat-slug-aside-hub">● Durango Hub, MX</span>
        </div>

        <div>
          <h2 class="smat-slug-aside-h2">1. Available Alloys / Materials</h2>
          <div class="smat-slug-chip-row">
            {sku.available_materials.map((mat: string) => (
              <span role="button" tabindex="0" data-mat-code={mat} class={`smat-slug-mat-chip ${mat === sku.default_material ? 'is-default' : ''}`}>
                {mat} {mat === sku.default_material ? '(Standard)' : ''}
              </span>
            ))}
          </div>
        </div>

        <div>
          {hasAtomicPumpCodes && (
            <div style="margin-bottom: 0.75rem;">
              <h3 class="smat-slug-aside-h3">2A. Linked Atomic Part Codes (13-Part Pump BOM)</h3>
              <div class="smat-slug-chip-row">
                {sku.atomic_codes.map((code: string) => (
                  <a
                    href={`/en/catalog/${code.toLowerCase()}/`}
                    class="smat-slug-atomic-link"
                  >
                    🔗 {code}
                  </a>
                ))}
              </div>
            </div>
          )}
          <h3 class="smat-slug-aside-h3">2. Circuit Coupling & Preventive Reorder Cycle</h3>
          <div class="smat-slug-coupled-box" data-coupled-sku={sku.coupled_pair_sku} data-reorder-days={String(sku.reorder_window_days)}>
            <div>
              <strong>Recommended Coupled SKU:</strong>{' '}
              {coupledSku ? (
                <a href={`/en/products/${coupledSku.slug_en}/`} class="smat-slug-atomic-link" style="display:inline-block; padding:0.1rem 0.45rem;">
                  {sku.coupled_pair_sku} — {coupledSku.title_en} →
                </a>
              ) : (
                <span>{sku.coupled_pair_sku}</span>
              )}
            </div>
            <div>
              <strong>Preventive Reorder Cycle:</strong> <span>Every {sku.reorder_window_days} operating days (Lot #{sku.kit_id || 1})</span>
            </div>
            {coupledSku && (
              <div style="margin-top: 0.45rem;">
                <button
                  type="button"
                  data-quick-tray-add={coupledSku.id}
                  data-add-coupled-pair-btn={coupledSku.id}
                  data-sku-title={coupledSku.title_en}
                  data-sku-code={coupledSku.atomic_codes?.[0] || coupledSku.id}
                  data-sku-material={coupledSku.default_material || 'A05'}
                  data-sku-regime={coupledSku.stock_regime || 'hay'}
                  data-sku-mass={String(coupledSku.mass_kg || 15)}
                  class="smat-slug-atomic-link"
                  style="cursor:pointer; font-weight:700; width:100%; justify-content:center; padding:0.35rem 0.6rem;"
                >
                  + Add Synchronized Coupled Pair ({coupledSku.id}) to Tray
                </button>
              </div>
            )}
          </div>
        </div>

        <div class="smat-slug-lanes-stack">
          <div class="smat-slug-lane-card smat-slug-lane-card--emerald">
            <div class="smat-slug-lane-head">
              <span class="smat-slug-lane-title smat-slug-lane-title--emerald">⚡ LANE A: PETTY CASH (&lt; 25,000 MXN)</span>
              <span class="smat-slug-lane-tag smat-slug-lane-tag--emerald">P1 · CFDI 4.0 TODAY</span>
            </div>
            <p class="smat-slug-lane-desc">
              Express SPEI or corporate card release without SAP vendor onboarding delay. Same-day dispatch for <strong>🟢 IN STOCK</strong> items.
            </p>
          </div>

          <div class="smat-slug-lane-card smat-slug-lane-card--amber">
            <div class="smat-slug-lane-head">
              <span class="smat-slug-lane-title smat-slug-lane-title--amber">🏢 LANE B: PURCHASE ORDER (&gt; 25,000 MXN)</span>
              <span class="smat-slug-lane-tag smat-slug-lane-tag--amber">SAP / ORACLE · B2B PASSPORT</span>
            </div>
            <p class="smat-slug-lane-desc">
              Formal PDF quotation with Tax Compliance Certificate (32-D) and active REPSE registration.
            </p>
            <div class="smat-slug-sat-pill">
              SAT ProdServ: <strong>{sat.clave_prod_serv}</strong> · Unit: <strong>{sat.clave_unidad}</strong> · HS/TIGIE: <strong>{sat.fraccion_arancelaria}</strong>
            </div>
          </div>
        </div>

        <div class="smat-slug-passport-box">
          <div class="smat-slug-passport-title">📋 Includes SMAT Vendor Passport:</div>
          <p>• Heat Metallurgical Certificate (PMI / Brinell Hardness ASTM A532)</p>
          <p>• Geometric Triplet Dimensional Verification (ISO 2768-m) in Durango</p>
          <p>• NIOSH / NOM-036-1-STPS Rigging & Ergonomic Safety Footprint</p>
        </div>

        {(sku.id === 'SMAT-PUMP-BRG-005M' || (Array.isArray(sku.atomic_codes) && sku.atomic_codes.includes('DAM005'))) && (
          <div
            data-core-tradein-widget={sku.id}
            style="padding: 0.9rem; border-radius: 12px; background: #ecfdf5; border: 1px solid #10b981; font-size: 0.78rem; color: #064e3b;"
          >
            <div style="font-family: var(--font-mono, monospace); font-weight: 800; color: #064e3b; margin-bottom: 0.4rem;">
              ♻️ DAM005 CORE TRADE-IN PROGRAM (-22% CREDIT)
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.45rem;">
              <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 700;">
                <span>Used Housing Condition</span>
                <select data-tradein-condition data-core-tradein-condition style="padding: 0.35rem 0.45rem; border: 1px solid #059669; border-radius: 6px; background: #ffffff; color: #0f172a; font-size: 0.75rem;">
                  <option value="h7_intact" selected>Intact Crack-Free Housing (-22% • 0.78x)</option>
                  <option value="minor_bearing_seizure">Bearing Seizure / Recoverable Bore (-12% • 0.88x)</option>
                  <option value="cracked_housing">Cracked or Welded Housing (0% • 1.00x)</option>
                </select>
              </label>
              <label style="display: flex; align-items: center; gap: 0.35rem; font-weight: 700; padding-top: 1rem;">
                <input type="checkbox" data-tradein-not-welded data-core-tradein-toggle checked />
                <span>Unwelded H7 Bearing Bore (ISO IT6)</span>
              </label>
            </div>
            <div data-tradein-result data-core-tradein-badge style="font-family: var(--font-mono, monospace); font-weight: 800; color: #064e3b;">
              Active: -22% Core Trade-In Credit (Factor 0.78x • RMA-CORE-DAM005-INTACT)
            </div>
            <div data-tradein-co2 data-core-tradein-note style="font-size: 0.72rem; color: #064e3b; margin-top: 0.2rem;">
              Physical return at Central Warehouse: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166 (35 kg CO₂e saved)
            </div>
          </div>
        )}

        <div class="smat-slug-cta-stack">
          <button
            type="button"
            data-quick-tray-add={sku.id}
            data-slug-add-to-tray={sku.id}
            data-sku-title={sku.title_en}
            data-sku-code={sku.atomic_codes[0] || sku.id}
            data-sku-material={sku.default_material}
            data-sku-regime={sku.stock_regime || 'hay'}
            data-sku-mass={sku.mass_kg}
            class="smat-slug-btn-primary"
          >
            🛒 Add to B2B Quote Tray / Request SAP Passport ({sku.id}) →
          </button>
          <a
            href={`https://wa.me/526183670664?text=${encodeURIComponent(`[SMAT-DGO] Hello SMAT, I need an urgent quote for SKU ${sku.id} (${sku.title_en}) in alloy ${sku.default_material} [ Regime: ${sku.stock_regime || 'hay'} | Mass: ${sku.mass_kg} kg ].`)}`}
            target="_blank"
            rel="noopener noreferrer"
            data-slug-wa-btn={sku.id}
            data-sku-id={sku.id}
            data-sku-title={sku.title_en}
            data-sku-regime={sku.stock_regime || 'hay'}
            data-sku-mass={String(sku.mass_kg)}
            data-sku-lang="en"
            class="smat-slug-btn-wa"
          >
            💬 Fast Checkout / Petty Cash via Engineering WhatsApp (526183670664)
          </a>
          <a
            href={`/en/quote/?sku=${encodeURIComponent(sku.id)}&mat=${encodeURIComponent(sku.default_material)}#rfq`}
            data-home-workbench={`/en/?sku=${encodeURIComponent(sku.id)}&mat=${encodeURIComponent(sku.default_material)}#workbench`}
            data-slug-workbench-btn={sku.id}
            data-workbench-anchor="#workbench"
            data-sku-id={sku.id}
            data-sku-lang="en"
            class="smat-slug-btn-workbench"
          >
            ⚙️ Open in Hydraulic & Metallurgical Workbench (Plane 2)
          </a>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<script>
  import { initCoreTradeInWidgets } from '../../../scripts/vendorPassportAndTradeInController.js';
  import { initHarmonicJrpWindowAndPairCard } from '../../../scripts/catalogDropInAndJrpProjector.js';

  function initSlugSheetEn() {
    if (typeof document === 'undefined') return;
    initCoreTradeInWidgets(document, 'en');
    initHarmonicJrpWindowAndPairCard(document, 'en');
    const chips = document.querySelectorAll('.smat-slug-mat-chip[data-mat-code]');
    const trayBtn = document.querySelector('[data-slug-add-to-tray]');
    const waBtn = document.querySelector('[data-slug-wa-btn]') as HTMLAnchorElement | null;
    const wbBtn = document.querySelector('[data-slug-workbench-btn]') as HTMLAnchorElement | null;
    const activateSlugMatChip = (chip: Element) => {
      const mat = chip.getAttribute('data-mat-code') || '';
      if (!mat) return;
      chips.forEach((c) => {
        const isCurrent = c === chip;
        c.classList.toggle('is-default', isCurrent);
        c.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
      });
      if (trayBtn) {
        trayBtn.setAttribute('data-sku-material', mat);
      }
      if (waBtn) {
        const skuId = waBtn.getAttribute('data-sku-id') || '';
        const skuTitle = waBtn.getAttribute('data-sku-title') || '';
        const regime = waBtn.getAttribute('data-sku-regime') || 'hay';
        const mass = waBtn.getAttribute('data-sku-mass') || '15';
        const msg = `[SMAT-DGO] Hello SMAT, I need an urgent quote for SKU ${skuId} (${skuTitle}) in alloy ${mat} [ Regime: ${regime} | Mass: ${mass} kg ].`;
        waBtn.href = `https://wa.me/526183670664?text=${encodeURIComponent(msg)}`;
      }
      if (wbBtn) {
        const skuId = wbBtn.getAttribute('data-sku-id') || '';
        wbBtn.href = `/en/quote/?sku=${encodeURIComponent(skuId)}&mat=${encodeURIComponent(mat)}#rfq`;
        wbBtn.setAttribute('data-home-workbench', `/en/?sku=${encodeURIComponent(skuId)}&mat=${encodeURIComponent(mat)}#workbench`);
      }
    };
    chips.forEach((chip) => {
      if ((chip as HTMLElement).dataset?.slugChipBound === '1') return;
      if ((chip as HTMLElement).dataset) (chip as HTMLElement).dataset.slugChipBound = '1';
      chip.addEventListener('click', () => activateSlugMatChip(chip));
      chip.addEventListener('keydown', (ev: Event) => {
        const ke = ev as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault();
          activateSlugMatChip(chip);
        }
      });
    });
  }
  initSlugSheetEn();
  document.addEventListener('astro:page-load', initSlugSheetEn);
</script>

