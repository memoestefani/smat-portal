---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductQuickCard from '../../../components/ProductQuickCard.astro';
import { getAllStaticProductRouteEntries } from '../../../scripts/quickProductsCatalog.js';

export function getStaticPaths() {
  const entries = getAllStaticProductRouteEntries('en');
  return entries.map((entry) => ({
    params: { slug: entry.routeSlug },
    props: {
      sku: entry.sku,
      isCanonical: entry.isCanonical,
      canonicalSlug: entry.canonicalSlug
    }
  }));
}

const { sku, canonicalSlug } = Astro.props;
const pageTitle = `${sku.title_en} | Fast Checkout SMAT Minerals`;
const pageDescription = `${sku.summary_en} Drop-In Cross Reference: ${sku.oem_cross_ref}. Hardness: ${sku.hardness_spec}.`;
const canonicalPath = `/en/products/${canonicalSlug || sku.slug_en}/`;
const sat = sku.sat_tuple || {
  clave_prod_serv: '40142000',
  clave_unidad: 'H87',
  fraccion_arancelaria: '8413.91.99.00'
};
const triplet = sku.geometric_triplet_mm || {
  a_id_mm: 100,
  b_od_mm: 400,
  c_thickness_mm: 80,
  tolerance_std: 'ISO 2768-m',
  label_en: 'A: Bore ID 100 mm | B: Outer OD 400 mm | C: Thickness 80 mm'
};

const nioshBadges: Record<string, { label: string; color: string }> = {
  MANUAL_SAFE: {
    label: '🟢 Safe Manual Handling (< 11.1 kg NIOSH)',
    color: 'bg-emerald-950/70 text-emerald-300 border-emerald-500/40'
  },
  ASSISTED_SHAFT_MOUNT_2P: {
    label: '🟡 2-Operator Assisted Mount (11.1–23.0 kg NIOSH)',
    color: 'bg-amber-950/70 text-amber-300 border-amber-500/40'
  },
  HOIST_REQUIRED: {
    label: '🔴 Mechanical Hoist Required (> 23.0 kg NOM-036-1-STPS)',
    color: 'bg-rose-950/70 text-rose-300 border-rose-500/40'
  }
};
const niosh = nioshBadges[sku.niosh_mode] || nioshBadges.HOIST_REQUIRED;
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalPath} lang="en">
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 text-slate-100">
    <!-- Breadcrumb & language switcher -->
    <nav class="flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-slate-400 mb-6" aria-label="Breadcrumb">
      <div class="flex items-center gap-2">
        <a href="/en/" class="hover:text-amber-400 transition">Home</a>
        <span>/</span>
        <a href="/en/catalog/" class="hover:text-amber-400 transition">19-SKU Catalog</a>
        <span>/</span>
        <span class="text-amber-400">{sku.id}</span>
      </div>
      <a href={`/productos/${sku.slug_es}/`} class="inline-flex items-center gap-1.5 px-3 py-1 rounded border border-slate-700 hover:border-amber-400 text-slate-300">
        <span>ES</span>
        <span>Ficha en Español →</span>
      </a>
    </nav>

    <!-- Plane 1 Header: < 30s identification -->
    <header class="rounded-2xl border border-slate-800 bg-slate-900/90 p-6 sm:p-8 shadow-xl mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-2.5 py-1 rounded text-xs font-mono uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/40">
          {sku.id} · {sku.vertical.toUpperCase()} · GATE {sku.gate_lock || 'G1'}
        </span>
        <span class={`px-2.5 py-1 rounded text-xs font-mono border ${niosh.color}`}>
          {niosh.label}
        </span>
        <span class="px-2.5 py-1 rounded text-xs font-mono bg-slate-800 text-slate-300 border border-slate-700">
          Dry Mass: {sku.mass_kg} kg
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white mb-3">
        {sku.title_en}
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-4xl mb-5">
        {sku.summary_en}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-slate-800 text-sm">
        <div class="bg-slate-950/70 rounded-xl p-3.5 border border-slate-800/80">
          <div class="text-xs font-mono uppercase text-slate-400 mb-1">Zero-OEM Drop-In Cross Reference</div>
          <div class="font-mono font-semibold text-amber-300">{sku.oem_cross_ref}</div>
        </div>
        <div class="bg-slate-950/70 rounded-xl p-3.5 border border-slate-800/80">
          <div class="text-xs font-mono uppercase text-slate-400 mb-1">Certified Metallurgy / Hardness</div>
          <div class="font-semibold text-slate-100">{sku.hardness_spec}</div>
        </div>
        <div class="bg-slate-950/70 rounded-xl p-3.5 border border-slate-800/80">
          <div class="text-xs font-mono uppercase text-slate-400 mb-1">Everyday Calibration Scale (ISO/IEC 7810)</div>
          <div class="font-semibold text-sky-300">{sku.everyday_scale_en}</div>
        </div>
      </div>
    </header>

    <!-- 2-Column Body: 3-in-1 ProductQuickCard + Dual B2B Checkout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 space-y-6">
        <ProductQuickCard sku={sku} lang="en" />

        <!-- 3-Step Plant Validation Box -->
        <section class="rounded-2xl border border-emerald-500/30 bg-emerald-950/15 p-5">
          <h2 class="text-sm font-mono uppercase tracking-wider text-emerald-300 mb-3">
            📋 How to Validate Your Part in Plant in 3 Steps (Zero Downtime Risk)
          </h2>
          <ol class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-slate-300">
            <li class="rounded-xl bg-slate-950/80 border border-slate-800 p-3">
              <strong class="block font-mono text-amber-300 mb-1">STEP 1 · CAST CODE</strong>
              Check the raised number on your current part ({sku.atomic_codes.join(', ')}) or send us a yard photo via WhatsApp.
            </li>
            <li class="rounded-xl bg-slate-950/80 border border-slate-800 p-3">
              <strong class="block font-mono text-amber-300 mb-1">STEP 2 · TRIPLET (A, B, C)</strong>
              Confirm with caliper or tape: <span class="font-mono text-slate-100">{triplet.label_en}</span> ({triplet.tolerance_std || 'ISO 2768-m'}).
            </li>
            <li class="rounded-xl bg-slate-950/80 border border-slate-800 p-3">
              <strong class="block font-mono text-amber-300 mb-1">STEP 3 · 0.76 MM SCALE</strong>
              During assembly, set axial clearance using 1 standard ISO/IEC 7810 bank card (0.76 mm).
            </li>
          </ol>
        </section>

        <!-- Coupled Telemetry Hooks -->
        <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
          <h2 class="text-sm font-mono uppercase tracking-wider text-slate-400 mb-3">
            Recommended Metallurgical Operating Window
          </h2>
          <div class="grid grid-cols-3 gap-3 text-center">
            <div class="rounded-xl bg-slate-950 p-3 border border-slate-800">
              <div class="text-xs text-slate-400 font-mono">Slurry Density (Marcy SG)</div>
              <div class="text-lg font-bold text-amber-400 font-mono">
                {sku.telemetry_hooks.marcy_sg_range[0]} – {sku.telemetry_hooks.marcy_sg_range[1]} t/m³
              </div>
            </div>
            <div class="rounded-xl bg-slate-950 p-3 border border-slate-800">
              <div class="text-xs text-slate-400 font-mono">Plitt Cut Size d50c</div>
              <div class="text-lg font-bold text-sky-400 font-mono">
                {sku.telemetry_hooks.plitt_d50_um_range[0]} – {sku.telemetry_hooks.plitt_d50_um_range[1]} µm
              </div>
            </div>
            <div class="rounded-xl bg-slate-950 p-3 border border-slate-800">
              <div class="text-xs text-slate-400 font-mono">Typical Wear Life (Weibull)</div>
              <div class="text-lg font-bold text-emerald-400 font-mono">
                {sku.telemetry_hooks.wear_life_hours_range[0]} – {sku.telemetry_hooks.wear_life_hours_range[1]} h
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Right Column: Dual Checkout Lane (< 25,000 MXN Petty Cash vs > 25,000 MXN SAP PO) -->
      <aside class="lg:col-span-5 rounded-2xl border border-amber-500/40 bg-slate-900 p-6 shadow-xl space-y-5">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <span class="text-xs font-mono uppercase tracking-wider text-amber-400">
            Dual B2B Checkout (Zero Login)
          </span>
          <span class="text-xs font-mono text-emerald-400">● Durango Hub, MX</span>
        </div>

        <div>
          <h2 class="text-lg font-bold text-white mb-2">1. Available Alloys in Foundry / Molding</h2>
          <div class="flex flex-wrap gap-2">
            {sku.available_materials.map((mat: string) => (
              <span class={`px-3 py-1.5 rounded-lg text-xs font-mono font-bold border ${mat === sku.default_material ? 'bg-amber-500 text-slate-950 border-amber-400' : 'bg-slate-950 text-slate-300 border-slate-700'}`}>
                {mat} {mat === sku.default_material ? '(Standard)' : ''}
              </span>
            ))}
          </div>
        </div>

        <div>
          <h3 class="text-xs font-mono uppercase text-slate-400 mb-2">2. Linked Atomic Part Codes (13-Part BOM)</h3>
          <div class="flex flex-wrap gap-2">
            {sku.atomic_codes.map((code: string) => (
              <a
                href={`/en/catalog/${code.toLowerCase()}/`}
                class="px-3 py-1 rounded bg-slate-950 border border-slate-700 hover:border-amber-400 text-xs font-mono text-amber-300 transition"
              >
                🔗 {code}
              </a>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-1 gap-3 pt-1">
          <div class="rounded-xl border border-emerald-500/40 bg-emerald-950/20 p-3.5">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-mono font-bold text-emerald-300">⚡ LANE A: PETTY CASH (&lt; $25,000 MXN)</span>
              <span class="text-[11px] font-mono text-emerald-400">P1 · CFDI 4.0 TODAY</span>
            </div>
            <p class="text-xs text-slate-300">
              Express SPEI or corporate card release without SAP vendor onboarding delay. Same-day dispatch for <strong>🟢 IN STOCK</strong> items.
            </p>
          </div>

          <div class="rounded-xl border border-amber-500/40 bg-amber-950/20 p-3.5">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-mono font-bold text-amber-300">🏢 LANE B: PURCHASE ORDER (&gt; $25,000 MXN)</span>
              <span class="text-[11px] font-mono text-amber-400">SAP / ORACLE · B2B PASSPORT</span>
            </div>
            <p class="text-xs text-slate-300 mb-1.5">
              Formal PDF quotation with Tax Compliance Certificate (32-D) and active REPSE registration.
            </p>
            <div class="text-[11px] font-mono text-slate-400 bg-slate-950/80 rounded px-2.5 py-1.5 border border-slate-800">
              SAT ProdServ: <strong class="text-slate-200">{sat.clave_prod_serv}</strong> · Unit: <strong class="text-slate-200">{sat.clave_unidad}</strong> · HS/TIGIE: <strong class="text-slate-200">{sat.fraccion_arancelaria}</strong>
            </div>
          </div>
        </div>

        <div class="rounded-xl bg-slate-950/90 border border-slate-800 p-4 text-xs text-slate-300 space-y-1.5">
          <div class="font-mono text-slate-200 font-semibold">📋 Includes SMAT Vendor Passport:</div>
          <p>• Heat Metallurgical Certificate (PMI / Brinell Hardness ASTM A532)</p>
          <p>• Geometric Triplet Dimensional Verification (ISO 2768-m) in Durango</p>
          <p>• NIOSH / NOM-036-1-STPS Rigging & Ergonomic Safety Footprint</p>
        </div>

        <div class="flex flex-col gap-3 pt-2">
          <a
            href={`/en/contact/?sku=${encodeURIComponent(sku.id)}&part=${encodeURIComponent(sku.atomic_codes.join(','))}&mat=${encodeURIComponent(sku.default_material)}&lane=po`}
            class="w-full py-3.5 px-5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-center text-sm transition shadow-lg"
          >
            Request Formal Quote / SAP Passport ({sku.id}) →
          </a>
          <a
            href={`https://wa.me/526181302221?text=${encodeURIComponent(`Hello SMAT, I need an urgent quote for SKU ${sku.id} (${sku.title_en}) in alloy ${sku.default_material} [ Codes: ${sku.atomic_codes.join('/')} | Regime: ${sku.stock_regime || 'hay'} ].`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 px-5 rounded-xl border border-emerald-500/60 bg-emerald-950/40 hover:bg-emerald-900/50 text-emerald-300 font-mono text-center text-xs transition"
          >
            💬 Fast Checkout / Petty Cash via Engineering WhatsApp
          </a>
          <a
            href={`/en/#workbench?sku=${encodeURIComponent(sku.id)}&mat=${encodeURIComponent(sku.default_material)}`}
            class="w-full py-2.5 px-4 rounded-xl border border-slate-700 hover:border-sky-400 text-slate-300 hover:text-sky-300 font-mono text-center text-xs transition"
          >
            ⚙️ Open in Hydraulic & Metallurgical Workbench (Plane 2)
          </a>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>
