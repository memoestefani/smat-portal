---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductQuickCard from '../../../components/ProductQuickCard.astro';
import { getAllStaticProductRouteEntries } from '../../../scripts/quickProductsCatalog.js';

export function getStaticPaths() {
  const entries = getAllStaticProductRouteEntries('en');
  return entries.map((entry) => ({
    params: { slug: entry.routeSlug },
    props: {
      sku: entry.sku,
      isCanonical: entry.isCanonical,
      canonicalSlug: entry.canonicalSlug
    }
  }));
}

const { sku, canonicalSlug } = Astro.props;
const pageTitle = `${sku.title_en} | Fast Checkout SMAT Minerals`;
const pageDescription = `${sku.summary_en} Drop-In Cross Reference: ${sku.oem_cross_ref}. Hardness: ${sku.hardness_spec}.`;
const canonicalPath = `/en/products/${canonicalSlug || sku.slug_en}/`;
const sat = sku.sat_tuple || {
  clave_prod_serv: '40142000',
  clave_unidad: 'H87',
  fraccion_arancelaria: '8413.91.99.00'
};
const triplet = sku.geometric_triplet_mm || {
  a_id_mm: 100,
  b_od_mm: 400,
  c_thickness_mm: 80,
  tolerance_std: 'ISO 2768-m',
  label_en: 'A: Bore ID 100 mm | B: Outer OD 400 mm | C: Thickness 80 mm'
};

const nioshBadges: Record<string, { label: string; cls: string }> = {
  MANUAL_SAFE: {
    label: '🟢 Safe Manual Handling (< 11.1 kg NIOSH)',
    cls: 'smat-slug-badge--emerald'
  },
  ASSISTED_SHAFT_MOUNT_2P: {
    label: '🟡 2-Operator Assisted Mount (11.1–23.0 kg NIOSH)',
    cls: 'smat-slug-badge--amber'
  },
  HOIST_REQUIRED: {
    label: '🔴 Mechanical Hoist Required (> 23.0 kg NOM-036-1-STPS)',
    cls: 'smat-slug-badge--rose'
  }
};
const niosh = nioshBadges[sku.niosh_mode] || nioshBadges.HOIST_REQUIRED;
const hasAtomicPumpCodes = Array.isArray(sku.atomic_codes) && sku.atomic_codes.length > 0;
const castCodeLabel = hasAtomicPumpCodes ? sku.atomic_codes.join(', ') : sku.id;
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalPath} lang="en">
  <main class="smat-slug-main">
    <!-- Breadcrumb & language switcher -->
    <nav class="smat-slug-breadcrumb" aria-label="Breadcrumb">
      <div class="smat-slug-breadcrumb-links">
        <a href="/en/" class="smat-slug-nav-link">Home</a>
        <span>/</span>
        <a href="/en/catalog/" class="smat-slug-nav-link">19-SKU Catalog</a>
        <span>/</span>
        <span class="smat-slug-breadcrumb-current">{sku.id}</span>
      </div>
      <a href={`/productos/${sku.slug_es}/`} class="smat-slug-lang-switch">
        <span>ES</span>
        <span>Ficha en Español →</span>
      </a>
    </nav>

    <!-- Plane 1 Header: < 30s identification -->
    <header class="smat-slug-header">
      <div class="smat-slug-badge-row">
        <span class="smat-slug-badge smat-slug-badge--amber">
          {sku.id} · {sku.vertical.toUpperCase()} · GATE {sku.gate_lock || 'G1'}
        </span>
        <span class={`smat-slug-badge ${niosh.cls}`}>
          {niosh.label}
        </span>
        <span class="smat-slug-badge smat-slug-badge--neutral">
          Dry Mass: {sku.mass_kg} kg
        </span>
      </div>

      <h1 class="smat-slug-h1">
        {sku.title_en}
      </h1>
      <p class="smat-slug-lead">
        {sku.summary_en}
      </p>

      <div class="smat-slug-kpi-grid">
        <div class="smat-slug-kpi-box">
          <div class="smat-slug-kpi-label">Zero-OEM Drop-In Cross Reference</div>
          <div class="smat-slug-kpi-value smat-slug-kpi-value--amber">{sku.oem_cross_ref}</div>
        </div>
        <div class="smat-slug-kpi-box">
          <div class="smat-slug-kpi-label">Certified Metallurgy / Hardness</div>
          <div class="smat-slug-kpi-value">{sku.hardness_spec}</div>
        </div>
        <div class="smat-slug-kpi-box">
          <div class="smat-slug-kpi-label">Everyday Calibration Scale (ISO/IEC 7810)</div>
          <div class="smat-slug-kpi-value smat-slug-kpi-value--sky">{sku.everyday_scale_en}</div>
        </div>
      </div>
    </header>

    <!-- 2-Column Body: 3-in-1 ProductQuickCard + Dual B2B Checkout -->
    <div class="smat-slug-layout-grid">
      <div class="smat-slug-col-left">
        <ProductQuickCard sku={sku} lang="en" />

        <!-- 3-Step Plant Validation Box -->
        <section class="smat-slug-validation-card">
          <h2 class="smat-slug-section-kicker smat-slug-section-kicker--emerald">
            📋 How to Validate Your Part in Plant in 3 Steps (Zero Downtime Risk)
          </h2>
          <ol class="smat-slug-steps-grid">
            <li class="smat-slug-step-item">
              <strong class="smat-slug-step-title">STEP 1 · CAST / TAG CODE</strong>
              Check the identifier on your equipment ({castCodeLabel}) or send us a yard photo via WhatsApp.
            </li>
            <li class="smat-slug-step-item">
              <strong class="smat-slug-step-title">STEP 2 · TRIPLET (A, B, C)</strong>
              Confirm with caliper or tape: <span class="smat-slug-mono-inline">{triplet.label_en}</span> ({triplet.tolerance_std || 'ISO 2768-m'}).
            </li>
            <li class="smat-slug-step-item">
              <strong class="smat-slug-step-title">STEP 3 · 0.76 MM SCALE</strong>
              During assembly, set clearance or seating using 1 standard ISO/IEC 7810 bank card (0.76 mm).
            </li>
          </ol>
        </section>

        <!-- Coupled Telemetry Hooks -->
        <section class="smat-slug-telemetry-card">
          <h2 class="smat-slug-section-kicker">
            Recommended Metallurgical Operating Window
          </h2>
          <div class="smat-slug-telemetry-grid">
            <div class="smat-slug-telemetry-box">
              <div class="smat-slug-telemetry-label">Slurry Density (Marcy SG)</div>
              <div class="smat-slug-telemetry-val smat-slug-telemetry-val--amber">
                {sku.telemetry_hooks.marcy_sg_range[0]} – {sku.telemetry_hooks.marcy_sg_range[1]} t/m³
              </div>
            </div>
            <div class="smat-slug-telemetry-box">
              <div class="smat-slug-telemetry-label">Plitt Cut Size d50c</div>
              <div class="smat-slug-telemetry-val smat-slug-telemetry-val--sky">
                {sku.telemetry_hooks.plitt_d50_um_range[0]} – {sku.telemetry_hooks.plitt_d50_um_range[1]} µm
              </div>
            </div>
            <div class="smat-slug-telemetry-box">
              <div class="smat-slug-telemetry-label">Typical Wear Life (Weibull)</div>
              <div class="smat-slug-telemetry-val smat-slug-telemetry-val--emerald">
                {sku.telemetry_hooks.wear_life_hours_range[0]} – {sku.telemetry_hooks.wear_life_hours_range[1]} h
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Right Column: Dual Checkout Lane (< 25,000 MXN Petty Cash vs > 25,000 MXN SAP PO) -->
      <aside class="smat-slug-checkout-aside">
        <div class="smat-slug-aside-head">
          <span class="smat-slug-aside-kicker">
            Dual B2B Checkout (Zero Login)
          </span>
          <span class="smat-slug-aside-hub">● Durango Hub, MX</span>
        </div>

        <div>
          <h2 class="smat-slug-aside-h2">1. Available Alloys / Materials</h2>
          <div class="smat-slug-chip-row">
            {sku.available_materials.map((mat: string) => (
              <span class={`smat-slug-mat-chip ${mat === sku.default_material ? 'is-default' : ''}`}>
                {mat} {mat === sku.default_material ? '(Standard)' : ''}
              </span>
            ))}
          </div>
        </div>

        <div>
          {hasAtomicPumpCodes ? (
            <>
              <h3 class="smat-slug-aside-h3">2. Linked Atomic Part Codes (13-Part Pump BOM)</h3>
              <div class="smat-slug-chip-row">
                {sku.atomic_codes.map((code: string) => (
                  <a
                    href={`/en/catalog/${code.toLowerCase()}/`}
                    class="smat-slug-atomic-link"
                  >
                    🔗 {code}
                  </a>
                ))}
              </div>
            </>
          ) : (
            <>
              <h3 class="smat-slug-aside-h3">2. Circuit Coupling & Preventive Reorder Window (s, S)</h3>
              <div class="smat-slug-coupled-box">
                <div>
                  <strong>Recommended Coupled SKU:</strong> <span>{sku.coupled_pair_sku}</span>
                </div>
                <div>
                  <strong>Preventive Window (s, S):</strong> <span>Every {sku.reorder_window_days} operating days</span>
                </div>
              </div>
            </>
          )}
        </div>

        <div class="smat-slug-lanes-stack">
          <div class="smat-slug-lane-card smat-slug-lane-card--emerald">
            <div class="smat-slug-lane-head">
              <span class="smat-slug-lane-title smat-slug-lane-title--emerald">⚡ LANE A: PETTY CASH (&lt; 25,000 MXN)</span>
              <span class="smat-slug-lane-tag smat-slug-lane-tag--emerald">P1 · CFDI 4.0 TODAY</span>
            </div>
            <p class="smat-slug-lane-desc">
              Express SPEI or corporate card release without SAP vendor onboarding delay. Same-day dispatch for <strong>🟢 IN STOCK</strong> items.
            </p>
          </div>

          <div class="smat-slug-lane-card smat-slug-lane-card--amber">
            <div class="smat-slug-lane-head">
              <span class="smat-slug-lane-title smat-slug-lane-title--amber">🏢 LANE B: PURCHASE ORDER (&gt; 25,000 MXN)</span>
              <span class="smat-slug-lane-tag smat-slug-lane-tag--amber">SAP / ORACLE · B2B PASSPORT</span>
            </div>
            <p class="smat-slug-lane-desc">
              Formal PDF quotation with Tax Compliance Certificate (32-D) and active REPSE registration.
            </p>
            <div class="smat-slug-sat-pill">
              SAT ProdServ: <strong>{sat.clave_prod_serv}</strong> · Unit: <strong>{sat.clave_unidad}</strong> · HS/TIGIE: <strong>{sat.fraccion_arancelaria}</strong>
            </div>
          </div>
        </div>

        <div class="smat-slug-passport-box">
          <div class="smat-slug-passport-title">📋 Includes SMAT Vendor Passport:</div>
          <p>• Heat Metallurgical Certificate (PMI / Brinell Hardness ASTM A532)</p>
          <p>• Geometric Triplet Dimensional Verification (ISO 2768-m) in Durango</p>
          <p>• NIOSH / NOM-036-1-STPS Rigging & Ergonomic Safety Footprint</p>
        </div>

        <div class="smat-slug-cta-stack">
          <button
            type="button"
            data-quick-tray-add={sku.id}
            data-slug-add-to-tray={sku.id}
            data-sku-title={sku.title_en}
            data-sku-code={sku.atomic_codes[0] || sku.id}
            data-sku-material={sku.default_material}
            data-sku-regime={sku.stock_regime || 'hay'}
            data-sku-mass={sku.mass_kg}
            class="smat-slug-btn-primary"
          >
            🛒 Add to B2B Quote Tray / Request SAP Passport ({sku.id}) →
          </button>
          <a
            href={`https://wa.me/526183670664?text=${encodeURIComponent(`[SMAT-DGO] Hello SMAT, I need an urgent quote for SKU ${sku.id} (${sku.title_en}) in alloy ${sku.default_material} [ Regime: ${sku.stock_regime || 'hay'} | Mass: ${sku.mass_kg} kg ].`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="smat-slug-btn-wa"
          >
            💬 Fast Checkout / Petty Cash via Engineering WhatsApp (526183670664)
          </a>
          <a
            href={`/en/?sku=${encodeURIComponent(sku.id)}&mat=${encodeURIComponent(sku.default_material)}#workbench`}
            class="smat-slug-btn-workbench"
          >
            ⚙️ Open in Hydraulic & Metallurgical Workbench (Plane 2)
          </a>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .smat-slug-main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem 1rem;
    color: var(--smat-solar-ink, #0f172a);
  }

  @media (min-width: 640px) {
    .smat-slug-main {
      padding: 2.5rem 1.5rem;
    }
  }

  .smat-slug-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    color: var(--smat-solar-muted, #334155);
  }

  .smat-slug-breadcrumb-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .smat-slug-nav-link {
    color: var(--smat-solar-muted, #334155);
    text-decoration: none;
  }

  .smat-slug-nav-link:hover {
    color: var(--smat-solar-accent, #b45309);
  }

  .smat-slug-breadcrumb-current {
    font-weight: 700;
    color: var(--smat-solar-accent, #b45309);
  }

  .smat-slug-lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--smat-solar-border, #cbd5e1);
    background: #ffffff;
    color: var(--smat-solar-ink, #0f172a);
    text-decoration: none;
    font-weight: 600;
  }

  .smat-slug-lang-switch:hover {
    border-color: var(--smat-solar-amber-border, #d97706);
  }

  .smat-slug-header {
    background: var(--smat-solar-surface, #ffffff);
    border: 1px solid var(--smat-solar-border, #cbd5e1);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
  }

  @media (min-width: 640px) {
    .smat-slug-header {
      padding: 2rem;
    }
  }

  .smat-slug-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .smat-slug-badge {
    padding: 0.25rem 0.625rem;
    border-radius: 6px;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    border: 1px solid transparent;
  }

  .smat-slug-badge--amber {
    background: var(--smat-solar-amber-bg, #fffbeb);
    border-color: var(--smat-solar-amber-border, #d97706);
    color: var(--smat-solar-accent, #b45309);
  }

  .smat-slug-badge--emerald {
    background: var(--smat-solar-emerald-bg, #ecfdf5);
    border-color: var(--smat-solar-emerald-border, #059669);
    color: var(--smat-solar-emerald, #047857);
  }

  .smat-slug-badge--rose {
    background: #fff1f2;
    border-color: #e11d48;
    color: #be123c;
  }

  .smat-slug-badge--neutral {
    background: var(--smat-solar-bg, #f8fafc);
    border-color: var(--smat-solar-border, #cbd5e1);
    color: var(--smat-solar-ink, #0f172a);
  }

  .smat-slug-h1 {
    margin: 0 0 0.75rem 0;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--smat-solar-ink, #0f172a);
  }

  @media (min-width: 640px) {
    .smat-slug-h1 {
      font-size: 2.25rem;
    }
  }

  .smat-slug-lead {
    margin: 0 0 1.25rem 0;
    max-width: 56rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--smat-solar-muted, #334155);
  }

  .smat-slug-kpi-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--smat-solar-border, #cbd5e1);
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .smat-slug-kpi-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .smat-slug-kpi-box {
    padding: 0.875rem;
    border-radius: 12px;
    background: var(--smat-solar-bg, #f8fafc);
    border: 1px solid var(--smat-solar-border, #cbd5e1);
  }

  .smat-slug-kpi-label {
    margin-bottom: 0.25rem;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--smat-solar-muted, #334155);
  }

  .smat-slug-kpi-value {
    font-weight: 700;
    color: var(--smat-solar-ink, #0f172a);
  }

  .smat-slug-kpi-value--amber {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    color: var(--smat-solar-accent, #b45309);
  }

  .smat-slug-kpi-value--sky {
    color: #0369a1;
  }

  .smat-slug-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .smat-slug-layout-grid {
      grid-template-columns: 7fr 5fr;
    }
  }

  .smat-slug-col-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .smat-slug-validation-card {
    padding: 1.25rem;
    border-radius: 16px;
    border: 1px solid var(--smat-solar-emerald-border, #059669);
    background: var(--smat-solar-emerald-bg, #ecfdf5);
  }

  .smat-slug-section-kicker {
    margin: 0 0 0.75rem 0;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--smat-solar-muted, #334155);
  }

  .smat-slug-section-kicker--emerald {
    color: var(--smat-solar-emerald, #047857);
  }

  .smat-slug-steps-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--smat-solar-ink, #0f172a);
  }

  @media (min-width: 640px) {
    .smat-slug-steps-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .smat-slug-step-item {
    padding: 0.75rem;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid var(--smat-solar-border, #cbd5e1);
    line-height: 1.45;
  }

  .smat-slug-step-title {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    color: var(--smat-solar-accent, #b45309);
  }

  .smat-slug-mono-inline {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-weight: 700;
  }

  .smat-slug-telemetry-card {
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--smat-solar-border, #cbd5e1);
    background: #ffffff;
  }

  .smat-slug-telemetry-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    text-align: center;
  }

  .smat-slug-telemetry-box {
    padding: 0.75rem;
    border-radius: 12px;
    background: var(--smat-solar-bg, #f8fafc);
    border: 1px solid var(--smat-solar-border, #cbd5e1);
  }

  .smat-slug-telemetry-label {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    color: var(--smat-solar-muted, #334155);
  }

  .smat-slug-telemetry-val {
    margin-top: 0.25rem;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 1.0625rem;
    font-weight: 800;
  }

  .smat-slug-telemetry-val--amber {
    color: var(--smat-solar-accent, #b45309);
  }

  .smat-slug-telemetry-val--sky {
    color: #0369a1;
  }

  .smat-slug-telemetry-val--emerald {
    color: var(--smat-solar-emerald, #047857);
  }

  .smat-slug-checkout-aside {
    padding: 1.5rem;
    border-radius: 16px;
    border: 2px solid var(--smat-solar-amber-border, #d97706);
    background: #ffffff;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .smat-slug-aside-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--smat-solar-border, #cbd5e1);
  }

  .smat-slug-aside-kicker {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--smat-solar-accent, #b45309);
  }

  .smat-slug-aside-hub {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--smat-solar-emerald, #047857);
  }

