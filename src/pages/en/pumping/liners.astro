---
// src/pages/en/pumping/liners.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../../scripts/workbenchBus.js';
import { WET_END_MATERIAL_MATRIX } from '../../../scripts/slurryEngine.js';
import rolesData from '../../../../data/roles.json';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const revRole = allRoles.find((r) => r.role_id === 'revestimientos');
const dc = revRole?.decision_criteria;
const throatbushPart = getAtomicPartSpecs('E4083');
const wetMaterials = [
  WET_END_MATERIAL_MATRIX.alto_cromo_cr27,
  WET_END_MATERIAL_MATRIX.hule_natural,
  WET_END_MATERIAL_MATRIX.poliuretano,
  WET_END_MATERIAL_MATRIX.ceramica_sic,
  (WET_END_MATERIAL_MATRIX as any).hybrid_a05_r55
].filter(Boolean);
---

<BaseLayout 
  title="Volute Liners & Throatbushes in High Chrome, Rubber & Polyurethane | SMAT Minerals"
  description="Wet-end wear parts in High Chrome, Rubber, and Polyurethane: volutes, throatbushes, and frame plate liner inserts supplied by lot."
  lang="en"
>
  <section class="page-hero smat-compact-hero">
    <div class="container">
      <a href="/en/pumping/" class="back-link">← Back to Slurry Pumps</a>
      <div style="margin-top: 0.3rem;">
        <span class="badge badge-copper">WET-END WEAR PARTS · 5-5-4 LOT</span>
      </div>
      <h1>Volute Liners, Throatbushes & Liners</h1>
      <p class="smat-hero-sub">
        Live tribological calibration for wet-end lots across 27% High Chrome A05, Natural Rubber R55, Polyurethane U01, SiC, and Hybrid Branch D.
      </p>
    </div>
  </section>

  <section class="section smat-stage-compact">
    <div class="container">
      <!-- STRATUM 1: Volute Liner Comparison Matrix -->
      <div id="stratum1-liners-sim" data-testid="liners-material-matrix" data-stratum-1-instrument>
        <div class="card" style="margin-bottom: 1rem; background: #f8fafc; border: 1.5px solid #cbd5e1; padding: clamp(0.7rem, 1.4vw, 1.1rem);">
          <span class="badge badge-copper">LIVE SIMULATOR · MONOLITHIC VS SPLIT CASING ARCHITECTURE &amp; HYBRID BRANCH D</span>
          <h2 style="margin: 0.3rem 0 0.45rem; font-size: clamp(0.98rem, 1.4vw, 1.1rem);">FPL/CPL Split Liners, Monolithic Volute &amp; Finnie-Hutchings Angular Partition Verifier</h2>
          <div class="smat-stratum1-display">
            <div id="trib-status-out" style="padding: 0.5rem 0.75rem; border-radius: 6px; background: #ecfdf5; border: 1px solid #059669; color: #064e3b; font-family: var(--smat-font-mono); font-size: 0.79rem; font-weight: 700;">
              Toughness OK · Series 6x4 · Finnie-Hutchings Angular Partition: 27% High Chrome Closed Impeller (A05) + Split R55 Natural Rubber Liners (FPL/CPL).
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.45rem; font-family: var(--smat-font-mono); font-size: 0.78rem;">
              <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Active Configuration:</strong> <span id="trib-mat-out">Hybrid Branch D: A05 Impeller + R55 Liners</span></div>
              <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Toughness K<sub>Ic</sub>:</strong> <span id="trib-kic-out">18.5 MPa·√m</span></div>
              <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>NIOSH Mass &amp; Rigging:</strong> <span id="trib-arch-out">418 kg · 5 NIOSH ≥ 23 kg</span></div>
            </div>
          </div>
          <div class="smat-inputs-2col" style="margin-bottom: 0.65rem; padding: 0.6rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.8rem;">
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Particle Size d<sub>80</sub> (µm):</span>
              <input type="number" id="trib-d80-um" min="20" max="6000" step="25" value="250" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Tip Speed u₂ (m/s):</span>
              <input type="number" id="trib-vtip-ms" min="10" max="36" step="0.5" value="21.5" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Slurry pH:</span>
              <input type="number" id="trib-ph" min="1.0" max="13.5" step="0.5" value="7.5" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>5-5-4 Lot Architecture:</span>
              <select id="trib-branch" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                <option value="hibrido_a05_r55" selected>Hybrid Branch D (A05 Impeller + R55 Liners)</option>
                <option value="auto">Auto (Finnie-Hutchings)</option>
                <option value="metal">Monolithic 27% High Chrome (A05)</option>
                <option value="rubber">Split Natural Rubber (R55)</option>
                <option value="polyurethane">Split Polyurethane (U01)</option>
                <option value="ceramica_sic">Monolithic SiC Ceramic</option>
              </select>
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Pump Series:</span>
              <select id="trib-series" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                <option value="3x2">3x2 / 4x3</option>
                <option value="6x4" selected>6x4</option>
                <option value="8x6">8x6 / 10x8</option>
              </select>
            </label>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center;">
            <a href="/en/quote/?circuito=bombeo&equipo=kit_wet_end&pieza=voluta_liners&estacion=S3#rfq" class="btn btn-primary" style="min-height: 48px; display: inline-flex; align-items: center;">Quote Calibrated Wet-End Lot →</a>
            <button
              type="button"
              class="btn btn-outline btn-avenue-tray"
              data-vertical-tray-btn
              data-add-tray-sku="SMAT-PUMP-TB-083"
              data-tray-part-code="E4083"
              data-tray-title="Calibrated Wet-End Lot & Throatbush 5-5-4"
              data-tray-series="6x4"
              data-tray-material="hybrid_a05_r55"
              data-tray-circuit="bombeo"
              data-tray-source="liners_stratum1_calc"
              style="min-height: 48px;"
            >+ Add Calibrated SKU to Tray</button>
          </div>
        </div>
        <h3 style="margin-top: 1.25rem;">Wet-End Material Matrix (A05 / R55 / U01 / SiC Ceramic / Hybrid Branch D) &amp; Gülich Law Δη_v = k_r·(δ/b₂)^1.5</h3>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(230px, 1fr)); gap:0.85rem; margin-top:0.65rem;">
          {wetMaterials.map((mat) => (
            <div class="card" style="background:#ffffff; border:1px solid #cbd5e1; padding:1rem;">
              <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#082f49;">[{mat.code}] {mat.hardness}</span>
              <h3 style="margin:0.35rem 0; font-size:0.98rem;">{mat.nameEn}</h3>
              <p style="font-size:0.82rem; color:#334155; margin-bottom:0.45rem;">{mat.dutyApplicationEn}</p>
              <div class="font-mono-tech" style="font-size:0.73rem; color:#475569; margin-bottom:0.55rem;">
                u₂ ≤ {mat.maxTipSpeedMs} m/s • K_Ic = {mat.fractureToughnessMpaSqrtM} MPa·√m • Clearance δ = {mat.recommendedClearanceMm} mm • Lot {mat.wearRatio554}
              </div>
              <a href={`/en/quote/?circuito=bombeo&equipo=kit_wet_end&material=${mat.key}&claro_mm=${mat.recommendedClearanceMm}&estacion=S3#rfq`} data-card-fixed-params="material" class="btn btn-primary" style="width:100%; text-align:center; font-size:0.78rem;">Quote {mat.code} Kit →</a>
            </div>
          ))}
        </div>
      </div>

      <!-- STRATO 2: Technical CAD Diagrams & Engineering Breakdown -->
      <div style="margin-top: 2rem;">
        <TechnicalDiagrams diagram="liners" lang="en" />
      </div>

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Wet-End Lot Ordering</h2>
          <p>
            In mining operations, wet-end contact parts are not purchased one by one. To keep pumps running at peak hydraulic efficiency and prevent unplanned stockouts, plants order balanced wet-end lots matched to component wear rates (for example: <strong>5 impellers, 5 throatbushes, and 4 volute liners</strong>).
          </p>

          <h3 style="margin-top: 1.75rem;">Available Materials & Components</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Liner Materials</th>
                  <td><strong>27% High Chrome (A05), Natural Rubber (R55), Polyurethane (U01), and Sintered Silicon Carbide (SiC ≥ 2200 HV)</strong></td>
                </tr>
                <tr>
                  <th>Wet-End Components</th>
                  <td>Volute Liner, Throatbush (<em>Cuello</em>), Frame Plate Liner Insert, and Impeller</td>
                </tr>
                <tr>
                  <th>High Chrome</th>
                  <td>High-chrome white iron casting (≥ 650 HB) for mill discharge and coarse, sharp-edged particles</td>
                </tr>
                <tr>
                  <th>Rubber & Polyurethane</th>
                  <td>Compression-molded elastomers and tear-resistant polyurethane for fine particles, hydrocyclones, flotation, and corrosive slurries</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Sample Plant Lot Configuration</h3>
            <p>
              The <strong>throatbush</strong> and <strong>impeller</strong> operate with a tight front clearance and require more frequent replacement than the volute. Ordering in matched lots (e.g., 5 impellers + 5 throatbushes + 4 volutes) prevents pairing a new impeller with a worn throatbush.
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/en/quote/?circuito=bombeo&equipo=kit_wet_end&pieza=voluta_liners&estacion=S3#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote Wet-End Lot (5-5-4) →</a>
              <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="btn btn-outline" style="width: 100%; text-align: center;">View Pump Assembly & Exploded BOM →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[ENGINEERING DECISION CRITERIA — 5-5-4 LOT]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Metallurgical Rule:</strong> {dc.metallurgy_rule_en}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Critical Variables:</strong> {dc.required_slurry_vars_en}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Avoided Risk:</strong> {dc.risk_avoided_en}</p>
            </div>
          )}
        </div>
      </div>

      {throatbushPart && (
        <div class="card" data-testid="throatbush-atomic-card" style="margin-top:1.75rem; background:#f8fafc; border:1.5px solid #cbd5e1;">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
            <span class="badge badge-copper">{throatbushPart.part_number} — {throatbushPart.name_en} ({throatbushPart.smat_code})</span>
            <span class="font-mono-tech" style="font-size:0.75rem; font-weight:800; color:var(--smat-text-primary);">
              Mass: {throatbushPart.weight_kg} kg • {throatbushPart.niosh_handling_mode} (LI={throatbushPart.niosh_lifting_index_shaft}) • Wall: {throatbushPart.wall_thickness_mm} mm
            </span>
          </div>
          <p style="font-size:0.85rem; color:#334155; margin:0.5rem 0;">
            {throatbushPart.summary_en} <strong>Station 0{throatbushPart.station_number}:</strong> {throatbushPart.assembly_order_note}. Calibrating front clearance within <strong>δ = 0.5–1.0 mm</strong> prevents volumetric recirculation loss Δη_v = k_r·(δ/b₂)^1.5 from degrading the 5:5:4 wear lot ratio into 5:9:4.
          </p>
          <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
            <a href={`/en/catalog/${throatbushPart.code}/`} class="btn btn-outline">View {throatbushPart.part_number} Sheet →</a>
            <a href={`/en/quote/?codigo=${throatbushPart.part_number}&circuito=bombeo&equipo=kit_wet_end&serie=${throatbushPart.pipe_size}&peso_kg=${throatbushPart.weight_kg}&estacion=S${throatbushPart.station_number}#rfq`} class="btn btn-primary">Quote {throatbushPart.part_number} →</a>
            <button
              type="button"
              class="btn btn-outline btn-avenue-tray"
              data-add-tray-sku="SMAT-PUMP-TB-083"
              data-tray-part-code={throatbushPart.part_number}
              data-tray-title={throatbushPart.name_en}
              data-tray-series={throatbushPart.pipe_size}
              data-tray-material="A05"
              data-tray-circuit="bombeo"
              data-tray-category="BOMBA_SLURRY"
              data-tray-source="throatbush_atomic_card"
              style="min-height: 48px;"
            >+ Tray</button>
          </div>
        </div>
      )}

      <div style="margin-top: 2.25rem;">
        <h2>Wet-End Kit Comparison by Material: High Chrome (≥650 HB), Natural Rubber & Polyurethane</h2>
        <TechnicalDiagrams diagram="material_kit_grid" lang="en" />
      </div>

      <div style="margin-top: 2.25rem;">
        <h2>Throatbush & Front Axial Clearance Calibration (δ = 0.5–1.0 mm)</h2>
        <TechnicalDiagrams diagram="suction_throatbush" lang="en" />
      </div>

      <SharePurchasing
        roleTitle="Wet-End Wear Lot: Volute Liners & Throatbushes (5-5-4)"
        series="1.5x1 to 14x12 Series (4x3, 6x4, 8x6, 10x8)"
        metallurgy="High Chrome 27% (A05 ≥ 650 HB), Rubber, and Polyurethane"
        specs="Matched wet-end wear lot (impellers, throatbushes, volutes, and frame plate liner inserts) with 1:1 dimensional verification."
        roleId="revestimientos"
        circuit="bombeo"
        lang="en"
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { bindCanonicalTribologySelector } from '../../../scripts/verticalCalculatorsAndLabelsBridge.js';
  import { bindAtomicPartTrayButtons } from '../../../scripts/verticalStateAndCtaSyncBridge.js';
  bindCanonicalTribologySelector(document, 'en');
  bindAtomicPartTrayButtons(document);
</script>

<style>
  .back-link { color: var(--smat-solar-accent); font-size: 0.88rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
</style>
