---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TribologyAlloyIsland from '../../../components/islands/TribologyAlloyIsland.astro';

const title = 'Volute Liners & Throatbushes in High Chrome, Rubber & Polyurethane | SMAT Minerals';
const description = 'Wet-end wear parts in High Chrome, Rubber, and Polyurethane: volutes, throatbushes, and frame plate liner inserts supplied by lot.';
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath="/en/pumping/liners/"
  alternateEsPath="/bombeo/revestimientos/"
  alternateEnPath="/en/pumping/liners/"
>
  <TribologyAlloyIsland locale="en" variant="liners" mode="standalone" />
</BaseLayout>
