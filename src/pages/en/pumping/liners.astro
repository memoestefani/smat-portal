---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
---

<BaseLayout 
  title="Slurry Pump Liners, Volutes & Throatbushes | SMAT Minerals"
  description="High-mass split volute liners, throatbushes, and frame plate liner inserts in High Chrome 27% (A05) and elastomer. Urgent dispatch from Durango, Mexico."
  lang="en"
  canonicalPath="/en/pumping/liners/"
  alternateEsPath="/bombeo/revestimientos/"
  alternateEnPath="/en/pumping/liners/"
>
  <Header slot="header" lang="en" currentPath="/en/pumping/liners/" alternatePath="/bombeo/revestimientos/" />

  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">OPEX • IMMEDIATE DURANGO DISPATCH</span>
      <h1>Liners, Volute Casings & Throatbushes</h1>
      <p class="subtitle">Severe wear protection for split casing pumps across 4x3 to 10x8 sizes.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <h2>Reinforced Cross-Sections at Critical Cutwater Zones</h2>
        <p>
          SMAT Minerals slurry pump volutes are manufactured with oversized cross-sectional wall thickness at the cutwater tongue where severe particle impingement and turbulent hydraulic eddy currents cause accelerated erosion.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Component</th>
              <th>Materials & Options</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Volute Casing Liner</td>
              <td>High Chrome 27% Cr (A05) or vulcanized natural rubber bonded to steel skeleton</td>
            </tr>
            <tr>
              <td>Throatbush</td>
              <td>A05 precision machined for micro-metric front axial gap clearance adjustment</td>
            </tr>
            <tr>
              <td>Frame Plate Liner Insert</td>
              <td>High-integrity wear plate resisting both particle impact and acidic mine water</td>
            </tr>
            <tr>
              <td>O-Rings & Gaskets</td>
              <td>NBR / EPDM precision molded seals preventing peripheral joint leakage</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Slurry Pump Liners & Volute Casings"
          series="Standard fit for 4x3 C, 6x4 D, 8x6 E, 10x8 F pumps"
          metallurgy="High Chrome 27% (A05) / Elastomer"
          specs="High-mass volute liners with reinforced cutwater thickness and axial clearance adjustment for minimal internal recirculation."
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">IMMEDIATE DISPATCH FROM DURANGO FACILITY</span>
            <h3>Need A05 volutes or throatbushes for scheduled shutdown?</h3>
            <p>Generate your official technical requisition with verified part numbers and 1:1 dimensional fit.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/?equipo=revestimientos#rfq" class="btn btn-primary btn-lg">
              Quote Volute / Liners in Central Workbench →
            </a>
            <a href="https://wa.me/526188104408?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20A05%20Volutes%20and%20Liners" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Inquire Plant Stock via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton lang="en" />
  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
