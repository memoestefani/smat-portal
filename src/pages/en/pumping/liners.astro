---
// src/pages/en/pumping/liners.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../../scripts/workbenchBus.js';
import { WET_END_MATERIAL_MATRIX } from '../../../scripts/slurryEngine.js';
import rolesData from '../../../../data/roles.json';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const revRole = allRoles.find((r) => r.role_id === 'revestimientos');
const dc = revRole?.decision_criteria;
const throatbushPart = getAtomicPartSpecs('E4083');
const wetMaterials = [
  WET_END_MATERIAL_MATRIX.alto_cromo_cr27,
  WET_END_MATERIAL_MATRIX.hule_natural,
  WET_END_MATERIAL_MATRIX.poliuretano,
  WET_END_MATERIAL_MATRIX.ceramica_sic
];
---

<BaseLayout 
  title="Volute Liners & Throatbushes in High Chrome, Rubber & Polyurethane | SMAT Minerals"
  description="Wet-end wear parts in High Chrome, Rubber, and Polyurethane: volutes, throatbushes, and frame plate liner inserts supplied by lot."
  lang="en"
>
  <section class="page-hero">
    <div class="container">
      <a href="/en/pumping/" class="back-link">← Back to Slurry Pumps</a>
      <div style="margin-top: 1rem;">
        <span class="badge badge-copper">WET-END WEAR PARTS</span>
      </div>
      <h1>Volute Liners, Throatbushes & Liners</h1>
      <p style="font-size: 1.08rem; max-width: 720px; color: var(--smat-text-secondary);">
        Wet-end contact parts manufactured in <strong>High Chrome, Rubber, and Polyurethane</strong>: volutes, throatbushes, and frame plate liner inserts for slurry pumps.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="liners" lang="en" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Wet-End Lot Ordering</h2>
          <p>
            In mining operations, wet-end contact parts are not purchased one by one. To keep pumps running at peak hydraulic efficiency and prevent unplanned stockouts, plants order balanced wet-end lots matched to component wear rates (for example: <strong>5 impellers, 5 throatbushes, and 4 volute liners</strong>).
          </p>

          <h3 style="margin-top: 1.75rem;">Available Materials & Components</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Liner Materials</th>
                  <td><strong>27% High Chrome (A05), Natural Rubber (R55), Polyurethane (U01), and Sintered Silicon Carbide (SiC ≥ 2200 HV)</strong></td>
                </tr>
                <tr>
                  <th>Wet-End Components</th>
                  <td>Volute Liner, Throatbush (<em>Cuello</em>), Frame Plate Liner Insert, and Impeller</td>
                </tr>
                <tr>
                  <th>High Chrome</th>
                  <td>High-chrome white iron casting (≥ 650 HB) for mill discharge and coarse, sharp-edged particles</td>
                </tr>
                <tr>
                  <th>Rubber & Polyurethane</th>
                  <td>Compression-molded elastomers and tear-resistant polyurethane for fine particles, hydrocyclones, flotation, and corrosive slurries</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Sample Plant Lot Configuration</h3>
            <p>
              The <strong>throatbush</strong> and <strong>impeller</strong> operate with a tight front clearance and require more frequent replacement than the volute. Ordering in matched lots (e.g., 5 impellers + 5 throatbushes + 4 volutes) prevents pairing a new impeller with a worn throatbush.
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/en/quote/?circuito=bombeo&equipo=kit_wet_end&pieza=voluta_liners&estacion=S3#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote Wet-End Lot (5-5-4) →</a>
              <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="btn btn-outline" style="width: 100%; text-align: center;">View Pump Assembly & Exploded BOM →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[ENGINEERING DECISION CRITERIA — 5-5-4 LOT]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Metallurgical Rule:</strong> {dc.metallurgy_rule_en}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Critical Variables:</strong> {dc.required_slurry_vars_en}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Avoided Risk:</strong> {dc.risk_avoided_en}</p>
            </div>
          )}
        </div>
      </div>

      <!-- 4 Wet-End Material Cards (A05, R55, U01, SiC) + Atomic Throatbush Card E4083 -->
      <div style="margin-top: 2rem;" data-testid="liners-material-matrix">
        <h2>4-Material Wet-End Matrix (A05 / R55 / U01 / SiC Ceramic) & Gülich Law Δη_v = k_r·(δ/b₂)^1.5</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(230px, 1fr)); gap:0.85rem; margin-top:0.85rem;">
          {wetMaterials.map((mat) => (
            <div class="card" style="background:#ffffff; border:1px solid #cbd5e1; padding:1rem;">
              <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#082f49;">[{mat.code}] {mat.hardness}</span>
              <h3 style="margin:0.35rem 0; font-size:0.98rem;">{mat.nameEn}</h3>
              <p style="font-size:0.82rem; color:#334155; margin-bottom:0.45rem;">{mat.dutyApplicationEn}</p>
              <div class="font-mono-tech" style="font-size:0.73rem; color:#475569; margin-bottom:0.55rem;">
                u₂ ≤ {mat.maxTipSpeedMs} m/s • K_Ic = {mat.fractureToughnessMpaSqrtM} MPa·√m • Clearance δ = {mat.recommendedClearanceMm} mm • Lot {mat.wearRatio554}
              </div>
              <a href={`/en/quote/?circuito=bombeo&equipo=kit_wet_end&material=${mat.key}&claro_mm=${mat.recommendedClearanceMm}&estacion=S3#rfq`} class="btn btn-primary" style="width:100%; text-align:center; font-size:0.78rem;">Quote {mat.code} Kit →</a>
            </div>
          ))}
        </div>

        {throatbushPart && (
          <div class="card" data-testid="throatbush-atomic-card" style="margin-top:1.25rem; background:#f8fafc; border:1.5px solid #cbd5e1;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
              <span class="badge badge-copper">{throatbushPart.part_number} — {throatbushPart.name_en} ({throatbushPart.smat_code})</span>
              <span class="font-mono-tech" style="font-size:0.75rem; font-weight:800; color:var(--smat-text-primary);">
                Mass: {throatbushPart.weight_kg} kg • {throatbushPart.niosh_handling_mode} (LI={throatbushPart.niosh_lifting_index_shaft}) • Wall: {throatbushPart.wall_thickness_mm} mm
              </span>
            </div>
            <p style="font-size:0.85rem; color:#334155; margin:0.5rem 0;">
              {throatbushPart.summary_en} <strong>Station 0{throatbushPart.station_number}:</strong> {throatbushPart.assembly_order_note}. Calibrating front clearance within <strong>δ = 0.5–1.0 mm</strong> prevents volumetric recirculation loss Δη_v = k_r·(δ/b₂)^1.5 from degrading the 5:5:4 wear lot ratio into 5:9:4.
            </p>
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
              <a href={`/en/catalog/${throatbushPart.code}/`} class="btn btn-outline">View {throatbushPart.part_number} Sheet →</a>
              <a href={`/en/quote/?codigo=${throatbushPart.part_number}&circuito=bombeo&equipo=kit_wet_end&serie=${throatbushPart.pipe_size}&peso_kg=${throatbushPart.weight_kg}&estacion=S${throatbushPart.station_number}#rfq`} class="btn btn-primary">Quote {throatbushPart.part_number} →</a>
            </div>
          </div>
        )}
      </div>

      <div style="margin-top: 2.25rem;">
        <h2>Wet-End Kit Comparison by Material: High Chrome (≥650 HB), Natural Rubber & Polyurethane</h2>
        <TechnicalDiagrams diagram="material_kit_grid" lang="en" />
      </div>

      <div style="margin-top: 2.25rem;">
        <h2>Throatbush & Front Axial Clearance Calibration (δ = 0.5–1.0 mm)</h2>
        <TechnicalDiagrams diagram="suction_throatbush" lang="en" />
      </div>

      <SharePurchasing
        roleTitle="Wet-End Wear Lot: Volute Liners & Throatbushes (5-5-4)"
        series="1.5x1 to 14x12 Frames (4x3 C, 6x4 D, 8x6 E, 10x8 F)"
        metallurgy="High Chrome 27% (A05 ≥ 650 HB), Rubber, and Polyurethane"
        specs="Matched wet-end wear lot (impellers, throatbushes, volutes, and frame plate liner inserts) with 1:1 dimensional verification."
        roleId="kit_wet_end"
        circuit="bombeo"
        lang="en"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 2.75rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.5rem; }
  .back-link { color: var(--smat-copper-accent); font-size: 0.9rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .page-hero { padding: 0.75rem 0; }
    .page-hero h1 { font-size: 1.35rem; margin: 0.2rem 0; }
    .page-hero p { font-size: 0.82rem !important; line-height: 1.3; margin: 0.2rem 0; }
  }
</style>
