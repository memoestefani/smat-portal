---
// src/pages/en/pumping/bearing-assembly.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import rolesData from '../../../../data/roles.json';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const soporteRole = allRoles.find((r) => r.role_id === 'soporte');
const dc = soporteRole?.decision_criteria;
---

<BaseLayout 
  title="Bearing Assembly / Housing | SMAT Minerals"
  description="Bearing Assembly / Housing: complete assembled cartridge unit with cylindrical housing, shaft, tapered roller bearings, and labyrinth seals for slurry pumps."
  lang="en"
>
  <section class="page-hero smat-compact-hero">
    <div class="container">
      <a href="/en/pumping/" class="back-link">← Back to Slurry Pumps</a>
      <div style="margin-top: 0.3rem;">
        <span class="badge badge-copper">STATION 01 · BEARING ASSEMBLY / HOUSING</span>
      </div>
      <h1>Bearing Assembly / Housing</h1>
      <p class="smat-hero-sub">
        Live ISO 281 L₁₀ₘₕ bearing life calibration, recommended frame sizing, and DAM005 Core Trade-In exchange (-22% / -12%).
      </p>
    </div>
  </section>

  <section class="section smat-stage-compact">
    <div class="container">
      <!-- STRATUM 1: ISO 281:2007 L10h & Modified Life L10mh Inspector + Dual Action -->
      <div class="card" id="stratum1-bearing-inspector" data-bearing-inspector data-stratum-1-instrument style="margin-bottom: 1.5rem; background: #f8fafc; border: 1.5px solid #cbd5e1; padding: clamp(0.7rem, 1.4vw, 1.1rem);">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.45rem; margin-bottom:0.45rem;">
          <span class="badge badge-copper">ISO 281:2007 RATING (p = 10/3)</span>
          <span class="font-mono-tech" style="font-size:0.75rem; font-weight:700; color:#0c4a6e;">L₁₀ₘₕ = a_ISO(e_c·C_u/P, κ) · (C/P)^(10/3)</span>
        </div>
        <h2 style="margin:0 0 0.45rem; font-size: clamp(0.98rem, 1.4vw, 1.12rem);">Modified Bearing Life L₁₀ₘₕ Inspector (Labyrinth Seal vs Contaminated Felt) &amp; Radial Belt Load Fᵣ</h2>
        <div class="smat-stratum1-display">
          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:0.45rem;">
            <div style="background:#ecfdf5; border:1px solid #059669; border-radius:8px; padding:0.5rem 0.65rem;">
              <span class="font-mono-tech" style="font-size:0.68rem; color:#064e3b; font-weight:800;">MODIFIED LIFE SMAT LABYRINTH SEAL</span>
              <div style="font-size:1.05rem; font-weight:800; color:#064e3b;" data-bear-l10mh-lab>52,438 h (a_ISO = 1.25×)</div>
              <div style="font-size:0.74rem; color:#064e3b;" data-bear-l10h>Base ISO 281 L₁₀h = 41,950 h (e_c ≥ 0.6)</div>
            </div>
            <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:0.5rem 0.65rem;">
              <span class="font-mono-tech" style="font-size:0.68rem; color:#334155; font-weight:800;">RADIAL BELT LOAD (Fᵣ) &amp; P_eq</span>
              <div style="font-size:1.05rem; font-weight:800; color:var(--smat-text-primary);" data-bear-fr>6.71 kN (P = 14.81 kN)</div>
              <div style="font-size:0.74rem; color:#334155;" data-bear-rpm>n₂ = 1001 RPM • u₂ = 19.92 m/s</div>
            </div>
            <div style="background:#fef2f2; border:1px solid #dc2626; border-radius:8px; padding:0.5rem 0.65rem;">
              <span class="font-mono-tech" style="font-size:0.68rem; color:#7f1d1d; font-weight:800;">CONTAMINATED FELT SEAL RISK</span>
              <div style="font-size:1.05rem; font-weight:800; color:#7f1d1d;" data-bear-l10mh-cont>9,229 h (a_ISO = 0.22×)</div>
              <div style="font-size:0.74rem; color:#7f1d1d;">Silica ingress (e_c ≤ 0.1) cuts life by -82%</div>
            </div>
            <div style="background:#f0f9ff; border:1px solid #0284c7; border-radius:8px; padding:0.5rem 0.65rem;">
              <span class="font-mono-tech" style="font-size:0.68rem; color:#0c4a6e; font-weight:800;">RECOMMENDED FRAME (P_max / n_max / SHAFT Ø)</span>
              <div style="font-size:0.92rem; font-weight:800; color:#082f49;" data-bear-frame-spec>Frame Series D (DAM005 • Shaft Ø 75 mm)</div>
              <div style="font-size:0.74rem; color:#0c4a6e;" data-bear-frame-limits>P_max = 110 kW • n_max = 1400 RPM • C_dyn = 215 kN</div>
            </div>
          </div>
        </div>

        <div class="smat-inputs-2col" style="margin:0.5rem 0 0.65rem; padding:0.6rem; background:#ffffff; border:1px solid #e2e8f0; border-radius:8px;">
          <label style="display:flex; flex-direction:column; gap:0.2rem; font-size:0.78rem; font-weight:700;">
            <span>Drive Arrangement:</span>
            <select data-bear-arr style="padding:0.35rem; border:1px solid #cbd5e1; border-radius:6px;">
              <option value="CV" selected>CV — Overhead Motor</option>
              <option value="ZVZ">ZVZ — Elevated Rear Motor</option>
              <option value="CRZ">CRZ — Side-by-Side Base Motor</option>
              <option value="DC">DC — Direct Inline Coupling (Fᵣ = 0 kN)</option>
            </select>
          </label>
          <label style="display:flex; flex-direction:column; gap:0.2rem; font-size:0.78rem; font-weight:700;">
            <span>Dynamic Capacity C (kN):</span>
            <select data-bear-c style="padding:0.35rem; border:1px solid #cbd5e1; border-radius:6px;">
              <option value="95">95 kN — 3x2" / 4x3" Series</option>
              <option value="195" selected>195 kN — 6x4" Series</option>
              <option value="285">285 kN — 8x6" Series</option>
              <option value="390">390 kN — 10x8" / 12x10" Series</option>
            </select>
          </label>
          <label style="display:flex; flex-direction:column; gap:0.2rem; font-size:0.78rem; font-weight:700;">
            <span>Shaft Power P (kW): <strong data-bear-kw-lbl>45 kW</strong></span>
            <input type="range" min="15" max="250" step="5" value="45" data-bear-kw />
          </label>
        </div>
        <div style="margin-top:0.85rem;">
          <div style="display:flex; flex-wrap:wrap; gap:0.65rem; align-items:center;">
            <a
              href="/en/quote/?circuito=bombeo&equipo=kit_rodamientos&pieza=bearing_assembly&estacion=S1&transmision=CV&cap_c_kn=195&l10h=41950#rfq"
              class="btn btn-primary"
              data-bear-cta
              style="min-height:48px; display:inline-flex; align-items:center;"
            >
              Quote Calibrated Bearing Assembly →
            </a>
            <button
              type="button"
              class="btn btn-outline btn-avenue-tray"
              data-vertical-tray-btn
              data-add-tray-sku="SMAT-PUMP-BRG-005M"
              data-tray-part-code="DAM005"
              data-tray-title="Complete Bearing Assembly Cartridge (DAM005)"
              data-tray-series="CV"
              data-tray-material="GGG40"
              data-tray-circuit="bombeo"
              data-tray-source="bearing_stratum1_calc"
              style="min-height: 48px;"
            >+ Add Calibrated SKU to Tray</button>
          </div>

          <div
            data-core-tradein-widget="DAM005"
            data-lang="en"
            style="width: 100%; margin-top: 0.75rem; padding: 0.85rem; border-radius: 8px; background: #ecfdf5; border: 1px solid #10b981; font-size: 0.78rem; color: #064e3b;"
          >
            <div style="font-family: var(--font-mono-tech, monospace); font-weight: 800; color: #065f46; margin-bottom: 0.35rem;">
              ♻️ SMAT DAM005 CORE TRADE-IN PROGRAM (-22% / -12% H7 REMANUFACTURING)
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.5rem; margin-bottom: 0.4rem;">
              <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 700;">
                <span>Used Housing Condition</span>
                <select data-tradein-condition data-core-tradein-condition style="padding: 0.35rem 0.45rem; border: 1px solid #059669; border-radius: 6px; background: #ffffff; color: #1c1917; font-size: 0.75rem;">
                  <option value="h7_intact" selected>Intact Crack-Free Housing (-22% • 0.78x)</option>
                  <option value="minor_bearing_seizure">Bearing Seizure / Recoverable Bore (-12% • 0.88x)</option>
                  <option value="cracked_housing">Cracked or Welded Housing (0% • 1.00x)</option>
                </select>
              </label>
              <label style="display: flex; align-items: center; gap: 0.35rem; font-weight: 700; padding-top: 1rem;">
                <input type="checkbox" data-tradein-not-welded data-core-tradein-toggle checked />
                <span>Unwelded H7 Bearing Bore (ISO IT6)</span>
              </label>
            </div>
            <div data-tradein-result data-core-tradein-badge style="font-family: var(--font-mono-tech, monospace); font-weight: 800; color: #065f46;">
              Active: -22% Core Trade-In Credit (Factor 0.78x • RMA-CORE-DAM005-INTACT)
            </div>
            <div data-tradein-co2 data-core-tradein-note style="font-size: 0.72rem; color: #047857; margin-top: 0.2rem;">
              Physical return at Central Warehouse: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166 (35 kg CO₂e saved)
            </div>
          </div>
        </div>
      </div>

      <!-- STRATUM 2: Primary Technical Diagram of Bearing Assembly / Housing -->
      <TechnicalDiagrams diagram="bearing" lang="en" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>A Complete Unit Ready for Installation</h2>
          <p>
            The <strong>Bearing Assembly / Housing</strong> is supplied as a complete, pre-assembled unit: it includes the cylindrical cast housing, precision-machined shaft with impeller thread, back-to-back tapered roller bearings, end covers, and labyrinth seals at both ends.
          </p>

          <h3 style="margin-top: 1.75rem;">Bearing Assembly / Housing Components</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Configuration</th>
                  <td>Complete assembled cartridge (Bearing Assembly / Housing)</td>
                </tr>
                <tr>
                  <th>Housing</th>
                  <td>Ductile iron cylindrical barrel with lifting lugs and bottom axial adjustment lug</td>
                </tr>
                <tr>
                  <th>Shaft</th>
                  <td>High-tensile alloy steel with precision impeller thread and drive-end keyway</td>
                </tr>
                <tr>
                  <th>Bearings</th>
                  <td>Heavy-duty double-row tapered roller bearings</td>
                </tr>
                <tr>
                  <th>Sealing Protection</th>
                  <td>Labyrinth seals and piston rings at both ends to prevent slurry and moisture ingress</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Drop-In Replacement & Axial Adjustment</h3>
            <p>
              Keeping a complete <strong>Bearing Assembly / Housing</strong> in plant inventory allows maintenance crews to swap the entire drive end in minutes during a scheduled shutdown and adjust front impeller-to-throatbush clearance using the bottom adjusting screw.
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/en/quote/?circuito=bombeo&equipo=kit_rodamientos&pieza=bearing_assembly&estacion=S1#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote Bearing Assembly / Housing →</a>
              <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="btn btn-outline" style="width: 100%; text-align: center;">View Station 1 & Axial Adjustment (δ) →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[ENGINEERING DECISION CRITERIA — STATION 01]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Metallurgical Rule:</strong> {dc.metallurgy_rule_en}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Critical Variables:</strong> {dc.required_slurry_vars_en}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Avoided Risk:</strong> {dc.risk_avoided_en}</p>
            </div>
          )}
        </div>
      </div>

      <SharePurchasing
        roleTitle="Complete Bearing Assembly / Housing"
        series="4x3 to 10x8 Series (Suction × Discharge)"
        metallurgy="Ductile Iron Housing, High-Tensile Alloy Shaft & Tapered Roller Bearings"
        specs="Complete pre-assembled cylindrical cartridge with precision shaft, back-to-back tapered roller bearings, and labyrinth seals."
        roleId="kit_rodamientos"
        circuit="bombeo"
        lang="en"
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { initBearingSupportInspector } from '../../../scripts/verticalBidirectionalHydrationLens.js';
  initBearingSupportInspector(document, 'en');
  document.addEventListener('astro:page-load', () => initBearingSupportInspector(document, 'en'));
</script>

<style>
  .back-link { color: var(--smat-solar-accent); font-size: 0.88rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
</style>
