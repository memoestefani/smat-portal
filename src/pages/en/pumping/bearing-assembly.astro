---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
---

<BaseLayout 
  title="Slurry Pump Bearing Assemblies & Shafts | SMAT Minerals"
  description="Heavy-duty bearing cartridge assemblies and forged alloy shafts for slurry pumps. Assembled, pre-lubricated, and balanced at our Durango, Mexico plant."
  lang="en"
  canonicalPath="/en/pumping/bearing-assembly/"
  alternateEsPath="/bombeo/soporte/"
  alternateEnPath="/en/pumping/bearing-assembly/"
>
  <Header slot="header" lang="en" currentPath="/en/pumping/bearing-assembly/" alternatePath="/bombeo/soporte/" />

  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">OPEX • IMMEDIATE DURANGO DISPATCH</span>
      <h1>Bearing Assemblies & Rigid Shafts</h1>
      <p class="subtitle">Heavy-duty cartridge bearing assemblies for C, D, E, and F frames with dynamic balancing.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <h2>Torsional Rigidity & Ingress Protection</h2>
        <p>
          The mechanical bearing assembly is the structural backbone of any centrifugal slurry pump. SMAT Minerals delivers fully assembled cartridges, pre-greased, sealed with dual non-contacting labyrinth rings, and fitted with heavy-duty tapered roller bearings calculated to withstand high radial and axial shock loads from density surges and pump cavitation.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Mechanical Component</th>
              <th>SMAT Specification</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Machined Shaft</td>
              <td>High-strength forged alloy steel (AISI 4140 / 4340) with minimal overhang for negligible deflection</td>
            </tr>
            <tr>
              <td>Roller Bearings</td>
              <td>Heavy-duty Timken / SKF tapered roller bearings with calculated L10 life exceeding 50,000 operating hours</td>
            </tr>
            <tr>
              <td>Bearing Housing</td>
              <td>Ductile nodular iron casting with convective cooling ribs resisting mechanical shock and cracking</td>
            </tr>
            <tr>
              <td>Labyrinth Sealing</td>
              <td>Dual-barrier non-contact grease purges preventing wash-water, grit, or slurry ingress into races</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Slurry Pump Bearing Assembly"
          series="Frames CAM, DAM, EAM, FAM"
          metallurgy="Forged AISI 4140 Shaft, Nodular Iron Housing, Timken/SKF Bearings"
          specs="Fully assembled bearing cartridge preloaded and lubricated with dual labyrinth grease seals against abrasive slurry ingress."
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">IMMEDIATE DISPATCH FROM DURANGO WAREHOUSE</span>
            <h3>Need pre-assembled, lubricated bearing cartridges?</h3>
            <p>Generate your official serialized technical requisition with frame size and shop pre-load verification.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/?equipo=soporte#rfq" class="btn btn-primary btn-lg">
              Quote Bearing Assembly in Central Workbench →
            </a>
            <a href="https://wa.me/526183670664?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20Bearing%20Assemblies" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Inquire Warehouse Stock via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton lang="en" />
  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
