---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SealDriveBearingIsland from '../../../components/islands/SealDriveBearingIsland.astro';

const title = 'Centrifugal Expeller & Stuffing Box (No Mechanical Seal) | SMAT Minerals';
const description = 'Centrifugal expeller, expeller ring, shaft sleeve, and stuffing box sealing for slurry pumps. We do not sell mechanical seals due to corrosive and abrasive mining slurries.';
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath="/en/pumping/seal/"
  alternateEsPath="/bombeo/sello/"
  alternateEnPath="/en/pumping/seal/"
>
  <SealDriveBearingIsland locale="en" variant="seal" mode="standalone" />
</BaseLayout>
