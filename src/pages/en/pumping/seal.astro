---
// src/pages/en/pumping/seal.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../../scripts/workbenchBus.js';
import rolesData from '../../../../data/roles.json';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const selloRole = allRoles.find((r) => r.role_id === 'sello');
const dc = selloRole?.decision_criteria;
const sealParts = [getAtomicPartSpecs('DAM028'), getAtomicPartSpecs('EAM028')].filter(Boolean);
---

<BaseLayout 
  title="Centrifugal Expeller & Stuffing Box (No Mechanical Seal) | SMAT Minerals"
  description="Centrifugal expeller, expeller ring, shaft sleeve, and stuffing box sealing for slurry pumps. We do not sell mechanical seals due to corrosive and abrasive mining slurries."
  lang="en"
>
  <section class="page-hero smat-compact-hero">
    <div class="container">
      <a href="/en/pumping/" class="back-link">← Back to Slurry Pumps</a>
      <div style="margin-top: 0.3rem;">
        <span class="badge badge-copper">STATION 02 · CENTRIFUGAL EXPELLER & STUFFING BOX</span>
      </div>
      <h1>Centrifugal Expeller & Stuffing Box</h1>
      <p class="smat-hero-sub">
        Live sealing pressure calibration: Dry Expeller (02A Zero Flush Water) vs Flushed Stuffing Box (02B) — no mechanical seals.
      </p>
    </div>
  </section>

  <section class="section smat-stage-compact">
    <div class="container">
      <!-- STRATUM 1: Interactive Comparator & Live Sealing Calculator -->
      <div class="card" id="stratum1-seal-sim" data-seal-branch-comparator data-stratum-1-instrument style="margin-bottom: 1.5rem; background: #f8fafc; border: 1.5px solid #cbd5e1; padding: clamp(0.7rem, 1.4vw, 1.1rem);">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.45rem; margin-bottom:0.45rem;">
          <span class="badge badge-copper">STATION 02 SEALING BIFURCATION</span>
          <span class="font-mono-tech" style="font-size:0.75rem; font-weight:700; color:#0c4a6e;">ΔP_exp = ½·ρ_m·k_ω²·ω²·(R_exp² - R_h²) &gt; P_s + ΔP_back</span>
        </div>
        <h2 style="margin:0 0 0.45rem; font-size: clamp(0.98rem, 1.4vw, 1.12rem);">Live Calculator: Expeller Counter-Pressure (02A Dry) vs Stuffing Box Flush Water (02B Wet)</h2>
        <div class="smat-stratum1-display">
          <div id="seal-status-out" style="padding: 0.55rem 0.75rem; border-radius: 6px; background: #ecfdf5; border: 1px solid #059669; color: #064e3b; font-family: var(--smat-font-mono); font-size: 0.79rem; font-weight: 700;">
            Branch 02A Viable (Dry Expeller Seal • 0 GPM gland water • Hs/Hd = 11.4%): Positive centrifugal margin.
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.45rem; font-family: var(--smat-font-mono); font-size: 0.78rem;">
            <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Expeller Pressure:</strong> <span id="seal-pexp-out">118.4 kPa</span></div>
            <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Stuffing Box Pressure:</strong> <span id="seal-pbox-out">88.8 kPa</span></div>
            <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Flush Water Req.:</strong> <span id="seal-pwater-out">0 L/min</span></div>
            <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Recommended Branch:</strong> <span id="seal-branch-out">02A · Dry Expeller Seal</span></div>
          </div>
        </div>
        <div class="smat-inputs-2col" style="margin: 0.5rem 0 0.65rem; padding: 0.6rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.8rem;">
          <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
            <span>Total Head TDH (m):</span>
            <input type="number" id="seal-hd-m" min="5" max="110" step="1" value="28" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
          </label>
          <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
            <span>Suction Head H<sub>s</sub> (m):</span>
            <input type="number" id="seal-hs-m" min="0" max="25" step="0.5" value="3.2" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
          </label>
          <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
            <span>Expeller Ø (mm):</span>
            <input type="number" id="seal-exp-dia" min="140" max="520" step="10" value="280" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
          </label>
          <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
            <span>Pump Speed (RPM):</span>
            <input type="number" id="seal-rpm" min="400" max="2200" step="25" value="1150" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
          </label>
          <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
            <span>Slurry Density (SG<sub>m</sub>):</span>
            <input type="number" id="seal-sg" min="1.05" max="2.20" step="0.02" value="1.38" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
          </label>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center; margin-bottom: 0.85rem;">
          <a href="/en/quote/?circuito=bombeo&equipo=kit_sellado&pieza=expeller_sello&seal_branch=expeller_dry&estacion=S2#rfq" class="btn btn-primary" style="min-height: 48px; display: inline-flex; align-items: center;">Quote Calibrated Sealing →</a>
          <button
            type="button"
            class="btn btn-outline btn-avenue-tray"
            data-vertical-tray-btn
            data-add-tray-sku="SMAT-SEAL-EXPELLER"
            data-tray-part-code="E4028"
            data-tray-title="Calibrated Expeller Seal System (02A)"
            data-tray-series="02A"
            data-tray-material="A05"
            data-tray-circuit="bombeo"
            data-tray-source="seal_stratum1_calc"
            style="min-height: 48px;"
          >+ Add Calibrated SKU to Tray</button>
        </div>
        <div class="grid-2" style="margin-top:0.75rem;">
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:1rem;">
            <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#064e3b;">[STATION 02A — DRY EXPELLER SEAL]</span>
            <h4 style="margin:0.35rem 0;">Dry Centrifugal Expeller (Zero Gland Water)</h4>
            <p style="font-size:0.85rem; color:#334155;">Recommended when suction head P_s ≤ 18% of total head H and fixed speed or VFD ≥ 70% nominal RPM. Prevents %Cw dilution feeding hydrocyclones and flotation.</p>
            <a href="/en/quote/?circuito=bombeo&equipo=kit_sellado&seal_branch=expeller_dry&estacion=S2#rfq" data-card-fixed-params="seal_branch" class="btn btn-primary" style="margin-top:0.5rem;">Configure Station 02A (Dry) →</a>
          </div>
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:1rem;">
            <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#0c4a6e;">[STATION 02B — FLUSHED GLAND PACKING]</span>
            <h4 style="margin:0.35rem 0;">Wet Packed Stuffing Box (Lantern Ring Flushing)</h4>
            <p style="font-size:0.85rem; color:#334155;">Required in multi-stage series pumping (stage 2+), high positive suction head P_s &gt; 18% H, or low-speed VFD turndown where expeller ω² head drops.</p>
            <a href="/en/quote/?circuito=bombeo&equipo=kit_sellado&seal_branch=gland_water&estacion=S2#rfq" data-card-fixed-params="seal_branch" class="btn btn-outline" style="margin-top:0.5rem;">Configure Station 02B (Wet) →</a>
          </div>
        </div>
      </div>

      <!-- STRATUM 2: Technical Diagram & Reference Tables -->
      <TechnicalDiagrams diagram="expeller" lang="en" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Why We Use Centrifugal Expellers & Stuffing Boxes (No Mechanical Seals)</h2>
          <p>
            In mineral slurry pumping with corrosive reagents and abrasive suspended solids, delicate flat-face mechanical seals rapidly fracture or seize. Our slurry pumps use a <strong>centrifugal expeller</strong> paired with an <strong>expeller ring and braided-packing stuffing box</strong>, operating dry without external gland water that would dilute the process slurry.
          </p>

          <h3 style="margin-top: 1.75rem;">Sealing Assembly Components</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Centrifugal Expeller</th>
                  <td>High Chrome or Rubber; generates a dynamic pressure ring that repels slurry from the shaft</td>
                </tr>
                <tr>
                  <th>Expeller Ring & Stuffing Box</th>
                  <td>Heavy-duty casting housing the braided packing and lantern ring</td>
                </tr>
                <tr>
                  <th>Shaft Sleeve</th>
                  <td>Hardened stainless steel sleeve protecting the Bearing Assembly shaft</td>
                </tr>
                <tr>
                  <th>Braided Packing</th>
                  <td>PTFE and graphite synthetic packing for static shutdown sealing</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Zero Slurry Dilution</h3>
            <p>
              Centrifugal expeller sealing eliminates external gland water injection, preserving pulp density stability feeding hydrocyclones and flotation banks.
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/en/quote/?circuito=bombeo&equipo=kit_sellado&pieza=expeller_sello&seal_branch=expeller_dry&estacion=S2#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote Centrifugal Expeller (St. 02A Dry) →</a>
              <a href="/en/quote/?circuito=bombeo&equipo=kit_sellado&pieza=expeller_sello&seal_branch=gland_water&estacion=S2#rfq" class="btn btn-outline" style="width: 100%; text-align: center;">Quote Wet Gland Packing (St. 02B) →</a>
              <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="btn btn-outline" style="width: 100%; text-align: center;">View Station 2 in Assembly Report →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[ENGINEERING DECISION CRITERIA — STATION 02]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Metallurgical Rule:</strong> {dc.metallurgy_rule_en}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Critical Variables:</strong> {dc.required_slurry_vars_en}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Avoided Risk:</strong> {dc.risk_avoided_en}</p>
            </div>
          )}
        </div>
      </div>

      <!-- Atomic Sealing Spare Parts (DAM028 & EAM028) with NIOSH Mass & Rigging -->
      <div style="margin-top: 2rem;" data-testid="seal-atomic-parts">
        <h2>Verified Atomic Sealing Spares at Durango Warehouse (DAM028 / EAM028)</h2>
        <div class="grid-2" style="margin-top: 1rem;">
          {sealParts.map((sp) => (
            <div class="card" style="background:#ffffff; border:1px solid #cbd5e1;">
              <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                <span class="badge badge-copper">{sp.part_number} ({sp.smat_code})</span>
                <span class="font-mono-tech" style="font-size:0.74rem; font-weight:700; color:var(--smat-text-primary);">{sp.weight_kg} kg • {sp.niosh_handling_mode} (LI={sp.niosh_lifting_index_shaft})</span>
              </div>
              <h3 style="margin-top:0.5rem;">{sp.name_en}</h3>
              <p style="font-size:0.86rem; color:#334155;">{sp.summary_en}</p>
              <div class="font-mono-tech" style="font-size:0.75rem; color:#475569; margin-bottom:0.85rem;">
                Series {sp.pipe_size.toUpperCase()} ({sp.frame}) • Wall {sp.wall_thickness_mm} mm • Station 0{sp.station_number} ({sp.assembly_order_note})
              </div>
              <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <a href={`/en/catalog/${sp.code}/`} class="btn btn-outline">View {sp.part_number} Sheet →</a>
                <a href={`/en/quote/?codigo=${sp.part_number}&circuito=bombeo&equipo=kit_sellado&serie=${sp.pipe_size}&peso_kg=${sp.weight_kg}&estacion=S${sp.station_number}#rfq`} class="btn btn-primary">Quote {sp.part_number} →</a>
                <button
                  type="button"
                  class="btn btn-outline btn-avenue-tray"
                  data-add-tray-sku="SMAT-PUMP-EXP-028"
                  data-tray-part-code={sp.part_number}
                  data-tray-title={sp.name_en}
                  data-tray-series={sp.pipe_size}
                  data-tray-material="A05"
                  data-tray-category="BOMBA_SLURRY"
                  data-tray-source="seal_atomic_card"
                  style="min-height: 48px;"
                >+ Tray</button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <SharePurchasing
        roleTitle="Centrifugal Expeller, Expeller Ring & Stuffing Box"
        series="1.5x1 to 14x12 Series (4x3, 6x4, 8x6, 10x8)"
        metallurgy="High Chrome 27% (A05), Hardened Stainless Steel & PTFE/Graphite Packing"
        specs="Dry centrifugal expeller and braided-packing stuffing box assembly (no mechanical seals) for zero slurry dilution."
        roleId="kit_sellado"
        circuit="bombeo"
        lang="en"
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { bindCanonicalSealBalanceCalculator } from '../../../scripts/verticalCalculatorsAndLabelsBridge.js';
  import { bindAtomicPartTrayButtons } from '../../../scripts/verticalStateAndCtaSyncBridge.js';
  bindCanonicalSealBalanceCalculator(document, 'en');
  bindAtomicPartTrayButtons(document);
</script>

<style>
  .back-link { color: var(--smat-solar-accent); font-size: 0.88rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
</style>
