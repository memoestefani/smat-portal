---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
---

<BaseLayout 
  title="Mechanical Seals, Expellers & Stuffing Boxes | SMAT Minerals"
  description="Dynamic shaft sealing systems for slurry pumps: centrifugal expellers, graphited packing stuffing boxes, and cartridge slurry mechanical seals. Durango, Mexico."
  lang="en"
  canonicalPath="/en/pumping/seal/"
  alternateEsPath="/bombeo/sello/"
  alternateEnPath="/en/pumping/seal/"
>
  <Header slot="header" lang="en" currentPath="/en/pumping/seal/" alternatePath="/bombeo/sello/" />

  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">OPEX • IMMEDIATE DURANGO DISPATCH</span>
      <h1>Mechanical Seals & Gland Assemblies</h1>
      <p class="subtitle">Eliminate chronic slurry leakage and operate with or without external water flush.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <h2>Sealing Engineering for Heavy Mining Slurries</h2>
        <p>
          Shaft seal failures represent the leading cause of unscheduled shutdowns and bearing contamination in tailings and concentrate pumping circuits. SMAT provides three proven field configurations matching your plant water balance:
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Sealing Type</th>
              <th>Operating Advantages</th>
              <th>Flush Water Requirement</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Dynamic Centrifugal Expeller Seal</td>
              <td>Auxiliary back-impeller expels solids away from shaft via centrifugal force during operation.</td>
              <td><strong>Zero gland water required</strong> (ideal for arid locations and water-conservation mills).</td>
            </tr>
            <tr>
              <td>Standard Packed Gland</td>
              <td>Graphite or PTFE reinforced packing rings with split lantern ring for clean water injection.</td>
              <td>Continuous clean water supply at pressure exceeding pump discharge.</td>
            </tr>
            <tr>
              <td>Heavy-Duty Cartridge Mechanical Seal</td>
              <td>Silicon carbide vs tungsten carbide faces lubricated by process slurry or barrier fluid.</td>
              <td>Zero product dilution and zero visible leakage across plant floor.</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Dynamic / Mechanical Slurry Pump Seal"
          series="Universal compatibility for C, D, E, F frames"
          metallurgy="Silicon Carbide / Tungsten Carbide / Graphited PTFE"
          specs="Dynamic expeller sealing for flush-free operation or cartridge mechanical slurry seals for high-density applications."
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">IMMEDIATE DISPATCH FROM DURANGO WAREHOUSE</span>
            <h3>Need seal assemblies to stop chronic pump leakage?</h3>
            <p>Generate your official technical requisition with seal type and frame compatibility verification.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/?equipo=sello#rfq" class="btn btn-primary btn-lg">
              Quote Mechanical Seal / Expeller in Central Workbench →
            </a>
            <a href="https://wa.me/526188104408?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20Slurry%20Pump%20Seals" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Inquire Warehouse Stock via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton lang="en" />
  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
