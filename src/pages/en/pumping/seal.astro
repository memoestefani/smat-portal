---
// src/pages/en/pumping/seal.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../../scripts/workbenchBus.js';
import rolesData from '../../../../data/roles.json';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const selloRole = allRoles.find((r) => r.role_id === 'sello');
const dc = selloRole?.decision_criteria;
const sealParts = [getAtomicPartSpecs('DAM028'), getAtomicPartSpecs('EAM028')].filter(Boolean);
---

<BaseLayout 
  title="Centrifugal Expeller & Stuffing Box (No Mechanical Seal) | SMAT Minerals"
  description="Centrifugal expeller, expeller ring, shaft sleeve, and stuffing box sealing for slurry pumps. We do not sell mechanical seals due to corrosive and abrasive mining slurries."
  lang="en"
>
  <section class="page-hero">
    <div class="container">
      <a href="/en/pumping/" class="back-link">← Back to Slurry Pumps</a>
      <div style="margin-top: 1rem;">
        <span class="badge badge-copper">CENTRIFUGAL EXPELLER & STUFFING BOX</span>
      </div>
      <h1>Centrifugal Expeller & Stuffing Box</h1>
      <p style="font-size: 1.08rem; max-width: 720px; color: var(--smat-text-secondary);">
        Centrifugal sealing components for slurry pumps: expeller, expeller ring, shaft sleeve, and packed stuffing box. <strong>We do not sell mechanical seals</strong> because mineral slurry pumps operate in highly corrosive and abrasive conditions.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="expeller" lang="en" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Why We Use Centrifugal Expellers & Stuffing Boxes (No Mechanical Seals)</h2>
          <p>
            In mineral slurry pumping with corrosive reagents and abrasive suspended solids, delicate flat-face mechanical seals rapidly fracture or seize. Our slurry pumps use a <strong>centrifugal expeller</strong> paired with an <strong>expeller ring and braided-packing stuffing box</strong>, operating dry without external gland water that would dilute the process slurry.
          </p>

          <h3 style="margin-top: 1.75rem;">Sealing Assembly Components</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Centrifugal Expeller</th>
                  <td>High Chrome or Rubber; generates a dynamic pressure ring that repels slurry from the shaft</td>
                </tr>
                <tr>
                  <th>Expeller Ring & Stuffing Box</th>
                  <td>Heavy-duty casting housing the braided packing and lantern ring</td>
                </tr>
                <tr>
                  <th>Shaft Sleeve</th>
                  <td>Hardened stainless steel sleeve protecting the Bearing Assembly shaft</td>
                </tr>
                <tr>
                  <th>Braided Packing</th>
                  <td>PTFE and graphite synthetic packing for static shutdown sealing</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Zero Slurry Dilution</h3>
            <p>
              Centrifugal expeller sealing eliminates external gland water injection, preserving pulp density stability feeding hydrocyclones and flotation banks.
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/en/quote/?circuito=bombeo&equipo=kit_sellado&pieza=expeller_sello&seal_branch=expeller_dry&estacion=S2#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote Centrifugal Expeller (St. 02A Dry) →</a>
              <a href="/en/quote/?circuito=bombeo&equipo=kit_sellado&pieza=expeller_sello&seal_branch=gland_water&estacion=S2#rfq" class="btn btn-outline" style="width: 100%; text-align: center;">Quote Wet Gland Packing (St. 02B) →</a>
              <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="btn btn-outline" style="width: 100%; text-align: center;">View Station 2 in Assembly Report →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[ENGINEERING DECISION CRITERIA — STATION 02]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Metallurgical Rule:</strong> {dc.metallurgy_rule_en}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Critical Variables:</strong> {dc.required_slurry_vars_en}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Avoided Risk:</strong> {dc.risk_avoided_en}</p>
            </div>
          )}
        </div>
      </div>

      <!-- Bifurcated Station 02A (Dry Expeller) vs Station 02B (Gland Water) Comparator & VFD Law -->
      <div class="card" data-seal-branch-comparator style="margin-top: 2rem; background: #f8fafc; border: 1.5px solid #cbd5e1;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.85rem;">
          <span class="badge badge-copper">STATION 02 SEALING BIFURCATION</span>
          <span class="font-mono-tech" style="font-size:0.75rem; font-weight:700; color:#0c4a6e;">ΔP_exp = ½·ρ_m·k_ω²·ω²·(R_exp² - R_h²) &gt; P_s + ΔP_back</span>
        </div>
        <h3>Technical Selector: Station 02A (Dry Expeller) vs Station 02B (Lantern-Ring Gland Water)</h3>
        <div class="grid-2" style="margin-top:0.85rem;">
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:1rem;">
            <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#065f46;">[STATION 02A — EXPELLER_DRY]</span>
            <h4 style="margin:0.35rem 0;">Dry Centrifugal Expeller (Zero Gland Water)</h4>
            <p style="font-size:0.85rem; color:#334155;">Recommended when suction head P_s ≤ 15% of total head H and fixed speed or VFD ≥ 70% nominal RPM. Prevents %Cw dilution feeding hydrocyclones and flotation.</p>
            <a href="/en/quote/?circuito=bombeo&equipo=kit_sellado&seal_branch=expeller_dry&estacion=S2#rfq" class="btn btn-primary" style="margin-top:0.5rem;">Configure Station 02A (Dry) →</a>
          </div>
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:1rem;">
            <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#0c4a6e;">[STATION 02B — GLAND_WATER]</span>
            <h4 style="margin:0.35rem 0;">Wet Packed Stuffing Box (Lantern Ring Flushing)</h4>
            <p style="font-size:0.85rem; color:#334155;">Required in multi-stage series pumping (stage 2+), high positive suction head P_s &gt; 20% H, or low-speed VFD turndown where expeller ω² head drops.</p>
            <a href="/en/quote/?circuito=bombeo&equipo=kit_sellado&seal_branch=gland_water&estacion=S2#rfq" class="btn btn-outline" style="margin-top:0.5rem;">Configure Station 02B (Wet) →</a>
          </div>
        </div>
      </div>

      <!-- Atomic Sealing Spare Parts (DAM028 & EAM028) with NIOSH Mass & Rigging -->
      <div style="margin-top: 2rem;" data-testid="seal-atomic-parts">
        <h2>Verified Atomic Sealing Spares at Durango Warehouse (DAM028 / EAM028)</h2>
        <div class="grid-2" style="margin-top: 1rem;">
          {sealParts.map((sp) => (
            <div class="card" style="background:#ffffff; border:1px solid #cbd5e1;">
              <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                <span class="badge badge-copper">{sp.part_number} ({sp.smat_code})</span>
                <span class="font-mono-tech" style="font-size:0.74rem; font-weight:700; color:var(--smat-text-primary);">{sp.weight_kg} kg • {sp.niosh_handling_mode} (LI={sp.niosh_lifting_index_shaft})</span>
              </div>
              <h3 style="margin-top:0.5rem;">{sp.name_en}</h3>
              <p style="font-size:0.86rem; color:#334155;">{sp.summary_en}</p>
              <div class="font-mono-tech" style="font-size:0.75rem; color:#475569; margin-bottom:0.85rem;">
                Frame {sp.frame} (Series {sp.pipe_size.toUpperCase()}) • Wall {sp.wall_thickness_mm} mm • Station 0{sp.station_number} ({sp.assembly_order_note})
              </div>
              <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <a href={`/en/catalog/${sp.code}/`} class="btn btn-outline">View {sp.part_number} Sheet →</a>
                <a href={`/en/quote/?codigo=${sp.part_number}&circuito=bombeo&equipo=kit_sellado&serie=${sp.pipe_size}&peso_kg=${sp.weight_kg}&estacion=S${sp.station_number}#rfq`} class="btn btn-primary">Quote {sp.part_number} →</a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <SharePurchasing
        roleTitle="Centrifugal Expeller, Expeller Ring & Stuffing Box"
        series="1.5x1 to 14x12 Frames (4x3 C, 6x4 D, 8x6 E, 10x8 F)"
        metallurgy="High Chrome 27% (A05), Hardened Stainless Steel & PTFE/Graphite Packing"
        specs="Dry centrifugal expeller and braided-packing stuffing box assembly (no mechanical seals) for zero slurry dilution."
        roleId="kit_sellado"
        circuit="bombeo"
        lang="en"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 2.75rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.5rem; }
  .back-link { color: var(--smat-copper-accent); font-size: 0.9rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .page-hero { padding: 0.75rem 0; }
    .page-hero h1 { font-size: 1.35rem; margin: 0.2rem 0; }
    .page-hero p { font-size: 0.82rem !important; line-height: 1.3; margin: 0.2rem 0; }
  }
</style>
