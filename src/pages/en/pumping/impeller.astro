---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
---

<BaseLayout 
  title="High Chrome 27% (A05) Slurry Pump Impellers | SMAT Minerals"
  description="Severe abrasion closed slurry pump impellers. High Chrome 27% (A05, 650+ HB) and vulcanized natural rubber from our Durango facility, Mexico."
  lang="en"
  canonicalPath="/en/pumping/impeller/"
  alternateEsPath="/bombeo/impulsor/"
  alternateEnPath="/en/pumping/impeller/"
>
  <Header slot="header" lang="en" currentPath="/en/pumping/impeller/" alternatePath="/bombeo/impulsor/" />

  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">OPEX • DURANGO FACILITY STOCK</span>
      <h1>Slurry Pump Impeller / Rodete</h1>
      <p class="subtitle">High Chrome 27% (A05) and vulcanized natural rubber for 4x3 to 10x8 standard frames.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <h2>Hydrodynamic Design and Shear Erosion Resistance</h2>
        <p>
          SMAT Minerals impellers feature heavy 4 and 5-vane closed profiles engineered for severe coarse slurry duties. Integrated pump-out back-vanes create a continuous centrifugal clearing vortex that prevents solids recirculation into the gland area and drastically reduces stuffing box pressure, doubling packing and seal life.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Material Property</th>
              <th>SMAT Verified Standard</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Primary Metallic Alloy</td>
              <td>High Chrome White Iron (27% Cr, A05 ASTM A532 Class III Type A)</td>
            </tr>
            <tr>
              <td>Surface Hardness</td>
              <td>Minimum 650 HB (Brinell) / 58-62 HRC heat-treated microstructure</td>
            </tr>
            <tr>
              <td>Elastomer Alternative</td>
              <td>Pressure-vulcanized natural rubber for fine particle duties &lt; 5 mm</td>
            </tr>
            <tr>
              <td>Dynamic Balancing</td>
              <td>Dynamic shop balancing verified on Durango test bench</td>
            </tr>
            <tr>
              <td>Shaft Threading</td>
              <td>CNC machined trapezoidal Acme threads with release collar for safe maintenance</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Slurry Pump Impeller High Chrome 27% (A05)"
          series="Standard dimensional fit for 4x3 C-AH, 6x4 D-AH, 8x6 E-AH, 10x8 F-AH"
          metallurgy="High Chrome 27% Cr (A05, 650+ HB) / Natural Rubber"
          specs="Closed 4-5 vane impeller with pump-out back vanes, dynamic balancing in client presence and emergency dispatch from Durango."
          lang="en"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">IMMEDIATE DISPATCH FROM DURANGO WAREHOUSE</span>
            <h3>Need replacement impellers for plant shutdown or safety stock?</h3>
            <p>Generate your official serialized requisition with part number and shop balance verification.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/en/?equipo=impulsor#rfq" class="btn btn-primary btn-lg">
              Quote A05 Impeller in Central Workbench →
            </a>
            <a href="https://wa.me/526188104408?text=Hello%20SMAT%20Minerals,%20I%20would%20like%20to%20quote%20Replacement%20A05%20Impeller" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Inquire Warehouse Stock via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton lang="en" />
  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
