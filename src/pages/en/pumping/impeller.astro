---
// src/pages/en/pumping/impeller.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
---

<BaseLayout 
  title="Slurry Pump Impeller | SMAT Minerals"
  description="5-vane closed and wide-passage slurry impellers in High Chrome, Rubber, and Polyurethane."
  lang="en"
>
  <section class="page-hero">
    <div class="container">
      <a href="/en/pumping/" class="back-link">← Back to Slurry Pumps</a>
      <div style="margin-top: 1rem;">
        <span class="badge badge-copper">WET-END WEAR PART</span>
      </div>
      <h1>Slurry Pump Impeller</h1>
      <p style="font-size: 1.08rem; max-width: 700px; color: var(--smat-text-secondary);">
        Heavy-duty closed slurry impeller with wide-passage main vanes and front/rear pump-out vanes for grinding, cyclone feed, and tailings pumps.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="impeller" lang="en" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Impeller Characteristics</h2>
          <p>
            The impeller transfers centrifugal energy to the mineral slurry and absorbs the highest kinetic impact from suspended solids. Its geometry features front and rear pump-out vanes that reduce internal recirculation against the throatbush and lower pressure at the stuffing box.
          </p>

          <h3 style="margin-top: 1.75rem;">Impeller Specifications</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Available Materials</th>
                  <td>High Chrome (ASTM A532 ≥ 650 HB), Rubber, and Polyurethane</td>
                </tr>
                <tr>
                  <th>Vane Geometry</th>
                  <td>5-vane closed (high efficiency) or 4-vane wide passage</td>
                </tr>
                <tr>
                  <th>Pump-Out Vanes</th>
                  <td>Auxiliary vanes on front and rear shrouds to control recirculation</td>
                </tr>
                <tr>
                  <th>Shaft Thread</th>
                  <td>Precision-machined thread for direct mounting on the Bearing Assembly shaft</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Wet-End Lot Supply</h3>
            <p>
              Because the impeller and throatbush wear faster than the volute, concentrator plants typically order impellers in matched wet-end lots (for example: <strong>5 impellers, 5 throatbushes, and 4 volute liners</strong>).
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light);">
              <a href="/en/#rfq?equipo=impulsor" class="btn btn-primary" style="width: 100%;">Quote Impellers →</a>
            </div>
          </div>
        </div>
      </div>

      <SharePurchasing
        roleTitle="Slurry Pump Impeller"
        series="1.5x1 to 14x12 Frames (4x3 C, 6x4 D, 8x6 E, 10x8 F)"
        metallurgy="High Chrome 27% (A05 ≥ 650 HB), Rubber, and Polyurethane"
        specs="5-vane closed or wide-passage slurry impeller with front/rear expeller vanes and shop dynamic balancing."
        roleId="solo_impulsor"
        circuit="bombeo"
        lang="en"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 2.75rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.5rem; }
  .back-link { color: var(--smat-copper-accent); font-size: 0.9rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
</style>
