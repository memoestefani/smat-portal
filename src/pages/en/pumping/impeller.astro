---
// src/pages/en/pumping/impeller.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../../scripts/workbenchBus.js';
import { WET_END_MATERIAL_MATRIX } from '../../../scripts/slurryEngine.js';
import rolesData from '../../../../data/roles.json';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const impulsorRole = allRoles.find((r) => r.role_id === 'impulsor');
const dc = impulsorRole?.decision_criteria;
const impellerParts = [getAtomicPartSpecs('D3147'), getAtomicPartSpecs('E4147'), getAtomicPartSpecs('F6147')].filter(Boolean);
const wetMaterials = [
  WET_END_MATERIAL_MATRIX.alto_cromo_cr27,
  WET_END_MATERIAL_MATRIX.hule_natural,
  WET_END_MATERIAL_MATRIX.poliuretano,
  WET_END_MATERIAL_MATRIX.ceramica_sic
];
---

<BaseLayout 
  title="Slurry Pump Impeller | SMAT Minerals"
  description="5-vane closed and wide-passage slurry impellers in High Chrome, Rubber, and Polyurethane."
  lang="en"
>
  <section class="page-hero">
    <div class="container">
      <a href="/en/pumping/" class="back-link">← Back to Slurry Pumps</a>
      <div style="margin-top: 1rem;">
        <span class="badge badge-copper">WET-END WEAR PART</span>
      </div>
      <h1>Slurry Pump Impeller</h1>
      <p style="font-size: 1.08rem; max-width: 700px; color: var(--smat-text-secondary);">
        Heavy-duty closed slurry impeller with wide-passage main vanes and front/rear pump-out vanes for grinding, cyclone feed, and tailings pumps.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="impeller" lang="en" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Impeller Characteristics</h2>
          <p>
            The impeller transfers centrifugal energy to the mineral slurry and absorbs the highest kinetic impact from suspended solids. Its geometry features front and rear pump-out vanes that reduce internal recirculation against the throatbush and lower pressure at the stuffing box.
          </p>

          <h3 style="margin-top: 1.75rem;">Impeller Specifications</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Available Materials</th>
                  <td>High Chrome (ASTM A532 ≥ 650 HB), Natural Rubber (R55), Polyurethane (U01), and Sintered Silicon Carbide (SiC ≥ 2200 HV)</td>
                </tr>
                <tr>
                  <th>Vane Geometry</th>
                  <td>5-vane closed (high efficiency) or 4-vane wide passage</td>
                </tr>
                <tr>
                  <th>Pump-Out Vanes</th>
                  <td>Auxiliary vanes on front and rear shrouds to control recirculation</td>
                </tr>
                <tr>
                  <th>Shaft Thread</th>
                  <td>Precision-machined thread for direct mounting on the Bearing Assembly shaft</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Wet-End Lot Supply</h3>
            <p>
              Because the impeller and throatbush wear faster than the volute, concentrator plants typically order impellers in matched wet-end lots (for example: <strong>5 impellers, 5 throatbushes, and 4 volute liners</strong>).
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/en/quote/?circuito=bombeo&equipo=solo_impulsor&pieza=impulsor_5_alabes&estacion=S3#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote Impellers →</a>
              <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="btn btn-outline" style="width: 100%; text-align: center;">View Impeller Mounting in Assembly Report →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[ENGINEERING DECISION CRITERIA — STATION 03]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Metallurgical Rule:</strong> {dc.metallurgy_rule_en}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Critical Variables:</strong> {dc.required_slurry_vars_en}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Avoided Risk:</strong> {dc.risk_avoided_en}</p>
            </div>
          )}
        </div>
      </div>

      <!-- Verified Atomic Impellers (D3147, E4147, F6147) with 6 Physical Parameters & NIOSH -->
      <div style="margin-top: 2rem;" data-testid="impeller-atomic-parts">
        <h2>Verified Standard Impellers at Durango Warehouse (D3147 / E4147 / F6147)</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:1rem; margin-top:1rem;">
          {impellerParts.map((ip) => (
            <div class="card" style="background:#ffffff; border:1px solid #cbd5e1;">
              <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                <span class="badge badge-copper">{ip.part_number} ({ip.smat_code})</span>
                <span class="font-mono-tech" style="font-size:0.74rem; font-weight:800; color:var(--smat-text-primary);">{ip.weight_kg} kg • LI={ip.niosh_lifting_index_shaft}</span>
              </div>
              <h3 style="margin-top:0.5rem;">{ip.name_en}</h3>
              <div class="font-mono-tech" style="font-size:0.76rem; color:#0c4a6e; font-weight:700; margin-bottom:0.4rem;">
                ∅D₂ = {ip.impeller_diameter_mm} mm • Max sphere = {ip.max_particle_mm} mm • Wall = {ip.wall_thickness_mm} mm
              </div>
              <p style="font-size:0.84rem; color:#334155; margin-bottom:0.5rem;">
                <strong>NIOSH Rigging:</strong> {ip.niosh_handling_mode} ({ip.niosh_ergonomic_tier}) • <strong>Station 0{ip.station_number}:</strong> {ip.assembly_order_note}
              </p>
              <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <a href={`/en/catalog/${ip.code}/`} class="btn btn-outline">View {ip.part_number} Sheet →</a>
                <a href={`/en/quote/?codigo=${ip.part_number}&circuito=bombeo&equipo=solo_impulsor&serie=${ip.pipe_size}&peso_kg=${ip.weight_kg}&estacion=S${ip.station_number}#rfq`} class="btn btn-primary">Quote {ip.part_number} →</a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 4 Wet-End Material Matrix (including SiC Ceramic & K_Ic / u2 Limits) -->
      <div style="margin-top: 2rem;" data-testid="impeller-material-matrix">
        <h2>Tribological Wet-End Material Selection (A05 / R55 / U01 / SiC)</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:0.85rem; margin-top:0.85rem;">
          {wetMaterials.map((mat) => (
            <div class="card" style="background:#f8fafc; border:1px solid #cbd5e1; padding:1rem;">
              <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#082f49;">[{mat.code}] {mat.hardness}</span>
              <h4 style="margin:0.35rem 0; font-size:0.95rem;">{mat.nameEn}</h4>
              <div class="font-mono-tech" style="font-size:0.74rem; color:#334155; margin-bottom:0.45rem;">
                u₂ ≤ {mat.maxTipSpeedMs} m/s • K_Ic = {mat.fractureToughnessMpaSqrtM} MPa·√m • d₈₀: {mat.d80RangeMicrons[0]}–{mat.d80RangeMicrons[1]} µm • pH {mat.phRange[0]}–{mat.phRange[1]}
              </div>
              <a href={`/en/quote/?circuito=bombeo&equipo=solo_impulsor&material=${mat.key}&estacion=S3#rfq`} class="btn btn-outline" style="width:100%; text-align:center; font-size:0.78rem;">Configure in {mat.code} →</a>
            </div>
          ))}
        </div>
      </div>

      <SharePurchasing
        roleTitle="Slurry Pump Impeller"
        series="1.5x1 to 14x12 Frames (4x3 C, 6x4 D, 8x6 E, 10x8 F)"
        metallurgy="High Chrome 27% (A05 ≥ 650 HB), Rubber, and Polyurethane"
        specs="5-vane closed or wide-passage slurry impeller with front/rear expeller vanes and shop dynamic balancing."
        roleId="solo_impulsor"
        circuit="bombeo"
        lang="en"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 2.75rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.5rem; }
  .back-link { color: var(--smat-copper-accent); font-size: 0.9rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .page-hero { padding: 0.75rem 0; }
    .page-hero h1 { font-size: 1.35rem; margin: 0.2rem 0; }
    .page-hero p { font-size: 0.82rem !important; line-height: 1.3; margin: 0.2rem 0; }
  }
</style>
