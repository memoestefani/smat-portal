---
// src/pages/en/pumping/impeller.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../../scripts/workbenchBus.js';
import { WET_END_MATERIAL_MATRIX } from '../../../scripts/slurryEngine.js';
import rolesData from '../../../../data/roles.json';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const impulsorRole = allRoles.find((r) => r.role_id === 'impulsor');
const dc = impulsorRole?.decision_criteria;
const impellerParts = [getAtomicPartSpecs('D3147'), getAtomicPartSpecs('E4147'), getAtomicPartSpecs('F6147')].filter(Boolean);
const wetMaterials = [
  WET_END_MATERIAL_MATRIX.alto_cromo_cr27,
  WET_END_MATERIAL_MATRIX.hule_natural,
  WET_END_MATERIAL_MATRIX.poliuretano,
  WET_END_MATERIAL_MATRIX.ceramica_sic,
  (WET_END_MATERIAL_MATRIX as any).hybrid_a05_r55
].filter(Boolean);
---

<BaseLayout 
  title="Slurry Pump Impeller | SMAT Minerals"
  description="5-vane closed and wide-passage slurry impellers in High Chrome, Rubber, and Polyurethane."
  lang="en"
>
  <section class="page-hero smat-compact-hero">
    <div class="container">
      <a href="/en/pumping/" class="back-link">← Back to Slurry Pumps</a>
      <div style="margin-top: 0.3rem;">
        <span class="badge badge-copper">STATION 03 · WET-END WEAR PART</span>
      </div>
      <h1>Slurry Pump Impeller</h1>
      <p class="smat-hero-sub">
        Live tribological calibration of impeller vane geometry, tip speed u₂, and selection across A05 / R55 / U01 / SiC / Hybrid Branch D.
      </p>
    </div>
  </section>

  <section class="section smat-stage-compact">
    <div class="container">
      <!-- STRATUM 1: Impeller Alloy Comparison Matrix -->
      <div id="stratum1-impeller-sim" data-testid="impeller-material-matrix" data-stratum-1-instrument>
        <div class="card" style="background: #f8fafc; border: 1.5px solid #cbd5e1; padding: clamp(0.7rem, 1.4vw, 1.1rem); margin-bottom: 1rem;">
          <span class="badge badge-copper">LIVE TRIBOLOGY SIMULATOR · FINNIE-HUTCHINGS &amp; K<sub>Ic</sub> TOUGHNESS</span>
          <h2 style="margin: 0.3rem 0 0.45rem; font-size: clamp(0.98rem, 1.4vw, 1.12rem);">Tip Speed u₂, Brittle Spalling (SiC) &amp; NIOSH Rigging Verifier</h2>
          <div class="smat-stratum1-display">
            <div id="trib-status-out" style="padding: 0.5rem 0.75rem; border-radius: 6px; background: #ecfdf5; border: 1px solid #059669; color: #064e3b; font-family: var(--smat-font-mono); font-size: 0.79rem; font-weight: 700;">
              Toughness OK · Series 6x4 · No brittle spalling risk under current kinematic regime.
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.45rem; font-family: var(--smat-font-mono); font-size: 0.78rem;">
              <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Recommended Material:</strong> <span id="trib-mat-out">27% High Chrome (A05)</span></div>
              <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Toughness K<sub>Ic</sub>:</strong> <span id="trib-kic-out">18.5 MPa·√m</span></div>
              <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>NIOSH Mass &amp; Rigging:</strong> <span id="trib-arch-out">492 kg · 6 NIOSH ≥ 23 kg</span></div>
            </div>
          </div>
          <div class="smat-inputs-2col" style="margin-bottom: 0.65rem; padding: 0.6rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.8rem;">
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Particle Size d<sub>80</sub> (µm):</span>
              <input type="number" id="trib-d80-um" min="20" max="6000" step="25" value="450" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Tip Speed u₂ (m/s):</span>
              <input type="number" id="trib-vtip-ms" min="10" max="36" step="0.5" value="22.5" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Slurry pH:</span>
              <input type="number" id="trib-ph" min="1.0" max="13.5" step="0.5" value="7.5" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Material Branch:</span>
              <select id="trib-branch" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                <option value="auto" selected>Auto (Finnie-Hutchings)</option>
                <option value="metal">27% High Chrome (A05)</option>
                <option value="rubber">Natural Rubber (R55)</option>
                <option value="polyurethane">Polyurethane (U01)</option>
                <option value="ceramica_sic">SiC Ceramic</option>
                <option value="hibrido_a05_r55">Hybrid Branch D (A05+R55)</option>
              </select>
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Pump Series:</span>
              <select id="trib-series" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                <option value="3x2">3x2 / 4x3</option>
                <option value="6x4" selected>6x4</option>
                <option value="8x6">8x6 / 10x8</option>
              </select>
            </label>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center;">
            <a href="/en/quote/?circuito=bombeo&equipo=solo_impulsor&pieza=impulsor_5_alabes&estacion=S3#rfq" class="btn btn-primary" style="min-height: 48px; display: inline-flex; align-items: center;">Quote Calibrated Impeller →</a>
            <button
              type="button"
              class="btn btn-outline btn-avenue-tray"
              data-vertical-tray-btn
              data-add-tray-sku="SMAT-PUMP-IMP-147"
              data-tray-part-code="147/083"
              data-tray-title="Calibrated 5-Vane Impeller"
              data-tray-series="6x4"
              data-tray-material="alto_cromo_cr27"
              data-tray-circuit="bombeo"
              data-tray-source="impeller_stratum1_calc"
              style="min-height: 48px;"
            >+ Add Calibrated SKU to Tray</button>
          </div>
        </div>

        <h3 style="margin-top: 1.25rem;">Tribological Wet-End Material Selection (5 Certified Branches)</h3>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:0.85rem; margin-top:0.65rem;">
          {wetMaterials.map((mat) => (
            <div class="card" style="background:#f8fafc; border:1px solid #cbd5e1; padding:1rem;">
              <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#082f49;">[{mat.code}] {mat.hardness}</span>
              <h4 style="margin:0.35rem 0; font-size:0.95rem;">{mat.nameEn}</h4>
              <div class="font-mono-tech" style="font-size:0.74rem; color:#334155; margin-bottom:0.45rem;">
                u₂ ≤ {mat.maxTipSpeedMs} m/s • K_Ic = {mat.fractureToughnessMpaSqrtM} MPa·√m • d₈₀: {mat.d80RangeMicrons[0]}–{mat.d80RangeMicrons[1]} µm • pH {mat.phRange[0]}–{mat.phRange[1]}
              </div>
              <a href={`/en/quote/?circuito=bombeo&equipo=solo_impulsor&material=${mat.key}&estacion=S3#rfq`} data-card-fixed-params="material" class="btn btn-outline" style="width:100%; text-align:center; font-size:0.78rem;">Configure in {mat.code} →</a>
            </div>
          ))}
        </div>
      </div>

      <!-- STRATUM 2: CAD Technical Diagram & Atomic Warehouse Sheets -->
      <div style="margin-top: 2rem;">
        <TechnicalDiagrams diagram="impeller" lang="en" />
      </div>

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Impeller Characteristics</h2>
          <p>
            The impeller transfers centrifugal energy to the mineral slurry and absorbs the highest kinetic impact from suspended solids. Its geometry features front and rear pump-out vanes that reduce internal recirculation against the throatbush and lower pressure at the stuffing box.
          </p>

          <h3 style="margin-top: 1.75rem;">Impeller Specifications</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Available Materials</th>
                  <td>High Chrome (ASTM A532 ≥ 650 HB), Natural Rubber (R55), Polyurethane (U01), and Sintered Silicon Carbide (SiC ≥ 2200 HV)</td>
                </tr>
                <tr>
                  <th>Vane Geometry</th>
                  <td>5-vane closed (high efficiency) or 4-vane wide passage</td>
                </tr>
                <tr>
                  <th>Pump-Out Vanes</th>
                  <td>Auxiliary vanes on front and rear shrouds to control recirculation</td>
                </tr>
                <tr>
                  <th>Shaft Thread</th>
                  <td>Precision-machined thread for direct mounting on the Bearing Assembly shaft</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Wet-End Lot Supply</h3>
            <p>
              Because the impeller and throatbush wear faster than the volute, concentrator plants typically order impellers in matched wet-end lots (for example: <strong>5 impellers, 5 throatbushes, and 4 volute liners</strong>).
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/en/quote/?circuito=bombeo&equipo=solo_impulsor&pieza=impulsor_5_alabes&estacion=S3#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote Impellers →</a>
              <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="btn btn-outline" style="width: 100%; text-align: center;">View Impeller Mounting in Assembly Report →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[ENGINEERING DECISION CRITERIA — STATION 03]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Metallurgical Rule:</strong> {dc.metallurgy_rule_en}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Critical Variables:</strong> {dc.required_slurry_vars_en}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Avoided Risk:</strong> {dc.risk_avoided_en}</p>
            </div>
          )}
        </div>
      </div>

      <!-- Verified Atomic Impellers (D3147, E4147, F6147) with 6 Physical Parameters & NIOSH -->
      <div style="margin-top: 2rem;" data-testid="impeller-atomic-parts">
        <h2>Verified Standard Impellers at Durango Warehouse (D3147 / E4147 / F6147)</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:1rem; margin-top:1rem;">
          {impellerParts.map((ip) => (
            <div class="card" style="background:#ffffff; border:1px solid #cbd5e1;">
              <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                <span class="badge badge-copper">{ip.part_number} ({ip.smat_code})</span>
                <span class="font-mono-tech" style="font-size:0.74rem; font-weight:800; color:var(--smat-text-primary);">{ip.weight_kg} kg • LI={ip.niosh_lifting_index_shaft}</span>
              </div>
              <h3 style="margin-top:0.5rem;">{ip.name_en}</h3>
              <div class="font-mono-tech" style="font-size:0.76rem; color:#0c4a6e; font-weight:700; margin-bottom:0.4rem;">
                ∅D₂ = {ip.impeller_diameter_mm} mm • Max sphere = {ip.max_particle_mm} mm • Wall = {ip.wall_thickness_mm} mm
              </div>
              <p style="font-size:0.84rem; color:#334155; margin-bottom:0.5rem;">
                <strong>NIOSH Rigging:</strong> {ip.niosh_handling_mode} ({ip.niosh_ergonomic_tier}) • <strong>Station 0{ip.station_number}:</strong> {ip.assembly_order_note}
              </p>
              <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <a href={`/en/catalog/${ip.code}/`} class="btn btn-outline">View {ip.part_number} Sheet →</a>
                <a href={`/en/quote/?codigo=${ip.part_number}&circuito=bombeo&equipo=solo_impulsor&serie=${ip.pipe_size}&peso_kg=${ip.weight_kg}&estacion=S${ip.station_number}#rfq`} class="btn btn-primary">Quote {ip.part_number} →</a>
                <button
                  type="button"
                  class="btn btn-outline btn-avenue-tray"
                  data-add-tray-sku="SMAT-PUMP-IMP-147"
                  data-tray-part-code={ip.part_number}
                  data-tray-title={ip.name_en}
                  data-tray-series={ip.pipe_size}
                  data-tray-material="A05"
                  data-tray-category="BOMBA_SLURRY"
                  data-tray-source="impeller_atomic_card"
                  style="min-height: 48px;"
                >+ Tray</button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <SharePurchasing
        roleTitle="Slurry Pump Impeller"
        series="1.5x1 to 14x12 Series (4x3, 6x4, 8x6, 10x8)"
        metallurgy="High Chrome 27% (A05 ≥ 650 HB), Rubber, and Polyurethane"
        specs="5-vane closed or wide-passage slurry impeller with front/rear expeller vanes and 1:1 dimensional verification."
        roleId="solo_impulsor"
        circuit="bombeo"
        lang="en"
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { bindCanonicalTribologySelector } from '../../../scripts/verticalCalculatorsAndLabelsBridge.js';
  import { bindAtomicPartTrayButtons } from '../../../scripts/verticalStateAndCtaSyncBridge.js';
  bindCanonicalTribologySelector(document, 'en');
  bindAtomicPartTrayButtons(document);
</script>

<style>
  .back-link { color: var(--smat-solar-accent); font-size: 0.88rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
</style>
