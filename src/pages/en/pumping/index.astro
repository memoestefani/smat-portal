---
// src/pages/en/pumping/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CircuitNavigator from '../../../components/CircuitNavigator.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import atomicParts from '../../../../data/atomic_parts.json';
---

<BaseLayout 
  title="Slurry Pumps & Spare Parts | SMAT Minerals"
  description="Replacement slurry pumps, wet-end Spare Parts in balanced 5-5-4 lots (impellers, volute liners, and throatbushes in High Chrome, Rubber, and Polyurethane), plus complete Bearing Assembly / Housing units."
  lang="en"
>
  <section class="page-hero">
    <div class="container">
      <span class="badge badge-copper">DOOR 2 • PLANT OPERATIONS, MAINTENANCE & SPARES</span>
      <h1>Slurry Pumps & Spare Parts</h1>
      <p style="font-size: 1.08rem; max-width: 760px; color: var(--smat-text-secondary);">
        Horizontal centrifugal replacement slurry pumps, complete assembled <strong>Bearing Assembly / Housing</strong> units, and wet-end <strong>Spare Parts</strong> supplied in balanced wear lots (<strong>5 impellers, 5 throatbushes, and 4 volute liners</strong>) in <strong>High Chrome (≥650 HB), Rubber, and Polyurethane</strong>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="pump" lang="en" />

      <div class="wet-lot-callout">
        <div>
          <strong>Wet-End Lot Ordering (5 – 5 – 4)</strong>
          <p>
            Plants order wet-end contact parts in balanced lots matched to component wear rates (for example: <strong>5 impellers, 5 throatbushes, and 4 volute liners</strong>) in High Chrome, Rubber, or Polyurethane. We do not sell mechanical seals due to the highly corrosive and abrasive nature of mineral slurries; we supply centrifugal expellers and stuffing boxes.
          </p>
        </div>
        <a href="/en/quote/?equipo=revestimientos#rfq" class="btn btn-primary">Quote Wet-End Lot →</a>
      </div>

      <h2 style="margin-top: 2rem;">Replacement Slurry Pumps & Critical Spare Parts</h2>
      <div class="grid-2" style="margin-top: 1.5rem;">
        <div class="card">
          <h3>Complete Slurry Pumps</h3>
          <p>Heavy-duty horizontal centrifugal slurry pumps from 1.5x1" to 14x12" for mill discharge, cyclone feed, flotation, and tailings transport.</p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Range:</strong> 1.5x1" to 14x12"</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/en/pumping/skid/" class="btn btn-outline">View Diagram & Specs</a>
            <a href="/en/quote/?equipo=skid_bomba#rfq" class="btn btn-primary">Quote →</a>
          </div>
        </div>

        <div class="card">
          <h3>Bearing Assembly / Housing</h3>
          <p>Complete assembled cartridge unit ready for installation: cylindrical housing, alloy shaft, heavy-duty tapered roller bearings, and labyrinth seals.</p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Supply:</strong> Complete Assembled Unit</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/en/pumping/bearing-assembly/" class="btn btn-outline">View Bearing Assembly</a>
            <a href="/en/quote/?equipo=soporte#rfq" class="btn btn-primary">Quote →</a>
          </div>
        </div>

        <div class="card">
          <h3>Impeller</h3>
          <p>5-vane closed and wide-passage slurry impellers with front and rear expeller vanes to reduce stuffing box pressure and recirculation.</p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Materials:</strong> High Chrome, Rubber & Polyurethane</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/en/pumping/impeller/" class="btn btn-outline">Impeller Characteristics</a>
            <a href="/en/quote/?equipo=impulsor#rfq" class="btn btn-primary">Quote →</a>
          </div>
        </div>

        <div class="card">
          <h3>Volute Liners & Throatbushes</h3>
          <p>Volutes, throatbushes, and frame plate liner inserts for wet-end contact zones, available in multi-unit wear lots.</p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Materials:</strong> High Chrome, Rubber & Polyurethane</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/en/pumping/liners/" class="btn btn-outline">View Parts & Lots</a>
            <a href="/en/quote/?equipo=revestimientos#rfq" class="btn btn-primary">Quote →</a>
          </div>
        </div>

        <div class="card">
          <h3>Centrifugal Expeller & Stuffing Box</h3>
          <p>Dry centrifugal expeller, expeller ring, shaft sleeve, and braided-packing stuffing box (no mechanical seals) for zero slurry dilution.</p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Sealing:</strong> Expeller & PTFE/Graphite Stuffing Box</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/en/pumping/seal/" class="btn btn-outline">View Sealing Assembly</a>
            <a href="/en/quote/?equipo=sello#rfq" class="btn btn-primary">Quote →</a>
          </div>
        </div>
      </div>

      <!-- Universal Part Number Technical Sheets (atomic_parts.json) -->
      <div class="atomic-silo-block" style="margin-top: 2.5rem;">
        <h2 style="margin-bottom: 0.4rem;">Universal Part Number Spare Parts Sheets (Wet-End & Sealing)</h2>
        <p style="color: var(--smat-text-secondary); margin-bottom: 1.25rem;">
          Review individual metallurgical specifications for closed impellers, suction throatbushes, and expeller rings verified 1:1 at our Durango Central Warehouse.
        </p>
        <div class="grid-3-atomic">
          {atomicParts.map((part) => (
            <div class="card atomic-silo-card">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span class="badge badge-copper">{part.part_number}</span>
                <span style="font-family: var(--smat-font-mono); font-size: 0.78rem; font-weight: 700; color: var(--smat-text-secondary);">Frame {part.frame}</span>
              </div>
              <h3 style="font-size: 1.02rem; margin-bottom: 0.35rem;">{part.name_en}</h3>
              <p style="font-size: 0.84rem; color: var(--smat-text-secondary); margin-bottom: 0.85rem;">{part.type_en} • {part.hardness}</p>
              <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: auto;">
                <a href={`/en/catalog/${part.code}/`} class="btn btn-outline" style="font-size: 0.8rem; padding: 0.4rem 0.75rem;">View Sheet {part.part_number}</a>
                <a href={`/en/quote/?codigo=${part.part_number}&circuito=bombeo#rfq`} class="btn btn-primary" style="font-size: 0.8rem; padding: 0.4rem 0.75rem;">Quote →</a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <SharePurchasing
        roleTitle="Slurry Pumps & Wet-End Spare Parts Lot (5-5-4)"
        specs="Balanced lot of 5 Impellers + 5 Throatbushes + 4 Volute Liners and Bearing Assembly / Housing"
        metallurgy="High Chrome 27% A05 (≥650 HB), Abrasion-Resistant Natural Rubber, and Polyurethane"
        series="1.5x1 to 14x12"
        roleId="kit_wet_end"
        circuit="bombeo"
        lang="en"
      />
    </div>
  </section>

  <!-- WET-END LOT PROCUREMENT MATRIX -->
  <section class="tco-matrix-section" aria-label="Wet-End Lot Procurement">
    <div class="container">
      <div class="tco-matrix-header">
        <span class="section-eyebrow">PLANT MAINTENANCE PLANNING</span>
        <h2>Wet-End Lot Procurement vs. Single-Piece Purchasing</h2>
        <p>For slurry pumps, concentrator plants order balanced wet-end lots matched to component wear rates (for example: <strong>5 impellers, 5 throatbushes, and 4 volute liners</strong>) alongside a complete spare <strong>Bearing Assembly / Housing</strong>.</p>
      </div>

      <div class="tco-table-wrapper">
        <table class="tco-comparison-matrix">
          <thead>
            <tr>
              <th>Operational Metric</th>
              <th>Overseas OEM Import</th>
              <th>Reactive Single-Part Buying</th>
              <th class="col-smat-highlight">SMAT Wet-End Lot Supply</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>International Lead Time</strong></td>
              <td>16 to 24 weeks (Ocean freight & customs)</td>
              <td>Fragmented emergency orders</td>
              <td class="col-smat-val">Scheduled lot supply (Domestic tax invoice)</td>
            </tr>
            <tr>
              <td><strong>Wet-End Lot Configuration</strong></td>
              <td>Rigid bundles with slow-moving items</td>
              <td>Single part (mismatched wear clearances)</td>
              <td class="col-smat-val">Custom lots (e.g. 5 Impellers + 5 Throatbushes + 4 Volutes)</td>
            </tr>
            <tr>
              <td><strong>Wear Materials</strong></td>
              <td>Single standard alloy</td>
              <td>Unverified casting (&lt;500 HB)</td>
              <td class="col-smat-val">High Chrome (≥650 HB), Rubber & Polyurethane</td>
            </tr>
            <tr>
              <td><strong>Mill Downtime Risk (20k–40,000 USD/hour)</strong></td>
              <td>High working capital tied up in transit</td>
              <td>Extended downtime waiting for throatbush or impeller</td>
              <td class="col-smat-val">Batch scheduling matched to actual wet-end wear (5-5-4)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" style="background-color: #ffffff; border-top: 1px solid var(--smat-border-light); border-bottom: 1px solid var(--smat-border-light);">
    <div class="container">
      <CircuitNavigator lang="en" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="background: #f8fafc; border: 1px solid var(--smat-border-strong); padding: 2.25rem; text-align: center;">
        <h2 style="margin-bottom: 0.6rem;">Request a Quotation for Slurry Pumps or Spare Parts Lots</h2>
        <p style="max-width: 620px; margin: 0 auto 1.25rem; color: var(--smat-text-secondary);">
          Specify your pump size or the quantities for your wet-end lot (impellers, throatbushes, volutes, or Bearing Assembly / Housing).
        </p>
        <a href="/en/quote/?equipo=skid_bomba#rfq" class="btn btn-primary">Request Quotation →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 3rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.65rem; }
  .wet-lot-callout {
    margin: 1.5rem 0;
    padding: 1.35rem 1.5rem;
    background: #fff7ed;
    border: 1px solid #fdba74;
    border-left: 4px solid var(--smat-copper-accent);
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .wet-lot-callout strong { display: block; font-size: 1rem; color: var(--smat-text-primary); margin-bottom: 0.3rem; }
  .wet-lot-callout p { margin: 0; font-size: 0.9rem; color: #334155; max-width: 720px; line-height: 1.5; }
  .grid-3-atomic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.15rem;
  }
  .atomic-silo-card {
    display: flex;
    flex-direction: column;
  }
  .section-eyebrow {
    display: inline-block;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }
  .tco-matrix-section {
    padding: var(--smat-space-2xl, 80px) 0;
    background-color: #ffffff;
    border-top: 1px solid var(--smat-border-light);
    border-bottom: 1px solid var(--smat-border-light);
  }
  .tco-matrix-header {
    margin-bottom: 1.75rem;
    max-width: 780px;
  }
  .tco-matrix-header h2 {
    font-size: clamp(1.4rem, 2.3vw, 1.85rem);
    color: var(--smat-text-primary);
    margin: 0 0 0.5rem 0;
  }
  .tco-matrix-header p {
    color: var(--smat-text-secondary);
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
  }
  .tco-table-wrapper {
    overflow-x: auto;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
  }
  .tco-comparison-matrix {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
    background: #ffffff;
  }
  .tco-comparison-matrix th,
  .tco-comparison-matrix td {
    padding: 0.95rem 1.15rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .tco-comparison-matrix thead th {
    background: #f8fafc;
    color: #334155;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
  .col-smat-highlight {
    background: #fff7ed !important;
    color: #9a3412 !important;
    border-left: 2px solid var(--smat-copper-accent);
  }
  .col-smat-val {
    background: #fffaf5;
    font-weight: 700;
    color: var(--smat-text-primary);
    border-left: 2px solid var(--smat-copper-accent);
  }
</style>
