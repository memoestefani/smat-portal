---
// src/pages/en/pumping/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CircuitNavigator from '../../../components/CircuitNavigator.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import PumpAssemblyReport from '../../../components/PumpAssemblyReport.astro';
import atomicParts from '../../../../data/atomic_parts.json';
import { getAtomicPartSpecs, formatNioshErgonomicStatus, buildWizardUrl } from '../../../scripts/workbenchBus.js';
---

<BaseLayout 
  title="Slurry Pumps & Spare Parts | SMAT Minerals"
  description="Replacement slurry pumps, wet-end Spare Parts in balanced 5-5-4 lots (impellers, volute liners, and throatbushes in High Chrome, Rubber, and Polyurethane), plus complete Bearing Assembly / Housing units."
  lang="en"
>
  <section class="page-hero">
    <div class="container">
      <span class="badge badge-copper">DOOR 2 • PLANT OPERATIONS, MAINTENANCE & SPARES</span>
      <h1>Slurry Pumps & Spare Parts</h1>
      <p style="font-size: 1.04rem; max-width: 760px; color: var(--smat-text-secondary);">
        Direct 1-click selection of wet-end wear parts in balanced <strong>5-5-4</strong> lots (<strong>High Chrome ≥650 HB, Natural Rubber, and Polyurethane</strong>), complete <strong>Bearing Assembly</strong> cartridges, and our 5-station pump assembly report.
      </p>
    </div>
  </section>

  <section class="section" id="bombeo-main-section">
    <div class="container">
      <TechnicalDiagrams diagram="pump" lang="en" />

      <!-- UNIFIED 3-TAB XOR CONSOLE: KITS BY MATERIAL, SUB-ASSEMBLIES & UNIVERSAL PART SHEETS (DECISION 6 / DEB-V42-06) -->
      <div class="bombeo-catalog-tabs" id="bombeo-catalog-tabs" style="margin-top: 2.25rem;">
        <div class="bombeo-tabs-header">
          <div>
            <span class="section-eyebrow">CONSOLIDATED PUMPING & WEAR SPARES CATALOG (3-TAB XOR CONSOLE)</span>
            <h2 style="margin: 0.2rem 0 0.35rem;">5-5-4 Wet-End Kits, Sub-Assemblies & Universal Part Number Sheets</h2>
          </div>
          <div class="bombeo-tab-switcher" role="tablist" aria-label="Material Kits, Sub-assemblies or Universal Part Sheets Selector">
            <button
              type="button"
              role="tab"
              aria-selected="true"
              class="bombeo-tab-btn is-active"
              data-bombeo-tab="kits"
            >
              1. Kits by Material (4)
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              class="bombeo-tab-btn"
              data-bombeo-tab="systems"
            >
              2. Sub-Assemblies & Pumps (5)
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              class="bombeo-tab-btn"
              data-bombeo-tab="atomic"
            >
              3. Universal Part Number Sheets (6)
            </button>
          </div>
        </div>

        <!-- TAB 1: SPARE PARTS BY MATERIAL SHOWCASE (4 SSOT ALLOYS) -->
        <div class="bombeo-tab-panel is-active material-kits-showcase" id="kits-by-material" data-bombeo-panel="kits" style="margin-top: 1.25rem;">
          <p style="color: var(--smat-text-secondary); margin-bottom: 1rem;">
            Compare the physical geometry of each wet-end kit: 1-piece monolithic High Chrome Cr27% or SiC Ceramic composite volute vs. split two-half liners (FPL + CPL) in vulcanized Natural Rubber or cast Polyurethane.
          </p>
          <TechnicalDiagrams diagram="material_kit_grid" lang="en" />

          <div class="grid-3-atomic" style="margin-top: 1rem;">
            <article class="card atomic-silo-card">
              <span class="badge badge-copper" style="align-self: flex-start; margin-bottom: 0.5rem;">HIGH CHROME Cr27% • ≥650 HB</span>
              <h3>Metallic Kit (Primary Mill & Cyclone Feed)</h3>
              <p style="font-size: 0.86rem; color: var(--smat-text-secondary);">
                <strong>Kit parts:</strong> Monolithic Volute + 5-Vane Impeller + Throatbush + FPL Insert.<br/>
                <strong>Operating envelope:</strong> Coarse impact d₅₀ &gt; 6 mm, v_tip ≤ 32 m/s, pH 4.0–12.0.
              </p>
              <div style="margin-top: auto; padding-top: 0.75rem;">
                <a href="/en/quote/?circuito=bombeo&equipo=bombeo_hule_cromo&pieza=lote_554&material=alto_cromo_cr27&estacion=S4#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote High Chrome Kit →</a>
              </div>
            </article>

            <article class="card atomic-silo-card">
              <span class="badge badge-copper" style="align-self: flex-start; margin-bottom: 0.5rem;">NATURAL RUBBER • 55–65 SHORE A</span>
              <h3>Elastomer Kit (Fine Tailings & Flotation)</h3>
              <p style="font-size: 0.86rem; color: var(--smat-text-secondary);">
                <strong>Kit parts:</strong> Cover Plate Liner (CPL) + Frame Plate Liner (FPL) with steel backing + Impeller + Throatbush.<br/>
                <strong>Operating envelope:</strong> Fine slurry d₅₀ ≤ 5 mm, v_tip ≤ 27.5 m/s, pH 1.5–11.0.
              </p>
              <div style="margin-top: auto; padding-top: 0.75rem;">
                <a href="/en/quote/?circuito=bombeo&equipo=bombeo_hule_cromo&pieza=lote_554&material=hule_natural&estacion=S4#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote Natural Rubber Kit →</a>
              </div>
            </article>

            <article class="card atomic-silo-card">
              <span class="badge badge-copper" style="align-self: flex-start; margin-bottom: 0.5rem;">POLYURETHANE • 85–95 SHORE A</span>
              <h3>Polyurethane Kit (Cyclones & Reagents)</h3>
              <p style="font-size: 0.86rem; color: var(--smat-text-secondary);">
                <strong>Kit parts:</strong> Yellow/Red Polyurethane CPL + FPL Liners + PU Impeller + PU Throatbush.<br/>
                <strong>Operating envelope:</strong> Sharp particles d₅₀ ≤ 8 mm, reagent, oil, and froth resistance.
              </p>
              <div style="margin-top: auto; padding-top: 0.75rem;">
                <a href="/en/quote/?circuito=bombeo&equipo=bombeo_hule_cromo&pieza=lote_554&material=poliuretano&estacion=S4#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote Polyurethane Kit →</a>
              </div>
            </article>

            <article class="card atomic-silo-card">
              <span class="badge badge-copper" style="align-self: flex-start; margin-bottom: 0.5rem;">SiC CERAMIC • ≥2200 HV (MOHS 9.2)</span>
              <h3>Silicon Carbide Composite Kit (Fine Silica & Extreme pH)</h3>
              <p style="font-size: 0.86rem; color: var(--smat-text-secondary);">
                <strong>Kit parts:</strong> SiC Composite Volute + SiC Throatbush + Cr27/SiC Impeller.<br/>
                <strong>Operating envelope:</strong> Severe silica d₈₀ ≤ 800 µm, u₂ ≤ 28.0 m/s, K_Ic = 4.1 MPa·√m, pH 1.0–13.5.
              </p>
              <div style="margin-top: auto; padding-top: 0.75rem;">
                <a href="/en/quote/?circuito=bombeo&equipo=bombeo_hule_cromo&pieza=lote_554&material=ceramica_sic&estacion=S4#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote SiC Ceramic Kit →</a>
              </div>
            </article>
          </div>
        </div>

        <div class="bombeo-tab-panel" data-bombeo-panel="systems" style="display: none;">
          <div class="grid-2" style="margin-top: 1.25rem;">
            <div class="card">
              <h3>Complete Slurry Pumps</h3>
              <p>Heavy-duty horizontal centrifugal slurry pumps from 1.5x1" to 14x12" for mill discharge, cyclone feed, flotation, and tailings transport.</p>
              <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Range:</strong> 1.5x1" to 14x12"</p>
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/en/pumping/skid/" class="btn btn-outline">View Diagram & Specs</a>
                <a href="/en/quote/?circuito=bombeo&equipo=skid_bomba#rfq" class="btn btn-primary">Quote →</a>
              </div>
            </div>

            <div class="card">
              <h3>Bearing Assembly / Housing</h3>
              <p>Complete assembled cartridge unit ready for installation: cylindrical housing, alloy shaft, heavy-duty tapered roller bearings, and labyrinth seals.</p>
              <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Supply:</strong> Complete Assembled Unit</p>
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/en/pumping/bearing-assembly/" class="btn btn-outline">View Bearing Assembly</a>
                <a href="/en/quote/?circuito=bombeo&equipo=soporte&estacion=S1#rfq" class="btn btn-primary">Quote →</a>
              </div>
            </div>

            <div class="card">
              <h3>Impeller</h3>
              <p>5-vane closed and wide-passage slurry impellers with front and rear expeller vanes to reduce stuffing box pressure and recirculation.</p>
              <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Materials:</strong> High Chrome, Rubber, Polyurethane & SiC</p>
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/en/pumping/impeller/" class="btn btn-outline">Impeller Characteristics</a>
                <a href="/en/quote/?circuito=bombeo&equipo=impulsor&estacion=S3#rfq" class="btn btn-primary">Quote →</a>
              </div>
            </div>

            <div class="card">
              <h3>Volute Liners & Throatbushes</h3>
              <p>Volutes, throatbushes, and frame plate liner inserts for wet-end contact zones, available in multi-unit wear lots.</p>
              <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Materials:</strong> High Chrome, Rubber, Polyurethane & SiC</p>
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/en/pumping/liners/" class="btn btn-outline">View Parts & Lots</a>
                <a href="/en/quote/?circuito=bombeo&equipo=revestimientos&estacion=S4#rfq" class="btn btn-primary">Quote →</a>
              </div>
            </div>

            <div class="card">
              <h3>Centrifugal Expeller & Stuffing Box</h3>
              <p>Dry centrifugal expeller, expeller ring, shaft sleeve, and braided-packing stuffing box (no mechanical seals) for zero slurry dilution.</p>
              <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Sealing:</strong> Expeller & PTFE/Graphite Stuffing Box</p>
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/en/pumping/seal/" class="btn btn-outline">View Sealing Assembly</a>
                <a href="/en/quote/?circuito=bombeo&equipo=sello&estacion=S2#rfq" class="btn btn-primary">Quote →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Universal Part Number Technical Sheets (atomic_parts.json) enriched with Waters-NIOSH 1993 mass -->
        <div class="bombeo-tab-panel atomic-silo-block" data-bombeo-panel="atomic" style="margin-top: 1.25rem; display: none;">
          <h3 style="margin-bottom: 0.35rem;">Universal Part Number Spare Parts Sheets (Wet-End & Sealing)</h3>
          <p style="color: var(--smat-text-secondary); margin-bottom: 1.15rem;">
            Review individual metallurgical specifications for closed impellers, suction throatbushes, and expeller rings with verified mass (Waters-NIOSH 1993 RWL_shaft = 11.1 kg and Hoist ≥23 kg threshold) at our Durango Central Warehouse.
          </p>
          <div class="grid-3-atomic">
            {atomicParts.map((part) => {
              const specs = getAtomicPartSpecs(part.part_number);
              const niosh = formatNioshErgonomicStatus(specs, 'en');
              const quoteHref = buildWizardUrl({
                lang: 'en',
                circuit: 'bombeo',
                role: specs.role,
                code: part.part_number,
                series: specs.series || '6x4',
                station: specs.station_code,
                material: part.part_number === 'DAM005' ? undefined : 'alto_cromo_cr27',
                weightKg: specs.weight_kg,
                arrangement: 'CV'
              });
              return (
                <div class="card atomic-silo-card" data-atomic-code={part.part_number} data-niosh-tier={niosh.tier}>
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <span class="badge badge-copper">{part.part_number}</span>
                    <span style="font-family: var(--smat-font-mono); font-size: 0.78rem; font-weight: 700; color: var(--smat-text-secondary);">Frame {part.frame} • {specs.station_number}</span>
                  </div>
                  <h3 style="font-size: 1.02rem; margin-bottom: 0.35rem;">{part.name_en}</h3>
                  <p style="font-size: 0.84rem; color: var(--smat-text-secondary); margin-bottom: 0.5rem;">{part.type_en} • {part.hardness}</p>
                  <div class="atomic-niosh-meta" style="font-family: var(--smat-font-mono); font-size: 0.76rem; color: #334155; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.4rem 0.6rem; margin-bottom: 0.85rem;">
                    <strong>Mass: {specs.weight_kg} kg</strong> • {niosh.badgeEn}
                  </div>
                  <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: auto;">
                    <a href={`/en/catalog/${part.code}/`} class="btn btn-outline" style="font-size: 0.8rem; padding: 0.4rem 0.75rem;">View Sheet {part.part_number}</a>
                    <a href={quoteHref} class="btn btn-primary" style="font-size: 0.8rem; padding: 0.4rem 0.75rem;">Quote →</a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <!-- HOW A SLURRY PUMP IS ASSEMBLED REPORT (DECISION 3-C+ & DECISION 5) -->
      <PumpAssemblyReport lang="en" />

      <SharePurchasing
        roleTitle="Slurry Pumps & Wet-End Spare Parts Lot (5-5-4)"
        specs="Balanced lot of 5 Impellers + 5 Throatbushes + 4 Volute Liners and Bearing Assembly / Housing"
        metallurgy="High Chrome 27% A05 (≥650 HB), Abrasion-Resistant Natural Rubber, and Polyurethane"
        series="1.5x1 to 14x12"
        roleId="kit_wet_end"
        circuit="bombeo"
        lang="en"
      />
    </div>
  </section>

  <!-- WET-END LOT PROCUREMENT MATRIX -->
  <section class="tco-matrix-section" aria-label="Wet-End Lot Procurement">
    <div class="container">
      <div class="tco-matrix-header">
        <span class="section-eyebrow">PLANT MAINTENANCE PLANNING</span>
        <h2>Wet-End Lot Procurement vs. Single-Piece Purchasing</h2>
        <p>For slurry pumps, concentrator plants order balanced wet-end lots matched to component wear rates (for example: <strong>5 impellers, 5 throatbushes, and 4 volute liners</strong>) alongside a complete spare <strong>Bearing Assembly / Housing</strong>.</p>
      </div>

      <div class="tco-table-wrapper">
        <table class="tco-comparison-matrix">
          <thead>
            <tr>
              <th>Operational Metric</th>
              <th>Overseas OEM Import</th>
              <th>Reactive Single-Part Buying</th>
              <th class="col-smat-highlight">SMAT Wet-End Lot Supply</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>International Lead Time</strong></td>
              <td>16 to 24 weeks (Ocean freight & customs)</td>
              <td>Fragmented emergency orders</td>
              <td class="col-smat-val">Scheduled lot supply (Domestic tax invoice)</td>
            </tr>
            <tr>
              <td><strong>Wet-End Lot Configuration</strong></td>
              <td>Rigid bundles with slow-moving items</td>
              <td>Single part (mismatched wear clearances)</td>
              <td class="col-smat-val">Custom lots (e.g. 5 Impellers + 5 Throatbushes + 4 Volutes)</td>
            </tr>
            <tr>
              <td><strong>Wear Materials</strong></td>
              <td>Single standard alloy</td>
              <td>Unverified casting (&lt;500 HB)</td>
              <td class="col-smat-val">High Chrome (≥650 HB), Rubber & Polyurethane</td>
            </tr>
            <tr>
              <td><strong>Mill Downtime Risk (20k–40,000 USD/hour)</strong></td>
              <td>High working capital tied up in transit</td>
              <td>Extended downtime waiting for throatbush or impeller</td>
              <td class="col-smat-val">Batch scheduling matched to actual wet-end wear (5-5-4)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <details class="bombeo-circuit-drawer" id="bombeo-circuit-drawer">
    <summary class="bombeo-circuit-drawer__summary container">
      <span>View Grinding Circuit P&ID Map & Metallurgical Rules by Role</span>
      <span class="bombeo-circuit-drawer__badge">P&ID APPENDIX ▾</span>
    </summary>
    <div class="bombeo-circuit-drawer__body">
      <CircuitNavigator currentCircuit="molienda" lang="en" />
    </div>
  </details>

  <script>
    function initBombeoCatalogTabs() {
      const tabBtns = document.querySelectorAll('[data-bombeo-tab]');
      const tabPanels = document.querySelectorAll('[data-bombeo-panel]');
      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-bombeo-tab') || 'systems';
          tabBtns.forEach((b) => {
            const active = b.getAttribute('data-bombeo-tab') === target;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          tabPanels.forEach((p) => {
            const active = p.getAttribute('data-bombeo-panel') === target;
            p.classList.toggle('is-active', active);
            (p as HTMLElement).style.display = active ? 'block' : 'none';
          });
        });
      });
    }
    initBombeoCatalogTabs();
    document.addEventListener('astro:page-load', initBombeoCatalogTabs);
  </script>
</BaseLayout>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 3rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.65rem; }
  .bombeo-tabs-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--smat-border-light);
  }
  .bombeo-tab-switcher {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    background: #e2e8f0;
    padding: 0.3rem;
    border-radius: 10px;
    border: 1px solid var(--smat-border-light);
  }
  .bombeo-tab-btn {
    border: none;
    background: transparent;
    color: #1e293b;
    font-weight: 700;
    font-size: 0.84rem;
    padding: 0.5rem 0.95rem;
    border-radius: 7px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .bombeo-tab-btn.is-active {
    background: var(--smat-navy-950);
    color: #ffffff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.25);
  }
  .bombeo-circuit-drawer {
    border-top: 1px solid var(--smat-border-strong);
    border-bottom: 1px solid var(--smat-border-strong);
    background-color: #f8fafc;
  }
  .bombeo-circuit-drawer__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.15rem 1rem;
    cursor: pointer;
    font-weight: 800;
    color: var(--smat-text-primary);
    list-style: none;
  }
  .bombeo-circuit-drawer__summary::-webkit-details-marker {
    display: none;
  }
  .bombeo-circuit-drawer__badge {
    background-color: #fff7ed;
    color: #9a3412;
    border: 1px solid #fed7aa;
    font-family: var(--smat-font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
  }
  .grid-3-atomic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.15rem;
  }
  .atomic-silo-card {
    display: flex;
    flex-direction: column;
  }
  .section-eyebrow {
    display: inline-block;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }
  .tco-matrix-section {
    padding: var(--smat-space-2xl, 80px) 0;
    background-color: #ffffff;
    border-top: 1px solid var(--smat-border-light);
    border-bottom: 1px solid var(--smat-border-light);
  }
  .tco-matrix-header {
    margin-bottom: 1.75rem;
    max-width: 780px;
  }
  .tco-matrix-header h2 {
    font-size: clamp(1.4rem, 2.3vw, 1.85rem);
    color: var(--smat-text-primary);
    margin: 0 0 0.5rem 0;
  }
  .tco-matrix-header p {
    color: var(--smat-text-secondary);
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
  }
  .tco-table-wrapper {
    overflow-x: auto;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
  }
  .tco-comparison-matrix {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
    background: #ffffff;
  }
  .tco-comparison-matrix th,
  .tco-comparison-matrix td {
    padding: 0.95rem 1.15rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .tco-comparison-matrix thead th {
    background: #f8fafc;
    color: #334155;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
  .col-smat-highlight {
    background: #fff7ed !important;
    color: #9a3412 !important;
    border-left: 2px solid var(--smat-copper-accent);
  }
  .col-smat-val {
    background: #fffaf5;
    font-weight: 700;
    color: var(--smat-text-primary);
    border-left: 2px solid var(--smat-copper-accent);
  }
  @media (max-width: 768px) {
    .page-hero {
      padding: 0.65rem 0;
    }
    .page-hero h1 {
      font-size: 1.3rem;
      margin: 0.2rem 0;
    }
    .page-hero p {
      font-size: 0.8rem !important;
      line-height: 1.25;
      margin: 0.2rem 0;
    }
    #bombeo-main-section {
      padding-top: 0.55rem;
    }
  }
</style>
