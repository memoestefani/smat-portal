---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PumpingHubIsland from '../../../components/islands/PumpingHubIsland.astro';

const title = 'Slurry Pumps & Spare Parts | SMAT Minerals';
const description = 'Replacement slurry pumps, wet-end Spare Parts in balanced 5-5-4 lots (impellers, volute liners, and throatbushes in High Chrome, Rubber, and Polyurethane), plus complete Bearing Assembly / Housing units.';
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath="/en/pumping/"
  alternateEsPath="/bombeo/"
  alternateEnPath="/en/pumping/"
>
  <PumpingHubIsland locale="en" mode="standalone" />
</BaseLayout>
