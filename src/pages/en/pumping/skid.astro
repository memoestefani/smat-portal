---
// src/pages/en/pumping/skid.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../../components/SharePurchasing.astro';
import { DRIVE_ARRANGEMENT_CATALOG } from '../../../scripts/slurryEngine.js';
import rolesData from '../../../../data/roles.json';

const driveArrangements = Object.values(DRIVE_ARRANGEMENT_CATALOG);
const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const skidRole = allRoles.find((r) => r.role_id === 'skid_bomba');
const dc = skidRole?.decision_criteria;
---

<BaseLayout 
  title="Slurry Pumps | SMAT Minerals"
  description="Horizontal centrifugal slurry pumps for abrasive and corrosive slurries in grinding, classification, flotation, and tailings."
  lang="en"
>
  <section class="page-hero">
    <div class="container">
      <a href="/en/pumping/" class="back-link">← Back to Slurry Pumps</a>
      <div style="margin-top: 1rem;">
        <span class="badge badge-copper">COMPLETE PUMP</span>
      </div>
      <h1>Slurry Pumps</h1>
      <p style="font-size: 1.08rem; max-width: 700px; color: var(--smat-text-secondary);">
        Heavy-duty horizontal centrifugal slurry pumps for mill discharge, hydrocyclone feed, flotation circuits, and tailings disposal.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="pump" lang="en" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Slurry Pump Configuration</h2>
          <p>
            Engineered for high-density slurries with abrasive or corrosive solids. Each pump integrates a split outer casing, interchangeable wet-end wear parts (impeller, throatbush, volute liner, and frame plate liner insert), centrifugal expeller and stuffing box sealing (no mechanical seal), and a complete <strong>Bearing Assembly / Housing</strong> unit.
          </p>
          
          <h3 style="margin-top: 1.75rem;">Technical Specifications</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Available Sizes</th>
                  <td>1.5x1", 2x1.5", 3x2", 4x3", 6x4", 8x6", 10x8", 12x10", 14x12"</td>
                </tr>
                <tr>
                  <th>Wet-End Materials</th>
                  <td>27% High Chrome (A05 ≥650 HB), Natural Rubber (R55), Polyurethane (U01), and Sintered Silicon Carbide (SiC ≥2200 HV)</td>
                </tr>
                <tr>
                  <th>Bearing Unit</th>
                  <td>Complete Bearing Assembly / Housing with external axial adjustment (L₁₀ₘₕ = 1.25× L₁₀h with labyrinth seal vs 0.22× contaminated)</td>
                </tr>
                <tr>
                  <th>Shaft Sealing</th>
                  <td>Dry centrifugal expeller and stuffing box (no mechanical seals)</td>
                </tr>
                <tr>
                  <th>Drive Arrangement</th>
                  <td>V-belt and pulley drive or direct coupling</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Plant Applications</h3>
            <ul>
              <li><strong>Mill Discharge & Cyclone Feed:</strong> High Chrome impeller and liners for coarse rock impact.</li>
              <li><strong>Flotation & Regrind:</strong> Rubber or Polyurethane liners for fine particles and corrosive reagents.</li>
              <li><strong>Tailings & Thickener Underflow:</strong> Continuous single-stage or series pumping.</li>
            </ul>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/en/quote/?equipo=skid_bomba#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Quote Slurry Pump →</a>
              <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="btn btn-outline" style="width: 100%; text-align: center;">View Pump Assembly Report (14 Parts) →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[ENGINEERING DECISION CRITERIA]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Metallurgical Rule:</strong> {dc.metallurgy_rule_en}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Critical Variables:</strong> {dc.required_slurry_vars_en}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Avoided Risk:</strong> {dc.risk_avoided_en}</p>
            </div>
          )}
        </div>
      </div>

      <!-- SKID DRIVE ARRANGEMENTS (DECISION 5-C+ • DON MANUEL REF 3 & 5) -->
      <div id="drive-arrangements" style="margin-top: 2.5rem;">
        <h2>Base Frame Drive & Mounting Arrangements (CV / ZVZ / CRZ / DC)</h2>
        <p style="color: var(--smat-text-secondary); max-width: 760px;">
          Select the drive arrangement matched to your plant floor footprint and target ISO 281 L₁₀h <strong>Bearing Assembly</strong> life:
        </p>
        <TechnicalDiagrams diagram="drive_arrangements" lang="en" />

        <div class="grid-2" style="margin-top: 1rem;" data-drive-links="transmision=CV transmision=ZVZ transmision=CRZ transmision=DC">
          {driveArrangements.map((arr) => (
            <div class="card">
              <h3>{arr.nameEn}</h3>
              <p>{arr.descriptionEn}</p>
              <small style="display:block; margin-bottom:0.65rem; font-family:var(--smat-font-mono); font-size:0.74rem; color:#082f49; font-weight:700;" data-kin-flood>
                Footprint: {arr.footprintFactor.toFixed(2)}× • Sump Flood: {Boolean(arr.sumpFloodImmunity) ? 'Elevated Motor (Splash Immune)' : 'Baseplate level / Sump drainage'}
              </small>
              <a href={`/en/quote/?equipo=skid_bomba&transmision=${arr.code}#rfq`} class="btn btn-primary">Quote {arr.code} Arrangement Pump →</a>
            </div>
          ))}
        </div>

        <!-- V-Belt Kinematics, Tip Speed u2 <= 24.5 m/s & ISO 281 L10h Calibrator (Decision 2-C+, Arbitrage #8) -->
        <details class="skid-kinematics-calibrator" id="skid-kinematics-panel" data-skid-kinematics>
          <summary class="skid-kinematics-calibrator__summary">
            <span class="skid-kinematics-calibrator__badge">ISO 281 KINEMATICS SIMULATOR</span>
            <span class="skid-kinematics-calibrator__title">
              Calculate V-Belt Sheave Ratio, Impeller Tip Speed (u₂ ≤ 24.5 m/s) & Bearing Life (L₁₀h)
            </span>
            <span class="skid-kinematics-calibrator__hint">Open kinematics calculator ▾</span>
          </summary>

          <div class="skid-kinematics-calibrator__body">
            <div class="skid-kinematics-calibrator__controls">
              <label class="kin-field">
                <span>Drive Arrangement:</span>
                <select data-kin-arrangement>
                  <option value="CV" selected>CV — Overhead Piggyback Motor</option>
                  <option value="ZVZ">ZVZ — Elevated Rear Motor</option>
                  <option value="CRZ">CRZ — Side-by-Side Base Motor</option>
                  <option value="DC">DC — Direct Inline Coupling (Fr = 0 kN)</option>
                </select>
              </label>
              <label class="kin-field">
                <span>Electric Motor Speed (RPM):</span>
                <select data-kin-motor-rpm>
                  <option value="1780" selected>1780 RPM (4-Pole • 60 Hz)</option>
                  <option value="1480">1480 RPM (4-Pole • 50 Hz / VFD)</option>
                  <option value="1180">1180 RPM (6-Pole • 60 Hz)</option>
                </select>
              </label>
              <label class="kin-field">
                <span>Driver Motor Sheave (mm): <strong data-kin-driver-val>180 mm</strong></span>
                <input type="range" min="120" max="380" step="10" value="180" data-kin-driver />
              </label>
              <label class="kin-field">
                <span>Driven Pump Sheave (mm): <strong data-kin-driven-val>320 mm</strong></span>
                <input type="range" min="160" max="560" step="10" value="320" data-kin-driven />
              </label>
              <label class="kin-field">
                <span>Shaft Power (kW): <strong data-kin-power-val>45 kW (60 HP)</strong></span>
                <input type="range" min="15" max="315" step="5" value="45" data-kin-power />
              </label>
              <label class="kin-field">
                <span>Impeller Diameter ØD₂ (atomic_parts):</span>
                <select data-kin-impeller>
                  <option value="270">270 mm — 3x2 / 4x3 Series (D3147)</option>
                  <option value="380" selected>380 mm — 6x4 Series (E4147)</option>
                  <option value="510">510 mm — 8x6 Series (F6147)</option>
                  <option value="640">640 mm — 10x8 Series (G8147)</option>
                </select>
              </label>
              <label class="kin-field">
                <span>Wet-End Material:</span>
                <select data-kin-material>
                  <option value="alto_cromo_cr27" selected>27% High Chrome A05 (u₂ max 32.0 m/s • K_Ic=20 MPa·√m)</option>
                  <option value="hule_natural">Natural Rubber R55 (u₂ max 24.5 m/s • K_Ic=12 MPa·√m)</option>
                  <option value="poliuretano">Polyurethane U01 (u₂ max 26.0 m/s • K_Ic=14 MPa·√m)</option>
                  <option value="ceramica_sic">Sintered Silicon Carbide SiC (u₂ max 28.0 m/s • ≥2200 HV)</option>
                </select>
              </label>
              <label class="kin-field">
                <span>Dynamic Bearing Capacity C (kN — ISO 281):</span>
                <input type="number" min="60" max="450" step="5" value="145" data-kin-capacity-c />
              </label>
            </div>

            <div class="skid-kinematics-calibrator__metrics">
              <div class="kin-metric-card">
                <span class="kin-metric-card__kicker">PUMP SHAFT SPEED</span>
                <strong class="kin-metric-card__val" data-kin-rpm>1001 RPM</strong>
                <span class="kin-metric-card__sub" data-kin-ratio>Motor 1780 RPM • Ratio 0.56×</span>
              </div>
              <div class="kin-metric-card">
                <span class="kin-metric-card__kicker">IMPELLER TIP SPEED (u₂)</span>
                <strong class="kin-metric-card__val" data-kin-u2>19.92 m/s</strong>
                <span class="kin-metric-card__sub" data-kin-u2-status>Safe for Rubber R55, PU & High Chrome A05</span>
              </div>
              <div class="kin-metric-card">
                <span class="kin-metric-card__kicker">RADIAL BELT LOAD (Fᵣ)</span>
                <strong class="kin-metric-card__val" data-kin-fr>6.71 kN</strong>
                <span class="kin-metric-card__sub" data-kin-fr-sub data-kin-load-p>Eq. load P = 14.37 kN • Footprint 1.00×</span>
              </div>
              <div class="kin-metric-card">
                <span class="kin-metric-card__kicker">ISO 281 BEARING LIFE (L₁₀h / L₁₀ₘₕ LABYRINTH)</span>
                <strong class="kin-metric-card__val" data-kin-l10h>42,800 h</strong>
                <span class="kin-metric-card__sub" data-kin-l10mh>L₁₀ₘₕ Labyrinth: 53,500 h vs Contam. Felt: 9,416 h</span>
                <a
                  href="/en/quote/?equipo=skid_bomba&transmision=CV&material=alto_cromo_cr27&u2_ms=19.92&l10h=42800#rfq"
                  class="kin-metric-card__cta"
                  data-kin-cta
                  data-quote-base="/en/quote/"
                >
                  Quote Pump with this Kinematics →
                </a>
              </div>
            </div>

            <div class="skid-kinematics-calibrator__alert" data-kin-rubber-alert style="display:none">
              <div>
                <strong>TRIBOLOGICAL LOCK (INV-SMAT-SCI-13):</strong> Peripheral tip speed exceeds <strong>24.5 m/s</strong> in Natural Rubber (R55), causing viscoelastic hysteresis blistering.
              </div>
              <button type="button" class="btn btn-primary" data-kin-switch-a05>
                Switch to High Chrome A05 (≥650 HB)
              </button>
            </div>
          </div>
        </details>
      </div>

      <!-- SUCTION THROATBUSH & AXIAL CLEARANCE CALIBRATION (DON MANUEL REF 4) -->
      <div style="margin-top: 2.5rem;">
        <h2>Suction Geometry, Throatbush & Front Axial Clearance Calibration (δ = 0.5–1.0 mm)</h2>
        <TechnicalDiagrams diagram="suction_throatbush" lang="en" />
      </div>

      <SharePurchasing
        roleTitle="Horizontal Centrifugal Slurry Pump"
        series="1.5x1 to 14x12 (4x3, 6x4, 8x6, 10x8)"
        metallurgy="Wet-End Parts in High Chrome 27% (A05), Rubber & Polyurethane"
        specs="Heavy-duty horizontal slurry pump with complete Bearing Assembly / Housing and dry centrifugal expeller sealing."
        roleId="skid_bomba"
        circuit="bombeo"
        lang="en"
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { calculateDriveAndBearingKinematics } from '../../../scripts/slurryEngine.js';
  import { saveWorkbenchState, loadWorkbenchState } from '../../../scripts/workbenchBus.js';

  function initSkidKinematicsEn() {
    const panel = document.querySelector('[data-skid-kinematics]');
    if (!panel) return;

    const arrSel = panel.querySelector('[data-kin-arrangement]') as HTMLSelectElement | null;
    const motorRpmSel = panel.querySelector('[data-kin-motor-rpm]') as HTMLSelectElement | null;
    const driverInput = panel.querySelector('[data-kin-driver]') as HTMLInputElement | null;
    const drivenInput = panel.querySelector('[data-kin-driven]') as HTMLInputElement | null;
    const powerInput = panel.querySelector('[data-kin-power]') as HTMLInputElement | null;
    const impSel = panel.querySelector('[data-kin-impeller]') as HTMLSelectElement | null;
    const matSel = panel.querySelector('[data-kin-material]') as HTMLSelectElement | null;
    const capCInput = panel.querySelector('[data-kin-capacity-c]') as HTMLInputElement | null;

    const driverVal = panel.querySelector('[data-kin-driver-val]');
    const drivenVal = panel.querySelector('[data-kin-driven-val]');
    const powerVal = panel.querySelector('[data-kin-power-val]');
    const rpmEl = panel.querySelector('[data-kin-rpm]');
    const ratioEl = panel.querySelector('[data-kin-ratio]');
    const u2El = panel.querySelector('[data-kin-u2]');
    const u2StatusEl = panel.querySelector('[data-kin-u2-status]');
    const frEl = panel.querySelector('[data-kin-fr]');
    const frSubEl = panel.querySelector('[data-kin-fr-sub]');
    const l10hEl = panel.querySelector('[data-kin-l10h]');
    const alertBox = panel.querySelector('[data-kin-rubber-alert]') as HTMLElement | null;
    const switchBtn = panel.querySelector('[data-kin-switch-a05]');
    const ctaEl = panel.querySelector('[data-kin-cta]') as HTMLAnchorElement | null;

    const updateKinematics = () => {
      const arrangement = (arrSel?.value || 'CV') as 'CV' | 'ZVZ' | 'CRZ' | 'DC';
      const motorRpm = Number(motorRpmSel?.value) || 1780;
      const driverPulleyMm = Number(driverInput?.value) || 180;
      const drivenPulleyMm = Number(drivenInput?.value) || 320;
      const shaftPowerKw = Number(powerInput?.value) || 45;
      const impellerDiameterMm = Number(impSel?.value) || 380;
      const wetEndMaterial = matSel?.value || 'alto_cromo_cr27';
      const dynamicCapacityCkN = Number(capCInput?.value) || 145;

      if (driverInput) driverInput.disabled = arrangement === 'DC';
      if (drivenInput) drivenInput.disabled = arrangement === 'DC';

      if (driverVal) driverVal.textContent = arrangement === 'DC' ? 'Direct 1:1' : `${driverPulleyMm} mm`;
      if (drivenVal) drivenVal.textContent = arrangement === 'DC' ? 'Direct 1:1' : `${drivenPulleyMm} mm`;
      if (powerVal) powerVal.textContent = `${shaftPowerKw} kW (${Math.round(shaftPowerKw * 1.341)} HP)`;

      const res = calculateDriveAndBearingKinematics({
        arrangement,
        motorRpm,
        driverPulleyMm,
        drivenPulleyMm,
        impellerDiameterMm,
        shaftPowerKw,
        dynamicCapacityCkN,
        wetEndMaterial
      });

      if (rpmEl) rpmEl.textContent = `${res.pumpRpm} RPM`;
      if (ratioEl) ratioEl.textContent = `Motor ${res.motorRpm} RPM • i=${res.reductionRatio.toFixed(2)}:1 (${res.speedMultiplier.toFixed(2)}×)`;
      if (u2El) u2El.textContent = `${res.tipSpeedMs.toFixed(2)} m/s`;
      if (u2StatusEl) {
        u2StatusEl.textContent = res.rubberSafeTipSpeed
          ? `Safe for Rubber/PU/A05 (Suggested: ${res.recommendedWetMaterialByTipSpeed})`
          : `Exceeds 24.5 m/s: Exclusive ${res.recommendedWetMaterialByTipSpeed} (≥650 HB)`;
      }
      if (frEl) frEl.textContent = `${res.beltRadialLoadKn.toFixed(2)} kN`;
      if (frSubEl) frSubEl.textContent = `P=${res.equivalentLoadPkN.toFixed(2)} kN (C=${res.dynamicCapacityCkN} kN) • Footprint ${res.footprintFactor.toFixed(2)}×`;
      const l10mhEl = panel.querySelector('[data-kin-l10mh]');
      if (l10hEl) l10hEl.textContent = `${res.bearingL10Hours.toLocaleString('en-US')} h`;
      if (l10mhEl) l10mhEl.textContent = `L₁₀ₘₕ Labyrinth: ${res.l10mhLabyrinthHours.toLocaleString('en-US')} h (1.25×) vs Contaminated: ${res.l10mhContaminatedHours.toLocaleString('en-US')} h (0.22×)`;
      if (alertBox) {
        alertBox.style.display = (res.rubberThermalLimitExceeded || res.ceramicSpallingSpeedExceeded) ? 'flex' : 'none';
      }
      if (ctaEl) {
        const base = ctaEl.getAttribute('data-quote-base') || '/en/quote/';
        ctaEl.href = `${base}?equipo=skid_bomba&transmision=${res.arrangement}&material=${wetEndMaterial}&driver_mm=${res.driverPulleyMm}&driven_mm=${res.drivenPulleyMm}&motor_rpm=${res.motorRpm}&power_kw=${res.shaftPowerKw}&n2_rpm=${res.pumpRpm}&fr_kn=${res.beltRadialLoadKn.toFixed(2)}&u2_ms=${res.tipSpeedMs.toFixed(2)}&l10h=${res.bearingL10Hours}&cap_c_kn=${res.dynamicCapacityCkN}#rfq`;
      }

      const prev = loadWorkbenchState() || {};
      saveWorkbenchState({
        ...prev,
        cap_c_kn: res.dynamicCapacityCkN,
        kinematics: {
          arrangement: res.arrangement,
          motorRpm: res.motorRpm,
          driverPulleyMm: res.driverPulleyMm,
          drivenPulleyMm: res.drivenPulleyMm,
          impellerDiameterMm: res.impellerDiameterMm,
          shaftPowerKw: res.shaftPowerKw,
          dynamicCapacityCkN: res.dynamicCapacityCkN,
          reductionRatio: res.reductionRatio,
          sumpFloodImmunity: res.sumpFloodImmunity,
          recommendedWetMaterialByTipSpeed: res.recommendedWetMaterialByTipSpeed,
          wetEndMaterial: res.wetEndMaterial,
          pumpRpm: res.pumpRpm,
          tipSpeedMs: res.tipSpeedMs,
          beltRadialLoadKn: res.beltRadialLoadKn,
          equivalentLoadPkN: res.equivalentLoadPkN,
          bearingL10Hours: res.bearingL10Hours,
          rubberThermalLimitExceeded: res.rubberThermalLimitExceeded
        }
      });
    };

    [arrSel, motorRpmSel, driverInput, drivenInput, powerInput, impSel, matSel, capCInput].forEach((el) => {
      if (el) {
        el.addEventListener('input', updateKinematics);
        el.addEventListener('change', updateKinematics);
      }
    });

    if (switchBtn && matSel) {
      switchBtn.addEventListener('click', () => {
        matSel.value = 'alto_cromo_cr27';
        updateKinematics();
      });
    }

    updateKinematics();
  }

  initSkidKinematicsEn();
  document.addEventListener('astro:page-load', initSkidKinematicsEn);
</script>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 2.75rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.5rem; }
  .back-link { color: var(--smat-copper-accent); font-size: 0.9rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  .skid-kinematics-calibrator { margin-top: 1.5rem; border: 1.5px solid #cbd5e1; border-radius: 10px; background: #f8fafc; overflow: hidden; }
  .skid-kinematics-calibrator__summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.65rem; padding: 0.85rem 1.1rem; cursor: pointer; list-style: none; }
  .skid-kinematics-calibrator__badge { background: #0d78c6; color: #ffffff; font-family: var(--smat-font-mono, monospace); font-size: 0.68rem; font-weight: 800; padding: 0.18rem 0.5rem; border-radius: 4px; }
  .skid-kinematics-calibrator__title { font-size: 0.92rem; font-weight: 800; color: #1c1917; flex: 1; }
  .skid-kinematics-calibrator__hint { font-family: var(--smat-font-mono, monospace); font-size: 0.72rem; font-weight: 800; color: #082f49; }
  .skid-kinematics-calibrator__body { padding: 1.1rem; background: #ffffff; border-top: 1px solid #e2e8f0; }
  .skid-kinematics-calibrator__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.85rem; margin-bottom: 1rem; }
  .kin-field { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.8rem; font-weight: 700; color: #1c1917; }
  .skid-kinematics-calibrator__metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; }
  .kin-metric-card { background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .kin-metric-card__kicker { font-family: var(--smat-font-mono, monospace); font-size: 0.66rem; font-weight: 800; color: #475569; }
  .kin-metric-card__val { font-size: 1rem; font-weight: 800; color: #1c1917; }
  .kin-metric-card__sub { font-size: 0.74rem; color: #334155; }
  .kin-metric-card__cta { margin-top: 0.25rem; font-family: var(--smat-font-mono, monospace); font-size: 0.72rem; font-weight: 800; color: #082f49; text-decoration: underline; }
  .skid-kinematics-calibrator__alert { margin-top: 0.9rem; padding: 0.85rem 1rem; border-radius: 8px; background: #fef2f2; border: 1.5px solid #dc2626; color: #7f1d1d; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; font-size: 0.82rem; }
  @media (max-width: 640px) {
    .page-hero { padding: 0.75rem 0; }
    .page-hero h1 { font-size: 1.35rem; margin: 0.2rem 0; }
    .page-hero p { font-size: 0.82rem !important; line-height: 1.3; margin: 0.2rem 0; }
  }
</style>
