---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SealDriveBearingIsland from '../../../components/islands/SealDriveBearingIsland.astro';

const title = 'Slurry Pumps | SMAT Minerals';
const description = 'Horizontal centrifugal slurry pumps for abrasive and corrosive slurries in grinding, classification, flotation, and tailings.';
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath="/en/pumping/skid/"
  alternateEsPath="/bombeo/skid/"
  alternateEnPath="/en/pumping/skid/"
>
  <SealDriveBearingIsland locale="en" variant="skid" mode="standalone" />
</BaseLayout>
