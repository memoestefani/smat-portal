---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProcessControlIsland from '../../../components/islands/ProcessControlIsland.astro';

const title = 'Process Control & Metallurgical Instrumentation | SMAT Minerals';
const description = 'Plant and metallurgical laboratory instrumentation: Pulp Density & % Solids Scales (Marcy style, 1000 cm³ cup, 12 dial rings SG 2.2–4.4), Laboratory Batch Pressure Filters (60–100 psi), and Certified ASTM E11 / ISO 3310 Test Sieves.';
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  canonicalPath="/en/process-control/"
  alternateEsPath="/control-de-procesos/"
  alternateEnPath="/en/process-control/"
>
  <ProcessControlIsland locale="en" mode="standalone" />
</BaseLayout>
