---
// src/pages/en/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustMatrix from '../../components/TrustMatrix.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
---

<BaseLayout 
  title="SMAT Minerals | Process Equipment, Slurry Pumps & Spare Parts, Process Control"
  description="Supply for mineral processing plants from our Durango Central Warehouse: Process Equipment (Flotation & Filter Presses), Slurry Pumps & Spare Parts (5-5-4 Wet-End Lots & Bearing Assemblies), and Process Control (Marcy Scales, Batch Pressure Filters & ASTM E11 Sieves)."
  lang="en"
>
  <section class="hero-home">
    <div class="container">
      <div class="hero-badge-pill">
        <span class="live-dot" aria-hidden="true"></span>
        <span>SMAT MINERALS • DURANGO CENTRAL WAREHOUSE • MINERAL PROCESSING SUPPLY</span>
      </div>
      
      <h1>
        Slurry Pumps & Wear Spares<br/>
        <span class="hero-sub-accent">Flotation Mechanisms, Filter Presses & Pulp Density Scales.</span>
      </h1>
      
      <p class="hero-lead">
        Select your plant supply area: <strong>Process Equipment</strong>, <strong>Slurry Pumps & Spare Parts</strong> in balanced wet-end lots (5-5-4), or <strong>Process Control</strong> for metallurgical laboratories.
      </p>

      <div class="hero-actions">
        <a href="/en/quote/#rfq" class="btn btn-primary btn-lg">Request Quotation</a>
        <a href="/en/catalog/" class="btn btn-outline btn-lg">View Catalog & Diagrams</a>
      </div>
    </div>
  </section>

  <!-- THREE-DOOR ARCHITECTURE (DON MANUEL) -->
  <section class="equipment-showcase-section" aria-label="The Three SMAT Supply Doors">
    <div class="container">
      <div class="showcase-header">
        <span class="section-eyebrow">SELECT YOUR PLANT SUPPLY AREA</span>
        <h2>Process Equipment, Spare Parts & Metallurgical Control</h2>
        <p>Direct department routing for capital projects, slurry pumping maintenance, and metallurgical process control.</p>
      </div>

      <div class="showcase-grid">
        <!-- DOOR 1: PROCESS EQUIPMENT -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Door 1 • Projects & Circuits</span>
            <span class="showcase-series">50–300 ft³ • 16 bar</span>
          </div>
          <h3>Process Equipment</h3>
          <TechnicalDiagrams diagram="flotation" lang="en" compact={true} />
          <p>
            <strong>Flotation Cell Mechanisms & Conditioners</strong> (Rougher, Cleaner, and Scavenger stages), <strong>Recessed-Chamber Filter Presses</strong> (800 to 1500 mm, up to 16 bar), and complete project slurry pump packages.
          </p>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Flotation:</span>
              <span class="ks-val">Mechanisms & Cells 50 to 300 ft³</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Filtration:</span>
              <span class="ks-val">Filter Presses 800 to 1500 mm (16 bar)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Direct Quote:</span>
              <span class="ks-val">
                <a href="/en/quote/?equipo=celda_flotacion#rfq" class="inline-spec-link">Flotation</a> • <a href="/en/quote/?equipo=filtro_prensa#rfq" class="inline-spec-link">Filter Press</a>
              </span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/en/process-equipment/" class="showcase-cta-primary">Enter Process Equipment →</a>
            <a href="/en/quote/?equipo=celda_flotacion#rfq" class="showcase-cta-secondary">Quote Project</a>
          </div>
        </article>

        <!-- DOOR 2: SLURRY PUMPS & SPARE PARTS -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Door 2 • Operations & Maintenance</span>
            <span class="showcase-series">1.5x1" to 14x12"</span>
          </div>
          <h3>Slurry Pumps & Spare Parts</h3>
          <TechnicalDiagrams diagram="pump" lang="en" compact={true} />
          <p>
            Replacement horizontal slurry pumps, complete assembled <strong>Bearing Assembly / Housing</strong> units, and balanced wet-end wear lots (<strong>5 impellers, 5 throatbushes, and 4 volute liners</strong>) with centrifugal expeller and stuffing box sealing.
          </p>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Wear Materials:</span>
              <span class="ks-val">High Chrome (≥650 HB), Rubber & Polyurethane</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Wet-End Lot:</span>
              <span class="ks-val">5 Impellers + 5 Throatbushes + 4 Volutes</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Drive Cartridge:</span>
              <span class="ks-val">Complete Bearing Assembly / Housing</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/en/pumping/" class="showcase-cta-primary">Enter Slurry Pumps & Spare Parts →</a>
            <a href="/en/quote/?equipo=skid_bomba#rfq" class="showcase-cta-secondary">Quote Wet-End Lot</a>
          </div>
        </article>

        <!-- DOOR 3: PROCESS CONTROL -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Door 3 • Laboratory & Control</span>
            <span class="showcase-series">SG 2.2–4.4 • ASTM E11</span>
          </div>
          <h3>Process Control</h3>
          <TechnicalDiagrams diagram="marcy" lang="en" compact={true} />
          <p>
            <strong>Pulp Density & % Solids Scales (Marcy Style)</strong> with 1000 cm³ calibrated cup, <strong>SMAT Laboratory Batch Pressure Filter</strong> (60 to 100 psi), and <strong>Certified ASTM E11 / ISO 3310 Test Sieves</strong> in Brass and Stainless Steel.
          </p>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Pulp Density:</span>
              <span class="ks-val">Marcy Scale (1000 cm³, 12 dial rings)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Lab Dewatering:</span>
              <span class="ks-val">Batch Pressure Filter (60–100 psi)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Particle Size:</span>
              <span class="ks-val">ASTM E11 Sieves (5" to #635 Mesh)</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/en/process-control/" class="showcase-cta-primary">Enter Process Control →</a>
            <a href="/en/quote/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="showcase-cta-secondary">Quote Instrument</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <TrustMatrix lang="en" hideBoundaries={true} />
</BaseLayout>

<style>
  .hero-home {
    background-color: var(--smat-bg-canvas);
    color: var(--smat-text-primary);
    padding: 3rem 0 2.25rem;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid var(--smat-border-strong);
    color: var(--smat-text-secondary);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-family: var(--smat-font-mono);
    margin-bottom: 1.15rem;
    box-shadow: var(--smat-shadow-xs);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background-color: var(--smat-emerald-stock);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
  }

  .hero-home h1 {
    color: var(--smat-text-primary);
    font-size: clamp(2rem, 3.5vw, 2.9rem);
    max-width: 880px;
    margin-bottom: 0.85rem;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .hero-sub-accent {
    color: var(--smat-copper-accent);
    display: inline-block;
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    margin-top: 0.2rem;
  }

  .hero-lead {
    color: var(--smat-text-secondary);
    font-size: 1.04rem;
    max-width: 760px;
    margin-bottom: 1.5rem;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn-lg {
    padding: 0.85rem 1.75rem;
    font-size: 0.95rem;
  }

  .equipment-showcase-section {
    padding: var(--smat-space-2xl, 80px) 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .showcase-header {
    margin-bottom: var(--smat-space-lg, 32px);
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .showcase-header h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--smat-text-primary);
    margin: 0 0 0.4rem 0;
    letter-spacing: -0.02em;
  }

  .showcase-header p {
    color: var(--smat-text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--smat-space-md, 24px);
  }

  @media (max-width: 960px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }

  .showcase-card {
    background: var(--smat-bg-canvas, #fafaf9);
    border: 1px solid var(--smat-border-strong, #cbd5e1);
    border-radius: 10px;
    padding: var(--smat-space-md, 24px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .showcase-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .showcase-tag {
    font-family: var(--smat-font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--smat-text-primary);
    background: #e2e8f0;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .showcase-series {
    font-family: var(--smat-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
  }

  .showcase-card h3 {
    font-size: 1.2rem;
    color: var(--smat-text-primary);
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
  }

  .showcase-card p {
    font-size: 0.88rem;
    color: var(--smat-text-secondary);
    line-height: 1.55;
    margin: 0 0 1rem 0;
    flex-grow: 1;
  }

  .pro-keyspecs-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    margin-bottom: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .keyspec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.76rem;
    gap: 0.5rem;
  }

  .ks-label {
    color: #64748b;
    font-weight: 600;
  }

  .ks-val {
    font-family: var(--smat-font-mono);
    font-weight: 700;
    color: var(--smat-text-primary);
    text-align: right;
  }

  .inline-spec-link {
    color: var(--smat-copper-accent);
    text-decoration: underline;
    min-height: auto !important;
    min-width: auto !important;
    display: inline !important;
  }

  .showcase-links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid #e2e8f0;
  }

  .showcase-cta-primary {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    text-decoration: none;
  }

  .showcase-cta-secondary {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--smat-text-secondary);
    text-decoration: underline;
  }
</style>
