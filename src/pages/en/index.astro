---
// src/pages/en/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustMatrix from '../../components/TrustMatrix.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
---

<BaseLayout 
  title="SMAT Minerals | Process Equipment, Slurry Pumps & Spare Parts, Process Control"
  description="Supply for mineral processing plants from our Durango Central Warehouse: Process Equipment (Flotation & Filter Presses), Slurry Pumps & Spare Parts (5-5-4 Wet-End Lots & Bearing Assemblies), and Process Control (Marcy Scales, Batch Pressure Filters & ASTM E11 Sieves)."
  lang="en"
>
  <section class="hero-home">
    <div class="container">
      <div class="hero-badge-pill">
        <span class="live-dot" aria-hidden="true"></span>
        <span>SMAT MINERALS • DURANGO CENTRAL WAREHOUSE • MINERAL PROCESSING SUPPLY</span>
      </div>
      
      <h1>
        Slurry Pumps & Wear Spares<br/>
        <span class="hero-sub-accent">Flotation Mechanisms, Filter Presses & Pulp Density Scales.</span>
      </h1>

      <div class="hero-actions">
        <a href="/en/quote/#rfq" class="btn btn-primary btn-lg">Request Quotation</a>
        <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="btn btn-outline btn-lg">View Exploded BOM & Pump Assembly</a>
        <a href="/en/catalog/" class="btn btn-outline btn-lg">Master Catalog</a>
      </div>
    </div>
  </section>

  <!-- THREE-DOOR ARCHITECTURE (DON MANUEL - PART FIRST, ZERO FLUFF) -->
  <section class="equipment-showcase-section" aria-label="The Three SMAT Supply Doors">
    <div class="container">
      <div class="showcase-header">
        <span class="section-eyebrow">DIRECT PART & EQUIPMENT SELECTION</span>
        <h2>Select Your Spare Part or Plant Supply Area</h2>
      </div>

      <div class="showcase-grid">
        <!-- DOOR 1: PROCESS EQUIPMENT -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Door 1 • Projects & Circuits</span>
            <span class="showcase-series">50–300 ft³ • 16 bar</span>
          </div>
          <h3>Process Equipment</h3>
          <TechnicalDiagrams diagram="flotation" lang="en" compact={true} />
          <p class="door-concise-summary">
            Flotation Mechanisms, Filter Presses (800–1500 mm) & Pump Skids (CV / ZVZ / CRZ / DC).
          </p>
          <div class="part-chip-strip" aria-label="Quick selection of Process Equipment">
            <a href="/en/quote/?equipo=celda_flotacion#rfq" class="part-chip">Flotation Mechanism</a>
            <a href="/en/quote/?equipo=filtro_prensa#rfq" class="part-chip">16-bar Filter Press</a>
            <a href="/en/quote/?equipo=placas_filtrantes#rfq" class="part-chip">PP Plates & Cloths</a>
            <a href="/en/quote/?equipo=skid_bomba&transmision=CV#rfq" class="part-chip">Pump Skid (CV/ZVZ/CRZ/DC)</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Flotation:</span>
              <span class="ks-val">50 to 300 ft³ (Rougher, Cleaner, and Scavenger)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Filtration:</span>
              <span class="ks-val">Filter Presses 800 to 1500 mm (16 bar)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Skid Drives:</span>
              <span class="ks-val">
                <a href="/en/pumping/skid/#drive-arrangements" class="inline-spec-link">CV • ZVZ • CRZ • DC Arrangements</a>
              </span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/en/process-equipment/" class="showcase-cta-primary">View Equipment & Diagrams →</a>
            <a href="/en/quote/?equipo=celda_flotacion#rfq" class="showcase-cta-secondary">Quote Equipment</a>
          </div>
        </article>

        <!-- DOOR 2: SLURRY PUMPS & SPARE PARTS -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Door 2 • Operations & Maintenance</span>
            <span class="showcase-series">1.5x1" to 14x12"</span>
          </div>
          <h3>Slurry Pumps & Spare Parts</h3>
          <TechnicalDiagrams diagram="pump" lang="en" compact={true} />
          <p class="door-concise-summary">
            5-5-4 Wet-End Lots in High Chrome (≥650 HB), Rubber & PU + Bearing Assembly.
          </p>
          <div class="part-chip-strip" aria-label="Direct slurry pump spare part selection">
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=lote_554&material=alto_cromo_cr27#rfq" class="part-chip part-chip--highlight">5-5-4 Kit</a>
            <a href="/en/quote/?equipo=impulsor_bomba&pieza=impulsor_5_alabes&material=alto_cromo_cr27#rfq" class="part-chip">5-Vane Impeller</a>
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=voluta_liners&material=alto_cromo_cr27#rfq" class="part-chip">Cr27% Volute</a>
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=voluta_liners&material=hule_natural#rfq" class="part-chip">Rubber / PU Liners</a>
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=throatbush&material=alto_cromo_cr27#rfq" class="part-chip">Throatbush</a>
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=fpl_insert&material=alto_cromo_cr27#rfq" class="part-chip">FPL Insert</a>
            <a href="/en/quote/?equipo=sello_expulsor&pieza=expeller_sello#rfq" class="part-chip">Dry Expeller</a>
            <a href="/en/quote/?equipo=soporte_rodamiento&pieza=bearing_assembly#rfq" class="part-chip">Bearing Assembly</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Materials:</span>
              <span class="ks-val">High Chrome (≥650 HB), Rubber & Polyurethane</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Wet-End Lot:</span>
              <span class="ks-val">5 Impellers + 5 Throatbushes + 4 Volutes</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Assembly Report:</span>
              <span class="ks-val">
                <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="inline-spec-link">How a pump is assembled (14 parts) →</a>
              </span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/en/pumping/" class="showcase-cta-primary">View Parts & Exploded BOM →</a>
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=lote_554#rfq" class="showcase-cta-secondary">Quote 5-5-4 Lot</a>
          </div>
        </article>

        <!-- DOOR 3: PROCESS CONTROL -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Door 3 • Laboratory & Control</span>
            <span class="showcase-series">SG 2.2–4.4 • ASTM E11</span>
          </div>
          <h3>Process Control</h3>
          <TechnicalDiagrams diagram="marcy" lang="en" compact={true} />
          <p class="door-concise-summary">
            Marcy Scale (1000 cm³), Lab Batch Filter (60–100 psi) & ASTM E11 Sieves.
          </p>
          <div class="part-chip-strip" aria-label="Quick selection of metallurgical control instruments">
            <a href="/en/quote/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="part-chip">Marcy Scale + 1000 cm³ Cup</a>
            <a href="/en/quote/?circuito=control_procesos&equipo=filtro_batch_lab#rfq" class="part-chip">Batch Pressure Filter</a>
            <a href="/en/quote/?circuito=control_procesos&equipo=tamices_astm_e11#rfq" class="part-chip">ASTM E11 Sieves (#200 / 75 µm)</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Pulp Density:</span>
              <span class="ks-val">Marcy Scale (1000 cm³, 12 dial rings)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Lab Dewatering:</span>
              <span class="ks-val">Batch Pressure Filter (60–100 psi)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Particle Size:</span>
              <span class="ks-val">ASTM E11 Sieves (5" to #635 Mesh)</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/en/process-control/" class="showcase-cta-primary">View Instruments & Diagrams →</a>
            <a href="/en/quote/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="showcase-cta-secondary">Quote Instrument</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <TrustMatrix lang="en" hideBoundaries={true} />
</BaseLayout>

<style>
  .hero-home {
    background-color: var(--smat-bg-canvas);
    color: var(--smat-text-primary);
    padding: 3rem 0 2.25rem;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid var(--smat-border-strong);
    color: var(--smat-text-secondary);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-family: var(--smat-font-mono);
    margin-bottom: 1.15rem;
    box-shadow: var(--smat-shadow-xs);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background-color: var(--smat-emerald-stock);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
  }

  .hero-home h1 {
    color: var(--smat-text-primary);
    font-size: clamp(2rem, 3.5vw, 2.9rem);
    max-width: 880px;
    margin-bottom: 0.85rem;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .hero-sub-accent {
    color: var(--smat-copper-accent);
    display: inline-block;
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    margin-top: 0.2rem;
  }

  .door-concise-summary {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--smat-text-primary);
    margin: 0.4rem 0 0.65rem 0;
    line-height: 1.35;
  }

  .part-chip-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    margin-bottom: 0.85rem;
  }

  .part-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.26rem 0.58rem;
    border-radius: 5px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.12s ease, background 0.12s ease;
  }

  .part-chip:hover {
    border-color: #0c4a6e;
    background: #f0f9ff;
    color: #0c4a6e;
  }

  .part-chip--highlight {
    background: #eff6ff;
    border-color: #0284c7;
    color: #0c4a6e;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn-lg {
    padding: 0.85rem 1.75rem;
    font-size: 0.95rem;
  }

  .equipment-showcase-section {
    padding: var(--smat-space-2xl, 80px) 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .showcase-header {
    margin-bottom: var(--smat-space-lg, 32px);
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .showcase-header h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--smat-text-primary);
    margin: 0 0 0.4rem 0;
    letter-spacing: -0.02em;
  }

  .showcase-header p {
    color: var(--smat-text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--smat-space-md, 24px);
  }

  @media (max-width: 960px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }

  .showcase-card {
    background: var(--smat-bg-canvas, #fafaf9);
    border: 1px solid var(--smat-border-strong, #cbd5e1);
    border-radius: 10px;
    padding: var(--smat-space-md, 24px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .showcase-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .showcase-tag {
    font-family: var(--smat-font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--smat-text-primary);
    background: #e2e8f0;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .showcase-series {
    font-family: var(--smat-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
  }

  .showcase-card h3 {
    font-size: 1.2rem;
    color: var(--smat-text-primary);
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
  }

  .showcase-card p {
    font-size: 0.88rem;
    color: var(--smat-text-secondary);
    line-height: 1.55;
    margin: 0 0 1rem 0;
    flex-grow: 1;
  }

  .pro-keyspecs-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    margin-bottom: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .keyspec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.76rem;
    gap: 0.5rem;
  }

  .ks-label {
    color: #64748b;
    font-weight: 600;
  }

  .ks-val {
    font-family: var(--smat-font-mono);
    font-weight: 700;
    color: var(--smat-text-primary);
    text-align: right;
  }

  .inline-spec-link {
    color: var(--smat-copper-accent);
    text-decoration: underline;
    min-height: 48px;
    min-width: 48px;
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    font-weight: 700;
  }

  .showcase-links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid #e2e8f0;
  }

  .showcase-cta-primary {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    text-decoration: none;
  }

  .showcase-cta-secondary {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--smat-text-secondary);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .hero-home {
      padding: 1.15rem 0 0.85rem;
    }
    .hero-badge-pill {
      margin-bottom: 0.55rem;
      padding: 0.22rem 0.6rem;
      font-size: 0.65rem;
    }
    .hero-home h1 {
      font-size: 1.48rem;
      margin-bottom: 0.5rem;
      line-height: 1.14;
    }
    .hero-sub-accent {
      font-size: 1.12rem;
    }
    .hero-actions {
      gap: 0.5rem;
    }
    .btn-lg {
      padding: 0.55rem 1rem;
      font-size: 0.84rem;
    }
    .equipment-showcase-section {
      padding: 1.15rem 0 1.5rem;
    }
    .showcase-header {
      margin-bottom: 0.85rem;
    }
    .showcase-header h2 {
      font-size: 1.25rem;
    }
    .showcase-card {
      padding: 1rem;
    }
  }
</style>
