---
// src/pages/en/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustMatrix from '../../components/TrustMatrix.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import ProductQuickCard from '../../components/ProductQuickCard.astro';
import { getQuickProductsCatalog } from '../../scripts/quickProductsCatalog.js';

const quickCatalog = getQuickProductsCatalog();
const familyFilterChipsEn = [
  { id: 'all', label: 'All Families (19)' },
  { id: 'control', label: '⚖️ Marcy Scale & Lab (6)' },
  { id: 'tamices', label: '📐 ASTM E11 Sieves & Ro-Tap' },
  { id: 'bombeo', label: '⚙️ Slurry Pumps & 5:5:4 Lot' },
  { id: 'sello_potencia', label: '💧 Dry Expeller Seal & 005M Cartridge' },
  { id: 'clasificacion', label: '🌪️ D6-D20 Hydrocyclones & TH48 Screens' },
  { id: 'filtracion', label: '🧱 Filter Presses, Cloths & Plate Shifter' },
  { id: 'flotacion', label: '🫧 #18 SP Flotation' }
];
---

<BaseLayout 
  title="SMAT Minerals | Process Equipment, Slurry Pumps & Spare Parts, Process Control"
  description="Supply for mineral processing plants from our Durango Central Warehouse: Process Equipment (Flotation, Hydrocyclones & Filter Presses), Slurry Pumps & Spare Parts (5-5-4 Wet-End Lots, D075C21 Shaft Sleeve & Bearing Assemblies), and Process Control (Marcy Scales, Batch Pressure Filters & ASTM E11 Sieves)."
  lang="en"
>
  <section class="hero-home">
    <div class="container">
      <div class="hero-badge-pill">
        <span class="live-dot" aria-hidden="true"></span>
        <span>SMAT MINERALS • DURANGO CENTRAL WAREHOUSE • MINERAL PROCESSING SUPPLY</span>
      </div>
      
      <h1>
        Slurry Pumps & Wear Spares<br/>
        <span class="hero-sub-accent">Flotation Mechanisms, Filter Presses & Pulp Density Scales. Hydrocyclones.</span>
      </h1>

      <div class="hero-actions">
        <a href="/en/quote/#rfq" class="btn btn-primary btn-lg">Request Quotation</a>
        <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="btn btn-outline btn-lg">View Exploded BOM & Pump Assembly</a>
        <a href="/en/classification/" class="btn btn-outline btn-lg">Hydrocyclones & 3-Cup Marcy Balance</a>
        <a href="/en/catalog/" class="btn btn-outline btn-lg">Master Catalog (19 SKUs + 13 Codes)</a>
      </div>

      <!-- 8-Chip Quick Product Family Filter Bar in the Hero (PRD §2.1) -->
      <div class="hero-family-chip-bar" role="toolbar" aria-label="Quick product family filter" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem;">
        {familyFilterChipsEn.map((chip, idx) => (
          <button
            type="button"
            data-family-chip={chip.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
            class={`part-chip ${idx === 0 ? 'part-chip--highlight' : ''}`}
            style="cursor: pointer;"
          >
            {chip.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- THREE-DOOR ARCHITECTURE (DON MANUEL - PART FIRST, ZERO FLUFF) -->
  <section class="equipment-showcase-section" aria-label="The Three SMAT Supply Doors">
    <div class="container">
      <div class="showcase-header">
        <span class="section-eyebrow">DIRECT PART & EQUIPMENT SELECTION • X-RAY CAD DIAGRAMS</span>
        <h2>Select Your Spare Part or Plant Supply Area</h2>
      </div>

      <div class="showcase-grid">
        <!-- DOOR 1: SLURRY PUMPS & SPARE PARTS (AVENUE 1 · TAM 17.5M–22.0M USD) -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Door 1 • Slurry Pumping & Wear Spares</span>
            <span class="showcase-series">1.5x1" to 14x12" • 13 Codes</span>
          </div>
          <h3>Slurry Pumps & Spare Parts</h3>
          <TechnicalDiagrams diagram="pump" lang="en" compact={true} />
          <p class="door-concise-summary">
            5-5-4 Wet-End Lots in High Chrome (≥650 HB), Rubber, PU & SiC + D075C21 Sleeve & Bearing Assembly.
          </p>
          <div class="part-chip-strip" aria-label="Direct slurry pump spare part selection">
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=lote_554&material=alto_cromo_cr27#rfq" class="part-chip part-chip--highlight">5-5-4 Kit</a>
            <a href="/en/quote/?equipo=impulsor_bomba&pieza=impulsor_5_alabes&material=alto_cromo_cr27#rfq" class="part-chip">5-Vane Impeller</a>
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=voluta_liners&material=alto_cromo_cr27#rfq" class="part-chip">Cr27% Volute</a>
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=voluta_liners&material=hule_natural#rfq" class="part-chip">Rubber / PU Liners</a>
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=throatbush&material=alto_cromo_cr27#rfq" class="part-chip">Throatbush</a>
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=fpl_insert&material=alto_cromo_cr27#rfq" class="part-chip">FPL Insert</a>
            <a href="/en/catalog/D075C21/" class="part-chip part-chip--highlight">Sleeve D075C21</a>
            <a href="/en/quote/?equipo=sello_expulsor&pieza=expeller_sello#rfq" class="part-chip">Dry Expeller</a>
            <a href="/en/quote/?equipo=soporte_rodamiento&pieza=bearing_assembly#rfq" class="part-chip">Bearing Assembly</a>
            <a href="/en/quote/?equipo=skid_bomba#rfq" class="part-chip">CV/ZVZ Drive Train</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Materials:</span>
              <span class="ks-val">High Chrome (≥650 HB), Rubber, Polyurethane & SiC Ceramic</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Wet-End Lot:</span>
              <span class="ks-val">5 Impellers + 5 Throatbushes + 4 Volutes</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Assembly Report:</span>
              <span class="ks-val">
                <a href="/en/pumping/#how-a-slurry-pump-is-assembled" class="inline-spec-link">How a pump is assembled (14 parts) →</a>
              </span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/en/pumping/" class="showcase-cta-primary">View Parts & Exploded BOM →</a>
            <a href="/en/quote/?equipo=bombeo_hule_cromo&pieza=lote_554#rfq" class="showcase-cta-secondary">Quote 5-5-4 Lot</a>
          </div>
        </article>

        <!-- DOOR 2: HYDROCYCLONES, MARRIED PACKAGES & URETHANE SCREENS (AVENUES 2 & 3) -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Door 2 • Classification & Fine Screening</span>
            <span class="showcase-series">D6–D20 • TH48-30 • 1'x1'</span>
          </div>
          <h3>Hydrocyclones & Urethane Screens</h3>
          <TechnicalDiagrams diagram="cyclone_d6_d20" lang="en" compact={true} />
          <p class="door-concise-summary">
            D6–D20 Hydrocyclones (SiC Apex & Vortex Finder), Married Pump + Cyclone Package & TH48-30 / 1'x1' Urethane Screens.
          </p>
          <div class="part-chip-strip" aria-label="Quick selection of Classification & Screening">
            <a href="/en/classification/" class="part-chip part-chip--highlight">D6–D20 Hydrocyclones (Apex & Vortex)</a>
            <a href="/en/products/coupled-pump-hydrocyclone-package/" class="part-chip part-chip--highlight">Married Pump + Cyclone Package</a>
            <a href="/en/products/high-frequency-urethane-screens-th48-30/" class="part-chip">TH48-30 Fine Screens</a>
            <a href="/en/products/modular-polyurethane-screen-panels-1x1/" class="part-chip">1'x1' Polyurethane Modules</a>
            <a href="/en/classification/#marcy-3cup-workbench" class="part-chip">3-Cup Marcy Balance (Plitt d50c)</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Hydrocyclones:</span>
              <span class="ks-val">
                <a href="/en/classification/" class="inline-spec-link">D6, D10, D10B, D15 & D20 Series (5 Zones) →</a>
              </span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Urethane Screens:</span>
              <span class="ks-val">TH48-30 Series & 1'x1' Panels (Weibull α ≥ 4.2)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Hydraulic Pairing:</span>
              <span class="ks-val">4x3 + D10 • 6x4 + D15 • 8x6 + D20 (10–12 psi)</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/en/classification/" class="showcase-cta-primary">View Hydrocyclones & Screens →</a>
            <a href="/en/products/coupled-pump-hydrocyclone-package/" class="showcase-cta-secondary">Quote Married Package</a>
          </div>
        </article>

        <!-- DOOR 3: FLOTATION MECHANISMS, FILTER PRESSES & PROCESS CONTROL (AVENUES 4, 5 & 6A) -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Door 3 • Flotation, Filtration & Lab</span>
            <span class="showcase-series">50–300 ft³ • 16 bar • SG 2.2–4.4</span>
          </div>
          <h3>Flotation Mechanisms, Filter Presses & Control</h3>
          <TechnicalDiagrams diagram="flotation" lang="en" compact={true} />
          <p class="door-concise-summary">
            Suspended Flotation Mechanisms (18 SP, 24, 30), Filter Presses (800–1500 mm, Cloths & Plate Shifter), Marcy Scale & ASTM E11 Sieves.
          </p>
          <div class="part-chip-strip" aria-label="Quick selection of Flotation, Filtration & Lab">
            <a href="/en/quote/?circuito=flotacion&equipo=celda_flotacion#rfq" class="part-chip part-chip--highlight">18 SP / 24 / 30 Flotation Mechanism</a>
            <a href="/en/quote/?circuito=filtracion&equipo=filtro_prensa#rfq" class="part-chip">PP Plates, Cloths & Plate Shifter (16 bar)</a>
            <a href="/en/quote/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="part-chip part-chip--highlight">Marcy Scale + 1000 cm³ Cup</a>
            <a href="/en/quote/?circuito=control_procesos&equipo=filtro_batch_lab#rfq" class="part-chip">Batch Pressure Filter (100 psi)</a>
            <a href="/en/quote/?circuito=control_procesos&equipo=tamices_astm_e11#rfq" class="part-chip">ASTM E11 Sieves & Ro-Tap</a>
            <a href="/en/process-equipment/" class="part-chip">Process Equipment</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Drop-In Flotation:</span>
              <span class="ks-val">50 to 300 ft³ • Rougher, Cleaner, and Scavenger (Drop-In Rotor/Diffuser)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Filter Presses:</span>
              <span class="ks-val">800 to 1500 mm (16 bar • NOM-141 • Plate Shifter)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Laboratory:</span>
              <span class="ks-val">Marcy Scale (1000 cm³), ASTM E11 Sieves & Gold Pan</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/en/process-control/" class="showcase-cta-primary">View Equipment & Lab →</a>
            <a href="/en/quote/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="showcase-cta-secondary">Quote Equipment</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 19 QUICK-CHECKOUT SKUS SHOWCASE (MVP V3.0 • D1, D2, D3, D4, D6) -->
  <section class="quick-sku-home-section" id="home-quick-checkout-catalog" aria-label="19 Quick-Checkout SKUs">
    <div class="container">
      <div class="showcase-header" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="section-eyebrow">1-CLICK QUICK CHECKOUT • ISO/IEC 7810 (0.76 MM) PHYSICAL SCALE • MULTI-ITEM TRAY (c·μ)</span>
          <h2>19 Critical Plant SKUs & 13 Verified Atomic Part Sheets</h2>
        </div>
        <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
          <a href="/en/catalog/d075c21/" class="part-chip part-chip--highlight">View D075C21 Sheet (Shaft Sleeve) →</a>
          <a href="/en/classification/" class="part-chip part-chip--highlight">Open Hydrocyclone Simulator →</a>
        </div>
      </div>

      <!-- Instant Zero-OEM Drop-In Geometric Equivalence Verifier (Anti-Luis • D3 · Solar Light-First) -->
      <div id="workbench" class="dropin-verifier-box" data-dropin-verifier-en style="margin-bottom: 1.5rem; padding: 1rem 1.25rem; border-radius: 10px; background: #f8fafc; color: #0f172a; border: 1.5px solid #cbd5e1; border-left: 4px solid #7c2d12; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between;">
        <p style="margin: 0; font-size: 0.82rem; color: #334155;">
          <strong style="font-family: var(--smat-font-mono); font-size: 0.78rem; color: #7c2d12; display: block;">
            🔎 INSTANT ZERO-OEM DROP-IN GEOMETRIC EQUIVALENCE VERIFIER (ISO 2768-m)
          </strong>
          Enter the cast code on your current part (e.g. <code>E4147A05</code>, <code>D075C21</code>, <code>E4083</code>, <code>TH48-30</code>):
        </p>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
          <input
            type="text"
            data-dropin-input-en
            placeholder="e.g. E4147A05 or D075C21"
            aria-label="Part code to verify Drop-In equivalence"
            style="padding: 0.5rem 0.75rem; border-radius: 6px; border: 1px solid #94a3b8; background: #ffffff; color: #0f172a; font-family: var(--smat-font-mono); font-size: 0.85rem;"
          />
          <button
            type="button"
            data-dropin-btn-en
            class="part-chip part-chip--highlight"
            style="cursor: pointer;"
          >
            Verify Triplet (A,B,C) →
          </button>
        </div>
        <p data-dropin-result-en style="width: 100%; margin: 0.35rem 0 0; font-family: var(--smat-font-mono); font-size: 0.78rem; color: #065f46; display: none;"></p>
      </div>

      <div class="quick-sku-grid">
        {quickCatalog.map((item) => {
          const cleanRfqHrefEn = item.atomic_codes.length > 0
            ? `/en/quote/?sku=${encodeURIComponent(item.id)}&codigo=${encodeURIComponent(item.atomic_codes[0])}#rfq`
            : `/en/quote/?sku=${encodeURIComponent(item.id)}#rfq`;
          return (
            <article
              class="quick-sku-card"
              data-sku-family={item.vertical}
              data-sku-id={item.id}
            >
              <div class="quick-sku-top">
                <span class="quick-sku-id">{item.id} · {item.stock_regime === 'se_fabrica' ? '🔵 CUSTOM' : item.stock_regime === 'se_pide' ? '🟡 BATCH' : '🟢 IN STOCK'}</span>
                {item.atomic_codes.length > 0 && (
                  <span class="quick-sku-atomic">{item.atomic_codes.join(' · ')}</span>
                )}
              </div>
              <h3 class="quick-sku-title">
                <a href={`/en/products/${item.slug_en}/`}>{item.title_en}</a>
              </h3>
              <ProductQuickCard sku={item} lang="en" />
              <div class="quick-sku-actions" style="margin-top: 0.75rem;">
                <a href={`/en/products/${item.slug_en}/`} class="part-chip part-chip--highlight">View Full Sheet & X-Ray →</a>
                <a href={cleanRfqHrefEn} class="part-chip">+ RFQ Dossier</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <script>
    import { verifyDropInEquivalence } from '../../scripts/dropInEquivalenceGuard.js';
    function matchesFamilyFilterEn(skuId: string, vertical: string, filterId: string): boolean {
      if (!filterId || filterId === 'all') return true;
      if (filterId === 'tamices') return skuId === 'SMAT-LAB-TAMIZ-E11' || skuId === 'SMAT-LAB-ROTAP-MECH';
      if (filterId === 'sello_potencia') return skuId === 'SMAT-PUMP-EXPELLER-KIT' || skuId === 'SMAT-PUMP-BRG-005M';
      return vertical === filterId;
    }
    function bindDropInVerifierEn() {
      const chips = document.querySelectorAll('[data-family-chip]');
      const skuCards = document.querySelectorAll('[data-sku-family]');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const filterId = chip.getAttribute('data-family-chip') || 'all';
          chips.forEach((c) => {
            const active = c.getAttribute('data-family-chip') === filterId;
            c.setAttribute('aria-pressed', active ? 'true' : 'false');
            c.classList.toggle('part-chip--highlight', active);
          });
          skuCards.forEach((card) => {
            const skuId = card.getAttribute('data-sku-id') || '';
            const vertical = card.getAttribute('data-sku-family') || '';
            const visible = matchesFamilyFilterEn(skuId, vertical, filterId);
            if (card instanceof HTMLElement) {
              card.style.display = visible ? '' : 'none';
            }
          });
          const catalogSection = document.getElementById('home-quick-checkout-catalog');
          catalogSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      const box = document.querySelector('[data-dropin-verifier-en]');
      if (!box) return;
      const input = box.querySelector('[data-dropin-input-en]') as HTMLInputElement | null;
      const btn = box.querySelector('[data-dropin-btn-en]');
      const out = box.querySelector('[data-dropin-result-en]') as HTMLElement | null;
      const run = () => {
        if (!input || !out) return;
        const res = verifyDropInEquivalence(input.value);
        out.style.display = 'block';
        if (res.matched && res.geometricTripletMm) {
          out.innerHTML = `✅ DROP-IN MATCH: <strong>${res.canonicalSkuId}</strong> (${res.titleEn}) | Alloy: <strong>${res.alloyCode}</strong> | ${res.geometricTripletMm.label_en} (${res.toleranceStd}) · <a href="/en/products/${res.slugEn}/" style="color:#b45309;text-decoration:underline;">Open Sheet →</a>`;
        } else {
          out.innerHTML = `ℹ️ ${res.reasonEn}`;
        }
      };
      btn?.addEventListener('click', run);
      input?.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter') run();
      });
      const params = new URLSearchParams(window.location.search);
      const urlSku = params.get('sku');
      if (urlSku && input) {
        input.value = urlSku;
        run();
      }
    }
    bindDropInVerifierEn();
    document.addEventListener('astro:page-load', bindDropInVerifierEn);
  </script>

  <TrustMatrix lang="en" hideBoundaries={true} />
</BaseLayout>

<style>
  .hero-home {
    background-color: var(--smat-bg-canvas);
    color: var(--smat-text-primary);
    padding: 3rem 0 2.25rem;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid var(--smat-border-strong);
    color: var(--smat-text-secondary);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-family: var(--smat-font-mono);
    margin-bottom: 1.15rem;
    box-shadow: var(--smat-shadow-xs);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background-color: var(--smat-emerald-stock);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
  }

  .hero-home h1 {
    color: var(--smat-text-primary);
    font-size: clamp(2rem, 3.5vw, 2.9rem);
    max-width: 880px;
    margin-bottom: 0.85rem;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .hero-sub-accent {
    color: var(--smat-copper-accent);
    display: inline-block;
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    margin-top: 0.2rem;
  }

  .door-concise-summary {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--smat-text-primary);
    margin: 0.4rem 0 0.65rem 0;
    line-height: 1.35;
  }

  .part-chip-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    margin-bottom: 0.85rem;
  }

  .part-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.26rem 0.58rem;
    border-radius: 5px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.12s ease, background 0.12s ease;
  }

  .part-chip:hover {
    border-color: #0c4a6e;
    background: #f0f9ff;
    color: #0c4a6e;
  }

  .part-chip--highlight {
    background: #eff6ff;
    border-color: #0284c7;
    color: #0c4a6e;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn-lg {
    padding: 0.85rem 1.75rem;
    font-size: 0.95rem;
  }

  .equipment-showcase-section {
    padding: var(--smat-space-2xl, 80px) 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .showcase-header {
    margin-bottom: var(--smat-space-lg, 32px);
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .showcase-header h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--smat-text-primary);
    margin: 0 0 0.4rem 0;
    letter-spacing: -0.02em;
  }

  .showcase-header p {
    color: var(--smat-text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--smat-space-md, 24px);
  }

  @media (max-width: 960px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }

