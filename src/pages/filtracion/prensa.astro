---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FiltrationCalculatorIsland from '../../components/islands/FiltrationCalculatorIsland.astro';

const title = 'Filtros Prensa | SMAT Minerals';
const description = 'Filtros prensa hidráulicos (hasta 16 bar) para filtración de concentrados y jales secos (dry tailings) con placas de 800 a 1500 mm. Durango, México.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/filtracion/prensa/"
  alternateEsPath="/filtracion/prensa/"
  alternateEnPath="/en/filtration/press/"
>
  <FiltrationCalculatorIsland locale="es" variant="press" mode="standalone" />
</BaseLayout>
