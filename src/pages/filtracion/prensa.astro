---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import rolesData from '../../../data/roles.json';

const filtVertical = rolesData.verticals.find((v) => v.id === 'filtracion');
const prensaRole = filtVertical?.capex?.find((r) => r.role_id === 'prensa_completa');
const criteria = prensaRole?.decision_criteria;
---

<BaseLayout 
  title="Filtros Prensa | SMAT Minerals"
  description="Filtros prensa hidráulicos (hasta 16 bar) para filtración de concentrados y jales secos (dry tailings) con placas de 800 a 1500 mm. Durango, México."
  lang="es"
  canonicalPath="/filtracion/prensa/"
  alternateEsPath="/filtracion/prensa/"
  alternateEnPath="/en/filtration/press/"
>
  <section class="page-hero smat-compact-hero">
    <div class="container">
      <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0.4rem;">
        <h1 style="margin:0;">Filtros Prensa — Simulador Darcy-Ruth &amp; Timoshenko 16 bar</h1>
        <span class="badge badge-capex">EQUIPOS DE FILTRACIÓN • 800 A 1500 MM</span>
      </div>
      <p class="smat-hero-sub">Equipos hidráulicos de filtración para concentrados minerales y deshidratación de jales (dry tailings).</p>
    </div>
  </section>

  <section class="section-spacing smat-stage-compact">
    <div class="container content-container">
      <div class="card detail-card">
        <!-- Estrato 1: Calculadora Interactiva de Capacidad Darcy-Ruth y Esfuerzo Timoshenko -->
        <div class="filtration-5family-box" id="stratum1-press-sim" data-plate-flexure-panel="timoshenko-g5" data-stratum-1-instrument style="margin-bottom: 1.25rem; padding: clamp(0.7rem, 1.4vw, 1.15rem); border-radius: 10px; background: #f8fafc; color: var(--smat-text-primary); border: 1.5px solid #cbd5e1; border-left: 4px solid #7c2d12;">
          <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0.45rem; margin-bottom:0.35rem;">
            <span class="badge badge-copper">DIMENSIONAMIENTO EN VIVO · CAPACIDAD DE CICLO DARCY-RUTH &amp; TIMOSHENKO</span>
            <div style="display:flex; flex-wrap:wrap; gap:0.4rem; align-items:center;">
              <span id="filt-nom141-badge" style="font-family:var(--smat-font-mono); font-size:0.72rem; font-weight:800; padding:0.2rem 0.55rem; border-radius:4px; background:#ecfdf5; border:1px solid #059669; color:#064e3b;">NOM-141 ≤16% Cumple</span>
              <span id="filt-shifter-sku-badge" style="font-family:var(--smat-font-mono); font-size:0.72rem; font-weight:800; padding:0.2rem 0.55rem; border-radius:4px; background:#eff6ff; border:1px solid #0284c7; color:#0c4a6e;">SKU: SMAT-FILT-SHIFTER-CHAIN</span>
            </div>
          </div>
          <h2 style="margin: 0.25rem 0 0.45rem; font-size: clamp(0.98rem, 1.4vw, 1.12rem); color: var(--smat-text-primary);">Simulador de Tonelaje Seco (t/d), Ciclos Diarios y Flexión de Placa a 16 bar</h2>
          <div class="smat-stratum1-display">
            <div id="filt-res-summary" style="padding: 0.55rem 0.75rem; border-radius: 6px; background: #ecfdf5; border: 1px solid #059669; color: #064e3b; font-family: var(--smat-font-mono); font-size: 0.8rem; font-weight: 700;">
              Operación estructural segura. Cumple criterio de torta seca NOM-141.
            </div>
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.55rem;">
              <div style="background: #ffffff; padding: 0.5rem 0.65rem; border-radius: 6px; border: 1px solid #e2e8f0;">
                <span style="font-size: 0.7rem; font-weight: 800; color: #334155; display: block;">ESFUERZO TIMOSHENKO (σ<sub>max</sub>)</span>
                <strong id="filt-res-stress" style="font-family: var(--smat-font-mono); font-size: 1.05rem;">3.54 MPa</strong>
              </div>
              <div style="background: #ffffff; padding: 0.5rem 0.65rem; border-radius: 6px; border: 1px solid #e2e8f0;">
                <span style="font-size: 0.7rem; font-weight: 800; color: #334155; display: block;">FACTOR DE SEGURIDAD (FS)</span>
                <strong id="filt-res-fs" style="font-family: var(--smat-font-mono); font-size: 1.05rem;">FS 4.10</strong>
              </div>
            </div>
            <div id="filt-res-secondary" style="font-family: var(--smat-font-mono); font-size: 0.77rem; color: #334155; padding: 0.45rem 0.65rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px;">
              ΔP_asim = 0.288 MPa · σ_adm = 14.5 MPa · 48 ciclos/d · 545 t/d
            </div>
          </div>
          <div class="smat-inputs-2col" style="margin-bottom: 0.65rem; padding: 0.65rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.8rem;">
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Formato Placa (mm):</span>
              <select id="filt-plate-width" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                <option value="800">800 × 800 mm</option>
                <option value="1000">1000 × 1000 mm</option>
                <option value="1200">1200 × 1200 mm</option>
                <option value="1500" selected>1500 × 1500 mm</option>
              </select>
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Presión Prensado (bar):</span>
              <input type="number" id="filt-pressure-bar" min="4" max="25" step="1" value="16" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Puertos Obstruidos (0–4):</span>
              <input type="number" id="filt-clogged-ports" min="0" max="4" step="1" value="0" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Espesor Alma (mm):</span>
              <input type="number" id="filt-plate-thickness" min="45" max="110" step="5" value="65" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Humedad Torta (%):</span>
              <input type="number" id="filt-cake-moisture" min="8" max="26" step="0.5" value="14" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
          </div>
          <div style="display:flex; gap:0.65rem; flex-wrap:wrap; align-items:center;">
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-primary" data-quote-base="/cotizar/" style="min-height:48px; display:inline-flex; align-items:center;">Cotizar Filtro Prensa Calibrado →</a>
            <button
              type="button"
              class="btn btn-outline btn-avenue-tray"
              data-vertical-tray-btn
              data-add-tray-sku="SMAT-FILT-PRESS-1500"
              data-tray-part-code="FP-1500"
              data-tray-title="Filtro Prensa Hidráulico 1500 mm (16 bar)"
              data-tray-series="1500"
              data-tray-material="PP-Acero"
              data-tray-circuit="filtracion"
              data-tray-source="filter_press_stratum1_calc"
              style="min-height:48px;"
            >+ Bandeja Filtro Prensa</button>
          </div>
        </div>

        <div style="margin-bottom: 1.75rem;">
          <TechnicalDiagrams type="filter" lang="es" />
        </div>
        <h2>Especificaciones del Filtro Prensa</h2>
        <p>
          Los filtros prensa SMAT Minerals están diseñados para obtener tortas de filtración con humedades residuales del 12% al 16%, facilitando el manejo de concentrados y la recuperación de agua de proceso.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Parámetro de Diseño</th>
              <th>Especificación Técnica SMAT</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Tamaño de Placas</td>
              <td>Placas de cámara empotrada y membrana de 800 x 800 mm hasta 1500 x 1500 mm</td>
            </tr>
            <tr>
              <td>Presión de Cierre Hidráulico</td>
              <td>Cilindro hidráulico de alta fuerza con presiones de cierre de hasta 350 bar</td>
            </tr>
            <tr>
              <td>Presión de Filtración</td>
              <td>Alimentación de lodos a presiones de 8 bar a 16 bar</td>
            </tr>
            <tr>
              <td>Apertura y Descarga</td>
              <td>Sistema de apertura automática de placas por carro transfer o apertura en bloque</td>
            </tr>
            <tr>
              <td>Control</td>
              <td>Gabinete de control PLC para ciclos de llenado, prensado y soplado de torta</td>
            </tr>
            <tr>
              <td>Potencia Electrohidráulica y Tiempos de Ciclo</td>
              <td>{prensaRole?.power_range} • {prensaRole?.flow_range}</td>
            </tr>
            <tr>
              <td>Compresibilidad de Torta Darcy-Ruth (Tiller 1975)</td>
              <td>Resistencia específica α = α<sub>0</sub> (ΔP)<sup>s</sup> (s = 0.65) con exprimido secundario a 16 bar para humedad &lt; 15%</td>
            </tr>
          </tbody>
        </table>

        {criteria && (
          <div class="decision-criteria-panel" data-testid="role-decision-criteria" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid #9a3412;">
            <span class="badge badge-copper">CRITERIOS DE DECISIÓN METALÚRGICA EN PLANTA</span>
            <h3 style="margin: 0.45rem 0 0.75rem; font-size: 1.08rem; color: var(--smat-text-primary);">Matriz de Selección de Filtro Prensa ({prensaRole?.series})</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem; font-size: 0.88rem;">
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: var(--smat-text-primary); margin-bottom: 0.25rem;">Variables de Pulpa Requeridas</strong>
                <span style="color: #334155;">{criteria.required_slurry_vars_es}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #7c2d12; margin-bottom: 0.25rem;">Regla de Cámara y Compresión</strong>
                <span style="color: #334155;">{criteria.metallurgy_rule_es}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #14532d; margin-bottom: 0.25rem;">Riesgo Geotécnico y Operativo Mitigado</strong>
                <span style="color: #334155;">{criteria.risk_avoided_es}</span>
              </div>
            </div>
          </div>
        )}

        <div class="filtration-selector-box" data-testid="filtration-contextual-selector" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #fffbeb; border: 1px solid #fde68a;">
          <span class="badge badge-copper">PRE-SELECCIÓN CONTEXTUAL • PUENTE A COTIZADOR</span>
          <h3 style="margin: 0.45rem 0 0.5rem; font-size: 1.05rem; color: var(--smat-text-primary);">Seleccione Medida de Placa y Condición de Desaguado</h3>
          <p style="font-size: 0.88rem; color: #475569; margin-bottom: 0.85rem;">
            Pre-cargue directamente la medida de cámara empotrada (800 a 2000 mm) y el objetivo operativo en el cotizador RFQ:
          </p>
          <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=800&filt_condition=ciclo_lento#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Placas 800×800 mm • Concentrados</a>
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=1200&filt_condition=jales_secos#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Placas 1200×1200 mm • Jales Secos</a>
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Placas 1500×1500 mm • Dry Stacking</a>
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=2000&filt_condition=jales_secos#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Placas 2000×2000 mm • Gran Tonelaje</a>
          </div>
        </div>

        <SharePurchasing 
          roleTitle="Filtro Prensa"
          series="Placas de 800x800 a 1500x1500 mm (Presión hasta 16 bar)"
          metallurgy="Vigas de Acero Estructural Pesado, Placas de Polipropileno Virgen"
          specs="Filtro prensa con cilindro de cierre hidráulico, paquete de placas de polipropileno y telas filtrantes."
          roleId="filtro_prensa"
          circuit="filtracion"
          lang="es"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">ATENCIÓN TÉCNICA EN DURANGO</span>
            <h3>¿Requiere cotizar un filtro prensa para concentrados o jales?</h3>
            <p>Solicite su cotización indicando tamaño de placa o tonelaje por turno.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-primary btn-lg">
              Solicitar Cotización →
            </a>
            <a href="https://wa.me/526183670664?text=Hola%20SMAT%20Minerals,%20requiero%20cotizar%20Filtro%20Prensa" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              Cotizar por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { bindCanonicalFiltrationCalculator } from '../../scripts/verticalCalculatorsAndLabelsBridge.js';
  bindCanonicalFiltrationCalculator(document, 'es');
  document.addEventListener('astro:page-load', () => bindCanonicalFiltrationCalculator(document, 'es'));
</script>

<style>
  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: clamp(0.7rem, 2vw, 1.5rem);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--smat-copper-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #334155;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
