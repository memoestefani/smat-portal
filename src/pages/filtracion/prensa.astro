---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
---

<BaseLayout 
  title="Filtros Prensa para Jales Secos y Concentrados | SMAT Minerals"
  description="Filtros prensa hidráulicos de alta presión (hasta 16 bar) para desaguado de jales mineros (dry tailings) y filtración de concentrados. Durango, México."
  lang="es"
  canonicalPath="/filtracion/prensa/"
  alternateEsPath="/filtracion/prensa/"
  alternateEnPath="/en/filtration/press/"
>
  <Header slot="header" lang="es" currentPath="/filtracion/prensa/" alternatePath="/en/filtration/press/" />

  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-capex">CAPEX • PROYECTOS BAJO ESPECIFICACIÓN</span>
      <h1>Filtros Prensa Hidráulicos para Jales Secos</h1>
      <p class="subtitle">Sistemas de desaguado de alto tonelaje para disposición sustentable de jales (dry tailings).</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <h2>Desaguado Mecánico para Estabilidad de Presas de Jales</h2>
        <p>
          La gestión moderna de residuos mineros exige la transición hacia el depósito de jales secos para mitigar riesgos de falla de presas y maximizar la recuperación de agua de proceso. Los filtros prensa hidráulicos SMAT Minerals proporcionan tortas de filtración con humedades residuales del 12% al 16%, permitiendo el apilamiento en seco seguro y compactable.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Parámetro de Diseño</th>
              <th>Especificación de Proyecto SMAT</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Tamaño de Placas</td>
              <td>Placas de cámara empotrada y membrana de 800 x 800 mm hasta 1500 x 1500 mm</td>
            </tr>
            <tr>
              <td>Presión de Cierre Hidráulico</td>
              <td>Cilindro hidráulico de alta fuerza con presiones de cierre de hasta 350 bar</td>
            </tr>
            <tr>
              <td>Presión de Filtración</td>
              <td>Alimentación de lodos a presiones de 8 bar a 16 bar</td>
            </tr>
            <tr>
              <td>Apertura y Descarga</td>
              <td>Sistema de apertura automática de placas por carro transfer o apertura sincronizada en bloque</td>
            </tr>
            <tr>
              <td>Automatización</td>
              <td>Gabinete de control PLC con pantalla HMI táctil para ciclos de llenado, prensado y soplado de torta</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Filtro Prensa Hidráulico para Jales Secos"
          series="Placas de 800x800 a 1500x1500 mm (Presión hasta 16 bar)"
          metallurgy="Vigas de Acero Estructural Pesado, Placas de Polipropileno Virgen"
          specs="Filtro prensa para desaguado de jales con cilindro de cierre hidráulico, colector de filtrado y ciclo automático por PLC."
          lang="es"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">COTIZACIÓN INSTANTÁNEA EN ALMACÉN DURANGO</span>
            <h3>¿Requiere filtros prensa para desaguado de concentrados o jales?</h3>
            <p>Configure su proyecto en la consola central para recibir propuesta técnico-económica con dimensionamiento preliminar.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/?equipo=filtro_prensa#rfq" class="btn btn-primary btn-lg">
              Cotizar Filtro Prensa en Consola Central →
            </a>
            <a href="https://wa.me/526183670664?text=Hola%20SMAT%20Minerals,%20requiero%20cotizar%20Filtro%20Prensa" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              Consultar Proyecto por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton lang="es" />
  <Footer slot="footer" lang="es" />
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
