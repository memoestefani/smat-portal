---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import rolesData from '../../../data/roles.json';

const filtVertical = rolesData.verticals.find((v) => v.id === 'filtracion');
const prensaRole = filtVertical?.capex?.find((r) => r.role_id === 'prensa_completa');
const criteria = prensaRole?.decision_criteria;
---

<BaseLayout 
  title="Filtros Prensa | SMAT Minerals"
  description="Filtros prensa hidráulicos (hasta 16 bar) para filtración de concentrados y jales secos (dry tailings) con placas de 800 a 1500 mm. Durango, México."
  lang="es"
  canonicalPath="/filtracion/prensa/"
  alternateEsPath="/filtracion/prensa/"
  alternateEnPath="/en/filtration/press/"
>
  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-capex">EQUIPOS DE FILTRACIÓN • 800 A 1500 MM</span>
      <h1>Filtros Prensa</h1>
      <p class="subtitle">Equipos hidráulicos de filtración para concentrados minerales y deshidratación de jales (dry tailings).</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <div style="margin-bottom: 1.75rem;">
          <TechnicalDiagrams type="filter" lang="es" />
        </div>
        <h2>Especificaciones del Filtro Prensa</h2>
        <p>
          Los filtros prensa SMAT Minerals están diseñados para obtener tortas de filtración con humedades residuales del 12% al 16%, facilitando el manejo de concentrados y la recuperación de agua de proceso.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Parámetro de Diseño</th>
              <th>Especificación Técnica SMAT</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Tamaño de Placas</td>
              <td>Placas de cámara empotrada y membrana de 800 x 800 mm hasta 1500 x 1500 mm</td>
            </tr>
            <tr>
              <td>Presión de Cierre Hidráulico</td>
              <td>Cilindro hidráulico de alta fuerza con presiones de cierre de hasta 350 bar</td>
            </tr>
            <tr>
              <td>Presión de Filtración</td>
              <td>Alimentación de lodos a presiones de 8 bar a 16 bar</td>
            </tr>
            <tr>
              <td>Apertura y Descarga</td>
              <td>Sistema de apertura automática de placas por carro transfer o apertura en bloque</td>
            </tr>
            <tr>
              <td>Control</td>
              <td>Gabinete de control PLC para ciclos de llenado, prensado y soplado de torta</td>
            </tr>
            <tr>
              <td>Potencia Electrohidráulica y Tiempos de Ciclo</td>
              <td>{prensaRole?.power_range} • {prensaRole?.flow_range}</td>
            </tr>
            <tr>
              <td>Compresibilidad de Torta Darcy-Ruth (Tiller 1975)</td>
              <td>Resistencia específica α = α<sub>0</sub> (ΔP)<sup>s</sup> (s = 0.65) con exprimido secundario a 16 bar para humedad &lt; 15%</td>
            </tr>
          </tbody>
        </table>

        {criteria && (
          <div class="decision-criteria-panel" data-testid="role-decision-criteria" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid #9a3412;">
            <span class="badge badge-copper">CRITERIOS DE DECISIÓN METALÚRGICA • ROLES.JSON</span>
            <h3 style="margin: 0.45rem 0 0.75rem; font-size: 1.08rem; color: var(--smat-text-primary);">Matriz de Selección de Filtro Prensa ({prensaRole?.series})</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem; font-size: 0.88rem;">
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: var(--smat-text-primary); margin-bottom: 0.25rem;">Variables de Pulpa Requeridas</strong>
                <span style="color: #334155;">{criteria.required_slurry_vars_es}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #7c2d12; margin-bottom: 0.25rem;">Regla de Cámara y Compresión</strong>
                <span style="color: #334155;">{criteria.metallurgy_rule_es}</span>
              </div>
              <div style="background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid #e2e8f0;">
                <strong style="display: block; color: #14532d; margin-bottom: 0.25rem;">Riesgo Geotécnico y Operativo Mitigado</strong>
                <span style="color: #334155;">{criteria.risk_avoided_es}</span>
              </div>
            </div>
          </div>
        )}

        <div class="filtration-selector-box" data-testid="filtration-contextual-selector" style="margin-bottom: 2rem; padding: 1.35rem; border-radius: 10px; background: #fffbeb; border: 1px solid #fde68a;">
          <span class="badge badge-copper">PRE-SELECCIÓN CONTEXTUAL • PUENTE A COTIZADOR</span>
          <h3 style="margin: 0.45rem 0 0.5rem; font-size: 1.05rem; color: var(--smat-text-primary);">Seleccione Medida de Placa y Condición de Desaguado</h3>
          <p style="font-size: 0.88rem; color: #475569; margin-bottom: 0.85rem;">
            Pre-cargue directamente la medida de cámara empotrada (800 a 2000 mm) y el objetivo operativo en el cotizador RFQ:
          </p>
          <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=800&filt_condition=ciclo_lento#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Placas 800×800 mm • Concentrados</a>
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=1200&filt_condition=jales_secos#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Placas 1200×1200 mm • Jales Secos</a>
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Placas 1500×1500 mm • Dry Stacking</a>
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=2000&filt_condition=jales_secos#rfq" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.8rem;">Placas 2000×2000 mm • Gran Tonelaje</a>
          </div>
        </div>

        <SharePurchasing 
          roleTitle="Filtro Prensa"
          series="Placas de 800x800 a 1500x1500 mm (Presión hasta 16 bar)"
          metallurgy="Vigas de Acero Estructural Pesado, Placas de Polipropileno Virgen"
          specs="Filtro prensa con cilindro de cierre hidráulico, paquete de placas de polipropileno y telas filtrantes."
          roleId="filtro_prensa"
          circuit="filtracion"
          lang="es"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">ATENCIÓN TÉCNICA EN DURANGO</span>
            <h3>¿Requiere cotizar un filtro prensa para concentrados o jales?</h3>
            <p>Solicite su cotización indicando tamaño de placa o tonelaje por turno.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-primary btn-lg">
              Solicitar Cotización →
            </a>
            <a href="https://wa.me/526183670664?text=Hola%20SMAT%20Minerals,%20requiero%20cotizar%20Filtro%20Prensa" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              Cotizar por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--smat-copper-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
