---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FiltrationCalculatorIsland from '../../components/islands/FiltrationCalculatorIsland.astro';

const title = 'Placas Filtrantes, Telas y Repuestos Hidráulicos | SMAT Minerals';
const description = 'Telas filtrantes cortadas por láser con sellado perimetral térmico y placas de polipropileno de alta resistencia química (800 a 1500 mm).';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/filtracion/repuestos/"
  alternateEsPath="/filtracion/repuestos/"
  alternateEnPath="/en/filtration/parts/"
>
  <FiltrationCalculatorIsland locale="es" variant="parts" mode="standalone" />
</BaseLayout>
