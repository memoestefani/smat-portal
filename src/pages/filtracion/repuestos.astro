---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
---

<BaseLayout 
  title="Placas de Polipropileno y Telas Filtrantes | SMAT Minerals"
  description="Placas de cámara empotrada, membranas exprimibles y telas filtrantes de monofilamento / multifilamento para desaguado minero desde Almacén Durango."
  lang="es"
  canonicalPath="/filtracion/repuestos/"
  alternateEsPath="/filtracion/repuestos/"
  alternateEnPath="/en/filtration/parts/"
>
  <Header slot="header" lang="es" currentPath="/filtracion/repuestos/" alternatePath="/en/filtration/parts/" />

  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">OPEX • STOCK EN ALMACÉN DURANGO</span>
      <h1>Placas Filtrantes y Telas de Prensa</h1>
      <p class="subtitle">Reposición de elementos filtrantes para mantener la continuidad en el desaguado de jales.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <h2>Placas de Polipropileno Virgen y Tejidos de Alta Resistencia</h2>
        <p>
          Las telas filtrantes tapadas o rasgadas reducen drásticamente la tasa de filtración horaria e incrementan el contenido de humedad en la torta. SMAT Minerals mantiene inventario de telas sintéticas calibradas según la granulometría de su pulpa y placas de reemplazo de polipropileno de alta densidad estabilizado térmicamente.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Repuesto</th>
              <th>Material y Especificaciones</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Placas de Cámara Empotrada</td>
              <td>Polipropileno virgen 100% de grado de ingeniería resistente a agentes químicos y ácidos</td>
            </tr>
            <tr>
              <td>Placas de Membrana</td>
              <td>Membrana soldada o reemplazable de elastómero termoplástico (TPE) para soplado y exprimido secundario</td>
            </tr>
            <tr>
              <td>Telas Filtrantes</td>
              <td>Tejidos de monofilamento, multifilamento o fibras mixtas de polipropileno (PP), poliamida y poliéster</td>
            </tr>
            <tr>
              <td>Sellos y Accesorios</td>
              <td>Empaques perimetrales de goma, orificios de alimentación central/esquinera y agarraderas de sujeción</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Placas de Polipropileno y Telas de Filtro Prensa"
          series="Dimensiones estándar 800x800, 1000x1000, 1200x1200, 1500x1500 mm"
          metallurgy="Polipropileno Virgen de Alta Densidad (PP) / Telas Sintéticas"
          specs="Placas de cámara empotrada y telas calibradas para desaguado de jales y concentrados con resistencia al taponamiento."
          lang="es"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">DESPACHO INMEDIATO DESDE DURANGO</span>
            <h3>¿Requiere paquetes de placas de polipropileno o telas filtrantes?</h3>
            <p>Emita de inmediato su requisición técnica formal con dimensiones de placa y tejido para filtración continua.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/?equipo=placas_telas#rfq" class="btn btn-primary btn-lg">
              Cotizar Placas y Telas en Consola Central →
            </a>
            <a href="https://wa.me/526183670664?text=Hola%20SMAT%20Minerals,%20requiero%20cotizar%20Placas%20y%20Telas%20de%20Filtro" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              Consultar Stock en Almacén por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton lang="es" />
  <Footer slot="footer" lang="es" />
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
