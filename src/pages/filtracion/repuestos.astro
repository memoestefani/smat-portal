---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
---

<BaseLayout 
  title="Placas Filtrantes, Telas y Repuestos Hidráulicos | SMAT Minerals"
  description="Telas filtrantes cortadas por láser con sellado perimetral térmico y placas de polipropileno de alta resistencia química (800 a 1500 mm)."
  lang="es"
  canonicalPath="/filtracion/repuestos/"
  alternateEsPath="/filtracion/repuestos/"
  alternateEnPath="/en/filtration/parts/"
>
  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">CÁMARA EMPOTRADA • 800 MM A 1500 MM</span>
      <h1>Placas Filtrantes, Telas y Repuestos Hidráulicos</h1>
      <p class="subtitle">Telas filtrantes cortadas por láser con sellado perimetral térmico y placas de polipropileno de alta resistencia química.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <div style="margin-bottom: 1.75rem;">
          <TechnicalDiagrams type="filter" lang="es" />
        </div>
        <h2>Telas Filtrantes y Placas de Polipropileno</h2>
        <p>
          Telas filtrantes cortadas por láser con sellado perimetral térmico y placas de polipropileno de alta resistencia química para cámaras de 800 mm a 1500 mm.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Repuesto</th>
              <th>Material y Especificaciones</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Placas de Cámara Empotrada</td>
              <td>Polipropileno Virgen Copolímero (800 x 800 mm a 1500 x 1500 mm) de alta resistencia química</td>
            </tr>
            <tr>
              <td>Placas de Membrana</td>
              <td>Membrana de elastómero termoplástico (TPE) para soplado y exprimido secundario de torta</td>
            </tr>
            <tr>
              <td>Telas Filtrantes</td>
              <td>Polipropileno Virgen Copolímero y Fieltro Agujado cortado por láser con sellado perimetral térmico</td>
            </tr>
            <tr>
              <td>Repuestos Hidráulicos y Sellos</td>
              <td>Cilindros, sellos hidráulicos, empaques perimetrales y cuellos de alimentación central/esquinero</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Placas Filtrantes, Telas y Repuestos Hidráulicos"
          series="Cámara empotrada de 800 mm a 1500 mm"
          metallurgy="Polipropileno Virgen Copolímero y Fieltro Agujado"
          specs="Telas filtrantes cortadas por láser con sellado perimetral térmico y placas de polipropileno de alta resistencia química."
          roleId="placas_telas"
          circuit="filtracion"
          lang="es"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">ATENCIÓN TÉCNICA EN DURANGO</span>
            <h3>¿Requiere placas filtrantes, telas o repuestos hidráulicos?</h3>
            <p>Solicite su cotización indicando dimensiones de placa (800 a 1500 mm) y posición de alimentación.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/?equipo=placas_telas#rfq" class="btn btn-primary btn-lg">
              Solicitar Cotización →
            </a>
            <a href="https://wa.me/526183670664?text=Hola%20SMAT%20Minerals,%20requiero%20cotizar%20Placas%20y%20Telas%20de%20Filtro%20Prensa" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              Cotizar por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
