---
// src/pages/filtracion/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
---

<BaseLayout 
  title="Filtros Prensa | SMAT Minerals"
  description="Filtros prensa de placas de 800 mm a 1500 mm, placas filtrantes de polipropileno, telas filtrantes y repuestos hidráulicos."
  lang="es"
>
  <section class="page-hero">
    <div class="container">
      <span class="badge badge-copper">FILTRACIÓN Y DESAGUADO</span>
      <h1>Filtros Prensa</h1>
      <p style="font-size: 1.08rem; max-width: 720px; color: var(--smat-text-secondary);">
        Filtros prensa de cámara empotrada, placas filtrantes de polipropileno, telas filtrantes y repuestos hidráulicos para concentrados y jales.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="filter" lang="es" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div class="card">
          <h3>Filtros Prensa</h3>
          <p>
            Filtros prensa de placas con cierre electrohidráulico para desaguado de concentrados minerales y jales, diseñados para ciclos de prensado de hasta 16 bar.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Cámara empotrada:</strong> de 800 mm a 1500 mm</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/filtracion/prensa/" class="btn btn-outline">Ficha Técnica</a>
            <a href="/#rfq?equipo=filtro_prensa" class="btn btn-primary">Cotizar</a>
          </div>
        </div>

        <div class="card">
          <h3>Placas Filtrantes, Telas y Repuestos Hidráulicos</h3>
          <p style="font-family: var(--smat-font-mono); font-size: 0.82rem; color: var(--smat-copper-accent); font-weight: 700; margin-bottom: 0.35rem;">
            Cámara empotrada de 800 mm a 1500 mm
          </p>
          <h4 style="margin: 0 0 0.5rem 0; font-size: 1rem;">Telas Filtrantes y Placas de Polipropileno</h4>
          <p>
            Telas filtrantes cortadas por láser con sellado perimetral térmico y placas de polipropileno de alta resistencia química.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Material:</strong> Polipropileno Virgen Copolímero y Fieltro Agujado</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/filtracion/repuestos/" class="btn btn-outline">Ficha Técnica</a>
            <a href="/#rfq?equipo=placas_telas" class="btn btn-primary">Cotizar</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="background: #f8fafc; border: 1px solid var(--smat-border-strong); padding: 2.25rem; text-align: center;">
        <h2 style="margin-bottom: 0.6rem;">Solicitar Cotización de Filtro Prensa, Placas o Telas</h2>
        <p style="max-width: 600px; margin: 0 auto 1.25rem; color: var(--smat-text-secondary);">
          Indique la medida de sus placas (800 a 1500 mm) o la capacidad requerida para su filtro prensa.
        </p>
        <a href="/#rfq?equipo=filtro_prensa" class="btn btn-primary">Solicitar Cotización →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 3rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.65rem; }
</style>
