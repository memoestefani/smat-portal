---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FiltrationCalculatorIsland from '../../components/islands/FiltrationCalculatorIsland.astro';

const title = 'Filtros Prensa | SMAT Minerals';
const description = 'Filtros prensa de placas de 800 mm a 1500 mm, placas filtrantes de polipropileno, telas filtrantes y repuestos hidráulicos.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/filtracion/"
  alternateEsPath="/filtracion/"
  alternateEnPath="/en/filtration/"
>
  <FiltrationCalculatorIsland locale="es" variant="hub" mode="standalone" />
</BaseLayout>
