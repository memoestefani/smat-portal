---
// src/pages/filtracion/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import CircuitNavigator from '../../components/CircuitNavigator.astro';
---

<BaseLayout 
  title="Filtros Prensa | SMAT Minerals"
  description="Filtros prensa de placas de 800 mm a 1500 mm, placas filtrantes de polipropileno, telas filtrantes y repuestos hidráulicos."
  lang="es"
>
  <section class="page-hero">
    <div class="container">
      <span class="badge badge-copper">FILTRACIÓN Y DESAGUADO</span>
      <h1>Filtros Prensa</h1>
      <p style="font-size: 1.08rem; max-width: 720px; color: var(--smat-text-secondary);">
        Filtros prensa de cámara empotrada, placas filtrantes de polipropileno, telas filtrantes y repuestos hidráulicos para concentrados y jales.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="filter" lang="es" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div class="card">
          <h3>Filtros Prensa</h3>
          <p>
            Filtros prensa de placas con cierre electrohidráulico para desaguado de concentrados minerales y jales, diseñados para ciclos de prensado de hasta 16 bar.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Cámara empotrada:</strong> de 800 mm a 1500 mm • Hasta 16 bar • Ciclos 20–40 min</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/filtracion/prensa/" class="btn btn-outline">Ficha Técnica</a>
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-primary">Cotizar</a>
          </div>
        </div>

        <div class="card">
          <h3>Placas Filtrantes, Telas y Repuestos Hidráulicos</h3>
          <p style="font-family: var(--smat-font-mono); font-size: 0.82rem; color: var(--smat-copper-accent); font-weight: 700; margin-bottom: 0.35rem;">
            Cámara empotrada de 800 mm a 1500 mm • <var>α</var> = <var>α</var><sub>0</sub> (Δ<var>P</var>)<sup><var>s</var></sup>
          </p>
          <h4 style="margin: 0 0 0.5rem 0; font-size: 1rem;">Telas Filtrantes y Placas de Polipropileno</h4>
          <p>
            Telas filtrantes cortadas por láser con sellado perimetral térmico y placas de polipropileno de alta resistencia química.
          </p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Material:</strong> Polipropileno Virgen Copolímero y Fieltro Agujado</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/filtracion/repuestos/" data-subroute-link="/filtracion/repuestos/" class="btn btn-outline">Ficha Técnica</a>
            <a href="/productos/lonas-y-placas-filtro-prensa-16bar/" class="btn btn-outline">Telas y Placas SMAT-FILT-CLOTH-PLATE →</a>
            <a href="/productos/mecanismo-corre-placas-plate-shifter/" class="btn btn-outline">Corre-Placas SMAT-FILT-SHIFTER-CHAIN →</a>
            <a href="/cotizar/?circuito=filtracion&equipo=placas_telas&serie=1500&filt_condition=fuga_chorreo#rfq" class="btn btn-primary">Cotizar</a>
          </div>
        </div>
      </div>

      <!-- Verificador de Flexión Timoshenko de Placas PP y Apilamiento en Seco NOM-141 -->
      <div class="card" id="nom141-plate-flexure-verifier" data-smat-calc="filtration" style="margin-top: 2rem; padding: 1.75rem;">
        <span class="badge badge-copper" data-smat-decision="D8" style="margin-bottom: 0.5rem;">CUMPLIMIENTO SEMARNAT NOM-141 &amp; MECÁNICA TIMOSHENKO</span>
        <h2 style="margin-bottom: 0.5rem;">Verificador de Flexión Asimétrica de Placas de Polipropileno y Torta Seca (Dry Stacking)</h2>
        <p style="color: var(--smat-text-secondary); margin-bottom: 1.25rem;">
          Evalúe el esfuerzo flector máximo (σ<sub>max</sub>) por obstrucción del puerto de alimentación y verifique el factor de seguridad estructural junto con la humedad objetivo de apilamiento en seco (&le; 16%).
        </p>

        <div class="grid-2" style="gap: 1.5rem; align-items: start;">
          <div style="display: grid; gap: 0.75rem;">
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Presión de Alimentación (bar):</span>
              <input type="number" id="filt-pressure-bar" min="4" max="25" step="1" value="12" style="width: 100px; padding: 0.4rem;" />
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Puertos / Cuellos Obstruidos (0 a 4):</span>
              <input type="number" id="filt-clogged-ports" min="0" max="4" step="1" value="0" style="width: 100px; padding: 0.4rem;" />
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Formato de Placa Cuadrada (mm):</span>
              <select id="filt-plate-width" style="width: 130px; padding: 0.4rem;">
                <option value="800">800 x 800 mm</option>
                <option value="1000">1000 x 1000 mm</option>
                <option value="1200" selected>1200 x 1200 mm</option>
                <option value="1500">1500 x 1500 mm</option>
              </select>
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Espesor de Alma de Placa (mm):</span>
              <input type="number" id="filt-plate-thickness" min="45" max="110" step="5" value="65" style="width: 100px; padding: 0.4rem;" />
            </label>
            <label style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600;">
              <span>Humedad Residual de Torta (%):</span>
              <input type="number" id="filt-cake-moisture" min="8" max="26" step="0.5" value="14" style="width: 100px; padding: 0.4rem;" />
            </label>
          </div>

          <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1.25rem;">
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-bottom: 0.65rem;">
              <div>
                <span style="font-size: 0.72rem; font-weight: 800; color: #475569; display: block;">ESFUERZO TIMOSHENKO (σ<sub>max</sub>)</span>
                <strong id="filt-res-stress" style="font-family: var(--smat-font-mono); font-size: 1.25rem;">3.54 MPa</strong>
              </div>
              <div>
                <span style="font-size: 0.72rem; font-weight: 800; color: #475569; display: block;">FACTOR DE SEGURIDAD (FS)</span>
                <strong id="filt-res-fs" style="font-family: var(--smat-font-mono); font-size: 1.25rem;">FS 4.10</strong>
              </div>
            </div>
            <div id="filt-res-secondary" style="font-family: var(--smat-font-mono); font-size: 0.78rem; color: #334155; margin-bottom: 0.85rem; padding: 0.45rem 0.65rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px;">
              ΔP_asim = 0.216 MPa · σ_adm = 14.5 MPa · 45 ciclos/d · 512 t/d (18.0 + 12 = 30.0 min)
            </div>
            <p id="filt-res-summary" style="font-size: 0.88rem; line-height: 1.5; margin: 0 0 1rem; padding: 0.75rem; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 6px; color: #065f46; font-weight: 600;">
              Operación estructural segura. Cumple criterio de torta seca NOM-141.
            </p>
            <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
              <a href="/productos/lonas-y-placas-filtro-prensa-16bar/" class="btn btn-primary">Configurar Placas y Lonas (SMAT-FILT-CLOTH-PLATE) →</a>
              <a href="/productos/mecanismo-corre-placas-plate-shifter/" class="btn btn-outline">Configurar Corre-Placas (SMAT-FILT-SHIFTER-CHAIN) →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background-color: #ffffff; border-top: 1px solid var(--smat-border-light); border-bottom: 1px solid var(--smat-border-light);">
    <div class="container">
      <CircuitNavigator lang="es" defaultCircuit="jales_filtracion" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="background: #f8fafc; border: 1px solid var(--smat-border-strong); padding: 2.25rem; text-align: center;">
        <h2 style="margin-bottom: 0.6rem;">Solicitar Cotización de Filtro Prensa, Placas o Telas</h2>
        <p style="max-width: 600px; margin: 0 auto 1.25rem; color: var(--smat-text-secondary);">
          Indique la medida de sus placas (800 a 1500 mm) o la capacidad requerida para su filtro prensa.
        </p>
        <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq" class="btn btn-primary">Solicitar Cotización →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { evaluateFilterPressPlateDeflection } from '../../scripts/slurryEngine.js';
  import { bindCanonicalFiltrationCalculator } from '../../scripts/verticalCalculatorsAndLabelsBridge.js';
  import { saveEngineeringContextSnapshot } from '../../scripts/wizardCircuitPhysicsController.js';
  void evaluateFilterPressPlateDeflection;
  void saveEngineeringContextSnapshot;
  bindCanonicalFiltrationCalculator(document, 'es');
</script>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 3rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.65rem; }
</style>
