---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustMatrix from '../components/TrustMatrix.astro';
import TechnicalDiagrams from '../components/TechnicalDiagrams.astro';
---

<BaseLayout 
  title="SMAT Minerals | Equipos de Proceso, Bombas para Lodos y Spare Parts, Control de Procesos"
  description="Suministro para plantas de beneficio minero desde Almacén Central Durango: Equipos de Proceso (Flotación y Filtros Prensa), Bombas para Lodos y Spare Parts (Lotes 5-5-4 y Bearing Assembly), y Control de Procesos (Balanzas Marcy, Filtro Batch y Tamices ASTM E11)."
  lang="es"
>
  <section class="hero-home">
    <div class="container">
      <div class="hero-badge-pill">
        <span class="live-dot" aria-hidden="true"></span>
        <span>SMAT MINERALS • ALMACÉN CENTRAL DURANGO • SUMINISTRO PARA PLANTAS DE BENEFICIO</span>
      </div>
      
      <h1>
        Bombas para Lodos y Refacciones<br/>
        <span class="hero-sub-accent">Mecanismos de Flotación, Filtros Prensa y Balanzas.</span>
      </h1>
      
      <p class="hero-lead">
        Seleccione su área de suministro en planta: <strong>Equipos de Proceso</strong>, <strong>Bombas para Lodos y Spare Parts</strong> por lote en contacto húmedo (5-5-4), o <strong>Control de Procesos</strong> para laboratorio metalúrgico.
      </p>

      <div class="hero-actions">
        <a href="/cotizar/#rfq" class="btn btn-primary btn-lg">Solicitar Cotización</a>
        <a href="/catalogo/" class="btn btn-outline btn-lg">Ver Catálogo y Diagramas</a>
      </div>
    </div>
  </section>

  <!-- ARQUITECTURA DE LAS 3 PUERTAS (DON MANUEL) -->
  <section class="equipment-showcase-section" aria-label="Las Tres Puertas de Suministro SMAT">
    <div class="container">
      <div class="showcase-header">
        <span class="section-eyebrow">SELECCIONE SU ÁREA DE SUMINISTRO EN PLANTA</span>
        <h2>Equipos de Proceso, Spare Parts y Control Metalúrgico</h2>
        <p>Acceso directo por departamento para proyectos de ingeniería, mantenimiento de bombeo y control de procesos.</p>
      </div>

      <div class="showcase-grid">
        <!-- PUERTA 1: EQUIPOS DE PROCESO -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Puerta 1 • Proyectos y Circuitos</span>
            <span class="showcase-series">50–300 ft³ • 16 bar</span>
          </div>
          <h3>Equipos de Proceso</h3>
          <TechnicalDiagrams diagram="flotation" lang="es" compact={true} />
          <p>
            <strong>Mecanismos para Celdas de Flotación y Acondicionadores</strong> (etapas Rougher, Cleaner y Scavenger), <strong>Filtros Prensa de Cámara Empotrada</strong> (800 a 1500 mm, hasta 16 bar) y paquetes completos de bombeo para proyectos.
          </p>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Flotación:</span>
              <span class="ks-val">Mecanismos y Celdas 50 a 300 ft³</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Filtración:</span>
              <span class="ks-val">Filtros Prensa 800 a 1500 mm (16 bar)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Cotización Rápida:</span>
              <span class="ks-val">
                <a href="/cotizar/?equipo=celda_flotacion#rfq" class="inline-spec-link">Flotación</a> • <a href="/cotizar/?equipo=filtro_prensa#rfq" class="inline-spec-link">Filtro Prensa</a>
              </span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/equipos/" class="showcase-cta-primary">Entrar a Equipos de Proceso →</a>
            <a href="/cotizar/?equipo=celda_flotacion#rfq" class="showcase-cta-secondary">Cotizar Proyecto</a>
          </div>
        </article>

        <!-- PUERTA 2: BOMBAS PARA LODOS Y SPARE PARTS -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Puerta 2 • Operación y Mantenimiento</span>
            <span class="showcase-series">1.5x1" a 14x12"</span>
          </div>
          <h3>Bombas para Lodos y Spare Parts</h3>
          <TechnicalDiagrams diagram="pump" lang="es" compact={true} />
          <p>
            Bombas horizontales de reemplazo, conjuntos completos <strong>Bearing Assembly / Housing</strong> y lotes programados de contacto húmedo (<strong>5 impulsores, 5 cuellos y 4 volutas</strong>) con sellado por expulsor centrífugo y prensaestopa.
          </p>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Aleaciones y Elastómeros:</span>
              <span class="ks-val">Alto Cromo (≥650 HB), Hule y Poliuretano</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Lote Húmedo:</span>
              <span class="ks-val">5 Impulsores + 5 Cuellos + 4 Volutas</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Conjunto Motriz:</span>
              <span class="ks-val">Bearing Assembly / Housing Completo</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/bombeo/" class="showcase-cta-primary">Entrar a Bombas y Spare Parts →</a>
            <a href="/cotizar/?equipo=skid_bomba#rfq" class="showcase-cta-secondary">Cotizar Lote Húmedo</a>
          </div>
        </article>

        <!-- PUERTA 3: CONTROL DE PROCESOS -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Puerta 3 • Laboratorio y Control</span>
            <span class="showcase-series">SG 2.2–4.4 • ASTM E11</span>
          </div>
          <h3>Control de Procesos</h3>
          <TechnicalDiagrams diagram="marcy" lang="es" compact={true} />
          <p>
            <strong>Balanzas para Densidad de Pulpa y % de Sólidos (Tipo Marcy)</strong> con vaso de 1000 cm³, <strong>Filtro de Presión Batch de Laboratorio SMAT</strong> (60 a 100 psi) y <strong>Tamices Certificados ASTM E11 / ISO 3310</strong> en Bronce y Acero Inoxidable.
          </p>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Densidad de Pulpa:</span>
              <span class="ks-val">Balanza Marcy (1000 cm³, 12 anillos)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Desaguado Lab:</span>
              <span class="ks-val">Filtro de Presión Batch (60–100 psi)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Granulometría:</span>
              <span class="ks-val">Tamices ASTM E11 (5" a Malla #635)</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/control-de-procesos/" class="showcase-cta-primary">Entrar a Control de Procesos →</a>
            <a href="/cotizar/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="showcase-cta-secondary">Cotizar Instrumento</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <TrustMatrix lang="es" hideBoundaries={true} />
</BaseLayout>

<style>
  .hero-home {
    background-color: var(--smat-bg-canvas);
    color: var(--smat-text-primary);
    padding: 3rem 0 2.25rem;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid var(--smat-border-strong);
    color: var(--smat-text-secondary);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-family: var(--smat-font-mono);
    margin-bottom: 1.15rem;
    box-shadow: var(--smat-shadow-xs);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background-color: var(--smat-emerald-stock);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
  }

  .hero-home h1 {
    color: var(--smat-text-primary);
    font-size: clamp(2rem, 3.5vw, 2.9rem);
    max-width: 880px;
    margin-bottom: 0.85rem;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .hero-sub-accent {
    color: var(--smat-copper-accent);
    display: inline-block;
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    margin-top: 0.2rem;
  }

  .hero-lead {
    color: var(--smat-text-secondary);
    font-size: 1.04rem;
    max-width: 760px;
    margin-bottom: 1.5rem;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn-lg {
    padding: 0.85rem 1.75rem;
    font-size: 0.95rem;
  }

  .equipment-showcase-section {
    padding: var(--smat-space-2xl, 80px) 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .showcase-header {
    margin-bottom: var(--smat-space-lg, 32px);
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .showcase-header h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--smat-text-primary);
    margin: 0 0 0.4rem 0;
    letter-spacing: -0.02em;
  }

  .showcase-header p {
    color: var(--smat-text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--smat-space-md, 24px);
  }

  @media (max-width: 960px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }

  .showcase-card {
    background: var(--smat-bg-canvas, #fafaf9);
    border: 1px solid var(--smat-border-strong, #cbd5e1);
    border-radius: 10px;
    padding: var(--smat-space-md, 24px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .showcase-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .showcase-tag {
    font-family: var(--smat-font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--smat-text-primary);
    background: #e2e8f0;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .showcase-series {
    font-family: var(--smat-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
  }

  .showcase-card h3 {
    font-size: 1.2rem;
    color: var(--smat-text-primary);
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
  }

  .showcase-card p {
    font-size: 0.88rem;
    color: var(--smat-text-secondary);
    line-height: 1.55;
    margin: 0 0 1rem 0;
    flex-grow: 1;
  }

  .pro-keyspecs-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    margin-bottom: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .keyspec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.76rem;
    gap: 0.5rem;
  }

  .ks-label {
    color: #64748b;
    font-weight: 600;
  }

  .ks-val {
    font-family: var(--smat-font-mono);
    font-weight: 700;
    color: var(--smat-text-primary);
    text-align: right;
  }

  .inline-spec-link {
    color: var(--smat-copper-accent);
    text-decoration: underline;
    min-height: auto !important;
    min-width: auto !important;
    display: inline !important;
  }

  .showcase-links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid #e2e8f0;
  }

  .showcase-cta-primary {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    text-decoration: none;
  }

  .showcase-cta-secondary {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--smat-text-secondary);
    text-decoration: underline;
  }
</style>
