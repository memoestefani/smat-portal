---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustMatrix from '../components/TrustMatrix.astro';
import TechnicalDiagrams from '../components/TechnicalDiagrams.astro';
---

<BaseLayout 
  title="SMAT Minerals | Equipos de Proceso, Bombas para Lodos y Spare Parts, Control de Procesos"
  description="Suministro para plantas de beneficio minero desde Almacén Central Durango: Equipos de Proceso (Flotación y Filtros Prensa), Bombas para Lodos y Spare Parts (Lotes 5-5-4 y Bearing Assembly), y Control de Procesos (Balanzas Marcy, Filtro Batch y Tamices ASTM E11)."
  lang="es"
>
  <section class="hero-home">
    <div class="container">
      <div class="hero-badge-pill">
        <span class="live-dot" aria-hidden="true"></span>
        <span>SMAT MINERALS • ALMACÉN CENTRAL DURANGO • SUMINISTRO PARA PLANTAS DE BENEFICIO</span>
      </div>
      
      <h1>
        Bombas para Lodos y Refacciones<br/>
        <span class="hero-sub-accent">Mecanismos de Flotación, Filtros Prensa y Balanzas.</span>
      </h1>

      <div class="hero-actions">
        <a href="/cotizar/#rfq" class="btn btn-primary btn-lg">Solicitar Cotización</a>
        <a href="/bombeo/#como-se-arma-una-bomba" class="btn btn-outline btn-lg">Ver Despiece y Cómo se Arma una Bomba</a>
        <a href="/catalogo/" class="btn btn-outline btn-lg">Catálogo General</a>
      </div>
    </div>
  </section>

  <!-- ARQUITECTURA DE LAS 3 PUERTAS (DON MANUEL - PIEZA PRIMERO, CERO ROLLO) -->
  <section class="equipment-showcase-section" aria-label="Las Tres Puertas de Suministro SMAT">
    <div class="container">
      <div class="showcase-header">
        <span class="section-eyebrow">SELECCIÓN DIRECTA DE PIEZA Y EQUIPO</span>
        <h2>Seleccione su Pieza o Área de Suministro en Planta</h2>
      </div>

      <div class="showcase-grid">
        <!-- PUERTA 1: EQUIPOS DE PROCESO -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Puerta 1 • Proyectos y Circuitos</span>
            <span class="showcase-series">50–300 ft³ • 16 bar</span>
          </div>
          <h3>Equipos de Proceso</h3>
          <TechnicalDiagrams diagram="flotation" lang="es" compact={true} />
          <p class="door-concise-summary">
            Celdas de Flotación, Filtros Prensa (800–1500 mm) y Skids de Bombeo (CV / ZVZ / CRZ / DC).
          </p>
          <div class="part-chip-strip" aria-label="Selección rápida de Equipos de Proceso">
            <a href="/cotizar/?equipo=celda_flotacion#rfq" class="part-chip">Mecanismo Flotación</a>
            <a href="/cotizar/?equipo=filtro_prensa#rfq" class="part-chip">Filtro Prensa 16 bar</a>
            <a href="/cotizar/?equipo=placas_filtrantes#rfq" class="part-chip">Placas PP y Lonas</a>
            <a href="/cotizar/?equipo=skid_bomba&transmision=CV#rfq" class="part-chip">Skid Bomba (CV/ZVZ/CRZ/DC)</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Flotación:</span>
              <span class="ks-val">50 a 300 ft³ (Rougher, Cleaner y Scavenger)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Filtración:</span>
              <span class="ks-val">Filtros Prensa 800 a 1500 mm (16 bar)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Transmisión Skid:</span>
              <span class="ks-val">
                <a href="/bombeo/skid/#arreglos-transmision" class="inline-spec-link">Arreglos CV • ZVZ • CRZ • DC</a>
              </span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/equipos/" class="showcase-cta-primary">Ver Equipos y Diagramas →</a>
            <a href="/cotizar/?equipo=celda_flotacion#rfq" class="showcase-cta-secondary">Cotizar Equipo</a>
          </div>
        </article>

        <!-- PUERTA 2: BOMBAS PARA LODOS Y SPARE PARTS -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Puerta 2 • Operación y Mantenimiento</span>
            <span class="showcase-series">1.5x1" a 14x12"</span>
          </div>
          <h3>Bombas para Lodos y Spare Parts</h3>
          <TechnicalDiagrams diagram="pump" lang="es" compact={true} />
          <p class="door-concise-summary">
            Lotes 5-5-4 en Alto Cromo (≥650 HB), Hule y Poliuretano + Bearing Assembly.
          </p>
          <div class="part-chip-strip" aria-label="Selección directa de refacción de bomba">
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=lote_554&material=alto_cromo_cr27#rfq" class="part-chip part-chip--highlight">Lote 5-5-4</a>
            <a href="/cotizar/?equipo=impulsor_bomba&pieza=impulsor_5_alabes&material=alto_cromo_cr27#rfq" class="part-chip">Impulsor 5 Álabes</a>
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=voluta_liners&material=alto_cromo_cr27#rfq" class="part-chip">Voluta Cr27%</a>
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=voluta_liners&material=hule_natural#rfq" class="part-chip">Liners Hule / PU</a>
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=throatbush&material=alto_cromo_cr27#rfq" class="part-chip">Throatbush</a>
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=fpl_insert&material=alto_cromo_cr27#rfq" class="part-chip">FPL Insert</a>
            <a href="/cotizar/?equipo=sello_expulsor&pieza=expeller_sello#rfq" class="part-chip">Expeller Seco</a>
            <a href="/cotizar/?equipo=soporte_rodamiento&pieza=bearing_assembly#rfq" class="part-chip">Bearing Assembly</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Materiales:</span>
              <span class="ks-val">Alto Cromo (≥650 HB), Hule y Poliuretano</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Lote Húmedo:</span>
              <span class="ks-val">5 Impulsores + 5 Cuellos + 4 Volutas</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Reporte Despiece:</span>
              <span class="ks-val">
                <a href="/bombeo/#como-se-arma-una-bomba" class="inline-spec-link">Cómo se arma una bomba (14 piezas) →</a>
              </span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/bombeo/" class="showcase-cta-primary">Ver Piezas y Despiece →</a>
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=lote_554#rfq" class="showcase-cta-secondary">Cotizar Lote 5-5-4</a>
          </div>
        </article>

        <!-- PUERTA 3: CONTROL DE PROCESOS -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Puerta 3 • Laboratorio y Control</span>
            <span class="showcase-series">SG 2.2–4.4 • ASTM E11</span>
          </div>
          <h3>Control de Procesos</h3>
          <TechnicalDiagrams diagram="marcy" lang="es" compact={true} />
          <p class="door-concise-summary">
            Balanza Marcy (1000 cm³), Filtro Batch (60–100 psi) y Tamices ASTM E11.
          </p>
          <div class="part-chip-strip" aria-label="Selección rápida de instrumentación metalúrgica">
            <a href="/cotizar/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="part-chip">Balanza Marcy + Vaso 1000 cm³</a>
            <a href="/cotizar/?circuito=control_procesos&equipo=filtro_batch_lab#rfq" class="part-chip">Filtro Presión Batch</a>
            <a href="/cotizar/?circuito=control_procesos&equipo=tamices_astm_e11#rfq" class="part-chip">Tamices ASTM E11 (#200 / 75 µm)</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Densidad de Pulpa:</span>
              <span class="ks-val">Balanza Marcy (1000 cm³, 12 anillos)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Desaguado Lab:</span>
              <span class="ks-val">Filtro de Presión Batch (60–100 psi)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Granulometría:</span>
              <span class="ks-val">Tamices ASTM E11 (5" a Malla #635)</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/control-de-procesos/" class="showcase-cta-primary">Ver Instrumentos y Diagramas →</a>
            <a href="/cotizar/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="showcase-cta-secondary">Cotizar Instrumento</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <TrustMatrix lang="es" hideBoundaries={true} />
</BaseLayout>

<style>
  .hero-home {
    background-color: var(--smat-bg-canvas);
    color: var(--smat-text-primary);
    padding: 3rem 0 2.25rem;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid var(--smat-border-strong);
    color: var(--smat-text-secondary);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-family: var(--smat-font-mono);
    margin-bottom: 1.15rem;
    box-shadow: var(--smat-shadow-xs);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background-color: var(--smat-emerald-stock);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
  }

  .hero-home h1 {
    color: var(--smat-text-primary);
    font-size: clamp(2rem, 3.5vw, 2.9rem);
    max-width: 880px;
    margin-bottom: 0.85rem;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .hero-sub-accent {
    color: var(--smat-copper-accent);
    display: inline-block;
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    margin-top: 0.2rem;
  }

  .door-concise-summary {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--smat-text-primary);
    margin: 0.4rem 0 0.65rem 0;
    line-height: 1.35;
  }

  .part-chip-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    margin-bottom: 0.85rem;
  }

  .part-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.26rem 0.58rem;
    border-radius: 5px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.12s ease, background 0.12s ease;
  }

  .part-chip:hover {
    border-color: #0d78c6;
    background: #f0f9ff;
    color: #0d78c6;
  }

  .part-chip--highlight {
    background: #eff6ff;
    border-color: #0d78c6;
    color: #0d78c6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn-lg {
    padding: 0.85rem 1.75rem;
    font-size: 0.95rem;
  }

  .equipment-showcase-section {
    padding: var(--smat-space-2xl, 80px) 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .showcase-header {
    margin-bottom: var(--smat-space-lg, 32px);
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .showcase-header h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--smat-text-primary);
    margin: 0 0 0.4rem 0;
    letter-spacing: -0.02em;
  }

  .showcase-header p {
    color: var(--smat-text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--smat-space-md, 24px);
  }

  @media (max-width: 960px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }

  .showcase-card {
    background: var(--smat-bg-canvas, #fafaf9);
    border: 1px solid var(--smat-border-strong, #cbd5e1);
    border-radius: 10px;
    padding: var(--smat-space-md, 24px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .showcase-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .showcase-tag {
    font-family: var(--smat-font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--smat-text-primary);
    background: #e2e8f0;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .showcase-series {
    font-family: var(--smat-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
  }

  .showcase-card h3 {
    font-size: 1.2rem;
    color: var(--smat-text-primary);
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
  }

  .showcase-card p {
    font-size: 0.88rem;
    color: var(--smat-text-secondary);
    line-height: 1.55;
    margin: 0 0 1rem 0;
    flex-grow: 1;
  }

  .pro-keyspecs-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    margin-bottom: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .keyspec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.76rem;
    gap: 0.5rem;
  }

  .ks-label {
    color: #64748b;
    font-weight: 600;
  }

  .ks-val {
    font-family: var(--smat-font-mono);
    font-weight: 700;
    color: var(--smat-text-primary);
    text-align: right;
  }

  .inline-spec-link {
    color: var(--smat-copper-accent);
    text-decoration: underline;
    min-height: auto !important;
    min-width: auto !important;
    display: inline !important;
  }

  .showcase-links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid #e2e8f0;
  }

  .showcase-cta-primary {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    text-decoration: none;
  }

  .showcase-cta-secondary {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--smat-text-secondary);
    text-decoration: underline;
  }
</style>
