---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import FlightDeck from '../components/FlightDeck.astro';
import CaseCards from '../components/CaseCards.astro';
import TrustMatrix from '../components/TrustMatrix.astro';
import TechnicalDiagrams from '../components/TechnicalDiagrams.astro';
---

<BaseLayout 
  title="SMAT Minerals | Bombas para Lodos, Mecanismos de Flotación, Filtros Prensa y Balanzas"
  description="Suministro de bombas para lodos, impulsores, revestimientos y cuellos (Alto Cromo, Hule y Poliuretano), Bearing Assembly / Housing, mecanismos de flotación, filtros prensa y balanzas Marcy."
  lang="es"
>
  <section class="hero-home">
    <div class="container">
      <div class="hero-badge-pill">
        <span class="live-dot" aria-hidden="true"></span>
        <span>SMAT MINERALS • SUMINISTRO PARA PLANTAS DE BENEFICIO</span>
      </div>
      
      <h1>
        Bombas para Lodos y Refacciones<br/>
        <span class="hero-sub-accent">Mecanismos de Flotación, Filtros Prensa y Balanzas.</span>
      </h1>
      
      <p class="hero-lead">
        Bombas completas para lodos, piezas en contacto húmedo por lote (impulsores, cuellos y volutas en Alto Cromo, Hule y Poliuretano), <strong>Bearing Assembly / Housing</strong>, mecanismos para celdas de flotación y acondicionadores, filtros prensa y <strong>balanzas de densidad de pulpa</strong>.
      </p>

      <div class="hero-actions">
        <a href="#rfq" class="btn btn-primary btn-lg">Solicitar Cotización</a>
        <a href="/catalogo/" class="btn btn-outline btn-lg">Ver Catálogo y Diagramas</a>
      </div>
    </div>
  </section>

  <!-- VITRINA CON DIAGRAMAS TÉCNICOS: BOMBAS PARA LODOS, FLOTACIÓN, FILTROS PRENSA Y BALANZAS -->
  <section class="equipment-showcase-section" aria-label="Equipos y Refacciones Principales">
    <div class="container">
      <div class="showcase-header">
        <span class="section-eyebrow">EQUIPOS, PIEZAS DE DESGASTE E INSTRUMENTACIÓN</span>
        <h2>Equipos y Refacciones por Área de Planta</h2>
        <p>Diagramas técnicos de referencia. Seleccione el equipo o lote de piezas en contacto húmedo para cotizar.</p>
      </div>

      <div class="showcase-grid">
        <!-- Tarjeta 1: Bombas para Lodos y Contacto Húmedo -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Circuito 1: Molienda y Bombeo</span>
            <span class="showcase-series">1.5x1" a 14x12"</span>
          </div>
          <h3>Bombas para Lodos y Piezas en Contacto Húmedo</h3>
          <TechnicalDiagrams diagram="pump" lang="es" compact={true} />
          <p>
            Bombas horizontales para lodos, <strong>Bearing Assembly / Housing</strong> completos y lotes de contacto húmedo (ej. 5 impulsores, 5 cuellos y 4 volutas). Sellado por expulsor centrífugo y prensaestopa (sin sello mecánico).
          </p>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Materiales:</span>
              <span class="ks-val">Alto Cromo (≥650 HB), Hule y Poliuretano</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Conjunto Motriz:</span>
              <span class="ks-val">Bearing Assembly / Housing Completo</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/#rfq?equipo=skid_bomba" class="showcase-cta-primary">Cotizar Bomba o Lote →</a>
            <a href="/bombeo/" class="showcase-cta-secondary">Ver Piezas y Diagramas</a>
          </div>
        </article>

        <!-- Tarjeta 2: Mecanismos para Celdas de Flotación y Acondicionadores -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Circuito 2: Concentración</span>
            <span class="showcase-series">50 a 300 ft³</span>
          </div>
          <h3>Mecanismos para Celdas de Flotación y Acondicionadores</h3>
          <TechnicalDiagrams diagram="flotation" lang="es" compact={true} />
          <p>
            Cabezales motrices, flechas, tubos de aire, rotores, estatores y acondicionadores de pulpa para etapas Rougher, Cleaner y Scavenger.
          </p>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Equipos:</span>
              <span class="ks-val">Mecanismos Completos y Acondicionadores</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Desgaste:</span>
              <span class="ks-val">Rotores y Estatores en Hule y Poliuretano</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/#rfq?equipo=celda_flotacion" class="showcase-cta-primary">Cotizar Mecanismo →</a>
            <a href="/flotacion/" class="showcase-cta-secondary">Especificaciones</a>
          </div>
        </article>

        <!-- Tarjeta 3: Filtros Prensa y Balanzas -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Circuito 3: Jales Secos</span>
            <span class="showcase-series">800 a 1500 mm</span>
          </div>
          <h3>Filtros Prensa, Placas Filtrantes y Balanzas</h3>
          <TechnicalDiagrams diagram="filter" lang="es" compact={true} />
          <p>
            Filtros prensa de cámara empotrada (hasta 16 bar), placas de polipropileno virgen copolímero, telas filtrantes en fieltro agujado y <strong>balanzas de densidad de pulpa (tipo Marcy)</strong>.
          </p>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Placas y Telas:</span>
              <span class="ks-val">Cámara empotrada de 800 mm a 1500 mm</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Control de Pulpa:</span>
              <span class="ks-val">Balanzas de Densidad y % de Sólidos</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/#rfq?equipo=filtro_prensa" class="showcase-cta-primary">Cotizar Filtro o Balanza →</a>
            <a href="/filtracion/" class="showcase-cta-secondary">Ver Filtros Prensa</a>
          </div>
        </article>
      </div>

      <!-- Bloque dedicado a Balanzas de Densidad de Pulpa -->
      <div class="marcy-banner-card">
        <div class="marcy-banner-info">
          <span class="showcase-tag">CONTROL METALÚRGICO EN PLANTA</span>
          <h3>Balanzas para Densidad de Pulpa y % de Sólidos</h3>
          <p>
            Balanza colgante de lectura directa con recipiente calibrado de 1000 cm³ (acero inoxidable o acrílico con orificios de rebose) y carátulas intercambiables para lectura inmediata de gravedad específica de pulpa y porcentaje de sólidos en molienda, clasificación y flotación.
          </p>
          <div class="showcase-links">
            <a href="/#rfq?equipo=custom" class="showcase-cta-primary">Cotizar Balanza →</a>
            <a href="/catalogo/" class="showcase-cta-secondary">Ver en Catálogo</a>
          </div>
        </div>
        <div class="marcy-banner-diagram">
          <TechnicalDiagrams diagram="marcy" lang="es" compact={true} />
        </div>
      </div>
    </div>
  </section>

  <!-- CONSOLA CENTRAL DE COTIZACIÓN -->
  <section class="workbench-main-section" aria-label="Solicitud de Cotización">
    <div class="container">
      <FlightDeck lang="es" />
    </div>
  </section>

  <!-- MATRIZ COMPARATIVA DE SUMINISTRO POR LOTE -->
  <section class="tco-matrix-section" aria-label="Suministro por Lote de Contacto Húmedo">
    <div class="container">
      <div class="tco-matrix-header">
        <span class="section-eyebrow">PLANEACIÓN DE MANTENIMIENTO EN PLANTA</span>
        <h2>Compra por Lote de Contacto Húmedo vs. Compra Pieza por Pieza</h2>
        <p>En bombas para lodos, las plantas programan lotes balanceados según la tasa real de desgaste de cada componente húmedo (por ejemplo: <strong>5 impulsores, 5 cuellos y 4 volutas</strong>) junto con un <strong>Bearing Assembly / Housing</strong> completo de respaldo.</p>
      </div>

      <div class="tco-table-wrapper">
        <table class="tco-comparison-matrix">
          <thead>
            <tr>
              <th>Criterio Operativo</th>
              <th>Importación Ultramarina Tradicional</th>
              <th>Compra Unitaria Reactiva</th>
              <th class="col-smat-highlight">Suministro Programado por Lote SMAT</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Tiempo de Tránsito Internacional</strong></td>
              <td>16 a 24 semanas (Tránsito marítimo y aduana)</td>
              <td>Compras aisladas de urgencia</td>
              <td class="col-smat-val">Programación directa por lote (Facturación nacional CFDI)</td>
            </tr>
            <tr>
              <td><strong>Configuración de Contacto Húmedo</strong></td>
              <td>Lotes rígidos con piezas de baja rotación</td>
              <td>1 pieza suelta (desajuste con partes gastadas)</td>
              <td class="col-smat-val">Lotes a medida (ej. 5 Impulsores + 5 Cuellos + 4 Volutas)</td>
            </tr>
            <tr>
              <td><strong>Materiales de Desgaste</strong></td>
              <td>Una sola aleación estándar</td>
              <td>Fundición no controlada (&lt;500 HB)</td>
              <td class="col-smat-val">Alto Cromo (≥650 HB), Hule y Poliuretano</td>
            </tr>
            <tr>
              <td><strong>Impacto ante Paro de Molino (20k–40,000 USD/hora)</strong></td>
              <td>Alto capital inmovilizado por meses</td>
              <td>Paro prolongado por falta de cuello o impulsor</td>
              <td class="col-smat-val">Respaldo completo en bodega de mina</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CaseCards lang="es" />

  <TrustMatrix lang="es" hideBoundaries={true} />
</BaseLayout>

<style>
  .hero-home {
    background-color: var(--smat-bg-canvas);
    color: var(--smat-text-primary);
    padding: 3.25rem 0 2.25rem;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid var(--smat-border-strong);
    color: var(--smat-text-secondary);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-family: var(--smat-font-mono);
    margin-bottom: 1.25rem;
    box-shadow: var(--smat-shadow-xs);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background-color: var(--smat-emerald-stock);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
  }

  .hero-home h1 {
    color: var(--smat-text-primary);
    font-size: clamp(2rem, 3.6vw, 3rem);
    max-width: 900px;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .hero-sub-accent {
    color: var(--smat-copper-accent);
    display: inline-block;
    font-size: clamp(1.35rem, 2.4vw, 2.1rem);
    margin-top: 0.25rem;
  }

  .hero-lead {
    color: var(--smat-text-secondary);
    font-size: 1.05rem;
    max-width: 820px;
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn-lg {
    padding: 0.85rem 1.75rem;
    font-size: 0.95rem;
  }

  .equipment-showcase-section {
    padding: var(--smat-space-xl, 48px) 0 var(--smat-space-lg, 32px);
    background-color: #ffffff;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .showcase-header {
    margin-bottom: var(--smat-space-lg, 32px);
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .showcase-header h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--smat-text-primary);
    margin: 0 0 0.4rem 0;
    letter-spacing: -0.02em;
  }

  .showcase-header p {
    color: var(--smat-text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--smat-space-md, 24px);
  }

  @media (max-width: 960px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }

  .showcase-card {
    background: var(--smat-bg-canvas, #fafaf9);
    border: 1px solid var(--smat-border-strong, #cbd5e1);
    border-radius: 10px;
    padding: var(--smat-space-md, 24px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .showcase-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .showcase-tag {
    font-family: var(--smat-font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #0f172a;
    background: #e2e8f0;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .showcase-series {
    font-family: var(--smat-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
  }

  .showcase-card h3 {
    font-size: 1.15rem;
    color: var(--smat-text-primary);
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
  }

  .showcase-card p {
    font-size: 0.88rem;
    color: var(--smat-text-secondary);
    line-height: 1.55;
    margin: 0 0 1rem 0;
    flex-grow: 1;
  }

  .pro-keyspecs-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    margin-bottom: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .keyspec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.76rem;
    gap: 0.5rem;
  }

  .ks-label {
    color: #64748b;
    font-weight: 600;
  }

  .ks-val {
    font-family: var(--smat-font-mono);
    font-weight: 700;
    color: #0f172a;
    text-align: right;
  }

  .showcase-links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid #e2e8f0;
  }

  .showcase-cta-primary {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    text-decoration: none;
  }

  .showcase-cta-secondary {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--smat-text-secondary);
    text-decoration: underline;
  }

  .marcy-banner-card {
    margin-top: 1.75rem;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 1.5rem;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .marcy-banner-card {
      grid-template-columns: 1fr;
    }
  }

  .marcy-banner-info h3 {
    margin: 0.5rem 0;
    font-size: 1.25rem;
    color: var(--smat-text-primary);
  }

  .marcy-banner-info p {
    font-size: 0.92rem;
    color: var(--smat-text-secondary);
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .workbench-main-section {
    padding: 1rem 0 3.5rem;
    background-color: var(--smat-bg-canvas);
  }

  .tco-matrix-section {
    padding: var(--smat-space-2xl, 80px) 0;
    background-color: #ffffff;
    border-top: 1px solid var(--smat-border-light);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .tco-matrix-header {
    margin-bottom: 1.75rem;
    max-width: 780px;
  }

  .tco-matrix-header h2 {
    font-size: clamp(1.4rem, 2.3vw, 1.85rem);
    color: var(--smat-text-primary);
    margin: 0 0 0.5rem 0;
  }

  .tco-matrix-header p {
    color: var(--smat-text-secondary);
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
  }

  .tco-table-wrapper {
    overflow-x: auto;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
  }

  .tco-comparison-matrix {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
    background: #ffffff;
  }

  .tco-comparison-matrix th,
  .tco-comparison-matrix td {
    padding: 0.95rem 1.15rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .tco-comparison-matrix thead th {
    background: #f8fafc;
    color: #334155;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  .col-smat-highlight {
    background: #fff7ed !important;
    color: #9a3412 !important;
    border-left: 2px solid var(--smat-copper-accent);
  }

  .col-smat-val {
    background: #fffaf5;
    font-weight: 700;
    color: #090d16;
    border-left: 2px solid var(--smat-copper-accent);
  }
</style>
