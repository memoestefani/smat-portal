---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustMatrix from '../components/TrustMatrix.astro';
import TechnicalDiagrams from '../components/TechnicalDiagrams.astro';
import ProductQuickCard from '../components/ProductQuickCard.astro';
import { getQuickProductsCatalog } from '../scripts/quickProductsCatalog.js';

const quickCatalog = getQuickProductsCatalog();
const familyFilterChipsEs = [
  { id: 'all', label: 'Todas las Familias (19)' },
  { id: 'control', label: '⚖️ Balanza Marcy y Lab (6)' },
  { id: 'tamices', label: '📐 Tamices ASTM E11 y Ro-Tap' },
  { id: 'bombeo', label: '⚙️ Bombas de Lodos y Lote 5:5:4' },
  { id: 'sello_potencia', label: '💧 Sello Seco Expeller y Cartucho 005M' },
  { id: 'clasificacion', label: '🌪️ Hidrociclones D6-D20 y Mallas TH48' },
  { id: 'filtracion', label: '🧱 Filtros Prensa, Lonas y Plate Shifter' },
  { id: 'flotacion', label: '🫧 Flotación #18 SP' }
];
---

<BaseLayout 
  title="SMAT Minerals | Equipos de Proceso, Bombas para Lodos y Spare Parts, Control de Procesos"
  description="Suministro para plantas de beneficio minero desde Almacén Central Durango: Equipos de Proceso (Flotación, Hidrociclones y Filtros Prensa), Bombas para Lodos y Spare Parts (Lotes 5-5-4, Camisa D075C21 y Bearing Assembly), y Control de Procesos (Balanzas Marcy, Filtro Batch y Tamices ASTM E11)."
  lang="es"
>
  <section class="hero-home">
    <div class="container">
      <div class="hero-badge-pill">
        <span class="live-dot" aria-hidden="true"></span>
        <span>SMAT MINERALS • ALMACÉN CENTRAL DURANGO • SUMINISTRO PARA PLANTAS DE BENEFICIO</span>
      </div>
      
      <h1>
        Bombas para Lodos y Refacciones<br/>
        <span class="hero-sub-accent">Mecanismos de Flotación, Filtros Prensa y Balanzas. Hidrociclones.</span>
      </h1>

      <div class="hero-actions">
        <a href="/cotizar/#rfq" class="btn btn-primary btn-lg">Solicitar Cotización</a>
        <a href="/bombeo/#como-se-arma-una-bomba" class="btn btn-outline btn-lg">Ver Despiece y Cómo se Arma una Bomba</a>
        <a href="/clasificacion/" class="btn btn-outline btn-lg">Hidrociclones y Balance 3 Vasos Marcy</a>
        <a href="/catalogo/" class="btn btn-outline btn-lg">Catálogo General (19 SKUs + 13 Códigos)</a>
      </div>

      <!-- Barra de 8 Chips de Filtro Rápido por Familia de Producto en el Hero (PRD §2.1) -->
      <div class="hero-family-chip-bar" role="toolbar" aria-label="Filtro rápido por familia de producto" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem;">
        {familyFilterChipsEs.map((chip, idx) => (
          <button
            type="button"
            data-family-chip={chip.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
            class={`part-chip ${idx === 0 ? 'part-chip--highlight' : ''}`}
            style="cursor: pointer;"
          >
            {chip.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ARQUITECTURA DE LAS 3 PUERTAS (DON MANUEL - PIEZA PRIMERO, CERO ROLLO) -->
  <section class="equipment-showcase-section" aria-label="Las Tres Puertas de Suministro SMAT">
    <div class="container">
      <div class="showcase-header">
        <span class="section-eyebrow">SELECCIÓN DIRECTA DE PIEZA Y EQUIPO • DIAGRAMAS CAD RAYOS X</span>
        <h2>Seleccione su Pieza o Área de Suministro en Planta</h2>
      </div>

      <div class="showcase-grid">
        <!-- PUERTA 1: BOMBAS PARA LODOS Y SPARE PARTS (AVENIDA 1 · TAM 17.5M–22.0M USD) -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Puerta 1 • Bombeo de Lodos y Refacciones</span>
            <span class="showcase-series">1.5x1" a 14x12" • 13 Códigos</span>
          </div>
          <h3>Bombas para Lodos y Spare Parts</h3>
          <TechnicalDiagrams diagram="pump" lang="es" compact={true} />
          <p class="door-concise-summary">
            Lotes 5-5-4 en Alto Cromo (≥650 HB), Hule, Poliuretano y SiC + Camisa D075C21 y Bearing Assembly.
          </p>
          <div class="part-chip-strip" aria-label="Selección directa de refacción de bomba">
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=lote_554&material=alto_cromo_cr27#rfq" class="part-chip part-chip--highlight">Lote 5-5-4</a>
            <a href="/cotizar/?equipo=impulsor_bomba&pieza=impulsor_5_alabes&material=alto_cromo_cr27#rfq" class="part-chip">Impulsor 5 Álabes</a>
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=voluta_liners&material=alto_cromo_cr27#rfq" class="part-chip">Voluta Cr27%</a>
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=voluta_liners&material=hule_natural#rfq" class="part-chip">Liners Hule / PU</a>
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=throatbush&material=alto_cromo_cr27#rfq" class="part-chip">Throatbush</a>
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=fpl_insert&material=alto_cromo_cr27#rfq" class="part-chip">FPL Insert</a>
            <a href="/catalogo/D075C21/" class="part-chip part-chip--highlight">Camisa D075C21</a>
            <a href="/cotizar/?equipo=sello_expulsor&pieza=expeller_sello#rfq" class="part-chip">Expeller Seco</a>
            <a href="/cotizar/?equipo=soporte_rodamiento&pieza=bearing_assembly#rfq" class="part-chip">Bearing Assembly</a>
            <a href="/cotizar/?equipo=skid_bomba#rfq" class="part-chip">Tren Motriz CV/ZVZ</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Materiales:</span>
              <span class="ks-val">Alto Cromo (≥650 HB), Hule, Poliuretano y Cerámica SiC</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Lote Húmedo:</span>
              <span class="ks-val">5 Impulsores + 5 Cuellos + 4 Volutas</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Reporte Despiece:</span>
              <span class="ks-val">
                <a href="/bombeo/#como-se-arma-una-bomba" class="inline-spec-link">Cómo se arma una bomba (14 piezas) →</a>
              </span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/bombeo/" class="showcase-cta-primary">Ver Piezas y Despiece →</a>
            <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=lote_554#rfq" class="showcase-cta-secondary">Cotizar Lote 5-5-4</a>
          </div>
        </article>

        <!-- PUERTA 2: HIDROCICLONES, PAQUETES CASADOS Y MALLAS DE URETANO (AVENIDAS 2 Y 3) -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Puerta 2 • Clasificación y Cribado Fino</span>
            <span class="showcase-series">D6–D20 • TH48-30 • 1'x1'</span>
          </div>
          <h3>Hidrociclones y Mallas de Uretano</h3>
          <TechnicalDiagrams diagram="cyclone_d6_d20" lang="es" compact={true} />
          <p class="door-concise-summary">
            Hidrociclones D6–D20 (Apex SiC y Vortex Finder), Paquete Casado Bomba + Ciclón y Mallas de Uretano TH48-30 / 1'x1'.
          </p>
          <div class="part-chip-strip" aria-label="Selección rápida de Clasificación y Cribado">
            <a href="/clasificacion/" class="part-chip part-chip--highlight">Hidrociclones D6–D20 (Apex y Vortex)</a>
            <a href="/productos/paquete-casado-bomba-hidrociclon/" class="part-chip part-chip--highlight">Paquete Casado Bomba + Ciclón</a>
            <a href="/productos/mallas-finas-uretano-th48-30/" class="part-chip">Mallas Finas TH48-30</a>
            <a href="/productos/modulos-poliuretano-1x1-pin-camisa/" class="part-chip">Módulos Poliuretano 1'x1'</a>
            <a href="/clasificacion/#marcy-3cup-workbench" class="part-chip">Balance 3 Vasos Marcy (Plitt d50c)</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Hidrociclones:</span>
              <span class="ks-val">
                <a href="/clasificacion/" class="inline-spec-link">Serie D6, D10, D10B, D15 y D20 (5 Zonas) →</a>
              </span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Mallas Uretano:</span>
              <span class="ks-val">Serie TH48-30 y Paneles 1'x1' (Weibull α ≥ 4.2)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Acople Hidráulico:</span>
              <span class="ks-val">4x3 + D10 • 6x4 + D15 • 8x6 + D20 (10–12 psi)</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/clasificacion/" class="showcase-cta-primary">Ver Hidrociclones y Mallas →</a>
            <a href="/productos/paquete-casado-bomba-hidrociclon/" class="showcase-cta-secondary">Cotizar Paquete Casado</a>
          </div>
        </article>

        <!-- PUERTA 3: MECANISMOS DE FLOTACIÓN, FILTROS PRENSA Y CONTROL DE PROCESOS (AVENIDAS 4, 5 Y 6A) -->
        <article class="showcase-card">
          <div class="showcase-card-top">
            <span class="showcase-tag">Puerta 3 • Flotación, Filtración y Lab</span>
            <span class="showcase-series">50–300 ft³ • 16 bar • SG 2.2–4.4</span>
          </div>
          <h3>Mecanismos de Flotación, Filtros Prensa y Control</h3>
          <TechnicalDiagrams diagram="flotation" lang="es" compact={true} />
          <p class="door-concise-summary">
            Mecanismos Suspendidos de Flotación (18 SP, 24, 30), Filtros Prensa (800–1500 mm, Lonas y Plate Shifter), Balanza Marcy y Tamices ASTM E11.
          </p>
          <div class="part-chip-strip" aria-label="Selección rápida de Flotación, Filtración e Instrumentación">
            <a href="/cotizar/?circuito=flotacion&equipo=celda_flotacion#rfq" class="part-chip part-chip--highlight">Mecanismo Flotación 18 SP / 24 / 30</a>
            <a href="/cotizar/?circuito=filtracion&equipo=filtro_prensa#rfq" class="part-chip">Placas PP, Lonas y Plate Shifter (16 bar)</a>
            <a href="/cotizar/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="part-chip part-chip--highlight">Balanza Marcy + Vaso 1000 cm³</a>
            <a href="/cotizar/?circuito=control_procesos&equipo=filtro_batch_lab#rfq" class="part-chip">Filtro Presión Batch (100 psi)</a>
            <a href="/cotizar/?circuito=control_procesos&equipo=tamices_astm_e11#rfq" class="part-chip">Tamices ASTM E11 y Ro-Tap</a>
            <a href="/equipos/" class="part-chip">Equipos de Proceso</a>
          </div>
          <div class="pro-keyspecs-box">
            <div class="keyspec-row">
              <span class="ks-label">Flotación Drop-In:</span>
              <span class="ks-val">50 a 300 ft³ • Rougher, Cleaner y Scavenger (Rotor/Difusor sin Obra Civil)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Filtros Prensa:</span>
              <span class="ks-val">800 a 1500 mm (16 bar • NOM-141 • Corre-Placas)</span>
            </div>
            <div class="keyspec-row">
              <span class="ks-label">Laboratorio:</span>
              <span class="ks-val">Balanza Marcy (1000 cm³), Tamices ASTM E11 y Plato Tentadura</span>
            </div>
          </div>
          <div class="showcase-links">
            <a href="/control-de-procesos/" class="showcase-cta-primary">Ver Equipos y Laboratorio →</a>
            <a href="/cotizar/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="showcase-cta-secondary">Cotizar Equipo</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CATÁLOGO RÁPIDO DE LOS 19 SKUS EN CAJA RÁPIDA (MVP V3.0 • D1, D2, D3, D4, D6) -->
  <section class="quick-sku-home-section" id="home-quick-checkout-catalog" aria-label="19 SKUs de Configuración Rápida">
    <div class="container">
      <div class="showcase-header" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="section-eyebrow">CONFIGURACIÓN RÁPIDA EN 1 CLIC • ESCALA FÍSICA ISO/IEC 7810 (0.76 MM) • BANDEJA MULTI-ÍTEM (c·μ)</span>
          <h2>19 SKUs Críticos de Planta y 13 Fichas Atómicas Verificadas</h2>
        </div>
        <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
          <a href="/catalogo/d075c21/" class="part-chip part-chip--highlight">Ver Ficha D075C21 (Camisa de Flecha) →</a>
          <a href="/clasificacion/" class="part-chip part-chip--highlight">Abrir Simulador de Hidrociclones →</a>
        </div>
      </div>

      <!-- Verificador Instantáneo Cero-OEM de Equivalencia Drop-In (Anti-Luis • D3 · Solar Light-First) -->
      <div id="workbench" class="dropin-verifier-box" data-dropin-verifier style="margin-bottom: 1.5rem; padding: 1rem 1.25rem; border-radius: 10px; background: #f8fafc; color: #0f172a; border: 1.5px solid #cbd5e1; border-left: 4px solid #7c2d12; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between;">
        <p style="margin: 0; font-size: 0.82rem; color: #334155;">
          <strong style="font-family: var(--smat-font-mono); font-size: 0.78rem; color: #7c2d12; display: block;">
            🔎 VERIFICADOR INSTANTÁNEO DE EQUIVALENCIA GEOMÉTRICA DROP-IN (ISO 2768-m)
          </strong>
          Ingresa el código fundido en tu pieza actual (ej. <code>E4147A05</code>, <code>D075C21</code>, <code>E4083</code>, <code>TH48-30</code>):
        </p>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
          <input
            type="text"
            data-dropin-input
            placeholder="Ej. E4147A05 o D075C21"
            aria-label="Código de parte para verificar equivalencia Drop-In"
            style="padding: 0.5rem 0.75rem; border-radius: 6px; border: 1px solid #94a3b8; background: #ffffff; color: #0f172a; font-family: var(--smat-font-mono); font-size: 0.85rem;"
          />
          <button
            type="button"
            data-dropin-btn
            class="part-chip part-chip--highlight"
            style="cursor: pointer;"
          >
            Verificar Tripleta (A,B,C) →
          </button>
        </div>
        <p data-dropin-result style="width: 100%; margin: 0.35rem 0 0; font-family: var(--smat-font-mono); font-size: 0.78rem; color: #065f46; display: none;"></p>
      </div>

      <div class="quick-sku-grid">
        {quickCatalog.map((item) => {
          const cleanRfqHref = item.atomic_codes.length > 0
            ? `/cotizar/?sku=${encodeURIComponent(item.id)}&codigo=${encodeURIComponent(item.atomic_codes[0])}#rfq`
            : `/cotizar/?sku=${encodeURIComponent(item.id)}#rfq`;
          return (
            <article
              class="quick-sku-card"
              data-sku-family={item.vertical}
              data-sku-id={item.id}
            >
              <div class="quick-sku-top">
                <span class="quick-sku-id">{item.id} · {item.stock_regime === 'se_fabrica' ? '🔵 SE FABRICA' : item.stock_regime === 'se_pide' ? '🟡 SE PIDE' : '🟢 HAY'}</span>
                {item.atomic_codes.length > 0 && (
                  <span class="quick-sku-atomic">{item.atomic_codes.join(' · ')}</span>
                )}
              </div>
              <h3 class="quick-sku-title">
                <a href={`/productos/${item.slug_es}/`}>{item.title_es}</a>
              </h3>
              <ProductQuickCard sku={item} lang="es" />
              <div class="quick-sku-actions" style="margin-top: 0.75rem;">
                <a href={`/productos/${item.slug_es}/`} class="part-chip part-chip--highlight">Ver Ficha Completa y Rayos X →</a>
                <a href={cleanRfqHref} class="part-chip">+ Dossier RFQ</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <script>
    import { verifyDropInEquivalence } from '../scripts/dropInEquivalenceGuard.js';
    function matchesFamilyFilter(skuId: string, vertical: string, filterId: string): boolean {
      if (!filterId || filterId === 'all') return true;
      if (filterId === 'tamices') return skuId === 'SMAT-LAB-TAMIZ-E11' || skuId === 'SMAT-LAB-ROTAP-MECH';
      if (filterId === 'sello_potencia') return skuId === 'SMAT-PUMP-EXPELLER-KIT' || skuId === 'SMAT-PUMP-BRG-005M';
      return vertical === filterId;
    }
    function bindDropInVerifier() {
      const chips = document.querySelectorAll('[data-family-chip]');
      const skuCards = document.querySelectorAll('[data-sku-family]');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const filterId = chip.getAttribute('data-family-chip') || 'all';
          chips.forEach((c) => {
            const active = c.getAttribute('data-family-chip') === filterId;
            c.setAttribute('aria-pressed', active ? 'true' : 'false');
            c.classList.toggle('part-chip--highlight', active);
          });
          skuCards.forEach((card) => {
            const skuId = card.getAttribute('data-sku-id') || '';
            const vertical = card.getAttribute('data-sku-family') || '';
            const visible = matchesFamilyFilter(skuId, vertical, filterId);
            if (card instanceof HTMLElement) {
              card.style.display = visible ? '' : 'none';
            }
          });
          const catalogSection = document.getElementById('home-quick-checkout-catalog');
          catalogSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      const box = document.querySelector('[data-dropin-verifier]');
      if (!box) return;
      const input = box.querySelector('[data-dropin-input]') as HTMLInputElement | null;
      const btn = box.querySelector('[data-dropin-btn]');
      const out = box.querySelector('[data-dropin-result]') as HTMLElement | null;
      const run = () => {
        if (!input || !out) return;
        const res = verifyDropInEquivalence(input.value);
        out.style.display = 'block';
        if (res.matched && res.geometricTripletMm) {
          out.innerHTML = `✅ MATCH DROP-IN: <strong>${res.canonicalSkuId}</strong> (${res.titleEs}) | Aleación: <strong>${res.alloyCode}</strong> | ${res.geometricTripletMm.label_es} (${res.toleranceStd}) · <a href="/productos/${res.slugEs}/" style="color:#b45309;text-decoration:underline;">Abrir Ficha →</a>`;
        } else {
          out.innerHTML = `ℹ️ ${res.reasonEs}`;
        }
      };
      btn?.addEventListener('click', run);
      input?.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter') run();
      });
      const params = new URLSearchParams(window.location.search);
      const urlSku = params.get('sku');
      if (urlSku && input) {
        input.value = urlSku;
        run();
      }
    }
    bindDropInVerifier();
    document.addEventListener('astro:page-load', bindDropInVerifier);
  </script>

  <TrustMatrix lang="es" hideBoundaries={true} />
</BaseLayout>

<style>
  .hero-home {
    background-color: var(--smat-bg-canvas);
    color: var(--smat-text-primary);
    padding: 3rem 0 2.25rem;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid var(--smat-border-strong);
    color: var(--smat-text-secondary);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-family: var(--smat-font-mono);
    margin-bottom: 1.15rem;
    box-shadow: var(--smat-shadow-xs);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background-color: var(--smat-emerald-stock);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);
  }

  .hero-home h1 {
    color: var(--smat-text-primary);
    font-size: clamp(2rem, 3.5vw, 2.9rem);
    max-width: 880px;
    margin-bottom: 0.85rem;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .hero-sub-accent {
    color: var(--smat-copper-accent);
    display: inline-block;
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    margin-top: 0.2rem;
  }

  .door-concise-summary {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--smat-text-primary);
    margin: 0.4rem 0 0.65rem 0;
    line-height: 1.35;
  }

  .part-chip-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    margin-bottom: 0.85rem;
  }

  .part-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.26rem 0.58rem;
    border-radius: 5px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #0f172a;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.12s ease, background 0.12s ease;
  }

  .part-chip:hover {
    border-color: #0c4a6e;
    background: #f0f9ff;
    color: #0c4a6e;
  }

  .part-chip--highlight {
    background: #eff6ff;
    border-color: #0284c7;
    color: #0c4a6e;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn-lg {
    padding: 0.85rem 1.75rem;
    font-size: 0.95rem;
  }

  .equipment-showcase-section {
    padding: var(--smat-space-2xl, 80px) 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .showcase-header {
    margin-bottom: var(--smat-space-lg, 32px);
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--smat-font-mono);
