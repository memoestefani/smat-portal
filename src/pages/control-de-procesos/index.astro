---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProcessControlIsland from '../../components/islands/ProcessControlIsland.astro';

const title = 'Control de Procesos e Instrumentación Metalúrgica | SMAT Minerals';
const description = 'Instrumentación metalúrgica de planta y laboratorio: Balanzas de Densidad de Pulpa y % de Sólidos (Tipo Marcy, vaso 1000 cm³, 12 carátulas SG 2.2–4.4), Filtro de Presión Batch de Laboratorio (60–100 psi) y Tamices Certificados ASTM E11 / ISO 3310.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/control-de-procesos/"
  alternateEsPath="/control-de-procesos/"
  alternateEnPath="/en/process-control/"
>
  <ProcessControlIsland locale="es" mode="standalone" />
</BaseLayout>
