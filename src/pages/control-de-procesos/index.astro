---
// src/pages/control-de-procesos/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import CircuitNavigator from '../../components/CircuitNavigator.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
---

<BaseLayout
  title="Control de Procesos e Instrumentación Metalúrgica | SMAT Minerals"
  description="Instrumentación metalúrgica de planta y laboratorio: Balanzas de Densidad de Pulpa y % de Sólidos (Tipo Marcy, vaso 1000 cm³, 12 carátulas SG 2.2–4.4), Filtro de Presión Batch de Laboratorio (60–100 psi) y Tamices Certificados ASTM E11 / ISO 3310."
  lang="es"
  canonicalPath="/control-de-procesos/"
  alternateEsPath="/control-de-procesos/"
  alternateEnPath="/en/process-control/"
>
  <section class="page-hero">
    <div class="container">
      <span class="badge badge-copper">PUERTA 3 • CONTROL METALÚRGICO Y LABORATORIO</span>
      <h1>Control de Procesos</h1>
      <p style="font-size: 1.06rem; max-width: 780px; color: var(--smat-text-secondary);">
        Instrumentación de medición directa para control de molienda, clasificación, flotación y desaguado: <strong>Balanzas de Densidad de Pulpa y % de Sólidos (Tipo Marcy)</strong>, <strong>Filtro de Presión Batch de Laboratorio SMAT (60–100 psi)</strong> y <strong>Tamices de Laboratorio Certificados ASTM E11 / ISO 3310 (5" a Malla #635)</strong>.
      </p>
      <div style="display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.25rem;">
        <a href="/cotizar/?circuito=control_procesos#rfq" class="btn btn-primary" data-ctrl-quote-link>Cotizar Instrumentación de Control →</a>
        <a href="#metrology-calculator" class="btn btn-outline">Calculadora Marcy, Gy y Serie √2 ASTM ↓</a>
      </div>
    </div>
  </section>

  <section class="section" id="stage-diagnostic">
    <div class="container">
      <!-- Segmented Control Apple HIG: 1 Instrumento Activo a la Vez -->
      <div class="metrology-segmented-bar" role="tablist" aria-label="Estaciones del Banco Metrológico (1 Instrumento Activo a la Vez)">
        <button type="button" role="tab" aria-selected="true" class="metrology-seg-btn is-active" data-met-station-tab="1">
          1. Balanza Marcy
        </button>
        <button type="button" role="tab" aria-selected="false" class="metrology-seg-btn" data-met-station-tab="2">
          2. Filtro Prensa Lab + Pierre Gy
        </button>
        <button type="button" role="tab" aria-selected="false" class="metrology-seg-btn" data-met-station-tab="3">
          3. Tamices ASTM E11
        </button>
      </div>

      <div class="control-equipment-grid">
        <!-- Instrumento 1: Balanza Marcy -->
        <article id="balanza-marcy" class="card control-block" data-instrument-card="1">
          <div class="control-block-header">
            <span class="badge badge-copper">DENSIDAD DE PULPA Y % DE SÓLIDOS • VASO 1000 CM³</span>
            <h2>Balanza de Densidad de Pulpa y % de Sólidos (Tipo Marcy)</h2>
            <p style="color: var(--smat-text-secondary);">
              Balanza colgante de lectura directa para determinación inmediata en piso de planta de peso neto de pulpa, gravedad específica de pulpa (kg/L) y porcentaje de sólidos en peso (%Cw) sin tablas manuales ni cálculos intermedios.
            </p>
          </div>
          <TechnicalDiagrams diagram="marcy" lang="es" />
          <div class="specs-strip">
            <div><strong>Recipiente Calibrado:</strong> 1000 cm³ en Acero Inoxidable 304 o Acrílico transparente con orificios de rebose</div>
            <div><strong>12 Anillos Intercambiables:</strong> Gravedad específica de mineral seco desde SG 2.2 hasta SG 4.4</div>
            <div><strong>Puntos de Control:</strong> Descarga de molino, rebose de hidrociclones, alimentación a flotación y espesadores</div>
          </div>
          <div class="control-actions">
            <a href="/cotizar/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="btn btn-primary">Cotizar Balanza Marcy →</a>
            <a href="#metrology-calculator" class="btn btn-outline" data-open-station="1">Simular Carátula Marcy</a>
          </div>
        </article>

        <!-- Instrumento 2: Filtro de Presión Batch de Laboratorio -->
        <article id="filtro-batch" class="card control-block" data-instrument-card="2" style="display:none">
          <div class="control-block-header">
            <span class="badge badge-copper">PRUEBAS METALÚRGICAS DE DESAGUADO • 60 A 100 PSI</span>
            <h2>Filtro de Presión Batch de Laboratorio SMAT</h2>
            <p style="color: var(--smat-text-secondary);">
              Unidad vertical de filtración a presión para secado rápido de muestras de concentrado, determinación de humedad residual de torta y curvas de velocidad de filtración antes de escalar a filtros prensa industriales.
            </p>
          </div>
          <TechnicalDiagrams diagram="batch_filter" lang="es" />
          <div class="specs-strip">
            <div><strong>Cámara y Bastidor:</strong> Cilindro vertical de acero pesado o acero inoxidable con barras guía verticales</div>
            <div><strong>Cierre y Sellado:</strong> Husillo superior de rosca trapezoidal con maneral en T y empaque anular</div>
            <div><strong>Operación Neumática:</strong> Entrada superior con manómetro, válvula de alivio y regulador para 60 a 100 psi</div>
          </div>
          <div class="control-actions">
            <a href="/cotizar/?circuito=control_procesos&equipo=filtro_batch_lab#rfq" class="btn btn-primary">Cotizar Filtro Batch de Laboratorio →</a>
            <a href="#metrology-calculator" class="btn btn-outline" data-open-station="2">Simular Ciclos Batch y Masa Pierre Gy</a>
          </div>
        </article>

        <!-- Instrumento 3: Tamices Certificados ASTM E11 / ISO 3310 -->
        <article id="tamices-astm" class="card control-block" data-instrument-card="3" style="display:none">
          <div class="control-block-header">
            <span class="badge badge-copper">GRANULOMETRÍA DE CORTE D80 / P80 • ASTM E11 / ISO 3310</span>
            <h2>Tamices de Laboratorio Certificados ASTM E11 / ISO 3310 y Tamizadores</h2>
            <p style="color: var(--smat-text-secondary);">
              Tamices de prueba con malla tejida de precisión y marco embutido sin costuras en <strong>Bronce</strong> y <strong>Acero Inoxidable</strong> (diámetros de 8" y 12", altura completa o media altura) para control de corte $P_{80}$ en hidrociclones y balance metalúrgico por mallas.
            </p>
          </div>
          <TechnicalDiagrams diagram="sieves" lang="es" />
          <div class="specs-strip">
            <div><strong>Rango de Aberturas:</strong> Desde 5" (125 mm) hasta malla #635 (20 µm) en serie Tyler / ASTM √2</div>
            <div><strong>Configuración de Marco:</strong> 8" (203 mm) y 12" (305 mm) en Acero Inoxidable 304/316 o Bronce, con tapa y cazuela receptora</div>
            <div><strong>Equipos Complementarios:</strong> Tamizadores mecánicos Ro-Tap / electromagnéticos y cuarteadores Riffle</div>
          </div>
          <div class="control-actions">
            <a href="/cotizar/?circuito=control_procesos&equipo=tamices_laboratorio#rfq" class="btn btn-primary">Cotizar Batería de Tamices ASTM →</a>
            <a href="#metrology-calculator" class="btn btn-outline" data-open-station="3">Calcular Serie √2 y Rosin-Rammler</a>
          </div>
        </article>
      </div>

      <!-- CALCULADORA INTERACTIVA DE METROLOGÍA METALÚRGICA (1 Estación Activa a la Vez) -->
      <div id="metrology-calculator" class="card metrology-calc-card" style="margin-top: 2.5rem;">
        <div class="metrology-calc-header">
          <span class="badge badge-copper">HERRAMIENTA DE CONTROL METALÚRGICO EN PLANTA</span>
          <h2>Simulador de Carátula Marcy, Filtro Prensa Lab (Pierre Gy) y Serie √2 ASTM E11</h2>
          <p style="color: var(--smat-text-secondary); margin: 0;">
            Seleccione la estación activa del banco metrológico para calibrar densidad de pulpa ($S_s$, $C_w$), masa mínima de muestreo y ciclos de filtración (Pierre Gy), o la serie de 7 tamices ASTM E11 ($P_{80}$, Rosin-Rammler $y'$).
          </p>
        </div>

        <div class="metrology-stations-stack">
          <details class="metrology-station-accordion" data-station-accordion="1" open>
            <summary class="metrology-station-summary">
              <span><strong>1. Balanza Marcy:</strong> Gravedad Específica del Mineral Seco ($S_s$) y % Sólidos ($C_w$)</span>
              <span class="metrology-station-tag">ESTACIÓN 01 • ACTIVA</span>
            </summary>
            <div class="metrology-inputs-grid">
              <label class="metrology-field">
                <span>Gravedad Específica del Mineral Seco ($S_s$):</span>
                <input type="number" id="met-sg-input" min="2.2" max="4.4" step="0.1" value="2.8" />
              </label>
              <label class="metrology-field">
                <span>Porcentaje de Sólidos en Peso ($C_w$ %):</span>
                <input type="number" id="met-cw-input" min="5" max="80" step="1" value="50" />
              </label>
              <label class="metrology-field">
                <span>Densidad de Pulpa Medida ($\rho_p$ kg/L — Bidireccional):</span>
                <input type="number" id="met-rhop-input" min="1.05" max="2.60" step="0.005" value="1.474" />
              </label>
            </div>
            <div class="metrology-result-box">
              <span class="met-res-label">Lectura en Vaso Marcy (1000 cm³) y Auditoría de Sesgo de Anillo</span>
              <strong id="met-res-marcy-main" class="met-res-value">1474 g netos • ρp = 1.474 kg/L</strong>
              <small id="met-res-marcy-sub">Anillo recomendado: SG 2.8 (Rango 2.2 a 4.4)</small>
              <small id="met-res-marcy-bias" style="color: #082f49; font-weight: 700;">Sólidos secos en vaso: 737 g • Cw aparente en anillo: 50.0% (Sesgo ΔC_bias = 0.0 pts) • Vaso Acero Inox 304 (1000 cm³)</small>
            </div>
          </details>

          <details class="metrology-station-accordion" data-station-accordion="2">
            <summary class="metrology-station-summary">
              <span><strong>2. Filtro Prensa Lab + Pierre Gy:</strong> Masa Mínima de Muestra ($M_s$) y Ciclos Batch (60–100 psi)</span>
              <span class="metrology-station-tag">ESTACIÓN 02 ▾</span>
            </summary>
            <div class="metrology-inputs-grid">
              <label class="metrology-field">
                <span>Presión Neumática de Filtración Batch (psi):</span>
                <select id="met-gy-pressure-select">
                  <option value="70">60–80 psi (Concentrados Estándar)</option>
                  <option value="90" selected>80–100 psi (Finos / Lamas Arcillosas)</option>
                </select>
              </label>
              <label class="metrology-field">
                <span>Tamaño Máximo $d_{95}$ de Partícula (mm):</span>
                <input type="number" id="met-gy-d95-input" min="0.04" max="25.0" step="0.01" value="0.105" />
              </label>
              <label class="metrology-field">
                <span>Tamaño de Liberación Mineralógica dₗ (µm):</span>
                <input type="number" id="met-gy-lib-input" min="10" max="1000" step="5" value="100" />
              </label>
              <label class="metrology-field">
                <span>Ley Mineral Decimal ($a_L$ — 0.005 a 0.60):</span>
                <input type="number" id="met-gy-grade-input" min="0.001" max="0.80" step="0.005" value="0.05" />
              </label>
              <label class="metrology-field">
                <span>Constante Mineralógica de Pierre Gy $c$ (g/cm³):</span>
                <input type="number" id="met-gy-c-input" min="0.5" max="15.0" step="0.1" value="4.0" />
              </label>
              <label class="metrology-field">
                <span>Error Estándar Relativo Objetivo (s_FSE):</span>
                <select id="met-gy-error-select">
                  <option value="0.01">±1.0% (Balance Metalúrgico Conciliado)</option>
                  <option value="0.025">±2.5% (Control de Turno Molienda)</option>
                  <option value="0.05" selected>±5.0% (Muestreo Operativo Rápido)</option>
                </select>
              </label>
            </div>
            <div class="metrology-result-box">
              <span class="met-res-label">Masa Mínima de Muestra (Pierre Gy) y Ciclos Filtro Lab</span>
              <strong id="met-res-gy-main" class="met-res-value">250 g secos (Tamizado en Húmedo + Seco)</strong>
              <small id="met-res-gy-sub">Factor de forma f = 0.50, granulometría g = 0.25</small>
            </div>
          </details>

          <details class="metrology-station-accordion" data-station-accordion="3">
            <summary class="metrology-station-summary">
              <span><strong>3. Tamices ASTM E11:</strong> Corte $P_{80}$ Objetivo, Serie √2 y Linealización Rosin-Rammler ($y'$)</span>
              <span class="metrology-station-tag">ESTACIÓN 03 ▾</span>
            </summary>
            <div class="metrology-inputs-grid">
              <label class="metrology-field">
                <span>Corte $P_{80}$ Objetivo de Molienda (µm):</span>
                <input type="number" id="met-p80-input" min="25" max="2000" step="5" value="75" />
              </label>
              <label class="metrology-field">
                <span>Módulo de Uniformidad Rosin-Rammler ($n$):</span>
                <input type="number" id="met-rr-n-input" min="0.60" max="2.20" step="0.05" value="1.25" />
              </label>
              <label class="metrology-field">
                <span>Material de Marco de Tamiz Preferido:</span>
                <select id="met-frame-select">
                  <option value="Acero Inoxidable 8&quot; (Altura Completa)">Acero Inoxidable 8" (Altura Completa)</option>
                  <option value="Acero Inoxidable 8&quot; (Media Altura)">Acero Inoxidable 8" (Media Altura)</option>
                  <option value="Bronce y Acero Inox 8&quot;">Combinación Bronce / Acero Inox 8"</option>
                  <option value="Acero Inoxidable 12&quot;">Acero Inoxidable 12"</option>
                </select>
              </label>
              <label class="metrology-field">
                <span>Régimen de Tamizado de Laboratorio:</span>
                <select id="met-screening-mode">
                  <option value="auto" selected>Automático (Húmedo ≤150 µm / Seco &gt;150 µm)</option>
                  <option value="wet">Tamizado en Húmedo + Seco (Deslamado #400)</option>
                  <option value="dry">Tamizado en Seco (Ro-Tap Estándar)</option>
                </select>
              </label>
            </div>
            <div class="metrology-result-box">
              <span class="met-res-label">Batería Recomendada ASTM E11 (Serie √2 + Rosin-Rammler)</span>
              <strong id="met-res-sieves-main" class="met-res-value">#70, #100, #140, #200, #270, #325, #400</strong>
              <small id="met-res-sieves-sub">Incluye Tapa y Cazuela • y' = -0.1555 (n = 1.25)</small>
              <div style="overflow-x:auto; margin-top:0.75rem;">
                <table id="met-sieve-stack-table" class="metrology-sieve-table" style="width:100%; border-collapse:collapse; font-size:0.78rem;">
                  <thead>
                    <tr style="border-bottom:1.5px solid #cbd5e1; text-align:left;">
                      <th style="padding:0.35rem 0.5rem;">Malla ASTM (Tyler)</th>
                      <th style="padding:0.35rem 0.5rem;">Abertura (µm)</th>
                      <th style="padding:0.35rem 0.5rem;">% Ret. Indiv.</th>
                      <th style="padding:0.35rem 0.5rem;">% Ret. Acum.</th>
                      <th style="padding:0.35rem 0.5rem;">% Pasante Acum.</th>
                      <th style="padding:0.35rem 0.5rem;">Masa Ret. (g) / Rol</th>
                    </tr>
                  </thead>
                  <tbody id="met-sieve-stack-tbody"></tbody>
                </table>
              </div>
            </div>
          </details>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light);">
          <span id="met-summary-code" style="font-family: var(--smat-font-mono); font-size: 0.85rem; color: var(--smat-text-secondary);">
            Especificación lista para cotizador: <strong>SMAT-CTRL-MARCY-1000 / SMAT-CTRL-SIEVE-ASTM</strong>
          </span>
          <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
            <a id="met-pump-precal-cta" href="/cotizar/?circuito=bombeo&flow=220&solids=50&d80=75&sg=2.8#rfq" class="btn btn-outline">
              Pre-calibrar Bomba con esta Pulpa →
            </a>
            <a id="met-quote-cta" href="/cotizar/?circuito=control_procesos&equipo=balanza_marcy#rfq" class="btn btn-primary">
              Enviar Cédula Metrológica al Cotizador →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="stage-2" style="padding-top: 0;">
    <div class="container">
      <SharePurchasing
        roleTitle="Paquete de Instrumentación de Control de Procesos (Balanza Marcy + Filtro Batch + Tamices ASTM E11)"
        specs="Balanza Marcy vaso 1000 cm³ (12 anillos SG 2.2-4.4), Filtro de Presión Batch 100 psi y Batería de Tamices ASTM E11"
        metallurgy="Acero Inoxidable 304 / 316 y Bronce sin costuras"
        series="Control Metalúrgico SMAT"
        roleId="balanza_marcy"
        circuit="control_procesos"
        lang="es"
      />
    </div>
  </section>

  <section class="section" style="background-color: #ffffff; border-top: 1px solid var(--smat-border-light); border-bottom: 1px solid var(--smat-border-light);">
    <div class="container">
      <CircuitNavigator lang="es" />
    </div>
  </section>
</BaseLayout>

<script>
  import {
    calculateMarcyScaleReading,
    calculateGyMinimumSampleMass,
    recommendAstmSieveSeries
  } from '../../scripts/slurryEngine.js';
  import { saveWorkbenchState, loadWorkbenchState } from '../../scripts/workbenchBus.js';

  function updateMetrologyCalculator(evt?: Event) {
    const sgEl = document.getElementById('met-sg-input') as HTMLInputElement | null;
    const cwEl = document.getElementById('met-cw-input') as HTMLInputElement | null;
    const rhopEl = document.getElementById('met-rhop-input') as HTMLInputElement | null;
    const p80El = document.getElementById('met-p80-input') as HTMLInputElement | null;
    const rrNEl = document.getElementById('met-rr-n-input') as HTMLInputElement | null;
    const frameEl = document.getElementById('met-frame-select') as HTMLSelectElement | null;
    const pressureEl = document.getElementById('met-gy-pressure-select') as HTMLSelectElement | null;
    const d95El = document.getElementById('met-gy-d95-input') as HTMLInputElement | null;
    const libEl = document.getElementById('met-gy-lib-input') as HTMLInputElement | null;
    const gradeEl = document.getElementById('met-gy-grade-input') as HTMLInputElement | null;
    const gyCEl = document.getElementById('met-gy-c-input') as HTMLInputElement | null;
    const gyErrEl = document.getElementById('met-gy-error-select') as HTMLSelectElement | null;
    const modeEl = document.getElementById('met-screening-mode') as HTMLSelectElement | null;
    const sieveTbody = document.getElementById('met-sieve-stack-tbody');

    if (!sgEl || !cwEl || !p80El || !frameEl) return;

    const sg = parseFloat(sgEl.value) || 2.8;
    const targetId = (evt && (evt.target as HTMLElement)?.id) || '';
    let marcy = calculateMarcyScaleReading({ solidsSpecificGravity: sg, solidsWeightPercent: parseFloat(cwEl.value) || 50 });
    if (targetId === 'met-rhop-input' && rhopEl) {
      const rhopVal = parseFloat(rhopEl.value) || 1.474;
      marcy = calculateMarcyScaleReading({ solidsSpecificGravity: sg, pulpDensityKgL: rhopVal, solveFor: 'ore_density_rhop' });
      cwEl.value = String(Math.round(marcy.solidsWeightPercent));
    } else if (rhopEl && document.activeElement !== rhopEl) {
      rhopEl.value = marcy.pulpDensityKgL.toFixed(3);
    }
    const cw = marcy.solidsWeightPercent;
    const p80 = parseFloat(p80El.value) || 75;
    const frame = frameEl.value;

    // Si el usuario cambió P80, actualizar sugerencia de d95 a menos que esté editando d95 directamente
    if (targetId === 'met-p80-input' && d95El) {
      d95El.value = ((p80 * 1.4) / 1000).toFixed(3);
    }

    const topSizeD95Mm = d95El ? (parseFloat(d95El.value) || (p80 * 1.4) / 1000) : (p80 * 1.4) / 1000;
    const liberationSizeMicrons = libEl ? (parseFloat(libEl.value) || 100) : 100;
    const oreGradeDecimal = gradeEl ? (parseFloat(gradeEl.value) || 0.05) : 0.05;
    const samplingConstantC = gyCEl && targetId === 'met-gy-c-input' ? (parseFloat(gyCEl.value) || undefined) : undefined;
    const targetRelativeStdError = gyErrEl ? (parseFloat(gyErrEl.value) || 0.05) : 0.05;
    const airPressurePsi = pressureEl ? (parseFloat(pressureEl.value) || 90) : 90;
    const frameDiameterInches = frame.includes('12"') ? 12 : 8;
    const screeningMode = modeEl ? modeEl.value : 'auto';
    const rosinRammlerSlopeN = rrNEl && rrNEl.value ? parseFloat(rrNEl.value) : undefined;

    const gy = calculateGyMinimumSampleMass({
      topSizeD95Mm,
      liberationSizeMicrons,
      oreGradeDecimal,
      samplingConstantC,
      targetRelativeStdError,
      solidsWeightPercent: cw,
      solidsSpecificGravity: sg,
      airPressurePsi
    });
    if (gyCEl && targetId !== 'met-gy-c-input' && document.activeElement !== gyCEl) {
      gyCEl.value = String(gy.samplingConstantC);
    }
    const sieveStack = recommendAstmSieveSeries({
      targetP80Microns: p80,
      frameDiameterInches,
      screeningMode,
      rosinRammlerSlopeN
    });

    const marcyMain = document.getElementById('met-res-marcy-main');
    const marcySub = document.getElementById('met-res-marcy-sub');
    const marcyBias = document.getElementById('met-res-marcy-bias');
    const gyMain = document.getElementById('met-res-gy-main');
    const gySub = document.getElementById('met-res-gy-sub');
    const sievesMain = document.getElementById('met-res-sieves-main');
    const sievesSub = document.getElementById('met-res-sieves-sub');
    const quoteCta = document.getElementById('met-quote-cta') as HTMLAnchorElement | null;
    const pumpPrecalCta = document.getElementById('met-pump-precal-cta') as HTMLAnchorElement | null;

    const wetDryLabel = sieveStack.screeningMode === 'wet' ? 'Tamizado en Húmedo + Seco' : 'Tamizado en Seco';

    if (marcyMain) {
      marcyMain.textContent = `${marcy.cupNetMassGrams} g netos • ρp = ${marcy.pulpDensityKgL.toFixed(3)} kg/L`;
    }
    if (marcySub) {
      marcySub.textContent = `Anillo Marcy activo: SG ${marcy.recommendedRingSg.toFixed(1)} (Fracción volumétrica Cv = ${marcy.solidsVolumePercent}%)`;
    }
    if (marcyBias) {
      marcyBias.textContent = `Sólidos secos en vaso: ${marcy.drySolidsMassGramsInCup} g • Cw aparente en anillo: ${marcy.ringApparentCw}% (Sesgo ΔC_bias = ${marcy.wrongRingBiasPoints} pts) • ${marcy.recommendedContainerEs}`;
    }
    if (gyMain) {
      gyMain.textContent = `${gy.minDrySampleGrams} g secos (${wetDryLabel}) • ${gy.slurrySampleLiters} L pulpa`;
    }
    if (gySub) {
      gySub.textContent = `Masa teórica Pierre Gy: ${gy.theoreticalGyGrams} g (d95=${gy.topSizeD95Mm} mm, c=${gy.samplingConstantC}) • Filtro Batch: ${gy.batchFilterCycles} ciclo(s) a ${gy.recommendedAirPressurePsi} (${gy.estimatedCycleMinutes} min/ciclo, humedad torta ~${gy.residualCakeMoisturePct}%)`;
    }
    const meshLabels = sieveStack.sieveStackSummary;
    if (sievesMain) {
      sievesMain.textContent = meshLabels;
    }
    if (sievesSub) {
      sievesSub.textContent = `Corte central: ${sieveStack.primaryControlMesh} (${sieveStack.primaryApertureMicrons} µm) • y'=${sieveStack.rosinRammlerYPrime} (n=${sieveStack.rosinRammlerSlopeN}) • ${frame}`;
    }
    if (sieveTbody && Array.isArray(sieveStack.sieveStack)) {
      sieveTbody.innerHTML = sieveStack.sieveStack.map((s: any) => {
        const isPrimary = Boolean(s.isPrimaryP80Control || s.isPrimaryCut);
        const rowStyle = isPrimary
          ? 'background:#f0f9ff; font-weight:800; border-bottom:1px solid #cbd5e1;'
          : 'border-bottom:1px solid #e2e8f0;';
        return `<tr style="${rowStyle}" data-primary-p80="${isPrimary ? 'true' : 'false'}">
          <td style="padding:0.32rem 0.5rem;">${s.mesh} <span style="opacity:0.75;">(${s.tylerEquivalent})</span>${isPrimary ? ' • P80' : ''}</td>
          <td style="padding:0.32rem 0.5rem;">${s.apertureMicrons} µm</td>
          <td style="padding:0.32rem 0.5rem;">${s.retainedIndividualPct.toFixed(1)}%</td>
          <td style="padding:0.32rem 0.5rem;">${Number(s.cumulativeRetainedPct ?? (100 - s.cumulativePassingPct)).toFixed(1)}%</td>
          <td style="padding:0.32rem 0.5rem;">${s.cumulativePassingPct.toFixed(1)}%</td>
          <td style="padding:0.32rem 0.5rem;">${Number(s.estimatedMassRetainedGrams ?? 0).toFixed(1)} g • ${s.roleEs || ''}</td>
        </tr>`;
      }).join('');
    }

    const metrologiaStr = `Marcy SG=${marcy.recommendedRingSg.toFixed(1)} (${cw}% Cw, ρp=${marcy.pulpDensityKgL.toFixed(3)} kg/L, ΔC_bias=${marcy.wrongRingBiasPoints} pts) | Gy=${gy.minDrySampleKg} kg (d95=${gy.topSizeD95Mm} mm, c=${gy.samplingConstantC}, s=${gy.targetRelativeStdError}, ${gy.batchFilterCycles} ciclo Batch a ${gy.recommendedAirPressurePsi}) | ASTM P80=${p80} µm (${sieveStack.primaryControlMesh}, y'=${sieveStack.rosinRammlerYPrime}, n=${sieveStack.rosinRammlerSlopeN}, R_P80=${sieveStack.retainedPercentAtP80}%)`;

    if (quoteCta) {
      quoteCta.href = `/cotizar/?circuito=control_procesos&equipo=balanza_marcy&sg=${sg}&cw=${cw}&rhop=${marcy.pulpDensityKgL}&p80=${p80}&d95=${gy.topSizeD95Mm}&lib_um=${gy.liberationSizeMicrons}&grade=${gy.oreGradeDecimal}&air_psi=${gy.airPressurePsi}&gy_c=${gy.samplingConstantC}&gy_err=${gy.targetRelativeStdError}&rr_n=${sieveStack.rosinRammlerSlopeN}&ret_p80=${sieveStack.retainedPercentAtP80}&gy_kg=${gy.minDrySampleKg}&metrologia=${encodeURIComponent(metrologiaStr)}#rfq`;
    }
    if (pumpPrecalCta) {
      pumpPrecalCta.href = `/cotizar/?circuito=bombeo&flow=220&solids=${cw}&d80=${p80}&sg=${sg}&rhop=${marcy.pulpDensityKgL}&d95=${gy.topSizeD95Mm}&lib_um=${gy.liberationSizeMicrons}&grade=${gy.oreGradeDecimal}&air_psi=${gy.airPressurePsi}&gy_c=${gy.samplingConstantC}&gy_err=${gy.targetRelativeStdError}&rr_n=${sieveStack.rosinRammlerSlopeN}&ret_p80=${sieveStack.retainedPercentAtP80}&metrologia=${encodeURIComponent(metrologiaStr)}#rfq`;
    }

    const prev = loadWorkbenchState() || {};
    saveWorkbenchState({
      ...prev,
      rhop: marcy.pulpDensityKgL,
      lib_um: gy.liberationSizeMicrons,
      grade: gy.oreGradeDecimal,
      air_psi: gy.airPressurePsi,
      gy_c: gy.samplingConstantC,
      gy_err: gy.targetRelativeStdError,
      rr_n: sieveStack.rosinRammlerSlopeN,
      ret_p80: sieveStack.retainedPercentAtP80,
      metrologia: metrologiaStr,
      metrology: {
        specificGravity: sg,
        solidsPctCw: cw,
        pulpDensityKgL: marcy.pulpDensityKgL,
        recommendedRingSg: marcy.recommendedRingSg,
        ringApparentCw: marcy.ringApparentCw,
        wrongRingBiasPoints: marcy.wrongRingBiasPoints,
        cupNetMassGrams: marcy.cupNetMassGrams,
        drySolidsMassGramsInCup: marcy.drySolidsMassGramsInCup,
        recommendedContainerEs: marcy.recommendedContainerEs,
        topSizeD95Mm: gy.topSizeD95Mm,
        liberationSizeMicrons: gy.liberationSizeMicrons,
        oreGradeDecimal: gy.oreGradeDecimal,
        theoreticalGyGrams: gy.theoreticalGyGrams,
        samplingConstantC: gy.samplingConstantC,
        targetRelativeStdError: gy.targetRelativeStdError,
        airPressurePsi: gy.airPressurePsi,
        gySampleMassKg: gy.minDrySampleKg,
        batchFilterCycles: gy.batchFilterCycles,
        estimatedCycleMinutes: gy.estimatedCycleMinutes,
        residualCakeMoisturePct: gy.residualCakeMoisturePct,
        targetP80Microns: p80,
        primaryControlMesh: sieveStack.primaryControlMesh,
        rosinRammlerYPrime: sieveStack.rosinRammlerYPrime,
        rosinRammlerSlopeN: sieveStack.rosinRammlerSlopeN,
        retainedPercentAtP80: sieveStack.retainedPercentAtP80,
        screeningMode: sieveStack.screeningMode,
        sieveFrame: frame,
        sieveStack: sieveStack.sieveStack,
        summary: metrologiaStr
      }
    });
  }

  // Sincronización bidireccional entre Segmented Control (3 estaciones), Tarjetas de Equipo y Acordeones
  const stationTabs = Array.from(document.querySelectorAll('[data-met-station-tab]'));
  const instrumentCards = Array.from(document.querySelectorAll('[data-instrument-card]'));
  const accordions = Array.from(document.querySelectorAll('[data-station-accordion]'));

  function activateMetrologyStation(stationId: string) {
    stationTabs.forEach((tab) => {
      const isMatch = tab.getAttribute('data-met-station-tab') === stationId;
      tab.classList.toggle('is-active', isMatch);
      tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
    });
    instrumentCards.forEach((card) => {
      const isMatch = card.getAttribute('data-instrument-card') === stationId;
      (card as HTMLElement).style.display = isMatch ? 'block' : 'none';
    });
    accordions.forEach((acc) => {
      const isMatch = acc.getAttribute('data-station-accordion') === stationId;
      (acc as HTMLDetailsElement).open = isMatch;
      const tag = acc.querySelector('.metrology-station-tag');
      if (tag) {
        tag.textContent = isMatch ? `ESTACIÓN 0${stationId} • ACTIVA` : `ESTACIÓN 0${stationId} ▾`;
      }
    });
  }

  stationTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const st = tab.getAttribute('data-met-station-tab') || '1';
      activateMetrologyStation(st);
    });
  });

  document.querySelectorAll('[data-open-station]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const st = btn.getAttribute('data-open-station') || '1';
      activateMetrologyStation(st);
    });
  });

  accordions.forEach((acc) => {
    acc.addEventListener('toggle', () => {
      if ((acc as HTMLDetailsElement).open) {
        const st = acc.getAttribute('data-station-accordion') || '1';
        activateMetrologyStation(st);
      }
    });
  });

  [
    'met-sg-input',
    'met-cw-input',
    'met-rhop-input',
    'met-gy-pressure-select',
    'met-gy-d95-input',
    'met-gy-lib-input',
    'met-gy-grade-input',
    'met-gy-c-input',
    'met-gy-error-select',
    'met-p80-input',
    'met-rr-n-input',
    'met-frame-select',
    'met-screening-mode'
  ].forEach((id) => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', updateMetrologyCalculator);
      el.addEventListener('change', updateMetrologyCalculator);
    }
  });
  updateMetrologyCalculator();
</script>

