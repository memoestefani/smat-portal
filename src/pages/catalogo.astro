---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogFacetedIsland from '../components/islands/CatalogFacetedIsland.astro';

const title = 'Catálogo Técnico Digital 2026 | Bombas para Lodos, Mecanismos de Flotación, Filtros Prensa y Balanzas | SMAT Minerals';
const description = 'Catálogo técnico digital con diagramas CAD de bombas para lodos (9 series 1.5x1 a 14x12), lotes de contacto húmedo (5 ramas tribológicas: Alto Cromo, Hule, Poliuretano, SiC Cerámico y Rama D Híbrida A05+R55), Bearing Assembly / Housing, mecanismos de flotación, filtros prensa y laboratorio metrológico.';
---

<BaseLayout title={title} description={description} lang="es">
  <CatalogFacetedIsland locale="es" />
</BaseLayout>
