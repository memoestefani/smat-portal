---
import BaseLayout from '../layouts/BaseLayout.astro';
import DualHubView from '../components/DualHubView.astro';
import TechnicalDiagrams from '../components/TechnicalDiagrams.astro';
import atomicParts from '../../data/atomic_parts.json';

const title = "Catálogo Técnico Digital 2026 | Bombas para Lodos, Mecanismos de Flotación, Filtros Prensa y Balanzas | SMAT Minerals";
const description = "Catálogo técnico digital con diagramas CAD de bombas para lodos, lotes de contacto húmedo (Alto Cromo, Hule y Poliuretano), Bearing Assembly / Housing, mecanismos de flotación, filtros prensa y balanzas Marcy.";
---

<BaseLayout title={title} description={description} lang="es">
  <div class="catalog-page-container">
    
    <!-- Barra Superior Ejecutiva -->
    <div class="catalog-action-bar no-print">
      <div class="action-bar-left">
        <a href="/" class="btn-back">← Volver al Inicio</a>
        <span class="catalog-edition-pill">EDICIÓN TÉCNICA V3.2 • 2026</span>
      </div>
      <div class="action-bar-right">
        <button type="button" class="btn-action btn-print" onclick="window.print()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          <span>Imprimir / Guardar Catálogo PDF (A4)</span>
        </button>
        <a href="/#rfq" class="btn-action btn-rfq">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Cotizar Requisición</span>
        </a>
      </div>
    </div>

    <!-- Encabezado Membretado Oficial (Visible en Web e Impresión) -->
    <header class="catalog-official-header">
      <div class="header-brand-block">
        <h1 class="brand-title">SMAT MINERALS</h1>
        <span class="brand-tagline">BOMBAS PARA LODOS, CONTACTO HÚMEDO, FLOTACIÓN, FILTROS PRENSA Y BALANZAS</span>
        <span class="brand-location">Domicilio Fiscal: Mariano Salas #114, Durango, Dgo. CP 34166 | Almacén Central Durango</span>
      </div>
      <div class="header-meta-block">
        <span class="doc-badge">CATÁLOGO TÉCNICO CON DIAGRAMAS CAD</span>
        <span class="doc-code">REF: SMAT-CAT-2026</span>
        <span class="doc-contact">Tel: (618) 810-4408 • Guardia: (618) 367-0664 • ventas@smatminerals.com</span>
      </div>
    </header>

    <div class="catalog-intro-banner no-print">
      <div class="intro-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
      </div>
      <div class="intro-text">
        <strong>Catálogo Técnico con Diagramas de Despiece para Ingeniería de Planta y Compras Mineras</strong>
        <p>Consulte las bombas para lodos (1.5x1" a 14x12"), programación de lotes en contacto húmedo (ej. 5 impulsores, 5 cuellos y 4 volutas en Alto Cromo, Hule y Poliuretano), <strong>Bearing Assembly / Housing</strong> completos, mecanismos para celdas de flotación y acondicionadores, filtros prensa (800 a 1500 mm) y balanzas de densidad de pulpa tipo Marcy.</p>
      </div>
    </div>

    <!-- SECCIÓN 1: BOMBAS PARA LODOS Y PIEZAS EN CONTACTO HÚMEDO -->
    <section class="catalog-section" id="bombeo">
      <div class="section-title-wrap">
        <span class="section-num">01</span>
        <div>
          <h2>Bombas para Lodos y Piezas en Contacto Húmedo (Circuito de Bombeo)</h2>
          <span class="section-subtitle">Bombas horizontales para lodos, lotes 5-5-4 en Alto Cromo, Hule y Poliuretano, y Bearing Assembly / Housing completo</span>
        </div>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <TechnicalDiagrams diagram="pump" lang="es" />
      </div>

      <div class="catalog-grid-2">
        <div class="catalog-card">
          <div class="card-tag">Bombas Horizontales y Conjunto Motriz</div>
          <h3>Bombas para Lodos (1.5x1" a 14x12") y Bearing Assembly / Housing</h3>
          <p class="card-desc">Bombas centrífugas horizontales de servicio pesado para descarga de molino, alimentación a ciclones, flotación y jales, junto con <strong>Bearing Assembly / Housing</strong> completos listos para montaje rápido en campo.</p>
          <ul class="card-specs">
            <li><strong>Rango de Bombas:</strong> Desde 1.5x1" hasta 14x12" (Series 4x3 C, 6x4 D, 8x6 E, 10x8 F con acople 1:1).</li>
            <li><strong>Bearing Assembly / Housing:</strong> Conjunto completo ensamblado (carcasa cilíndrica, flecha de acero aleado, rodamientos cónicos Timken y sellos laberinto).</li>
            <li><strong>Sellado de Flecha:</strong> Expulsor centrífugo en seco y prensaestopa con anillo linterna. <strong>No vendemos sello mecánico</strong> por la alta corrosión y abrasión del lodo.</li>
            <li><strong>Intercambiabilidad:</strong> Acople dimensional 1:1 con bancadas y bridas ANSI estándar.</li>
          </ul>
          <div class="card-footer-action no-print" style="display:flex; gap:1rem; flex-wrap:wrap;">
            <a href="/#rfq?equipo=skid_bomba" class="btn-card-quote">Cotizar Bomba para Lodos →</a>
            <a href="/#rfq?equipo=soporte" class="btn-card-quote">Cotizar Bearing Assembly →</a>
          </div>
        </div>

        <div class="catalog-card">
          <div class="card-tag">Suministro por Lote en Contacto Húmedo (5 – 5 – 4)</div>
          <h3>Impulsores, Cuellos y Volutas (Alto Cromo, Hule y Poliuretano)</h3>
          <p class="card-desc">Piezas en contacto húmedo suministradas por lote balanceado según la rotación real de desgaste en planta (por ejemplo: <strong>5 Impulsores + 5 Cuellos + 4 Volutas</strong>) para evitar paros por desajuste de holguras.</p>
          <ul class="card-specs">
            <li><strong>Materiales Disponibles:</strong> Aleación de Alto Cromo 27% Cr (ASTM A532 ≥650 HB), Hule natural vulcanizado y Poliuretano grado minero.</li>
            <li><strong>Impulsores:</strong> Cerrados de 5 álabes y de paso amplio con álabes expulsores traseros para aliviar presión en prensaestopa.</li>
            <li><strong>Cuellos y Volutas:</strong> Cuellos de succión (ajustables para compensar desgaste frontal), volutas y platos posteriores (FPL).</li>
            <li><strong>Balanceo en Banco:</strong> Verificación de dureza y balanceo dinámico ISO 1940 G2.5 en Durango.</li>
          </ul>
          <div class="card-footer-action no-print" style="display:flex; gap:1rem; flex-wrap:wrap;">
            <a href="/#rfq?equipo=revestimientos" class="btn-card-quote">Cotizar Lote Húmedo (5-5-4) →</a>
            <a href="/#rfq?equipo=impulsor" class="btn-card-quote">Cotizar Impulsores →</a>
          </div>
        </div>
      </div>

      <div class="catalog-grid-2" style="margin-bottom: 1.5rem;">
        <div>
          <TechnicalDiagrams diagram="liners" lang="es" compact={true} />
        </div>
        <div>
          <TechnicalDiagrams diagram="bearing" lang="es" compact={true} />
        </div>
      </div>

      <!-- Tabla Paramétrica Rápida de Series y Marcos (Decisión 2-A) -->
      <div class="catalog-table-wrap" id="tabla-parametrica">
        <div class="table-header-flex">
          <div>
            <h4 class="table-title">Matriz Paramétrica Rápida — Series de Bombeo de Pulpa (4x3 a 10x8)</h4>
            <span class="table-subtitle">Consolidado dimensional de marcos, pasaje de sólidos (Top Size), potencias y caudales (&lt;15s de inspección)</span>
          </div>
          <span class="matrix-badge">NORMA DIMENSIONAL 1:1</span>
        </div>

        <!-- Mini-Diagrama Esquemático SVG de Cotas de Montaje (Decisión 2-A & 4-A) -->
        <div class="mounting-diagram-box no-print" id="pump-mounting-diagram">
          <div class="diagram-meta">
            <span class="diagram-tag">CROQUIS ESQUEMÁTICO DE ACOPLE Y ANCLAJE (ESTÁNDAR ANSI 1:1)</span>
            <small>Pase el cursor sobre cualquier fila de la tabla inferior para resaltar las cotas de banco en tiempo real.</small>
          </div>
          <div class="diagram-flex">
            <svg class="pump-svg-scheme" viewBox="0 0 340 120" width="100%" height="120" aria-label="Esquema acotado de bomba de pulpa">
              <defs>
                <marker id="dim-arrow-c" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                  <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#c25e00" />
                </marker>
                <marker id="dim-arrow-blue" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                  <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#2563eb" />
                </marker>
              </defs>
              <rect x="50" y="85" width="240" height="20" rx="3" fill="#e2e8f0" stroke="#94a3b8" stroke-width="1.5" />
              <circle cx="70" cy="95" r="4" fill="#64748b" />
              <circle cx="270" cy="95" r="4" fill="#64748b" />
              <line x1="70" y1="112" x2="270" y2="112" stroke="#c25e00" stroke-width="1.5" stroke-dasharray="3,3" marker-start="url(#dim-arrow-c)" marker-end="url(#dim-arrow-c)" />
              <text x="170" y="109" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#c25e00" text-anchor="middle" font-weight="bold" class="svg-dim-c pro-tabular-nums">Cota C: Distancia entre Barrenos</text>
              <circle cx="120" cy="55" r="32" fill="#cbd5e1" stroke="#475569" stroke-width="1.5" />
              <rect x="25" y="43" width="15" height="24" rx="2" fill="#94a3b8" stroke="#334155" stroke-width="1.5" />
              <line x1="40" y1="55" x2="90" y2="55" stroke="#334155" stroke-width="1.5" />
              <text x="20" y="38" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#0f172a" font-weight="bold" class="svg-dim-a pro-tabular-nums">Ø A (Succión)</text>
              <rect x="108" y="8" width="24" height="15" rx="2" fill="#94a3b8" stroke="#334155" stroke-width="1.5" />
              <line x1="120" y1="23" x2="120" y2="55" stroke="#334155" stroke-width="1.5" />
              <text x="140" y="18" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#0f172a" font-weight="bold" class="svg-dim-b pro-tabular-nums">Ø B (Descarga)</text>
              <line x1="295" y1="55" x2="295" y2="85" stroke="#2563eb" stroke-width="1.5" marker-start="url(#dim-arrow-blue)" marker-end="url(#dim-arrow-blue)" />
              <text x="300" y="73" font-size="10" font-family="var(--apple-font-mono, monospace)" fill="#2563eb" font-weight="bold" class="svg-dim-d pro-tabular-nums">Cota D</text>
            </svg>
            <div class="diagram-legend">
              <span class="legend-item"><strong>Ø A:</strong> Diámetro nominal de brida de succión (4" a 10")</span>
              <span class="legend-item"><strong>Ø B:</strong> Diámetro nominal de brida de descarga (3" a 8")</span>
              <span class="legend-item"><strong>Cota C:</strong> Distancia entre centros de anclaje a patines</span>
              <span class="legend-item"><strong>Cota D:</strong> Altura de centro de eje a base de concreto</span>
            </div>
          </div>
        </div>

        <table class="catalog-table pro-tabular-nums" id="parametric-pumps-table">
          <thead>
            <tr>
              <th>Serie / Marco</th>
              <th>Succión × Descarga</th>
              <th>Caudal Operativo</th>
              <th>Carga Dinámica (TDH)</th>
              <th>Top Size (Sólidos máx)</th>
              <th>Potencia de Motor</th>
              <th>Materiales en Contacto Húmedo</th>
              <th>Aplicación en Planta</th>
              <th class="no-print">Acción Rápida</th>
            </tr>
          </thead>
          <tbody>
            <tr class="dim-row" data-dimension="dim-c" data-series="4x3C">
              <td><span class="series-pill">4x3 C</span></td>
              <td>4" (100 mm) × 3" (75 mm)</td>
              <td>50 – 180 m³/h</td>
              <td>10 – 45 m</td>
              <td><strong>28 mm</strong></td>
              <td>30 – 50 HP (22-37 kW)</td>
              <td>Alto Cromo (&gt;650 HB) / Hule / Poliuretano</td>
              <td>Alimentación a celdas, sumideros y finos.</td>
              <td class="no-print"><a href="/#rfq?equipo=skid_bomba&serie=4x3" class="btn-table-cta">Cotizar 4x3 →</a></td>
            </tr>
            <tr class="dim-row" data-dimension="dim-c" data-series="6x4D">
              <td><span class="series-pill highlight">6x4 D</span></td>
              <td>6" (150 mm) × 4" (100 mm)</td>
              <td>150 – 450 m³/h</td>
              <td>15 – 60 m</td>
              <td><strong>45 mm</strong></td>
              <td>50 – 100 HP (37-75 kW)</td>
              <td>Alto Cromo (&gt;650 HB) / Hule / Poliuretano</td>
              <td>Descarga de molinos SAG a hidrociclones.</td>
              <td class="no-print"><a href="/#rfq?equipo=skid_bomba&serie=6x4" class="btn-table-cta">Cotizar 6x4 →</a></td>
            </tr>
            <tr class="dim-row" data-dimension="dim-c" data-series="8x6E">
              <td><span class="series-pill">8x6 E</span></td>
              <td>8" (200 mm) × 6" (150 mm)</td>
              <td>350 – 900 m³/h</td>
              <td>20 – 70 m</td>
              <td><strong>63 mm</strong></td>
              <td>100 – 200 HP (75-150 kW)</td>
              <td>Alto Cromo (&gt;650 HB) / Hule</td>
              <td>Molienda primaria y jales espesados.</td>
              <td class="no-print"><a href="/#rfq?equipo=skid_bomba&serie=8x6" class="btn-table-cta">Cotizar 8x6 →</a></td>
            </tr>
            <tr class="dim-row" data-dimension="dim-c" data-series="10x8F">
              <td><span class="series-pill">10x8 F</span></td>
              <td>10" (250 mm) × 8" (200 mm)</td>
              <td>700 – 1,200 m³/h</td>
              <td>25 – 80 m</td>
              <td><strong>86 mm</strong></td>
              <td>150 – 250 HP (110-185 kW)</td>
              <td>Alto Cromo (&gt;650 HB) / Hule</td>
              <td>Gran caudal de relaves y plantas &gt;1,500 t/d.</td>
              <td class="no-print"><a href="/#rfq?equipo=skid_bomba&serie=10x8" class="btn-table-cta">Cotizar 10x8 →</a></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Fichas Técnicas Atómicas de Piezas de Desgaste (atomic_parts.json) -->
      <div class="atomic-parts-catalog-block" id="fichas-atomicas">
        <div class="table-header-flex">
          <div>
            <h4 class="table-title">Fichas Técnicas por Número de Parte Universal (Impulsores, Cuellos y Anillos Expulsores)</h4>
            <span class="table-subtitle">Seleccione el código universal para abrir su especificación metalúrgica individual, dureza certificada y acople dimensional 1:1</span>
          </div>
          <span class="matrix-badge">6 FICHAS ATÓMICAS</span>
        </div>
        <div class="atomic-parts-grid">
          {atomicParts.map((part) => (
            <div class="atomic-part-card">
              <div class="atomic-part-top">
                <span class="series-pill highlight">{part.part_number}</span>
                <span class="atomic-frame-badge">Marco {part.frame}</span>
              </div>
              <strong class="atomic-part-title">{part.name_es}</strong>
              <p class="atomic-part-desc">{part.type_es} • {part.hardness}</p>
              <div class="atomic-part-actions no-print">
                <a href={`/catalogo/${part.code}/`} class="btn-table-cta">Ver Ficha {part.part_number} →</a>
                <a href={`/#rfq?codigo=${part.part_number}&circuito=bombeo`} class="btn-card-quote">Cotizar →</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECCIÓN 2: MECANISMOS PARA CELDAS DE FLOTACIÓN Y ACONDICIONADORES -->
    <section class="catalog-section" id="flotacion">
      <div class="section-title-wrap">
        <span class="section-num">02</span>
        <div>
          <h2>Mecanismos para Celdas de Flotación y Acondicionadores</h2>
          <span class="section-subtitle">Cabezales motrices, flechas, tubos de aire, acondicionadores y mecanismos rotor/estator (50 a 300 ft³)</span>
        </div>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <TechnicalDiagrams diagram="flotation" lang="es" />
      </div>

      <div class="catalog-grid-2">
        <div class="catalog-card">
          <div class="card-tag">Mecanismos Completos y Acondicionadores</div>
          <h3>Mecanismos para Celdas de Flotación y Tanques Acondicionadores (50 a 300 ft³)</h3>
          <p class="card-desc">Conjuntos motrices completos (cabezal porta-rodamientos vertical, polea acanalada, tubo de aire concéntrico con válvula de control y flecha de acero aleado) para bancos Rougher, Cleaner y Scavenger, así como mecanismos de agitación para acondicionadores de pulpa.</p>
          <ul class="card-specs">
            <li><strong>Volúmenes de Celda:</strong> 50 ft³ (1.4 m³), 100 ft³ (2.8 m³), 200 ft³ (5.6 m³), 300 ft³ (8.5 m³).</li>
            <li><strong>Acondicionadores de Pulpa:</strong> Mecanismos de circulación axial con tubo difusor central y propela recubierta.</li>
            <li><strong>Aireación:</strong> Auto-aspiración por columna concéntrica o alimentación de aire a baja presión.</li>
            <li><strong>Montaje:</strong> Sustitución directa sobre puente estructural de celdas existentes.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/#rfq?equipo=celda_flotacion" class="btn-card-quote">Cotizar Mecanismo o Acondicionador →</a>
          </div>
        </div>

        <div class="catalog-card">
          <div class="card-tag">Piezas de Desgaste en Hule y Poliuretano</div>
          <h3>Rotores, Estatores, Propelas y Flechas</h3>
          <p class="card-desc">Impulsores/rotores, difusores/estatores y propelas de acondicionador moldeados sobre alma metálica en hule natural de alta resiliencia o poliuretano grado minero.</p>
          <ul class="card-specs">
            <li><strong>Materiales:</strong> Hule natural vulcanizado (60-65 Shore A) y Poliuretano resistente a reactivos.</li>
            <li><strong>Rotores:</strong> Geometría radial que maximiza el cizallamiento aire-pulpa sin desprendimiento.</li>
            <li><strong>Estatores:</strong> Álabes estabilizadores que eliminan el vórtice y mantienen una cama de espuma estable.</li>
            <li><strong>Compatibilidad:</strong> Recambio dimensional 1:1 para mecanismos de celdas industriales estándar.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/#rfq?equipo=rotor_estator" class="btn-card-quote">Cotizar Rotores y Estatores →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 3: FILTROS PRENSA, PLACAS Y TELAS FILTRANTES -->
    <section class="catalog-section" id="filtracion">
      <div class="section-title-wrap">
        <span class="section-num">03</span>
        <div>
          <h2>Filtros Prensa, Placas Filtrantes y Telas (Filtración de Concentrados y Jales)</h2>
          <span class="section-subtitle">Filtros prensa de cámara empotrada (800 a 1500 mm), placas de polipropileno virgen y telas en fieltro agujado</span>
        </div>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <TechnicalDiagrams diagram="filter" lang="es" />
      </div>

      <div class="catalog-grid-2">
        <div class="catalog-card">
          <div class="card-tag">Filtros Prensa de Placas</div>
          <h3>Filtros Prensa Electrohidráulicos (800 mm a 1500 mm)</h3>
          <p class="card-desc">Filtros prensa de cámara empotrada diseñados para el desaguado de concentrados minerales y jales espesados (hasta 16 bar de presión de alimentación), entregando tortas sólidas con baja humedad residual y alta recuperación de agua.</p>
          <ul class="card-specs">
            <li><strong>Dimensiones de Placa:</strong> Cámara empotrada de 800 x 800 mm, 1000 x 1000 mm, 1250 x 1250 mm y 1500 x 1500 mm.</li>
            <li><strong>Presión de Filtrado:</strong> Alimentación de pulpa hasta 16 bar.</li>
            <li><strong>Cierre Hidráulico:</strong> Cilindro hidráulico de doble efecto (hasta 350 bar) con unidad de potencia y válvulas de retención.</li>
            <li><strong>Operación:</strong> Cabezal móvil, vigas laterales reforzadas y sistema desplazador de placas.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/#rfq?equipo=filtro_prensa" class="btn-card-quote">Cotizar Filtro Prensa →</a>
          </div>
        </div>

        <div class="catalog-card">
          <div class="card-tag">Placas Filtrantes y Telas</div>
          <h3>Placas de Polipropileno Virgen y Telas Filtrantes</h3>
          <p class="card-desc">Placas filtrantes de cámara empotrada moldeadas en polipropileno virgen copolímero y telas filtrantes en fieltro agujado cortadas por láser con sellado perimetral térmico.</p>
          <ul class="card-specs">
            <li><strong>Placas Filtrantes:</strong> Polipropileno virgen copolímero de alta densidad para cámaras de 800 mm a 1500 mm.</li>
            <li><strong>Telas Filtrantes:</strong> Fieltro agujado y tejido monofilamento/multifilamento calibrado al P80 del mineral (cuello central, ojillos y velcro).</li>
            <li><strong>Resistencia Química:</strong> Inertes frente a reactivos de flotación, acidez y alcalinidad.</li>
            <li><strong>Repuestos Hidráulicos:</strong> Sellos de cilindro, válvulas, bombas de alimentación de lodo y manómetros con sello de diafragma.</li>
          </ul>
          <div class="card-footer-action no-print">
            <a href="/#rfq?equipo=placas_telas" class="btn-card-quote">Cotizar Placas y Telas →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 4: BALANZAS DE DENSIDAD DE PULPA (TIPO MARCY) -->
    <section class="catalog-section" id="balanzas">
      <div class="section-title-wrap">
        <span class="section-num">04</span>
