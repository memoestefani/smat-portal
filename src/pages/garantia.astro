---
// src/pages/garantia.astro
// Decisión 2-B: Pacto de Certeza Técnica y Garantía Comercial en Patio Durango
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustMatrix from '../components/TrustMatrix.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
---

<BaseLayout 
  title="Pacto de Certeza y Garantía en Almacén Durango"
  description="Garantía de Almacén Central Durango y Domicilio Fiscal Mariano Salas #114: Verificación dimensional de refacciones, cotejo 1:1 sobre plantilla maestra y aleación High Chrome >650 HB."
  lang="es"
  canonicalPath="/garantia/"
  alternateEsPath="/garantia/"
  alternateEnPath="/en/warranty/"
>
  <section class="trust-page-main">
    <div class="container">
      <div class="page-header">
        <span class="trust-badge">POLÍTICA INSTITUCIONAL DE TRANSPARENCIA</span>
        <h1 class="page-title">Pacto de Certeza Técnica y Garantía en Almacén Durango</h1>
        <p class="page-lead">
          En compras industriales mineras, la confianza no se pide: se exhibe. En SMAT Minerals delimitamos con exactitud qué cubre nuestro protocolo en el Almacén Central Durango (con domicilio fiscal en Mariano Salas #114): verificación dimensional de ensamble, compatibilidad 1:1 con marcos estándar de la industria y despacho verificado en almacén.
        </p>
      </div>

      <!-- Matriz de Garantía y Límites -->
      <div id="stratum1-warranty-trust" data-stratum-1-instrument>
        <TrustMatrix lang="es" />
      </div>

      <!-- Evidencia Fotográfica Real de Inspección XRF Cr27% y Metrología en Durango -->
      <div class="trust-evidence-grid">
        <figure class="trust-evidence-fig">
          <img
            src="/images/productos/impulsor-bomba-lodos-serie-ah-v2.webp"
            alt="Lectura real de espectrometría XRF confirmando 27.209% Cromo (Cr27) en lote SMAT Durango"
            width="640"
            height="480"
            loading="eager"
            decoding="async"
          />
          <figcaption>Espectrometría PMI / XRF real en colada de Alto Cromo (27.209% Cr · ASTM A532)</figcaption>
        </figure>
        <figure class="trust-evidence-fig">
          <img
            src="/images/almacen/almacen-impulsor-cr27.webp"
            alt="Impulsor maquinado en Alto Cromo 27% inspeccionado en Almacén Central Durango"
            width="640"
            height="480"
            loading="eager"
            decoding="async"
          />
          <figcaption>Inspección de barrenado y concentricidad en Almacén Central Durango</figcaption>
        </figure>
      </div>

      <!-- Protocolos de Verificación Dimensional en Almacén Durango -->
      <div class="protocol-request-card">
        <div class="protocol-card-header">
          <span class="protocol-badge">VERIFICACIÓN PREVIA AL EMBARQUE</span>
          <h3>Protocolo de Cotejo Dimensional 1:1 e Inspección Física de Ajuste</h3>
        </div>
        <p>
          Para salvaguardar la confiabilidad en el montaje, cada componente despachado desde nuestro Almacén Central en Durango se coteja físicamente contra el patrón dimensional de carcasa (bridas ANSI, barrenado y cuñeros de flecha) y se somete a prueba de giro y dureza Brinell (≥650 HB) antes de ser cargado a plataforma o fletera.
        </p>
        <div class="protocol-card-action">
          <a href="/cotizar/#rfq" class="btn btn-primary">Generar Requisición / RFQ Técnica →</a>
          <a href="https://wa.me/526183670664?text=Hola%20SMAT%20Minerals,%20deseo%20confirmar%20compatibilidad%20dimensional%20para%20mi%20circuito" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Consultar Ajuste con Ingeniería vía WhatsApp</a>
        </div>
      </div>

      <!-- Banner de Retiro en Patio -->
      <div class="pickup-banner">
        <div class="pickup-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" x2="12" y1="22.08" y2="12"/></svg>
        </div>
        <div class="pickup-text">
          <h3>Retiro y Maniobra en Almacén Central Durango</h3>
          <p>
            Instalaciones habilitadas para carga en camión unitario, torton o plataforma previa confirmación de folio. Su personal técnico puede presenciar el cotejo dimensional 1:1 sobre plantilla maestra antes de que la unidad salga hacia su mina.
          </p>
        </div>
        <div class="pickup-action">
          <a href="https://wa.me/526183670664?text=Hola%20SMAT,%20deseo%20coordinar%20retiro%20de%20refacciones%20en%20almacen%20Durango" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            Coordinar Retiro en Almacén →
          </a>
        </div>
      </div>

      <!-- Pasaporte de Cumplimiento y Alta Rápida de Proveedor B2B (D7 = 7-C++) -->
      <div class="protocol-request-card" id="warranty-vendor-passport-bridge" data-vendor-passport-bridge="es">
        <div class="protocol-card-header">
          <span class="protocol-badge">CUMPLIMIENTO FISCAL SAT CFDI 4.0 · ERP</span>
          <h3>Pasaporte de Alta Rápida de Proveedor (SAP Ariba / Coupa / Oracle)</h3>
        </div>
        <p>
          Descargue en 1 clic nuestro expediente de alta de proveedor con Constancia Fiscal SAT CFDI 4.0 (Régimen 601, Col. Primer Presidente, C.P. 34166 Durango), códigos UNSPSC (<code>40151500</code>, <code>20121500</code>, <code>40161500</code>, <code>41111500</code>), Incoterms EXW/DAP y trazabilidad de colada ASTM A532.
        </p>
        <div class="protocol-card-action">
          <a href="/cumplimiento/" class="btn btn-primary">Abrir Pasaporte de Cumplimiento (.vcf + JSON) →</a>
        </div>
      </div>

      <!-- Preguntas Frecuentes de Suministro, Balanceo y Metalurgia (data/faqs.json) -->
      <FaqAccordion lang="es" />
    </div>
  </section>
</BaseLayout>

<style>
  .trust-page-main {
    padding-top: clamp(0.65rem, 1.8vw, 1.75rem);
    padding-bottom: 3rem;
    background-color: #fafaf9;
  }

  .page-header {
    text-align: center;
    max-width: 840px;
    margin: 0 auto clamp(0.65rem, 1.5vw, 1.35rem);
  }

  .trust-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: #fff7ed;
    border: 1px solid #92400e;
    border-radius: var(--smat-radius-pill);
    color: var(--smat-copper-accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .page-title {
    font-family: var(--smat-font-editorial);
    font-size: clamp(1.25rem, 2.8vw, 2.25rem);
    font-weight: 800;
    color: var(--smat-text-primary);
    line-height: 1.15;
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
  }

  .page-lead {
    font-size: clamp(0.82rem, 1.2vw, 0.98rem);
    color: var(--smat-text-secondary);
    line-height: 1.4;
    margin: 0;
  }

  @media (max-width: 640px) {
    .page-header {
      text-align: left;
    }
    .page-lead {
      font-size: 0.9rem;
      line-height: 1.45;
    }
  }

  .protocol-request-card {
    margin-top: 2.5rem;
    background: #f8fafc;
    border: 1px solid var(--smat-border-medium);
    border-radius: var(--smat-radius-md);
    padding: 1.5rem 1.75rem;
  }

  .protocol-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .protocol-badge {
    font-size: 0.68rem;
    font-weight: 800;
    font-family: var(--smat-font-mono);
    background: var(--smat-slate-dark, #1e293b);
    color: #ffffff;
    padding: 0.2rem 0.5rem;
    border-radius: var(--smat-radius-sm);
  }

  .protocol-card-header h3 {
    font-family: var(--smat-font-ui);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--smat-text-primary);
    margin: 0;
  }

  .protocol-request-card p {
    font-size: 0.88rem;
    color: var(--smat-text-secondary);
    line-height: 1.5;
    margin: 0 0 1rem;
  }

  .protocol-card-action {
    display: flex;
  }

  .pickup-banner {
    margin-top: 2rem;
    background: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-left: 4px solid var(--smat-copper-accent);
    border-radius: var(--smat-radius-md);
    padding: 1.75rem 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    box-shadow: var(--smat-shadow-sm);
  }

  .pickup-icon {
    font-size: 2.2rem;
    flex-shrink: 0;
  }

  .pickup-text {
    flex: 1 1 400px;
  }

  .pickup-text h3 {
    font-family: var(--smat-font-ui);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--smat-text-primary);
    margin: 0 0 0.35rem 0;
  }

  .pickup-text p {
    font-size: 0.85rem;
    color: var(--smat-text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .pickup-action {
    flex-shrink: 0;
  }

  .trust-evidence-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .trust-evidence-fig {
    margin: 0;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    overflow: hidden;
  }

  .trust-evidence-fig img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .trust-evidence-fig figcaption {
    padding: 0.55rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #334155;
  }
</style>
