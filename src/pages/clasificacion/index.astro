---
// src/pages/clasificacion/index.astro
// MVP v3.0 (D7): Vertical de Clasificación por Hidrociclones — Balance de Masa por 3 Vasos Marcy
// (Cero Báscula / Cero Flujómetro), Corte Plitt d50c y Alerta de Acordonamiento (Roping C_v,u >= 0.56)
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import CycloneAndScreenReport from '../../components/CycloneAndScreenReport.astro';

const title = 'Clasificación por Hidrociclones y Balance 3 Vasos Marcy | SMAT Minerals';
const description = 'Boquillas Apex en Cerámica SiC / Cr27, Buscadores de Vórtice y Revestimientos de Cono con simulador de Balance de Masa por 3 Vasos Marcy sin báscula ni flujómetro.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/clasificacion/"
  alternateEsPath="/clasificacion/"
  alternateEnPath="/en/classification/"
>
  <main class="cyc-main" id="stage-diagnostic">
    <div class="container">
      <header class="cyc-hero">
        <span class="cyc-badge">INGENIERÍA DE CLASIFICACIÓN Y MOLIENDA CERRADA • D7</span>
        <h1>Clasificación por Hidrociclones y Diagnóstico de Roping</h1>
        <p class="cyc-lead">
          Audite el desempeño de su batería de ciclones midiendo únicamente 3 vasos con Balanza Marcy (Alimentación, Descarga Apex y Rebalse Vortex) sin necesidad de báscula de banda ni flujómetro ultrasónico.
        </p>
      </header>

      <TechnicalDiagrams diagram="cyclone-apex-vortex" lang="es" showXrayOverlay={true} />

      <section class="cyc-sim-card" id="marcy-3cup-cyclone-calculator" aria-labelledby="cyc-sim-heading">
        <div class="cyc-sim-header">
          <h2 id="cyc-sim-heading">Calculadora de Balance de Masa por 3 Vasos Marcy y Corte Plitt (d<sub>50c</sub>)</h2>
          <span class="cyc-sim-tag">CERO BÁSCULA • CERO FLUJÓMETRO</span>
        </div>

        <div class="cyc-sim-grid" id="stage-2">
          <div class="cyc-inputs">
            <label class="cyc-field">
              <span>1. Densidad Alimentación Nido (ρ<sub>f</sub> kg/L):</span>
              <input type="number" id="cyc-feed-sg" step="0.01" min="1.05" max="2.20" value="1.35" />
            </label>
            <label class="cyc-field">
              <span>2. Densidad Descarga Apex Underflow (ρ<sub>u</sub> kg/L):</span>
              <input type="number" id="cyc-underflow-sg" step="0.01" min="1.20" max="2.60" value="1.82" />
            </label>
            <label class="cyc-field">
              <span>3. Densidad Rebalse Vortex Overflow (ρ<sub>o</sub> kg/L):</span>
              <input type="number" id="cyc-overflow-sg" step="0.01" min="1.01" max="1.80" value="1.15" />
            </label>
            <label class="cyc-field">
              <span>4. Gravedad Específica del Mineral Seco (S<sub>s</sub>):</span>
              <input type="number" id="cyc-solids-sg" step="0.05" min="1.80" max="5.20" value="2.70" />
            </label>
            <label class="cyc-field">
              <span>5. Diámetro Interno de Boquilla Apex (D<sub>u</sub> mm):</span>
              <input type="number" id="cyc-apex-mm" step="1" min="15" max="200" value="50" />
            </label>
            <label class="cyc-field">
              <span>6. Diámetro Interno de Vortex Finder (D<sub>o</sub> mm):</span>
              <input type="number" id="cyc-vortex-mm" step="1" min="30" max="350" value="100" />
            </label>
            <label class="cyc-field">
              <span>7. Presión Manométrica en Nido (ΔP kPa):</span>
              <input type="number" id="cyc-pressure-kpa" step="5" min="25" max="250" value="95" />
            </label>
          </div>

          <div class="cyc-results">
            <div class="cyc-regime-banner" id="cyc-res-regime" data-regime="SEMI_UMBRELLA_OPTIMAL">
              Descarga Semi-Paraguas Óptima (Aire Central Estable)
            </div>

            <div class="cyc-kpi-grid">
              <div class="cyc-kpi-box">
                <span class="cyc-kpi-label">RECUPERACIÓN MÁSICA A DESCARGA (R<sub>s</sub>)</span>
                <strong class="cyc-kpi-val" id="cyc-res-recovery">84.2%</strong>
              </div>
              <div class="cyc-kpi-box">
                <span class="cyc-kpi-label">CARGA CIRCULANTE ESTIMADA</span>
                <strong class="cyc-kpi-val" id="cyc-res-circload">533%</strong>
              </div>
              <div class="cyc-kpi-box">
                <span class="cyc-kpi-label">FRACCIÓN VOLUMÉTRICA APEX (C<sub>v,u</sub>)</span>
                <strong class="cyc-kpi-val" id="cyc-res-cvu">48.2%</strong>
              </div>
              <div class="cyc-kpi-box">
                <span class="cyc-kpi-label">TAMAÑO DE CORTE PLITT (d<sub>50c</sub>)</span>
                <strong class="cyc-kpi-val" id="cyc-res-d50c">74 µm</strong>
              </div>
            </div>

            <p class="cyc-diagnostic-note" id="cyc-res-action">
              Relación Du/Do y fracción volumétrica C_v,u en ventana metalúrgica óptima. Mantenga monitoreo preventivo de diámetro de Apex con galga cilíndrica.
            </p>

            <div class="cyc-cta-row">
              <a href="/productos/hidrociclon-completo-y-boquillas-d6-d20/" class="btn-cyc-sku" id="cyc-recommended-sku-link">
                Configurar Boquilla Apex (SMAT-CYC-D6-D20) →
              </a>
              <a href="/cotizar/?circuito=clasificacion&equipo=apex-boquilla-hidrociclon&sku=SMAT-CYC-D6-D20#rfq" class="btn-cyc-rfq" id="cyc-rfq-link">
                Sincronizar al Cotizador A4 →
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="cyc-sku-catalog" aria-label="Repuestos críticos de hidrociclón">
        <h2>Repuestos Críticos de Hidrociclón con Cotejo Dimensional 1:1 en Durango</h2>
        <div class="cyc-sku-cards">
          <article class="cyc-sku-card">
            <span class="cyc-sku-code">SMAT-CYC-D6-D20 • ALTA ABRASIÓN UNDERFLOW</span>
            <h3>Boquilla Apex / Spigot (Cerámica SiC / Nitruro / Cr27)</h3>
            <p>Geometría cónica rectificada para conservar el ángulo de descarga semi-paraguas y evitar el acordonamiento (roping).</p>
            <a href="/productos/hidrociclon-completo-y-boquillas-d6-d20/">Abrir Ficha Quick-Checkout SMAT-CYC-D6-D20 →</a>
          </article>

          <article class="cyc-sku-card">
            <span class="cyc-sku-code">SMAT-COUPLED-PUMP-CYC • CORTE FINO OVERFLOW</span>
            <h3>Buscador de Vórtice (Vortex Finder en Cr27 / SiC / PU)</h3>
            <p>Borde de ataque de alta resistencia a la erosión turbulenta para eliminar el cortocircuito de gruesos hacia flotación.</p>
            <a href="/productos/paquete-casado-bomba-hidrociclon/">Abrir Ficha Quick-Checkout SMAT-COUPLED-PUMP-CYC →</a>
          </article>

          <article class="cyc-sku-card">
            <span class="cyc-sku-code">SMAT-SCR-TH48-30 • CUERPO, CONOS Y CRIBADO</span>
            <h3>Juego de Revestimientos de Cono y Cilindro (Hule R55 / PU / SiC)</h3>
            <p>Camisas reemplazables con labio escalonado anti-turbulencia compatibles con baterías D10, D15, D20 y D26.</p>
            <a href="/productos/hidrociclon-completo-y-boquillas-d6-d20/">Abrir Ficha Quick-Checkout SMAT-CYC-D6-D20 →</a>
          </article>
        </div>
      </section>

      <CycloneAndScreenReport lang="es" />

      <SharePurchasing
        lang="es"
        circuit="clasificacion"
        role="hidrociclon_apex_vortex"
        partName="Batería de Hidrociclones — Apex, Vortex Finder y Conos"
        partCode="SMAT-CYC-D6-D20"
      />
    </div>
  </main>
</BaseLayout>

<script>
  import { calculateThreeCupMarcyCycloneBalance } from '../../scripts/slurryEngine.js';
  import { saveWorkbenchSession, loadWorkbenchSession } from '../../scripts/workbenchBus.js';

  const feedInput = document.getElementById('cyc-feed-sg') as HTMLInputElement | null;
  const underInput = document.getElementById('cyc-underflow-sg') as HTMLInputElement | null;
  const overInput = document.getElementById('cyc-overflow-sg') as HTMLInputElement | null;
  const solidsInput = document.getElementById('cyc-solids-sg') as HTMLInputElement | null;
  const apexInput = document.getElementById('cyc-apex-mm') as HTMLInputElement | null;
  const vortexInput = document.getElementById('cyc-vortex-mm') as HTMLInputElement | null;
  const pressInput = document.getElementById('cyc-pressure-kpa') as HTMLInputElement | null;

  const regimeEl = document.getElementById('cyc-res-regime');
  const recEl = document.getElementById('cyc-res-recovery');
  const circEl = document.getElementById('cyc-res-circload');
  const cvuEl = document.getElementById('cyc-res-cvu');
  const d50El = document.getElementById('cyc-res-d50c');
  const actionEl = document.getElementById('cyc-res-action');
  const skuLink = document.getElementById('cyc-recommended-sku-link') as HTMLAnchorElement | null;

  function updateCycloneBalance() {
    if (!feedInput || !underInput || !overInput) return;
    const res = calculateThreeCupMarcyCycloneBalance({
      feedSg: Number(feedInput.value) || 1.35,
      underflowSg: Number(underInput.value) || 1.82,
      overflowSg: Number(overInput.value) || 1.15,
      solidsSg: solidsInput ? Number(solidsInput.value) || 2.7 : 2.7,
      apexDiameterMm: apexInput ? Number(apexInput.value) || 50 : 50,
      vortexDiameterMm: vortexInput ? Number(vortexInput.value) || 100 : 100,
      feedPressureKpa: pressInput ? Number(pressInput.value) || 95 : 95
    });

    if (regimeEl) {
      regimeEl.textContent = res.regimeLabelEs;
      regimeEl.setAttribute('data-regime', res.dischargeRegime);
    }
    if (recEl) recEl.textContent = `${res.solidsRecoveryPct}%`;
    if (circEl) circEl.textContent = `${res.circulatingLoadPct}%`;
    if (cvuEl) cvuEl.textContent = `${res.cvUnderflowPct}%`;
    if (d50El) d50El.textContent = `${res.d50cMicrons} µm`;
    if (actionEl) actionEl.textContent = res.diagnosticActionEs;
    if (skuLink) {
      skuLink.href = res.recommendedSkuId === 'SMAT-COUPLED-PUMP-CYC'
        ? '/productos/paquete-casado-bomba-hidrociclon/'
        : '/productos/hidrociclon-completo-y-boquillas-d6-d20/';
      skuLink.textContent = `Configurar Repuesto Recomendado (${res.recommendedSkuId}) →`;
    }

    const prev = loadWorkbenchSession();
    saveWorkbenchSession({
      ...prev,
      cycloneCircuit: {
        feedSg: res.feedSg,
        underflowSg: res.underflowSg,
        overflowSg: res.overflowSg,
        apexMm: res.apexDiameterMm,
        vortexMm: res.vortexDiameterMm,
        d50cMicrons: res.d50cMicrons,
        solidsRecoveryPct: res.solidsRecoveryPct,
        ropingRisk: res.isRopingCritical
      }
    });
  }

  [feedInput, underInput, overInput, solidsInput, apexInput, vortexInput, pressInput].forEach((el) => {
    if (el) el.addEventListener('input', updateCycloneBalance);
  });
  updateCycloneBalance();
</script>

<style>
  .cyc-main {
    padding: 2.5rem 0 4rem;
    background: #f8fafc;
  }
  .cyc-hero {
    margin-bottom: 1.5rem;
  }
  .cyc-badge {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    background: #f0f9ff;
    color: #082f49;
    border: 1px solid #bae6fd;
    border-radius: 4px;
    font-family: var(--smat-font-mono, monospace);
    font-size: 0.74rem;
    font-weight: 800;
    margin-bottom: 0.6rem;
  }
  .cyc-lead {
    font-size: 1.05rem;
    color: #334155;
    max-width: 78ch;
  }
  .cyc-sim-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 2rem;
    margin: 1.75rem 0;
  }
  .cyc-sim-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 0.85rem;
  }
  .cyc-sim-tag {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-family: var(--smat-font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .cyc-sim-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }
  @media (min-width: 960px) {
    .cyc-sim-grid {
      grid-template-columns: 1fr 1.25fr;
    }
  }
  @media (max-width: 768px) {
    .cyc-main {
      padding: 1.25rem 0 2.5rem;
    }
  }
  .cyc-inputs {
    display: grid;
    gap: 0.8rem;
  }
  .cyc-field {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: #1e293b;
  }
  .cyc-field input {
    width: 110px;
    padding: 0.45rem 0.6rem;
    border: 1px solid #94a3b8;
    border-radius: 6px;
    font-family: var(--smat-font-mono, monospace);
    font-weight: 700;
  }
  .cyc-regime-banner {
    padding: 0.85rem 1rem;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.92rem;
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
    margin-bottom: 1rem;
  }
  .cyc-regime-banner[data-regime="ROPING_CORDON"] {
    background: #fef2f2;
    color: #991b1b;
    border-color: #fecaca;
  }
  .cyc-kpi-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
    margin-bottom: 1rem;
  }
  .cyc-kpi-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0.85rem;
  }
  .cyc-kpi-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 800;
    color: #475569;
    margin-bottom: 0.35rem;
  }
  .cyc-kpi-val {
    font-family: var(--smat-font-mono, monospace);
    font-size: 1.35rem;
    color: #090d16;
  }
  .cyc-diagnostic-note {
    font-size: 0.9rem;
    color: #334155;
    line-height: 1.5;
    background: #fffbeb;
    border: 1px solid #fde68a;
    padding: 0.85rem;
    border-radius: 6px;
  }
  .cyc-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .btn-cyc-sku, .btn-cyc-rfq {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.7rem 1.1rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
  }
  .btn-cyc-sku {
    background: #7c2d12;
    color: #ffffff;
  }
  .btn-cyc-rfq {
    background: #0f172a;
    color: #ffffff;
  }
  .cyc-sku-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 1rem 0 2rem;
  }
  .cyc-sku-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 1.35rem;
  }
  .cyc-sku-code {
    display: block;
    font-family: var(--smat-font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 800;
    color: #7c2d12;
    margin-bottom: 0.4rem;
  }
  .cyc-sku-card a {
    display: inline-block;
    margin-top: 0.65rem;
    font-weight: 700;
    color: #082f49;
  }
</style>
