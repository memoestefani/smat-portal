---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CycloneScreenIsland from '../../components/islands/CycloneScreenIsland.astro';

const title = 'Trituración, Molienda, Hidrociclones y Cribas | SMAT Minerals';
const description = 'Equipos de trituración y molienda, boquillas Ápex en Cerámica SiC / Cr27, buscadores de vórtice y cribas TH48-30 con calculadora de balance de 3 vasos.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/clasificacion/"
  alternateEsPath="/clasificacion/"
  alternateEnPath="/en/classification/"
>
  <CycloneScreenIsland locale="es" mode="standalone" />
</BaseLayout>

<style>
  :global(.cyc-main .smat-sf-card[data-sf-sku="SMAT-CYC-D6-D20"]) {
    order: -1;
  }
</style>
