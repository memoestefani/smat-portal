---
// src/pages/acuse.astro
// Decisión 7-A: Acuse Formal Imprimible (@media print) para ERPs (SAP Ariba / Coupa / Oracle)
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Comprobante Institucional de Requisición Técnica"
  description="Acuse formal de requisición técnica con folio institucional para departamentos de compras y sistemas ERP corporativos."
  lang="es"
  canonicalPath="/acuse/"
  alternateEsPath="/acuse/"
  alternateEnPath="/en/thank-you/"
>
  <main class="ack-main">
    <div class="container ack-container">
      
      <!-- Hoja Ejecutiva Imprimible -->
      <div class="requisition-sheet" id="print-sheet">
        <!-- Membrete Corporativo Imprimible -->
        <div class="sheet-header">
          <div class="company-brand">
            <span class="brand-logo-text">SMAT MINERALS</span>
            <span class="brand-legacy">Equipos de Proceso y Refaccionamiento Minero</span>
            <span class="brand-address">Domicilio Fiscal: Mariano Salas #114, Durango, Dgo. CP 34166 • Almacén Central Durango</span>
            <span class="brand-contact">Tel: (618) 810-4408 / 4428 • ventas@smatminerals.com • smatminerals.com</span>
          </div>
          <div class="folio-box">
            <span class="folio-label">FOLIO DE REQUISICIÓN</span>
            <strong class="folio-value" id="display-folio">SMAT-2026-RFQ</strong>
            <span class="folio-date" id="display-date">Fecha de Emisión</span>
            <span class="folio-status" id="display-urgency">ESTATUS: RECIBIDO</span>
          </div>
        </div>

        <div class="sheet-divider"></div>

        <div class="sheet-title-bar">
          <h2>ACUSE FORMAL DE SOLICITUD DE COTIZACIÓN TÉCNICA</h2>
          <span class="badge-sla">SLA MISMO DÍA HÁBIL • ATENCIÓN EN CURSO</span>
        </div>

        <!-- Tabla de Datos del Solicitante -->
        <div class="sheet-section">
          <h3 class="section-title">1. DATOS DEL SOLICITANTE Y UNIDAD MINERA</h3>
          <table class="sheet-table">
            <tbody>
              <tr>
                <th style="width: 25%;">Solicitante / Cargo:</th>
                <td style="width: 35%;" id="field-name">No especificado</td>
                <th style="width: 20%;">Mina / Empresa:</th>
                <td style="width: 20%;" id="field-company">No especificado</td>
              </tr>
              <tr>
                <th>Teléfono / WhatsApp:</th>
                <td id="field-phone">No especificado</td>
                <th>Correo Corporativo:</th>
                <td id="field-email">No especificado</td>
              </tr>
              <tr>
                <th>Destino de Entrega:</th>
                <td colspan="3" id="field-destination">Almacén Central Durango / Retiro Coordinado con Folio</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Tabla de Especificación Técnica Solicitada -->
        <div class="sheet-section">
          <h3 class="section-title">2. ESPECIFICACIÓN TÉCNICA DEL COMPONENTE / EQUIPO</h3>
          <table class="sheet-table">
            <tbody>
              <tr>
                <th style="width: 25%;">Línea / Componente:</th>
                <td style="width: 35%;" id="field-role" class="highlight-spec">Equipo en evaluación</td>
                <th style="width: 20%;">Código SMAT / Pieza:</th>
                <td style="width: 20%; font-family: monospace; font-weight: 700;" id="field-code">Por asignar en revisión</td>
              </tr>
              <tr>
                <th>Referencia Interna / Tag:</th>
                <td id="field-client-ref">Sin referencia de placa declarada</td>
                <th>Medidas de Campo (Flexómetro):</th>
                <td id="field-dimensions">Verificación con patrón 1:1 en almacén</td>
              </tr>
              <tr>
                <th>Condiciones y Notas:</th>
                <td colspan="3" id="field-details">Revisión de parámetros de pulpa según protocolo de ingeniería.</td>
              </tr>
              <tr>
                <th>Memoria Hidráulica (Durand):</th>
                <td colspan="3" id="field-hydraulics">Cálculo hidráulico sujeto a confirmación de flujo y % de sólidos en planta.</td>
              </tr>
              <tr>
                <th>Metalurgia, Arreglo y Estación:</th>
                <td colspan="3" id="field-material-drive">Alto Cromo ASTM A532 Cr27% (>600 HB) • Arreglo ZVZ • Estación S4 (Wet-End)</td>
              </tr>
              <tr>
                <th>Claro Axial (δ) y Cinemática:</th>
                <td colspan="3" id="field-clearance-kinematics">δ = 0.75 mm (Óptimo, Δη_v = -0.3%) • u₂ ≤ 24.5 m/s • Vida ISO 281 L₁₀ₕ certificada</td>
              </tr>
              <tr id="row-field-metrology">
                <th>Memoria Metrológica (Lab):</th>
                <td colspan="3" id="field-metrology">Sin pre-calibración de laboratorio adjunta (Balanza Marcy / Bond / Prensa).</td>
              </tr>
              <tr>
                <th>Continuidad y Perfil Mineral:</th>
                <td colspan="3" id="field-tco">Evaluación de continuidad operativa en Almacén Central Durango.</td>
              </tr>
              <tr>
                <th>Tipo de Solicitud:</th>
                <td id="field-type">Refacción de Desgaste / Continuidad Operativa</td>
                <th>Inspección en Almacén:</th>
                <td>Almacén Central Durango (Banco de Pruebas)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Protocolo Técnico y Cláusula de Almacén Durango (Decisiones 1-C, 2-C y 6-C) -->
        <div class="sheet-section terms-section">
          <h3 class="section-title">3. PROTOCOLO TÉCNICO Y CONTROL DE CALIDAD EN ALMACÉN CENTRAL</h3>
          <p class="terms-text">
            Este acuse certifica el registro formal de su requerimiento en los sistemas de SMAT Minerals. Todo conjunto rotativo, impulsor y carcasa suministrada cuenta con protocolo de balanceo dinámico en banco de pruebas de almacén central, colada High Chrome 27% (A05) con dureza garantizada &gt;650 HB y verificación de acople dimensional 1:1 en instalaciones de SMAT Durango (Domicilio fiscal para facturación: Mariano Salas #114).
          </p>
          <div class="coyote-seal-notice facility-guarantee-notice">
            <strong>Cláusula de Validez de Almacén Central:</strong> Esta propuesta técnica y su respaldo operativo son válidos para componentes inspeccionados y despachados en Almacén Central SMAT Durango. Equipos y skids completos se configuran bajo pedido según variables de pulpa del cliente; refacciones de desgaste comunes en rotación continua de inventario.
          </div>
          <div class="signatures-row">
            <div class="sig-block">
              <span class="sig-line"></span>
              <span class="sig-caption">Ingeniería y Ventas Técnicas<br />SMAT Minerals México</span>
            </div>
            <div class="sig-block">
              <span class="sig-line"></span>
              <span class="sig-caption">Recepción de Solicitud<br />Área de Compras / Mantenimiento</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Barra de Acciones en Pantalla (Oculta al Imprimir) -->
      <div class="screen-actions no-print">
        <button type="button" class="btn btn-primary btn-print" id="print-btn" onclick="window.print()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Imprimir / Guardar en PDF (SAP / Coupa)
        </button>
        <button type="button" class="btn btn-secondary" id="copy-sap-acuse-btn">
          Copiar Texto SAP / Ariba
        </button>
        <button type="button" class="btn btn-secondary" id="download-tsv-acuse-btn">
          Descargar TSV / Excel
        </button>
        <a href="/" class="btn btn-secondary">
          Volver al Inicio
        </a>
        <a href="https://wa.me/526183670664" class="btn btn-emergency" target="_blank" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          Seguimiento Inmediato por WhatsApp
        </a>
      </div>

    </div>
  </main>
</BaseLayout>

<script is:inline>
  (function() {
    function populateSheet() {
      const urlParams = new URLSearchParams(window.location.search);
      let cached = {};
      let wbV2 = {};
      try {
        const raw = sessionStorage.getItem('smat_last_rfq_payload');
        if (raw) cached = JSON.parse(raw) || {};
      } catch (_e) {}
      try {
        const rawV2 = localStorage.getItem('smat_workbench_state_v2') || localStorage.getItem('smat_workbench_session');
        if (rawV2) wbV2 = JSON.parse(rawV2) || {};
      } catch (_e) {}

      const folio = urlParams.get('folio') || cached.folio || wbV2.folio || 'SMAT-' + new Date().getFullYear() + '-' + Math.floor(1000 + Math.random() * 9000);
      const nombre = urlParams.get('nombre') || urlParams.get('name') || cached.nombre || wbV2.name || 'Ingeniero / Solicitante de Planta';
      const empresa = urlParams.get('empresa') || urlParams.get('company') || cached.empresa || wbV2.company || 'Operación Minera Registrada';
      const telefono = urlParams.get('telefono') || urlParams.get('phone') || cached.telefono || wbV2.phone || '(618) 810-4408';
      const correo = urlParams.get('correo') || urlParams.get('email') || cached.correo || wbV2.email || 'ventas@smatminerals.com';
      const equipo = urlParams.get('equipo') || urlParams.get('role') || cached.equipo || wbV2.equipTitle || 'Refaccionamiento Crítico de Pulpa / Bombeo';
      const codigo = urlParams.get('codigo') || cached.codigo_smat || wbV2.equipCode || '';
      const pieza = urlParams.get('pieza') || cached.codigo_pieza_atomica || wbV2.atomicPartCode || '';
      const refCliente = urlParams.get('ref_cliente') || cached.referencia_cliente || wbV2.clientRef || 'Sin referencia interna declarada';
      const medidas = urlParams.get('medidas') || cached.medidas_flexometro || 'Verificación dimensional 1:1 en Almacén Durango';
      const perfilPulpa = urlParams.get('perfil_pulpa') || cached.perfil_pulpa_mina || '';
      const phVal = urlParams.get('ph') || cached.pulp_ph || wbV2.pulpPh || '7.5';
      const flVal = urlParams.get('fl') || cached.durand_fl || wbV2.durandFactorFL || '';
      const cvVal = urlParams.get('cv') || cached.solids_cv_pct || wbV2.solidsVolumetricPercent || '';
      const vRecVal = urlParams.get('v_rec') || cached.recommended_velocity_ms || wbV2.recommendedPipeVelocityMs || '';
      const erVal = urlParams.get('eff_ratio_er') || cached.eff_ratio_er || wbV2.eff_ratio_er || '0.88';
      const impLifeVal = urlParams.get('impeller_life_h') || cached.impeller_life_h || wbV2.impeller_life_h || '2800';
      const wearRatioVal = urlParams.get('wear_life_ratio') || cached.wear_life_ratio || wbV2.wear_life_ratio || '3.8';
      const pAtmMcaVal = urlParams.get('p_atm_mca') || cached.p_atm_mca || wbV2.p_atm_mca || '7.98';
      const deltaNpshVal = urlParams.get('delta_npsh_m') || cached.delta_npsh_m || wbV2.delta_npsh_m || '2.35';
      const motorDeratingVal = urlParams.get('motor_derating_iec') || cached.motor_derating_iec || wbV2.motor_derating_iec || '0.920';
      const kMotorAltVal = urlParams.get('k_motor_alt') || cached.k_motor_alt || wbV2.k_motor_alt || '1.24';
      const pipeVelLossVal = urlParams.get('pipe_vel_loss_pct') || cached.pipe_vel_loss_pct || wbV2.pipe_vel_loss_pct || '0.3';
      const gateClassVal = urlParams.get('gate_classification') || cached.gate_classification || wbV2.gate_classification || 'STANDARD_PROJECT';
      const hidraulicaBase = urlParams.get('hidraulica') || cached.memoria_hidraulica_durand || 'Cálculo hidráulico sujeto a confirmación de flujo y % de sólidos en planta.';
      const hidraulicaExtras = [
        `pH = ${phVal}`,
        flVal ? `F_L = ${flVal}` : '',
        cvVal ? `C_v = ${cvVal}%` : '',
        vRecVal ? `v_rec = ${vRecVal} m/s` : '',
        `η_r = ${erVal}`,
        `Vida Impulsor = ${impLifeVal} h (${wearRatioVal}x)`,
        `P_atm = ${pAtmMcaVal} mca (ΔNPSH = -${deltaNpshVal} m)`,
        `f_IEC = ${motorDeratingVal} (K_motor,alt = ${kMotorAltVal}x)`
      ].filter(Boolean).join(' | ');
      const hidraulica = hidraulicaBase.includes('K_motor,alt') ? hidraulicaBase : `${hidraulicaBase} (${hidraulicaExtras})`;
      const tco = urlParams.get('tco') || cached.proyeccion_tco || '';
      const detalles = urlParams.get('detalles') || urlParams.get('specs') || cached.especificacion_tecnica || wbV2.notes || 'Requisición técnica sujeta a validación dimensional de patio Durango.';
      const destino = urlParams.get('destino') || cached.modalidad_logistica || 'Retiro en Almacén Central Durango (Coordinado con Folio)';
      const urgencia = urlParams.get('urgencia') || (cached.urgencia && cached.urgencia.includes('PARO') ? 'paro' : (wbV2.urgency || 'proyecto'));
      const material = urlParams.get('material') || cached.material_bombeo || wbV2.pump_material || wbV2.selectedMaterial || 'alto_cromo_cr27';
      const transmision = urlParams.get('transmision') || urlParams.get('arreglo') || cached.arreglo_transmision || wbV2.drive_arrangement || wbV2.driveArrangement || 'ZVZ';
      const estacion = urlParams.get('estacion') || cached.estacion_armado || wbV2.stationCode || 'S4';
      const sealBranch = urlParams.get('seal_branch') || cached.rama_sellado || wbV2.seal_branch || wbV2.sealBranch || 'expeller_dry';
      const pesoKg = urlParams.get('peso_kg') || cached.peso_pieza_kg || wbV2.partMassKg || wbV2.weight_kg || '';
      const claroMm = urlParams.get('claro_mm') || cached.claro_axial_mm || wbV2.clearance_mm || wbV2.clearanceMm || '0.75';
      const b2Mm = urlParams.get('b2_mm') || cached.ancho_impulsor_b2_mm || wbV2.b2_mm || wbV2.impellerExitWidthMm || '48';
      const capCKn = urlParams.get('cap_c_kn') || cached.capacidad_rodamiento_c_kn || wbV2.cap_c_kn || wbV2.dynamicCapacityCkN || '185';
      const trustBoundaryId = urlParams.get('trust_boundary_id') || cached.trust_boundary_id || wbV2.trust_boundary_id || 'NONE';
      const deltaEtaV = urlParams.get('delta_eta_v') || cached.perdida_eficiencia_vol_pct || wbV2.volumetricEfficiencyDropPct || '0.3';
      const u2Ms = urlParams.get('u2_ms') || cached.velocidad_periferica_u2_ms || wbV2.tipSpeedU2Ms || '22.4';
      const n2Rpm = urlParams.get('n2_rpm') || cached.n2_rpm || (wbV2.kinematics && wbV2.kinematics.pumpRpm) || '1149';
      const frKn = urlParams.get('fr_kn') || cached.fr_kn || (wbV2.kinematics && wbV2.kinematics.beltRadialLoadKn) || '5.20';
      const floodImm = urlParams.get('inmunidad_sumidero') || cached.inmunidad_sumidero || (wbV2.kinematics && wbV2.kinematics.sumpFloodImmunity) || 'HIGH';
      const structReason = urlParams.get('razon_estructural') || cached.razon_estructural || (wbV2.clearance_eval && wbV2.clearance_eval.structuralReasonEs) || '';
      const l10h = urlParams.get('l10h') || cached.vida_rodamiento_l10h || wbV2.l10hHours || '38500';
      const rhopVal = urlParams.get('rhop') || cached.densidad_mineral_rhop || wbV2.oreDensitySg || '';
      const libUmVal = urlParams.get('lib_um') || wbV2.lib_um || '';
      const gradeVal = urlParams.get('grade') || wbV2.grade || '';
      const airPsiVal = urlParams.get('air_psi') || wbV2.air_psi || '';
      const rrNVal = urlParams.get('rr_n') || wbV2.rr_n || '';
      const retP80Val = urlParams.get('ret_p80') || wbV2.ret_p80 || '';
      const metrologiaBase = urlParams.get('metrologia') || cached.memoria_metrologica || '';
      const metroExtras = [
        libUmVal ? `d_l=${libUmVal} µm` : '',
        gradeVal ? `a_L=${gradeVal}%` : '',
        airPsiVal ? `P_air=${airPsiVal} PSI` : '',
        rrNVal ? `n=${rrNVal}` : '',
        retP80Val ? `R(P80)=${retP80Val}%` : ''
      ].filter(Boolean).join(' | ');
      const metrologia = metrologiaBase
        ? (metroExtras && !metrologiaBase.includes('d_l=') ? `${metrologiaBase} (${metroExtras})` : metrologiaBase)
        : (rhopVal ? `Densidad mineral ρ_p = ${rhopVal} t/m³ calibrada en estación metrológica${metroExtras ? ' (' + metroExtras + ')' : ''}.` : 'Sin pre-calibración de laboratorio adjunta (Balanza Marcy / Bond / Prensa).');

      const elFolio = document.getElementById('display-folio');
      if (elFolio) elFolio.textContent = folio;

      const elDate = document.getElementById('display-date');
      if (elDate) {
        const now = new Date();
        elDate.textContent = now.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
      }

      const elUrgency = document.getElementById('display-urgency');
      if (elUrgency) {
        elUrgency.textContent = urgencia === 'paro' ? 'PRIORIDAD: [PARO DE PLANTA]' : 'PRIORIDAD: [PROYECTO / PROGRAMADO]';
        if (urgencia === 'paro') elUrgency.style.color = '#ef4444';
      }

      const setText = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      const fullCode = [codigo, pieza ? `[Pieza: ${pieza}]` : ''].filter(Boolean).join(' ') || 'SMAT-STD (Cotejo 1:1)';
      const fullTcoAndProfile = [
        perfilPulpa ? `Perfil Mineral: ${perfilPulpa}` : '',
        tco ? `Impacto Operativo: ${tco}` : ''
      ].filter(Boolean).join(' • ') || 'Evaluación de continuidad operativa en Almacén Central Durango.';

      setText('field-name', nombre);
      setText('field-company', empresa);
      setText('field-phone', telefono);
      setText('field-email', correo);
      setText('field-destination', destino);
      setText('field-role', equipo);
      setText('field-code', fullCode);
      setText('field-client-ref', refCliente);
      setText('field-dimensions', medidas);
      setText('field-details', detalles);
      setText('field-hydraulics', hidraulica);
      const matLabel = material === 'hule_natural'
        ? 'Hule Natural Antiabrasivo R55 (55–65 Shore A)'
        : (material === 'poliuretano'
          ? 'Poliuretano Grado Minero U01 (85–95 Shore A)'
          : ((material === 'ceramica_sic' || material === 'carburo_silicio')
            ? 'Carburo de Silicio Sinterizado SiC (≥2200 HV, Mohs 9.2, K_Ic=4.1 MPa·√m)'
            : 'Alto Cromo ASTM A532 Cr27% (>600 HB)'));
      const sealLabel = sealBranch === 'gland_water' ? 'S5b Prensaestopa con Agua' : 'S5a Expulsor Centrífugo Seco';
      const wNum = Number(pesoKg) || 0;
      const liShaft = wNum > 0 ? (wNum / 11.1).toFixed(2) : '0.00';
      const nioshTier = wNum >= 23
        ? `HOIST_REQUIRED: Polipasto / Grúa Obligatorio (≥23 kg NIOSH, LI_shaft=${liShaft})`
        : (wNum > 11.1
          ? `ASSISTED_SHAFT_MOUNT_2P: Montaje Asistido 2 Técnicos (11.1–23 kg Waters-NIOSH, RWL_shaft=11.1 kg, LI_shaft=${liShaft})`
          : `MANUAL_SAFE_1P: Manejo Manual Seguro 1 Técnico (≤11.1 kg Waters-NIOSH, LI_shaft=${liShaft})`);
      const nioshLabel = pesoKg ? ` • Peso: ${pesoKg} kg (${nioshTier})` : '';
      setText('field-material-drive', `${matLabel} • Arreglo V-Belt: ${transmision} (Sumidero: ${floodImm}) • Estación: ${estacion} (${sealLabel})${nioshLabel}`);
      setText('field-clearance-kinematics', `Claro Axial δ = ${claroMm} mm (b₂ = ${b2Mm} mm, Δη_v = -${deltaEtaV}%, Δv_pipe = -${pipeVelLossVal}%) • n₂ = ${n2Rpm} RPM • u₂ = ${u2Ms} m/s • F_r = ${frKn} kN • C = ${capCKn} kN (Vida ISO 281 L₁₀ₕ = ${Number(l10h).toLocaleString('es-MX')} h)${structReason ? ' • ' + structReason : ''}`);
      setText('field-metrology', metrologia);
      setText('field-tco', fullTcoAndProfile);
      setText('field-type', `${urgencia === 'paro' ? 'Paro Operativo Prioritario' : 'Requisición Formal de Proyecto'} [${gateClassVal}${trustBoundaryId !== 'NONE' ? ' • ' + trustBoundaryId : ''}]`);

      const copySapBtn = document.getElementById('copy-sap-acuse-btn');
      if (copySapBtn) {
        copySapBtn.onclick = async () => {
          const sapBlock = [
            `FOLIO: ${folio} | GATE: ${gateClassVal} | BOUNDARY: ${trustBoundaryId}`,
            `EMPRESA: ${empresa} | SOLICITANTE: ${nombre}`,
            `EQUIPO: ${equipo} (${fullCode})`,
            `METALURGIA Y ARREGLO: ${matLabel} | ${transmision} (Sumidero: ${floodImm}) | ${estacion} (${sealLabel})${nioshLabel}`,
            `HIDRAULICA Y ALTITUD: ${hidraulica}`,
            `CINEMATICA: delta=${claroMm}mm (b2=${b2Mm}mm, dEtaV=-${deltaEtaV}%, dvPipe=-${pipeVelLossVal}%), n2=${n2Rpm}RPM, u2=${u2Ms}m/s, Fr=${frKn}kN, C=${capCKn}kN, L10h=${l10h}h${structReason ? ' | ' + structReason : ''}`,
            `METROLOGIA: ${metrologia}`
          ].join('\n');
          try {
            await navigator.clipboard.writeText(sapBlock);
            copySapBtn.textContent = 'Texto SAP Copiado';
          } catch (_e) {}
        };
      }

      const dlTsvBtn = document.getElementById('download-tsv-acuse-btn');
      if (dlTsvBtn) {
        dlTsvBtn.onclick = () => {
          const headers = ['Folio', 'Gate', 'Boundary', 'Empresa', 'Solicitante', 'Equipo', 'Codigo', 'Material', 'Arreglo', 'Inmunidad_Sumidero', 'Estacion', 'Sello', 'Peso_kg', 'NIOSH_Waters_Tier', 'Claro_mm', 'b2_mm', 'n2_RPM', 'u2_ms', 'Fr_kN', 'Capacidad_C_kN', 'L10h_h', 'Er_Cave', 'Vida_Impulsor_h', 'Delta_NPSH_m', 'Derating_IEC', 'K_Motor_Alt', 'Perdida_v_pct', 'Razon_Estructural', 'Hidraulica', 'Metrologia'];
          const row = [folio, gateClassVal, trustBoundaryId, empresa, nombre, equipo, fullCode, matLabel, transmision, floodImm, estacion, sealLabel, pesoKg || '0', nioshTier, claroMm, b2Mm, n2Rpm, u2Ms, frKn, capCKn, l10h, erVal, impLifeVal, deltaNpshVal, motorDeratingVal, kMotorAltVal, pipeVelLossVal, structReason, hidraulica, metrologia];
          const tsv = headers.join('\t') + '\n' + row.map(v => String(v || '').replace(/[\t\r\n]+/g, ' ')).join('\t') + '\n';
          const blob = new Blob(['\uFEFF' + tsv], { type: 'text/tab-separated-values;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${folio}_SAP_ERP.tsv`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        };
      }
    }

    populateSheet();
    document.addEventListener('astro:page-load', populateSheet);
  })();
</script>

