---
// src/pages/acuse.astro
// Isla Canónica AcuseSheetIsland (lang="es") sin <main> anidado (SLICE-V53-01)
import BaseLayout from '../layouts/BaseLayout.astro';
import AcuseSheetIsland from '../components/islands/AcuseSheetIsland.astro';
---

<BaseLayout
  title="Comprobante Institucional de Requisición Técnica"
  description="Acuse formal de requisición técnica con folio institucional para departamentos de compras y sistemas ERP corporativos."
  lang="es"
  canonicalPath="/acuse/"
  alternateEsPath="/acuse/"
  alternateEnPath="/en/thank-you/"
>
  <AcuseSheetIsland lang="es" />
</BaseLayout>

<script>
  import { initAcuseSheetController, enrichTrayItemsPreservingMetadata } from '../scripts/acuseSheetController.js';
  /* Hidratación canónica PutGet (material === 'poliuretano' | 'ceramica_sic', Waters-NIOSH RWL_shaft = 11.1 kg) */
  initAcuseSheetController('es', { enrichTrayItemsPreservingMetadata });
</script>

<style>
  @media print {
    :global(#print-btn) {
      display: none !important;
    }
  }
</style>
