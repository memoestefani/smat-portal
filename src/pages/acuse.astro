---
// src/pages/acuse.astro
// Decisión 7-A: Acuse Formal Imprimible (@media print) para ERPs (SAP Ariba / Coupa / Oracle)
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Comprobante Institucional de Requisición Técnica"
  description="Acuse formal de requisición técnica con folio institucional para departamentos de compras y sistemas ERP corporativos."
  lang="es"
  canonicalPath="/acuse/"
  alternateEsPath="/acuse/"
  alternateEnPath="/en/thank-you/"
>
  <main class="ack-main">
    <div class="container ack-container">
      
      <!-- Hoja Ejecutiva Imprimible -->
      <div class="requisition-sheet" id="print-sheet">
        <!-- Membrete Corporativo Imprimible -->
        <div class="sheet-header">
          <div class="company-brand">
            <span class="brand-logo-text">SMAT MINERALS</span>
            <span class="brand-legacy">Equipos de Proceso y Refaccionamiento Minero</span>
            <span class="brand-address">Domicilio Fiscal: Mariano Salas #114, Durango, Dgo. CP 34166 • Almacén Central Durango</span>
            <span class="brand-contact">Tel: (618) 810-4408 / 4428 • ventas@smatminerals.com • smatminerals.com</span>
          </div>
          <div class="folio-box">
            <span class="folio-label">FOLIO DE REQUISICIÓN</span>
            <strong class="folio-value" id="display-folio">SMAT-2026-RFQ</strong>
            <span class="folio-date" id="display-date">Fecha de Emisión</span>
            <span class="folio-status" id="display-urgency">ESTATUS: RECIBIDO</span>
          </div>
        </div>

        <div class="sheet-divider"></div>

        <div class="sheet-title-bar">
          <h2 id="dossier-title">ACUSE FORMAL DE SOLICITUD DE COTIZACIÓN TÉCNICA</h2>
          <span class="badge-sla" id="dossier-order-code" data-hash-algo="fnv1a">ATENCIÓN PRIORITARIA • COTEJO EN ALMACÉN DURANGO</span>
        </div>

        <!-- Tabla de Datos del Solicitante -->
        <div class="sheet-section">
          <h3 class="section-title">1. DATOS DEL SOLICITANTE Y UNIDAD MINERA</h3>
          <table class="sheet-table">
            <tbody>
              <tr>
                <th style="width: 25%;">Solicitante / Cargo:</th>
                <td style="width: 35%;" id="field-name">No especificado</td>
                <th style="width: 20%;">Mina / Empresa:</th>
                <td style="width: 20%;" id="field-company">No especificado</td>
              </tr>
              <tr>
                <th>Teléfono / WhatsApp:</th>
                <td id="field-phone">No especificado</td>
                <th>Correo Corporativo:</th>
                <td id="field-email">No especificado</td>
              </tr>
              <tr>
                <th>Destino de Entrega:</th>
                <td colspan="3" id="field-destination">Almacén Central Durango / Retiro Coordinado con Folio</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Tabla de Especificación Técnica Solicitada -->
        <div class="sheet-section">
          <h3 class="section-title">2. ESPECIFICACIÓN TÉCNICA DEL COMPONENTE / EQUIPO</h3>
          <table class="sheet-table">
            <tbody>
              <tr>
                <th style="width: 25%;">Línea / Componente:</th>
                <td style="width: 35%;" id="field-role" class="highlight-spec">Equipo en evaluación</td>
                <th style="width: 20%;">Código SMAT / Pieza:</th>
                <td style="width: 20%; font-family: monospace; font-weight: 700;" id="field-code">Por asignar en revisión</td>
              </tr>
              <tr>
                <th>Referencia Interna / Tag:</th>
                <td id="field-client-ref">Sin referencia de placa declarada</td>
                <th>Medidas de Campo (Flexómetro):</th>
                <td id="field-dimensions">Verificación con patrón 1:1 en almacén</td>
              </tr>
              <tr>
                <th>Condiciones y Notas:</th>
                <td colspan="3" id="field-details">Revisión de parámetros de pulpa según protocolo de ingeniería.</td>
              </tr>
              <tr id="row-field-hydraulics">
                <th>Memoria Hidráulica (Durand):</th>
                <td colspan="3" id="field-hydraulics">Cálculo hidráulico sujeto a confirmación de flujo y % de sólidos en planta.</td>
              </tr>
              <tr id="row-field-material-drive">
                <th>Metalurgia, Arreglo y Estación:</th>
                <td colspan="3" id="field-material-drive">Alto Cromo ASTM A532 Cr27% (>600 HB) • Arreglo ZVZ • Estación S4 (Wet-End)</td>
              </tr>
              <tr id="row-field-clearance-kinematics">
                <th>Claro Axial (δ) y Cinemática:</th>
                <td colspan="3" id="field-clearance-kinematics">δ = 0.75 mm (Óptimo, Δη_v = -0.3%) • u₂ ≤ 24.5 m/s • Vida ISO 281 L₁₀ₕ certificada</td>
              </tr>
              <tr id="row-field-metrology">
                <th>Memoria Metrológica (Lab):</th>
                <td colspan="3" id="field-metrology">Sin pre-calibración de laboratorio adjunta (Balanza Marcy / Bond / Prensa).</td>
              </tr>
              <tr>
                <th>Continuidad y Perfil Mineral:</th>
                <td colspan="3" id="field-tco">Evaluación de continuidad operativa en Almacén Central Durango.</td>
              </tr>
              <tr>
                <th>Tipo de Solicitud:</th>
                <td id="field-type">Refacción de Desgaste / Continuidad Operativa</td>
                <th>Inspección en Almacén:</th>
                <td>Almacén Central Durango (Cotejo Dimensional A, B, C · ISO 2768-m)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Desglose Multi-Partida SAT CFDI 4.0 + TIGIE + Ciclo de Reorden -->
        <div class="sheet-section" id="acuse-multi-item-tray-section">
          <h3 class="section-title">2B. PARTIDAS DE LA REQUISICIÓN, TUPLA FISCAL SAT CFDI 4.0 Y CICLO DE REORDEN CONJUNTO</h3>
          <table class="sheet-table">
            <thead>
              <tr>
                <th style="width: 22%;">SKU / Aleación</th>
                <th style="width: 44%;">Descripción Técnica y Tupla Fiscal SAT / TIGIE</th>
                <th style="width: 10%;">Cant.</th>
                <th style="width: 24%;">Par Casado y Ciclo de Reorden</th>
              </tr>
            </thead>
            <tbody id="acuse-multi-item-tray-tbody">
              <tr>
                <td colspan="4" style="color: #64748b; font-size: 0.82rem;">Cargando partidas de requisición y tuplas SAT CFDI 4.0...</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Protocolo Técnico y Cláusula de Almacén Durango (Decisiones 1-C, 2-C y 6-C) -->
        <div class="sheet-section terms-section">
          <h3 class="section-title">3. PROTOCOLO TÉCNICO Y CONTROL DE CALIDAD EN ALMACÉN CENTRAL</h3>
          <p class="terms-text">
            Este acuse certifica el registro formal de su requerimiento en los sistemas de SMAT Minerals. Todo conjunto rotativo, impulsor y carcasa suministrada cuenta con certificado de colada High Chrome 27% (A05) con dureza garantizada &gt;650 HB (ASTM A532 HRC &ge; 58), cotejo dimensional de tripleta geométrica (A, B, C) bajo ISO 2768-m y atención prioritaria de despacho en instalaciones de SMAT Durango (Domicilio fiscal para facturación: Mariano Salas #114).
          </p>
          <div class="coyote-seal-notice facility-guarantee-notice" id="vendor-passport-section">
            <strong>Cláusula de Validez de Almacén Central y Pasaporte de Proveedor B2B:</strong> Esta propuesta técnica y su respaldo operativo son válidos para componentes inspeccionados y despachados en Almacén Central SMAT Durango (Incoterms EXW / DAP Durango • UNSPSC 40151500 / 20121500 / 40161500 / 41111500 • Certificación de Colada ASTM A532 Cr27 HRC &ge; 58). Equipos y paquetes acoplados completos se configuran bajo pedido según variables de pulpa del cliente; refacciones de desgaste comunes en rotación continua de inventario.
          </div>
          <pre id="sap-plaintext-block" data-hash-algo="fnv1a" style="margin: 1rem 0 0; padding: 0.85rem; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; font-family: monospace; font-size: 0.76rem; color: #0f172a; overflow-x: auto; white-space: pre-wrap;">FOLIO: SMAT-2026-RFQ | FOLIO DE VERIFICACIÓN TÉCNICA</pre>
          <div class="signatures-row">
            <div class="sig-block">
              <span class="sig-line"></span>
              <span class="sig-caption">Ingeniería y Ventas Técnicas<br />SMAT Minerals México</span>
            </div>
            <div class="sig-block">
              <span class="sig-line"></span>
              <span class="sig-caption">Recepción de Solicitud<br />Área de Compras / Mantenimiento</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Barra de Acciones en Pantalla (Oculta al Imprimir) -->
      <div class="screen-actions no-print">
        <button type="button" class="btn btn-primary btn-print" id="print-btn" onclick="window.print()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Imprimir / Guardar en PDF (SAP / Coupa)
        </button>
        <button type="button" class="btn btn-secondary" id="copy-sap-acuse-btn">
          Copiar Texto SAP / Ariba
        </button>
        <button type="button" class="btn btn-secondary" id="download-tsv-acuse-btn">
          Descargar TSV / Excel
        </button>
        <button type="button" class="btn btn-secondary" id="download-vendor-vcard-btn">
          Pasaporte Proveedor (.vcf)
        </button>
        <button type="button" class="btn btn-secondary" id="download-vendor-json-btn">
          Ficha Alta ERP (.json)
        </button>
        <a href="/cotizar/?reorder=1&tray=SMAT-PUMP-IMP-AH:1:PARO_DE_LINEA#rfq" class="btn btn-secondary" id="reorder-ss-link">
          Reorden Preventivo en 1 Clic
        </a>
        <a href="/" class="btn btn-secondary">
          Volver al Inicio
        </a>
        <a href="https://wa.me/526183670664" class="btn btn-emergency" target="_blank" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          Seguimiento Inmediato por WhatsApp
        </a>
      </div>

    </div>
  </main>
</BaseLayout>

<script>
  import { initAcuseSheetController, enrichTrayItemsPreservingMetadata } from '../scripts/acuseSheetController.js';
  /*
   * Hidratación canónica PutGet (smat_workbench_state_v2):
   * urlParams.get('material') | urlParams.get('claro_mm') | urlParams.get('u2_ms') | urlParams.get('l10h')
   * material === 'poliuretano' | material === 'ceramica_sic' (≥2200 HV, K_Ic=4.1 MPa·√m)
   * Ergonomía Waters-NIOSH 1993 (RWL_shaft = 11.1 kg): HOIST_REQUIRED | ASSISTED_SHAFT_MOUNT_2P | MANUAL_SAFE_1P
   * Métricas físicas: eff_ratio_er, impeller_life_h, delta_npsh_m, k_motor_alt, pipe_vel_loss_pct, gate_classification
   */
  void enrichTrayItemsPreservingMetadata;
  initAcuseSheetController('es');
</script>

<style>
  .ack-main {
    padding: 3rem 1.5rem 5rem;
    background-color: var(--smat-bg-page);
  }

  .ack-container {
    max-width: 880px;
    margin: 0 auto;
  }

  .requisition-sheet {
    background: #ffffff;
    color: #0f172a;
    border-radius: 8px;
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .sheet-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .company-brand {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .brand-logo-text {
    font-size: 1.5rem;
    font-weight: 900;
    color: #ea580c;
    letter-spacing: -0.02em;
  }

  .brand-legacy {
    font-size: 0.85rem;
    font-weight: 700;
    color: #475569;
  }

  .brand-address, .brand-contact {
    font-size: 0.75rem;
    color: #64748b;
  }

  .folio-box {
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .folio-label {
    font-size: 0.7rem;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.05em;
  }

  .folio-value {
    font-size: 1.3rem;
    font-weight: 900;
    color: #0f172a;
    font-family: monospace;
  }

  .folio-date {
    font-size: 0.75rem;
    color: #64748b;
  }

  .folio-status {
    font-size: 0.75rem;
    font-weight: 800;
    color: #16a34a;
    margin-top: 0.25rem;
  }

  .sheet-divider {
    height: 2px;
    background: #e2e8f0;
    margin: 1.5rem 0;
  }

  .sheet-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sheet-title-bar h2 {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .badge-sla {
    background: #ffedd5;
    color: #c2410c;
    border: 1px solid #fed7aa;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .sheet-section {
    margin-bottom: 1.5rem;
  }

  .section-title {
    font-size: 0.82rem;
    font-weight: 800;
    color: #334155;
    letter-spacing: 0.04em;
    border-bottom: 1px solid #cbd5e1;
    padding-bottom: 0.35rem;
    margin-bottom: 0.75rem;
  }

  .sheet-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .sheet-table th, .sheet-table td {
    border: 1px solid #e2e8f0;
    padding: 0.6rem 0.75rem;
    text-align: left;
  }

  .sheet-table th {
    background-color: #f8fafc;
    color: #475569;
    font-weight: 700;
  }

  .sheet-table td {
    color: #0f172a;
  }

  .highlight-spec {
    font-weight: 700;
    color: #ea580c;
  }

  .terms-text {
    font-size: 0.78rem;
    color: #64748b;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .coyote-seal-notice {
    font-size: 0.74rem;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-left: 3px solid #ea580c;
    padding: 0.75rem 1rem;
    color: #334155;
    line-height: 1.45;
    margin-bottom: 2rem;
    border-radius: 4px;
  }

  .signatures-row {
    display: flex;
    justify-content: space-around;
    margin-top: 3rem;
  }

  .sig-block {
    text-align: center;
    width: 240px;
  }

  .sig-line {
    display: block;
    border-top: 1px solid #94a3b8;
    margin-bottom: 0.5rem;
  }

  .sig-caption {
    font-size: 0.75rem;
    color: #475569;
    line-height: 1.35;
  }

  .screen-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .btn-print {
    background: #0c4a6e;
    color: #ffffff;
    font-size: 0.95rem;
    padding: 0.75rem 1.5rem;
  }

  .btn-print:hover {
    background: #082f49;
  }

  @media (max-width: 640px) {
    .ack-main {
      padding: 0.65rem 0.5rem 2rem;
    }
    .requisition-sheet {
      padding: 0.85rem;
    }
    .sheet-header {
      gap: 0.5rem;
    }
    .brand-logo-text {
      font-size: 1.15rem;
    }
    .brand-address, .brand-contact {
      display: none;
    }
    .folio-box {
      text-align: left;
    }
    .folio-value {
      font-size: 1rem;
    }
    .sheet-divider {
      margin: 0.5rem 0;
    }
    .sheet-title-bar {
      margin-bottom: 0.5rem;
    }
    .sheet-title-bar h2 {
      font-size: 0.88rem;
    }
    .sheet-section {
      margin-bottom: 0.75rem;
    }
    .section-title {
      margin-bottom: 0.35rem;
    }
  }

  /* ESTILOS DE IMPRESIÓN ESTRICTOS PARA ERP (SAP/COUPA) */
  @media print {
    body {
      background: #ffffff !important;
      color: #000000 !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .no-print, header, footer, .screen-actions, #nav-header, #main-footer {
      display: none !important;
    }

    .ack-main {
      padding: 0 !important;
      background: none !important;
    }

    .ack-container {
      max-width: 100% !important;
      margin: 0 !important;
    }

    .requisition-sheet {
      box-shadow: none !important;
      padding: 0 !important;
      border: none !important;
      border-radius: 0 !important;
    }

    @page {
      margin: 1.5cm;
      size: letter portrait;
    }
  }
</style>
