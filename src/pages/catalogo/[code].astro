---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtomicPartIsland from '../../components/islands/AtomicPartIsland.astro';
import atomicParts from '../../../data/atomic_parts.json';

export function getStaticPaths() {
  return atomicParts.map((part) => ({
    params: { code: part.code },
    props: { part, routeSlug: part.code, altEnSlug: part.code },
  }));
}

const { part, routeSlug, altEnSlug } = Astro.props;
const canonicalPath = `/catalogo/${routeSlug || part.code}/`;
const title = `${part.part_number} — ${part.name_es} | SMAT Minerals`;
const description = `Refacción ${part.part_number}: ${part.type_es} en aleación ${part.metallurgy} (${part.hardness}). Despacho directo desde Almacén Central Durango.`;
---

<BaseLayout title={title} description={description} lang="es" canonicalPath={canonicalPath} alternateEsPath={canonicalPath} alternateEnPath={`/en/catalog/${altEnSlug || part.code}/`}>
  <AtomicPartIsland locale="es" part={part} routeSlug={routeSlug} />
</BaseLayout>
