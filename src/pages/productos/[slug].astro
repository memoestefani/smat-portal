---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductQuickCard from '../../components/ProductQuickCard.astro';
import JrpReorderCore from '../../components/cores/JrpReorderCore.astro';
import { getAllStaticProductRouteEntries, getQuickProductBySlugOrAlias } from '../../scripts/quickProductsCatalog.js';
import '../../styles/productSlugSolar.css';

export function getStaticPaths() {
  const entries = getAllStaticProductRouteEntries('es');
  return entries.map((entry) => ({
    params: { slug: entry.routeSlug },
    props: {
      sku: entry.sku,
      isCanonical: entry.isCanonical,
      canonicalSlug: entry.canonicalSlug
    }
  }));
}

const { sku, canonicalSlug } = Astro.props;
const pageTitle = `${sku.title_es} | Compra Rápida SMAT Minerals`;
const pageDescription = `${sku.summary_es} Referencia cruzada Drop-In: ${sku.oem_cross_ref}. Dureza: ${sku.hardness_spec}.`;
const canonicalPath = `/productos/${canonicalSlug || sku.slug_es}/`;
const sat = sku.sat_tuple || {
  clave_prod_serv: '40142000',
  clave_unidad: 'H87',
  fraccion_arancelaria: '8413.91.99.00'
};
const triplet = sku.geometric_triplet_mm || {
  a_id_mm: 100,
  b_od_mm: 400,
  c_thickness_mm: 80,
  tolerance_std: 'ISO 2768-m',
  label_es: 'A: Ø Int. 100 mm | B: Ø Ext. 400 mm | C: Espesor 80 mm'
};

const nioshBadges: Record<string, { label: string; cls: string }> = {
  MANUAL_SAFE: {
    label: 'Manejo Manual Seguro (< 11.1 kg NIOSH)',
    cls: 'smat-slug-badge--emerald'
  },
  ASSISTED_SHAFT_MOUNT_2P: {
    label: 'Montaje Asistido 2 Operadores (11.1–23.0 kg NIOSH)',
    cls: 'smat-slug-badge--amber'
  },
  HOIST_REQUIRED: {
    label: 'Izaje Mecánico Obligatorio (> 23.0 kg NOM-036-1-STPS)',
    cls: 'smat-slug-badge--rose'
  }
};
const niosh = nioshBadges[sku.niosh_mode] || nioshBadges.HOIST_REQUIRED;
const hasAtomicPumpCodes = Array.isArray(sku.atomic_codes) && sku.atomic_codes.length > 0;
const castCodeLabel = hasAtomicPumpCodes ? sku.atomic_codes.join(', ') : sku.id;
const coupledSku = getQuickProductBySlugOrAlias(sku.coupled_pair_sku);
const telemetryLabelsByVertical: Record<string, { sg: string; d50: string; life: string }> = {
  control: {
    sg: 'Rango Densidad / SG (Marcy)',
    d50: 'Abertura Granulométrica (ASTM E11)',
    life: 'Ciclo de Calibración / Vida Útil'
  },
  filtracion: {
    sg: 'Densidad Pulpa Alimentación Prensa',
    d50: 'Granulometría de Torta (d50)',
    life: 'Vida Media Operativa (Lona / Placa)'
  },
  flotacion: {
    sg: 'Densidad de Pulpa en Celda',
    d50: 'Granulometría de Liberación (d80)',
    life: 'Vida Útil Operativa Rotor-Estator'
  },
  clasificacion: {
    sg: 'Densidad Alimentación Ciclón / Criba',
    d50: 'Corte Granulométrico d50c',
    life: 'Vida Útil Ápex SiC / Malla PU'
  }
};
const telLabels = telemetryLabelsByVertical[sku.vertical] || {
  sg: 'Densidad Pulpa (Marcy SG)',
  d50: 'Corte Granulométrico d50c',
  life: 'Vida Útil Típica en Planta'
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalPath}
  canonicalPath={canonicalPath}
  alternateEsPath={`/productos/${sku.slug_es}/`}
  alternateEnPath={`/en/products/${sku.slug_en}/`}
  lang="es"
>
  <section class="smat-slug-main">
    <!-- Migas de pan -->
    <nav class="smat-slug-breadcrumb" aria-label="Breadcrumb">
      <div class="smat-slug-breadcrumb-links">
        <a href="/" class="smat-slug-nav-link">Inicio</a>
        <span>/</span>
        <a href="/catalogo/" class="smat-slug-nav-link">Catálogo 19 SKUs</a>
        <span>/</span>
        <span class="smat-slug-breadcrumb-current">{sku.id}</span>
      </div>
    </nav>

    <!-- Cabecera Plano 1: Identificación rápida en < 30 segundos -->
    <header class="smat-slug-header">
      <div class="smat-slug-badge-row">
        <span class="smat-slug-badge smat-slug-badge--amber">
          {sku.id} · {sku.vertical.toUpperCase()} · RÉGIMEN {sku.gate_lock || 'G1'}
        </span>
        <span class={`smat-slug-badge ${niosh.cls}`}>
          {niosh.label}
        </span>
        <span class="smat-slug-badge smat-slug-badge--neutral">
          Masa Seca: {sku.mass_kg} kg
        </span>
      </div>

      <h1 class="smat-slug-h1">
        {sku.title_es}
      </h1>
      <p class="smat-slug-lead">
        {sku.summary_es}
      </p>

      <!-- Estrato 1: Ventana Preventiva de Reemplazo 3 Hitos + Par Casado Sincronizado -->
      <div id="stratum1-slug-card" data-stratum-1-instrument class="smat-jrp-slug-host">
        <details class="wb-progressive-drawer" id="slug-jrp-drawer">
          <summary class="wb-progressive-summary">
            <span>Planificador preventivo de reorden 5-5-4 y Par Casado</span>
            <span>▾</span>
          </summary>
          <div class="smat-mt-sm">
            <JrpReorderCore
              lang="es"
              mode="slug"
              skuId={sku.id}
              partCode={sku.atomic_codes?.[0] || sku.id}
              title={sku.title_es}
              series={(sku as any).series || '6x4'}
              material={sku.default_material || 'A05'}
              circuit={sku.vertical || 'bombeo'}
              coupledSkuId={sku.coupled_pair_sku || 'SMAT-PUMP-TB-083'}
              coupledTitle={coupledSku ? coupledSku.title_es : (sku.coupled_pair_sku || 'SMAT-PUMP-TB-083')}
              reorderDays={Number(sku.reorder_window_days) || 90}
              traySource="product_slug_stratum1"
              showTradeIn={false}
              showPrimaryTrayBtn={true}
              showPairBtn={true}
            />
          </div>
        </details>
      </div>

      <div class="smat-slug-kpi-grid">
        <div class="smat-slug-kpi-box">
          <div class="smat-slug-kpi-label">Referencia Cruzada Drop-In Cero-OEM</div>
          <div class="smat-slug-kpi-value smat-slug-kpi-value--amber">{sku.oem_cross_ref}</div>
        </div>
        <div class="smat-slug-kpi-box">
          <div class="smat-slug-kpi-label">Metalurgia / Dureza Certificada</div>
          <div class="smat-slug-kpi-value">{sku.hardness_spec}</div>
        </div>
        <div class="smat-slug-kpi-box">
          <div class="smat-slug-kpi-label">Ventana Preventiva de Reorden</div>
          <div class="smat-slug-kpi-value smat-slug-kpi-value--sky">Cada {sku.reorder_window_days} días · Par: {sku.coupled_pair_sku}</div>
        </div>
      </div>
    </header>

    <!-- Cuerpo en 2 columnas: ProductQuickCard 3-en-1 + Checkout Dual y Validación en 3 Pasos -->
    <div class="smat-slug-layout-grid">
      <div class="smat-slug-col-left">
        <ProductQuickCard sku={sku} lang="es" mode="media-only" />

        <!-- Recuadro PRD v3.0: Cómo validar tu pieza en planta en 3 pasos -->
        <section class="smat-slug-validation-card">
          <h2 class="smat-slug-section-kicker smat-slug-section-kicker--emerald">
            Cómo validar tu pieza en planta en 3 pasos (Cero Riesgo de Paro)
          </h2>
          <ol class="smat-slug-steps-grid">
            <li class="smat-slug-step-item">
              <strong class="smat-slug-step-title">PASO 1 · CÓDIGO / PLACA</strong>
              Verifica el identificador de tu equipo ({castCodeLabel}) o envíanos foto por WhatsApp desde patio.
            </li>
            <li class="smat-slug-step-item">
              <strong class="smat-slug-step-title">PASO 2 · TRIPLETA (A, B, C)</strong>
              Confirma con cinta o vernier: <span class="smat-slug-mono-inline">{triplet.label_es}</span> ({triplet.tolerance_std || 'ISO 2768-m'}).
            </li>
            <li class="smat-slug-step-item">
              <strong class="smat-slug-step-title">PASO 3 · ESCALA 0.76 MM</strong>
              Al montar, calibra el claro o asiento usando 1 tarjeta bancaria estándar ISO/IEC 7810 (0.76 mm).
            </li>
          </ol>
        </section>

        <!-- Telemetría Operativa Acoplada (Plano 1 -> Plano 2 Workbench) -->
        <section class="smat-slug-telemetry-card">
          <h2 class="smat-slug-section-kicker">
            Ventana de Operación Metalúrgica Recomendada
          </h2>
          <div class="smat-slug-telemetry-grid">
            <div class="smat-slug-telemetry-box">
              <div class="smat-slug-telemetry-label">{telLabels.sg}</div>
              <div class="smat-slug-telemetry-val smat-slug-telemetry-val--amber">
                {sku.telemetry_hooks.marcy_sg_range[0]} – {sku.telemetry_hooks.marcy_sg_range[1]} t/m³
              </div>
            </div>
            <div class="smat-slug-telemetry-box">
              <div class="smat-slug-telemetry-label">{telLabels.d50}</div>
              <div class="smat-slug-telemetry-val smat-slug-telemetry-val--sky">
                {sku.telemetry_hooks.plitt_d50_um_range[0]} – {sku.telemetry_hooks.plitt_d50_um_range[1]} µm
              </div>
            </div>
            <div class="smat-slug-telemetry-box">
              <div class="smat-slug-telemetry-label">{telLabels.life}</div>
              <div class="smat-slug-telemetry-val smat-slug-telemetry-val--emerald">
                {sku.telemetry_hooks.wear_life_hours_range[0]} – {sku.telemetry_hooks.wear_life_hours_range[1]} h
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Columna derecha: Checkout Dual (< 25,000 MXN Caja Chica vs > 25,000 MXN OC SAP) -->
      <aside class="smat-slug-checkout-aside">
        <div class="smat-slug-aside-head">
          <span class="smat-slug-aside-kicker">
            Checkout B2B Dual (Sin Registro)
          </span>
          <span class="smat-slug-aside-hub">● Almacén Durango, Dgo.</span>
        </div>

        <div>
          <h2 class="smat-slug-aside-h2">1. Aleaciones / Materiales Disponibles</h2>
          <div class="smat-slug-chip-row">
            {sku.available_materials.map((mat: string) => (
              <span role="button" tabindex="0" data-mat-code={mat} class={`smat-slug-mat-chip ${mat === sku.default_material ? 'is-default' : ''}`}>
                {mat} {mat === sku.default_material ? '(Estándar)' : ''}
              </span>
            ))}
          </div>
        </div>

        <details class="wb-progressive-drawer" id="slug-coupled-and-codes-drawer">
          <summary class="wb-progressive-summary">
            <span>Códigos atómicos vinculados y Par Casado ({sku.coupled_pair_sku})</span>
            <span>▾</span>
          </summary>
          <div class="smat-mt-sm">
            {hasAtomicPumpCodes && (
              <div class="smat-slug-atomic-wrap">
                <h3 class="smat-slug-aside-h3">2A. Códigos Atómicos Vinculados (13-Part BOM Bombeo)</h3>
                <div class="smat-slug-chip-row">
                  {sku.atomic_codes.map((code: string) => (
                    <a
                      href={`/catalogo/${code.toLowerCase()}/`}
                      class="smat-slug-atomic-link"
                    >
                      {code}
                    </a>
                  ))}
                </div>
              </div>
            )}
            <h3 class="smat-slug-aside-h3">2. Acoplamiento de Circuito y Ciclo de Reorden Preventivo</h3>
            <div class="smat-slug-coupled-box" data-coupled-sku={sku.coupled_pair_sku} data-reorder-days={String(sku.reorder_window_days)}>
              <div>
                <strong>SKU Acoplado Recomendado:</strong>{' '}
                {coupledSku ? (
                  <a href={`/productos/${coupledSku.slug_es}/`} class="smat-slug-atomic-link smat-slug-atomic-link--inline">
                    {sku.coupled_pair_sku} — {coupledSku.title_es} →
                  </a>
                ) : (
                  <span>{sku.coupled_pair_sku}</span>
                )}
              </div>
              <div>
                <strong>Ciclo de Reorden Preventivo:</strong> <span>Cada {sku.reorder_window_days} días operativos (Lote #{sku.kit_id || 1})</span>
              </div>
              {coupledSku && (
                <div class="smat-slug-coupled-cta-wrap">
                  <button
                    type="button"
                    data-quick-tray-add={coupledSku.id}
                    data-add-coupled-pair-btn={coupledSku.id}
                    data-sku-title={coupledSku.title_es}
                    data-sku-code={coupledSku.atomic_codes?.[0] || coupledSku.id}
                    data-sku-material={coupledSku.default_material || 'A05'}
                    data-sku-regime={coupledSku.stock_regime || 'hay'}
                    data-sku-mass={String(coupledSku.mass_kg || 15)}
                    class="smat-slug-atomic-link smat-slug-coupled-btn"
                  >
                    + Agregar Par Casado Sincronizado ({coupledSku.id}) a Bandeja
                  </button>
                </div>
              )}
            </div>
          </div>
        </details>

        <!-- Carril Dual de Compra Rápida (PRD v3.0 §6.2) -->
        <div class="smat-slug-lanes-stack">
          <div class="smat-slug-lane-card smat-slug-lane-card--emerald">
            <div class="smat-slug-lane-head">
              <span class="smat-slug-lane-title smat-slug-lane-title--emerald">CARRIL A: CAJA CHICA (&lt; 25,000 MXN)</span>
              <span class="smat-slug-lane-tag smat-slug-lane-tag--emerald">P1 · CFDI 4.0 HOY</span>
            </div>
            <p class="smat-slug-lane-desc">
              Liberación exprés por SPEI o Tarjeta Corporativa sin alta de proveedor SAP. Salida el mismo día para piezas en régimen <strong>HAY</strong>.
            </p>
          </div>

          <div class="smat-slug-lane-card smat-slug-lane-card--amber">
            <div class="smat-slug-lane-head">
              <span class="smat-slug-lane-title smat-slug-lane-title--amber">CARRIL B: ORDEN DE COMPRA (&gt; 25,000 MXN)</span>
              <span class="smat-slug-lane-tag smat-slug-lane-tag--amber">SAP / ORACLE · PASAPORTE B2B</span>
            </div>
            <p class="smat-slug-lane-desc">
              Cotización formal PDF con Constancia Fiscal, Opinión 32-D Positiva y REPSE vigente.
            </p>
            <div class="smat-slug-sat-pill">
              SAT ProdServ: <strong>{sat.clave_prod_serv}</strong> · Unidad: <strong>{sat.clave_unidad}</strong> · TIGIE: <strong>{sat.fraccion_arancelaria}</strong>
            </div>
          </div>
        </div>

        <div class="smat-slug-passport-box">
          <div class="smat-slug-passport-title">Incluye Pasaporte de Proveedor SMAT:</div>
          <p>• Certificado Metalúrgico de Colada (PMI / Dureza Brinell ASTM A532)</p>
          <p>• Cotejo Dimensional de Tripleta Geométrica (ISO 2768-m) en Durango</p>
          <p>• Huella de Seguridad NIOSH / NOM-036-1-STPS para Maniobra en Patio</p>
        </div>

        {(sku.id === 'SMAT-PUMP-BRG-005M' || (Array.isArray(sku.atomic_codes) && sku.atomic_codes.includes('DAM005'))) && (
          <JrpReorderCore
            lang="es"
            mode="tradein"
            skuId={sku.id}
            showJrpCard={false}
            showTradeIn={true}
          />
        )}

        <div class="smat-slug-cta-stack">
          <button
            type="button"
            data-quick-tray-add={sku.id}
            data-slug-add-to-tray={sku.id}
            data-sku-title={sku.title_es}
            data-sku-code={sku.atomic_codes[0] || sku.id}
            data-sku-material={sku.default_material}
            data-sku-regime={sku.stock_regime || 'hay'}
            data-sku-mass={sku.mass_kg}
            class="smat-slug-btn-primary"
          >
            Agregar a Bandeja B2B / Solicitar Pasaporte SAP ({sku.id}) →
          </button>
          <a
            href={`https://wa.me/526183670664?text=${encodeURIComponent(`[SMAT-DGO] Hola SMAT, requiero cotizar SKU ${sku.id} (${sku.title_es}) en aleación ${sku.default_material} [ Régimen: ${sku.stock_regime || 'hay'} | Masa: ${sku.mass_kg} kg ].`)}`}
            target="_blank"
            rel="noopener noreferrer"
            data-slug-wa-btn={sku.id}
            data-sku-id={sku.id}
            data-sku-title={sku.title_es}
            data-sku-regime={sku.stock_regime || 'hay'}
            data-sku-mass={String(sku.mass_kg)}
            data-sku-lang="es"
            class="smat-slug-btn-wa"
          >
            Compra Rápida / Caja Chica por WhatsApp Ingeniería (526183670664)
          </a>
          <a
            href={`/cotizar/?sku=${encodeURIComponent(sku.id)}&mat=${encodeURIComponent(sku.default_material)}#rfq`}
            data-home-workbench={`/?sku=${encodeURIComponent(sku.id)}&mat=${encodeURIComponent(sku.default_material)}#workbench`}
            data-slug-workbench-btn={sku.id}
            data-workbench-anchor="#workbench"
            data-sku-id={sku.id}
            data-sku-lang="es"
            class="smat-slug-btn-workbench"
          >
            Abrir en Simulador Hidráulico y Metalúrgico (Plano 2)
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import { initCoreTradeInWidgets } from '../../scripts/vendorPassportAndTradeInController.js';
  import { initHarmonicJrpWindowAndPairCard } from '../../scripts/catalogDropInAndJrpProjector.js';

  function initSlugSheetEs() {
    if (typeof document === 'undefined') return;
    initCoreTradeInWidgets(document, 'es');
    initHarmonicJrpWindowAndPairCard(document, 'es');
    const winEl = document.getElementById('wb-jrp-window-days');
    if (winEl && !winEl.dataset.sepAdded) {
      winEl.dataset.sepAdded = '1';
      winEl.insertAdjacentText('afterend', ' · ');
    }
    const chips = document.querySelectorAll('.smat-slug-mat-chip[data-mat-code]');
    const trayBtn = document.querySelector('[data-slug-add-to-tray]');
    const waBtn = document.querySelector('[data-slug-wa-btn]') as HTMLAnchorElement | null;
    const wbBtn = document.querySelector('[data-slug-workbench-btn]') as HTMLAnchorElement | null;
    const activateSlugMatChip = (chip: Element) => {
      const mat = chip.getAttribute('data-mat-code') || '';
      if (!mat) return;
      chips.forEach((c) => {
        const isCurrent = c === chip;
        c.classList.toggle('is-default', isCurrent);
        c.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
      });
      if (trayBtn) {
        trayBtn.setAttribute('data-sku-material', mat);
      }
      if (waBtn) {
        const skuId = waBtn.getAttribute('data-sku-id') || '';
        const skuTitle = waBtn.getAttribute('data-sku-title') || '';
        const regime = waBtn.getAttribute('data-sku-regime') || 'hay';
        const mass = waBtn.getAttribute('data-sku-mass') || '15';
        const msg = `[SMAT-DGO] Hola SMAT, requiero cotizar SKU ${skuId} (${skuTitle}) en aleación ${mat} [ Régimen: ${regime} | Masa: ${mass} kg ].`;
        waBtn.href = `https://wa.me/526183670664?text=${encodeURIComponent(msg)}`;
      }
      if (wbBtn) {
        const skuId = wbBtn.getAttribute('data-sku-id') || '';
        wbBtn.href = `/cotizar/?sku=${encodeURIComponent(skuId)}&mat=${encodeURIComponent(mat)}#rfq`;
        wbBtn.setAttribute('data-home-workbench', `/?sku=${encodeURIComponent(skuId)}&mat=${encodeURIComponent(mat)}#workbench`);
      }
    };
    chips.forEach((chip) => {
      if ((chip as HTMLElement).dataset?.slugChipBound === '1') return;
      if ((chip as HTMLElement).dataset) (chip as HTMLElement).dataset.slugChipBound = '1';
      chip.addEventListener('click', () => activateSlugMatChip(chip));
      chip.addEventListener('keydown', (ev: Event) => {
        const ke = ev as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault();
          activateSlugMatChip(chip);
        }
      });
    });
  }
  initSlugSheetEs();
  document.addEventListener('astro:page-load', initSlugSheetEs);
</script>

