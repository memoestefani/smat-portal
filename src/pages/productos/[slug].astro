---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductQuickCard from '../../components/ProductQuickCard.astro';
import { getAllStaticProductRouteEntries } from '../../scripts/quickProductsCatalog.js';

export function getStaticPaths() {
  const entries = getAllStaticProductRouteEntries('es');
  return entries.map((entry) => ({
    params: { slug: entry.routeSlug },
    props: {
      sku: entry.sku,
      isCanonical: entry.isCanonical,
      canonicalSlug: entry.canonicalSlug
    }
  }));
}

const { sku, canonicalSlug } = Astro.props;
const pageTitle = `${sku.title_es} | Compra Rápida SMAT Minerals`;
const pageDescription = `${sku.summary_es} Referencia cruzada Drop-In: ${sku.oem_cross_ref}. Dureza: ${sku.hardness_spec}.`;
const canonicalPath = `/productos/${canonicalSlug || sku.slug_es}/`;
const sat = sku.sat_tuple || {
  clave_prod_serv: '40142000',
  clave_unidad: 'H87',
  fraccion_arancelaria: '8413.91.99.00'
};
const triplet = sku.geometric_triplet_mm || {
  a_id_mm: 100,
  b_od_mm: 400,
  c_thickness_mm: 80,
  tolerance_std: 'ISO 2768-m',
  label_es: 'A: Ø Int. 100 mm | B: Ø Ext. 400 mm | C: Espesor 80 mm'
};

const nioshBadges: Record<string, { label: string; color: string }> = {
  MANUAL_SAFE: {
    label: '🟢 Manejo Manual Seguro (< 11.1 kg NIOSH)',
    color: 'bg-emerald-950/70 text-emerald-300 border-emerald-500/40'
  },
  ASSISTED_SHAFT_MOUNT_2P: {
    label: '🟡 Montaje Asistido 2 Operadores (11.1–23.0 kg NIOSH)',
    color: 'bg-amber-950/70 text-amber-300 border-amber-500/40'
  },
  HOIST_REQUIRED: {
    label: '🔴 Izaje Mecánico Obligatorio (> 23.0 kg NOM-036-1-STPS)',
    color: 'bg-rose-950/70 text-rose-300 border-rose-500/40'
  }
};
const niosh = nioshBadges[sku.niosh_mode] || nioshBadges.HOIST_REQUIRED;
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalPath} lang="es">
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 text-slate-100">
    <!-- Migas de pan y selector de idioma -->
    <nav class="flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-slate-400 mb-6" aria-label="Breadcrumb">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-amber-400 transition">Inicio</a>
        <span>/</span>
        <a href="/catalogo/" class="hover:text-amber-400 transition">Catálogo 19 SKUs</a>
        <span>/</span>
        <span class="text-amber-400">{sku.id}</span>
      </div>
      <a href={`/en/products/${sku.slug_en}/`} class="inline-flex items-center gap-1.5 px-3 py-1 rounded border border-slate-700 hover:border-amber-400 text-slate-300">
        <span>EN</span>
        <span>English Spec Sheet →</span>
      </a>
    </nav>

    <!-- Cabecera Plano 1: Identificación rápida en < 30 segundos -->
    <header class="rounded-2xl border border-slate-800 bg-slate-900/90 p-6 sm:p-8 shadow-xl mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-2.5 py-1 rounded text-xs font-mono uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/40">
          {sku.id} · {sku.vertical.toUpperCase()} · CANDADO {sku.gate_lock || 'G1'}
        </span>
        <span class={`px-2.5 py-1 rounded text-xs font-mono border ${niosh.color}`}>
          {niosh.label}
        </span>
        <span class="px-2.5 py-1 rounded text-xs font-mono bg-slate-800 text-slate-300 border border-slate-700">
          Masa Seca: {sku.mass_kg} kg
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white mb-3">
        {sku.title_es}
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-4xl mb-5">
        {sku.summary_es}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-slate-800 text-sm">
        <div class="bg-slate-950/70 rounded-xl p-3.5 border border-slate-800/80">
          <div class="text-xs font-mono uppercase text-slate-400 mb-1">Referencia Cruzada Drop-In Cero-OEM</div>
          <div class="font-mono font-semibold text-amber-300">{sku.oem_cross_ref}</div>
        </div>
        <div class="bg-slate-950/70 rounded-xl p-3.5 border border-slate-800/80">
          <div class="text-xs font-mono uppercase text-slate-400 mb-1">Metalurgia / Dureza Certificada</div>
          <div class="font-semibold text-slate-100">{sku.hardness_spec}</div>
        </div>
        <div class="bg-slate-950/70 rounded-xl p-3.5 border border-slate-800/80">
          <div class="text-xs font-mono uppercase text-slate-400 mb-1">Escala Cotidiana de Calibración (ISO/IEC 7810)</div>
          <div class="font-semibold text-sky-300">{sku.everyday_scale_es}</div>
        </div>
      </div>
    </header>

    <!-- Cuerpo en 2 columnas: ProductQuickCard 3-en-1 + Checkout Dual y Validación en 3 Pasos -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 space-y-6">
        <ProductQuickCard sku={sku} lang="es" />

        <!-- Recuadro PRD v3.0: Cómo validar tu pieza en planta en 3 pasos -->
        <section class="rounded-2xl border border-emerald-500/30 bg-emerald-950/15 p-5">
          <h2 class="text-sm font-mono uppercase tracking-wider text-emerald-300 mb-3">
            📋 Cómo validar tu pieza en planta en 3 pasos (Cero Riesgo de Paro)
          </h2>
          <ol class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-slate-300">
            <li class="rounded-xl bg-slate-950/80 border border-slate-800 p-3">
              <strong class="block font-mono text-amber-300 mb-1">PASO 1 · CÓDIGO FUNDIDO</strong>
              Verifica el número en relieve de tu pieza actual ({sku.atomic_codes.join(', ')}) o envíanos foto por WhatsApp desde patio.
            </li>
            <li class="rounded-xl bg-slate-950/80 border border-slate-800 p-3">
              <strong class="block font-mono text-amber-300 mb-1">PASO 2 · TRIPLETA (A, B, C)</strong>
              Confirma con cinta o vernier: <span class="font-mono text-slate-100">{triplet.label_es}</span> ({triplet.tolerance_std || 'ISO 2768-m'}).
            </li>
            <li class="rounded-xl bg-slate-950/80 border border-slate-800 p-3">
              <strong class="block font-mono text-amber-300 mb-1">PASO 3 · ESCALA 0.76 MM</strong>
              Al montar, calibra el claro axial usando 1 tarjeta bancaria estándar ISO/IEC 7810 (0.76 mm).
            </li>
          </ol>
        </section>

        <!-- Telemetría Operativa Acoplada (Plano 1 -> Plano 2 Workbench) -->
        <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
          <h2 class="text-sm font-mono uppercase tracking-wider text-slate-400 mb-3">
            Ventana de Operación Metalúrgica Recomendada
          </h2>
          <div class="grid grid-cols-3 gap-3 text-center">
            <div class="rounded-xl bg-slate-950 p-3 border border-slate-800">
              <div class="text-xs text-slate-400 font-mono">Densidad Pulpa (Marcy SG)</div>
              <div class="text-lg font-bold text-amber-400 font-mono">
                {sku.telemetry_hooks.marcy_sg_range[0]} – {sku.telemetry_hooks.marcy_sg_range[1]} t/m³
              </div>
            </div>
            <div class="rounded-xl bg-slate-950 p-3 border border-slate-800">
              <div class="text-xs text-slate-400 font-mono">Corte Granulométrico d50c</div>
              <div class="text-lg font-bold text-sky-400 font-mono">
                {sku.telemetry_hooks.plitt_d50_um_range[0]} – {sku.telemetry_hooks.plitt_d50_um_range[1]} µm
              </div>
            </div>
            <div class="rounded-xl bg-slate-950 p-3 border border-slate-800">
              <div class="text-xs text-slate-400 font-mono">Vida Útil Típica (Weibull)</div>
              <div class="text-lg font-bold text-emerald-400 font-mono">
                {sku.telemetry_hooks.wear_life_hours_range[0]} – {sku.telemetry_hooks.wear_life_hours_range[1]} h
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Columna derecha: Checkout Dual (< 25,000 MXN Caja Chica vs > 25,000 MXN OC SAP) -->
      <aside class="lg:col-span-5 rounded-2xl border border-amber-500/40 bg-slate-900 p-6 shadow-xl space-y-5">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <span class="text-xs font-mono uppercase tracking-wider text-amber-400">
            Checkout B2B Dual (Sin Registro)
          </span>
          <span class="text-xs font-mono text-emerald-400">● Almacén Durango, Dgo.</span>
        </div>

        <div>
          <h2 class="text-lg font-bold text-white mb-2">1. Aleaciones Disponibles en Fundición / Moldeo</h2>
          <div class="flex flex-wrap gap-2">
            {sku.available_materials.map((mat: string) => (
              <span class={`px-3 py-1.5 rounded-lg text-xs font-mono font-bold border ${mat === sku.default_material ? 'bg-amber-500 text-slate-950 border-amber-400' : 'bg-slate-950 text-slate-300 border-slate-700'}`}>
                {mat} {mat === sku.default_material ? '(Estándar)' : ''}
              </span>
            ))}
          </div>
        </div>

        <div>
          <h3 class="text-xs font-mono uppercase text-slate-400 mb-2">2. Códigos Atómicos Vinculados (13-Part BOM)</h3>
          <div class="flex flex-wrap gap-2">
            {sku.atomic_codes.map((code: string) => (
              <a
                href={`/catalogo/${code.toLowerCase()}/`}
                class="px-3 py-1 rounded bg-slate-950 border border-slate-700 hover:border-amber-400 text-xs font-mono text-amber-300 transition"
              >
                🔗 {code}
              </a>
            ))}
          </div>
        </div>

        <!-- Carril Dual de Compra Rápida (PRD v3.0 §6.2) -->
        <div class="grid grid-cols-1 gap-3 pt-1">
          <div class="rounded-xl border border-emerald-500/40 bg-emerald-950/20 p-3.5">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-mono font-bold text-emerald-300">⚡ CARRIL A: CAJA CHICA (&lt; MXN 25,000)</span>
              <span class="text-[11px] font-mono text-emerald-400">P1 · CFDI 4.0 HOY</span>
            </div>
            <p class="text-xs text-slate-300">
              Liberación exprés por SPEI o Tarjeta Corporativa sin alta de proveedor SAP. Salida el mismo día para piezas en régimen <strong>🟢 HAY</strong>.
            </p>
          </div>

          <div class="rounded-xl border border-amber-500/40 bg-amber-950/20 p-3.5">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-mono font-bold text-amber-300">🏢 CARRIL B: ORDEN DE COMPRA (&gt; MXN 25,000)</span>
              <span class="text-[11px] font-mono text-amber-400">SAP / ORACLE · PASAPORTE B2B</span>
            </div>
            <p class="text-xs text-slate-300 mb-1.5">
              Cotización formal PDF con Constancia Fiscal, Opinión 32-D Positiva y REPSE vigente.
            </p>
            <div class="text-[11px] font-mono text-slate-400 bg-slate-950/80 rounded px-2.5 py-1.5 border border-slate-800">
              SAT ProdServ: <strong class="text-slate-200">{sat.clave_prod_serv}</strong> · Unidad: <strong class="text-slate-200">{sat.clave_unidad}</strong> · TIGIE: <strong class="text-slate-200">{sat.fraccion_arancelaria}</strong>
            </div>
          </div>
        </div>

        <div class="rounded-xl bg-slate-950/90 border border-slate-800 p-4 text-xs text-slate-300 space-y-1.5">
          <div class="font-mono text-slate-200 font-semibold">📋 Incluye Pasaporte de Proveedor SMAT:</div>
          <p>• Certificado Metalúrgico de Colada (PMI / Dureza Brinell ASTM A532)</p>
          <p>• Cotejo Dimensional de Tripleta Geométrica (ISO 2768-m) en Durango</p>
          <p>• Huella de Seguridad NIOSH / NOM-036-1-STPS para Maniobra en Patio</p>
        </div>

        <div class="flex flex-col gap-3 pt-2">
          <a
            href={`/contacto/?sku=${encodeURIComponent(sku.id)}&part=${encodeURIComponent(sku.atomic_codes.join(','))}&mat=${encodeURIComponent(sku.default_material)}&lane=po`}
            class="w-full py-3.5 px-5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-center text-sm transition shadow-lg"
          >
            Solicitar Cotización / Pasaporte SAP ({sku.id}) →
          </a>
          <a
            href={`https://wa.me/526181302221?text=${encodeURIComponent(`Hola SMAT, requiero cotizar SKU ${sku.id} (${sku.title_es}) en aleación ${sku.default_material} [ Códigos: ${sku.atomic_codes.join('/')} | Régimen: ${sku.stock_regime || 'hay'} ].`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 px-5 rounded-xl border border-emerald-500/60 bg-emerald-950/40 hover:bg-emerald-900/50 text-emerald-300 font-mono text-center text-xs transition"
          >
            💬 Compra Rápida / Caja Chica por WhatsApp Ingeniería
          </a>
          <a
            href={`/#workbench?sku=${encodeURIComponent(sku.id)}&mat=${encodeURIComponent(sku.default_material)}`}
            class="w-full py-2.5 px-4 rounded-xl border border-slate-700 hover:border-sky-400 text-slate-300 hover:text-sky-300 font-mono text-center text-xs transition"
          >
            ⚙️ Abrir en Simulador Hidráulico y Metalúrgico (Plano 2)
          </a>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>
