---
// src/pages/bombeo/sello.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../scripts/workbenchBus.js';
import rolesData from '../../../data/roles.json';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const selloRole = allRoles.find((r) => r.role_id === 'sello');
const dc = selloRole?.decision_criteria;
const sealParts = [getAtomicPartSpecs('DAM028'), getAtomicPartSpecs('EAM028')].filter(Boolean);
---

<BaseLayout 
  title="Expulsor Centrífugo y Prensaestopa (Sin Sello Mecánico) | SMAT Minerals"
  description="Sistemas de sellado por expulsor centrífugo, anillo expulsor, camisa de flecha y prensaestopa para bombas de lodos. No vendemos sello mecánico por alta corrosión y abrasión."
  lang="es"
>
  <section class="page-hero">
    <div class="container">
      <a href="/bombeo/" class="back-link">← Volver a Bombas para Lodos</a>
      <div style="margin-top: 1rem;">
        <span class="badge badge-copper">SELLADO CENTRÍFUGO Y PRENSAESTOPA</span>
      </div>
      <h1>Expulsor Centrífugo y Prensaestopa</h1>
      <p style="font-size: 1.08rem; max-width: 720px; color: var(--smat-text-secondary);">
        Piezas de sellado centrífugo para bombas de lodos: expulsor, anillo expulsor, camisa de flecha y prensaestopa con empaquetadura. <strong>No vendemos sello mecánico</strong> porque las bombas para lodos operan en condiciones altamente abrasivas y corrosivas.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="expeller" lang="es" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Por Qué Empleamos Expulsor y Prensaestopa (Sin Sello Mecánico)</h2>
          <p>
            En el bombeo de lodos minerales con reactivos corrosivos y sólidos en suspensión, los sellos mecánicos de caras planas se fracturan o se atascan rápidamente. Nuestras bombas para lodos utilizan un <strong>expulsor centrífugo</strong> combinado con <strong>anillo expulsor y prensaestopa</strong> de empaquetadura trenzada, permitiendo operar en seco sin inyectar agua externa que diluya la pulpa.
          </p>

          <h3 style="margin-top: 1.75rem;">Componentes del Conjunto de Sellado</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Expulsor Centrífugo</th>
                  <td>Alto Cromo o Hule; genera un anillo de presión negativa que repele el lodo del eje</td>
                </tr>
                <tr>
                  <th>Anillo Expulsor y Prensaestopa</th>
                  <td>Fundición de alta resistencia con cámara para empaquetadura y anillo linterna</td>
                </tr>
                <tr>
                  <th>Camisa de Flecha</th>
                  <td>Acero inoxidable endurecido para proteger la flecha del Bearing Assembly</td>
                </tr>
                <tr>
                  <th>Empaquetadura</th>
                  <td>Fibra sintética con PTFE y grafito para cierre secundario en paro</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Cero Dilución de Pulpa</h3>
            <p>
              El sellado por expulsor centrífugo evita introducir agua de sello al circuito, manteniendo estable la densidad de pulpa hacia los hidrociclones y las celdas de flotación.
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/cotizar/?circuito=bombeo&equipo=kit_sellado&pieza=expeller_sello&seal_branch=expeller_dry&estacion=S2#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Cotizar Expulsor Centrífugo (Est. 02A Seco) →</a>
              <a href="/cotizar/?circuito=bombeo&equipo=kit_sellado&pieza=expeller_sello&seal_branch=gland_water&estacion=S2#rfq" class="btn btn-outline" style="width: 100%; text-align: center;">Cotizar Prensaestopa Húmedo (Est. 02B) →</a>
              <a href="/bombeo/#como-se-arma-una-bomba" class="btn btn-outline" style="width: 100%; text-align: center;">Ver Estación 2 en Reporte de Armado →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[CRITERIO DE DECISIÓN E INGENIERÍA — ESTACIÓN 02]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Regla Metalúrgica:</strong> {dc.metallurgy_rule_es}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Variables Críticas:</strong> {dc.required_slurry_vars_es}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Riesgo Evitado:</strong> {dc.risk_avoided_es}</p>
            </div>
          )}
        </div>
      </div>

      <!-- Comparador Bifurcado Estación 02A (Expeller Seco) vs Estación 02B (Gland Water) y Ley VFD -->
      <div class="card" data-seal-branch-comparator style="margin-top: 2rem; background: #f8fafc; border: 1.5px solid #cbd5e1;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.85rem;">
          <span class="badge badge-copper">BIFURCACIÓN DE SELLADO ESTACIÓN 02</span>
          <span class="font-mono-tech" style="font-size:0.75rem; font-weight:700; color:#0c4a6e;">ΔP_exp = ½·ρ_m·k_ω²·ω²·(R_exp² - R_h²) &gt; P_s + ΔP_back</span>
        </div>
        <h3>Selector Técnico: Estación 02A (Expulsor Seco) vs Estación 02B (Prensaestopa con Anillo Linterna)</h3>
        <div class="grid-2" style="margin-top:0.85rem;">
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:1rem;">
            <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#065f46;">[ESTACIÓN 02A — EXPELLER_DRY]</span>
            <h4 style="margin:0.35rem 0;">Expulsor Centrífugo Seco (Cero Agua de Sello)</h4>
            <p style="font-size:0.85rem; color:#334155;">Recomendado cuando la presión de succión P_s ≤ 15% de la carga total H y velocidad fija o VFD ≥ 70% RPM nominal. Evita diluir el %Cw hacia hidrociclones y flotación.</p>
            <a href="/cotizar/?circuito=bombeo&equipo=kit_sellado&seal_branch=expeller_dry&estacion=S2#rfq" class="btn btn-primary" style="margin-top:0.5rem;">Configurar Estación 02A (Seco) →</a>
          </div>
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:1rem;">
            <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#0c4a6e;">[ESTACIÓN 02B — GLAND_WATER]</span>
            <h4 style="margin:0.35rem 0;">Prensaestopa Húmedo (Flushing con Anillo Linterna)</h4>
            <p style="font-size:0.85rem; color:#334155;">Requerido en bombas en serie (etapa 2+), carga positiva de succión P_s &gt; 20% H o variador de frecuencia VFD a baja velocidad donde cae ω² del expulsor.</p>
            <a href="/cotizar/?circuito=bombeo&equipo=kit_sellado&seal_branch=gland_water&estacion=S2#rfq" class="btn btn-outline" style="margin-top:0.5rem;">Configurar Estación 02B (Húmedo) →</a>
          </div>
        </div>
      </div>

      <!-- Fichas Atómicas de Sellado (DAM028 y EAM028) con Masa e Izaje NIOSH -->
      <div style="margin-top: 2rem;" data-testid="seal-atomic-parts">
        <h2>Refacciones Atómicas de Sellado Verificadas en Almacén Durango (DAM028 / EAM028)</h2>
        <div class="grid-2" style="margin-top: 1rem;">
          {sealParts.map((sp) => (
            <div class="card" style="background:#ffffff; border:1px solid #cbd5e1;">
              <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                <span class="badge badge-copper">{sp.part_number} ({sp.smat_code})</span>
                <span class="font-mono-tech" style="font-size:0.74rem; font-weight:700; color:var(--smat-text-primary);">{sp.weight_kg} kg • {sp.niosh_handling_mode} (LI={sp.niosh_lifting_index_shaft})</span>
              </div>
              <h3 style="margin-top:0.5rem;">{sp.name_es}</h3>
              <p style="font-size:0.86rem; color:#334155;">{sp.summary_es}</p>
              <div class="font-mono-tech" style="font-size:0.75rem; color:#475569; margin-bottom:0.85rem;">
                Marco {sp.frame} (Serie {sp.pipe_size.toUpperCase()}) • Espesor {sp.wall_thickness_mm} mm • Estación 0{sp.station_number} ({sp.assembly_order_note})
              </div>
              <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <a href={`/catalogo/${sp.code}/`} class="btn btn-outline">Ver Ficha {sp.part_number} →</a>
                <a href={`/cotizar/?codigo=${sp.part_number}&circuito=bombeo&equipo=kit_sellado&serie=${sp.pipe_size}&peso_kg=${sp.weight_kg}&estacion=S${sp.station_number}#rfq`} class="btn btn-primary">Cotizar {sp.part_number} →</a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <SharePurchasing
        roleTitle="Expulsor Centrífugo, Anillo Expulsor y Prensaestopa"
        series="Marcos 1.5x1 a 14x12 (4x3 C, 6x4 D, 8x6 E, 10x8 F)"
        metallurgy="Alto Cromo 27% (A05), Acero Inoxidable Endurecido y Empaquetadura PTFE/Grafito"
        specs="Conjunto de sellado centrífugo en seco y prensaestopa sin sello mecánico para evitar dilución de pulpa."
        roleId="kit_sellado"
        circuit="bombeo"
        lang="es"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 2.75rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.5rem; }
  .back-link { color: var(--smat-copper-accent); font-size: 0.9rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .page-hero { padding: 0.75rem 0; }
    .page-hero h1 { font-size: 1.35rem; margin: 0.2rem 0; }
    .page-hero p { font-size: 0.82rem !important; line-height: 1.3; margin: 0.2rem 0; }
  }
</style>
