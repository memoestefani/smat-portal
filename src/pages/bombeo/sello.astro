---
// src/pages/bombeo/sello.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../scripts/workbenchBus.js';
import rolesData from '../../../data/roles.json';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const selloRole = allRoles.find((r) => r.role_id === 'sello');
const dc = selloRole?.decision_criteria;
const sealParts = [getAtomicPartSpecs('DAM028'), getAtomicPartSpecs('EAM028')].filter(Boolean);
---

<BaseLayout 
  title="Expulsor Centrífugo y Prensaestopa (Sin Sello Mecánico) | SMAT Minerals"
  description="Sistemas de sellado por expulsor centrífugo, anillo expulsor, camisa de flecha y prensaestopa para bombas de lodos. No vendemos sello mecánico por alta corrosión y abrasión."
  lang="es"
>
  <section class="page-hero smat-compact-hero">
    <div class="container">
      <a href="/bombeo/" class="back-link">← Volver a Bombas para Lodos</a>
      <div style="margin-top: 0.3rem;">
        <span class="badge badge-copper">ESTACIÓN 02 · SELLADO CENTRÍFUGO Y PRENSAESTOPA</span>
      </div>
      <h1>Expulsor Centrífugo y Prensaestopa</h1>
      <p class="smat-hero-sub">
        Calibración en vivo de contrapresión Expeller (02A Seco) vs Agua de Prensaestopas (02B Húmedo) sin sello mecánico.
      </p>
    </div>
  </section>

  <section class="section smat-stage-compact">
    <div class="container">
      <!-- ESTRATO 1: Comparador Interactivo y Calculadora de Sellado Hidráulico -->
      <div class="card" id="stratum1-seal-sim" data-seal-branch-comparator data-stratum-1-instrument style="margin-bottom: 1.5rem; background: #f8fafc; border: 1.5px solid #cbd5e1; padding: clamp(0.7rem, 1.4vw, 1.1rem);">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.45rem; margin-bottom:0.45rem;">
          <span class="badge badge-copper">BIFURCACIÓN DE SELLADO ESTACIÓN 02</span>
          <span class="font-mono-tech" style="font-size:0.75rem; font-weight:700; color:#0c4a6e;">ΔP_exp = ½·ρ_m·k_ω²·ω²·(R_exp² - R_h²) &gt; P_s + ΔP_back</span>
        </div>
        <h2 style="margin:0 0 0.45rem; font-size: clamp(0.98rem, 1.4vw, 1.12rem);">Calculadora en Vivo: Contrapresión de Expeller (02A Seco) vs Agua de Prensaestopas (02B Húmedo)</h2>
        <div class="smat-stratum1-display">
          <div id="seal-status-out" style="padding: 0.55rem 0.75rem; border-radius: 6px; background: #ecfdf5; border: 1px solid #059669; color: #064e3b; font-family: var(--smat-font-mono); font-size: 0.79rem; font-weight: 700;">
            Rama 02A Viable (Sellado Seco Expeller • 0 L/min agua • Hs/Hd = 11.4%): Margen centrífugo positivo.
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.45rem; font-family: var(--smat-font-mono); font-size: 0.78rem;">
            <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Contrapresión Expeller:</strong> <span id="seal-pexp-out">118.4 kPa</span></div>
            <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Presión Caja Estopas:</strong> <span id="seal-pbox-out">88.8 kPa</span></div>
            <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Agua de Sello Req.:</strong> <span id="seal-pwater-out">0 L/min</span></div>
            <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Rama Recomendada:</strong> <span id="seal-branch-out">02A · Expeller Centrífugo Seco</span></div>
          </div>
        </div>
        <div class="smat-inputs-2col" style="margin: 0.5rem 0 0.65rem; padding: 0.6rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.8rem;">
          <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
            <span>Carga Total TDH (m):</span>
            <input type="number" id="seal-hd-m" min="5" max="110" step="1" value="28" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
          </label>
          <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
            <span>Carga Succión H<sub>s</sub> (m):</span>
            <input type="number" id="seal-hs-m" min="0" max="25" step="0.5" value="3.2" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
          </label>
          <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
            <span>Ø Expeller (mm):</span>
            <input type="number" id="seal-exp-dia" min="140" max="520" step="10" value="280" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
          </label>
          <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
            <span>Velocidad Bomba (RPM):</span>
            <input type="number" id="seal-rpm" min="400" max="2200" step="25" value="1150" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
          </label>
          <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
            <span>Densidad Pulpa (SG<sub>m</sub>):</span>
            <input type="number" id="seal-sg" min="1.05" max="2.20" step="0.02" value="1.38" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
          </label>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center; margin-bottom: 0.85rem;">
          <a href="/cotizar/?circuito=bombeo&equipo=kit_sellado&pieza=expeller_sello&seal_branch=expeller_dry&estacion=S2#rfq" class="btn btn-primary" style="min-height: 48px; display: inline-flex; align-items: center;">Cotizar Sellado Calibrado →</a>
          <button
            type="button"
            class="btn btn-outline btn-avenue-tray"
            data-vertical-tray-btn
            data-add-tray-sku="SMAT-SEAL-EXPELLER"
            data-tray-part-code="E4028"
            data-tray-title="Sistema Sellado Expeller Calibrado (02A)"
            data-tray-series="02A"
            data-tray-material="A05"
            data-tray-circuit="bombeo"
            data-tray-source="seal_stratum1_calc"
            style="min-height: 48px;"
          >+ Sumar SKU Calibrado a Bandeja</button>
        </div>
        <div class="grid-2" style="margin-top:0.75rem;">
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:1rem;">
            <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#064e3b;">[ESTACIÓN 02A — SELLADO SECO EXPELLER]</span>
            <h4 style="margin:0.35rem 0;">Expulsor Centrífugo Seco (Cero Agua de Sello)</h4>
            <p style="font-size:0.85rem; color:#334155;">Recomendado cuando la presión de succión P_s ≤ 18% de la carga total H y velocidad fija o VFD ≥ 70% RPM nominal. Evita diluir el %Cw hacia hidrociclones y flotación.</p>
            <a href="/cotizar/?circuito=bombeo&equipo=kit_sellado&seal_branch=expeller_dry&estacion=S2#rfq" data-card-fixed-params="seal_branch" class="btn btn-primary" style="margin-top:0.5rem;">Configurar Estación 02A (Seco) →</a>
          </div>
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:1rem;">
            <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#0c4a6e;">[ESTACIÓN 02B — PRENSAESTOPAS HÚMEDO]</span>
            <h4 style="margin:0.35rem 0;">Prensaestopa Húmedo (Flushing con Anillo Linterna)</h4>
            <p style="font-size:0.85rem; color:#334155;">Requerido en bombas en serie (etapa 2+), carga positiva de succión P_s &gt; 18% H o variador de frecuencia VFD a baja velocidad donde cae ω² del expulsor.</p>
            <a href="/cotizar/?circuito=bombeo&equipo=kit_sellado&seal_branch=gland_water&estacion=S2#rfq" data-card-fixed-params="seal_branch" class="btn btn-outline" style="margin-top:0.5rem;">Configurar Estación 02B (Húmedo) →</a>
          </div>
        </div>
      </div>

      <!-- ESTRATO 2: Diagrama Técnico y Respaldo -->
      <TechnicalDiagrams diagram="expeller" lang="es" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Por Qué Empleamos Expulsor y Prensaestopa (Sin Sello Mecánico)</h2>
          <p>
            En el bombeo de lodos minerales con reactivos corrosivos y sólidos en suspensión, los sellos mecánicos de caras planas se fracturan o se atascan rápidamente. Nuestras bombas para lodos utilizan un <strong>expulsor centrífugo</strong> combinado con <strong>anillo expulsor y prensaestopa</strong> de empaquetadura trenzada, permitiendo operar en seco sin inyectar agua externa que diluya la pulpa.
          </p>

          <h3 style="margin-top: 1.75rem;">Componentes del Conjunto de Sellado</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Expulsor Centrífugo</th>
                  <td>Alto Cromo o Hule; genera un anillo de presión negativa que repele el lodo del eje</td>
                </tr>
                <tr>
                  <th>Anillo Expulsor y Prensaestopa</th>
                  <td>Fundición de alta resistencia con cámara para empaquetadura y anillo linterna</td>
                </tr>
                <tr>
                  <th>Camisa de Flecha</th>
                  <td>Acero inoxidable endurecido para proteger la flecha del Bearing Assembly</td>
                </tr>
                <tr>
                  <th>Empaquetadura</th>
                  <td>Fibra sintética con PTFE y grafito para cierre secundario en paro</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Cero Dilución de Pulpa</h3>
            <p>
              El sellado por expulsor centrífugo evita introducir agua de sello al circuito, manteniendo estable la densidad de pulpa hacia los hidrociclones y las celdas de flotación.
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/cotizar/?circuito=bombeo&equipo=kit_sellado&pieza=expeller_sello&seal_branch=expeller_dry&estacion=S2#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Cotizar Expulsor Centrífugo (Est. 02A Seco) →</a>
              <a href="/cotizar/?circuito=bombeo&equipo=kit_sellado&pieza=expeller_sello&seal_branch=gland_water&estacion=S2#rfq" class="btn btn-outline" style="width: 100%; text-align: center;">Cotizar Prensaestopa Húmedo (Est. 02B) →</a>
              <a href="/bombeo/#como-se-arma-una-bomba" class="btn btn-outline" style="width: 100%; text-align: center;">Ver Estación 2 en Reporte de Armado →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[CRITERIO DE DECISIÓN E INGENIERÍA — ESTACIÓN 02]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Regla Metalúrgica:</strong> {dc.metallurgy_rule_es}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Variables Críticas:</strong> {dc.required_slurry_vars_es}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Riesgo Evitado:</strong> {dc.risk_avoided_es}</p>
            </div>
          )}
        </div>
      </div>

      <!-- Fichas Atómicas de Sellado (DAM028 y EAM028) con Masa e Izaje NIOSH -->
      <div style="margin-top: 2rem;" data-testid="seal-atomic-parts">
        <h2>Refacciones Atómicas de Sellado Verificadas en Almacén Durango (DAM028 / EAM028)</h2>
        <div class="grid-2" style="margin-top: 1rem;">
          {sealParts.map((sp) => (
            <div class="card" style="background:#ffffff; border:1px solid #cbd5e1;">
              <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                <span class="badge badge-copper">{sp.part_number} ({sp.smat_code})</span>
                <span class="font-mono-tech" style="font-size:0.74rem; font-weight:700; color:var(--smat-text-primary);">{sp.weight_kg} kg • {sp.niosh_handling_mode} (LI={sp.niosh_lifting_index_shaft})</span>
              </div>
              <h3 style="margin-top:0.5rem;">{sp.name_es}</h3>
              <p style="font-size:0.86rem; color:#334155;">{sp.summary_es}</p>
              <div class="font-mono-tech" style="font-size:0.75rem; color:#475569; margin-bottom:0.85rem;">
                Serie {sp.pipe_size.toUpperCase()} ({sp.frame}) • Espesor {sp.wall_thickness_mm} mm • Estación 0{sp.station_number} ({sp.assembly_order_note})
              </div>
              <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <a href={`/catalogo/${sp.code}/`} class="btn btn-outline">Ver Ficha {sp.part_number} →</a>
                <a href={`/cotizar/?codigo=${sp.part_number}&circuito=bombeo&equipo=kit_sellado&serie=${sp.pipe_size}&peso_kg=${sp.weight_kg}&estacion=S${sp.station_number}#rfq`} class="btn btn-primary">Cotizar {sp.part_number} →</a>
                <button
                  type="button"
                  class="btn btn-outline btn-avenue-tray"
                  data-add-tray-sku="SMAT-PUMP-EXP-028"
                  data-tray-part-code={sp.part_number}
                  data-tray-title={sp.name_es}
                  data-tray-series={sp.pipe_size}
                  data-tray-material="A05"
                  data-tray-category="BOMBA_SLURRY"
                  data-tray-source="seal_atomic_card"
                  style="min-height: 48px;"
                >+ Bandeja</button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <SharePurchasing
        roleTitle="Expulsor Centrífugo, Anillo Expulsor y Prensaestopa"
        series="Series 1.5x1 a 14x12 (4x3, 6x4, 8x6, 10x8)"
        metallurgy="Alto Cromo 27% (A05), Acero Inoxidable Endurecido y Empaquetadura PTFE/Grafito"
        specs="Conjunto de sellado centrífugo en seco y prensaestopa sin sello mecánico para evitar dilución de pulpa."
        roleId="kit_sellado"
        circuit="bombeo"
        lang="es"
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { bindCanonicalSealBalanceCalculator } from '../../scripts/verticalCalculatorsAndLabelsBridge.js';
  import { bindAtomicPartTrayButtons } from '../../scripts/verticalStateAndCtaSyncBridge.js';
  bindCanonicalSealBalanceCalculator(document, 'es');
  bindAtomicPartTrayButtons(document);
</script>

<style>
  .back-link { color: var(--smat-solar-accent); font-size: 0.88rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
</style>
