---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SealDriveBearingIsland from '../../components/islands/SealDriveBearingIsland.astro';

const title = 'Expulsor Centrífugo y Prensaestopa (Sin Sello Mecánico) | SMAT Minerals';
const description = 'Sistemas de sellado por expulsor centrífugo, anillo expulsor, camisa de flecha y prensaestopa para bombas de lodos. No vendemos sello mecánico por alta corrosión y abrasión.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/bombeo/sello/"
  alternateEsPath="/bombeo/sello/"
  alternateEnPath="/en/pumping/seal/"
>
  <SealDriveBearingIsland locale="es" variant="seal" mode="standalone" />
</BaseLayout>
