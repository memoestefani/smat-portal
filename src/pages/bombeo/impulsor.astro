---
// src/pages/bombeo/impulsor.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../scripts/workbenchBus.js';
import { WET_END_MATERIAL_MATRIX } from '../../scripts/slurryEngine.js';
import rolesData from '../../../data/roles.json';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const impulsorRole = allRoles.find((r) => r.role_id === 'impulsor');
const dc = impulsorRole?.decision_criteria;
const impellerParts = [getAtomicPartSpecs('D3147'), getAtomicPartSpecs('E4147'), getAtomicPartSpecs('F6147')].filter(Boolean);
const wetMaterials = [
  WET_END_MATERIAL_MATRIX.alto_cromo_cr27,
  WET_END_MATERIAL_MATRIX.hule_natural,
  WET_END_MATERIAL_MATRIX.poliuretano,
  WET_END_MATERIAL_MATRIX.ceramica_sic,
  (WET_END_MATERIAL_MATRIX as any).hybrid_a05_r55
].filter(Boolean);
---

<BaseLayout 
  title="Impulsor para Bomba de Lodos | SMAT Minerals"
  description="Impulsores cerrados de 5 álabes y de paso amplio en Alto Cromo, Hule y Poliuretano para bombas de lodos."
  lang="es"
>
  <section class="page-hero smat-compact-hero">
    <div class="container">
      <a href="/bombeo/" class="back-link">← Volver a Bombas para Lodos</a>
      <div style="margin-top: 0.3rem;">
        <span class="badge badge-copper">ESTACIÓN 03 · PIEZA EN CONTACTO HÚMEDO</span>
      </div>
      <h1>Impulsor para Bomba de Lodos</h1>
      <p class="smat-hero-sub">
        Calibración tribológica en vivo de álabes, velocidad periférica u₂ y selección en A05 / R55 / U01 / SiC / Híbrido Rama D.
      </p>
    </div>
  </section>

  <section class="section smat-stage-compact">
    <div class="container">
      <!-- ESTRATO 1: Matriz Comparativa Aleaciones Impulsor -->
      <div id="stratum1-impeller-sim" data-testid="impeller-material-matrix" data-stratum-1-instrument>
        <div class="card" style="background: #f8fafc; border: 1.5px solid #cbd5e1; padding: clamp(0.7rem, 1.4vw, 1.1rem); margin-bottom: 1rem;">
          <span class="badge badge-copper">SIMULADOR TRIBOLÓGICO EN VIVO · FINNIE-HUTCHINGS &amp; TENACIDAD K<sub>Ic</sub></span>
          <h2 style="margin: 0.3rem 0 0.45rem; font-size: clamp(0.98rem, 1.4vw, 1.12rem);">Verificador de Velocidad Periférica u₂, Desconchamiento (Spalling SiC) y Masa NIOSH</h2>
          <div class="smat-stratum1-display">
            <div id="trib-status-out" style="padding: 0.5rem 0.75rem; border-radius: 6px; background: #ecfdf5; border: 1px solid #059669; color: #064e3b; font-family: var(--smat-font-mono); font-size: 0.79rem; font-weight: 700;">
              Tenacidad OK · Serie 6x4 · Sin riesgo de desconchamiento frágil (Spalling) en régimen cinemático actual.
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.45rem; font-family: var(--smat-font-mono); font-size: 0.78rem;">
              <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Material Recomendado:</strong> <span id="trib-mat-out">Alto Cromo 27% (A05)</span></div>
              <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Tenacidad K<sub>Ic</sub>:</strong> <span id="trib-kic-out">18.5 MPa·√m</span></div>
              <div style="background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1;"><strong>Masa e Izaje NIOSH:</strong> <span id="trib-arch-out">492 kg · 6 NIOSH ≥ 23 kg</span></div>
            </div>
          </div>
          <div class="smat-inputs-2col" style="margin-bottom: 0.65rem; padding: 0.6rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.8rem;">
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Granulometría d<sub>80</sub> (µm):</span>
              <input type="number" id="trib-d80-um" min="20" max="6000" step="25" value="450" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Velocidad Punta u₂ (m/s):</span>
              <input type="number" id="trib-vtip-ms" min="10" max="36" step="0.5" value="22.5" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>pH de Pulpa:</span>
              <input type="number" id="trib-ph" min="1.0" max="13.5" step="0.5" value="7.5" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Rama de Material:</span>
              <select id="trib-branch" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                <option value="auto" selected>Auto (Finnie-Hutchings)</option>
                <option value="metal">Alto Cromo 27% Cr (A05)</option>
                <option value="rubber">Hule Natural (R55)</option>
                <option value="polyurethane">Poliuretano (U01)</option>
                <option value="ceramica_sic">Cerámica SiC</option>
                <option value="hibrido_a05_r55">Rama D Híbrida (A05+R55)</option>
              </select>
            </label>
            <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 600;">
              <span>Serie de Bomba:</span>
              <select id="trib-series" style="padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px;">
                <option value="3x2">3x2 / 4x3</option>
                <option value="6x4" selected>6x4</option>
                <option value="8x6">8x6 / 10x8</option>
              </select>
            </label>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center;">
            <a href="/cotizar/?circuito=bombeo&equipo=solo_impulsor&pieza=impulsor_5_alabes&estacion=S3#rfq" class="btn btn-primary" style="min-height: 48px; display: inline-flex; align-items: center;">Cotizar Impulsor Calibrado →</a>
            <button
              type="button"
              class="btn btn-outline btn-avenue-tray"
              data-vertical-tray-btn
              data-add-tray-sku="SMAT-PUMP-IMP-147"
              data-tray-part-code="147/083"
              data-tray-title="Impulsor 5 Álabes Calibrado"
              data-tray-series="6x4"
              data-tray-material="alto_cromo_cr27"
              data-tray-circuit="bombeo"
              data-tray-source="impeller_stratum1_calc"
              style="min-height: 48px;"
            >+ Sumar SKU Calibrado a Bandeja</button>
          </div>
        </div>

        <h3 style="margin-top: 1.25rem;">Selección Tribológica por Material Húmedo (5 Ramas Certificadas)</h3>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:0.85rem; margin-top:0.65rem;">
          {wetMaterials.map((mat) => (
            <div class="card" style="background:#f8fafc; border:1px solid #cbd5e1; padding:1rem;">
              <span class="font-mono-tech" style="font-size:0.72rem; font-weight:800; color:#082f49;">[{mat.code}] {mat.hardness}</span>
              <h4 style="margin:0.35rem 0; font-size:0.95rem;">{mat.nameEs}</h4>
              <div class="font-mono-tech" style="font-size:0.74rem; color:#334155; margin-bottom:0.45rem;">
                u₂ ≤ {mat.maxTipSpeedMs} m/s • K_Ic = {mat.fractureToughnessMpaSqrtM} MPa·√m • d₈₀: {mat.d80RangeMicrons[0]}–{mat.d80RangeMicrons[1]} µm • pH {mat.phRange[0]}–{mat.phRange[1]}
              </div>
              <a href={`/cotizar/?circuito=bombeo&equipo=solo_impulsor&material=${mat.key}&estacion=S3#rfq`} data-card-fixed-params="material" class="btn btn-outline" style="width:100%; text-align:center; font-size:0.78rem;">Configurar en {mat.code} →</a>
            </div>
          ))}
        </div>
      </div>

      <!-- ESTRATO 2: Diagrama CAD Técnico y Fichas Atómicas -->
      <div style="margin-top: 2rem;">
        <TechnicalDiagrams diagram="impeller" lang="es" />
      </div>

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Características del Impulsor</h2>
          <p>
            El impulsor transfiere la energía centrífuga a la pulpa mineral y recibe el mayor impacto cinético de los sólidos en suspensión. Su geometría incorpora álabes expulsores frontales y traseros que reducen la recirculación hacia el cuello y disminuyen la presión sobre el prensaestopa.
          </p>

          <h3 style="margin-top: 1.75rem;">Especificaciones del Impulsor</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Materiales Disponibles</th>
                  <td>Alto Cromo (ASTM A532 ≥ 650 HB), Hule Natural (R55), Poliuretano (U01) y Carburo de Silicio Sinterizado (SiC ≥ 2200 HV)</td>
                </tr>
                <tr>
                  <th>Geometría de Álabes</th>
                  <td>Cerrado de 5 álabes (alta eficiencia) o 4 álabes de paso amplio</td>
                </tr>
                <tr>
                  <th>Álabes Expulsores</th>
                  <td>Álabes auxiliares en cara frontal y posterior para control de recirculación</td>
                </tr>
                <tr>
                  <th>Rosca de Montaje</th>
                  <td>Maquinado de precisión para acoplamiento directo en flecha del Bearing Assembly</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Suministro en Lote de Contacto Húmedo</h3>
            <p>
              Por su desgaste frente al resto de la carcasa, las plantas mineras suelen programar el impulsor en lotes combinados con cuellos y volutas (por ejemplo: <strong>5 impulsores, 5 cuellos y 4 volutas</strong>) para asegurar el ajuste hidráulico en cada cambio.
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/cotizar/?circuito=bombeo&equipo=solo_impulsor&pieza=impulsor_5_alabes&estacion=S3#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Cotizar Impulsores →</a>
              <a href="/bombeo/#como-se-arma-una-bomba" class="btn btn-outline" style="width: 100%; text-align: center;">Ver Montaje en Reporte de Armado →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[CRITERIO DE DECISIÓN E INGENIERÍA — ESTACIÓN 03]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Regla Metalúrgica:</strong> {dc.metallurgy_rule_es}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Variables Críticas:</strong> {dc.required_slurry_vars_es}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Riesgo Evitado:</strong> {dc.risk_avoided_es}</p>
            </div>
          )}
        </div>
      </div>

      <!-- Fichas Atómicas de Impulsores (D3147, E4147, F6147) con 6 Parámetros Físicos y NIOSH -->
      <div style="margin-top: 2rem;" data-testid="impeller-atomic-parts">
        <h2>Impulsores Estándar Verificados en Almacén Durango (D3147 / E4147 / F6147)</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:1rem; margin-top:1rem;">
          {impellerParts.map((ip) => (
            <div class="card" style="background:#ffffff; border:1px solid #cbd5e1;">
              <div style="display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
                <span class="badge badge-copper">{ip.part_number} ({ip.smat_code})</span>
                <span class="font-mono-tech" style="font-size:0.74rem; font-weight:800; color:var(--smat-text-primary);">{ip.weight_kg} kg • LI={ip.niosh_lifting_index_shaft}</span>
              </div>
              <h3 style="margin-top:0.5rem;">{ip.name_es}</h3>
              <div class="font-mono-tech" style="font-size:0.76rem; color:#0c4a6e; font-weight:700; margin-bottom:0.4rem;">
                ∅D₂ = {ip.impeller_diameter_mm} mm • Esfera máx. = {ip.max_particle_mm} mm • Espesor = {ip.wall_thickness_mm} mm
              </div>
              <p style="font-size:0.84rem; color:#334155; margin-bottom:0.5rem;">
                <strong>Izaje NIOSH:</strong> {ip.niosh_handling_mode} ({ip.niosh_ergonomic_tier}) • <strong>Estación 0{ip.station_number}:</strong> {ip.assembly_order_note}
              </p>
              <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <a href={`/catalogo/${ip.code}/`} class="btn btn-outline">Ver Ficha {ip.part_number} →</a>
                <a href={`/cotizar/?codigo=${ip.part_number}&circuito=bombeo&equipo=solo_impulsor&serie=${ip.pipe_size}&peso_kg=${ip.weight_kg}&estacion=S${ip.station_number}#rfq`} class="btn btn-primary">Cotizar {ip.part_number} →</a>
                <button
                  type="button"
                  class="btn btn-outline btn-avenue-tray"
                  data-add-tray-sku="SMAT-PUMP-IMP-147"
                  data-tray-part-code={ip.part_number}
                  data-tray-title={ip.name_es}
                  data-tray-series={ip.pipe_size}
                  data-tray-material="A05"
                  data-tray-circuit="bombeo"
                  data-tray-category="BOMBA_SLURRY"
                  data-tray-source="impeller_atomic_card"
                  style="min-height: 48px;"
                >+ Bandeja</button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <SharePurchasing
        roleTitle="Impulsor para Bomba de Lodos"
        series="Series 1.5x1 a 14x12 (4x3, 6x4, 8x6, 10x8)"
        metallurgy="Alto Cromo 27% (A05 ≥ 650 HB), Hule y Poliuretano"
        specs="Impulsor cerrado de 5 álabes o paso amplio con álabes expulsores frontales y traseros y cotejo dimensional 1:1."
        roleId="solo_impulsor"
        circuit="bombeo"
        lang="es"
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { bindCanonicalTribologySelector } from '../../scripts/verticalCalculatorsAndLabelsBridge.js';
  import { bindAtomicPartTrayButtons } from '../../scripts/verticalStateAndCtaSyncBridge.js';
  bindCanonicalTribologySelector(document, 'es');
  bindAtomicPartTrayButtons(document);
</script>

<style>
  .back-link { color: var(--smat-solar-accent); font-size: 0.88rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
</style>
