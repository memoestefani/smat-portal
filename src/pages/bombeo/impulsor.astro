---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TribologyAlloyIsland from '../../components/islands/TribologyAlloyIsland.astro';

const title = 'Impulsor para Bomba de Lodos | SMAT Minerals';
const description = 'Impulsores cerrados de 5 álabes y de paso amplio en Alto Cromo, Hule y Poliuretano para bombas de lodos.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/bombeo/impulsor/"
  alternateEsPath="/bombeo/impulsor/"
  alternateEnPath="/en/pumping/impeller/"
>
  <TribologyAlloyIsland locale="es" variant="impeller" mode="standalone" />
</BaseLayout>
