---
// src/pages/bombeo/skid.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import { DRIVE_ARRANGEMENT_CATALOG } from '../../scripts/slurryEngine.js';
import rolesData from '../../../data/roles.json';

const driveArrangements = Object.values(DRIVE_ARRANGEMENT_CATALOG);
const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const skidRole = allRoles.find((r) => r.role_id === 'skid_bomba');
const dc = skidRole?.decision_criteria;
---

<BaseLayout 
  title="Bombas para Lodos | SMAT Minerals"
  description="Bombas centrífugas horizontales para lodos abrasivos y corrosivos en molienda, clasificación, flotación y jales."
  lang="es"
>
  <section class="page-hero">
    <div class="container">
      <a href="/bombeo/" class="back-link">← Volver a Bombas para Lodos</a>
      <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0.5rem; margin-top:0.45rem;">
        <h1 style="margin:0;">Bombas para Lodos — Calibrador Cinemático & Tren Motriz</h1>
        <span class="badge badge-copper">EQUIPO COMPLETO • ARREGLOS CV / ZVZ / CRZ / DC</span>
      </div>
      <p style="font-size:0.94rem; max-width:760px; color:var(--smat-text-secondary); margin:0.35rem 0 0;">
        Calibre poleas V-Belt, velocidad periférica (u₂ ≤ 24.5 m/s en Hule R55 vs A05) y vida ISO 281 L₁₀h antes de cotizar su bomba o skid.
      </p>
    </div>
  </section>

  <section class="section" id="skid-main-section">
    <div class="container">
      <!-- Estrato 1: Calibrador Cinemático V-Belt, 5/5 Materiales + Rama Híbrida + DAM005 Trade-In + Tray -->
      <details class="skid-kinematics-calibrator" id="skid-kinematics-panel" data-skid-kinematics open data-stratum-1-instrument style="margin-top:0; margin-bottom:1.5rem;">
        <summary class="skid-kinematics-calibrator__summary">
          <span class="skid-kinematics-calibrator__badge">SIMULADOR CINEMÁTICO ISO 281</span>
          <span class="skid-kinematics-calibrator__title">
            Relación de Poleas V-Belt, Velocidad Periférica u₂, Material Húmedo (A05 / R55 / U01 / SiC / Híbrido) y Vida L₁₀h
          </span>
          <span class="skid-kinematics-calibrator__hint">Instrumento activo ▾</span>
        </summary>

        <div class="skid-kinematics-calibrator__body">
          <div class="skid-kinematics-calibrator__controls">
            <label class="kin-field">
              <span>Arreglo de Transmisión:</span>
              <select data-kin-arrangement>
                <option value="CV" selected>CV — Motor Superior (Overhead)</option>
                <option value="ZVZ">ZVZ — Motor Trasero Elevado</option>
                <option value="CRZ">CRZ — Motor Lateral en Base</option>
                <option value="DC">DC — Acoplamiento Directo (Fr = 0 kN)</option>
              </select>
            </label>
            <label class="kin-field">
              <span>Velocidad Motor Eléctrico (RPM):</span>
              <select data-kin-motor-rpm>
                <option value="1780" selected>1780 RPM (4 Polos • 60 Hz)</option>
                <option value="1480">1480 RPM (4 Polos • 50 Hz / VFD)</option>
                <option value="1180">1180 RPM (6 Polos • 60 Hz)</option>
              </select>
            </label>
            <label class="kin-field">
              <span>Polea Motriz Motor (mm): <strong data-kin-driver-val>180 mm</strong></span>
              <input type="range" min="120" max="380" step="10" value="180" data-kin-driver />
            </label>
            <label class="kin-field">
              <span>Polea Conducida Bomba (mm): <strong data-kin-driven-val>320 mm</strong></span>
              <input type="range" min="160" max="560" step="10" value="320" data-kin-driven />
            </label>
            <label class="kin-field">
              <span>Potencia en Flecha (kW): <strong data-kin-power-val>45 kW (60 HP)</strong></span>
              <input type="range" min="15" max="315" step="5" value="45" data-kin-power />
            </label>
            <label class="kin-field">
              <span>Diámetro Impulsor ØD₂ (Censo Dimensional):</span>
              <select data-kin-impeller>
                <option value="270">270 mm — Serie 3x2 / 4x3 (D3147)</option>
                <option value="380" selected>380 mm — Serie 6x4 (E4147)</option>
                <option value="510">510 mm — Serie 8x6 (F6147)</option>
                <option value="640">640 mm — Serie 10x8 (G8147)</option>
              </select>
            </label>
            <label class="kin-field">
              <span>Material en Contacto Húmedo (5/5):</span>
              <select data-kin-material>
                <option value="alto_cromo_cr27" selected>Alto Cromo 27% A05 (u₂ máx 32.0 m/s • K_Ic=20 MPa·√m)</option>
                <option value="hule_natural">Hule Natural R55 (u₂ máx 24.5 m/s • K_Ic=12 MPa·√m)</option>
                <option value="poliuretano">Poliuretano U01 (u₂ máx 26.0 m/s • K_Ic=14 MPa·√m)</option>
                <option value="ceramica_sic">Cerámica Carburo de Silicio SiC (u₂ máx 28.0 m/s • ≥2200 HV)</option>
                <option value="hybrid_a05_r55">Rama D Híbrida (Impulsor A05 + Forros R55 • u₂ máx 24.5 m/s • K_Ic=18.5 MPa·√m)</option>
              </select>
            </label>
            <label class="kin-field">
              <span>Capacidad Dinámica Rodamiento C (kN — ISO 281):</span>
              <input type="number" min="60" max="450" step="5" value="145" data-kin-capacity-c />
            </label>
          </div>

          <div class="skid-kinematics-calibrator__metrics">
            <div class="kin-metric-card">
              <span class="kin-metric-card__kicker">VELOCIDAD EN EJE BOMBA</span>
              <strong class="kin-metric-card__val" data-kin-rpm>1001 RPM</strong>
              <span class="kin-metric-card__sub" data-kin-ratio>Motor 1780 RPM • Relación 0.56×</span>
            </div>
            <div class="kin-metric-card">
              <span class="kin-metric-card__kicker">VELOCIDAD PERIFÉRICA (u₂)</span>
              <strong class="kin-metric-card__val" data-kin-u2>19.92 m/s</strong>
              <span class="kin-metric-card__sub" data-kin-u2-status>Dentro de límite elástico de Hule y A05</span>
              <div class="kin-metric-card__sub" data-kin-hybrid-note style="margin-top:0.25rem; font-weight:700; color:#0c4a6e;"></div>
            </div>
            <div class="kin-metric-card">
              <span class="kin-metric-card__kicker">CARGA RADIAL BANDAS (Fᵣ)</span>
              <strong class="kin-metric-card__val" data-kin-fr>6.71 kN</strong>
              <span class="kin-metric-card__sub" data-kin-fr-sub data-kin-load-p>Carga eq. P = 14.37 kN • Huella 1.00×</span>
            </div>
            <div class="kin-metric-card">
              <span class="kin-metric-card__kicker">VIDA ISO 281 (L₁₀h / L₁₀ₘₕ LABERINTO)</span>
              <strong class="kin-metric-card__val" data-kin-l10h>42,800 h</strong>
              <span class="kin-metric-card__sub" data-kin-l10mh>L₁₀ₘₕ Laberinto: 53,500 h vs Fieltro Contam.: 9,416 h</span>
            </div>
          </div>

          <div style="display:flex; flex-wrap:wrap; align-items:center; gap:0.65rem; margin-top:0.85rem;">
            <a
              href="/cotizar/?circuito=bombeo&equipo=skid_bomba&transmision=CV&material=alto_cromo_cr27&u2_ms=19.92&l10h=42800#rfq"
              class="btn btn-primary"
              data-kin-cta
              data-quote-base="/cotizar/"
              style="min-height:48px; display:inline-flex; align-items:center;"
            >
              Cotizar Bomba con esta Cinemática →
            </a>
            <button
              type="button"
              class="btn btn-outline btn-avenue-tray"
              data-vertical-tray-btn
              data-add-tray-sku="SMAT-PUMP-DRIVE-SKID"
              data-tray-part-code="CV-6x4"
              data-tray-title="Tren Motriz Bomba CV (6x4, 45 kW, alto_cromo_cr27)"
              data-tray-series="6x4"
              data-tray-material="alto_cromo_cr27"
              data-tray-circuit="bombeo"
              data-tray-source="skid_stratum1_calc"
              style="min-height: 48px;"
            >+ Bandeja Tren Motriz</button>
          </div>

          <div
            data-core-tradein-widget="DAM005"
            data-lang="es"
            style="width: 100%; margin-top: 0.75rem; padding: 0.85rem; border-radius: 8px; background: #ecfdf5; border: 1px solid #10b981; font-size: 0.78rem; color: #064e3b;"
          >
            <div style="font-family: var(--font-mono-tech, monospace); font-weight: 800; color: #065f46; margin-bottom: 0.35rem;">
              ♻️ CANJE POR REPARABILIDAD DE NÚCLEO DAM005 (-22% / -12% REMANUFACTURA H7)
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.5rem; margin-bottom: 0.4rem;">
              <label style="display: flex; flex-direction: column; gap: 0.2rem; font-weight: 700;">
                <span>Estado de Carcasa Usada</span>
                <select data-tradein-condition data-core-tradein-condition style="padding: 0.35rem 0.45rem; border: 1px solid #059669; border-radius: 6px; background: #ffffff; color: #1c1917; font-size: 0.75rem;">
                  <option value="h7_intact" selected>Carcasa Intacta Sin Fisuras (-22% • 0.78x)</option>
                  <option value="minor_bearing_seizure">Roce de Rodamiento / Alojamiento Recuperable (-12% • 0.88x)</option>
                  <option value="cracked_housing">Carcasa Fisurada o Soldada (0% • 1.00x)</option>
                </select>
              </label>
              <label style="display: flex; align-items: center; gap: 0.35rem; font-weight: 700; padding-top: 1rem;">
                <input type="checkbox" data-tradein-not-welded data-core-tradein-toggle checked />
                <span>Alojamiento H7 Sin Soldadura (ISO IT6)</span>
              </label>
            </div>
            <div data-tradein-result data-core-tradein-badge style="font-family: var(--font-mono-tech, monospace); font-weight: 800; color: #065f46;">
              Activo: -22% Crédito por Núcleo Usado (Factor 0.78x • RMA-CORE-DAM005-INTACT)
            </div>
            <div data-tradein-co2 data-core-tradein-note style="font-size: 0.72rem; color: #047857; margin-top: 0.2rem;">
              Retorno en Almacén Central: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166 (35 kg CO₂e ahorrados)
            </div>
          </div>

          <div class="skid-kinematics-calibrator__alert" data-kin-rubber-alert style="display:none">
            <div>
              <strong>ALERTA DE VELOCIDAD PERIFÉRICA:</strong> La velocidad periférica supera <strong>24.5 m/s</strong> en Hule Natural (R55), provocando delaminación térmica por histéresis viscoelástica.
            </div>
            <button type="button" class="btn btn-primary" data-kin-switch-a05>
              Cambiar a Alto Cromo A05 (≥650 HB)
            </button>
          </div>
        </div>
      </details>

      <div class="grid-2" style="margin-bottom: 1.75rem;">
        <article>
          <h2>Configuración de la Bomba para Lodos</h2>
          <p>
            Diseñadas para operar con pulpas de alta densidad y sólidos abrasivos o corrosivos. Cada bomba integra carcasa bipartida, piezas en contacto húmedo intercambiables (impulsor, cuello, voluta y plato), sistema de sellado centrífugo por expulsor y prensaestopa (sin sello mecánico) y conjunto motriz <strong>Bearing Assembly / Housing</strong> completo.
          </p>
          
          <h3 style="margin-top: 1rem;">Especificaciones Técnicas</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Tamaños Disponibles</th>
                  <td>1.5x1", 2x1.5", 3x2", 4x3", 6x4", 8x6", 10x8", 12x10", 14x12"</td>
                </tr>
                <tr>
                  <th>Materiales en Contacto Húmedo</th>
                  <td>Alto Cromo 27% (A05 ≥650 HB), Hule Natural (R55), Poliuretano (U01) y Carburo de Silicio Sinterizado (SiC ≥2200 HV)</td>
                </tr>
                <tr>
                  <th>Conjunto de Rodamientos</th>
                  <td>Bearing Assembly / Housing completo con ajuste axial externo (L₁₀ₘₕ = 1.25× L₁₀h con sello laberinto vs 0.22× contaminado)</td>
                </tr>
                <tr>
                  <th>Sistema de Sellado</th>
                  <td>Expulsor centrífugo en seco y prensaestopa (no emplea sello mecánico)</td>
                </tr>
                <tr>
                  <th>Transmisión</th>
                  <td>Acoplamiento por poleas y bandas en V o acoplamiento directo</td>
                </tr>
              </tbody>
            </table>
          </div>
        </article>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Aplicaciones en Planta</h3>
            <ul>
              <li><strong>Descarga de Molino y Ciclones:</strong> Revestimiento e impulsor en Alto Cromo para impacto severo de roca gruesa.</li>
              <li><strong>Flotación y Remolienda:</strong> Revestimientos en Hule o Poliuretano para pulpas finas y reactivos corrosivos.</li>
              <li><strong>Envío de Jales y Espesadores:</strong> Operación continua en serie o etapa simple con alta carga estática.</li>
            </ul>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/cotizar/?equipo=skid_bomba#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Cotizar Bomba para Lodos →</a>
              <a href="/bombeo/#como-se-arma-una-bomba" class="btn btn-outline" style="width: 100%; text-align: center;">Ver Reporte de Armado (14 Piezas) →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[CRITERIO DE DECISIÓN E INGENIERÍA]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Regla Metalúrgica:</strong> {dc.metallurgy_rule_es}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Variables Críticas:</strong> {dc.required_slurry_vars_es}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Riesgo Evitado:</strong> {dc.risk_avoided_es}</p>
            </div>
          )}
        </div>
      </div>

      <TechnicalDiagrams diagram="pump" lang="es" />

      <!-- ARREGLOS DE TRANSMISIÓN EN SKID (DECISIÓN 5-C+ • REF 3 Y 5 DON MANUEL) -->
      <div id="arreglos-transmision" style="margin-top: 2.5rem;">
        <h2>Arreglos de Transmisión y Montaje en Base Estructural (CV / ZVZ / CRZ / DC)</h2>
        <p style="color: var(--smat-text-secondary); max-width: 760px;">
          Seleccione el arreglo motriz según el espacio disponible en planta y la vida nominal L₁₀h (ISO 281) del <strong>Bearing Assembly</strong>:
        </p>
        <TechnicalDiagrams diagram="drive_arrangements" lang="es" />

        <div class="grid-2" style="margin-top: 1rem;" data-drive-links="transmision=CV transmision=ZVZ transmision=CRZ transmision=DC">
          {driveArrangements.map((arr) => (
            <div class="card">
              <h3>{arr.nameEs}</h3>
              <p>{arr.descriptionEs}</p>
              <small style="display:block; margin-bottom:0.65rem; font-family:var(--smat-font-mono); font-size:0.74rem; color:#082f49; font-weight:700;" data-kin-flood>
                Huella: {arr.footprintFactor.toFixed(2)}× • Inundación: {Boolean(arr.sumpFloodImmunity) ? 'Motor Elevado (Inmune a salpicadura)' : 'Nivel de base / Requiere drenaje'}
              </small>
              <a href={`/cotizar/?equipo=skid_bomba&transmision=${arr.code}#rfq`} class="btn btn-primary" data-card-fixed-params="transmision">Cotizar Bomba Arreglo {arr.code} →</a>
            </div>
          ))}
        </div>
      </div>

      <!-- BOCA DE SUCCIÓN Y CALIBRACIÓN DE CLARO AXIAL (REF 4 DON MANUEL) -->
      <div style="margin-top: 2.5rem;">
        <h2>Geometría de Succión, Throatbush y Calibración de Claro Axial (δ = 0.5–1.0 mm)</h2>
        <TechnicalDiagrams diagram="suction_throatbush" lang="es" />
      </div>

      <SharePurchasing
        roleTitle="Bomba Centrífuga Horizontal para Lodos"
        series="1.5x1 a 14x12 (4x3, 6x4, 8x6, 10x8)"
        metallurgy="Contacto Húmedo en Alto Cromo 27% (A05), Hule y Poliuretano"
        specs="Bomba horizontal de servicio pesado con Bearing Assembly / Housing completo y sellado centrífugo por expulsor y prensaestopa."
        roleId="skid_bomba"
        circuit="bombeo"
        lang="es"
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { initSkidKinematicsInspector } from '../../scripts/verticalBidirectionalHydrationLens.js';
  initSkidKinematicsInspector(document, 'es');
  document.addEventListener('astro:page-load', () => initSkidKinematicsInspector(document, 'es'));
</script>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 0.9rem 0 0.85rem; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin: 0.25rem 0 0; font-size: 1.65rem; }
  .back-link { color: var(--smat-copper-accent); font-size: 0.9rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  .skid-kinematics-calibrator { margin-top: 1.5rem; border: 1.5px solid #cbd5e1; border-radius: 10px; background: #f8fafc; overflow: hidden; }
  .skid-kinematics-calibrator__summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.65rem; padding: 0.85rem 1.1rem; cursor: pointer; list-style: none; }
  .skid-kinematics-calibrator__badge { background: #0d78c6; color: #ffffff; font-family: var(--smat-font-mono, monospace); font-size: 0.68rem; font-weight: 800; padding: 0.18rem 0.5rem; border-radius: 4px; }
  .skid-kinematics-calibrator__title { font-size: 0.92rem; font-weight: 800; color: #1c1917; flex: 1; }
  .skid-kinematics-calibrator__hint { font-family: var(--smat-font-mono, monospace); font-size: 0.72rem; font-weight: 800; color: #082f49; }
  .skid-kinematics-calibrator__body { padding: 1.1rem; background: #ffffff; border-top: 1px solid #e2e8f0; }
  .skid-kinematics-calibrator__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.85rem; margin-bottom: 1rem; }
  .kin-field { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.8rem; font-weight: 700; color: #1c1917; }
  .skid-kinematics-calibrator__metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; }
  .kin-metric-card { background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .kin-metric-card__kicker { font-family: var(--smat-font-mono, monospace); font-size: 0.66rem; font-weight: 800; color: #475569; }
  .kin-metric-card__val { font-size: 1rem; font-weight: 800; color: #1c1917; }
  .kin-metric-card__sub { font-size: 0.74rem; color: #334155; }
  .kin-metric-card__cta { margin-top: 0.25rem; font-family: var(--smat-font-mono, monospace); font-size: 0.72rem; font-weight: 800; color: #082f49; text-decoration: underline; }
  .skid-kinematics-calibrator__alert { margin-top: 0.9rem; padding: 0.85rem 1rem; border-radius: 8px; background: #fef2f2; border: 1.5px solid #dc2626; color: #7f1d1d; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; font-size: 0.82rem; }
  @media (max-width: 640px) {
    .page-hero { padding: 0.65rem 0; }
    .page-hero h1 { font-size: 1.32rem; margin: 0.15rem 0; }
    .page-hero p { font-size: 0.82rem !important; line-height: 1.3; margin: 0.2rem 0 0; }
    #skid-main-section { padding-top: 0.65rem; }
  }
</style>
