---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SealDriveBearingIsland from '../../components/islands/SealDriveBearingIsland.astro';

const title = 'Bombas para Lodos | SMAT Minerals';
const description = 'Bombas centrífugas horizontales para lodos abrasivos y corrosivos en molienda, clasificación, flotación y jales.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/bombeo/skid/"
  alternateEsPath="/bombeo/skid/"
  alternateEnPath="/en/pumping/skid/"
>
  <SealDriveBearingIsland locale="es" variant="skid" mode="standalone" />
</BaseLayout>
