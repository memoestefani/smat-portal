---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TribologyAlloyIsland from '../../components/islands/TribologyAlloyIsland.astro';

const title = 'Revestimientos, Volutas y Cuellos en Alto Cromo, Hule y Poliuretano | SMAT Minerals';
const description = 'Suministro de revestimientos, volutas, cuellos y platos posteriores en Alto Cromo, Hule y Poliuretano por lote de contacto húmedo.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/bombeo/revestimientos/"
  alternateEsPath="/bombeo/revestimientos/"
  alternateEnPath="/en/pumping/liners/"
>
  <TribologyAlloyIsland locale="es" variant="liners" mode="standalone" />
</BaseLayout>
