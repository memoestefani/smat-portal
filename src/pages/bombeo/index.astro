---
// src/pages/bombeo/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import CircuitNavigator from '../../components/CircuitNavigator.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import QuickPartSelectorStrip from '../../components/QuickPartSelectorStrip.astro';
import PumpAssemblyReport from '../../components/PumpAssemblyReport.astro';
import atomicParts from '../../../data/atomic_parts.json';
import { getAtomicPartSpecs } from '../../scripts/workbenchBus.js';
---

<BaseLayout 
  title="Bombas para Lodos y Spare Parts | SMAT Minerals"
  description="Bombas para lodos de reemplazo, Spare Parts en contacto húmedo por lote 5-5-4 (impulsores, revestimientos, volutas y cuellos en Alto Cromo, Hule y Poliuretano) y Bearing Assembly / Housing completo."
  lang="es"
>
  <section class="page-hero">
    <div class="container">
      <span class="badge badge-copper">PUERTA 2 • OPERACIÓN, MANTENIMIENTO Y REFACCIONAMIENTO</span>
      <h1>Bombas para Lodos y Spare Parts</h1>
      <p style="font-size: 1.04rem; max-width: 760px; color: var(--smat-text-secondary);">
        Selección directa de piezas en contacto húmedo por lote <strong>5-5-4</strong> (<strong>Alto Cromo ≥650 HB, Hule Natural y Poliuretano</strong>), conjuntos completos <strong>Bearing Assembly</strong> y reporte técnico de armado en 5 estaciones.
      </p>
    </div>
  </section>

  <section class="section" id="bombeo-main-section">
    <div class="container">
      <QuickPartSelectorStrip lang="es" showAssemblyLink={true} />

      <TechnicalDiagrams diagram="pump" lang="es" />

      <!-- MOSAICO DE PIEZAS DE RECAMBIO POR MATERIAL (DECISIÓN 4-C+) -->
      <div class="material-kits-showcase" id="lotes-por-material" style="margin-top: 2.25rem;">
        <span class="section-eyebrow">IDENTIFICACIÓN VISUAL POR METALURGIA Y ELASTÓMERO</span>
        <h2 style="margin-bottom: 0.35rem;">Lotes de Spare Parts por Material: Alto Cromo (≥650 HB), Hule Natural y Poliuretano</h2>
        <p style="color: var(--smat-text-secondary); margin-bottom: 1rem;">
          Compare la geometría física de cada lote húmedo: voluta monolítica en Alto Cromo Cr27% frente a liners bipartidos (FPL + CPL) en Hule Natural vulcanizado o Poliuretano.
        </p>
        <TechnicalDiagrams diagram="material_kit_grid" lang="es" />

        <div class="grid-3-atomic" style="margin-top: 1rem;">
          <article class="card atomic-silo-card">
            <span class="badge badge-copper" style="align-self: flex-start; margin-bottom: 0.5rem;">ALTO CROMO Cr27% • ≥650 HB</span>
            <h3>Lote Metálico (Molienda Primaria y SAG)</h3>
            <p style="font-size: 0.86rem; color: var(--smat-text-secondary);">
              <strong>Piezas del kit:</strong> Voluta Monolítica + Impulsor 5 Álabes + Throatbush + FPL Insert.<br/>
              <strong>Límite operativo:</strong> Impacto severo d₅₀ &gt; 6 mm, v_tip ≤ 32 m/s, pH 4.0–12.0.
            </p>
            <div style="margin-top: auto; padding-top: 0.75rem;">
              <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=lote_554&material=alto_cromo_cr27#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Cotizar Lote Alto Cromo →</a>
            </div>
          </article>

          <article class="card atomic-silo-card">
            <span class="badge badge-copper" style="align-self: flex-start; margin-bottom: 0.5rem;">HULE NATURAL • 55–65 SHORE A</span>
            <h3>Lote Elastómero (Colas Finas y Flotación)</h3>
            <p style="font-size: 0.86rem; color: var(--smat-text-secondary);">
              <strong>Piezas del kit:</strong> Liner Frontal (CPL) + Liner Posterior (FPL) con alma de acero + Impulsor + Throatbush.<br/>
              <strong>Límite operativo:</strong> Abrasión fina d₅₀ ≤ 5 mm, v_tip ≤ 27.5 m/s, pH 1.5–11.0.
            </p>
            <div style="margin-top: auto; padding-top: 0.75rem;">
              <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=lote_554&material=hule_natural#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Cotizar Lote Hule Natural →</a>
            </div>
          </article>

          <article class="card atomic-silo-card">
            <span class="badge badge-copper" style="align-self: flex-start; margin-bottom: 0.5rem;">POLIURETANO • 85–95 SHORE A</span>
            <h3>Lote Poliuretano (Ciclones y Reactivos)</h3>
            <p style="font-size: 0.86rem; color: var(--smat-text-secondary);">
              <strong>Piezas del kit:</strong> Liners CPL + FPL en Poliuretano Amarillo/Rojo + Impulsor PU + Throatbush PU.<br/>
              <strong>Límite operativo:</strong> Partícula cortante d₅₀ ≤ 8 mm, resistencia a hidrocarburos y espumas.
            </p>
            <div style="margin-top: auto; padding-top: 0.75rem;">
              <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=lote_554&material=poliuretano#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Cotizar Lote Poliuretano →</a>
            </div>
          </article>

          <article class="card atomic-silo-card">
            <span class="badge badge-copper" style="align-self: flex-start; margin-bottom: 0.5rem;">CERÁMICA SiC • ≥2200 HV (MOHS 9.2)</span>
            <h3>Lote Compuesto Cerámico (Sílice Fina y pH Extremo)</h3>
            <p style="font-size: 0.86rem; color: var(--smat-text-secondary);">
              <strong>Piezas del kit:</strong> Voluta Compuesta SiC + Throatbush SiC + Impulsor Cr27/SiC.<br/>
              <strong>Límite operativo:</strong> Abrasión severa d₈₀ ≤ 800 µm, u₂ ≤ 28.0 m/s, K_Ic = 4.1 MPa·√m, pH 1.0–13.5.
            </p>
            <div style="margin-top: auto; padding-top: 0.75rem;">
              <a href="/cotizar/?equipo=bombeo_hule_cromo&pieza=lote_554&material=ceramica_sic#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Cotizar Lote Cerámica SiC →</a>
            </div>
          </article>
        </div>
      </div>

      <!-- REPORTE DE CÓMO SE ARMA UNA BOMBA (DECISIÓN 3-C+) -->
      <PumpAssemblyReport lang="es" />

      <!-- CONSOLA TABULADA UNIFICADA DE SUB-ENSAMBLES Y FICHAS ATÓMICAS (SECCIÓN 3.2.1 / DEB-32-02) -->
      <div class="bombeo-catalog-tabs" id="bombeo-catalog-tabs" style="margin-top: 2.25rem;">
        <div class="bombeo-tabs-header">
          <div>
            <span class="section-eyebrow">CATÁLOGO CONSOLIDADO DE BOMBEO Y DESGASTE</span>
            <h2 style="margin: 0.2rem 0 0.35rem;">Bombas de Reemplazo y Spare Parts Críticos</h2>
          </div>
          <div class="bombeo-tab-switcher" role="tablist" aria-label="Selector de Sub-ensambles o Fichas Atómicas">
            <button
              type="button"
              role="tab"
              aria-selected="true"
              class="bombeo-tab-btn is-active"
              data-bombeo-tab="systems"
            >
              1. Sub-ensambles y Bombas (5)
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              class="bombeo-tab-btn"
              data-bombeo-tab="atomic"
            >
              2. Fichas por Código Universal (6)
            </button>
          </div>
        </div>

        <div class="bombeo-tab-panel is-active" data-bombeo-panel="systems">
          <div class="grid-2" style="margin-top: 1.25rem;">
            <div class="card">
              <h3>Bombas Completas para Lodos</h3>
              <p>Bombas centrífugas horizontales de servicio pesado desde 1.5x1" hasta 14x12" para descarga de molino, alimentación a ciclones, flotación y jales.</p>
              <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Rango:</strong> 1.5x1" a 14x12"</p>
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/bombeo/skid/" class="btn btn-outline">Ver Diagrama y Datos</a>
                <a href="/cotizar/?equipo=skid_bomba#rfq" class="btn btn-primary">Cotizar →</a>
              </div>
            </div>

            <div class="card">
              <h3>Bearing Assembly / Housing</h3>
              <p>Equipo completo ensamblado listo para montaje: carcasa cilíndrica, flecha de acero aleado, rodamientos cónicos de servicio pesado y sellos laberinto.</p>
              <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Suministro:</strong> Conjunto Completo Ensamblado</p>
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/bombeo/soporte/" class="btn btn-outline">Ver Bearing Assembly</a>
                <a href="/cotizar/?equipo=soporte#rfq" class="btn btn-primary">Cotizar →</a>
              </div>
            </div>

            <div class="card">
              <h3>Impulsor</h3>
              <p>Impulsores cerrados de 5 álabes y de paso amplio con álabes expulsores traseros para reducir la presión en el prensaestopa y controlar la recirculación.</p>
              <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Materiales:</strong> Alto Cromo, Hule y Poliuretano</p>
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/bombeo/impulsor/" class="btn btn-outline">Características del Impulsor</a>
                <a href="/cotizar/?equipo=impulsor#rfq" class="btn btn-primary">Cotizar →</a>
              </div>
            </div>

            <div class="card">
              <h3>Revestimientos, Volutas y Cuellos</h3>
              <p>Volutas, cuellos y platos posteriores para las zonas en contacto húmedo. Disponibles por lote programado de desgaste.</p>
              <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Materiales:</strong> Alto Cromo, Hule y Poliuretano</p>
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/bombeo/revestimientos/" class="btn btn-outline">Ver Piezas y Lotes</a>
                <a href="/cotizar/?equipo=revestimientos#rfq" class="btn btn-primary">Cotizar →</a>
              </div>
            </div>

            <div class="card">
              <h3>Expulsor Centrífugo y Prensaestopa</h3>
              <p>Sellado centrífugo en seco, anillo expulsor, camisa de flecha y prensaestopa (sin sello mecánico) para evitar dilución de pulpa.</p>
              <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Sellado:</strong> Expulsor y Prensaestopa PTFE/Grafito</p>
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/bombeo/sello/" class="btn btn-outline">Ver Sellado Centrífugo</a>
                <a href="/cotizar/?equipo=sello#rfq" class="btn btn-primary">Cotizar →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Fichas Técnicas por Código Universal (atomic_parts.json) enriquecidas con masa NIOSH -->
        <div class="bombeo-tab-panel atomic-silo-block" data-bombeo-panel="atomic" style="margin-top: 1.25rem; display: none;">
          <h3 style="margin-bottom: 0.35rem;">Fichas Técnicas de Spare Parts por Número de Parte Universal (Contacto Húmedo)</h3>
          <p style="color: var(--smat-text-secondary); margin-bottom: 1.15rem;">
            Consulte las especificaciones individuales de impulsores cerrados, cuellos de succión y anillos expulsores con masa verificada (criterio NIOSH 23 kg) en Almacén Central Durango.
          </p>
          <div class="grid-3-atomic">
            {atomicParts.map((part) => {
              const specs = getAtomicPartSpecs(part.part_number);
              const isHoist = specs.niosh_handling_mode === 'HOIST_REQUIRED' || part.weight_kg > 23;
              return (
                <div class="card atomic-silo-card" data-atomic-code={part.part_number}>
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <span class="badge badge-copper">{part.part_number}</span>
                    <span style="font-family: var(--smat-font-mono); font-size: 0.78rem; font-weight: 700; color: var(--smat-text-secondary);">Marco {part.frame}</span>
                  </div>
                  <h3 style="font-size: 1.02rem; margin-bottom: 0.35rem;">{part.name_es}</h3>
                  <p style="font-size: 0.84rem; color: var(--smat-text-secondary); margin-bottom: 0.5rem;">{part.type_es} • {part.hardness}</p>
                  <div class="atomic-niosh-meta" style="font-family: var(--smat-font-mono); font-size: 0.76rem; color: #334155; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.4rem 0.6rem; margin-bottom: 0.85rem;">
                    <strong>Masa: {specs.weight_kg} kg</strong> • {isHoist ? 'Polipasto Obligatorio (>23 kg NIOSH)' : 'Manejo Manual Seguro (≤23 kg NIOSH)'}
                  </div>
                  <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: auto;">
                    <a href={`/catalogo/${part.code}/`} class="btn btn-outline" style="font-size: 0.8rem; padding: 0.4rem 0.75rem;">Ver Ficha {part.part_number}</a>
                    <a href={`/cotizar/?codigo=${part.part_number}&circuito=bombeo#rfq`} class="btn btn-primary" style="font-size: 0.8rem; padding: 0.4rem 0.75rem;">Cotizar →</a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <SharePurchasing
        roleTitle="Bombas para Lodos y Lote Húmedo de Spare Parts (5-5-4)"
        specs="Lote balanceado de 5 Impulsores + 5 Cuellos + 4 Volutas y Bearing Assembly / Housing"
        metallurgy="Alto Cromo 27% A05 (≥650 HB), Hule Natural Antiabrasivo y Poliuretano"
        series="1.5x1 a 14x12"
        roleId="kit_wet_end"
        circuit="bombeo"
        lang="es"
      />
    </div>
  </section>

  <!-- MATRIZ COMPARATIVA DE SUMINISTRO POR LOTE -->
  <section class="tco-matrix-section" aria-label="Suministro por Lote de Contacto Húmedo">
    <div class="container">
      <div class="tco-matrix-header">
        <span class="section-eyebrow">PLANEACIÓN DE MANTENIMIENTO EN PLANTA</span>
        <h2>Compra por Lote de Contacto Húmedo vs. Compra Pieza por Pieza</h2>
        <p>En bombas para lodos, las plantas programan lotes balanceados según la tasa real de desgaste de cada componente húmedo (por ejemplo: <strong>5 impulsores, 5 cuellos y 4 volutas</strong>) junto con un <strong>Bearing Assembly / Housing</strong> completo de respaldo.</p>
      </div>

      <div class="tco-table-wrapper">
        <table class="tco-comparison-matrix">
          <thead>
            <tr>
              <th>Criterio Operativo</th>
              <th>Importación Ultramarina Tradicional</th>
              <th>Compra Unitaria Reactiva</th>
              <th class="col-smat-highlight">Suministro Programado por Lote SMAT</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Tiempo de Tránsito Internacional</strong></td>
              <td>16 a 24 semanas (Tránsito marítimo y aduana)</td>
              <td>Compras aisladas de urgencia</td>
              <td class="col-smat-val">Programación directa por lote (Facturación nacional CFDI)</td>
            </tr>
            <tr>
              <td><strong>Configuración de Contacto Húmedo</strong></td>
              <td>Lotes rígidos con piezas de baja rotación</td>
              <td>1 pieza suelta (desajuste con partes gastadas)</td>
              <td class="col-smat-val">Lotes a medida (ej. 5 Impulsores + 5 Cuellos + 4 Volutas)</td>
            </tr>
            <tr>
              <td><strong>Materiales de Desgaste</strong></td>
              <td>Una sola aleación estándar</td>
              <td>Fundición no controlada (&lt;500 HB)</td>
              <td class="col-smat-val">Alto Cromo (≥650 HB), Hule y Poliuretano</td>
            </tr>
            <tr>
              <td><strong>Impacto ante Paro de Molino (20k–40,000 USD/hora)</strong></td>
              <td>Alto capital inmovilizado por meses</td>
              <td>Paro prolongado por falta de cuello o impulsor</td>
              <td class="col-smat-val">Programación por lote acoplado al desgaste real (5-5-4)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <details class="bombeo-circuit-drawer" id="bombeo-circuit-drawer">
    <summary class="bombeo-circuit-drawer__summary container">
      <span>Ver Mapa P&ID de Circuito de Molienda y Reglas Metalúrgicas por Rol</span>
      <span class="bombeo-circuit-drawer__badge">ANEXO P&ID ▾</span>
    </summary>
    <div class="bombeo-circuit-drawer__body">
      <CircuitNavigator currentCircuit="molienda" lang="es" />
    </div>
  </details>

  <script>
    function initBombeoCatalogTabs() {
      const tabBtns = document.querySelectorAll('[data-bombeo-tab]');
      const tabPanels = document.querySelectorAll('[data-bombeo-panel]');
      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-bombeo-tab') || 'systems';
          tabBtns.forEach((b) => {
            const active = b.getAttribute('data-bombeo-tab') === target;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          tabPanels.forEach((p) => {
            const active = p.getAttribute('data-bombeo-panel') === target;
            p.classList.toggle('is-active', active);
            (p as HTMLElement).style.display = active ? 'block' : 'none';
          });
        });
      });
    }
    initBombeoCatalogTabs();
    document.addEventListener('astro:page-load', initBombeoCatalogTabs);
  </script>
</BaseLayout>

<style>
  .page-hero {
    background-color: #ffffff;
    color: var(--smat-text-primary);
    padding: 3rem 0;
    border-bottom: 2px solid var(--smat-copper-accent);
  }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.65rem; }
  .bombeo-tabs-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--smat-border-light);
  }
  .bombeo-tab-switcher {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    background: #e2e8f0;
    padding: 0.3rem;
    border-radius: 10px;
    border: 1px solid var(--smat-border-light);
  }
  .bombeo-tab-btn {
    border: none;
    background: transparent;
    color: #1e293b;
    font-weight: 700;
    font-size: 0.84rem;
    padding: 0.5rem 0.95rem;
    border-radius: 7px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .bombeo-tab-btn.is-active {
    background: var(--smat-navy-950);
    color: #ffffff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.25);
  }
  .bombeo-circuit-drawer {
    border-top: 1px solid var(--smat-border-strong);
    border-bottom: 1px solid var(--smat-border-strong);
    background-color: #f8fafc;
  }
  .bombeo-circuit-drawer__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.15rem 1rem;
    cursor: pointer;
    font-weight: 800;
    color: var(--smat-text-primary);
    list-style: none;
  }
  .bombeo-circuit-drawer__summary::-webkit-details-marker {
    display: none;
  }
  .bombeo-circuit-drawer__badge {
    background-color: #fff7ed;
    color: #9a3412;
    border: 1px solid #fed7aa;
    font-family: var(--smat-font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
  }
  .grid-3-atomic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.15rem;
  }
  .atomic-silo-card {
    display: flex;
    flex-direction: column;
  }
  .section-eyebrow {
    display: inline-block;
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--smat-copper-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }
  .tco-matrix-section {
    padding: var(--smat-space-2xl, 80px) 0;
    background-color: #ffffff;
    border-top: 1px solid var(--smat-border-light);
    border-bottom: 1px solid var(--smat-border-light);
  }
  .tco-matrix-header {
    margin-bottom: 1.75rem;
    max-width: 780px;
  }
  .tco-matrix-header h2 {
    font-size: clamp(1.4rem, 2.3vw, 1.85rem);
    color: var(--smat-text-primary);
    margin: 0 0 0.5rem 0;
  }
  .tco-matrix-header p {
    color: var(--smat-text-secondary);
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
  }
  .tco-table-wrapper {
    overflow-x: auto;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
  }
  .tco-comparison-matrix {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
    background: #ffffff;
  }
  .tco-comparison-matrix th,
  .tco-comparison-matrix td {
    padding: 0.95rem 1.15rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .tco-comparison-matrix thead th {
    background: #f8fafc;
    color: #334155;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
  .col-smat-highlight {
    background: #fff7ed !important;
    color: #9a3412 !important;
    border-left: 2px solid var(--smat-copper-accent);
  }
  .col-smat-val {
    background: #fffaf5;
    font-weight: 700;
    color: var(--smat-text-primary);
    border-left: 2px solid var(--smat-copper-accent);
  }
  @media (max-width: 768px) {
    .page-hero {
      padding: 0.65rem 0;
    }
    .page-hero h1 {
      font-size: 1.3rem;
      margin: 0.2rem 0;
    }
    .page-hero p {
      font-size: 0.8rem !important;
      line-height: 1.25;
      margin: 0.2rem 0;
    }
    #bombeo-main-section {
      padding-top: 0.55rem;
    }
  }
</style>
