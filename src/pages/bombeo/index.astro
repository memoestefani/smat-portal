---
// src/pages/bombeo/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import CircuitNavigator from '../../components/CircuitNavigator.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import atomicParts from '../../../data/atomic_parts.json';
---

<BaseLayout 
  title="Bombas para Lodos y Piezas en Contacto Húmedo | SMAT Minerals"
  description="Bombas para lodos, impulsores, revestimientos, volutas y cuellos en Alto Cromo, Hule y Poliuretano, y Bearing Assembly / Housing completo."
  lang="es"
>
  <section class="page-hero">
    <div class="container">
      <span class="badge badge-copper">BOMBAS PARA LODOS Y REFACCIONES</span>
      <h1>Bombas para Lodos</h1>
      <p style="font-size: 1.08rem; max-width: 720px; color: var(--smat-text-secondary);">
        Bombas centrífugas horizontales para lodos, conjuntos completos <strong>Bearing Assembly / Housing</strong> y piezas en contacto húmedo suministradas por lote en <strong>Alto Cromo, Hule y Poliuretano</strong>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TechnicalDiagrams diagram="pump" lang="es" />

      <div class="wet-lot-callout">
        <div>
          <strong>Pedido por Lote de Contacto Húmedo (5 – 5 – 4)</strong>
          <p>
            En planta no se compra pieza por pieza suelta: se programa el lote de piezas en contacto húmedo de acuerdo con su rotación real (por ejemplo, <strong>5 impulsores, 5 cuellos y 4 volutas</strong>) en Alto Cromo, Hule o Poliuretano. No manejamos sello mecánico debido a la alta corrosión y abrasión de los lodos mineros; empleamos expulsor centrífugo y prensaestopa.
          </p>
        </div>
        <a href="/#rfq?equipo=revestimientos" class="btn btn-primary">Cotizar Lote Húmedo →</a>
      </div>

      <h2 style="margin-top: 2rem;">Bombas y Piezas de Reemplazo</h2>
      <div class="grid-2" style="margin-top: 1.5rem;">
        <div class="card">
          <h3>Bombas Completas para Lodos</h3>
          <p>Bombas centrífugas horizontales de servicio pesado desde 1.5x1" hasta 14x12" para descarga de molino, alimentación a ciclones, flotación y jales.</p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Rango:</strong> 1.5x1" a 14x12"</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/bombeo/skid/" class="btn btn-outline">Ver Diagrama y Datos</a>
            <a href="/#rfq?equipo=skid_bomba" class="btn btn-primary">Cotizar →</a>
          </div>
        </div>

        <div class="card">
          <h3>Bearing Assembly / Housing</h3>
          <p>Equipo completo ensamblado listo para montaje: carcasa cilíndrica, flecha de acero aleado, rodamientos cónicos de servicio pesado y sellos laberinto.</p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Suministro:</strong> Conjunto Completo Ensamblado</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/bombeo/soporte/" class="btn btn-outline">Ver Bearing Assembly</a>
            <a href="/#rfq?equipo=soporte" class="btn btn-primary">Cotizar →</a>
          </div>
        </div>

        <div class="card">
          <h3>Impulsor</h3>
          <p>Impulsores cerrados de 5 álabes y de paso amplio con álabes expulsores traseros para reducir la presión en el prensaestopa y controlar la recirculación.</p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Materiales:</strong> Alto Cromo, Hule y Poliuretano</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/bombeo/impulsor/" class="btn btn-outline">Características del Impulsor</a>
            <a href="/#rfq?equipo=impulsor" class="btn btn-primary">Cotizar →</a>
          </div>
        </div>

        <div class="card">
          <h3>Revestimientos, Volutas y Cuellos</h3>
          <p>Volutas, cuellos y platos posteriores para las zonas en contacto húmedo. Disponibles por lote programado de desgaste.</p>
          <p style="font-family: var(--smat-font-mono); font-size: 0.85rem;"><strong>Materiales:</strong> Alto Cromo, Hule y Poliuretano</p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/bombeo/revestimientos/" class="btn btn-outline">Ver Piezas y Lotes</a>
            <a href="/#rfq?equipo=revestimientos" class="btn btn-primary">Cotizar →</a>
          </div>
        </div>
      </div>

      <!-- Fichas Técnicas por Código Universal (atomic_parts.json) -->
      <div class="atomic-silo-block" style="margin-top: 2.5rem;">
        <h2 style="margin-bottom: 0.4rem;">Fichas Técnicas por Número de Parte Universal (Contacto Húmedo)</h2>
        <p style="color: var(--smat-text-secondary); margin-bottom: 1.25rem;">
          Consulte las especificaciones individuales de impulsores cerrados, cuellos de succión y anillos expulsores con verificación dimensional 1:1 en Almacén Central Durango.
        </p>
        <div class="grid-3-atomic">
          {atomicParts.map((part) => (
            <div class="card atomic-silo-card">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span class="badge badge-copper">{part.part_number}</span>
                <span style="font-family: var(--smat-font-mono); font-size: 0.78rem; font-weight: 700; color: var(--smat-text-secondary);">Marco {part.frame}</span>
              </div>
              <h3 style="font-size: 1.02rem; margin-bottom: 0.35rem;">{part.name_es}</h3>
              <p style="font-size: 0.84rem; color: var(--smat-text-secondary); margin-bottom: 0.85rem;">{part.type_es} • {part.hardness}</p>
              <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: auto;">
                <a href={`/catalogo/${part.code}/`} class="btn btn-outline" style="font-size: 0.8rem; padding: 0.4rem 0.75rem;">Ver Ficha {part.part_number}</a>
                <a href={`/#rfq?codigo=${part.part_number}&circuito=bombeo`} class="btn btn-primary" style="font-size: 0.8rem; padding: 0.4rem 0.75rem;">Cotizar →</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background-color: #ffffff; border-top: 1px solid var(--smat-border-light); border-bottom: 1px solid var(--smat-border-light);">
    <div class="container">
      <CircuitNavigator lang="es" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="background: #f8fafc; border: 1px solid var(--smat-border-strong); padding: 2.25rem; text-align: center;">
        <h2 style="margin-bottom: 0.6rem;">Solicitar Cotización de Bombas o Lote de Piezas</h2>
        <p style="max-width: 620px; margin: 0 auto 1.25rem; color: var(--smat-text-secondary);">
          Indique el tamaño de su bomba o las cantidades de su lote en contacto húmedo (impulsores, cuellos, volutas o Bearing Assembly / Housing).
        </p>
        <a href="/#rfq?equipo=skid_bomba" class="btn btn-primary">Solicitar Cotización →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background-color: #ffffff;
    color: var(--smat-text-primary);
    padding: 3rem 0;
    border-bottom: 2px solid var(--smat-copper-accent);
  }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.65rem; }
  .wet-lot-callout {
    margin: 1.5rem 0;
    padding: 1.35rem 1.5rem;
    background: #fff7ed;
    border: 1px solid #fdba74;
    border-left: 4px solid var(--smat-copper-accent);
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .wet-lot-callout strong {
    display: block;
    font-size: 1rem;
    color: var(--smat-text-primary);
    margin-bottom: 0.3rem;
  }
  .wet-lot-callout p {
    margin: 0;
    font-size: 0.9rem;
    color: #334155;
    max-width: 720px;
    line-height: 1.5;
  }
  .grid-3-atomic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.15rem;
  }
  .atomic-silo-card {
    display: flex;
    flex-direction: column;
  }
</style>
