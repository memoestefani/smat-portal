---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PumpingHubIsland from '../../components/islands/PumpingHubIsland.astro';

const title = 'Bombas para Lodos y Refacciones | SMAT Minerals';
const description = 'Bombas centrífugas para lodos, lotes balanceados 5-5-4 en contacto húmedo (impulsores, volutas y platos de succión en Alto Cromo, Hule Natural y Poliuretano) y cartuchos Bearing Assembly / Housing.';
---

<BaseLayout
  title={title}
  description={description}
  lang="es"
  canonicalPath="/bombeo/"
  alternateEsPath="/bombeo/"
  alternateEnPath="/en/pumping/"
>
  <PumpingHubIsland locale="es" mode="standalone" />
</BaseLayout>
