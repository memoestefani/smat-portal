---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
---

<BaseLayout 
  title="Ensambles de Rodamientos y Ejes de Bomba Slurry | SMAT Minerals"
  description="Ensambles de rodamientos de servicio pesado y ejes forjados de alta rigidez para bombas de pulpa. Despacho ensamblado y lubricado desde Almacén Durango."
  lang="es"
  canonicalPath="/bombeo/soporte/"
  alternateEsPath="/bombeo/soporte/"
  alternateEnPath="/en/pumping/bearing-assembly/"
>
  <Header slot="header" lang="es" currentPath="/bombeo/soporte/" alternatePath="/en/pumping/bearing-assembly/" />

  <section class="page-hero">
    <div class="container text-center">
      <span class="badge badge-emergency">OPEX • STOCK EN ALMACÉN DURANGO</span>
      <h1>Ensambles de Rodamientos y Ejes Rígidos</h1>
      <p class="subtitle">Cartuchos de rodamientos de uso rudo para marcos C, D, E y F con balanceo dinámico.</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="container content-container">
      <div class="card detail-card">
        <h2>Rigidez Torsional y Protección contra Contaminación</h2>
        <p>
          El ensamble de soporte mecánico es la columna vertebral de la bomba de pulpa. SMAT Minerals entrega cartuchos completamente ensamblados, sellados con laberintos de grasa y rodamientos de rodillos cónicos diseñados para soportar cargas axiales y radiales masivas causadas por fluctuaciones bruscas de densidad y cavitación.
        </p>

        <table class="tech-table">
          <thead>
            <tr>
              <th>Elemento Mecánico</th>
              <th>Especificación de Resistencia SMAT</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Eje Mecanizado (Shaft)</td>
              <td>Acero forjado de alta aleación (AISI 4140 / 4340) con bajo voladizo para mínima deflexión radial</td>
            </tr>
            <tr>
              <td>Rodamientos</td>
              <td>Rodillos cónicos de servicio pesado Timken / SKF con vida L10 calculada superior a 50,000 horas</td>
            </tr>
            <tr>
              <td>Alojamiento (Bearing Housing)</td>
              <td>Hierro nodular de alta resistencia a la fractura con nervaduras de enfriamiento por convección</td>
            </tr>
            <tr>
              <td>Sellado de Cojinetes</td>
              <td>Laberintos de purga de grasa sin contacto que impiden la entrada de agua de lavado o pulpa</td>
            </tr>
          </tbody>
        </table>

        <SharePurchasing 
          roleTitle="Ensamble de Rodamientos de Bomba Slurry"
          series="Marcos de soporte CAM, DAM, EAM, FAM"
          metallurgy="Eje AISI 4140, Carcasa de Hierro Dúctil, Rodillos Timken/SKF"
          specs="Ensamble completo de cojinetes calibrado y precargado en banco con sellos laberinto de doble barrera contra pulpa."
          lang="es"
        />

        <div class="cta-rfq-box">
          <div class="cta-rfq-header">
            <span class="badge badge-copper">DESPACHO INMEDIATO DESDE DURANGO</span>
            <h3>¿Requiere cartuchos de rodamientos armados y lubricados?</h3>
            <p>Emita de inmediato su requisición técnica formal con marco de soporte y protocolo de precarga en banco.</p>
          </div>
          <div class="cta-rfq-actions">
            <a href="/?equipo=soporte#rfq" class="btn btn-primary btn-lg">
              Cotizar Ensamble de Rodamientos en Consola Central →
            </a>
            <a href="https://wa.me/526183670664?text=Hola%20SMAT%20Minerals,%20requiero%20cotizar%20Ensamble%20de%20Rodamientos" target="_blank" rel="noopener noreferrer" class="btn btn-emergency btn-lg">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              Consultar Stock en Almacén por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton lang="es" />
  <Footer slot="footer" lang="es" />
</BaseLayout>

<style>
  .page-hero {
    padding: 4.5rem 0 3.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #fafaf9 100%);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .page-hero h1 {
    color: #090d16;
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.125rem;
    margin-top: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-card {
    background-color: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .detail-card h2 {
    color: #090d16;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--color-accent-copper);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .detail-card p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .tech-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .tech-table th, .tech-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--smat-border-light);
    text-align: left;
  }

  .tech-table th {
    background-color: #f8fafc;
    color: #090d16;
    font-weight: 700;
  }

  .tech-table td {
    color: #334155;
  }

  .cta-rfq-box {
    margin-top: 3rem;
    padding: 2.5rem;
    background: linear-gradient(180deg, #fafaf9 0%, #f1f5f9 100%);
    border: 1px solid var(--smat-border-light);
    border-radius: 12px;
    text-align: center;
  }

  .cta-rfq-header h3 {
    font-size: 1.4rem;
    color: #090d16;
    margin: 0.75rem 0 0.5rem;
  }

  .cta-rfq-header p {
    color: #475569;
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .cta-rfq-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
