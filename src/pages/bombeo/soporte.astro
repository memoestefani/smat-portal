---
// src/pages/bombeo/soporte.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechnicalDiagrams from '../../components/TechnicalDiagrams.astro';
import SharePurchasing from '../../components/SharePurchasing.astro';
import rolesData from '../../../data/roles.json';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const soporteRole = allRoles.find((r) => r.role_id === 'soporte');
const dc = soporteRole?.decision_criteria;
---

<BaseLayout 
  title="Bearing Assembly / Housing | SMAT Minerals"
  description="Bearing Assembly / Housing: equipo completo ensamblado con carcasa cilíndrica, flecha, rodamientos cónicos y sellos laberinto para bombas de lodos."
  lang="es"
>
  <section class="page-hero">
    <div class="container">
      <a href="/bombeo/" class="back-link">← Volver a Bombas para Lodos</a>
      <div style="margin-top: 1rem;">
        <span class="badge badge-copper">EQUIPO COMPLETO ENSAMBLADO</span>
      </div>
      <h1>Bearing Assembly / Housing</h1>
      <p style="font-size: 1.08rem; max-width: 700px; color: var(--smat-text-secondary);">
        Cartucho cilíndrico completo (<strong>Bearing Assembly / Housing</strong>) listo para instalarse en el bastidor de la bomba para lodos.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- Diagrama Técnico Principal del Bearing Assembly / Housing -->
      <TechnicalDiagrams diagram="bearing" lang="es" />

      <div class="grid-2" style="margin-top: 1.75rem;">
        <div>
          <h2>Un Equipo Completo Listo para Montaje</h2>
          <p>
            El <strong>Bearing Assembly / Housing</strong> se suministra como una unidad completa y cerrada: incluye el cuerpo cilíndrico (<em>housing</em>), la flecha maquinada con rosca para el impulsor, los rodamientos de rodillos cónicos en arreglo espalda con espalda, las tapas de retén (<em>end covers</em>) y los sellos laberinto en ambos extremos.
          </p>

          <h3 style="margin-top: 1.75rem;">Componentes del Bearing Assembly / Housing</h3>
          <div class="table-wrapper">
            <table>
              <tbody>
                <tr>
                  <th>Presentación</th>
                  <td>Cartucho completo ensamblado (Bearing Assembly / Housing)</td>
                </tr>
                <tr>
                  <th>Carcasa (Housing)</th>
                  <td>Fundición nodular con orejas de izaje y orejeta inferior para tornillo de ajuste axial</td>
                </tr>
                <tr>
                  <th>Flecha (Shaft)</th>
                  <td>Acero aleado de alta resistencia con rosca de precisión lado impulsor y cuñero lado transmisión</td>
                </tr>
                <tr>
                  <th>Rodamientos</th>
                  <td>Doble hilera de rodamientos de rodillos cónicos de servicio pesado</td>
                </tr>
                <tr>
                  <th>Sellos de Protección</th>
                  <td>Sellos laberinto y anillos de pistón en ambos extremos para impedir entrada de lodo o agua</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="card" style="background-color: #f8fafc;">
            <h3>Reemplazo Completo y Ajuste Axial</h3>
            <p>
              Contar con un <strong>Bearing Assembly / Housing</strong> completo en almacén permite intercambiar todo el conjunto motriz en minutos durante un mantenimiento programado, y ajustar la holgura entre el impulsor y el cuello mediante el tornillo regulador inferior.
            </p>
            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--smat-border-light); display: flex; flex-direction: column; gap: 0.6rem;">
              <a href="/cotizar/?circuito=bombeo&equipo=kit_rodamientos&pieza=bearing_assembly&estacion=S1#rfq" class="btn btn-primary" style="width: 100%; text-align: center;">Cotizar Bearing Assembly / Housing →</a>
              <a href="/bombeo/#como-se-arma-una-bomba" class="btn btn-outline" style="width: 100%; text-align: center;">Ver Estación 1 y Ajuste Axial (δ) →</a>
            </div>
          </div>

          {dc && (
            <div class="card" data-testid="role-decision-criteria" style="margin-top: 1rem; background: #f8fafc; border-left: 4px solid #7c2d12; padding: 1rem;">
              <span class="font-mono-tech" style="font-size: 0.72rem; font-weight: 800; color: #7c2d12; display: block; margin-bottom: 0.35rem;">[CRITERIO DE DECISIÓN E INGENIERÍA — ESTACIÓN 01]</span>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Regla Metalúrgica:</strong> {dc.metallurgy_rule_es}</p>
              <p style="font-size: 0.84rem; margin-bottom: 0.4rem;"><strong>Variables Críticas:</strong> {dc.required_slurry_vars_es}</p>
              <p style="font-size: 0.84rem; margin: 0; color: #7f1d1d;"><strong>Riesgo Evitado:</strong> {dc.risk_avoided_es}</p>
            </div>
          )}
        </div>
      </div>

      <!-- Inspector Cinemático ISO 281:2007 L10h y L10mh (INV-SMAT-SCI-29) -->
      <div class="card" data-bearing-inspector style="margin-top: 2rem; background: #f8fafc; border: 1.5px solid #cbd5e1;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.85rem;">
          <span class="badge badge-copper">MEMORIA ISO 281:2007 (p = 10/3)</span>
          <span class="font-mono-tech" style="font-size:0.75rem; font-weight:700; color:#0c4a6e;">L₁₀ₘₕ = a_ISO(e_c·C_u/P, κ) · (C/P)^(10/3)</span>
        </div>
        <h3>Inspector de Vida Modificada L₁₀ₘₕ (Sello Laberinto vs Fieltro Contaminado) y Carga Radial Fᵣ</h3>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(190px, 1fr)); gap:0.75rem; margin-top:0.85rem;">
          <label style="display:flex; flex-direction:column; gap:0.3rem; font-size:0.8rem; font-weight:700;">
            <span>Arreglo Motriz (Transmisión):</span>
            <select data-bear-arr style="padding:0.4rem; border:1px solid #cbd5e1; border-radius:6px;">
              <option value="CV" selected>CV — Motor Superior (Overhead)</option>
              <option value="ZVZ">ZVZ — Motor Trasero Elevado</option>
              <option value="CRZ">CRZ — Motor Lateral en Skid</option>
              <option value="DC">DC — Acoplamiento Directo (Fᵣ = 0 kN)</option>
            </select>
          </label>
          <label style="display:flex; flex-direction:column; gap:0.3rem; font-size:0.8rem; font-weight:700;">
            <span>Capacidad Dinámica C (kN):</span>
            <select data-bear-c style="padding:0.4rem; border:1px solid #cbd5e1; border-radius:6px;">
              <option value="95">95 kN — Marco C (3x2 / 4x3)</option>
              <option value="195" selected>195 kN — Marco D (6x4)</option>
              <option value="285">285 kN — Marco E (8x6)</option>
              <option value="390">390 kN — Marco F (10x8 / 12x10)</option>
            </select>
          </label>
          <label style="display:flex; flex-direction:column; gap:0.3rem; font-size:0.8rem; font-weight:700;">
            <span>Potencia en Eje P (kW): <strong data-bear-kw-lbl>45 kW</strong></span>
            <input type="range" min="15" max="250" step="5" value="45" data-bear-kw />
          </label>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:0.75rem; margin-top:1rem;">
          <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:0.75rem;">
            <span class="font-mono-tech" style="font-size:0.68rem; color:#475569; font-weight:800;">CARGA RADIAL BANDAS (Fᵣ) Y P_eq</span>
            <div style="font-size:1.1rem; font-weight:800; color:var(--smat-text-primary);" data-bear-fr>6.71 kN (P = 14.81 kN)</div>
            <div style="font-size:0.75rem; color:#334155;" data-bear-rpm>n₂ = 1001 RPM • u₂ = 19.92 m/s</div>
          </div>
          <div style="background:#ecfdf5; border:1px solid #6ee7b7; border-radius:8px; padding:0.75rem;">
            <span class="font-mono-tech" style="font-size:0.68rem; color:#065f46; font-weight:800;">VIDA MODIFICADA SELLO LABERINTO SMAT</span>
            <div style="font-size:1.1rem; font-weight:800; color:#065f46;" data-bear-l10mh-lab>52,438 h (a_ISO = 1.25×)</div>
            <div style="font-size:0.75rem; color:#047857;" data-bear-l10h>Base ISO 281 L₁₀h = 41,950 h (e_c ≥ 0.6)</div>
          </div>
          <div style="background:#fef2f2; border:1px solid #fca5a5; border-radius:8px; padding:0.75rem;">
            <span class="font-mono-tech" style="font-size:0.68rem; color:#991b1b; font-weight:800;">RIESGO RETENES DE FIELTRO CONTAMINADOS</span>
            <div style="font-size:1.1rem; font-weight:800; color:#991b1b;" data-bear-l10mh-cont>9,229 h (a_ISO = 0.22×)</div>
            <div style="font-size:0.75rem; color:#7f1d1d;">Ingresión de sílice (e_c ≤ 0.1) reduce vida -82%</div>
          </div>
        </div>
        <div style="margin-top:0.85rem;">
          <a
            href="/cotizar/?circuito=bombeo&equipo=kit_rodamientos&pieza=bearing_assembly&estacion=S1&transmision=CV&cap_c_kn=195&l10h=41950#rfq"
            class="btn btn-primary"
            data-bear-cta
          >
            Cotizar Bearing Assembly Calibrado →
          </a>
        </div>
      </div>

      <SharePurchasing
        roleTitle="Bearing Assembly / Housing Completo"
        series="Marcos C, D, E y F (4x3 a 10x8)"
        metallurgy="Carcasa en Fundición Nodular, Flecha de Acero Aleado y Rodamientos Cónicos"
        specs="Cartucho cilíndrico completo ensamblado con flecha maquinada, rodamientos de rodillos cónicos y sellos laberinto."
        roleId="kit_rodamientos"
        circuit="bombeo"
        lang="es"
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { calculateDriveAndBearingKinematics } from '../../scripts/slurryEngine.js';

  function initBearingInspector() {
    const box = document.querySelector('[data-bearing-inspector]');
    if (!box) return;
    const arrSel = box.querySelector('[data-bear-arr]') as HTMLSelectElement | null;
    const cSel = box.querySelector('[data-bear-c]') as HTMLSelectElement | null;
    const kwInput = box.querySelector('[data-bear-kw]') as HTMLInputElement | null;
    const kwLbl = box.querySelector('[data-bear-kw-lbl]');
    const frEl = box.querySelector('[data-bear-fr]');
    const rpmEl = box.querySelector('[data-bear-rpm]');
    const l10hEl = box.querySelector('[data-bear-l10h]');
    const labEl = box.querySelector('[data-bear-l10mh-lab]');
    const contEl = box.querySelector('[data-bear-l10mh-cont]');
    const ctaEl = box.querySelector('[data-bear-cta]') as HTMLAnchorElement | null;

    const update = () => {
      const arrangement = arrSel?.value || 'CV';
      const dynamicCapacityCkN = Number(cSel?.value) || 195;
      const shaftPowerKw = Number(kwInput?.value) || 45;
      if (kwLbl) kwLbl.textContent = `${shaftPowerKw} kW`;
      const res = calculateDriveAndBearingKinematics({
        arrangement,
        dynamicCapacityCkN,
        shaftPowerKw
      });
      if (frEl) frEl.textContent = `${res.beltRadialLoadKn.toFixed(2)} kN (P = ${res.equivalentLoadPkN.toFixed(2)} kN)`;
      if (rpmEl) rpmEl.textContent = `n₂ = ${res.pumpRpm} RPM • u₂ = ${res.tipSpeedMs.toFixed(2)} m/s`;
      if (l10hEl) l10hEl.textContent = `Base ISO 281 L₁₀h = ${res.bearingL10Hours.toLocaleString('es-MX')} h (e_c ≥ 0.6)`;
      if (labEl) labEl.textContent = `${res.l10mhLabyrinthHours.toLocaleString('es-MX')} h (a_ISO = 1.25×)`;
      if (contEl) contEl.textContent = `${res.l10mhContaminatedHours.toLocaleString('es-MX')} h (a_ISO = 0.22×)`;
      if (ctaEl) {
        ctaEl.href = `/cotizar/?circuito=bombeo&equipo=kit_rodamientos&pieza=bearing_assembly&estacion=S1&transmision=${res.arrangement}&cap_c_kn=${res.dynamicCapacityCkN}&power_kw=${res.shaftPowerKw}&fr_kn=${res.beltRadialLoadKn.toFixed(2)}&l10h=${res.bearingL10Hours}#rfq`;
      }
    };

    [arrSel, cSel, kwInput].forEach((el) => {
      el?.addEventListener('input', update);
      el?.addEventListener('change', update);
    });
    update();
  }

  initBearingInspector();
  document.addEventListener('astro:page-load', initBearingInspector);
</script>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 2.75rem 0; border-bottom: 2px solid var(--smat-copper-accent); }
  .page-hero h1 { color: var(--smat-text-primary); margin-top: 0.5rem; }
  .back-link { color: var(--smat-copper-accent); font-size: 0.9rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .page-hero { padding: 0.75rem 0; }
    .page-hero h1 { font-size: 1.35rem; margin: 0.2rem 0; }
    .page-hero p { font-size: 0.82rem !important; line-height: 1.3; margin: 0.2rem 0; }
  }
</style>
