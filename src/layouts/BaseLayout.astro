---
import '../styles/global.css';
import '../styles/storefront-layout.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import QuickOrderTray from '../components/QuickOrderTray.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
  canonical?: string;
  canonicalPath?: string;
  alternateEsPath?: string;
  alternateEnPath?: string;
}

const ROUTE_ES_TO_EN: Record<string, string> = {
  '/': '/en/',
  '/catalogo/': '/en/catalog/',
  '/bombeo/': '/en/pumping/',
  '/flotacion/': '/en/flotation/',
  '/filtracion/': '/en/filtration/',
  '/clasificacion/': '/en/classification/',
  '/cumplimiento/': '/en/compliance/',
  '/control-de-procesos/': '/en/process-control/',
  '/cotizar/': '/en/quote/',
  '/diagnostico/': '/en/diagnostics/',
  '/garantia/': '/en/warranty/',
  '/nosotros/': '/en/about/',
  '/contacto/': '/en/contact/',
  '/aviso/': '/en/privacy/',
  '/acuse/': '/en/thank-you/',
};

const ROUTE_EN_TO_ES: Record<string, string> = Object.fromEntries(
  Object.entries(ROUTE_ES_TO_EN).map(([es, en]) => [en, es])
);

const rawPathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isEs = (Astro.props.lang ?? 'es') === 'es';
const defaultCanonical = Astro.props.canonicalPath ?? Astro.props.canonical ?? rawPathname;
const defaultEsPath = Astro.props.alternateEsPath ?? (isEs ? defaultCanonical : (ROUTE_EN_TO_ES[defaultCanonical] ?? '/'));
const defaultEnPath = Astro.props.alternateEnPath ?? (!isEs ? defaultCanonical : (ROUTE_ES_TO_EN[defaultCanonical] ?? '/en/'));

const {
  title,
  description,
  lang = 'es',
  canonicalPath = defaultCanonical,
  alternateEsPath = defaultEsPath,
  alternateEnPath = defaultEnPath,
} = Astro.props;
const siteUrl = 'https://smatminerals.com';
const fullCanonicalUrl = `${siteUrl}${canonicalPath}`;
const fullEsUrl = `${siteUrl}${alternateEsPath}`;
const fullEnUrl = `${siteUrl}${alternateEnPath}`;
const gaId = import.meta.env.PUBLIC_GA_ID;
const isTransactionTerminal = /^\/(cotizar|en\/quote|acuse|en\/thank-you)(\/|$)/.test(canonicalPath);
const fullTitle = /SMAT Minerals/i.test(title) ? title : `${title} | SMAT Minerals`;

// Domicilio Fiscal Oficial: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166 (Inyectado vía SchemaOrg.astro)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonicalUrl} />

    <!-- Hreflang Tags para SEO Bilingüe Simétrico -->
    <link rel="alternate" hreflang="es" href={fullEsUrl} />
    <link rel="alternate" hreflang="en" href={fullEnUrl} />
    <link rel="alternate" hreflang="x-default" href={fullEsUrl} />

    <!-- Favicon Vectorial Dinámico + Fallback ICO (Decisión 1-B) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- Open Graph / Redes Sociales (Decisión 2-B) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/images/og-card.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/og-card.jpg`} />

    <!-- Micro-script Zero-FOUC de Detección de Idioma (Síncrono en Head) -->
    <script is:inline>
      (function() {
        try {
          var path = window.location.pathname;
          var stored = localStorage.getItem('smat_locale_pref');
          var userLang = (navigator.language || navigator.userLanguage || '').toLowerCase();
          
          if (!stored) {
            // Si el usuario viene configurado en inglés y está en la raíz, redirigir a /en/ de inmediato
            if (userLang.startsWith('en') && !path.startsWith('/en')) {
              var target = '/en' + (path === '/' ? '/' : path);
              window.location.replace(target);
            }
          }
        } catch (e) {
          // Fallback silencioso si localStorage está bloqueado
        }
      })();
    </script>

    <!-- Schema.org JSON-LD Unificado -->
    <SchemaOrg canonicalPath={canonicalPath} lang={lang} />

    <!-- Telemetría Condicional: Solo se inyecta si PUBLIC_GA_ID existe (Decisión 5-B / Zero-Third-Party Debris) -->
    {gaId && (
      <>
        <script type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script type="text/partytown" define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId, { send_page_view: true, anonymize_ip: true });
        </script>
      </>
    )}
  </head>
  <body>
    <slot name="header">
      <Header
        lang={lang}
        currentPath={canonicalPath}
        alternatePath={isEs ? alternateEnPath : alternateEsPath}
      />
    </slot>
    <main>
      <slot />
    </main>
    <slot name="footer">
      <Footer lang={lang} />
    </slot>
    {!isTransactionTerminal && !/^\/(aviso|contacto|nosotros|en\/legal|en\/contact|en\/about|en\/privacy)(\/|$)/.test(canonicalPath) && <QuickOrderTray lang={lang} />}
    <WhatsAppButton lang={lang} />

    <!-- Script de Registro de Eventos Analíticos de SMAT -->
    <script is:inline>
      window.smatTrack = function(eventName, params) {
        try {
          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, params || {});
          }
          if (window.dataLayer) {
            window.dataLayer.push(Object.assign({ event: eventName }, params || {}));
          }
        } catch(e) {}
      };
    </script>

    <!-- Registro Soberano de Service Worker Offline-First y Badge Reactivo -->
    <script is:inline>
      (function() {
        var isEn = document.documentElement.lang === 'en';
        function getPendingOutboxCount() {
          try {
            var raw = window.localStorage && window.localStorage.getItem('smat_lead_outbox_v1');
            if (!raw) return 0;
            var arr = JSON.parse(raw);
            return Array.isArray(arr) ? arr.filter(function(it) { return it && it.status === 'pending'; }).length : 0;
          } catch (e) {
            return 0;
          }
        }
        function syncOfflineBadge() {
          var badge = document.getElementById('smat-offline-status');
          var retryBtn = document.getElementById('smat-offline-retry-btn');
          var sep = document.querySelector('.smat-offline-sep');
          if (!badge) return;
          var isOffline = navigator.onLine === false;
          var pending = getPendingOutboxCount();
          var visible = isOffline || pending > 0;
          badge.hidden = !visible;
          if (retryBtn) retryBtn.hidden = !visible;
          if (sep) sep.hidden = !visible;
          badge.classList.toggle('is-offline', isOffline);
          if (isOffline) {
            badge.textContent = isEn
              ? ('Offline Mode Active (' + pending + ' queued)')
              : ('Sin conexión (EN_COLA_OFFLINE: ' + pending + ')');
          } else if (pending > 0) {
            badge.textContent = isEn
              ? (pending + ' queued request(s) pending')
              : (pending + ' solicitud(es) pendiente(s) en cola');
          }
        }
        window.addEventListener('online', syncOfflineBadge);
        window.addEventListener('offline', syncOfflineBadge);
        window.addEventListener('smat:outbox-updated', syncOfflineBadge);
        document.addEventListener('click', function(ev) {
          var target = ev.target;
          if (target && target.id === 'smat-offline-retry-btn') {
            window.dispatchEvent(new CustomEvent('smat:outbox-retry'));
            syncOfflineBadge();
          }
        });
        syncOfflineBadge();
        if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
          window.addEventListener('load', function() {
            navigator.serviceWorker.register('/sw.js').then(function() {
              syncOfflineBadge();
            }).catch(function() {});
          });
        }
      })();
    </script>
  </body>
</html>
