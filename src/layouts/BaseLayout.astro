---
import '../styles/global.css';
import faqsData from '../../data/faqs.json';
import companyData from '../../data/company.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
  canonicalPath?: string;
  alternateEsPath?: string;
  alternateEnPath?: string;
}

const ROUTE_ES_TO_EN: Record<string, string> = {
  '/': '/en/',
  '/catalogo/': '/en/catalog/',
  '/bombeo/': '/en/pumping/',
  '/bombeo/skid/': '/en/pumping/skid/',
  '/bombeo/impulsor/': '/en/pumping/impeller/',
  '/bombeo/revestimientos/': '/en/pumping/liners/',
  '/bombeo/sello/': '/en/pumping/seal/',
  '/bombeo/soporte/': '/en/pumping/bearing-assembly/',
  '/flotacion/': '/en/flotation/',
  '/flotacion/celdas/': '/en/flotation/cells/',
  '/flotacion/mecanismos/': '/en/flotation/mechanisms/',
  '/filtracion/': '/en/filtration/',
  '/filtracion/prensa/': '/en/filtration/press/',
  '/filtracion/repuestos/': '/en/filtration/parts/',
  '/diagnostico/': '/en/diagnostics/',
  '/garantia/': '/en/warranty/',
  '/nosotros/': '/en/about/',
  '/contacto/': '/en/contact/',
  '/aviso/': '/en/privacy/',
  '/acuse/': '/en/thank-you/',
};

const ROUTE_EN_TO_ES: Record<string, string> = Object.fromEntries(
  Object.entries(ROUTE_ES_TO_EN).map(([es, en]) => [en, es])
);

const rawPathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isEs = (Astro.props.lang ?? 'es') === 'es';
const defaultCanonical = Astro.props.canonicalPath ?? rawPathname;
const defaultEsPath = Astro.props.alternateEsPath ?? (isEs ? defaultCanonical : (ROUTE_EN_TO_ES[defaultCanonical] ?? '/'));
const defaultEnPath = Astro.props.alternateEnPath ?? (!isEs ? defaultCanonical : (ROUTE_ES_TO_EN[defaultCanonical] ?? '/en/'));

const {
  title,
  description,
  lang = 'es',
  canonicalPath = defaultCanonical,
  alternateEsPath = defaultEsPath,
  alternateEnPath = defaultEnPath,
} = Astro.props;
const siteUrl = 'https://smatminerals.com';
const fullCanonicalUrl = `${siteUrl}${canonicalPath}`;
const fullEsUrl = `${siteUrl}${alternateEsPath}`;
const fullEnUrl = `${siteUrl}${alternateEnPath}`;
const gaId = import.meta.env.PUBLIC_GA_ID;

// Generación de BreadcrumbList Jerárquico
const pathSegments = canonicalPath.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    'position': 1,
    'name': isEs ? 'Inicio' : 'Home',
    'item': isEs ? `${siteUrl}/` : `${siteUrl}/en/`
  }
];

let accumulatedPath = isEs ? '' : '/en';
pathSegments.forEach((segment) => {
  if (segment === 'en') return;
  accumulatedPath += `/${segment}`;
  breadcrumbItems.push({
    '@type': 'ListItem',
    'position': breadcrumbItems.length + 1,
    'name': segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
    'item': `${siteUrl}${accumulatedPath}/`
  });
});

const schemaOrgData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'LocalBusiness', 'WholesaleStore'],
      '@id': 'https://smatminerals.com/#organization',
      'name': companyData.name || 'SMAT Minerals',
      'alternateName': 'SMAT',
      'legalName': companyData.legal_name || 'SMAT Minerals S.A. de C.V.',
      'url': 'https://smatminerals.com',
      'logo': 'https://smatminerals.com/images/logo-smat.png',
      'description': 'Suministro de bombas para lodos y refacciones en Alto Cromo (A05), Hule y Poliuretano, mecanismos para celdas de flotación y acondicionadores, filtros prensa y balanzas Marcy en Durango, México.',
      'telephone': ['+52-618-810-4408', '+52-618-810-4428'],
      'email': companyData.contact?.emails?.[0]?.address || 'ventas@smatminerals.com',
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': companyData.address?.street ? `${companyData.address.street}, ${companyData.address.colonia}` : 'Mariano Salas #114, Col. Primer Presidente',
        'addressLocality': companyData.address?.city || 'Durango',
        'addressRegion': companyData.address?.state || 'Durango',
        'postalCode': companyData.address?.postal_code || '34166',
        'addressCountry': companyData.address?.country_code || 'MX'
      },
      'geo': {
        '@type': 'GeoCoordinates',
        'latitude': companyData.address?.coordinates?.latitude || 24.0277,
        'longitude': companyData.address?.coordinates?.longitude || -104.6532
      },
      'openingHoursSpecification': [
        {
          '@type': 'OpeningHoursSpecification',
          'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          'opens': '08:00',
          'closes': '18:00'
        }
      ],
      'areaServed': ['Mexico', 'United States', 'Canada', 'Peru', 'Chile'],
      'knowsAbout': [
        'Slurry Pumps',
        'Bombas de Pulpa',
        'High Chrome 27% A05',
        'Flotation Cells',
        'Celdas de Flotación',
        'Filter Presses',
        'Filtros Prensa',
        'Dry Tailings',
        'Jales Secos',
        'Marcy Pulp Density Scales'
      ]
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${fullCanonicalUrl}#breadcrumb`,
      'itemListElement': breadcrumbItems
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      'mainEntity': (faqsData.faqs as Array<{ question_es: string; question_en: string; answer_es: string; answer_en: string }>).map((faq) => ({
        '@type': 'Question',
        'name': isEs ? faq.question_es : faq.question_en,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': isEs ? faq.answer_es : faq.answer_en
        }
      }))
    }
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | SMAT Minerals</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonicalUrl} />

    <!-- Hreflang Tags para SEO Bilingüe Simétrico -->
    <link rel="alternate" hreflang="es" href={fullEsUrl} />
    <link rel="alternate" hreflang="en" href={fullEnUrl} />
    <link rel="alternate" hreflang="x-default" href={fullEsUrl} />

    <!-- Tipografía Soberana Local / System Stack y Geometría Táctil Fitts >= 48x48 px (Zero External CDN Leak) -->
    <style is:inline>
      a,
      button,
      select,
      input:not([type="hidden"]),
      .btn,
      .nav-link,
      .lang-btn,
      .phone-pill,
      .header-cta,
      .footer-links a,
      .atomic-code-pill,
      .showcase-cta-primary,
      .showcase-cta-secondary,
      .perspective-action-btn,
      .case-circuit-link,
      .snippet-link,
      .btn-table-cta,
      .btn-action,
      .btn-back,
      .circuit-pill,
      .stress-chip,
      .flot-chip,
      .filt-chip,
      .preset-chip,
      .alt-chip,
      .role-tab {
        min-height: 48px !important;
        min-width: 48px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
      }
      select,
      input[type="text"],
      input[type="email"],
      input[type="tel"],
      textarea {
        display: block;
        padding-top: 10px;
        padding-bottom: 10px;
      }
      input[type="radio"],
      input[type="checkbox"] {
        width: 24px;
        height: 24px;
        min-width: 48px !important;
        min-height: 48px !important;
        cursor: pointer;
      }
      input[type="range"] {
        min-height: 48px !important;
        cursor: pointer;
      }
    </style>

    <!-- Favicon Vectorial Dinámico + Fallback ICO (Decisión 1-B) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- Open Graph / Redes Sociales (Decisión 2-B) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonicalUrl} />
    <meta property="og:title" content={`${title} | SMAT Minerals`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/images/og-card.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | SMAT Minerals`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/og-card.jpg`} />

    <!-- Micro-script Zero-FOUC de Detección de Idioma (Síncrono en Head) -->
    <script is:inline>
      (function() {
        try {
          var path = window.location.pathname;
          var stored = localStorage.getItem('smat_locale_pref');
          var userLang = (navigator.language || navigator.userLanguage || '').toLowerCase();
          
          if (!stored) {
            // Si el usuario viene configurado en inglés y está en la raíz, redirigir a /en/ de inmediato
            if (userLang.startsWith('en') && !path.startsWith('/en')) {
              var target = '/en' + (path === '/' ? '/' : path);
              window.location.replace(target);
            }
          }
        } catch (e) {
          // Fallback silencioso si localStorage está bloqueado
        }
      })();
    </script>

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgData)} />

    <!-- Telemetría Condicional: Solo se inyecta si PUBLIC_GA_ID existe (Decisión 5-B / Zero-Third-Party Debris) -->
    {gaId && (
      <>
        <script type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script type="text/partytown" define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId, { send_page_view: true, anonymize_ip: true });
        </script>
      </>
    )}
  </head>
  <body>
    <slot name="header">
      <Header
        lang={lang}
        currentPath={canonicalPath}
        alternatePath={isEs ? alternateEnPath : alternateEsPath}
      />
    </slot>
    <main>
      <slot />
    </main>
    <slot name="footer">
      <Footer lang={lang} />
    </slot>

    <!-- Script de Registro de Eventos Analíticos de SMAT -->
    <script is:inline>
      window.smatTrack = function(eventName, params) {
        try {
          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, params || {});
          }
          if (window.dataLayer) {
            window.dataLayer.push(Object.assign({ event: eventName }, params || {}));
          }
        } catch(e) {}
      };
    </script>

    <!-- Registro Soberano de Service Worker Offline-First (Decisión 7-C / GOLD-180) -->
    <script is:inline>
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function() {});
        });
      }
    </script>
  </body>
</html>
