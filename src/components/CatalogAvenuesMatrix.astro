---
/**
 * CatalogAvenuesMatrix.astro — Grid Visual Abierto V6.0 (19/19 SKUs con Foto Real)
 * Reemplaza las antiguas tarjetas de texto plano + barra Master-Detail redundante.
 */
import ProductStorefrontCard from './ProductStorefrontCard.astro';
import { getQuickProductsCatalog } from '../scripts/quickProductsCatalog.js';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const allSkus = getQuickProductsCatalog();

function mapCategoryBucket(sku: any): string {
  if (sku.vertical === 'clasificacion') return 'clasificacion';
  if (sku.vertical === 'flotacion') return 'flotacion';
  if (sku.vertical === 'filtracion') return 'filtracion';
  if (sku.vertical === 'control') return 'control';
  return 'bombeo';
}

const countBucket = (id: string) => allSkus.filter((s: any) => mapCategoryBucket(s) === id).length;
const projectOrderCount = allSkus.filter((s: any) => s.stock_regime === 'bajo_proyecto').length;
const categoryFilters = [
  { id: 'all', es: `Todos (${allSkus.length})`, en: `All (${allSkus.length})` },
  { id: 'bombeo', es: `Bombeo (${countBucket('bombeo')})`, en: `Pumping (${countBucket('bombeo')})` },
  { id: 'clasificacion', es: `Hidrociclones, Trituración y Cribas (${countBucket('clasificacion')})`, en: `Comminution & Screens (${countBucket('clasificacion')})` },
  { id: 'flotacion', es: `Flotación (${countBucket('flotacion')})`, en: `Flotation (${countBucket('flotacion')})` },
  { id: 'filtracion', es: `Filtración y Espesado (${countBucket('filtracion')})`, en: `Filtration & Thickeners (${countBucket('filtracion')})` },
  { id: 'control', es: `Laboratorio (${countBucket('control')})`, en: `Laboratory (${countBucket('control')})` },
  { id: 'bajo_proyecto', es: `Bajo proyecto (${projectOrderCount})`, en: `Project Order (${projectOrderCount})` },
];
---

<section class="catalog-avenues-ssot-section" id="indice-19-skus-7-avenidas" data-testid="catalog-avenues-matrix">
  <div class="avenues-toolbar">
    <div class="avenues-filter-row" role="group" aria-label={isEs ? 'Filtrar catálogo por área' : 'Filter catalog by area'}>
      {categoryFilters.map((cat, idx) => (
        <button
          type="button"
          class={`smat-cat-filter-btn${idx === 0 ? ' is-active' : ''}`}
          data-cat-filter={cat.id}
          aria-pressed={idx === 0 ? 'true' : 'false'}
        >
          {isEs ? cat.es : cat.en}
        </button>
      ))}
    </div>
    <span class="avenues-count-readout" id="catalog-visible-readout">
      {isEs ? 'Mostrando ' : 'Showing '}
      <strong id="catalog-visible-sku-count" data-schema-output="catalogFacet.visibleSkuCount">{allSkus.length}</strong>
      {isEs ? ` de ${allSkus.length} productos` : ` of ${allSkus.length} products`}
    </span>
  </div>

  <div class="smat-sf-grid" id="catalog-open-sku-grid">
    {allSkus.map((sku: any, idx: number) => {
      const catBucket = mapCategoryBucket(sku);
      const searchBlob = [
        sku.id,
        sku.title_es,
        sku.title_en,
        sku.oem_cross_ref,
        sku.vertical,
        sku.avenue,
        ...(Array.isArray(sku.atomic_codes) ? sku.atomic_codes : []),
        ...(Array.isArray(sku.available_materials) ? sku.available_materials : []),
      ]
        .filter(Boolean)
        .join(' ')
        .toLowerCase();

      return (
        <div
          class="catalog-sku-slot"
          data-catalog-sku-id={sku.id}
          data-sku-id={sku.id}
          data-sku-family={sku.vertical || 'bombeo'}
          data-stock-regime={sku.stock_regime || 'hay'}
          data-cat-bucket={catBucket}
          data-primary-avenue={sku.avenue || ''}
          data-facet-avenues={[sku.avenue, ...(sku.secondary_avenues || [])].filter(Boolean).join(',')}
          data-search-blob={searchBlob}
          data-initial-index={String(idx)}
          data-ergos-homogeneous-card="1"
        >
          <ProductStorefrontCard sku={sku} lang={lang} eager={idx < 6} />
        </div>
      );
    })}
  </div>
</section>

<script>
  function bindOpenCatalogMatrixFilters() {
    const grid = document.getElementById('catalog-open-sku-grid');
    if (!grid) return;
    const slots = Array.from(grid.querySelectorAll<HTMLElement>('.catalog-sku-slot'));
    const catBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cat-filter]'));
    const headerInput = document.getElementById('header-omnibox-input') as HTMLInputElement | null;
    const readout = document.getElementById('catalog-visible-readout');
    const countBadge = document.getElementById('catalog-visible-sku-count');
    const isEn = document.documentElement.lang === 'en';
    const initialQ = typeof window !== 'undefined' ? String(new URLSearchParams(window.location.search).get('q') || '').trim() : '';
    if (initialQ && headerInput && !headerInput.value) {
      headerInput.value = initialQ;
    }
    let activeCat = 'all';

    const applyFilter = () => {
      const rawQuery = headerInput?.value || '';
      const tokens = String(rawQuery).trim().toLowerCase().split(/\s+/).filter(Boolean);
      let visible = 0;
      slots.forEach((slot) => {
        const bucket = slot.getAttribute('data-cat-bucket') || 'bombeo';
        const regime = slot.getAttribute('data-stock-regime') || 'hay';
        const blob = slot.getAttribute('data-search-blob') || '';
        const matchCat =
          activeCat === 'all' ||
          (activeCat === 'bajo_proyecto' ? regime === 'bajo_proyecto' : bucket === activeCat);
        const matchQuery = tokens.length === 0 || tokens.every((t) => blob.includes(t));
        const show = matchCat && matchQuery;
        slot.hidden = !show;
        slot.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });
      if (countBadge) {
        countBadge.textContent = String(visible);
      } else if (readout) {
        readout.textContent = isEn
          ? `Showing ${visible} of ${slots.length} products`
          : `Mostrando ${visible} de ${slots.length} productos`;
      }
    };

    catBtns.forEach((btn) => {
      if (btn.dataset.catBound === '1') return;
      btn.dataset.catBound = '1';
      btn.addEventListener('click', () => {
        activeCat = btn.getAttribute('data-cat-filter') || 'all';
        catBtns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        applyFilter();
      });
    });

    if (headerInput && headerInput.dataset.openGridHeaderBound !== '1') {
      headerInput.dataset.openGridHeaderBound = '1';
      headerInput.addEventListener('input', applyFilter);
    }
    if (initialQ) {
      applyFilter();
    }
  }

  bindOpenCatalogMatrixFilters();
  document.addEventListener('astro:page-load', bindOpenCatalogMatrixFilters);
</script>

<style>
  .catalog-avenues-ssot-section { margin: 0 0 1.75rem; }
  .avenues-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 1.15rem; }
  .avenues-filter-row { display: flex; flex-wrap: nowrap; overflow-x: auto; max-width: 100%; padding: 0 1.5rem 0.25rem 0; gap: 0.45rem; scrollbar-width: thin; -webkit-mask-image: linear-gradient(to right, #000 88%, transparent); mask-image: linear-gradient(to right, #000 88%, transparent); }
  @media (min-width: 768px) { .avenues-filter-row { flex-wrap: wrap; overflow-x: visible; padding: 0; -webkit-mask-image: none; mask-image: none; } }
  .smat-cat-filter-btn { flex: 0 0 auto; white-space: nowrap; min-height: 48px; min-width: 48px; padding: 0.45rem 0.9rem; border-radius: 9999px; border: 1px solid #cbd5e1; background: #ffffff; color: #0f172a; font-size: 0.82rem; font-weight: 700; cursor: pointer; }
  .smat-cat-filter-btn:hover { border-color: #7c2d12; color: #7c2d12; }
  .smat-cat-filter-btn.is-active { background: #0f172a; border-color: #0f172a; color: #ffffff; }
  .avenues-count-readout { font-family: var(--smat-font-mono, monospace); font-size: 0.8rem; font-weight: 700; color: #334155; }
  .catalog-sku-slot { display: flex; }
  .catalog-sku-slot[hidden] { display: none; }
  .catalog-sku-slot > :global(.smat-sf-card) { width: 100%; }
  .catalog-expand-row { display: flex; justify-content: center; }
</style>
