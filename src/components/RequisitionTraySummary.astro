---
// src/components/RequisitionTraySummary.astro
// Bandeja Unificada de Requisición Multi-Ítem B2B (`SLICE-V80-B05`)
// Sin <select> redundante: FastLaneBomBar en Paso 1 actúa como único canal de alta.

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const initialUrgencyHuman = isEs ? 'Borrador sin partidas' : 'Draft — Empty Tray';
---

<section
  class="req-tray-card"
  id="smat-requisition-tray-summary"
  data-requisition-tray
  aria-labelledby="req-tray-title"
>
  <div class="req-tray-header">
    <div>
      <span class="req-tray-badge">
        {isEs ? 'PARTIDAS ACTIVAS DE LA REQUISICIÓN INDUSTRIAL' : 'MULTI-ITEM B2B REQUISITION TRAY'}
      </span>
      <h3 id="req-tray-title" class="req-tray-title">
        {isEs ? 'Resumen de Partidas y Prioridad de Despacho' : 'Active Line Items & Priority Dispatch Routing'}
      </h3>
    </div>
    <button type="button" class="req-tray-clear-btn hidden" id="tray-clear-btn">
      {isEs ? 'Vaciar Bandeja' : 'Clear Tray'}
    </button>
  </div>

  <div class="req-tray-cmu-strip">
    <span class="req-tray-cmu-label">
      {isEs ? 'CABECERA DE PRIORIDAD DE DESPACHO DURANGO:' : 'DURANGO DISPATCH PRIORITY HEADER:'}
    </span>
    <code id="tray-cmu-subject-line" class="req-tray-cmu-code">
      {isEs
        ? '[SMAT-DGO] [BORRADOR SIN PARTIDAS | 0 SKUs]'
        : '[SMAT-DGO] [DRAFT NO ITEMS | 0 SKUs]'}
    </code>
    <div id="tray-priority-sla-meta" data-testid="tray-priority-sla-meta" class="font-mono-tech smat-tray-priority-sla-meta">
      {isEs ? `${initialUrgencyHuman} • Añada SKUs para asignar SLA` : `${initialUrgencyHuman} • Add SKUs to assign SLA`}
    </div>
  </div>

  <div class="req-tray-table-wrap">
    <table class="req-tray-table">
      <thead>
        <tr>
          <th>{isEs ? 'SKU / Código' : 'SKU / Code'}</th>
          <th>{isEs ? 'Descripción Técnica' : 'Technical Description'}</th>
          <th>{isEs ? 'Cant.' : 'Qty'}</th>
          <th>{isEs ? 'Régimen Operativo' : 'Operating Regime'}</th>
          <th>{isEs ? 'Acción' : 'Action'}</th>
        </tr>
      </thead>
      <tbody id="tray-items-tbody">
        <tr>
          <td colspan="5" class="req-tray-empty">
            {isEs
              ? 'Sin partidas en bandeja. Capture códigos arriba o seleccione productos del catálogo.'
              : 'No items in tray yet. Enter codes above or add products from the catalog.'}
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<script>
  import {
    SMAT_TRAY_UPDATE_EVENT,
    getTrayState,
    addTrayItem,
    removeTrayItem,
    computeCmuPriorityDescriptor,
    buildCmuPrioritySubjectLine,
    hydrateTrayFromReorderQuery
  } from '../scripts/requisitionTrayBus.js';
  import { hydrateRfqSessionFromUrl } from '../scripts/rfqSessionStore.js';
  import { formatCheckoutLaneHuman, formatUrgencyBandHuman } from '../scripts/i18nDomainLabels.js';
  import { getQuickProductsCatalog } from '../scripts/quickProductsCatalog.js';

  function initRequisitionTraySummary() {
    hydrateRfqSessionFromUrl(window.location.search);
    const root = document.querySelector('[data-requisition-tray]') as HTMLElement | null;
    if (!root) return;
    const isEn = document.documentElement.lang === 'en';
    const lang: 'es' | 'en' = isEn ? 'en' : 'es';
    const tbody = root.querySelector('#tray-items-tbody') as HTMLElement | null;
    const cmuCode = root.querySelector('#tray-cmu-subject-line') as HTMLElement | null;
    const cmuMeta = root.querySelector('#tray-priority-sla-meta') as HTMLElement | null;
    const clearBtn = root.querySelector('#tray-clear-btn') as HTMLElement | null;

    if (typeof window !== 'undefined' && window.location.search.includes('tray=')) {
      hydrateTrayFromReorderQuery(window.location.search);
    }
    if (typeof window !== 'undefined' && window.location.search.includes('sku=')) {
      const params = new URLSearchParams(window.location.search);
      const urlSku = (params.get('sku') || '').trim().toUpperCase();
      if (urlSku) {
        const matched = getQuickProductsCatalog().find((item) => String(item.id || '').toUpperCase() === urlSku);
        if (matched) {
          const currentTray = getTrayState();
          if (!currentTray.items.some((i: any) => i.skuId === matched.id)) {
            addTrayItem({
              skuId: matched.id,
              atomicCode: matched.atomic_codes?.[0] || matched.id,
              nameEs: matched.title_es || matched.id,
              nameEn: matched.title_en || matched.id,
              circuit: matched.vertical || 'bombeo',
              qty: 1,
              criticalityMode: 'PARO_DE_LINEA'
            });
          }
        }
      }
    }

    const renderTray = () => {
      const state = getTrayState();
      const desc = computeCmuPriorityDescriptor({ ...state, lang });
      clearBtn?.classList.toggle('hidden', !state.items.length);
      if (cmuCode) {
        cmuCode.textContent = buildCmuPrioritySubjectLine(state, { cvPct: 52, material: 'Cr27', lang });
      }
      if (cmuMeta) {
        if (!state.items.length) {
          cmuMeta.textContent = isEn
            ? 'Draft — Empty Tray • Add SKUs to assign priority & SLA'
            : 'Borrador sin partidas • Añada SKUs para asignar prioridad y SLA';
        } else {
          const urgencyHuman = formatUrgencyBandHuman(state.criticalityMode, lang);
          const laneHuman = formatCheckoutLaneHuman(desc.checkoutLane, lang);
          cmuMeta.textContent = isEn
            ? `${urgencyHuman} • ${laneHuman} • Response SLA: ≤ ${desc.slaResponseMinutes} min`
            : `${urgencyHuman} • ${laneHuman} • SLA Respuesta: ≤ ${desc.slaResponseMinutes} min`;
        }
      }
      if (!tbody) return;
      if (!state.items.length) {
        tbody.innerHTML = `<tr><td colspan="5" class="req-tray-empty">${
          isEn
            ? 'No items in tray yet. Enter codes above or add products from /en/catalog/.'
            : 'Sin partidas en bandeja. Capture códigos arriba o seleccione productos en /catalogo/.'
        }</td></tr>`;
        return;
      }

      tbody.innerHTML = state.items
        .map(
          (item: any) => `
          <tr data-tray-row="${item.id}">
            <td><strong>${item.skuId}</strong></td>
            <td>${isEn ? item.nameEn : item.nameEs}</td>
            <td><strong>${item.qty}</strong></td>
            <td><span class="req-mode-pill">${item.criticalityMode === 'PARO_DE_LINEA' ? (isEn ? 'LINE-STOP' : 'PARO DE LÍNEA') : (isEn ? 'STOCK REPLENISHMENT' : 'REPOSICIÓN STOCK')}</span></td>
            <td><button type="button" class="req-remove-btn" data-remove-sku="${item.id}">×</button></td>
          </tr>
        `
        )
        .join('');

      tbody.querySelectorAll('[data-remove-sku]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-remove-sku') || '';
          removeTrayItem(target);
          renderTray();
        });
      });
    };

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        const state = getTrayState();
        state.items.forEach((i: any) => removeTrayItem(i.id));
        renderTray();
      });
    }

    window.addEventListener(SMAT_TRAY_UPDATE_EVENT, renderTray);
    renderTray();
  }

  initRequisitionTraySummary();
</script>

<style>
  .req-tray-card { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 10px; padding: 1.15rem; margin-bottom: 1.25rem; }
  .req-tray-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.75rem; }
  .req-tray-badge { display: inline-block; font-family: var(--smat-font-mono, monospace); font-size: 0.7rem; font-weight: 800; color: #7c2d12; background: #fff7ed; border: 1px solid #fed7aa; padding: 0.15rem 0.5rem; border-radius: 4px; margin-bottom: 0.35rem; }
  .req-tray-title { margin: 0; font-size: 1.05rem; color: #090d16; }
  .req-tray-clear-btn { background: #f8fafc; border: 1px solid #cbd5e1; color: #475569; padding: 0.35rem 0.7rem; border-radius: 6px; font-size: 0.78rem; font-weight: 700; cursor: pointer; }
  .req-tray-cmu-strip { background: #f8fafc; border: 1px solid #e2e8f0; border-left: 3px solid #082f49; padding: 0.55rem 0.8rem; border-radius: 6px; margin-bottom: 0.85rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .req-tray-cmu-label { font-size: 0.68rem; font-weight: 800; color: #475569; }
  .req-tray-cmu-code { font-family: var(--smat-font-mono, monospace); font-size: 0.8rem; font-weight: 700; color: #082f49; word-break: break-all; }
  .req-tray-table-wrap { overflow-x: auto; }
  .req-tray-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
  .req-tray-table th, .req-tray-table td { padding: 0.5rem 0.6rem; border-bottom: 1px solid #e2e8f0; text-align: left; }
  .req-tray-empty { color: #64748b; font-style: italic; }
  .req-mode-pill { display: inline-block; padding: 0.15rem 0.45rem; background: #f0f9ff; color: #082f49; border-radius: 4px; font-family: var(--smat-font-mono, monospace); font-size: 0.7rem; font-weight: 700; }
  .req-remove-btn { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; border-radius: 4px; padding: 0.15rem 0.5rem; font-weight: 800; cursor: pointer; }
</style>
