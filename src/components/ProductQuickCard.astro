---
import TechnicalDiagrams from './TechnicalDiagrams.astro';
import atomicPartsCatalog from '../../data/atomic_parts.json';
import { formatDiagramHumanTitle } from '../scripts/verticalCalculatorsAndLabelsBridge.js';
import { formatAvailabilityBadgeHuman } from '../scripts/i18nDomainLabels.js';

interface GeometricTriplet {
  a_id_mm: number;
  b_od_mm: number;
  c_thickness_mm: number;
  tolerance_std?: string;
  label_es?: string;
  label_en?: string;
}

interface SatTuple {
  clave_prod_serv?: string;
  clave_unidad?: string;
  uso_cfdi?: string;
  fraccion_arancelaria?: string;
}

interface ConfigOption {
  value: string;
  label: string;
}

interface GallerySlideSpec {
  slot: string;
  src: string;
  caption_es?: string;
  caption_en?: string;
}

interface Props {
  sku: {
    id: string;
    slug_es: string;
    slug_en: string;
    title_es: string;
    title_en: string;
    diagram_id: string;
    secondary_diagram_id?: string;
    photo_webp?: string;
    gallery_webp?: GallerySlideSpec[];
    default_material: string;
    available_materials?: string[];
    config_options_es?: ConfigOption[];
    config_options_en?: ConfigOption[];
    sat_tuple?: SatTuple;
    stock_regime?: string;
    availability_regime?: string;
    kit_id?: number;
    gate_lock?: string;
    mass_kg: number;
    atomic_codes: string[];
    linked_atomic_codes?: string[];
    everyday_scale_es: string;
    everyday_scale_en: string;
    geometric_triplet_mm?: GeometricTriplet;
  };
  lang?: 'es' | 'en';
  mode?: 'card' | 'media-only';
  primaryPhotoOverride?: string;
}

const { sku, lang = 'es', mode = 'card', primaryPhotoOverride = '' } = Astro.props;
const isMediaOnly = mode === 'media-only';
const isEs = lang === 'es';
const photoUrl = primaryPhotoOverride || sku.photo_webp || `/images/productos/${sku.slug_es}.webp`;
const baseGallery: GallerySlideSpec[] = Array.isArray(sku.gallery_webp) && sku.gallery_webp.length > 0
  ? sku.gallery_webp
  : [{ slot: 'primary', src: sku.photo_webp || `/images/productos/${sku.slug_es}.webp`, caption_es: sku.title_es, caption_en: sku.title_en }];
const mergedSlides: Array<{ tabKey: string; src: string; caption: string }> = [];
const seenSrc = new Set<string>();
const addSlide = (src: string, caption: string) => {
  if (!src || seenSrc.has(src)) return;
  seenSrc.add(src);
  const tabKey = mergedSlides.length === 0 ? 'photo' : `photo-${mergedSlides.length}`;
  mergedSlides.push({ tabKey, src, caption });
};
if (primaryPhotoOverride) {
  addSlide(primaryPhotoOverride, isEs ? `Fotografía real · ${sku.title_es}` : `Real part photo · ${sku.title_en}`);
}
for (const g of baseGallery) {
  addSlide(g.src, String((isEs ? g.caption_es : g.caption_en) || (isEs ? sku.title_es : sku.title_en)));
}
const photoSlides = mergedSlides.length > 0 ? mergedSlides : [{ tabKey: 'photo', src: photoUrl, caption: isEs ? sku.title_es : sku.title_en }];
const atomicSheetMap = new Map(
  (atomicPartsCatalog as Array<{ part_number?: string; code?: string }>).map((part) => [
    String(part.part_number || '').toUpperCase(),
    String(part.code || part.part_number || '').toLowerCase()
  ])
);
const linkedAtomicCodes = Array.isArray(sku.linked_atomic_codes) && sku.linked_atomic_codes.length > 0
  ? sku.linked_atomic_codes
  : (Array.isArray(sku.atomic_codes) ? sku.atomic_codes : []);
const triplet = sku.geometric_triplet_mm || {
  a_id_mm: 100,
  b_od_mm: 400,
  c_thickness_mm: 80,
  tolerance_std: 'ISO 2768-m',
  label_es: 'A: Ø Int. 100 mm | B: Ø Ext. 400 mm | C: Espesor 80 mm',
  label_en: 'A: Bore ID 100 mm | B: Outer OD 400 mm | C: Thickness 80 mm'
};
const satTuple = sku.sat_tuple || { clave_prod_serv: '40151510', clave_unidad: 'H87', uso_cfdi: 'G03' };
const fallbackMaterials = Array.isArray(sku.available_materials) && sku.available_materials.length > 0
  ? sku.available_materials
  : [sku.default_material || 'A05'];
const configOptions: ConfigOption[] = (isEs ? sku.config_options_es : sku.config_options_en) ||
  fallbackMaterials.map((mat) => ({ value: mat, label: mat }));

const skuTitle = isEs ? sku.title_es : sku.title_en;
const avail = formatAvailabilityBadgeHuman(sku.stock_regime, lang);
const waText = isEs
  ? `Hola SMAT Durango, solicito disponibilidad e información para ${skuTitle} (SKU: ${sku.id}, Material: ${sku.default_material}).`
  : `Hello SMAT Durango, requesting stock availability for ${skuTitle} (SKU: ${sku.id}, Material: ${sku.default_material}).`;
const waDefaultHref = `https://wa.me/526183670664?text=${encodeURIComponent(waText)}`;
---

<section
  class="product-quick-card"
  data-product-quick-card={sku.id}
  data-stock-regime={sku.stock_regime || 'hay'}
  data-availability-regime={sku.availability_regime || 'stock_durango'}
  data-kit-id={String(sku.kit_id || 1)}
  data-gate-lock={sku.gate_lock || 'G1'}
>
  <div class="smat-qcard-stage smat-qcard-stage-ratio" data-qcard-media-only={isMediaOnly ? '1' : '0'}>
    {/* Slide 0 literal por invariante smat-gate V6/V7 + slides multiángulo adicionales */}
    <div data-qcard-panel="photo" class="smat-qcard-panel smat-qcard-panel--photo">
      <img
        src={photoSlides[0].src}
        alt={photoSlides[0].caption || skuTitle}
        width="640"
        height="480"
        loading={isMediaOnly ? 'eager' : 'lazy'}
        fetchpriority={isMediaOnly ? 'high' : 'auto'}
        decoding="async"
        class="smat-qcard-photo"
      />
    </div>
    {photoSlides.slice(1).map((slide) => (
      <div data-qcard-panel={slide.tabKey} class="smat-qcard-panel smat-qcard-panel--photo hidden" hidden>
        <img
          src={slide.src}
          alt={slide.caption || skuTitle}
          width="640"
          height="480"
          loading="lazy"
          decoding="async"
          class="smat-qcard-photo"
        />
      </div>
    ))}

    <!-- Diagrama técnico 2D -->
    <div data-qcard-panel="cad" class="smat-qcard-panel hidden" hidden>
      <div class="smat-qcard-diagram-wrap">
        <TechnicalDiagrams diagram={sku.diagram_id} lang={lang} showXrayOverlay={false} showXrayLegend={false} />
      </div>
    </div>

    <!-- Escala cotidiana 0.76 mm y desgaste 5:5:4 -->
    <div data-qcard-panel="xray" class="smat-qcard-panel hidden" hidden>
      <div class="smat-qcard-scale-box" data-xray-overlay-legend={sku.id} data-diagram-id={sku.diagram_id}>
        <strong class="smat-qcard-scale-title">
          {isEs ? 'Cotejo Geométrico Drop-In 1:1' : '1:1 Drop-In Dimensional Verification'}
        </strong>
        <p>{isEs ? triplet.label_es : triplet.label_en} ({triplet.tolerance_std || 'ISO 2768-m'})</p>
        <p>
          <strong>{isEs ? 'Escala 0.76 mm:' : '0.76 mm Scale:'}</strong>{' '}
          {isEs ? sku.everyday_scale_es : sku.everyday_scale_en}
        </p>
      </div>
    </div>
  </div>

  <!-- Miniaturas cuadradas 48x48 debajo del visor (Estilo Amazon) -->
  <div class="smat-qcard-header">
    <div class="smat-qcard-tablist smat-qcard-thumbs-row" role="tablist" aria-label={isEs ? 'Vistas y galería del producto' : 'Product gallery and technical views'}>
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-qcard-tab="photo"
        aria-label={photoSlides[0].caption || (isEs ? 'Vista principal' : 'Primary view')}
        title={photoSlides[0].caption}
        class="qcard-tab-btn qcard-thumb-btn is-active"
      >
        <img
          src={photoSlides[0].src}
          alt=""
          width="48"
          height="48"
          loading="lazy"
          decoding="async"
          class="smat-qcard-thumb-img"
        />
      </button>
      {photoSlides.slice(1).map((slide, idx) => (
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-qcard-tab={slide.tabKey}
          aria-label={slide.caption || (isEs ? `Vista ${idx + 2}` : `View ${idx + 2}`)}
          title={slide.caption}
          class="qcard-tab-btn qcard-thumb-btn"
        >
          <img
            src={slide.src}
            alt=""
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
            class="smat-qcard-thumb-img"
          />
        </button>
      ))}
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-qcard-tab="cad"
        aria-label={isEs ? 'Diagrama técnico' : 'Technical Diagram'}
        title={isEs ? 'Diagrama técnico 2D' : '2D Technical Diagram'}
        class="qcard-tab-btn qcard-thumb-btn qcard-thumb-btn--spec"
      >
        <span>CAD</span>
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-qcard-tab="xray"
        aria-label={isEs ? 'Medidas A-B-C' : 'Dimensions A-B-C'}
        title={isEs ? 'Medidas A-B-C y tolerancia' : 'A-B-C Dimensions & Tolerance'}
        class="qcard-tab-btn qcard-thumb-btn qcard-thumb-btn--spec"
      >
        <span>A·B·C</span>
      </button>
    </div>

    {!isMediaOnly && (
      <span class={`smat-sf-badge smat-sf-badge--${avail.tone}`}>
        {avail.label}
      </span>
    )}
  </div>

  {!isMediaOnly && (
  <div class="smat-qcard-footer">
    <div class="smat-qcard-footer-row">
      <div class="smat-qcard-meta">
        <div class="smat-qcard-triplet-row">
          <span class="smat-qcard-triplet-badge">{isEs ? triplet.label_es : triplet.label_en}</span>
          <span class="smat-qcard-tolerance-badge">{triplet.tolerance_std || 'ISO 2768-m'}</span>
        </div>
        {(linkedAtomicCodes.length > 0 || sku.secondary_diagram_id) && (
          <div class="smat-qcard-fiscal-row" data-qcard-ssot-links={sku.id}>
            {sku.secondary_diagram_id && (
              <span class="smat-qcard-lane-pill" data-secondary-diagram-id={sku.secondary_diagram_id}>
                {formatDiagramHumanTitle(sku.secondary_diagram_id, lang)}
              </span>
            )}
            {linkedAtomicCodes.map((rawCode) => {
              const norm = String(rawCode || '').trim().toUpperCase();
              const slug = atomicSheetMap.get(norm);
              const isExplicitLink = Array.isArray(sku.linked_atomic_codes) && sku.linked_atomic_codes.length > 0;
              return slug && isExplicitLink ? (
                <a href={isEs ? `/catalogo/${slug}/` : `/en/catalog/${slug}/`} class="smat-qcard-tolerance-badge">
                  {norm} →
                </a>
              ) : (
                <span class="smat-qcard-tolerance-badge">{norm}</span>
              );
            })}
          </div>
        )}
      </div>

      <div class="smat-qcard-controls">
        <select class="smat-qcard-config-select" data-qcard-config={sku.id} aria-label={isEs ? `Material para ${sku.title_es}` : `Material for ${sku.title_en}`}>
          {configOptions.map((opt) => (
            <option value={opt.value} selected={opt.value === sku.default_material}>{opt.label}</option>
          ))}
        </select>
        <div class="smat-qcard-actions">
          <a href={waDefaultHref} target="_blank" rel="noopener noreferrer" data-qcard-wa-btn={sku.id} data-sku-id={sku.id} data-sku-title={skuTitle} data-sku-sat={`${satTuple.clave_prod_serv}/${satTuple.clave_unidad}`} data-sku-lang={lang} class="smat-qcard-wa-btn">
            {isEs ? 'WhatsApp' : 'WhatsApp'}
          </a>
          <button type="button" data-qcard-add-btn={sku.id} data-quick-tray-add={sku.id} data-sku-title={skuTitle} data-sku-code={sku.atomic_codes[0] || sku.id} data-sku-material={sku.default_material} data-sku-regime={sku.stock_regime || 'hay'} data-sku-mass={sku.mass_kg} class="smat-qcard-cta-btn">
            {isEs ? '+ Agregar a cotización' : '+ Add to quote'}
          </button>
        </div>
      </div>
    </div>
  </div>
  )}
</section>

<script>
  function initProductQuickCards() {
    document.querySelectorAll('[data-product-quick-card]').forEach((card) => {
      if (card.getAttribute('data-qcard-bound') === '1') return;
      card.setAttribute('data-qcard-bound', '1');

      const tabs = card.querySelectorAll('[data-qcard-tab]');
      const panels = card.querySelectorAll('[data-qcard-panel]');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-qcard-tab');
          tabs.forEach((t) => {
            const active = t.getAttribute('data-qcard-tab') === target;
            t.setAttribute('aria-selected', active ? 'true' : 'false');
            t.classList.toggle('is-active', active);
          });
          panels.forEach((panel) => {
            const match = panel.getAttribute('data-qcard-panel') === target;
            panel.classList.toggle('hidden', !match);
            if (panel instanceof HTMLElement) panel.hidden = !match;
          });
        });
      });

      const configSelect = card.querySelector('[data-qcard-config]');
      const addBtn = card.querySelector('[data-qcard-add-btn]');
      const waBtn = card.querySelector('[data-qcard-wa-btn]');
      if (configSelect instanceof HTMLSelectElement) {
        configSelect.addEventListener('change', () => {
          const mat = configSelect.value;
          if (addBtn instanceof HTMLElement) addBtn.setAttribute('data-sku-material', mat);
          if (waBtn instanceof HTMLAnchorElement) {
            const id = waBtn.getAttribute('data-sku-id') || '';
            const title = waBtn.getAttribute('data-sku-title') || '';
            const isEn = waBtn.getAttribute('data-sku-lang') === 'en';
            const msg = isEn
              ? `Hello SMAT Durango, requesting quote for ${title} (SKU: ${id}, Material: ${mat}).`
              : `Hola SMAT Durango, solicito cotización para ${title} (SKU: ${id}, Material: ${mat}).`;
            waBtn.href = `https://wa.me/526183670664?text=${encodeURIComponent(msg)}`;
          }
        });
      }
    });
  }

  initProductQuickCards();
  document.addEventListener('astro:page-load', initProductQuickCards);
</script>

<style>
  .product-quick-card {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.06);
  }
  .smat-qcard-stage { position: relative; width: 100%; background: #ffffff; aspect-ratio: 4 / 3; }
  .smat-qcard-panel { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 0.75rem; overflow: auto; }
  .smat-qcard-panel--photo { padding: 0; overflow: hidden; }
  .smat-qcard-panel.hidden, .smat-qcard-panel[hidden] { display: none !important; }
  .smat-qcard-diagram-wrap { width: 100%; }
  .smat-qcard-photo { width: 100%; height: 100%; object-fit: cover; display: block; border: none; border-radius: 0; }
  .smat-qcard-scale-box { padding: 1.25rem; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; font-size: 0.88rem; color: #0f172a; display: grid; gap: 0.5rem; max-width: 92%; }
  .smat-qcard-scale-title { color: #7c2d12; font-size: 0.95rem; }
  .smat-qcard-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.6rem 0.9rem; background: #f8fafc; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; }
  .smat-qcard-thumbs-row { display: flex; flex-wrap: nowrap; align-items: center; gap: 0.45rem; overflow-x: auto; scrollbar-width: thin; }
  .qcard-tab-btn { width: 52px; height: 52px; min-height: 48px; min-width: 48px; flex: 0 0 auto; padding: 2px; border-radius: 8px; border: 1px solid #cbd5e1; background: #ffffff; color: #334155; font-size: 0.68rem; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  .qcard-tab-btn.is-active { border: 2px solid #92400e; background: #fef3c7; color: #78350f; }
  .smat-qcard-thumb-img { width: 100%; height: 100%; object-fit: cover; border-radius: 6px; display: block; }
  @media (max-width: 767px) { .smat-qcard-stage-ratio[data-qcard-media-only="1"] { max-height: 280px; } }
  .smat-qcard-footer { padding: 0.8rem 0.95rem; background: #ffffff; }
  .smat-qcard-footer-row { display: flex; flex-direction: column; gap: 0.7rem; }
  @media (min-width: 768px) { .smat-qcard-footer-row { flex-direction: row; align-items: center; justify-content: space-between; } }
  .smat-qcard-meta { display: flex; flex-direction: column; gap: 0.3rem; }
  .smat-qcard-triplet-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; font-family: var(--smat-font-mono, monospace); font-size: 0.74rem; }
  .smat-qcard-triplet-badge { padding: 0.15rem 0.5rem; border-radius: 4px; background: #f8fafc; border: 1px solid #cbd5e1; color: #0f172a; font-weight: 600; }
  .smat-qcard-tolerance-badge { padding: 0.15rem 0.5rem; border-radius: 4px; background: #ecfdf5; border: 1px solid #059669; color: #064e3b; font-weight: 700; text-decoration: none; }
  .smat-qcard-fiscal-row { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.2rem; }
  .smat-qcard-lane-pill { font-family: var(--smat-font-mono, monospace); font-size: 0.7rem; padding: 0.15rem 0.5rem; border-radius: 4px; border: 1px solid #7c2d12; background: #fffbeb; color: #7c2d12; font-weight: 600; }
  .smat-qcard-controls { display: flex; flex-direction: column; gap: 0.45rem; min-width: 240px; }
  .smat-qcard-config-select { min-height: 44px; padding: 0.35rem 0.6rem; border-radius: 8px; border: 1px solid #cbd5e1; background: #ffffff; font-size: 0.78rem; font-weight: 600; }
  .smat-qcard-actions { display: flex; gap: 0.45rem; }
  .smat-qcard-wa-btn, .smat-qcard-cta-btn { min-height: 48px; flex: 1 1 auto; display: inline-flex; align-items: center; justify-content: center; padding: 0.45rem 0.85rem; border-radius: 8px; font-size: 0.78rem; font-weight: 700; text-decoration: none; cursor: pointer; }
  .smat-qcard-wa-btn { border: 1px solid #064e3b; background: #065f46; color: #ffffff; }
  .smat-qcard-cta-btn { border: 1px solid #431407; background: #7c2d12; color: #ffffff; }
</style>
