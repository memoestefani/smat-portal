---
interface Props {
  variant?: 'light' | 'dark';
  height?: number;
  className?: string;
}

const { variant = 'light', height = 36, className = '' } = Astro.props;
const logoSrc = variant === 'dark' ? '/images/logo-smat-dark.webp' : '/images/logo-smat.webp';
const sizeKey = height === 44 ? '44' : height === 32 ? '32' : height === 28 ? '28' : '36';
---

<div class={`smat-logo-wrap smat-logo-wrap--${sizeKey} ${variant} ${className}`}>
  <img 
    src={logoSrc} 
    alt="SMAT Minerals" 
    width="511" 
    height="155"
    class={`smat-brand-img smat-logo-img smat-logo-img--${sizeKey} ${variant}`}
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .smat-logo-wrap {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    background: transparent;
  }
  .smat-brand-img {
    display: block;
    height: 100%;
    width: auto;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .smat-logo-wrap.dark {
    background: transparent;
    padding: 0;
  }
  .smat-logo-wrap.dark .smat-brand-img {
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.45));
  }
</style>
