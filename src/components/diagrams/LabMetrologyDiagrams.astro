---
interface Props {
  diagram: string;
  isEs: boolean;
  xrayWearStyle: string;
  uid: string;
}
const { diagram, isEs, xrayWearStyle, uid } = Astro.props;
---

    {diagram === 'marcy' && (
      <svg viewBox="0 0 680 250" class="cad-svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id={`grid-marcy-${uid}`} width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.6" />
          </pattern>
        </defs>
        <rect width="680" height="250" fill={`url(#grid-marcy-${uid})`} />
        <!-- Argolla superior -->
        <circle cx="240" cy="24" r="10" fill="none" stroke="#0f172a" stroke-width="2.2" />
        <!-- Carátula circular graduada -->
        <circle cx="240" cy="95" r="56" fill="#ffffff" stroke="#0f172a" stroke-width="2.5" />
        <circle cx="240" cy="95" r="44" fill="none" stroke="#0d78c6" stroke-width="1.5" stroke-dasharray="4 3" />
        <circle cx="240" cy="95" r="30" fill="none" stroke="#c25e00" stroke-width="1.5" stroke-dasharray="3 3" />
        <!-- Aguja indicadora -->
        <line x1="240" y1="95" x2="275" y2="68" stroke="#c25e00" stroke-width="2.5" />
        <circle cx="240" cy="95" r="4" fill="#0f172a" />
        <!-- Gancho y Recipiente de 1000 cm3 -->
        <line x1="240" y1="151" x2="240" y2="172" stroke="#0f172a" stroke-width="2" />
        <rect x="208" y="172" width="64" height="58" rx="3" fill="#dbeafe" stroke="#0f172a" stroke-width="2.2" />
        <!-- Orificios laterales de rebose -->
        <circle cx="208" cy="184" r="3" fill="#0d78c6" />
        <circle cx="272" cy="184" r="3" fill="#0d78c6" />
        <!-- Labels -->
        <g font-family="SF Mono, monospace" font-size="10.5" font-weight="700" fill="#0f172a">
          <text x="325" y="65">{isEs ? '1. CARÁTULA DE LECTURA DIRECTA' : '1. DIRECT READING DIAL'}</text>
          <text x="340" y="85" fill="#0d78c6">{isEs ? '• GRAVEDAD ESPECÍFICA DE PULPA (g/cm³)' : '• PULP SPECIFIC GRAVITY (g/cm³)'}</text>
          <text x="340" y="105" fill="#c25e00">{isEs ? '• % DE SÓLIDOS EN PESO (Cw%)' : '• % SOLIDS BY WEIGHT (Cw%)'}</text>
          <text x="325" y="185">{isEs ? '2. VASO CALIBRADO (1000 cm³)' : '2. CALIBRATED CUP (1000 cm³)'}</text>
          <text x="340" y="205" fill="#475569">{isEs ? '• ACERO INOXIDABLE / ACRÍLICO CON REBOSE' : '• STAINLESS STEEL / ACRYLIC WITH OVERFLOW'}</text>
        </g>
        <g data-layer="xray-wear" style={xrayWearStyle}>
          <line x1="200" y1="184" x2="280" y2="184" stroke="#dc2626" stroke-width="2.5" stroke-dasharray="4 2" />
          <text x="325" y="140" font-family="SF Mono, monospace" font-size="9.5" font-weight="800" fill="#dc2626">{isEs ? 'RAYOS X • ENRASE 1000.0 ± 0.5 CM³ Y RESORTE CALIBRADO' : 'X-RAY • 1000.0 ± 0.5 CM³ OVERFLOW WEIR & CALIBRATED SPRING'}</text>
        </g>
      </svg>
    )}

    {diagram === 'batch_filter' && (
      <svg viewBox="0 0 680 260" class="cad-svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id={`grid-batch-${uid}`} width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.6" />
          </pattern>
        </defs>
        <rect width="680" height="260" fill={`url(#grid-batch-${uid})`} />
        <!-- Columnas guía laterales y bastidor de piso/banco -->
        <rect x="135" y="220" width="190" height="16" rx="2" fill="#cbd5e1" stroke="#0f172a" stroke-width="2.2" />
        <line x1="162" y1="38" x2="162" y2="220" stroke="#0f172a" stroke-width="4" />
        <line x1="298" y1="38" x2="298" y2="220" stroke="#0f172a" stroke-width="4" />
        <!-- Travesaño superior y Husillo en T (T-Bar Screw Clamp) -->
        <rect x="150" y="34" width="160" height="14" rx="2" fill="#94a3b8" stroke="#0f172a" stroke-width="2" />
        <line x1="230" y1="16" x2="230" y2="70" stroke="#c25e00" stroke-width="4" />
        <line x1="196" y1="16" x2="264" y2="16" stroke="#c25e00" stroke-width="5" stroke-linecap="round" />
        <!-- Tapa superior bridada con entrada de aire comprimido y manómetro -->
        <rect x="172" y="68" width="116" height="16" rx="2" fill="#dbeafe" stroke="#0d78c6" stroke-width="2" />
        <line x1="272" y1="68" x2="272" y2="52" stroke="#0d78c6" stroke-width="2.2" />
        <circle cx="272" cy="44" r="8" fill="#ffffff" stroke="#0d78c6" stroke-width="2" />
        <!-- Cilindro de acero vertical para pulpa (Cámara de presión 60-100 psi) -->
        <rect x="180" y="84" width="100" height="98" fill="#f1f5f9" stroke="#0f172a" stroke-width="2.4" />
        <!-- Torta mineral y tela/papel filtrante en la base del cilindro -->
        <rect x="182" y="164" width="96" height="14" fill="#fde68a" stroke="#7c2d12" stroke-width="1.5" />
        <line x1="180" y1="180" x2="280" y2="180" stroke="#0d78c6" stroke-width="2.2" stroke-dasharray="4 2" />
        <!-- Plato base colector y descarga a probeta -->
        <rect x="172" y="182" width="116" height="14" rx="2" fill="#cbd5e1" stroke="#0f172a" stroke-width="2" />
        <path d="M 230 196 L 230 214" stroke="#0d78c6" stroke-width="3" />
        <!-- Labels -->
        <g font-family="SF Mono, monospace" font-size="10.5" font-weight="700" fill="#0f172a">
          <text x="338" y="34" fill="#c25e00">{isEs ? '1. HUSILLO DE CIERRE RÁPIDO EN T' : '1. TOP T-BAR SCREW CLAMP'}</text>
          <text x="338" y="65" fill="#0d78c6">{isEs ? '2. ENTRADA NEUMÁTICA (60–100 PSI) Y MANÓMETRO' : '2. COMPRESSED AIR INLET (60–100 PSI) & GAUGE'}</text>
          <text x="338" y="122">{isEs ? '3. CÁMARA CILÍNDRICA DE ACERO PESADO' : '3. HEAVY-DUTY STEEL PRESSURE BARREL'}</text>
          <text x="338" y="172" fill="#7c2d12">{isEs ? '4. PLATO POROSO + PAPEL / TELA FILTRANTE' : '4. DRAINAGE PLATE + FILTER PAPER / CLOTH'}</text>
          <text x="338" y="212" fill="#475569">{isEs ? '5. BASTIDOR CON BARRAS GUÍA Y DRENAJE INFERIOR' : '5. TWIN GUIDE ROD FRAME & FILTRATE PORT'}</text>
        </g>
        <g data-layer="xray-wear" style={xrayWearStyle}>
          <rect x="174" y="82" width="112" height="4" fill="#dc2626" opacity="0.85" />
          <rect x="174" y="180" width="112" height="4" fill="#dc2626" opacity="0.85" />
          <text x="338" y="148" font-family="SF Mono, monospace" font-size="9.5" font-weight="800" fill="#dc2626">{isEs ? 'RAYOS X • SELLO ANULAR O-RING 1.52 MM (100 PSI)' : 'X-RAY • 1.52 MM O-RING SEAL GASKET (100 PSI)'}</text>
        </g>
      </svg>
    )}

    {diagram === 'sieves' && (
      <svg viewBox="0 0 680 260" class="cad-svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id={`grid-sieves-${uid}`} width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.6" />
          </pattern>
        </defs>
        <rect width="680" height="260" fill={`url(#grid-sieves-${uid})`} />
        <!-- Columna apilada de Tamices ASTM E11 / ISO 3310 (8" / 12") -->
        <!-- Tapa superior -->
        <rect x="135" y="24" width="170" height="16" rx="3" fill="#cbd5e1" stroke="#0f172a" stroke-width="2" />
        <!-- Tamiz 1 (Malla Gruesa) -->
        <rect x="140" y="42" width="160" height="34" fill="#fff7ed" stroke="#c25e00" stroke-width="2.2" />
        <line x1="142" y1="70" x2="298" y2="70" stroke="#c25e00" stroke-width="2" stroke-dasharray="8 6" />
        <!-- Tamiz 2 (Malla Intermedia #100 / 150 µm) -->
        <rect x="140" y="78" width="160" height="34" fill="#f8fafc" stroke="#0f172a" stroke-width="2.2" />
        <line x1="142" y1="106" x2="298" y2="106" stroke="#0d78c6" stroke-width="2" stroke-dasharray="5 4" />
        <!-- Tamiz 3 (Malla Control P80 #200 / 75 µm) -->
        <rect x="140" y="114" width="160" height="34" fill="#dbeafe" stroke="#0d78c6" stroke-width="2.4" />
        <line x1="142" y1="142" x2="298" y2="142" stroke="#0d78c6" stroke-width="2" stroke-dasharray="3 2" />
        <!-- Tamiz 4 (Malla Ultra-Fina #400 a #635 / 20 µm) -->
        <rect x="140" y="150" width="160" height="34" fill="#f8fafc" stroke="#0f172a" stroke-width="2.2" />
        <line x1="142" y1="178" x2="298" y2="178" stroke="#475569" stroke-width="1.8" stroke-dasharray="1.5 1.5" />
        <!-- Cazuela colectora inferior (Fondo / Receiver Pan) -->
        <rect x="140" y="186" width="160" height="36" rx="2" fill="#e2e8f0" stroke="#0f172a" stroke-width="2.4" />
        <!-- Labels -->
        <g font-family="SF Mono, monospace" font-size="10.5" font-weight="700" fill="#0f172a">
          <text x="330" y="38">{isEs ? '1. TAPA Y MARCO EMBUTIDO SIN COSTURAS (8" Y 12")' : '1. COVER & SEAMLESS DRAWN FRAME (8" & 12")'}</text>
          <text x="330" y="65" fill="#c25e00">{isEs ? '2. BASTIDOR EN BRONCE O ACERO INOXIDABLE' : '2. BRASS OR STAINLESS STEEL FRAME OPTIONS'}</text>
          <text x="330" y="102">{isEs ? '3. SERIE GEOMÉTRICA ⁴√2 (DESDE 5" HASTA #100)' : '3. ⁴√2 GEOMETRIC SERIES (FROM 5" TO #100 MESH)'}</text>
          <text x="330" y="136" fill="#0d78c6">{isEs ? '4. CORTE P80 DE CONTROL (#200 / 75 MICRONES)' : '4. PRIMARY P80 CONTROL MESH (#200 / 75 MICRONS)'}</text>
          <text x="330" y="170">{isEs ? '5. MALLAS ULTRA-FINAS HASTA #635 (20 MICRONES)' : '5. ULTRA-FINE MESHES DOWN TO #635 (20 MICRONS)'}</text>
          <text x="330" y="206" fill="#475569">{isEs ? '6. CAZUELA COLECTORA + TAMIZADOR MECÁNICO' : '6. RECEIVER PAN + MECHANICAL SIEVE SHAKER'}</text>
        </g>
        <g data-layer="xray-wear" style={xrayWearStyle}>
          <rect x="138" y="114" width="164" height="34" fill="none" stroke="#dc2626" stroke-width="3" />
          <text x="330" y="236" font-family="SF Mono, monospace" font-size="9.5" font-weight="800" fill="#dc2626">{isEs ? 'RAYOS X • TENSIÓN ÓPTICA ASTM E11 (#200 = 75 µM)' : 'X-RAY • ASTM E11 OPTICAL TENSION (#200 = 75 µM)'}</text>
        </g>
      </svg>
    )}

    {diagram === 'lab_comminution_pan' && (
      <svg viewBox="0 0 680 240" class="cad-svg" xmlns="http://www.w3.org/2000/svg">
        <rect width="680" height="240" fill="#f8fafc" />
        <!-- Disco de pulverizador Cr27 -->
        <circle cx="108" cy="120" r="64" fill="#f1f5f9" stroke="#0f172a" stroke-width="2.2" />
        <g data-layer="xray-wear" style={xrayWearStyle}>
          <circle cx="108" cy="120" r="64" fill="#fee2e2" stroke="#dc2626" stroke-width="2.4" />
        </g>
        <circle cx="108" cy="120" r="18" fill="#f8fafc" stroke="#0f172a" stroke-width="2" />
        <!-- Batea de tentadura con 3 riflas -->
        <polygon points="184,74 264,74 244,168 204,168" fill="#e0f2fe" stroke="#0284c7" stroke-width="2.2" />
        <line x1="194" y1="98" x2="254" y2="98" stroke="#92400e" stroke-width="2.4" />
        <line x1="198" y1="122" x2="250" y2="122" stroke="#92400e" stroke-width="2.4" />
        <g font-family="SF Mono, monospace" font-size="10" font-weight="700" fill="#0f172a">
          <text x="286" y="56" fill="#dc2626">{isEs ? '1. DISCOS DE MOLIENDA Ø 8" EN ALTO CROMO A05 (>= 620 HB)' : '1. Ø 8" HIGH-CHROME A05 GRINDING DISCS (>= 620 HB)'}</text>
          <text x="286" y="76" font-size="9" fill="#475569">{isEs ? '• Claro entre discos: 0.76 mm (1 tarjeta ISO/IEC 7810) para malla #200' : '• Disc gap: 0.76 mm (1 ISO/IEC 7810 card) for #200 mesh assay'}</text>
          <text x="286" y="116" fill="#7c2d12">{isEs ? '2. PLATO DE TENTADURA Ø 14" CON 3 RIFLAS CONCENTRADORAS' : '2. Ø 14" METALLURGICAL PAN WITH 3 CONCENTRATING RIFFLES'}</text>
          <text x="286" y="136" font-size="9" fill="#475569">{isEs ? '• Control visual inmediato de sulfuros y oro libre en banco de celdas' : '• Instant visual check of sulfides and free gold at flotation bank'}</text>
        </g>
      </svg>
    )}

