---
import companyData from '../../data/company.json';
import { calculateSlurryMetrics } from '../scripts/slurryEngine.js';
import { formatNioshErgonomicStatus } from '../scripts/workbenchBus.js';

interface Props {
  lang?: 'es' | 'en';
  defaultKinematics: any;
  defaultPartSpecs: any;
  activeCircuit?: string;
}

const {
  lang = 'es',
  defaultKinematics,
  defaultPartSpecs,
  activeCircuit = 'bombeo',
} = Astro.props;
const isEs = lang === 'es';
const showPumpTable = activeCircuit === 'bombeo' || !activeCircuit;
const defaultNioshEval = formatNioshErgonomicStatus(defaultPartSpecs, isEs ? 'es' : 'en');
const defaultSlurryEval = calculateSlurryMetrics({
  flowM3H: 180,
  solidsWeightPercent: 45,
  particleSizeD80Microns: 180,
  solidsSpecificGravity: 2.7,
  pipeSeries: '6x4',
  altitudeM: 2200,
  pH: 7.0,
});
const advancePaymentPct = 50;
const inspectionProtocolText = isEs
  ? (companyData.logistics?.client_inspection_protocol || 'Cotejo dimensional 1:1 previo al embarque.')
  : (companyData.logistics?.client_inspection_protocol_en || 'On-site 1:1 dimensional verification prior to dispatch.');
---

<!-- PANEL DERECHO: Live Engineering Dossier A4 (Parnas Slice MS-05) -->
<div class="workbench-preview-panel" id="live-engineering-dossier-wrapper">
  <div class="dossier-role-banner">{isEs ? '2. DOCUMENTO OFICIAL SMAT • EMISIÓN EN TIEMPO REAL (A4)' : '2. OFFICIAL SMAT SPECIFICATION • REAL-TIME EMISSION (A4)'}</div>
  <div class="dossier-card" id="main-dossier-card">
    
    <!-- Selector de Pestañas Dual (Decisión 8-A: Mantenimiento vs Compras/SAP) -->
    <div class="dossier-tab-switcher" role="tablist">
      <button type="button" class="dossier-tab-btn active" id="tab-btn-maint" role="tab" aria-selected="true">
        <span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="dossier-inline-svg"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          {isEs ? 'Vista Mantenimiento' : 'Maintenance View'}
        </span>
      </button>
      <button type="button" class="dossier-tab-btn" id="tab-btn-sap" role="tab" aria-selected="false">
        <span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="dossier-inline-svg"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
          {isEs ? 'Vista Compras / SAP' : 'Purchasing / SAP View'}
        </span>
      </button>
    </div>

    <!-- Membrete de la Ficha Técnica -->
    <div class="dossier-header">
      <div class="dossier-brand">
        <span class="brand-title">SMAT MINERALS</span>
        <span class="brand-sub">{isEs ? 'EQUIPOS DE PROCESO Y REFACCIONAMIENTO MINERO' : 'MINERAL PROCESSING EQUIPMENT & CRITICAL SPARES'}</span>
        <span class="brand-address">{isEs ? 'Domicilio Fiscal: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166 • Almacén Central Durango' : 'Fiscal HQ: Mariano Salas #114, Durango, Mexico ZIP 34166 • Central Warehouse Durango'}</span>
      </div>
      <div class="dossier-folio-wrap">
        <span class="folio-label">{isEs ? 'FOLIO INSTITUCIONAL' : 'OFFICIAL FOLIO'}</span>
        <strong class="folio-code" id="live-folio">{isEs ? 'BORRADOR (SIN FOLIO)' : 'DRAFT (UNASSIGNED)'}</strong>
        <span class="smat-part-code-tag" id="live-smat-code">SMAT-PUMP-6X4-WETKIT</span>
        <span class="dossier-date" id="live-date">{new Date().toISOString().slice(0, 10)}</span>
      </div>
    </div>

    <div class="dossier-divider"></div>

    <!-- Estatus de Prioridad y Horario -->
    <div class="dossier-sla-bar" id="dossier-sla-bar">
      <span class="sla-badge" id="live-priority-tag">{isEs ? 'Borrador sin partidas (P0)' : 'Draft — No Active Items (P0)'}</span>
      <span class="sla-badge" id="live-budget-category-pill">{isEs ? 'Presupuesto: Refacciones y Desgaste' : 'Budget: Operating Wear Spares'}</span>
      <span class="sla-badge dossier-gate-pill" id="gate-lead-status" data-testid="gate-lead-status">{isEs ? 'BORRADOR EN CAPTURA' : 'DRAFT IN PROGRESS'}</span>
      <span class="sla-clock" data-emergency-hotline={String(companyData.contact.whatsapp.emergency_hotline)}>Durango: {companyData.contact.phones[0].display} • WhatsApp: {companyData.contact.whatsapp.display} • {isEs ? companyData.logistics.warehouse_hours : companyData.logistics.warehouse_hours_en}</span>
    </div>
    <div>
      <div id="trust-boundary-alert" data-testid="trust-boundary-alert" class="hidden dossier-trust-alert">
        <strong id="trust-boundary-title">{isEs ? 'Límite Técnico Detectado' : 'Technical Boundary Alert'}</strong>
        <p id="trust-boundary-reason" class="dossier-trust-reason"></p>
        <ul id="trust-boundary-warnings" class="dossier-trust-warnings hidden"></ul>
      </div>
    </div>

    <!-- PANE 1: VISTA MANTENIMIENTO -->
    <div class="dossier-pane active-pane" id="pane-maint">
      <div class="dossier-section">
        <span class="dossier-section-title">{isEs ? '1. LUGAR DE ENTREGA O RETIRO EN DURANGO' : '1. DELIVERY LOCATION & DURANGO DISPATCH'}</span>
        <dl class="spec-grid">
          <div class="spec-pair">
            <dt class="spec-label">{isEs ? 'Solicitante' : 'Requester'}</dt>
            <dd class="spec-value" id="live-requester">{isEs ? 'Pendiente de captura' : 'Pending entry'}</dd>
          </div>
          <div class="spec-pair">
            <dt class="spec-label">{isEs ? 'Mina / Corporativo' : 'Mine / Company'}</dt>
            <dd class="spec-value" id="live-company">{isEs ? 'Pendiente de captura' : 'Pending entry'}</dd>
          </div>
          <div class="spec-pair">
            <dt class="spec-label">{isEs ? 'Contacto Directo' : 'Direct Contact'}</dt>
            <dd class="spec-value" id="live-contact">{isEs ? 'Pendiente de captura' : 'Pending entry'}</dd>
          </div>
          <div class="spec-pair">
            <dt class="spec-label">{isEs ? 'Punto de Despacho' : 'Dispatch Point'}</dt>
            <dd class="spec-value" id="live-destination">{isEs ? 'Retiro en Almacén Central Durango' : 'Durango Central Warehouse Pickup'}</dd>
          </div>
        </dl>
      </div>

      <!-- Especificación Técnica y Partida -->
      <div class="dossier-section">
        <span class="dossier-section-title">{isEs ? '2. ESPECIFICACIÓN TÉCNICA DE INGENIERÍA' : '2. ENGINEERING SPECIFICATION'}</span>
        <div class="dossier-part-box">
          <div class="part-header-row">
            <strong class="part-name" id="live-part-name">{isEs ? 'Kit Extremo Húmedo Completo' : 'Complete Wet-End Kit'}</strong>
            <span class="part-fit-badge" id="dossier-part-hardness" data-testid="dossier-part-hardness">{defaultPartSpecs.hardness || (lang === 'en' ? 'Pending part selection (Draft)' : 'Por especificar (Borrador)')}</span>
          </div>
          <p class="part-details-text" id="live-part-details">
            {isEs ? 'Verificación dimensional de acople 1:1 en Almacén Central Durango.' : '1:1 dimensional check at Durango Central Warehouse.'}
          </p>
          <p class="part-details-text dossier-fit-guarantee" id="dossier-part-fit-guarantee" data-testid="dossier-part-fit-guarantee">
            {isEs ? (defaultPartSpecs.fit_guarantee_es || 'Cotejo dimensional 1:1 en Almacén Central Durango.') : (defaultPartSpecs.fit_guarantee_en || '1:1 dimensional verification at Durango Central Warehouse.')}
          </p>
          <div id="live-client-ref-box" class="live-client-ref-box hidden">
            <span class="ref-label">{isEs ? 'Referencia Confidencial Cliente:' : 'Client Confidential Ref:'}</span>
            <strong id="live-client-ref-text"></strong>
          </div>
          <div id="live-custom-box" class="live-client-ref-box hidden dossier-tight-top">
            <span class="ref-label">{isEs ? 'Equipo Especial Fuera de Catálogo:' : 'Custom Engineered Equipment:'}</span>
            <strong id="live-custom-text"></strong>
          </div>
          <div id="live-pipe-meta-box" class="live-pipe-meta-box">
            <span class="spec-label" id="live-pipe-header">{isEs ? 'Línea de Tubería / Capacidad:' : 'Process Line / Capacity:'}</span>
            <strong id="live-pipe-text" class="font-mono-tech">{isEs ? 'Tubería 6" a 4" (Línea Principal de Proceso)' : '6" to 4" Piping (Main Process Slurry)'}</strong>
            <span class="spec-label dossier-meta-gap" id="live-stress-header">{isEs ? 'Condición de Operación en Planta:' : 'Plant Operating Condition:'}</span>
            <strong id="live-stress-text" class="font-mono-tech">{isEs ? 'Pendiente de dictamen en campo (Asesoría SMAT solicitada)' : 'Pending field assessment (SMAT technical advice requested)'}</strong>
            <span class="spec-label dossier-meta-gap" id="live-criteria-header">{isEs ? 'Criterios de Aceptación Operativa (Rol):' : 'Role Acceptance Criteria:'}</span>
            <strong id="live-role-criteria" data-testid="live-role-criteria" class="font-mono-tech">{isEs ? 'Intercambiabilidad dimensional 1:1 • Dureza >600 HB • Disponibilidad en Almacén Durango' : '1:1 dimensional fit • Hardness >600 HB • Durango Warehouse availability'}</strong>
            <div class="font-mono-tech dossier-inline-spec-strip">
              <span data-wb-field="actualPipeVelocityMs">3.15 m/s</span> •{' '}
              <span data-wb-field="slurrySpecificGravity">1.40 kg/L</span> •{' '}
              <span data-wb-field="sealBranch">{isEs ? 'Expulsor Seco (Est. 02A)' : 'Dry Expeller (St. 02A)'}</span> •{' '}
              b₂ <span data-wb-field="impellerExitWidthMm">48 mm</span> • C <span data-wb-field="dynamicCapacityCkN">145 kN</span> •{' '}
              <span id="dossier-metric-sobol-driver">{isEs ? 'Factor clave: Caudal Q' : 'Primary factor: Flow Q'}</span>
            </div>
          </div>
          <div id="live-recirc-warning-dossier" class="live-recirc-warning-dossier hidden">
            <span class="recirc-warn-tag">{isEs ? 'AVISO DE RECIRCULACIÓN' : 'RECIRCULATION NOTICE'}</span>
            <p class="recirc-warn-text">
              {isEs 
                ? 'Reemplazo de pieza individual. Se aconseja cotejar holgura axial en voluta para mitigar recirculación prematura.' 
                : 'Single part replacement. Axial clearance verification inside volute recommended to mitigate recirculation.'}
            </p>
          </div>
          <div class="dossier-backend-telemetry font-mono-tech" id="dossier-backend-telemetry">
            <div><strong>{isEs ? 'Motivo Metalúrgico:' : 'Alloy Rationale:'}</strong> <span id="live-material-reason">{isEs ? defaultSlurryEval.materialReasonEs : defaultSlurryEval.materialReasonEn}</span></div>
            <div><strong>{isEs ? 'Bastidor y Rodamiento:' : 'Bearing Frame:'}</strong> <span id="live-bearing-frame-label">{isEs ? defaultKinematics.bearingFrameLabelEs : defaultKinematics.bearingFrameLabelEn}</span></div>
            <div><strong>{isEs ? 'Riesgo de Colisión Axial:' : 'Axial Collision Check:'}</strong> <span id="live-collision-risk">{isEs ? 'Sin colisión axial S1→S5 dentro de tolerancia.' : 'No axial interference S1→S5 within tolerance.'}</span></div>
            <div><strong>{isEs ? 'Recomendación Operativa:' : 'Engineering Recommendation:'}</strong> <span id="live-recommendation">{defaultSlurryEval.results?.flowConditionText || (isEs ? 'Operación segura dentro de rango de flujo.' : 'Safe operation within flow envelope.')}</span></div>
            <div><strong>{isEs ? 'Anticipo Fabricación:' : 'Build Advance Terms:'}</strong> <span id="live-advance-payment-pct">{advancePaymentPct}%</span> • <strong>{isEs ? 'Protocolo Presencial:' : 'Site Witness Protocol:'}</strong> <span id="live-inspection-protocol">{inspectionProtocolText}</span></div>
          </div>
        </div>
      </div>

      <!-- Memoria de Cálculo Hidráulico Durand (contextual por circuito) -->
      <div class={showPumpTable ? 'dossier-section' : 'dossier-section hidden'} id="live-section-pump-hydraulics">
        <span class="dossier-section-title">{isEs ? '3. CÁLCULO DE FLUJO PARA PREVENIR EMBANCAMIENTO (DURAND-CONDOLIOS)' : '3. SLURRY TRANSPORT AUDIT (DURAND-CONDOLIOS)'}</span>
        <table class="dossier-table">
          <tbody>
            <tr>
              <td><strong>{isEs ? 'Caudal y % Sólidos:' : 'Flow & Solids:'}</strong></td>
              <td id="live-table-flow">{isEs ? '180 m³/h @ 45% Sólidos (Cp)' : '180 m³/h @ 45% Solids (Cp)'}</td>
            </tr>
            <tr>
              <td><strong>{isEs ? 'Granulometría (d80):' : 'Particle Size (d80):'}</strong></td>
              <td id="live-table-d80">{isEs ? 'd80 = 180 µm (Cuarzo / Abrasivo Grueso)' : 'd80 = 180 µm (Quartz / Coarse Abrasive)'}</td>
            </tr>
            <tr>
              <td><strong>{isEs ? 'Velocidad Crítica Durand (Vc):' : 'Durand Critical Velocity (Vc):'}</strong></td>
              <td id="live-table-vc" class="highlight-cell">{isEs ? '2.42 m/s (Margen seguro: 3.02 m/s)' : '2.42 m/s (Safe margin: 3.02 m/s)'}</td>
            </tr>
            <tr>
              <td><strong>{isEs ? 'Abatimiento (HR / ηr) y Vida:' : 'Derating (HR / ηr) & Wear Life:'}</strong></td>
              <td id="live-table-derating-wear">
                HR = <strong id="metric-hr" data-testid="metric-hr">0.880</strong> | ηr = <strong id="metric-er" data-testid="metric-er">0.857</strong> | {isEs ? 'Vida Est.:' : 'Est. Life:'} <strong id="metric-wear-hours" data-testid="metric-wear-hours">2,400 h (3.8x vs FG)</strong>
              </td>
            </tr>
            <tr>
              <td><strong>{isEs ? 'Altitud y Pinza Térmica IEC:' : 'Altitude & IEC Thermal Pincer:'}</strong></td>
              <td id="live-table-altitude">
                Patm = <strong id="metric-patm-mca" data-testid="metric-patm-mca">7.89 mca</strong> (<span id="dossier-metric-delta-npsh" data-testid="dossier-metric-delta-npsh">-2.44 m NPSHa</span>) | IEC = <strong id="metric-motor-iec" data-testid="metric-motor-iec">0.880</strong> | K_motor,alt = <strong id="metric-k-motor-alt" data-testid="metric-k-motor-alt">1.326x</strong>
              </td>
            </tr>
            <tr>
              <td><strong>{isEs ? 'Metalurgia Dictaminada:' : 'Dictated Metallurgy:'}</strong></td>
              <td id="live-table-mat" class="highlight-cell">{isEs ? 'Dictamen técnico según severidad de pulpa (Durango)' : 'Technical metallurgy dictated per slurry severity (Durango)'}</td>
            </tr>
            <tr>
              <td><strong>{isEs ? 'Claro Axial y Cinemática:' : 'Axial Clearance & Kinematics:'}</strong></td>
              <td id="live-table-kinematics">δ = 0.75 mm (Δη_v = -1.6%, ΔV_pipe = -<span id="wb-pipe-vel-loss" data-testid="wb-pipe-vel-loss">1.2%</span>) | {isEs ? 'Arreglo CV' : 'CV Arrangement'} | u₂ = {defaultKinematics.tipSpeedMs} m/s | L₁₀ₕ = {defaultKinematics.bearingL10Hours.toLocaleString()} h | <span id="live-assembly-collision-note" data-testid="live-assembly-collision-note">{isEs ? 'Secuencia S1→S5 libre de colisión axial' : 'S1→S5 sequence collision-free'}</span></td>
            </tr>
            <tr>
              <td><strong>{isEs ? 'Ficha Física / NIOSH:' : 'Physical Spec / NIOSH:'}</strong></td>
              <td id="live-table-part-specs">{defaultPartSpecs.station_number} ({defaultPartSpecs.code}) | {defaultPartSpecs.weight_kg} kg ({isEs ? defaultNioshEval.badgeEs : defaultNioshEval.badgeEn}) | ØD₂ {defaultPartSpecs.impeller_diameter_mm} mm</td>
            </tr>
            <tr id="live-row-metrology" class="hidden">
              <td><strong>{isEs ? 'Cédula Metrológica Lab:' : 'Lab Metrology Spec:'}</strong></td>
              <td id="live-table-metrology">—</td>
            </tr>
            <tr id="live-row-circuit-physics" data-testid="live-row-circuit-physics">
              <td><strong id="live-table-circuit-physics-label">{isEs ? 'Telemetría de Circuito y Reorden:' : 'Circuit Telemetry & Reorder:'}</strong></td>
              <td id="live-table-circuit-physics-val">{isEs ? 'Ciclo preventivo sugerido: 90 días • Despacho Programado Durango' : 'Suggested preventive cycle: 90 days • Durango Scheduled Dispatch'}</td>
            </tr>
            <tr id="live-row-sobol-drivers" data-testid="live-row-sobol-drivers" data-sobol-model="S1">
              <td><strong>{isEs ? 'Factor Principal y Límite Físico:' : 'Primary Driver & Physical Bounds:'}</strong></td>
              <td id="live-table-sobol-drivers" class="font-mono-tech">{isEs ? 'Caudal dominante • Parámetros en rango físico' : 'Flow dominant • Parameters within physical bounds'}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Sello Metrológico de Almacén Durango y Domicilio Fiscal -->
      <div class="dossier-section">
        <span class="dossier-section-title">{isEs ? '4. INSPECCIÓN Y PROTOCOLO DE ALMACÉN CENTRAL' : '4. CENTRAL WAREHOUSE INSPECTION & PROTOCOL'}</span>
        <div class="durango-seal-box" id="durango-seal-box">
          <div class="seal-badge-header">
            <span class="seal-icon"><svg class="smat-inline-svg-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></span>
            <span class="seal-title">{isEs ? 'VERIFICACIÓN METROLÓGICA EN ALMACÉN CENTRAL DURANGO' : 'DURANGO CENTRAL WAREHOUSE METROLOGICAL VERIFICATION'}</span>
          </div>
          <div class="seal-specs-grid">
            <span class="seal-spec-item font-mono-tech">{isEs ? 'Cotejo Durango: Triplete (A, B, C) ISO 2768-m • Acople Brida 1:1' : 'Durango Check: (A, B, C) Triplet ISO 2768-m • 1:1 Flange Coupling'}</span>
            <span class="seal-spec-item font-mono-tech">{isEs ? 'Origen Fundición: ISO 1940 Grado G2.5 (<0.05 mm)' : 'Foundry Origin: ISO 1940 Grade G2.5 (<0.05 mm)'}</span>
            <span class="seal-spec-item font-mono-tech">{isEs ? 'Dureza Metalúrgica Certificada (ASTM A532 ≥650 HB)' : 'Certified Metallurgy Hardness (ASTM A532 ≥650 HB)'}</span>
          </div>
          <p class="seal-address-note" id="live-clause-text">
            {isEs 
              ? `Garantía de acople dimensional 1:1 en Almacén Central Durango SMAT (verificación física de Triplete Geométrico A, B, C bajo ISO 2768-m). Domicilio fiscal y patio de maniobras: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166.` 
              : `SMAT 1:1 dimensional fit warranty (physical verification of A, B, C Geometric Triplet under ISO 2768-m). Fiscal HQ & staging yard: Mariano Salas #114, Col. Primer Presidente, Durango, Mexico ZIP 34166.`}
          </p>
          <small class="dossier-maneuvers-access-note">
            {isEs ? companyData.logistics.maneuvers_access : companyData.logistics.maneuvers_access_en}
          </small>
        </div>
      </div>

      <!-- Micro-Anclaje Fiduciario TCO vs Paro de Planta -->
      <div class="tco-downtime-anchor-card">
        <div class="tco-anchor-header">
          <span class="anchor-badge font-mono-tech">{isEs ? '[TCO / PARO PROTEGIDO]' : '[TCO / PROTECTED UPTIME]'}</span>
          <span class="anchor-stat font-mono-tech">{isEs ? '40,000 USD/hora' : '40,000 USD/hour'}</span>
        </div>
        <p class="anchor-desc">
          {isEs 
            ? 'Inversión en Kit de Paro Integral para prevenir detenciones no programadas en planta concentradora (Referencia industrial: 40,000 USD/hora en producción diferida). Renovación total de holguras hidráulicas en una sola intervención de mantenimiento.' 
            : 'Complete Spare Kit investment to prevent unscheduled concentrator shutdowns (Industry benchmark: 40,000 USD/hour in deferred production). Full hydraulic clearance renewal in a single maintenance window.'}
        </p>
      </div>
    </div>

    <!-- PANE 2: VISTA COMPRAS / SAP -->
    <div class="dossier-subdivider"><span class="subdivider-tag font-mono-tech">{isEs ? "PARTIDA ERP & DATOS FISCALES" : "ERP LINE ITEM & FISCAL DATA"}</span></div>
    <div class="dossier-pane hidden-pane" id="pane-sap">
      <div class="dossier-section">
        <span class="dossier-section-title">{isEs ? '1. ESTRUCTURA DE PARTIDAS NORMALIZADA (SAP / ERP)' : '1. NORMALIZED REQUISITION ITEMS (SAP / ERP)'}</span>
        <div class="sap-table-wrap">
          <table class="dossier-table sap-item-table">
            <thead>
              <tr>
                <th>{isEs ? 'Pos.' : 'Item'}</th>
                <th>{isEs ? 'Partida / Código SMAT' : 'Line Item / SMAT Code'}</th>
                <th>{isEs ? 'Material / Norma' : 'Material / Spec'}</th>
                <th>{isEs ? 'Destino' : 'Destination'}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>010</strong></td>
                <td>
                  <span id="sap-live-part">{isEs ? 'Kit Extremo Húmedo Completo' : 'Complete Wet-End Kit'}</span>
                  <small class="sap-code-badge" id="sap-live-code">SMAT-PUMP-6X4-WETKIT</small>
                  <div class="sap-tag-line font-mono-tech dossier-sap-tag-line">
                    TAG: <strong id="sap-live-tag">CIRCUIT-BOMBEO</strong> • SAT: 8413.91.01 • {isEs ? 'Despacho: Almacén Central Durango' : 'Dispatch: Durango Central Hub'}
                  </div>
                </td>
                <td id="sap-live-mat">{isEs ? 'Dictamen según severidad de pulpa (Durango)' : 'Metallurgy dictated by slurry severity (Durango)'}</td>
                <td id="sap-live-dest">{isEs ? 'Almacén Central Durango' : 'Durango Central Warehouse'}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="dossier-section">
