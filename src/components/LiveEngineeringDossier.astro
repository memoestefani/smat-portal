          <span>{isEs ? 'Requisición PDF' : 'PDF Requisition'}</span>
        </button>

        <button type="button" class="btn-pill-action btn-pill-tsv" id="wb-copy-tsv-btn">
          <span class="pill-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
          </span>
          <span>{isEs ? 'Tabla TSV (SAP)' : 'TSV Table (SAP)'}</span>
        </button>

        <button type="button" class="btn-pill-action btn-pill-cotejo" id="wb-cotejo-btn" title={isEs ? 'Descargar Ficha de Cotejo Dimensional ANSI 1:1' : 'Download 1:1 ANSI Dimensional Verification Sheet'}>
          <span class="pill-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0l12.6 12.6z"/><line x1="14.5" y1="5.5" x2="18.5" y2="9.5"/><line x1="8.5" y1="11.5" x2="11.5" y2="14.5"/></svg>
