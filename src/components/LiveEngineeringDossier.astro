          <span>{isEs ? 'Cotejo ANSI 1:1' : 'ANSI 1:1 Fit'}</span>
        </button>

        <button type="button" class="btn-pill-action" id="wb-email-btn" data-testid="btn-quote-mailto">
          <span class="pill-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <span>{isEs ? 'Enviar Correo' : 'Send Email'}</span>
        </button>
      </div>

      <div id="wb-toast" class="wb-toast hidden" role="status" aria-live="polite">
        {isEs ? 'Partidas y folio copiados. Listo para pegar en SAP, Excel o correo.' : 'Spec & folio copied! Ready to paste into SAP, Excel or email.'}
      </div>

      <div class="privacy-pledge-footer">
        <small>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          {isEs ? 'Trato Directo: Sus datos se utilizan exclusivamente para emitir su cotización formal. Cero llamadas comerciales.' : 'Direct Contact Guarantee: Your information is used strictly for your official quote. Zero sales calls.'}
        </small>
      </div>
    </div>

  </div>
</div>

