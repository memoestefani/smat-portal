---
import companyData from '../../data/company.json';

interface Props {
  lang?: 'es' | 'en';
  defaultKinematics?: any;
  defaultPartSpecs?: any;
  activeCircuit?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const advancePaymentPct = 50;
const inspectionProtocolText = isEs
  ? (companyData.logistics?.client_inspection_protocol || 'Cotejo dimensional 1:1 previo al embarque.')
  : (companyData.logistics?.client_inspection_protocol_en || 'On-site 1:1 dimensional verification prior to dispatch.');
---

<!-- PANEL DERECHO: Live Engineering Dossier A4 (`SLICE-V90-A13`, bajo demanda cuando hay partidas) -->
<div class="workbench-preview-panel" id="live-engineering-dossier" data-dossier-mode="empty">
  <div class="dossier-role-banner">{isEs ? '2. RESUMEN DE REQUISICIÓN Y FOLIO SMAT (A4)' : '2. REQUISITION SUMMARY & SMAT FOLIO (A4)'}</div>
  <div class="dossier-card" id="main-dossier-card">
    <div class="dossier-tab-switcher hidden" data-dossier-tabs-bar="1" role="tablist">
      <button type="button" class="dossier-tab-btn active" id="tab-btn-maint" role="tab" aria-selected="true">
        <span>{isEs ? 'Vista Mantenimiento' : 'Maintenance View'}</span>
      </button>
      <button type="button" class="dossier-tab-btn" id="tab-btn-sap" role="tab" aria-selected="false">
        <span>{isEs ? 'Vista Compras / SAP' : 'Purchasing / SAP View'}</span>
      </button>
    </div>

    <!-- Guía limpia sin botones redundantes cuando la cotización está vacía -->
    <div class="dossier-section" data-dossier-empty-guide>
      <span class="dossier-section-title">{isEs ? 'GUÍA RÁPIDA EN 3 PASOS' : '3-STEP QUICK START GUIDE'}</span>
      <p class="part-details-text">
        {isEs
          ? '1) Agregue partidas o importe Excel/SAP · 2) Capture solicitante y mina · 3) Envíe a Durango y exporte folio A4 / TSV.'
          : '1) Add items or import Excel/SAP · 2) Enter requester & mine site · 3) Dispatch to Durango and export A4 / TSV.'}
      </p>
    </div>

    <div data-dossier-on-demand-body class="hidden">

    <div class="dossier-header">
      <div class="dossier-brand">
        <span class="brand-title">SMAT MINERALS</span>
        <span class="brand-sub">{isEs ? 'EQUIPOS DE PROCESO Y REFACCIONAMIENTO MINERO' : 'MINERAL PROCESSING EQUIPMENT & CRITICAL SPARES'}</span>
        <span class="brand-address">{isEs ? 'Domicilio Fiscal: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166 • Almacén Central Durango' : 'Fiscal HQ: Mariano Salas #114, Durango, Mexico ZIP 34166 • Central Warehouse Durango'}</span>
      </div>
      <div class="dossier-folio-wrap">
        <span class="folio-label">{isEs ? 'FOLIO INSTITUCIONAL' : 'OFFICIAL FOLIO'}</span>
        <strong class="folio-code" id="live-folio">{isEs ? 'Pendiente de envío' : 'Pending submission'}</strong>
        <span class="smat-part-code-tag" id="live-smat-code">{isEs ? 'SMAT-BORRADOR' : 'SMAT-DRAFT'}</span>
        <span class="dossier-date" id="live-date">{new Date().toISOString().slice(0, 10)}</span>
      </div>
    </div>

    <div class="dossier-divider"></div>

    <div class="dossier-sla-bar" id="dossier-sla-bar">
      <span class="sla-badge" id="live-priority-tag">{isEs ? 'Borrador sin partidas' : 'Draft — Empty Quote'}</span>
      <span class="sla-badge" id="live-budget-category-pill">{isEs ? 'Carril: Por asignar' : 'Lane: Pending items'}</span>
      <span class="sla-badge dossier-gate-pill" id="gate-lead-status" data-testid="gate-lead-status">{isEs ? 'Borrador en captura' : 'Draft in progress'}</span>
      <span class="sla-clock" data-emergency-hotline={String(companyData.contact.whatsapp.emergency_hotline)}>Durango: {companyData.contact.phones[0].display} • WhatsApp: {companyData.contact.whatsapp.display} • {isEs ? companyData.logistics.warehouse_hours : companyData.logistics.warehouse_hours_en}</span>
    </div>
    <div>
      <div id="trust-boundary-alert" data-testid="trust-boundary-alert" class="hidden dossier-trust-alert">
        <strong id="trust-boundary-title">{isEs ? 'Límite Técnico Detectado' : 'Technical Boundary Alert'}</strong>
        <p id="trust-boundary-reason" class="dossier-trust-reason"></p>
        <ul id="trust-boundary-warnings" class="dossier-trust-warnings hidden"></ul>
      </div>
    </div>

    <div class="dossier-pane active-pane" id="pane-maint">
      <div class="dossier-section">
        <span class="dossier-section-title">{isEs ? '1. LUGAR DE ENTREGA O RETIRO EN DURANGO' : '1. DELIVERY LOCATION & DURANGO DISPATCH'}</span>
        <dl class="spec-grid">
          <div class="spec-pair"><dt class="spec-label">{isEs ? 'Solicitante' : 'Requester'}</dt><dd class="spec-value" id="live-requester">{isEs ? 'Pendiente de captura' : 'Pending entry'}</dd></div>
          <div class="spec-pair"><dt class="spec-label">{isEs ? 'Mina / Corporativo' : 'Mine / Company'}</dt><dd class="spec-value" id="live-company">{isEs ? 'Pendiente de captura' : 'Pending entry'}</dd></div>
          <div class="spec-pair"><dt class="spec-label">{isEs ? 'Contacto Directo' : 'Direct Contact'}</dt><dd class="spec-value" id="live-contact">{isEs ? 'Pendiente de captura' : 'Pending entry'}</dd></div>
          <div class="spec-pair"><dt class="spec-label">{isEs ? 'Punto de Despacho' : 'Dispatch Point'}</dt><dd class="spec-value" id="live-destination">{isEs ? 'Retiro en Almacén Central Durango' : 'Durango Central Warehouse Pickup'}</dd></div>
        </dl>
      </div>

      <div class="dossier-section">
        <span class="dossier-section-title">{isEs ? '2. ESPECIFICACIÓN TÉCNICA DE PARTIDAS' : '2. ENGINEERING SPECIFICATION'}</span>
        <div class="dossier-part-box">
          <div class="part-header-row">
            <strong class="part-name" id="live-part-name">{isEs ? 'Sin partidas agregadas todavía' : 'No line items added yet'}</strong>
            <span class="part-fit-badge" id="dossier-part-hardness" data-testid="dossier-part-hardness">{isEs ? 'Por asignar según selección' : 'Assigned upon SKU selection'}</span>
          </div>
          <p class="part-details-text" id="live-part-details">{isEs ? 'Verificación dimensional 1:1 en Almacén Central Durango.' : '1:1 dimensional verification at Durango Central Warehouse.'}</p>
          <p class="part-details-text dossier-fit-guarantee" id="dossier-part-fit-guarantee" data-testid="dossier-part-fit-guarantee">{isEs ? 'Cotejo dimensional 1:1 previo al embarque.' : 'Pre-dispatch 1:1 dimensional fit check.'}</p>
          <div id="live-client-ref-box" class="live-client-ref-box hidden"><span class="ref-label">{isEs ? 'Referencia Cliente:' : 'Client Ref:'}</span> <strong id="live-client-ref-text"></strong></div>
          <div id="live-custom-box" class="live-client-ref-box hidden dossier-tight-top"><span class="ref-label">{isEs ? 'Equipo Especial:' : 'Custom Item:'}</span> <strong id="live-custom-text"></strong></div>
          <div id="live-pipe-meta-box" class="live-pipe-meta-box">
            <span class="spec-label" id="live-pipe-header">{isEs ? 'Alcance Técnico:' : 'Technical Scope:'}</span>
            <strong id="live-pipe-text" class="font-mono-tech">{isEs ? 'En espera de partidas o archivo SAP/Excel' : 'Awaiting line items or SAP/Excel list'}</strong>
            <span class="spec-label dossier-meta-gap" id="live-stress-header">{isEs ? 'Condición de Operación:' : 'Plant Condition:'}</span>
            <strong id="live-stress-text" class="font-mono-tech">{isEs ? 'Pendiente de captura de partidas' : 'Pending line item capture'}</strong>
            <span class="spec-label dossier-meta-gap" id="live-criteria-header">{isEs ? 'Criterios Operativos:' : 'Acceptance Criteria:'}</span>
            <strong id="live-role-criteria" data-testid="live-role-criteria" class="font-mono-tech">{isEs ? 'Compatibilidad 1:1 • Almacén Central Durango' : '1:1 drop-in fit • Durango Central Warehouse'}</strong>
            <div class="font-mono-tech dossier-inline-spec-strip">
              <span data-wb-field="actualPipeVelocityMs">—</span> • <span data-wb-field="slurrySpecificGravity">—</span> • <span data-wb-field="sealBranch">—</span> • <span data-wb-field="impellerExitWidthMm">—</span> • <span data-wb-field="dynamicCapacityCkN">—</span> • <span id="dossier-metric-sobol-driver">{isEs ? 'En espera de selección' : 'Awaiting selection'}</span>
            </div>
          </div>
          <div id="live-recirc-warning-dossier" class="live-recirc-warning-dossier hidden">
            <span class="recirc-warn-tag">{isEs ? 'AVISO DE RECIRCULACIÓN' : 'RECIRCULATION NOTICE'}</span>
            <p class="recirc-warn-text">{isEs ? 'Reemplazo individual: cotejar holgura axial en voluta para mitigar recirculación.' : 'Single-part swap: check axial volute clearance.'}</p>
          </div>
          <div class="dossier-backend-telemetry font-mono-tech" id="dossier-backend-telemetry">
            <div><strong>{isEs ? 'Material / Aleación:' : 'Alloy / Material:'}</strong> <span id="live-material-reason">{isEs ? 'Se asigna conforme al SKU seleccionado.' : 'Assigned per selected SKU.'}</span></div>
            <div><strong>{isEs ? 'Bastidor y Rodamiento:' : 'Bearing Frame:'}</strong> <span id="live-bearing-frame-label">—</span></div>
            <div><strong>{isEs ? 'Revisión Axial:' : 'Axial Check:'}</strong> <span id="live-collision-risk">—</span></div>
            <div><strong>{isEs ? 'Recomendación:' : 'Recommendation:'}</strong> <span id="live-recommendation">{isEs ? 'Agregue una partida para activar análisis.' : 'Add a line item to generate analysis.'}</span></div>
            <div><strong>{isEs ? 'Condición:' : 'Terms:'}</strong> <span id="live-advance-payment-pct">{advancePaymentPct}%</span> • <strong>{isEs ? 'Protocolo:' : 'Witness:'}</strong> <span id="live-inspection-protocol">{inspectionProtocolText}</span></div>
          </div>
        </div>
      </div>

      <!-- Memoria Hidráulica oculta en estado vacío hasta capturar partidas de bombeo -->
      <div class="dossier-section hidden" id="live-section-pump-hydraulics">
        <span class="dossier-section-title">{isEs ? '3. MEMORIA HIDRÁULICA DE TRANSPORTE DE PULPA' : '3. SLURRY HYDRAULIC TRANSPORT SUMMARY'}</span>
        <table class="dossier-table">
          <tbody>
            <tr><td><strong>{isEs ? 'Caudal y Sólidos:' : 'Flow & Solids:'}</strong></td><td id="live-table-flow">—</td></tr>
            <tr><td><strong>{isEs ? 'Granulometría (d80):' : 'Particle Size (d80):'}</strong></td><td id="live-table-d80">—</td></tr>
            <tr><td><strong>{isEs ? 'Velocidad Límite (Vc):' : 'Critical Velocity (Vc):'}</strong></td><td id="live-table-vc" class="highlight-cell">—</td></tr>
            <tr><td><strong>{isEs ? 'Abatimiento y Vida:' : 'Derating & Life:'}</strong></td><td id="live-table-derating-wear">HR = <strong id="metric-hr" data-testid="metric-hr">—</strong> | ηr = <strong id="metric-er" data-testid="metric-er">—</strong> | <strong id="metric-wear-hours" data-testid="metric-wear-hours">—</strong></td></tr>
            <tr><td><strong>{isEs ? 'Altitud y Derrateo Motor:' : 'Altitude & Motor Derate:'}</strong></td><td id="live-table-altitude">Patm = <strong id="metric-patm-mca" data-testid="metric-patm-mca">—</strong> (<span id="dossier-metric-delta-npsh" data-testid="dossier-metric-delta-npsh">—</span>) | f_alt = <strong id="metric-motor-iec" data-testid="metric-motor-iec">—</strong> | K_alt = <strong id="metric-k-motor-alt" data-testid="metric-k-motor-alt">—</strong></td></tr>
            <tr><td><strong>{isEs ? 'Metalurgia Dictaminada:' : 'Dictated Metallurgy:'}</strong></td><td id="live-table-mat" class="highlight-cell">—</td></tr>
            <tr><td><strong>{isEs ? 'Holgura y Cinemática:' : 'Clearance & Kinematics:'}</strong></td><td id="live-table-kinematics"><span id="wb-pipe-vel-loss" data-testid="wb-pipe-vel-loss">—</span> <span id="live-assembly-collision-note" data-testid="live-assembly-collision-note"></span></td></tr>
            <tr><td><strong>{isEs ? 'Ficha Física:' : 'Physical Spec:'}</strong></td><td id="live-table-part-specs">—</td></tr>
            <tr id="live-row-metrology" class="hidden"><td><strong>{isEs ? 'Cédula Metrológica Lab:' : 'Lab Metrology:'}</strong></td><td id="live-table-metrology">—</td></tr>
            <tr id="live-row-circuit-physics" data-testid="live-row-circuit-physics"><td><strong id="live-table-circuit-physics-label">{isEs ? 'Reorden de Circuito:' : 'Circuit Reorder:'}</strong></td><td id="live-table-circuit-physics-val">—</td></tr>
            <tr id="live-row-sobol-drivers" data-testid="live-row-sobol-drivers" data-sobol-model="S1"><td><strong>{isEs ? 'Factor Dominante:' : 'Primary Driver:'}</strong></td><td id="live-table-sobol-drivers" class="font-mono-tech">—</td></tr>
          </tbody>
        </table>
      </div>

      <div class="dossier-section">
        <span class="dossier-section-title">{isEs ? '4. INSPECCIÓN Y PROTOCOLO DE ALMACÉN CENTRAL' : '4. CENTRAL WAREHOUSE PROTOCOL'}</span>
        <div class="durango-seal-box" id="durango-seal-box">
          <div class="seal-badge-header">
            <span class="seal-title">{isEs ? 'VERIFICACIÓN METROLÓGICA EN ALMACÉN CENTRAL DURANGO' : 'DURANGO CENTRAL WAREHOUSE INSPECTION'}</span>
          </div>
          <div class="seal-specs-grid">
            <span class="seal-spec-item font-mono-tech">{isEs ? 'Cotejo Durango: Triplete (A, B, C) ISO 2768-m' : 'Durango Check: (A, B, C) Triplet ISO 2768-m'}</span>
            <span class="seal-spec-item font-mono-tech">{isEs ? 'Balanceo ISO 1940 Grado G2.5 (<0.05 mm)' : 'ISO 1940 Grade G2.5 (<0.05 mm runout)'}</span>
            <span class="seal-spec-item font-mono-tech">{isEs ? 'Dureza Certificada ASTM A532 ≥650 HB' : 'Certified Hardness ASTM A532 ≥650 HB'}</span>
          </div>
          <p class="seal-address-note" id="live-clause-text">
            {isEs
              ? 'Garantía de acople dimensional 1:1 en Almacén Central Durango SMAT. Domicilio fiscal: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166.'
              : 'SMAT 1:1 dimensional fit warranty at Durango Central Warehouse. Fiscal HQ: Mariano Salas #114, Durango, Mexico ZIP 34166.'}
          </p>
          <small class="dossier-maneuvers-access-note">{isEs ? companyData.logistics.maneuvers_access : companyData.logistics.maneuvers_access_en}</small>
        </div>
      </div>

      <div class="tco-downtime-anchor-card">
        <div class="tco-anchor-header">
          <span class="anchor-badge font-mono-tech">{isEs ? '[PROTECCIÓN CONTRA PARO]' : '[UPTIME PROTECTION]'}</span>
          <span class="anchor-stat font-mono-tech">{isEs ? '40,000 USD/hora' : '40,000 USD/hour'}</span>
        </div>
        <p class="anchor-desc">
          {isEs
            ? 'Prevención de detenciones no programadas en planta concentradora con refaccionamiento dimensionalmente verificado en Durango.'
            : 'Preventing unscheduled concentrator downtime with dimensionally verified wear parts from Durango.'}
        </p>
      </div>
    </div>

    <div class="dossier-subdivider"><span class="subdivider-tag font-mono-tech">{isEs ? 'PARTIDA ERP & DATOS FISCALES' : 'ERP LINE ITEM & FISCAL DATA'}</span></div>
    <div class="dossier-pane hidden-pane" id="pane-sap">
      <div class="dossier-section">
        <span class="dossier-section-title">{isEs ? '1. ESTRUCTURA DE PARTIDAS (SAP / ERP)' : '1. REQUISITION LINE ITEMS (SAP / ERP)'}</span>
        <div class="sap-table-wrap">
          <table class="dossier-table sap-item-table">
            <thead><tr><th>{isEs ? 'Pos.' : 'Item'}</th><th>{isEs ? 'Partida / Código SMAT' : 'Line Item / SMAT Code'}</th><th>{isEs ? 'Material / Norma' : 'Material / Spec'}</th><th>{isEs ? 'Destino' : 'Destination'}</th></tr></thead>
            <tbody>
              <tr>
                <td><strong>010</strong></td>
                <td>
                  <span id="sap-live-part">{isEs ? 'Sin partidas agregadas todavía' : 'No line items added yet'}</span>
                  <small class="sap-code-badge" id="sap-live-code">{isEs ? 'SMAT-BORRADOR' : 'SMAT-DRAFT'}</small>
                  <div class="sap-tag-line font-mono-tech dossier-sap-tag-line">TAG: <strong id="sap-live-tag">PENDING</strong> • Durango</div>
                </td>
                <td id="sap-live-mat">{isEs ? 'Por definir según SKU' : 'Per selected SKU'}</td>
                <td id="sap-live-dest">{isEs ? 'Almacén Central Durango' : 'Durango Central Warehouse'}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="dossier-section">
        <span class="dossier-section-title">{isEs ? '2. DATOS FISCALES PROVEEDOR' : '2. VENDOR FISCAL DATA'}</span>
        <div class="sap-vendor-box">
          <div class="sap-vendor-row"><span>{isEs ? 'Razón Social:' : 'Legal Entity:'}</span><strong>SMAT MINERALS</strong></div>
          <div class="sap-vendor-row"><span>{isEs ? 'Domicilio Fiscal:' : 'Fiscal HQ:'}</span><span>Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166</span></div>
          <div class="sap-vendor-row"><span>{isEs ? 'Almacén Central:' : 'Warehouse:'}</span><span id="dossier-maneuvers-access" data-testid="dossier-maneuvers-access">{isEs ? (companyData.logistics?.maneuvers_access || 'Durango, Dgo.') : (companyData.logistics?.maneuvers_access_en || 'Durango, Mexico')}</span></div>
          <div class="sap-vendor-row"><span>{isEs ? 'Contacto:' : 'Contact:'}</span><span>{companyData.contact.phones[0].display} • WhatsApp {companyData.contact.whatsapp.display} • {companyData.contact.emails[0].address}</span></div>
          <div class="sap-vendor-row dossier-sap-divider-row">
            <span>{isEs ? 'Validación CFDI 4.0:' : 'CFDI 4.0 Tuple:'}</span>
            <strong id="sap-live-anexo22-tuple" data-testid="sap-live-anexo22-tuple" class="font-mono-tech dossier-anexo22-tuple">{isEs ? 'En espera de partida para asignar fracción SAT' : 'Awaiting line item for SAT tax tuple'}</strong>
          </div>
          <div class="dossier-passport-actions">
            <a href={isEs ? '/cumplimiento/' : '/en/compliance/'} class="btn-pill-action dossier-btn-json">
              {isEs ? 'Expediente Fiscal SAT (.JSON / .VCF) →' : 'SAT Tax Dossier (.JSON / .VCF) →'}
            </a>
          </div>
        </div>
      </div>

      <div class="dossier-section">
        <span class="dossier-section-title">{isEs ? '3. JUSTIFICACIÓN TÉCNICA SAP / ERP' : '3. SAP / ERP TECHNICAL JUSTIFICATION'}</span>
        <div class="sap-justification-container">
          <div class="justification-executive-summary"><span class="justification-dot"></span><p id="sap-justification-summary">{isEs ? 'Suministro de refaccionamiento crítico con verificación dimensional 1:1 en Durango.' : 'Critical wear supply with 1:1 dimensional verification in Durango.'}</p></div>
          <div class="sap-justification-actions"><button type="button" class="btn-copy-justification" id="btn-copy-justification">{isEs ? 'Copiar justificación' : 'Copy justification'}</button></div>
          <details class="erp-justification-drawer" id="erp-justification-drawer">
            <summary class="erp-justification-summary-btn"><span>{isEs ? '▾ Ver texto completo para SAP/ERP' : '▾ View full SAP/ERP text'}</span></summary>
            <div class="sap-justification-box"><p id="sap-justification-text">{isEs ? 'Componente con verificación dimensional 1:1 y concentricidad validada en Almacén Central Durango.' : 'Verified 1:1 dimensional coupling and concentricity at Durango Central Warehouse.'}</p></div>
          </details>
        </div>
      </div>
    </div>

    <div class="dossier-export-section" data-domain-root="erpExport">
      <span class="export-heading">{isEs ? 'ACCIONES DE EXPORTACIÓN Y DESPACHO:' : 'SPEC EXPORT & DISPATCH ACTIONS:'}</span>
      <button type="button" class="export-btn-king export-btn-whatsapp" id="wb-whatsapp-btn" data-schema-output="erpExport.whatsappUrl">
        <div class="king-text">
          <strong>{isEs ? 'Enviar Requisición por WhatsApp a Durango' : 'Send Requisition via WhatsApp to Durango'}</strong>
          <small>{isEs ? 'Ingeniería de planta en Almacén Central • L-V 08:00–18:00 CST' : 'Plant engineering at Central Warehouse • Mon-Fri 08:00-18:00 CST'}</small>
        </div>
      </button>

      <details class="wb-progressive-drawer smat-mt-sm" id="dossier-secondary-exports-drawer">
        <summary class="wb-progressive-summary">
          <span>{isEs ? 'Exportar SAP TSV, PDF A4, Cotejo 1:1 y Enlace Compras' : 'Export SAP TSV, A4 PDF, 1:1 Fit & Purchasing Link'}</span>
          <span class="wb-step1-more-arrow">▾</span>
        </summary>
        <div class="wb-progressive-body">
          <div class="secondary-export-row" id="dossier-actions-row">
            <button type="button" class="btn-pill-action" id="wb-copy-btn"><span>{isEs ? 'Copiar para ERP / SAP' : 'Copy for ERP / SAP'}</span></button>
            <button type="button" class="btn-pill-action" id="wb-pdf-btn" data-schema-output="erpExport.acuseUrlParams"><span>{isEs ? 'Requisición PDF' : 'PDF Requisition'}</span></button>
            <button type="button" class="btn-pill-action btn-pill-tsv" id="wb-copy-tsv-btn" data-schema-output="erpExport.sapTsv"><span>{isEs ? 'Tabla TSV (SAP)' : 'TSV Table (SAP)'}</span></button>
            <button type="button" class="btn-pill-action btn-pill-cotejo" id="wb-cotejo-btn"><span>{isEs ? 'Cotejo ANSI 1:1' : 'ANSI 1:1 Fit'}</span></button>
            <button type="button" class="btn-pill-action" id="wb-email-btn" data-testid="btn-quote-mailto"><span>{isEs ? 'Enviar Correo' : 'Send Email'}</span></button>
            <button type="button" class="btn-pill-action" id="btn-share-purchasing-link"><span>{isEs ? 'Copiar enlace Compras' : 'Copy Link for Purchasing'}</span></button>
          </div>
          <div class="dossier-erp-summary-strip font-mono-tech smat-mt-sm">
            <span>{isEs ? 'Compromiso SLA:' : 'SLA:'} <strong id="dossier-sla-commitment" data-schema-output="erpExport.slaCommitmentEs">{isEs ? 'Sin SLA activo hasta capturar partidas' : 'No active SLA until items added'}</strong></span>
            <span>{isEs ? 'Carril:' : 'Lane:'} <strong id="dossier-dual-checkout" data-schema-output="erpExport.dualCheckout">{isEs ? 'Borrador vacío' : 'Empty Draft'}</strong></span>
            <span>{isEs ? 'Dictamen:' : 'Verdict:'} <strong id="dossier-structural-verdict" data-schema-output="erpExport.dictamen_estructural">{isEs ? 'En espera de partidas' : 'Awaiting items'}</strong></span>
            <span>{isEs ? 'Prioridad:' : 'Priority:'} <strong id="dossier-gate-classification" data-schema-output="erpExport.clasificacion_compuerta">P0</strong></span>
          </div>
        </div>
      </details>

      <div id="wb-toast" class="wb-toast hidden" role="status" aria-live="polite">
