---
// src/components/PumpAssemblyReport.astro
// "Reporte de cómo se arma una bomba" (Secuencia de 5 Estaciones + Despiece Bifurcado Metal vs. Elastómero + BOM de 14 Piezas)
// Basado en primeros principios (Gulich Q_rec ∝ δ^1.5, ISO 281 L10h, ASTM A532 Cr27% ≥650 HB).

import {
  PUMP_554_BOM_14_PARTS,
  PUMP_ASSEMBLY_STATIONS,
  WET_END_MATERIAL_MATRIX
} from '../scripts/slurryEngine.js';
import { formatNioshErgonomicStatus } from '../scripts/workbenchBus.js';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const quoteBase = isEs ? '/cotizar/' : '/en/quote/';
const primaryId = isEs ? 'como-se-arma-una-bomba' : 'how-a-slurry-pump-is-assembled';
const secondaryId = isEs ? 'how-a-slurry-pump-is-assembled' : 'como-se-arma-una-bomba';

const stations = PUMP_ASSEMBLY_STATIONS.map((st) => ({
  code: st.id,
  stationKey: `S${st.station}`,
  num: String(st.station).padStart(2, '0'),
  branch: st.station === 3 ? 'bifurcated' : 'common',
  title: isEs ? st.nameEs : st.nameEn,
  sub: isEs ? st.descriptionEs : st.descriptionEn,
  tolerance: isEs ? st.calibrationLawEs : st.calibrationLawEn
}));

const wetEndMatrixRef = WET_END_MATERIAL_MATRIX;

// Fuente única de verdad desde slurryEngine.js (rango canónico pos: '01' a pos: '14')
const bomItems = PUMP_554_BOM_14_PARTS.map((item) => {
  const niosh = formatNioshErgonomicStatus(item.weightKg, isEs ? 'es' : 'en');
  return {
    pos: item.pos,
    station: item.station,
    branch: item.branch,
    branchLabel: isEs ? item.branchLabelEs : item.branchLabelEn,
    name: isEs ? item.nameEs : item.nameEn,
    spec: isEs ? item.specEs : item.specEn,
    weightKg: item.weightKg,
    nioshHoistRequired: item.nioshHoistRequired,
    nioshTier: niosh.tier,
    nioshBadge: isEs ? niosh.badgeEs : niosh.badgeEn,
    equipo: item.equipo,
    pieza: item.pieza,
    material: item.material
  };
});
---

<section
  id={primaryId}
  class="assembly-report"
  data-pump-assembly-report
  aria-labelledby="assembly-report-heading"
>
  <span id={secondaryId} class="assembly-report__anchor-alias" aria-hidden="true"></span>

  <header class="assembly-report__header">
    <div class="assembly-report__title-group">
      <span class="assembly-report__eyebrow">
        {isEs
          ? 'INGENIERÍA DE CAMPO • REPORTE TÉCNICO DE ARMADO Y DESPIECE (14 COMPONENTES)'
          : 'FIELD ENGINEERING • SLURRY PUMP ASSEMBLY & EXPLODED BOM REPORT (14 PARTS)'}
      </span>
      <h2 id="assembly-report-heading" class="assembly-report__title">
        {isEs
          ? 'Reporte de cómo se arma una bomba para lodos (Secuencia de 5 Estaciones)'
          : 'How a Heavy-Duty Slurry Pump is Assembled (5-Station Sequence)'}
      </h2>
      <p class="assembly-report__subtitle">
        {isEs
          ? 'Del cartucho motriz (Bearing Assembly) al cierre de succión y calibración axial frontal (δ = 0.5–1.0 mm). Seleccione la configuración de contacto húmedo para filtrar las piezas y cotizar en 1 clic:'
          : 'From the Drive-End Bearing Cartridge to suction closure and front axial clearance calibration (δ = 0.5–1.0 mm). Select your wet-end configuration to filter parts and quote in 1 click:'}
      </p>
    </div>

    <div class="assembly-report__controls">
      <div class="assembly-report__branch-tabs" role="tablist" aria-label={isEs ? 'Rama de material de contacto húmedo' : 'Wet-end material branch'}>
        <button
          type="button"
          role="tab"
          aria-selected="true"
          class="branch-tab is-active"
          data-assembly-branch-btn="all"
        >
          {isEs ? 'Vista Dual (Cromo + Hule/PU)' : 'Dual View (Chrome + Rubber/PU)'}
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="branch-tab"
          data-assembly-branch-btn="alto_cromo_cr27"
          title={isEs ? wetEndMatrixRef.alto_cromo_cr27.idealForEs : wetEndMatrixRef.alto_cromo_cr27.idealForEn}
        >
          {isEs ? `Rama A: ${wetEndMatrixRef.alto_cromo_cr27.nameEs}` : `Branch A: ${wetEndMatrixRef.alto_cromo_cr27.nameEn}`}
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="branch-tab"
          data-assembly-branch-btn="hule_natural"
          data-branch-btn="hule_natural"
          title={isEs ? wetEndMatrixRef.hule_natural.idealForEs : wetEndMatrixRef.hule_natural.idealForEn}
        >
          {isEs ? `Rama B: ${wetEndMatrixRef.hule_natural.nameEs} / ${wetEndMatrixRef.poliuretano.code}` : `Branch B: ${wetEndMatrixRef.hule_natural.nameEn} / ${wetEndMatrixRef.poliuretano.code}`}
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="branch-tab"
          data-assembly-branch-btn="ceramica_sic"
          data-branch-btn="ceramica_sic"
          title={isEs ? wetEndMatrixRef.ceramica_sic.idealForEs : wetEndMatrixRef.ceramica_sic.idealForEn}
        >
          {isEs ? `Rama C: ${wetEndMatrixRef.ceramica_sic.nameEs} (δ=0.65 mm)` : `Branch C: ${wetEndMatrixRef.ceramica_sic.nameEn} (δ=0.65 mm)`}
        </button>
      </div>

      <button
        type="button"
        class="assembly-report__xray-btn is-active"
        data-toggle-xray
        aria-pressed="true"
      >
        {isEs ? 'Rayos X de Desgaste: ACTIVO' : 'Wear X-Ray Layer: ON'}
      </button>

      <span class="assembly-report__order-hash" data-selection-order-hash title={isEs ? 'Código determinista FNV-1a de configuración seleccionada' : 'Deterministic FNV-1a selection order code'}>
        Ref: SMAT-7A4F-9C12
      </span>

      <button
        type="button"
        class="assembly-report__print-btn"
        onclick="window.print()"
      >
        {isEs ? 'Imprimir Reporte de Armado (PDF)' : 'Print Assembly Report (PDF)'}
      </button>
    </div>
  </header>

  <!-- Lámina Isométrica de Despiece Bifurcado (Estaciones 1 a 5) -->
  <figure class="assembly-report__blueprint" role="img" aria-label={isEs ? 'Diagrama de despiece y secuencia de armado de bomba para lodos en 5 estaciones' : '5-station slurry pump exploded assembly blueprint'}>
    <div class="assembly-report__blueprint-bar">
      <span>
        {isEs
          ? 'SECUENCIA DE ENSAMBLE AXIAL: SUCCIÓN (IZQUIERDA) ◄─── EJE CENTRAL ───► EXTREMO MOTRIZ (DERECHA)'
          : 'AXIAL ASSEMBLY SEQUENCE: SUCTION END (LEFT) ◄─── SHAFT AXIS ───► DRIVE END (RIGHT)'}
      </span>
      <span class="assembly-report__law-badge">
        {isEs ? 'LEY DE CLARO AXIAL: Q_rec ∝ δ^1.5 (δ_óptimo = 0.5–1.0 mm)' : 'CLEARANCE LAW: Q_rec ∝ δ^1.5 (Optimal δ = 0.5–1.0 mm)'}
      </span>
    </div>

    <svg viewBox="0 0 880 390" class="assembly-svg" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid-assembly-v34" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.6" />
        </pattern>
      </defs>
      <rect width="880" height="390" fill="url(#grid-assembly-v34)" />

      <!-- Línea de eje central (Centerline) -->
      <line x1="24" y1="196" x2="856" y2="196" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="10 5" />

      <!-- ESTACIÓN 4 (Izquierda): Cierre de Succión (Cover Plate #13 + Throatbush #12) -->
      <g transform="translate(22, 48)">
        <rect x="0" y="0" width="162" height="288" rx="7" fill="#f8fafc" stroke="#0d78c6" stroke-width="1.8" />
        <rect x="0" y="0" width="162" height="24" rx="7" fill="#0d78c6" />
        <text x="81" y="16" text-anchor="middle" font-family="SF Mono, monospace" font-size="9.5" font-weight="800" fill="#ffffff">{isEs ? 'EST-04 • SUCCIÓN' : 'EST-04 • SUCTION'}</text>
        <!-- Cover Plate #13 -->
        <rect x="14" y="48" width="54" height="192" rx="4" fill="#cbd5e1" stroke="#0f172a" stroke-width="2.2" />
        <rect x="4" y="114" width="14" height="60" fill="#94a3b8" stroke="#0f172a" stroke-width="1.8" />
        <text x="41" y="42" text-anchor="middle" font-family="SF Mono, monospace" font-size="8.5" font-weight="800" fill="#0f172a">#13 COVER</text>
        <!-- Throatbush #12 -->
        <path d="M 84 68 L 136 68 L 146 112 L 146 176 L 136 220 L 84 220 Z" fill="#dbeafe" stroke="#1e3a8a" stroke-width="2.2" />
        <circle cx="115" cy="144" r="20" fill="#ffffff" stroke="#0d78c6" stroke-width="2" />
        <text x="115" y="56" text-anchor="middle" font-family="SF Mono, monospace" font-size="8.5" font-weight="800" fill="#1e3a8a">#12 THROATBUSH</text>
        <text x="81" y="256" text-anchor="middle" font-family="SF Mono, monospace" font-size="8" font-weight="700" fill="#0f172a">{isEs ? 'Anillo frontal de desgaste' : 'Suction front wear ring'}</text>
        <text x="81" y="272" text-anchor="middle" font-family="SF Mono, monospace" font-size="8" font-weight="700" fill="#c25e00">{isEs ? 'Cara de ajuste δ_frontal' : 'Mating face for δ_frontal'}</text>
      </g>

      <!-- ESTACIÓN 5 (Franja de Calibración Axial entre Throatbush #12 e Impulsor #09) -->
      <g id="est-05" transform="translate(190, 56)">
        <rect data-est-05-box x="0" y="0" width="56" height="272" rx="5" fill="#fffbeb" stroke="#d97706" stroke-width="2" stroke-dasharray="4 3" />
        <text x="28" y="22" text-anchor="middle" font-family="SF Mono, monospace" font-size="9" font-weight="800" fill="#b45309">EST-05</text>
        <line x1="28" y1="36" x2="28" y2="220" stroke="#d97706" stroke-width="2.5" stroke-dasharray="3 3" />
        <rect x="4" y="112" width="48" height="46" rx="4" fill="#fef3c7" stroke="#b45309" stroke-width="1.5" />
        <text x="28" y="131" text-anchor="middle" font-family="SF Mono, monospace" font-size="9" font-weight="800" fill="#92400e">δ_frontal</text>
        <text data-est-05-val x="28" y="147" text-anchor="middle" font-family="SF Mono, monospace" font-size="8.5" font-weight="800" fill="#b45309">0.75 mm</text>
        <text x="28" y="246" text-anchor="middle" font-family="SF Mono, monospace" font-size="7.5" font-weight="700" fill="#92400e">{isEs ? 'Calibración' : 'Clearance'}</text>
        <text x="28" y="258" text-anchor="middle" font-family="SF Mono, monospace" font-size="7.5" font-weight="700" fill="#92400e">{isEs ? 'Post-Armado' : 'Calibration'}</text>
      </g>

      <!-- ESTACIÓN 3 (Centro): Bifurcación del Lote Húmedo 5-5-4 (Rama A Alto Cromo vs. Rama B Hule/PU) -->
      <g transform="translate(252, 16)">
        <!-- Caja Superior: Rama A Alto Cromo Cr27% (≥650 HB) -->
        <g data-svg-branch="alto_cromo_cr27">
          <rect x="0" y="0" width="286" height="172" rx="7" fill="#eff6ff" stroke="#1e3a8a" stroke-width="2" />
          <rect x="0" y="0" width="286" height="24" rx="7" fill="#1e3a8a" />
          <text x="143" y="16" text-anchor="middle" font-family="SF Mono, monospace" font-size="9.5" font-weight="800" fill="#ffffff">
            {isEs ? 'EST-03 RAMA A • ALTO CROMO Cr27% (≥650 HB)' : 'EST-03 BRANCH A • HIGH CHROME Cr27% (≥650 HB)'}
          </text>
          <!-- #10 Voluta Monolítica -->
          <circle cx="58" cy="88" r="38" fill="#cbd5e1" stroke="#1e3a8a" stroke-width="2.4" />
          <circle cx="58" cy="88" r="15" fill="#eff6ff" stroke="#1e3a8a" stroke-width="1.8" />
          <rect x="46" y="38" width="24" height="14" fill="#94a3b8" stroke="#1e3a8a" stroke-width="2" />
          <text x="58" y="142" text-anchor="middle" font-family="SF Mono, monospace" font-size="8.5" font-weight="800" fill="#1e3a8a">#10 VOLUTA METAL</text>
          <text x="58" y="156" text-anchor="middle" font-family="SF Mono, monospace" font-size="7.5" font-weight="700" fill="#475569">{isEs ? 'Caracol 1 pieza' : '1-piece scroll'}</text>
          <!-- #09 Impulsor 5 Álabes -->
          <circle cx="152" cy="88" r="32" fill="#93c5fd" stroke="#1e3a8a" stroke-width="2.4" />
          <circle cx="152" cy="88" r="10" fill="#1e3a8a" />
          <text x="152" y="142" text-anchor="middle" font-family="SF Mono, monospace" font-size="8.5" font-weight="800" fill="#1e3a8a">#09 IMPULSOR 5V</text>
          <text x="152" y="156" text-anchor="middle" font-family="SF Mono, monospace" font-size="7.5" font-weight="700" fill="#475569">{isEs ? 'Álabes expulsores' : 'Pump-out vanes'}</text>
          <!-- #07 FPL Insert -->
          <rect x="218" y="52" width="44" height="72" rx="6" fill="#dbeafe" stroke="#0d78c6" stroke-width="2.2" />
          <text x="240" y="142" text-anchor="middle" font-family="SF Mono, monospace" font-size="8.5" font-weight="800" fill="#0d78c6">#07 FPL INSERT</text>
          <text x="240" y="156" text-anchor="middle" font-family="SF Mono, monospace" font-size="7.5" font-weight="700" fill="#475569">{isEs ? 'Plato posterior' : 'Rear wear plate'}</text>
        </g>

        <!-- Caja Inferior: Rama B Hule Natural / Poliuretano (Liners Bipartidos CPL + FPL) -->
        <g transform="translate(0, 186)" data-svg-branch="hule_natural">
          <rect x="0" y="0" width="286" height="172" rx="7" fill="#f8fafc" stroke="#0f172a" stroke-width="2" />
          <rect x="0" y="0" width="286" height="24" rx="7" fill="#0f172a" />
          <text x="143" y="16" text-anchor="middle" font-family="SF Mono, monospace" font-size="9.5" font-weight="800" fill="#ffffff">
            {isEs ? 'EST-03 RAMA B • HULE NATURAL / POLIURETANO' : 'EST-03 BRANCH B • NATURAL RUBBER / POLYURETHANE'}
          </text>
          <!-- #11 Cover Plate Liner (CPL) -->
          <path d="M 30 48 L 82 48 L 82 124 L 30 124 Z" fill="#1e293b" stroke="#475569" stroke-width="2.2" />
          <circle cx="56" cy="86" r="14" fill="#f8fafc" />
          <text x="56" y="142" text-anchor="middle" font-family="SF Mono, monospace" font-size="8.5" font-weight="800" fill="#0f172a">#11 LINER CPL</text>
          <text x="56" y="156" text-anchor="middle" font-family="SF Mono, monospace" font-size="7.5" font-weight="700" fill="#475569">{isEs ? 'Mitad succión' : 'Suction half-liner'}</text>
          <!-- #09 Impulsor Hule / PU -->
          <circle cx="146" cy="86" r="30" fill="#facc15" stroke="#b45309" stroke-width="2.2" />
          <circle cx="146" cy="86" r="9" fill="#0f172a" />
          <text x="146" y="142" text-anchor="middle" font-family="SF Mono, monospace" font-size="8.5" font-weight="800" fill="#b45309">#09 IMPULSOR</text>
          <text x="146" y="156" text-anchor="middle" font-family="SF Mono, monospace" font-size="7.5" font-weight="700" fill="#475569">{isEs ? 'Hule / PU / Cromo' : 'Rubber / PU / Cr27'}</text>
          <!-- #08 Frame Plate Liner (FPL) -->
          <path d="M 206 48 L 258 48 L 258 124 L 206 124 Z" fill="#334155" stroke="#0f172a" stroke-width="2.2" />
          <circle cx="232" cy="86" r="12" fill="#cbd5e1" />
          <text x="232" y="142" text-anchor="middle" font-family="SF Mono, monospace" font-size="8.5" font-weight="800" fill="#0f172a">#08 LINER FPL</text>
          <text x="232" y="156" text-anchor="middle" font-family="SF Mono, monospace" font-size="7.5" font-weight="700" fill="#475569">{isEs ? 'Mitad soporte' : 'Drive-side liner'}</text>
        </g>
      </g>

      <!-- ESTACIÓN 2 (Centro-Derecha): Sellado Centrífugo Expeller / Prensaestopa (#06, #05, #04, #03) -->
      <g transform="translate(546, 48)">
        <rect x="0" y="0" width="146" height="288" rx="7" fill="#f8fafc" stroke="#c25e00" stroke-width="1.8" />
        <rect x="0" y="0" width="146" height="24" rx="7" fill="#c25e00" />
        <text x="73" y="16" text-anchor="middle" font-family="SF Mono, monospace" font-size="9.5" font-weight="800" fill="#ffffff">{isEs ? 'EST-02 • SELLADO' : 'EST-02 • SEALING'}</text>
        <!-- #06 Frame Plate -->
        <rect x="10" y="48" width="26" height="192" rx="3" fill="#cbd5e1" stroke="#0f172a" stroke-width="2" />
        <text x="23" y="42" text-anchor="middle" font-family="SF Mono, monospace" font-size="7.5" font-weight="800" fill="#0f172a">#06 FP</text>
        <!-- #05 Expeller -->
        <rect x="44" y="82" width="32" height="124" rx="4" fill="#fef3c7" stroke="#c25e00" stroke-width="2.2" />
        <text x="60" y="72" text-anchor="middle" font-family="SF Mono, monospace" font-size="8" font-weight="800" fill="#c25e00">#05 EXP</text>
        <!-- #04 Expeller Ring / Stuffing Box + #03 Shaft Sleeve D075C21 -->
        <rect x="84" y="68" width="48" height="152" rx="4" fill="#e2e8f0" stroke="#334155" stroke-width="2" />
        <rect x="80" y="134" width="56" height="20" fill="#93c5fd" stroke="#1e3a8a" stroke-width="1.8" />
        <text x="108" y="58" text-anchor="middle" font-family="SF Mono, monospace" font-size="8" font-weight="800" fill="#0f172a">#04/#03 D075C21</text>
        <text x="73" y="256" text-anchor="middle" font-family="SF Mono, monospace" font-size="8" font-weight="700" fill="#c25e00">{isEs ? 'Expulsor seco o' : 'Dry expeller or'}</text>
        <text x="73" y="272" text-anchor="middle" font-family="SF Mono, monospace" font-size="8" font-weight="700" fill="#475569">{isEs ? 'Camisa D075C21' : 'D075C21 Sleeve'}</text>
      </g>

      <!-- Capa Pre-Atentiva de Rayos X de Desgaste (D2: Rojo #dc2626 / Ámbar #d97706 / Azul #0284c7) -->
      <g data-layer="xray-wear" class="assembly-xray-layer">
        <rect x="138" y="102" width="16" height="168" rx="3" fill="rgba(220, 38, 38, 0.22)" stroke="#dc2626" stroke-width="2" stroke-dasharray="4 2" />
        <circle cx="312" cy="196" r="56" fill="rgba(220, 38, 38, 0.14)" stroke="#dc2626" stroke-width="1.8" stroke-dasharray="5 3" />
        <rect x="556" y="126" width="66" height="136" rx="4" fill="rgba(217, 119, 6, 0.18)" stroke="#d97706" stroke-width="1.8" stroke-dasharray="4 2" />
        <rect x="716" y="138" width="126" height="106" rx="6" fill="rgba(2, 132, 199, 0.14)" stroke="#0284c7" stroke-width="1.8" stroke-dasharray="4 2" />
        <text x="440" y="378" text-anchor="middle" font-family="SF Mono, monospace" font-size="9.5" font-weight="800" fill="#dc2626">
          {isEs
            ? 'RAYOS X DE DESGASTE: ROJO (#dc2626 Claro δ = 1 Tarjeta ISO 0.76 mm + Álabes) • ÁMBAR (#d97706 Camisa D075C21) • AZUL (#0284c7 Soporte ISO 281)'
            : 'WEAR X-RAY: RED (#dc2626 Gap δ = 1 ISO Card 0.76 mm + Vanes) • AMBER (#d97706 D075C21 Sleeve) • BLUE (#0284c7 ISO 281 Support)'}
        </text>
      </g>

      <!-- ESTACIÓN 1 (Derecha): Extremo Motriz Bearing Assembly (#02 + #01) -->
      <g transform="translate(700, 48)">
        <rect x="0" y="0" width="158" height="288" rx="7" fill="#f8fafc" stroke="#0f172a" stroke-width="2" />
        <rect x="0" y="0" width="158" height="24" rx="7" fill="#0f172a" />
        <text x="79" y="16" text-anchor="middle" font-family="SF Mono, monospace" font-size="9.5" font-weight="800" fill="#ffffff">{isEs ? 'EST-01 • MOTRIZ' : 'EST-01 • DRIVE END'}</text>
        <!-- Eje Pasante -->
        <rect x="6" y="138" width="146" height="16" fill="#334155" />
        <!-- Cartucho Bearing Assembly #02 -->
        <rect x="20" y="96" width="118" height="98" rx="6" fill="#dbeafe" stroke="#0d78c6" stroke-width="2.4" />
        <rect x="28" y="104" width="22" height="82" fill="#93c5fd" stroke="#1e3a8a" stroke-width="1.8" />
        <rect x="108" y="104" width="22" height="82" fill="#93c5fd" stroke="#1e3a8a" stroke-width="1.8" />
        <text x="79" y="86" text-anchor="middle" font-family="SF Mono, monospace" font-size="8.5" font-weight="800" fill="#1e3a8a">#02 BEARING ASSY</text>
        <!-- Pedestal #01 y Tornillo de Ajuste Axial -->
        <rect x="30" y="196" width="98" height="36" rx="3" fill="#cbd5e1" stroke="#0f172a" stroke-width="2" />
        <circle cx="79" cy="214" r="8" fill="#15803d" />
        <text x="79" y="254" text-anchor="middle" font-family="SF Mono, monospace" font-size="8" font-weight="800" fill="#15803d">{isEs ? '#01 Tornillo Ajuste δ' : '#01 Adjusting Screw δ'}</text>
        <text x="79" y="270" text-anchor="middle" font-family="SF Mono, monospace" font-size="8" font-weight="700" fill="#475569">{isEs ? 'Rodamientos ISO 281' : 'ISO 281 Roller Bearings'}</text>
      </g>
    </svg>
  </figure>

  <!-- Tarjetas de las 5 Estaciones de Armado -->
  <div class="assembly-report__stations">
    {stations.map((st) => (
      <article class="station-card">
        <div class="station-card__top">
          <span class="station-card__code">{st.code}</span>
          <span class="station-card__num">{isEs ? `PASO ${st.num}` : `STEP ${st.num}`}</span>
        </div>
        <h3 class="station-card__title">{st.title}</h3>
        <p class="station-card__desc">{st.sub}</p>
        <div class="station-card__tol">
          <strong>{isEs ? 'Control:' : 'Check:'}</strong> {st.tolerance}
        </div>
        <a
          href={`${quoteBase}?circuito=bombeo&equipo=bombeo_hule_cromo&estacion=${st.stationKey}&material=alto_cromo_cr27&claro_mm=0.75&b2_mm=48&seal_branch=expeller_dry#rfq`}
          class="station-cta-btn no-print"
          data-station-cta={st.stationKey}
          data-quote-base={quoteBase}
        >
          {isEs ? `Cotizar ${st.code} →` : `Quote ${st.code} →`}
        </a>
      </article>
    ))}
  </div>

  <!-- Calibrador Interactivo de Claro Axial Frontal δ_frontal (Estación 05 — Decisión 1-C+, Arbitraje #9) -->
  <details class="assembly-clearance-calibrator" id="station-05-calibrator" data-clearance-calibrator>
    <summary class="assembly-clearance-calibrator__summary">
      <span class="assembly-clearance-calibrator__badge">EST-05 • {isEs ? 'CALIBRADOR EN VIVO' : 'LIVE CALIBRATOR'}</span>
      <span class="assembly-clearance-calibrator__title">
        {isEs
          ? 'Simular Claro Axial Frontal (δ_frontal), Pérdida Volumétrica (Δη_v) y Desgaste de Lote 5-5-4'
          : 'Simulate Front Axial Clearance (δ_frontal), Volumetric Loss (Δη_v) & 5-5-4 Wear Lot Impact'}
      </span>
      <span class="assembly-clearance-calibrator__hint">
        {isEs ? 'Abrir simulador δ = 0.1–5.0 mm ▾' : 'Open simulator δ = 0.1–5.0 mm ▾'}
      </span>
    </summary>

    <div class="assembly-clearance-calibrator__body">
      <div class="assembly-clearance-calibrator__controls">
        <label class="clearance-field">
          <span class="clearance-field__label">
            {isEs ? 'Claro Axial Frontal Impulsor–Throatbush (δ_frontal):' : 'Impeller–Throatbush Front Clearance (δ_frontal):'}
            <strong data-clearance-readout>0.75 mm</strong>
          </span>
          <input
            type="range"
            id="clearance-slider-s5"
            min="0.10"
            max="5.00"
            step="0.05"
            value="0.75"
            data-clearance-slider
            aria-label={isEs ? 'Claro axial frontal en milímetros' : 'Front axial clearance in millimeters'}
          />
          <span class="clearance-field__scale">
            <span>0.1 mm ({isEs ? 'Roce' : 'Rub'})</span>
            <span>0.5–1.0 mm ({isEs ? 'Óptimo' : 'Optimal'})</span>
            <span>5.0 mm ({isEs ? 'Vórtice severo' : 'Severe vortex'})</span>
          </span>
        </label>

        <label class="clearance-field">
          <span class="clearance-field__label">
            {isEs ? 'Ancho de Salida del Impulsor (b₂) / Serie:' : 'Impeller Exit Width (b₂) / Series:'}
          </span>
          <select data-clearance-b2 aria-label={isEs ? 'Ancho de salida de impulsor b2' : 'Impeller exit width b2'}>
            <option value="38" data-series="3x2">{isEs ? '38 mm — Serie 3x2 / 4x3 (D3147)' : '38 mm — 3x2 / 4x3 Series (D3147)'}</option>
            <option value="48" data-series="6x4" selected>{isEs ? '48 mm — Serie 6x4 (E4147 Estándar)' : '48 mm — 6x4 Series (E4147 Standard)'}</option>
            <option value="64" data-series="8x6">{isEs ? '64 mm — Serie 8x6 / 10x8 (F6147)' : '64 mm — 8x6 / 10x8 Series (F6147)'}</option>
          </select>
        </label>

        <label class="clearance-field">
          <span class="clearance-field__label">
            {isEs ? 'Rama de Sellado de Eje (Estación 02):' : 'Shaft Sealing Branch (Station 02):'}
          </span>
          <select data-seal-branch-select aria-label={isEs ? 'Rama de sellado de eje Estación 02' : 'Station 02 shaft sealing branch'}>
            <option value="expeller_dry" selected>{isEs ? 'Est. 02A — Expulsor Centrífugo Seco (Sin agua de sello)' : 'St. 02A — Dry Centrifugal Expeller (Zero gland water)'}</option>
            <option value="gland_water">{isEs ? 'Est. 02B — Prensaestopa Húmedo (Anillo Linterna)' : 'St. 02B — Wet Gland Packing (Lantern Ring)'}</option>
          </select>
        </label>

        <label class="clearance-field">
          <span class="clearance-field__label">
            {isEs ? 'Auditoria de Secuencia de Montaje (Estaciones 01–05):' : 'Assembly Sequence Audit (Stations 01–05):'}
          </span>
          <select data-clearance-seq-select aria-label={isEs ? 'Secuencia de montaje de 5 estaciones' : '5-station assembly sequence'}>
            <option value="canonical" selected>{isEs ? 'Canónica: EST-01 ➔ EST-02 ➔ EST-03 ➔ EST-04 ➔ EST-05' : 'Canonical: EST-01 ➔ EST-02 ➔ EST-03 ➔ EST-04 ➔ EST-05'}</option>
            <option value="impeller_before_rear_liner">{isEs ? 'Error típico A: Roscar Impulsor (EST-03) antes de Sello/FPL (EST-02)' : 'Typical Error A: Thread Impeller (EST-03) before Seal/FPL (EST-02)'}</option>
            <option value="cover_before_throatbush">{isEs ? 'Error típico B: Cerrar Tapa Succión (EST-05) sin Throatbush (EST-04)' : 'Typical Error B: Close Cover Plate (EST-05) without Throatbush (EST-04)'}</option>
          </select>
        </label>
      </div>

      <div class="assembly-clearance-calibrator__metrics">
        <div class="clearance-metric-card">
          <span class="clearance-metric-card__kicker">{isEs ? 'CAÍDA VOLUMÉTRICA (Δη_v)' : 'VOLUMETRIC DROP (Δη_v)'}</span>
          <strong class="clearance-metric-card__val" data-clearance-loss>1.68%</strong>
          <span class="clearance-metric-card__sub" data-clearance-ratio>1.00× {isEs ? 'recirculación base' : 'baseline recirculation'}</span>
        </div>
        <div class="clearance-metric-card">
          <span class="clearance-metric-card__kicker">{isEs ? 'ESTADO DE CALIBRACIÓN' : 'CALIBRATION STATUS'}</span>
          <strong class="clearance-metric-card__val status-optimal" data-clearance-status>
            {isEs ? 'CALIBRACIÓN ÓPTIMA (0.5–1.0 mm)' : 'OPTIMAL CALIBRATION (0.5–1.0 mm)'}
          </strong>
          <span class="clearance-metric-card__sub" data-clearance-vc-loss>
            {isEs ? 'Margen Vc tubería: -1.43%' : 'Pipe Vc margin impact: -1.43%'}
          </span>
        </div>
        <div class="clearance-metric-card">
          <span class="clearance-metric-card__kicker">{isEs ? 'IMPACTO EN LOTE 5-5-4' : '5-5-4 WEAR LOT IMPACT'}</span>
          <strong class="clearance-metric-card__val" data-clearance-lot554>
            {isEs ? '5:5:4 (Rotación acoplada nominal)' : '5:5:4 (Coupled nominal wear lot)'}
          </strong>
          <a
            href={`${quoteBase}?circuito=bombeo&equipo=bombeo_hule_cromo&pieza=throatbush&estacion=5&claro_mm=0.75#rfq`}
            class="clearance-metric-card__cta"
            data-clearance-quote-cta
            data-quote-base={quoteBase}
          >
            {isEs ? 'Cotizar Throatbush / Lote con este δ →' : 'Quote Throatbush / Kit with this δ →'}
          </a>
        </div>
        <div class="clearance-metric-card">
          <span class="clearance-metric-card__kicker">{isEs ? 'MASA DE RAMA E INTERFERENCIA' : 'BRANCH MASS & INTERFERENCE'}</span>
          <strong class="clearance-metric-card__val" data-clearance-mass-total>
            {isEs ? '736.2 kg • 6 izajes NIOSH (≥23 kg)' : '736.2 kg • 6 NIOSH hoists (≥23 kg)'}
          </strong>
          <span class="clearance-metric-card__sub" data-clearance-seq-status>
            {isEs ? 'Secuencia 01–05 válida sin colisión axial' : 'Sequence 01–05 valid with zero axial collision'}
          </span>
        </div>
      </div>
    </div>
  </details>

  <!-- Tabla Interactiva de Despiece (14 Componentes) con Cotización en 1 Clic -->
  <div class="assembly-report__bom-wrap">
    <div class="assembly-report__bom-header">
      <h3 class="assembly-report__bom-title">
        {isEs
          ? 'Cédula de Despiece (14 Componentes) y Selección Directa para Cotización'
          : '14-Component Exploded Bill of Materials (BOM) & Direct Quote Selection'}
      </h3>
      <a
        href={`${quoteBase}?equipo=bombeo_hule_cromo&pieza=lote_554&material=alto_cromo_cr27#rfq`}
        class="assembly-report__lot-cta"
      >
        {isEs ? 'Cotizar Lote Húmedo 5-5-4 Completo →' : 'Quote Complete 5-5-4 Wet-End Kit →'}
      </a>
    </div>

    <div class="assembly-report__table-scroll">
      <table class="assembly-bom-table">
        <thead>
          <tr>
            <th>{isEs ? '# Pos' : 'Pos #'}</th>
            <th>{isEs ? 'Estación' : 'Station'}</th>
            <th>{isEs ? 'Rama / Configuración' : 'Branch / Config'}</th>
            <th>{isEs ? 'Componente / Pieza de Recambio' : 'Component / Spare Part'}</th>
            <th>{isEs ? 'Masa / Izaje NIOSH' : 'Mass / NIOSH Hoist'}</th>
            <th>{isEs ? 'Especificación y Función en el Armado' : 'Specification & Assembly Function'}</th>
            <th>{isEs ? 'Acción Directa' : 'Direct Action'}</th>
          </tr>
        </thead>
        <tbody>
          {bomItems.map((row) => {
            const href = `${quoteBase}?circuito=bombeo&equipo=${row.equipo}&pieza=${row.pieza}&material=${row.material}&estacion=${row.station}&peso_kg=${row.weightKg}&claro_mm=0.75&b2_mm=48&seal_branch=expeller_dry#rfq`;
            return (
              <tr data-bom-row data-bom-branch={row.branch} data-bom-pos={row.pos} data-niosh-tier={row.nioshTier}>
                <td class="bom-col-pos">#{row.pos}</td>
                <td class="bom-col-station"><code>{row.station}</code></td>
                <td class="bom-col-branch">
                  <span class={`bom-branch-pill branch-${row.branch}`}>{row.branchLabel}</span>
                </td>
                <td class="bom-col-name"><strong>{row.name}</strong></td>
                <td class="bom-col-mass">
                  <strong>{row.weightKg} kg</strong>
                  <span class="bom-niosh-tag" style="display:block;font-size:0.72rem;opacity:0.86;">
                    {row.nioshBadge}
                  </span>
                </td>
                <td class="bom-col-spec">{row.spec}</td>
                <td class="bom-col-action">
                  <a
                    href={href}
                    class="bom-quote-link"
                    data-bom-quote-link
                    data-quote-base={quoteBase}
                    data-base-equipo={row.equipo}
                    data-base-pieza={row.pieza}
                    data-base-material={row.material}
                    data-base-station={row.station}
                    data-base-weight={row.weightKg}
                  >
                    {isEs ? 'Cotizar pieza →' : 'Quote part →'}
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  import { evaluateWetEndAssemblyInterference, computeSelectionOrderCodeHash } from '../scripts/slurryEngine.js';
  import { saveWorkbenchState, loadWorkbenchState } from '../scripts/workbenchBus.js';

  function initPumpAssemblyReport() {
    const reports = document.querySelectorAll('[data-pump-assembly-report]');
    reports.forEach((section) => {
      const buttons = section.querySelectorAll('[data-assembly-branch-btn]');
      const xrayToggleBtn = section.querySelector('[data-toggle-xray]') as HTMLButtonElement | null;
      const xrayLayer = section.querySelector('[data-layer="xray-wear"]') as SVGGElement | null;
      const orderHashBadge = section.querySelector('[data-selection-order-hash]');
      const rows = section.querySelectorAll('[data-bom-row]');
      const bomLinks = section.querySelectorAll('[data-bom-quote-link]');
      const stationCtas = section.querySelectorAll('[data-station-cta]');
      const lotCta = section.querySelector('.assembly-report__lot-cta') as HTMLAnchorElement | null;
      const svgBranches = section.querySelectorAll('[data-svg-branch]');
      let activeBranch = 'metal';
      let activeMaterialKey = 'alto_cromo_cr27';

      // Calibrador en vivo de Claro Axial Frontal δ_frontal y Secuencia 01–05 (Estación 05)
      const slider = section.querySelector('[data-clearance-slider]') as HTMLInputElement | null;
      const b2Select = section.querySelector('[data-clearance-b2]') as HTMLSelectElement | null;
      const sealSelect = section.querySelector('[data-seal-branch-select]') as HTMLSelectElement | null;
      const seqSelect = section.querySelector('[data-clearance-seq-select]') as HTMLSelectElement | null;
      const readoutEl = section.querySelector('[data-clearance-readout]');
      const lossEl = section.querySelector('[data-clearance-loss]');
      const ratioEl = section.querySelector('[data-clearance-ratio]');
      const statusEl = section.querySelector('[data-clearance-status]');
      const vcLossEl = section.querySelector('[data-clearance-vc-loss]');
      const lot554El = section.querySelector('[data-clearance-lot554]');
      const massTotalEl = section.querySelector('[data-clearance-mass-total]');
      const seqStatusEl = section.querySelector('[data-clearance-seq-status]');
      const quoteCta = section.querySelector('[data-clearance-quote-cta]') as HTMLAnchorElement | null;
      const svgValEl = section.querySelector('[data-est-05-val]');
      const svgBoxEl = section.querySelector('[data-est-05-box]');
      const isEnDoc = document.documentElement.lang === 'en';

      const syncAllAssemblyLinks = (frontClearanceMm: number, impellerExitWidthMm: number, sealBranch: string, pipeSeries: string) => {
        const claroStr = frontClearanceMm.toFixed(2);
        bomLinks.forEach((el) => {
          const link = el as HTMLAnchorElement;
          const base = link.getAttribute('data-quote-base') || '/cotizar/';
          const eq = link.getAttribute('data-base-equipo') || 'bombeo_hule_cromo';
          const pz = link.getAttribute('data-base-pieza') || 'lote_554';
          const baseMat = link.getAttribute('data-base-material') || 'alto_cromo_cr27';
          const st = link.getAttribute('data-base-station') || 'S4';
          const wt = link.getAttribute('data-base-weight') || '38.4';
          const resolvedMat = activeMaterialKey === 'ceramica_sic' && (baseMat === 'alto_cromo_cr27' || baseMat === 'hule_natural')
            ? 'ceramica_sic'
            : (activeMaterialKey !== 'alto_cromo_cr27' && st !== 'S1' ? activeMaterialKey : baseMat);
          link.href = `${base}?circuito=bombeo&equipo=${eq}&pieza=${pz}&material=${resolvedMat}&serie=${pipeSeries}&estacion=${st}&peso_kg=${wt}&claro_mm=${claroStr}&b2_mm=${impellerExitWidthMm}&seal_branch=${sealBranch}#rfq`;
        });
        stationCtas.forEach((el) => {
          const link = el as HTMLAnchorElement;
          const base = link.getAttribute('data-quote-base') || '/cotizar/';
          const st = link.getAttribute('data-station-cta') || 'S4';
          link.href = `${base}?circuito=bombeo&equipo=bombeo_hule_cromo&estacion=${st}&material=${activeMaterialKey}&serie=${pipeSeries}&claro_mm=${claroStr}&b2_mm=${impellerExitWidthMm}&seal_branch=${sealBranch}#rfq`;
        });
        if (lotCta) {
          const base = isEnDoc ? '/en/quote/' : '/cotizar/';
          lotCta.href = `${base}?circuito=bombeo&equipo=bombeo_hule_cromo&pieza=lote_554&material=${activeMaterialKey}&serie=${pipeSeries}&estacion=S4&claro_mm=${claroStr}&b2_mm=${impellerExitWidthMm}&seal_branch=${sealBranch}#rfq`;
        }
      };

      const updateClearanceSimulation = () => {
        if (!slider) return;
        const frontClearanceMm = Number(slider.value) || 0.75;
        const impellerExitWidthMm = b2Select ? Number(b2Select.value) || 48 : 48;
        const sealBranch = sealSelect ? sealSelect.value : 'expeller_dry';
        const pipeSeries = impellerExitWidthMm <= 38 ? '3x2' : (impellerExitWidthMm >= 64 ? '8x6' : '6x4');
        const sequencePreset = seqSelect ? seqSelect.value : 'canonical';
        const res = evaluateWetEndAssemblyInterference({
          wetEndBranch: activeBranch as 'metal' | 'rubber' | 'ceramica_sic',
          sealBranch,
          frontClearanceMm,
          impellerExitWidthMm,
          pipeSeries,
          sequencePreset
        });

        if (readoutEl) readoutEl.textContent = `${res.frontClearanceMm.toFixed(2)} mm`;
        if (orderHashBadge) {
          const codeHash = computeSelectionOrderCodeHash({
            branch: activeBranch,
            mat: activeMaterialKey,
            seal: sealBranch,
            b2: impellerExitWidthMm,
            claro: res.frontClearanceMm.toFixed(2)
          });
          orderHashBadge.textContent = `Ref: ${codeHash}`;
        }
        if (lossEl) lossEl.textContent = `${res.volumetricEfficiencyDropPct.toFixed(2)}%`;
        if (ratioEl) {
          ratioEl.textContent = isEnDoc
            ? `${res.excessRecirculationRatio.toFixed(2)}× baseline recirculation`
            : `${res.excessRecirculationRatio.toFixed(2)}× recirculación base`;
        }
        if (statusEl) {
          let label = isEnDoc ? 'OPTIMAL CALIBRATION (0.5–1.0 mm)' : 'CALIBRACIÓN ÓPTIMA (0.5–1.0 mm)';
          if (res.clearanceStatus === 'RUBBING_RISK') {
            label = isEnDoc ? 'CRITICAL: AXIAL RUBBING RISK (< 0.5 mm)' : 'CRÍTICO: RIESGO DE ROCE AXIAL (< 0.5 mm)';
          } else if (res.clearanceStatus === 'EXCESS_RECIRCULATION_WEAR') {
            label = isEnDoc ? 'WARNING: EXCESS VORTEX WEAR (> 1.0 mm)' : 'ALERTA: VÓRTICE DE RECIRCULACIÓN (> 1.0 mm)';
          }
          statusEl.textContent = label;
        }
        if (vcLossEl) {
          vcLossEl.textContent = isEnDoc
            ? `Pipe Vc margin impact: -${res.pipeVelocityMarginLossPct.toFixed(2)}%`
            : `Margen Vc tubería: -${res.pipeVelocityMarginLossPct.toFixed(2)}%`;
        }
        if (lot554El) {
          lot554El.textContent = isEnDoc ? res.wearRatioImpact554En : res.wearRatioImpact554;
        }
        if (massTotalEl) {
          massTotalEl.textContent = isEnDoc
            ? `${res.totalAssemblyMassKg.toFixed(1)} kg • ${res.nioshHoistPartsCount} NIOSH hoists (≥23 kg)`
            : `${res.totalAssemblyMassKg.toFixed(1)} kg • ${res.nioshHoistPartsCount} izajes NIOSH (≥23 kg)`;
        }
        if (seqStatusEl) {
          seqStatusEl.textContent = res.sequenceValid
            ? (isEnDoc ? 'Sequence 01–05 valid with zero axial collision' : 'Secuencia 01–05 válida sin colisión axial')
            : (isEnDoc ? `BLOCKED (${res.outOfOrderStationId}): ${res.collisionDetailsEn}` : `BLOQUEO (${res.outOfOrderStationId}): ${res.collisionDetailsEs}`);
        }
        if (svgValEl) svgValEl.textContent = `${res.frontClearanceMm.toFixed(2)} mm`;
        if (svgBoxEl) {
          const strokeColor = !res.sequenceValid || res.clearanceStatus === 'RUBBING_RISK'
            ? '#dc2626'
            : (res.clearanceStatus === 'OPTIMAL_CALIBRATION' ? '#15803d' : '#d97706');
          svgBoxEl.setAttribute('stroke', strokeColor);
        }
        if (quoteCta) {
          const base = quoteCta.getAttribute('data-quote-base') || '/cotizar/';
          quoteCta.href = `${base}?circuito=bombeo&equipo=bombeo_hule_cromo&pieza=throatbush&material=${activeMaterialKey}&estacion=S5&claro_mm=${res.frontClearanceMm.toFixed(2)}&seal_branch=${res.sealBranch}&b2_mm=${res.impellerExitWidthMm}#rfq`;
        }
        syncAllAssemblyLinks(res.frontClearanceMm, res.impellerExitWidthMm, res.sealBranch, pipeSeries);

        const prev = loadWorkbenchState() || {};
        saveWorkbenchState({
          ...prev,
          pump_material: activeMaterialKey,
          frontClearanceMm: res.frontClearanceMm,
          claro_mm: res.frontClearanceMm,
          clearance_mm: res.frontClearanceMm,
          seal_branch: res.sealBranch,
          sealBranch: res.sealBranch,
          b2_mm: res.impellerExitWidthMm,
          impellerExitWidthMm: res.impellerExitWidthMm,
          volumetricLossPct: res.volumetricEfficiencyDropPct,
          clearanceStatus: res.clearanceStatus,
          assemblySequencePreset: sequencePreset,
          assemblySequenceValid: res.sequenceValid,
          totalAssemblyMassKg: res.totalAssemblyMassKg,
          nioshHoistPartsCount: res.nioshHoistPartsCount
        });
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selectedBranch = btn.getAttribute('data-assembly-branch-btn') || 'all';
          activeBranch = selectedBranch === 'hule_natural' ? 'rubber' : (selectedBranch === 'ceramica_sic' ? 'ceramica_sic' : 'metal');
          activeMaterialKey = selectedBranch === 'all' ? 'alto_cromo_cr27' : selectedBranch;
          if (selectedBranch === 'ceramica_sic' && slider) {
            slider.value = '0.65';
          }
          buttons.forEach((b) => {
            const active = b === btn;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-selected', active ? 'true' : 'false');
          });

          rows.forEach((row) => {
            const rowBranch = row.getAttribute('data-bom-branch') || 'common';
            const visible = selectedBranch === 'all'
              || rowBranch === 'common'
              || rowBranch === selectedBranch
              || (selectedBranch === 'ceramica_sic' && rowBranch === 'alto_cromo_cr27');
            (row as HTMLElement).style.display = visible ? '' : 'none';
          });

          svgBranches.forEach((g) => {
            const gBranch = g.getAttribute('data-svg-branch');
            const active = selectedBranch === 'all' || gBranch === selectedBranch || (selectedBranch === 'ceramica_sic' && gBranch === 'alto_cromo_cr27');
            (g as HTMLElement).style.opacity = active ? '1' : '0.28';
          });
          updateClearanceSimulation();
        });
      });

      if (slider) slider.addEventListener('input', updateClearanceSimulation);
      if (b2Select) b2Select.addEventListener('change', updateClearanceSimulation);
      if (sealSelect) sealSelect.addEventListener('change', updateClearanceSimulation);
      if (seqSelect) seqSelect.addEventListener('change', updateClearanceSimulation);
      if (xrayToggleBtn && xrayLayer) {
        xrayToggleBtn.addEventListener('click', () => {
          const isPressed = xrayToggleBtn.getAttribute('aria-pressed') === 'true';
          const nextState = !isPressed;
          xrayToggleBtn.setAttribute('aria-pressed', String(nextState));
          xrayToggleBtn.classList.toggle('is-active', nextState);
          xrayLayer.style.display = nextState ? '' : 'none';
          xrayToggleBtn.textContent = isEnDoc
            ? (nextState ? 'Wear X-Ray Layer: ON' : 'Wear X-Ray Layer: OFF')
            : (nextState ? 'Rayos X de Desgaste: ACTIVO' : 'Rayos X de Desgaste: OCULTO');
        });
      }
      updateClearanceSimulation();
    });
  }

  initPumpAssemblyReport();
  document.addEventListener('astro:page-load', initPumpAssemblyReport);
</script>

<style>
  .assembly-report {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2rem 0;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.05);
  }
  .assembly-report__anchor-alias {
    display: block;
    height: 0;
    visibility: hidden;
  }
  .assembly-report__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .assembly-report__eyebrow {
    font-family: var(--smat-font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #0d78c6;
    text-transform: uppercase;
  }
  .assembly-report__title {
    margin: 0.25rem 0;
    font-size: 1.45rem;
    font-weight: 800;
    color: #0f172a;
  }
  .assembly-report__subtitle {
    margin: 0;
    font-size: 0.94rem;
    color: #334155;
    max-width: 78ch;
    line-height: 1.45;
  }
  .assembly-report__controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
