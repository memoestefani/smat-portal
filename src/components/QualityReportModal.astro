---
// src/components/QualityReportModal.astro
// Decisión 1-A: Facsímil Interactivo de Certificado de Calidad y Ensayos de Durango
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<div class="quality-modal-overlay hidden" id="quality-report-modal" role="dialog" aria-modal="true" aria-labelledby="modal-report-title">
  <div class="quality-modal-sheet">
    <div class="quality-modal-header">
      <div class="modal-badge-row">
        <span class="cert-pill">FACSÍMIL OFICIAL • CONTROL DE CALIDAD DURANGO</span>
        <span class="iso-pill">ISO 1940-1 G2.5 • ASTM A532</span>
      </div>
      <button type="button" class="btn-close-modal" id="btn-close-quality-modal" aria-label={isEs ? 'Cerrar ventana' : 'Close modal'}>✕</button>
    </div>

    <div class="facsimile-paper">
      <!-- Encabezado del Certificado -->
      <div class="facsimile-header">
        <div class="facsimile-brand">
          <span class="brand-name">SMAT MINERALS</span>
          <span class="brand-dept">{isEs ? 'DEPARTAMENTO DE CONTROL DE CALIDAD Y ENSAYOS' : 'QUALITY ASSURANCE & TESTING DIVISION'}</span>
          <span class="brand-loc">ALMACÉN CENTRAL DURANGO • DOMICILIO FISCAL: MARIANO SALAS #114, CP 34166</span>
        </div>
        <div class="facsimile-folio-box">
          <span class="folio-label">{isEs ? 'FOLIO ENSAYO' : 'TEST CERTIFICATE'}</span>
          <span class="folio-val">CERT-QA-2026-DGO-0881</span>
          <span class="folio-date">2026-09-24 • TURNO A</span>
        </div>
      </div>

      <div class="facsimile-divider"></div>

      <!-- Datos de la Pieza y Colada -->
      <div class="facsimile-grid-2">
        <div class="facsimile-field">
          <span class="f-label">{isEs ? 'COMPONENTE / PARTIDA:' : 'COMPONENT / PART:'}</span>
          <span class="f-val">{isEs ? 'Impulsor de 5 Álabes 6x4 (Código SMAT-PUMP-6X4-IMP)' : '5-Vane Impeller 6x4 (Code SMAT-PUMP-6X4-IMP)'}</span>
        </div>
        <div class="facsimile-field">
          <span class="f-label">{isEs ? 'LOTE DE COLADA / HEAT NO:' : 'HEAT NUMBER / LOT:'}</span>
          <span class="f-val">HT-2026-A05-7749-MX</span>
        </div>
        <div class="facsimile-field">
          <span class="f-label">{isEs ? 'NORMA METALÚRGICA:' : 'METALLURGICAL SPEC:'}</span>
          <span class="f-val">ASTM A532 Clase III Tipo A (High Chrome 27%)</span>
        </div>
        <div class="facsimile-field">
          <span class="f-label">{isEs ? 'TITULAR / UNIDAD MINERA:' : 'RECIPIENT / MINING UNIT:'}</span>
          <span class="f-val anonymized">{isEs ? '[DATOS DEL CLIENTE ANONIMIZADOS - CONFIDENCIAL]' : '[CLIENT DATA ANONYMIZED - CONFIDENTIAL]'}</span>
        </div>
      </div>

      <!-- Tabla de Composición Química Espectrométrica -->
      <div class="facsimile-section">
        <h4 class="f-section-title">{isEs ? '1. ANÁLISIS QUÍMICO ESPECTROMÉTRICO (ESPECTROMETRÍA DE EMISIÓN ÓPTICA)' : '1. OPTICAL EMISSION SPECTROMETRY CHEMICAL ANALYSIS'}</h4>
        <div class="spectro-table-wrap">
          <table class="spectro-table">
            <thead>
              <tr>
                <th>C %</th>
                <th>Cr %</th>
                <th>Mo %</th>
                <th>Mn %</th>
                <th>Si %</th>
                <th>Ni %</th>
                <th>P %</th>
                <th>S %</th>
                <th>Fe %</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>2.84</td>
                <td>27.15</td>
                <td>0.82</td>
                <td>0.68</td>
                <td>0.52</td>
                <td>0.45</td>
                <td>&lt;0.025</td>
                <td>&lt;0.018</td>
                <td>Bal.</td>
              </tr>
              <tr class="spec-row">
                <td>2.5 - 3.3</td>
                <td>23.0 - 30.0</td>
                <td>0.5 - 1.5</td>
                <td>0.5 - 1.5</td>
                <td>0.3 - 1.0</td>
                <td>&lt; 1.2</td>
                <td>&lt; 0.04</td>
                <td>&lt; 0.03</td>
                <td>Base</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Ensayos Mecánicos y Balanceo Dinámico -->
      <div class="facsimile-section">
        <h4 class="f-section-title">{isEs ? '2. ENSAYOS MECÁNICOS Y PRUEBAS DINÁMICAS EN BANCO DE DURANGO' : '2. MECHANICAL PROPERTIES & SHOP DYNAMIC BALANCING (DURANGO BENCH)'}</h4>
        <div class="test-results-grid">
          <div class="test-result-card">
            <div class="test-card-head">
              <span class="test-name">{isEs ? 'DUREZA BRINELL (HBW)' : 'BRINELL HARDNESS (HBW)'}</span>
              <span class="test-status pass">CONFORME</span>
            </div>
            <div class="test-card-val">658 HBW</div>
            <div class="test-card-desc">{isEs ? 'Requisito norma: ≥650 HBW. Ensayo en 4 puntos de álabe y plato posterior.' : 'Spec: ≥650 HBW. 4-point test across vanes & shroud.'}</div>
          </div>

          <div class="test-result-card">
            <div class="test-card-head">
              <span class="test-name">{isEs ? 'BALANCEO DINÁMICO' : 'DYNAMIC BALANCING'}</span>
              <span class="test-status pass">ISO 1940 G2.5</span>
            </div>
            <div class="test-card-val">1.42 mm/s</div>
            <div class="test-card-desc">{isEs ? 'Banco de balanceo Durango @ 1,200 RPM. Límite máximo permisible: 2.5 mm/s.' : 'Durango test bench @ 1,200 RPM. Allowable limit: 2.5 mm/s.'}</div>
          </div>

          <div class="test-result-card">
            <div class="test-card-head">
              <span class="test-name">{isEs ? 'CONTROL DIMENSIONAL CMM' : 'CMM DIMENSIONAL FIT'}</span>
              <span class="test-status pass">ACOPLE 1:1</span>
            </div>
            <div class="test-card-val">&lt; 0.035 mm</div>
            <div class="test-card-desc">{isEs ? 'Verificación de rosca, concentricidad de eje y holgura de garganta.' : 'Thread verification, shaft concentricity & throat clearance.'}</div>
          </div>
        </div>
      </div>

      <!-- Sello y Dictamen -->
      <div class="facsimile-footer">
        <div class="stamp-box">
          <div class="stamp-circle">
            <span>SMAT MINERALS</span>
            <strong>LIBERADO</strong>
            <small>ALMACÉN DURANGO</small>
          </div>
          <div class="stamp-legend">
            <strong>{isEs ? 'DICTAMEN TÉCNICO: APROBADO PARA SERVICIO PESADO' : 'TECHNICAL DISPOSITION: APPROVED FOR HEAVY DUTY'}</strong>
            <p>{isEs ? 'Componente certificado para pulpas abrasivas de molienda y flotación sin riesgo de fisuración prematura.' : 'Component certified for abrasive slurry milling without premature cracking risk.'}</p>
          </div>
        </div>
        <div class="action-footer-box">
          <a href="/#rfq" class="btn btn-primary" id="btn-modal-quote-trigger">
            {isEs ? 'Generar Folio para Adjuntar a su Requisición' : 'Generate Folio to Attach to Requisition'}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .quality-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(10, 13, 20, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: fadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .quality-modal-sheet {
    background: #ffffff;
    width: 100%;
    max-width: 820px;
    max-height: 90vh;
    border-radius: var(--smat-radius-md);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.7), var(--apple-border-specular, inset 0 1px 0 rgba(255, 255, 255, 0.12));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: scaleIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes scaleIn { from { transform: scale(0.96); opacity: 0; } to { transform: scale(1); opacity: 1; } }

  .quality-modal-header {
    background: #0f172a;
    color: #ffffff;
    padding: 0.85rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--smat-copper-accent);
  }

  .modal-badge-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .cert-pill {
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    color: #fed7aa;
    background: rgba(194, 94, 0, 0.25);
    border: 1px solid #c25e00;
    padding: 0.15rem 0.5rem;
    border-radius: var(--smat-radius-sm);
  }

  .iso-pill {
    font-family: var(--smat-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: #6ee7b7;
    background: rgba(6, 95, 70, 0.4);
    border: 1px solid #10b981;
    padding: 0.15rem 0.5rem;
    border-radius: var(--smat-radius-sm);
  }

  .btn-close-modal {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 1.25rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    transition: color 0.15s;
  }

  .btn-close-modal:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  .facsimile-paper {
    padding: 1.5rem;
    overflow-y: auto;
    background: #ffffff;
    font-family: var(--smat-font-ui);
    color: #1e293b;
  }

  .facsimile-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .brand-name {
    display: block;
    font-family: var(--smat-font-editorial);
    font-size: 1.3rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
  }

  .brand-dept {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    color: #c25e00;
    margin-top: 0.1rem;
  }

  .brand-loc {
    display: block;
    font-size: 0.68rem;
    color: #64748b;
    margin-top: 0.2rem;
    font-family: var(--smat-font-mono);
  }

  .facsimile-folio-box {
    text-align: right;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    padding: 0.4rem 0.75rem;
    border-radius: var(--smat-radius-sm);
  }

  .folio-label {
    display: block;
    font-size: 0.62rem;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.05em;
  }

  .folio-val {
    display: block;
    font-family: var(--smat-font-mono);
    font-size: 0.9rem;
    font-weight: 800;
    color: #0f172a;
  }

  .folio-date {
    display: block;
    font-size: 0.65rem;
    color: #64748b;
    font-family: var(--smat-font-mono);
  }

  .facsimile-divider {
    height: 1px;
    background: #e2e8f0;
    margin: 1rem 0;
  }

  .facsimile-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 640px) {
    .facsimile-grid-2 {
      grid-template-columns: 1fr;
    }
  }

  .facsimile-field .f-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.04em;
  }

  .facsimile-field .f-val {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #0f172a;
  }

  .facsimile-field .anonymized {
    color: #b45309;
    background: #fef3c7;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    display: inline-block;
  }

  .f-section-title {
    font-size: 0.8rem;
    font-weight: 800;
    color: #334155;
    letter-spacing: 0.04em;
    margin: 1rem 0 0.5rem;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 0.25rem;
  }

  .spectro-table-wrap {
    overflow-x: auto;
    border: 1px solid #e2e8f0;
    border-radius: var(--smat-radius-sm);
  }

  .spectro-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.75rem;
    text-align: center;
  }

  .spectro-table th {
    background: #f1f5f9;
    color: #334155;
    font-weight: 800;
    padding: 0.35rem 0.4rem;
    border-bottom: 1px solid #cbd5e1;
    font-family: var(--smat-font-mono);
  }

  .spectro-table td {
    padding: 0.4rem 0.4rem;
    border-bottom: 1px solid #f1f5f9;
    font-family: var(--smat-font-mono);
    font-weight: 600;
    color: #0f172a;
  }

  .spectro-table .spec-row td {
    font-size: 0.68rem;
    color: #64748b;
    background: #fafaf9;
    font-style: italic;
  }

  .test-results-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .test-results-grid {
      grid-template-columns: 1fr;
    }
  }

  .test-result-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: var(--smat-radius-sm);
    padding: 0.75rem;
  }

  .test-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.25rem;
  }

  .test-name {
    font-size: 0.68rem;
    font-weight: 800;
    color: #475569;
  }

  .test-status.pass {
    font-size: 0.62rem;
    font-weight: 800;
    color: #065f46;
    background: #ecfdf5;
    border: 1px solid #10b981;
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
  }

  .test-card-val {
    font-family: var(--smat-font-mono);
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0.2rem 0;
  }

  .test-card-desc {
    font-size: 0.68rem;
    color: #64748b;
    line-height: 1.3;
  }

  .facsimile-footer {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px dashed #cbd5e1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stamp-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stamp-circle {
    width: 68px;
    height: 68px;
    border: 2px dashed #059669;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #059669;
    text-align: center;
    line-height: 1.1;
    transform: rotate(-8deg);
  }

  .stamp-circle span { font-size: 0.5rem; font-weight: 800; }
  .stamp-circle strong { font-size: 0.75rem; font-weight: 900; }
  .stamp-circle small { font-size: 0.45rem; font-weight: 700; }

  .stamp-legend strong {
    display: block;
    font-size: 0.75rem;
    color: #065f46;
  }

  .stamp-legend p {
    font-size: 0.7rem;
    color: #64748b;
    margin: 0;
  }

  .hidden { display: none !important; }
</style>

<script is:inline>
  (function() {
    var modal = document.getElementById('quality-report-modal');
    var btnClose = document.getElementById('btn-close-quality-modal');
    var openButtons = document.querySelectorAll('.btn-open-quality-facsimile');

    function openModal() {
      if (modal) modal.classList.remove('hidden');
    }

    function closeModal() {
      if (modal) modal.classList.add('hidden');
    }

    openButtons.forEach(function(btn) {
      btn.addEventListener('click', openModal);
    });

    if (btnClose) {
      btnClose.addEventListener('click', closeModal);
    }

    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  })();
</script>
