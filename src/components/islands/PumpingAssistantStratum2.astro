---

<div id="bombeo-asistente" data-pumping-stratum2 data-lang={locale}>
  <section class="section smat-bombeo-stratum2" aria-label={isEs ? 'Asistente de selección hidráulica y despiece' : 'Hydraulic selection and wet-end assistant'}>
    <div class="container">
      <div class="smat-mb-sm">
        <h2 class="smat-section-title">
          {isEs ? 'Asistente de Selección Hidráulica y Lotes 5-5-4' : 'Hydraulic Selection & 5-5-4 Lot Assistant'}
        </h2>
      </div>

      <details class="wb-progressive-drawer smat-sim-accordion" id="bombeo-calculator-accordion">
        <summary class="wb-progressive-summary">
          <span>
            {isEs
              ? 'Validar tu selección con calculadora técnica (Hidráulica, Aleación, Sello y 5-5-4)'
              : 'Validate your selection with technical calculator (Hydraulics, Alloy, Seal & 5-5-4)'}
          </span>
          <span>▾</span>
        </summary>
        <div class="smat-mt-sm">
          <div class="smat-station-tabs" id="bombeo-station-tabs" role="tablist" aria-label={isEs ? 'Consolas de Bombeo de Lodos' : 'Slurry Pump Consoles'}>
            <button type="button" role="tab" aria-selected="true" class="smat-station-tab-btn is-active" data-station-tab="hydraulics">
              {isEs ? '1. Hidráulica y Altitud' : '1. Hydraulics & Head'}
            </button>
            <button type="button" role="tab" aria-selected="false" class="smat-station-tab-btn" data-station-tab="tribology">
              {isEs ? '2. Impulsor y Revestimientos' : '2. Impeller & Liners'}
            </button>
            <button type="button" role="tab" aria-selected="false" class="smat-station-tab-btn" data-station-tab="seals">
              {isEs ? '3. Sellado, Transmisión y Soporte' : '3. Seal, Drive & Bearings'}
            </button>
            <button type="button" role="tab" aria-selected="false" class="smat-station-tab-btn" data-station-tab="assembly">
              {isEs ? '4. Armado Integral 5-5-4' : '4. Full 5-5-4 Assembly'}
            </button>
          </div>

          <div class="card smat-bombeo-sim-card smat-station-panel" id="pumping-hydraulics-stratum1" data-station-panel="hydraulics" data-stratum-1-instrument>
            <div class="smat-bombeo-sim-header">
              <span class="badge badge-copper">
                {isEs ? 'CALCULADORA DE PULPA Y ALTITUD' : 'SLURRY HYDRAULICS & ALTITUDE CALCULATOR'}
              </span>
              <h3>
                {isEs
                  ? 'Verificador de Transporte Hidráulico y Altitud'
                  : 'Slurry Hydraulic Transport & Altitude Verifier'}
              </h3>
            </div>

            <PumpingHydraulicsCore
              locale={locale}
              showPipeAndSymptom={true}
              showTcoBlock={false}
              panelClass="pumping-core-standalone"
            />

            <div class="smat-bombeo-sim-actions">
              <a id="pumping-island-quote-cta" href={`${quoteBase}?circuito=bombeo#rfq`} class="btn btn-primary">
                {isEs ? 'Cotizar con esta Calibración Hidráulica →' : 'Quote With This Hydraulic Calibration →'}
              </a>
              <button type="button" class="btn btn-outline smat-tap-btn" data-add-calculated-kit="bombeo">
                {isEs ? '+ Agregar kit calculado a cotización' : '+ Add calculated kit to quote'}
              </button>
            </div>
          </div>

          <div class="card smat-bombeo-sim-card smat-station-panel" id="pumping-tribology-station" data-station-panel="tribology" hidden>
            <TribologyAlloyCore
              locale={locale}
              variant="impeller"
              showVerticalActions={true}
              panelClass="trib-core-standalone"
            />
          </div>

          <div class="card smat-bombeo-sim-card smat-station-panel" id="pumping-seals-station" data-station-panel="seals" hidden>
            <SealDriveBearingCore
              locale={locale}
              initialTab="seal"
              showVerticalActions={true}
            />
          </div>

          <div class="card smat-bombeo-sim-card smat-station-panel" id="pumping-assembly-station" data-station-panel="assembly" hidden>
            <PumpAssemblyReport lang={locale} />
          </div>
        </div>
      </details>

      {showVerticalShell && (
        <details class="bombeo-circuit-drawer smat-mt-sm" id="bombeo-catalog-disclosure">
          <summary class="bombeo-circuit-drawer__summary">
            <span>
              {isEs
                ? 'Planos CAD, Kits 5-5-4 por Material y Fichas Part Number (13 piezas)'
                : 'Slurry Pump CAD, 5-5-4 Material Kits & Universal Part Sheets (13 parts)'}
            </span>
            <span class="bombeo-circuit-drawer__badge">
              {isEs ? 'VER PLANOS Y DESPIECE ▾' : 'VIEW CAD & PARTS LIST ▾'}
            </span>
          </summary>
          <div class="bombeo-circuit-drawer__body">
            <TechnicalDiagrams diagram="pump" lang={locale} />
            <div class="bombeo-catalog-tabs" id="bombeo-catalog-tabs" data-canonical-single-console="true">
              <div class="bombeo-tabs-header">
                <div>
                  <span class="section-eyebrow">
                    {isEs ? 'CATÁLOGO DE BOMBEO Y PARTES HÚMEDAS' : 'PUMPING & WET-END WEAR SPARES CATALOG'}
                  </span>
                  <h2 class="smat-bombeo-console-heading">
                    {isEs ? 'Selección de bomba, partes húmedas y armado' : 'Slurry pump, wet-end lots & assembly'}
                  </h2>
                </div>
                <div class="bombeo-tab-switcher" role="tablist" aria-label={isEs ? 'Selector de Kits y Fichas' : 'Material Kits & Sheets Selector'}>
                  <button type="button" role="tab" aria-selected="true" class="bombeo-tab-btn is-active" data-bombeo-tab="kits">
                    {isEs ? '1. Kits por Material (5)' : '1. Kits by Material (5)'}
                  </button>
                  <button type="button" role="tab" aria-selected="false" class="bombeo-tab-btn" data-bombeo-tab="systems">
                    {isEs ? '2. Subconjuntos y Bombas (5)' : '2. Sub-Assemblies & Pumps (5)'}
                  </button>
                  <button type="button" role="tab" aria-selected="false" class="bombeo-tab-btn" data-bombeo-tab="atomic">
                    {isEs ? '3. Fichas Part Number Universal (13)' : '3. Universal Part Number Sheets (13)'}
                  </button>
                </div>
              </div>

              <div class="bombeo-tab-panel is-active material-kits-showcase" id={isEs ? 'lotes-por-material' : 'kits-by-material'} data-bombeo-panel="kits">
                <span id={isEs ? 'kits-by-material' : 'lotes-por-material'} aria-hidden="true"></span>
                <p class="smat-bombeo-panel-lead">
                  {isEs
                    ? 'Compare la geometría física de cada lote húmedo: voluta monolítica en Alto Cromo Cr27% o compuesto Cerámico SiC frente a revestimientos divididos (FPL + CPL) en Hule Natural o Poliuretano.'
                    : 'Compare the physical geometry of each wet-end kit: monolithic High Chrome Cr27% or SiC Ceramic volute vs. split two-half liners (FPL + CPL) in Natural Rubber or Polyurethane.'}
                </p>
                <TechnicalDiagrams diagram="material_kit_grid" lang={locale} />
                <div class="grid-3-atomic smat-bombeo-grid-gap">
                  {kits.map((kit) => (
                    <article class="card atomic-silo-card" data-hybrid-branch-d-card={kit.isHybrid ? 'true' : undefined}>
                      <span class="badge badge-copper smat-bombeo-card-badge">{isEs ? kit.badgeEs : kit.badgeEn}</span>
                      <strong class="smat-bombeo-card-title">{isEs ? kit.titleEs : kit.titleEn}</strong>
                      <p class="smat-bombeo-card-copy">
                        <strong>{isEs ? 'Incluye:' : 'Kit parts:'}</strong> {isEs ? kit.partsEs : kit.partsEn}<br />
                        <strong>{isEs ? 'Operación:' : 'Duty:'}</strong> {isEs ? kit.envEs : kit.envEn}
                      </p>
                      <div class="smat-bombeo-card-actions">
                        <a href={kit.href} class="btn btn-primary smat-bombeo-cta-flex">{isEs ? kit.ctaEs : kit.ctaEn}</a>
                        <button
                          type="button"
                          class="btn btn-outline btn-avenue-tray smat-bombeo-tray-btn"
                          data-add-tray-sku={kit.sku}
                          data-tray-part-code={kit.code}
                          data-tray-title={isEs ? kit.trayTitleEs : kit.trayTitleEn}
                          data-tray-series="5-5-4"
                          data-tray-material={kit.material}
                          data-tray-circuit="bombeo"
                          data-tray-source="bombeo_tab1_kit"
                        >
                          {isEs ? '+ Cotización' : '+ Quote'}
                        </button>
                      </div>
                    </article>
                  ))}
                </div>
              </div>

              <div class="bombeo-tab-panel" data-bombeo-panel="systems">
                <div class="grid-2 smat-bombeo-grid-gap">
                  {systems.map((sys) => (
                    <div class="card">
                      <strong class="smat-bombeo-card-title">{isEs ? sys.titleEs : sys.titleEn}</strong>
                      <p>{isEs ? sys.descEs : sys.descEn}</p>
                      <p class="smat-bombeo-sys-meta">
                        <strong>{isEs ? sys.metaLabelEs : sys.metaLabelEn}</strong> {isEs ? sys.metaEs : sys.metaEn}
                      </p>
                      <div class="smat-bombeo-sys-actions">
                        <a href={sys.specHref} class="btn btn-outline">{isEs ? sys.specCtaEs : sys.specCtaEn}</a>
                        <a href={sys.quoteHref} class="btn btn-primary">{isEs ? 'Cotizar →' : 'Quote →'}</a>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <div class="bombeo-tab-panel atomic-silo-block" data-bombeo-panel="atomic">
                <h3 class="smat-bombeo-atomic-heading">
                  {isEs ? 'Fichas de Part Number Universal (Contacto Húmedo y Sellado)' : 'Universal Part Number Spare Parts Sheets (Wet-End & Sealing)'}
                </h3>
                <p class="smat-bombeo-atomic-lead">
                  {isEs
                    ? 'Especificaciones metalúrgicas individuales para impulsores cerrados, platos de succión y anillos expulsores con peso verificado (umbral de izaje con polipasto ≥23 kg) en Almacén Central Durango.'
                    : 'Individual metallurgical specs for closed impellers, throatbushes, and expeller rings with verified mass (≥23 kg hoist handling threshold) at Durango Central Warehouse.'}
                </p>
                <div class="grid-3-atomic">
                  {atomicParts.map((part) => {
                    const specs = getAtomicPartSpecs(part.part_number);
                    const niosh = formatNioshErgonomicStatus(specs, locale);
                    const quoteHref = buildWizardUrl({
                      lang: locale,
                      circuit: 'bombeo',
                      role: specs.role,
                      code: part.part_number,
                      series: specs.series || '6x4',
                      station: specs.station_code,
                      material: part.part_number === 'DAM005' ? undefined : 'alto_cromo_cr27',
                      weightKg: specs.weight_kg,
                      arrangement: 'CV',
                    });
                    const partCatalogHref = isEs ? `/catalogo/${part.code}/` : `/en/catalog/${part.code}/`;
                    return (
                      <div class="card atomic-silo-card" data-atomic-code={part.part_number} data-niosh-tier={niosh.tier} data-niosh-tone={niosh.cssTone}>
                        <div class="smat-bombeo-atomic-head">
                          <span class="badge badge-copper">{part.part_number}</span>
                          <span class="smat-bombeo-atomic-frame">
                            {isEs ? `Serie ${part.frame}` : `Series ${part.frame}`} • {specs.station_number}
                          </span>
                        </div>
                        <strong class="smat-bombeo-card-title">{isEs ? part.name_es : part.name_en}</strong>
                        <p class="smat-bombeo-atomic-sub">{isEs ? part.type_es : part.type_en} • {part.hardness}</p>
                        <div class="atomic-niosh-meta smat-bombeo-niosh-box">
                          <strong>{isEs ? `Masa: ${specs.weight_kg} kg` : `Mass: ${specs.weight_kg} kg`}</strong> • {isEs ? niosh.badgeEs : niosh.badgeEn}
                        </div>
                        <div class="smat-bombeo-card-actions">
                          <a href={partCatalogHref} class="btn btn-outline smat-bombeo-mini-btn">
                            {isEs ? `Ver Ficha ${part.part_number}` : `View Sheet ${part.part_number}`}
                          </a>
                          <button
                            type="button"
                            class="btn btn-outline btn-avenue-tray smat-bombeo-mini-tray"
                            data-add-tray-sku={part.part_number === 'DAM005' ? 'SMAT-PUMP-BRG-005M' : `SMAT-PUMP-${part.part_number}`}
                            data-tray-part-code={part.part_number}
                            data-tray-title={isEs ? part.name_es : part.name_en}
                            data-tray-series={part.frame}
                            data-tray-material={part.part_number === 'DAM005' ? 'GGG40' : 'A05'}
                            data-tray-circuit="bombeo"
                            data-tray-source="bombeo_atomic_sheet"
                          >
                            {isEs ? '+ Cotización' : '+ Quote'}
                          </button>
                          <a href={quoteHref} class="btn btn-primary smat-bombeo-mini-btn">{isEs ? 'Cotizar →' : 'Quote →'}</a>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>

            <SharePurchasing
              roleTitle={isEs ? 'Bombas para Lodos y Lote de Refacciones Húmedas (5-5-4)' : 'Slurry Pumps & Wet-End Spare Parts Lot (5-5-4)'}
              specs={isEs
                ? 'Lote balanceado de 5 Impulsores + 5 Platos de Succión + 4 Volutas y Cartucho de Rodamientos'
                : 'Balanced lot of 5 Impellers + 5 Throatbushes + 4 Volute Liners and Bearing Assembly / Housing'}
              metallurgy={isEs
                ? 'Alto Cromo 27% A05 (≥650 HB), Hule Natural Antiabrasivo y Poliuretano'
                : 'High Chrome 27% A05 (≥650 HB), Abrasion-Resistant Natural Rubber, and Polyurethane'}
              series={isEs ? '1.5x1 a 14x12' : '1.5x1 to 14x12'}
              roleId="kit_wet_end"
              circuit="bombeo"
              lang={locale}
            />
          </div>
        </details>
      )}
    </div>
  </section>

  {showVerticalShell && (
    <section class="tco-matrix-section" aria-label={isEs ? 'Abastecimiento por Lote Húmedo' : 'Wet-End Lot Procurement'}>
      <div class="container">
        <div class="tco-matrix-header">
          <span class="section-eyebrow">{isEs ? 'PLANEACIÓN DE MANTENIMIENTO EN PLANTA' : 'PLANT MAINTENANCE PLANNING'}</span>
          <h2>{isEs ? 'Compra por Lote Húmedo vs. Pieza Suelta de Emergencia' : 'Wet-End Lot Procurement vs. Single-Piece Purchasing'}</h2>
          <p>
            {isEs
              ? <>Para bombas centrífugas de lodos, las plantas concentradoras programan lotes balanceados acoplados a su tasa real de desgaste (por ejemplo: <strong>5 impulsores, 5 platos de succión y 4 volutas</strong>) junto con un <strong>Cartucho de Rodamientos</strong> de respaldo.</>
              : <>For slurry pumps, concentrator plants order balanced wet-end lots matched to component wear rates (for example: <strong>5 impellers, 5 throatbushes, and 4 volute liners</strong>) alongside a complete spare <strong>Bearing Assembly / Housing</strong>.</>}
          </p>
        </div>

        <div class="tco-table-wrapper">
          <table class="tco-comparison-matrix">
            <thead>
              <tr>
                <th>{isEs ? 'Métrica Operativa' : 'Operational Metric'}</th>
                <th>{isEs ? 'Importación OEM Extranjera' : 'Overseas OEM Import'}</th>
                <th>{isEs ? 'Compra Reactiva Pieza Suelta' : 'Reactive Single-Part Buying'}</th>
                <th class="col-smat-highlight">{isEs ? 'Suministro SMAT por Lote Húmedo' : 'SMAT Wet-End Lot Supply'}</th>
              </tr>
            </thead>
            <tbody>
              {tcoRows.map((row) => (
                <tr>
                  <td><strong>{isEs ? row.metricEs : row.metricEn}</strong></td>
                  <td>{isEs ? row.oemEs : row.oemEn}</td>
                  <td>{isEs ? row.reactiveEs : row.reactiveEn}</td>
                  <td class="col-smat-val">{isEs ? row.smatEs : row.smatEn}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}
</div>

