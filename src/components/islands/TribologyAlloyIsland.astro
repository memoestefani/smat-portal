---
// src/components/islands/TribologyAlloyIsland.astro — Isla Canónica Única de Tribología y Lotes Húmedos (SLICE-V50-28..29)
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import SharePurchasing from '../SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../scripts/workbenchBus.js';
import { WET_END_MATERIAL_MATRIX } from '../../scripts/slurryEngine.js';
import rolesData from '../../../data/roles.json';

interface Props {
  locale?: 'es' | 'en';
  variant?: 'impeller' | 'liners';
  mode?: 'standalone' | 'embedded';
}

const { locale = 'es', variant = 'impeller', mode = 'standalone' } = Astro.props;
const isEs = locale === 'es';
const isLiners = variant === 'liners';
const isStandalone = mode === 'standalone';
const quoteBase = isEs ? '/cotizar/' : '/en/quote/';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const roleObj = allRoles.find((r) => r.role_id === (isLiners ? 'revestimientos' : 'impulsor'));
const dc = roleObj?.decision_criteria;

const impellerParts = isLiners
  ? []
  : [getAtomicPartSpecs('D3147'), getAtomicPartSpecs('E4147'), getAtomicPartSpecs('F6147')].filter(Boolean);
const throatbushPart = isLiners ? getAtomicPartSpecs('E4083') : null;

const wetMaterials = [
  WET_END_MATERIAL_MATRIX.alto_cromo_cr27,
  WET_END_MATERIAL_MATRIX.hule_natural,
  WET_END_MATERIAL_MATRIX.poliuretano,
  WET_END_MATERIAL_MATRIX.ceramica_sic,
  (WET_END_MATERIAL_MATRIX as any).hybrid_a05_r55,
].filter(Boolean);

const simId = isLiners ? 'stratum1-liners-sim' : 'stratum1-impeller-sim';
const testId = isLiners ? 'liners-material-matrix' : 'impeller-material-matrix';
const defaultD80 = isLiners ? '250' : '450';
const defaultU2 = isLiners ? '21.5' : '22.5';
---

{isStandalone && (
  <div data-island-standalone="tribology" data-tribology-variant={variant} data-lang={locale}>
    <section class="page-hero smat-compact-hero">
      <div class="container">
        <a href={isEs ? '/bombeo/' : '/en/pumping/'} class="back-link">
          {isEs ? '← Volver a Bombas para Lodos' : '← Back to Slurry Pumps'}
        </a>
        <div class="smat-trib-badge-wrap">
          <span class="badge badge-copper">
            {isLiners
              ? (isEs ? 'PIEZAS EN CONTACTO HÚMEDO · LOTE 5-5-4' : 'WET-END WEAR PARTS · 5-5-4 LOT')
              : (isEs ? 'ESTACIÓN 03 · PIEZA EN CONTACTO HÚMEDO' : 'STATION 03 · WET-END WEAR PART')}
          </span>
        </div>
        <h1>
          {isLiners
            ? (isEs ? 'Revestimientos, Volutas y Cuellos' : 'Volute Liners, Throatbushes & Liners')
            : (isEs ? 'Impulsor para Bomba de Lodos' : 'Slurry Pump Impeller')}
        </h1>
        <p class="smat-hero-sub">
          {isLiners
            ? (isEs
              ? 'Calibración tribológica en vivo de lotes húmedos en Alto Cromo A05, Hule R55, Poliuretano U01, SiC y Rama D Híbrida.'
              : 'Live tribological calibration for wet-end lots across 27% High Chrome A05, Natural Rubber R55, Polyurethane U01, SiC, and Hybrid Branch D.')
            : (isEs
              ? 'Calibración tribológica en vivo de álabes, velocidad periférica u₂ y selección en A05 / R55 / U01 / SiC / Híbrido Rama D.'
              : 'Live tribological calibration of impeller vane geometry, tip speed u₂, and selection across A05 / R55 / U01 / SiC / Hybrid Branch D.')}
        </p>
      </div>
    </section>

    <section class="section smat-stage-compact">
      <div class="container">
        <div id={simId} data-testid={testId} data-stratum-1-instrument>
          <div class="card smat-trib-sim-card">
            <span class="badge badge-copper">
              {isLiners
                ? (isEs ? 'SIMULADOR EN VIVO · CARCASA MONOLÍTICA VS BIPARTIDA & RAMA D HÍBRIDA' : 'LIVE SIMULATOR · MONOLITHIC VS SPLIT CASING & HYBRID BRANCH D')
                : (isEs ? 'SIMULADOR TRIBOLÓGICO EN VIVO · FINNIE-HUTCHINGS & TENACIDAD K_Ic' : 'LIVE TRIBOLOGY SIMULATOR · FINNIE-HUTCHINGS & K_Ic TOUGHNESS')}
            </span>
            <h2 class="smat-trib-sim-title">
              {isLiners
                ? (isEs ? 'Evaluador de Forros FPL/CPL, Voluta Monolítica, Claro Axial δ y Partición Angular Finnie-Hutchings' : 'FPL/CPL Split Liners, Monolithic Volute, Axial Clearance δ & Finnie-Hutchings Verifier')
                : (isEs ? 'Verificador de Velocidad Periférica u₂, Desconchamiento (Spalling SiC), Claro δ y Masa NIOSH' : 'Tip Speed u₂, Brittle Spalling (SiC), Clearance δ & NIOSH Rigging Verifier')}
            </h2>

            <div class="smat-stratum1-display">
              <div id="trib-status-out" class="smat-trib-status-box">
                {isLiners
                  ? (isEs
                    ? 'Tenacidad OK · Serie 6x4 · Partición Angular Finnie-Hutchings: Impulsor Cerrado Alto Cromo (A05) + Forros Bipartidos FPL/CPL en Hule Natural R55.'
                    : 'Toughness OK · Series 6x4 · Finnie-Hutchings Angular Partition: 27% High Chrome Closed Impeller (A05) + Split R55 Natural Rubber Liners (FPL/CPL).')
                  : (isEs
                    ? 'Tenacidad OK · Serie 6x4 · Sin riesgo de desconchamiento frágil (Spalling) en régimen cinemático actual.'
                    : 'Toughness OK · Series 6x4 · No brittle spalling risk under current kinematic regime.')}
              </div>
              <div class="smat-trib-kpi-grid">
                <div class="smat-trib-kpi-card">
                  <strong>{isLiners ? (isEs ? 'Configuración Activa:' : 'Active Configuration:') : (isEs ? 'Material Recomendado:' : 'Recommended Material:')}</strong>{' '}
                  <span id="trib-mat-out">
                    {isLiners
                      ? (isEs ? 'Rama D Híbrida: Impulsor A05 + Forros R55' : 'Hybrid Branch D: A05 Impeller + R55 Liners')
                      : (isEs ? 'Alto Cromo 27% (A05)' : '27% High Chrome (A05)')}
                  </span>
                </div>
                <div class="smat-trib-kpi-card">
                  <strong>{isEs ? 'Tenacidad K_Ic:' : 'Toughness K_Ic:'}</strong>{' '}
                  <span id="trib-kic-out">18.5 MPa·√m</span>
                </div>
                <div class="smat-trib-kpi-card">
                  <strong>{isEs ? 'Masa e Izaje NIOSH:' : 'NIOSH Mass & Rigging:'}</strong>{' '}
                  <span id="trib-arch-out">{isLiners ? '418 kg · 5 NIOSH ≥ 23 kg' : '492 kg · 6 NIOSH ≥ 23 kg'}</span>
                </div>
                <div class="smat-trib-kpi-card">
                  <strong>{isEs ? 'Pérdida Volumétrica Δην:' : 'Volumetric Loss Δην:'}</strong>{' '}
                  <span id="trib-vol-loss-out">-1.6%</span>
                </div>
                <div class="smat-trib-kpi-card">
                  <strong>{isEs ? 'Margen Tubería:' : 'Pipe Margin Loss:'}</strong>{' '}
                  <span id="trib-pipe-loss-out">-1.2%</span>
                </div>
              </div>
            </div>

            <div class="smat-inputs-2col smat-trib-inputs-box">
              <label class="smat-trib-field">
                <span>{isEs ? 'Granulometría d₈₀ (µm):' : 'Particle Size d₈₀ (µm):'}</span>
                <input type="number" id="trib-d80-um" min="20" max="6000" step="25" value={defaultD80} class="smat-trib-ctrl" />
              </label>
              <label class="smat-trib-field">
                <span>{isEs ? 'Velocidad Punta u₂ (m/s):' : 'Tip Speed u₂ (m/s):'}</span>
                <input type="number" id="trib-u2-ms" min="10" max="36" step="0.5" value={defaultU2} class="smat-trib-ctrl" />
              </label>
              <label class="smat-trib-field">
                <span>{isEs ? 'pH de Pulpa:' : 'Slurry pH:'}</span>
                <input type="number" id="trib-ph" min="1.0" max="13.5" step="0.5" value="7.5" class="smat-trib-ctrl" />
              </label>
              <label class="smat-trib-field">
                <span>{isEs ? 'Claro Axial Frontal δ (mm):' : 'Front Axial Clearance δ (mm):'}</span>
                <input type="number" id="trib-clearance-mm" min="0.2" max="6.0" step="0.1" value="0.75" class="smat-trib-ctrl" />
              </label>
              <label class="smat-trib-field">
                <span>{isLiners ? (isEs ? 'Arquitectura Lote 5-5-4:' : '5-5-4 Lot Architecture:') : (isEs ? 'Rama de Material:' : 'Material Branch:')}</span>
                <select id="trib-mat-select" class="smat-trib-ctrl">
                  <option value="hybrid_a05_r55" selected={isLiners}>
                    {isEs ? 'Rama D Híbrida (Impulsor A05 + Forros R55)' : 'Hybrid Branch D (A05 Impeller + R55 Liners)'}
                  </option>
                  <option value="auto" selected={!isLiners}>Auto (Finnie-Hutchings)</option>
                  <option value="alto_cromo_cr27">{isEs ? 'Alto Cromo 27% Cr (A05)' : '27% High Chrome (A05)'}</option>
                  <option value="hule_natural">{isEs ? 'Hule Natural (R55)' : 'Natural Rubber (R55)'}</option>
                  <option value="poliuretano">{isEs ? 'Poliuretano (U01)' : 'Polyurethane (U01)'}</option>
                  <option value="ceramica_sic">{isEs ? 'Cerámica SiC' : 'SiC Ceramic'}</option>
                </select>
              </label>
              <label class="smat-trib-field">
                <span>{isEs ? 'Serie de Bomba:' : 'Pump Series:'}</span>
                <select id="trib-series" class="smat-trib-ctrl">
                  <option value="3x2">3x2 / 4x3</option>
                  <option value="6x4" selected>6x4</option>
                  <option value="8x6">8x6 / 10x8</option>
                </select>
              </label>
            </div>

            <div class="smat-trib-actions">
              <a
                href={isLiners
                  ? `${quoteBase}?circuito=bombeo&equipo=kit_wet_end&pieza=voluta_liners&estacion=S3#rfq`
                  : `${quoteBase}?circuito=bombeo&equipo=solo_impulsor&pieza=impulsor_5_alabes&estacion=S3#rfq`}
                class="btn btn-primary smat-trib-btn-tall"
              >
                {isLiners
                  ? (isEs ? 'Cotizar Lote Húmedo Calibrado →' : 'Quote Calibrated Wet-End Lot →')
                  : (isEs ? 'Cotizar Impulsor Calibrado →' : 'Quote Calibrated Impeller →')}
              </a>
              <button
                type="button"
                class="btn btn-outline btn-avenue-tray smat-trib-btn-tall"
                data-vertical-tray-btn
                data-add-tray-sku={isLiners ? 'SMAT-PUMP-TB-083' : 'SMAT-PUMP-IMP-147'}
                data-tray-part-code={isLiners ? 'E4083' : '147/083'}
                data-tray-title={isLiners
                  ? (isEs ? 'Lote Revestimientos + Throatbush 5-5-4' : 'Calibrated Wet-End Lot & Throatbush 5-5-4')
                  : (isEs ? 'Impulsor 5 Álabes Calibrado' : 'Calibrated 5-Vane Impeller')}
                data-tray-series="6x4"
                data-tray-material={isLiners ? 'hybrid_a05_r55' : 'alto_cromo_cr27'}
                data-tray-circuit="bombeo"
                data-tray-source={isLiners ? 'liners_stratum1_calc' : 'impeller_stratum1_calc'}
              >
                {isEs ? '+ Sumar SKU Calibrado a Bandeja' : '+ Add Calibrated SKU to Tray'}
              </button>
            </div>
          </div>

          <h3 class="smat-trib-mat-heading">
            {isLiners
              ? (isEs
                ? 'Matriz de Materiales Húmedos (A05 / R55 / U01 / Cerámica SiC / Rama D Híbrida) y Ley de Gülich Δη_v = k_r·(δ/b₂)^1.5'
                : 'Wet-End Material Matrix (A05 / R55 / U01 / SiC Ceramic / Hybrid Branch D) & Gülich Law Δη_v = k_r·(δ/b₂)^1.5')
              : (isEs
                ? 'Selección Tribológica por Material Húmedo (5 Ramas Certificadas)'
                : 'Tribological Wet-End Material Selection (5 Certified Branches)')}
          </h3>
          <div class="smat-trib-mat-grid">
            {wetMaterials.map((mat) => (
              <div class="card smat-trib-mat-card">
                <span class="font-mono-tech smat-trib-mat-code">[{mat.code}] {mat.hardness}</span>
                <strong class="smat-trib-card-title">{isEs ? mat.nameEs : mat.nameEn}</strong>
                {isLiners && <p class="smat-trib-mat-duty">{isEs ? mat.dutyApplicationEs : mat.dutyApplicationEn}</p>}
                <div class="font-mono-tech smat-trib-mat-specs">
                  u₂ ≤ {mat.maxTipSpeedMs} m/s • K_Ic = {mat.fractureToughnessMpaSqrtM} MPa·√m
                  {isLiners
                    ? <> • {isEs ? `Claro δ = ${mat.recommendedClearanceMm} mm • Lote ${mat.wearRatio554}` : `Clearance δ = ${mat.recommendedClearanceMm} mm • Lot ${mat.wearRatio554}`}</>
                    : <> • d₈₀: {mat.d80RangeMicrons[0]}–{mat.d80RangeMicrons[1]} µm • pH {mat.phRange[0]}–{mat.phRange[1]}</>}
                </div>
                <a
                  href={isLiners
                    ? `${quoteBase}?circuito=bombeo&equipo=kit_wet_end&material=${mat.key}&claro_mm=${mat.recommendedClearanceMm}&estacion=S3#rfq`
                    : `${quoteBase}?circuito=bombeo&equipo=solo_impulsor&material=${mat.key}&estacion=S3#rfq`}
                  data-card-fixed-params="material"
                  class={isLiners ? 'btn btn-primary smat-trib-card-btn' : 'btn btn-outline smat-trib-card-btn'}
                >
                  {isLiners
                    ? (isEs ? `Cotizar Kit en ${mat.code} →` : `Quote ${mat.code} Kit →`)
                    : (isEs ? `Configurar en ${mat.code} →` : `Configure in ${mat.code} →`)}
                </a>
              </div>
            ))}
          </div>
        </div>

        <div class="smat-trib-diagram-gap">
          <TechnicalDiagrams diagram={isLiners ? 'liners' : 'impeller'} lang={locale} />
        </div>

        <div class="grid-2 smat-trib-two-col">
          <div>
            <h2>
              {isLiners
                ? (isEs ? 'Compra por Lote de Contacto Húmedo' : 'Wet-End Lot Ordering')
                : (isEs ? 'Características del Impulsor' : 'Impeller Characteristics')}
            </h2>
            <p>
              {isLiners
                ? (isEs
                  ? 'En la operación minera, las piezas que están en contacto húmedo no se compran de una por una. Para mantener la bomba trabajando en su punto de eficiencia y evitar paros por faltantes en almacén, se adquieren en lotes balanceados de acuerdo con la rotación de cada componente (por ejemplo: 5 impulsores, 5 cuellos y 4 volutas).'
                  : 'In mining operations, wet-end contact parts are not purchased one by one. To keep pumps running at peak hydraulic efficiency and prevent unplanned stockouts, plants order balanced wet-end lots matched to component wear rates (for example: 5 impellers, 5 throatbushes, and 4 volute liners).')
                : (isEs
                  ? 'El impulsor transfiere la energía centrífuga a la pulpa mineral y recibe el mayor impacto cinético de los sólidos en suspensión. Su geometría incorpora álabes expulsores frontales y traseros que reducen la recirculación hacia el cuello y disminuyen la presión sobre el prensaestopa.'
                  : 'The impeller transfers centrifugal energy to the mineral slurry and absorbs the highest kinetic impact from suspended solids. Its geometry features front and rear pump-out vanes that reduce internal recirculation against the throatbush and lower pressure at the stuffing box.')}
            </p>

            <h3 class="smat-trib-table-heading">
              {isLiners
                ? (isEs ? 'Materiales y Componentes Disponibles' : 'Available Materials & Components')
                : (isEs ? 'Especificaciones del Impulsor' : 'Impeller Specifications')}
            </h3>
            <div class="table-wrapper">
              <table>
                {isLiners ? (
                  <tbody>
                    <tr>
                      <th>{isEs ? 'Materiales de Revestimiento' : 'Liner Materials'}</th>
                      <td><strong>{isEs ? 'Alto Cromo 27% (A05), Hule Natural (R55), Poliuretano (U01) y Carburo de Silicio Sinterizado (SiC ≥ 2200 HV)' : '27% High Chrome (A05), Natural Rubber (R55), Polyurethane (U01), and Sintered Silicon Carbide (SiC ≥ 2200 HV)'}</strong></td>
                    </tr>
                    <tr>
                      <th>{isEs ? 'Piezas en Contacto Húmedo' : 'Wet-End Components'}</th>
                      <td>{isEs ? 'Voluta, Cuello (Throatbush), Plato Posterior (Frame Plate Liner Insert) e Impulsor' : 'Volute Liner, Throatbush, Frame Plate Liner Insert, and Impeller'}</td>
                    </tr>
                    <tr>
                      <th>{isEs ? 'Alto Cromo' : 'High Chrome'}</th>
                      <td>{isEs ? 'Fundición blanca al alto cromo (≥ 650 HB) para descarga de molinos y partículas gruesas con bordes cortantes' : 'High-chrome white iron casting (≥ 650 HB) for mill discharge and coarse, sharp-edged particles'}</td>
                    </tr>
                    <tr>
                      <th>{isEs ? 'Hule y Poliuretano' : 'Rubber & Polyurethane'}</th>
                      <td>{isEs ? 'Elastómeros moldeados por compresión y poliuretano de alta resistencia al rasgado para partículas finas, ciclones, flotación y pulpas corrosivas' : 'Compression-molded elastomers and tear-resistant polyurethane for fine particles, hydrocyclones, flotation, and corrosive slurries'}</td>
                    </tr>
                  </tbody>
                ) : (
                  <tbody>
                    <tr>
                      <th>{isEs ? 'Materiales Disponibles' : 'Available Materials'}</th>
                      <td>{isEs ? 'Alto Cromo (ASTM A532 ≥ 650 HB), Hule Natural (R55), Poliuretano (U01) y Carburo de Silicio Sinterizado (SiC ≥ 2200 HV)' : 'High Chrome (ASTM A532 ≥ 650 HB), Natural Rubber (R55), Polyurethane (U01), and Sintered Silicon Carbide (SiC ≥ 2200 HV)'}</td>
                    </tr>
                    <tr>
                      <th>{isEs ? 'Geometría de Álabes' : 'Vane Geometry'}</th>
                      <td>{isEs ? 'Cerrado de 5 álabes (alta eficiencia) o 4 álabes de paso amplio' : '5-vane closed (high efficiency) or 4-vane wide passage'}</td>
                    </tr>
                    <tr>
                      <th>{isEs ? 'Álabes Expulsores' : 'Pump-Out Vanes'}</th>
                      <td>{isEs ? 'Álabes auxiliares en cara frontal y posterior para control de recirculación' : 'Auxiliary vanes on front and rear shrouds to control recirculation'}</td>
                    </tr>
                    <tr>
                      <th>{isEs ? 'Rosca de Montaje' : 'Shaft Thread'}</th>
                      <td>{isEs ? 'Maquinado de precisión para acoplamiento directo en flecha del Bearing Assembly' : 'Precision-machined thread for direct mounting on the Bearing Assembly shaft'}</td>
                    </tr>
                  </tbody>
                )}
              </table>
            </div>
          </div>

          <div>
            <div class="card smat-trib-side-card">
              <h3>
                {isLiners
                  ? (isEs ? 'Ejemplo de Lote Programado para Planta' : 'Sample Plant Lot Configuration')
                  : (isEs ? 'Suministro en Lote de Contacto Húmedo' : 'Wet-End Lot Supply')}
              </h3>
              <p>
                {isLiners
                  ? (isEs
                    ? 'El cuello y el impulsor trabajan con una holgura frontal reducida y presentan mayor frecuencia de recambio que la voluta. Configurar su pedido por lote (ej. 5 impulsores + 5 cuellos + 4 volutas) evita instalar un impulsor nuevo contra un cuello desgastado.'
                    : 'The throatbush and impeller operate with a tight front clearance and require more frequent replacement than the volute. Ordering in matched lots (e.g., 5 impellers + 5 throatbushes + 4 volutes) prevents pairing a new impeller with a worn throatbush.')
                  : (isEs
                    ? 'Por su desgaste frente al resto de la carcasa, las plantas mineras suelen programar el impulsor en lotes combinados con cuellos y volutas (por ejemplo: 5 impulsores, 5 cuellos y 4 volutas) para asegurar el ajuste hidráulico en cada cambio.'
                    : 'Because the impeller and throatbush wear faster than the volute, concentrator plants typically order impellers in matched wet-end lots (for example: 5 impellers, 5 throatbushes, and 4 volute liners).')}
              </p>
              <div class="smat-trib-side-actions">
                <a
                  href={isLiners
                    ? `${quoteBase}?circuito=bombeo&equipo=kit_wet_end&pieza=voluta_liners&estacion=S3#rfq`
                    : `${quoteBase}?circuito=bombeo&equipo=solo_impulsor&pieza=impulsor_5_alabes&estacion=S3#rfq`}
                  class="btn btn-primary smat-trib-full-btn"
                >
                  {isLiners
                    ? (isEs ? 'Cotizar Lote de Contacto Húmedo (5-5-4) →' : 'Quote Wet-End Lot (5-5-4) →')
                    : (isEs ? 'Cotizar Impulsores →' : 'Quote Impellers →')}
                </a>
                <a
                  href={isEs ? '/bombeo/#como-se-arma-una-bomba' : '/en/pumping/#how-a-slurry-pump-is-assembled'}
                  class="btn btn-outline smat-trib-full-btn"
                >
                  {isLiners
                    ? (isEs ? 'Ver Reporte de Armado y Despiece →' : 'View Pump Assembly & Exploded BOM →')
                    : (isEs ? 'Ver Montaje en Reporte de Armado →' : 'View Impeller Mounting in Assembly Report →')}
                </a>
              </div>
            </div>

            {dc && (
              <div class="card smat-trib-criteria-card" data-testid="role-decision-criteria">
                <span class="font-mono-tech smat-trib-criteria-eyebrow">
                  {isLiners
                    ? (isEs ? '[CRITERIO DE DECISIÓN E INGENIERÍA — LOTE 5-5-4]' : '[ENGINEERING DECISION CRITERIA — 5-5-4 LOT]')
                    : (isEs ? '[CRITERIO DE DECISIÓN E INGENIERÍA — ESTACIÓN 03]' : '[ENGINEERING DECISION CRITERIA — STATION 03]')}
                </span>
                <p class="smat-trib-criteria-line"><strong>{isEs ? 'Regla Metalúrgica:' : 'Metallurgical Rule:'}</strong> {isEs ? dc.metallurgy_rule_es : dc.metallurgy_rule_en}</p>
                <p class="smat-trib-criteria-line"><strong>{isEs ? 'Variables Críticas:' : 'Critical Variables:'}</strong> {isEs ? dc.required_slurry_vars_es : dc.required_slurry_vars_en}</p>
                <p class="smat-trib-criteria-risk"><strong>{isEs ? 'Riesgo Evitado:' : 'Avoided Risk:'}</strong> {isEs ? dc.risk_avoided_es : dc.risk_avoided_en}</p>
              </div>
            )}
          </div>
        </div>

        {!isLiners && (
          <div class="smat-trib-diagram-gap" data-testid="impeller-atomic-parts">
            <h2>
              {isEs
                ? 'Impulsores Estándar Verificados en Almacén Durango (D3147 / E4147 / F6147)'
                : 'Verified Standard Impellers at Durango Warehouse (D3147 / E4147 / F6147)'}
            </h2>
            <div class="smat-trib-atomic-grid">
              {impellerParts.map((ip) => (
                <div class="card smat-trib-atomic-card">
                  <div class="smat-trib-atomic-head">
                    <span class="badge badge-copper">{ip.part_number} ({ip.smat_code})</span>
                    <span class="font-mono-tech smat-trib-atomic-mass">{ip.weight_kg} kg • LI={ip.niosh_lifting_index_shaft}</span>
                  </div>
                  <strong class="smat-trib-card-title">{isEs ? ip.name_es : ip.name_en}</strong>
                  <div class="font-mono-tech smat-trib-atomic-dims">
                    ∅D₂ = {ip.impeller_diameter_mm} mm • {isEs ? 'Esfera máx.' : 'Max sphere'} = {ip.max_particle_mm} mm • {isEs ? 'Espesor' : 'Wall'} = {ip.wall_thickness_mm} mm
                  </div>
