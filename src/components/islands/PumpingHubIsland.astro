    code: 'LOTE-554-HYB',
    trayTitleEs: 'Kit Lote 5-5-4 Rama Híbrida D (Impulsor A05 + Liners R55)',
    trayTitleEn: '5-5-4 Hybrid Branch D Kit (A05 Impeller + R55 Liners)',
    material: 'HYBRID',
    isHybrid: true,
  },
];

const systems = [
  {
    titleEs: 'Bombas Completas para Lodos',
    titleEn: 'Complete Slurry Pumps',
    descEs: 'Bombas centrífugas horizontales de servicio pesado desde 1.5x1" hasta 14x12" para descarga de molino, alimentación de ciclones, flotación y transporte de jales.',
    descEn: 'Heavy-duty horizontal centrifugal slurry pumps from 1.5x1" to 14x12" for mill discharge, cyclone feed, flotation, and tailings transport.',
    metaLabelEs: 'Rango:',
    metaLabelEn: 'Range:',
    metaEs: '1.5x1" hasta 14x12"',
    metaEn: '1.5x1" to 14x12"',
    specHref: isEs ? '/bombeo/skid/' : '/en/pumping/skid/',
    specCtaEs: 'Ver Diagrama y Ficha',
    specCtaEn: 'View Diagram & Specs',
    quoteHref: `${quoteBase}?circuito=bombeo&equipo=skid_bomba#rfq`,
  },
  {
    titleEs: 'Bearing Assembly / Housing (Soporte)',
    titleEn: 'Bearing Assembly / Housing',
    descEs: 'Cartucho completo armado listo para instalación directa: carcasa cilíndrica, flecha de acero aleado, rodamientos cónicos de servicio pesado y sellos laberinto.',
    descEn: 'Complete assembled cartridge unit ready for installation: cylindrical housing, alloy shaft, heavy-duty tapered roller bearings, and labyrinth seals.',
    metaLabelEs: 'Suministro:',
    metaLabelEn: 'Supply:',
    metaEs: 'Unidad Armada Completa',
    metaEn: 'Complete Assembled Unit',
    specHref: isEs ? '/bombeo/soporte/' : '/en/pumping/bearing-assembly/',
    specCtaEs: 'Ver Cartucho Bearing',
    specCtaEn: 'View Bearing Assembly',
    quoteHref: `${quoteBase}?circuito=bombeo&equipo=soporte&estacion=S1#rfq`,
  },
  {
    titleEs: 'Impulsor (Impeller)',
    titleEn: 'Impeller',
    descEs: 'Impulsores cerrados de 5 álabes y paso amplio para lodos con álabes expulsadores frontales y posteriores para abatir presión en caja y recirculación.',
    descEn: '5-vane closed and wide-passage slurry impellers with front and rear expeller vanes to reduce stuffing box pressure and recirculation.',
    metaLabelEs: 'Materiales:',
    metaLabelEn: 'Materials:',
    metaEs: 'Alto Cromo, Hule, Poliuretano y SiC',
    metaEn: 'High Chrome, Rubber, Polyurethane & SiC',
    specHref: isEs ? '/bombeo/impulsor/' : '/en/pumping/impeller/',
    specCtaEs: 'Características del Impulsor',
    specCtaEn: 'Impeller Characteristics',
    quoteHref: `${quoteBase}?circuito=bombeo&equipo=impulsor&estacion=S3#rfq`,
  },
  {
    titleEs: 'Revestimientos de Voluta y Plato de Succión',
    titleEn: 'Volute Liners & Throatbushes',
    descEs: 'Volutas, platos de succión (Throatbush) e insertos de plato posterior para zona en contacto húmedo, disponibles en lotes balanceados de desgaste.',
    descEn: 'Volutes, throatbushes, and frame plate liner inserts for wet-end contact zones, available in multi-unit wear lots.',
    metaLabelEs: 'Materiales:',
    metaLabelEn: 'Materials:',
    metaEs: 'Alto Cromo, Hule, Poliuretano y SiC',
    metaEn: 'High Chrome, Rubber, Polyurethane & SiC',
    specHref: isEs ? '/bombeo/revestimientos/' : '/en/pumping/liners/',
    specCtaEs: 'Ver Piezas y Lotes',
    specCtaEn: 'View Parts & Lots',
    quoteHref: `${quoteBase}?circuito=bombeo&equipo=revestimientos&estacion=S4#rfq`,
  },
  {
    titleEs: 'Expulsor Centrífugo y Prensaestopa',
    titleEn: 'Centrifugal Expeller & Stuffing Box',
    descEs: 'Expulsor centrífugo en seco, anillo expulsor (Expeller Ring), camisa de flecha y caja estopera trenzada sin sellos mecánicos para cero dilución de pulpa.',
    descEn: 'Dry centrifugal expeller, expeller ring, shaft sleeve, and braided-packing stuffing box (no mechanical seals) for zero slurry dilution.',
    metaLabelEs: 'Sellado:',
    metaLabelEn: 'Sealing:',
    metaEs: 'Expulsor y Empaquetadura PTFE/Grafito',
    metaEn: 'Expeller & PTFE/Graphite Stuffing Box',
    specHref: isEs ? '/bombeo/sello/' : '/en/pumping/seal/',
    specCtaEs: 'Ver Conjunto de Sellado',
    specCtaEn: 'View Sealing Assembly',
    quoteHref: `${quoteBase}?circuito=bombeo&equipo=sello&estacion=S2#rfq`,
  },
