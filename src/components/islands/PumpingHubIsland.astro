---
/**
 * PumpingHubIsland.astro — Estrato 1 Compra-First de Bombeo (`SLICE-V80-B03`, <= 350 LOC)
 * Vitrina de 6 SKUs + matriz paramétrica 9 series; el Estrato 2 técnico vive desacoplado
 * en `PumpingAssistantStratum2.astro` (`#bombeo-asistente`).
 */
import ProductStorefrontCard from '../ProductStorefrontCard.astro';
import PumpingParametricTable from '../PumpingParametricTable.astro';
import PumpingAssistantStratum2 from './PumpingAssistantStratum2.astro';
import { SMAT_SUPPLY_DOORS } from '../../scripts/i18nDomainLabels.js';
import { getVerticalCatalogSubset } from '../../scripts/quickProductsCatalog.js';

interface Props {
  locale?: 'es' | 'en';
  mode?: 'standalone' | 'embedded';
}

const { locale = 'es', mode = 'standalone' } = Astro.props;
const isEs = locale === 'es';
const showVerticalShell = mode === 'standalone';
const pumpingSkus = getVerticalCatalogSubset('bombeo');
---

<div data-island-standalone="pumping" data-island-mode={mode} data-lang={locale}>
  {showVerticalShell && (
    <section class="page-hero smat-compact-hero">
      <div class="container">
        <span class="badge badge-copper">
          {isEs ? SMAT_SUPPLY_DOORS.door2.badgeEs : SMAT_SUPPLY_DOORS.door2.badgeEn}
        </span>
        <h1>{isEs ? 'Bombas para Lodos y Refacciones' : 'Slurry Pumps & Spare Parts'}</h1>
        <p class="smat-bombeo-hero-lead">
          {isEs
            ? <>Selección directa en 1 clic de partes de desgaste en lotes balanceados <strong>5-5-4</strong> (<strong>Alto Cromo ≥650 HB, Hule Natural y Poliuretano</strong>), <strong>Cartuchos de Rodamientos</strong> completos y simulador hidráulico en vivo.</>
            : <>Direct 1-click selection of wet-end wear parts in balanced <strong>5-5-4</strong> lots (<strong>High Chrome ≥650 HB, Natural Rubber, and Polyurethane</strong>), complete <strong>Bearing Assembly</strong> cartridges, and live slurry hydraulic simulator.</>}
        </p>
      </div>
    </section>
  )}

  <section class="section smat-bombeo-main" id="bombeo-main-section">
    <div class="container">
      {showVerticalShell && (
        <div class="smat-mb-md" aria-label={isEs ? 'Refacciones y paquetes de bombeo disponibles' : 'Available slurry pumping spares and packages'}>
          <div class="smat-sf-grid">
            {pumpingSkus.map((sku, idx) => (
              <ProductStorefrontCard sku={sku} lang={locale} eager={idx < 3} />
            ))}
          </div>
        </div>
      )}

      {showVerticalShell && (
        <details class="wb-progressive-drawer smat-mt-md" id="bombeo-parametric-drawer">
          <summary class="wb-progressive-summary">
            <span>{isEs ? 'Tabla paramétrica de 9 series de bombas (1.5x1" a 14x12") y croquis ANSI 1:1' : 'Parametric matrix of 9 slurry pump frames (1.5x1" to 14x12") & ANSI 1:1 footprint'}</span>
            <span class="wb-step1-more-arrow">▾</span>
          </summary>
          <div class="wb-progressive-body">
            <PumpingParametricTable locale={locale} />
          </div>
        </details>
      )}
    </div>
  </section>

  <PumpingAssistantStratum2 locale={locale} mode={mode} />
</div>
