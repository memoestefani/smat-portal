---
// src/components/islands/PumpingHubIsland.astro — Isla Canónica Única de Bombeo y Lotes 5-5-4 (SLICE-V51-18)
import PumpingHydraulicsCore from '../cores/PumpingHydraulicsCore.astro';
import CircuitNavigator from '../CircuitNavigator.astro';
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import SharePurchasing from '../SharePurchasing.astro';
import PumpAssemblyReport from '../PumpAssemblyReport.astro';
import atomicParts from '../../../data/atomic_parts.json';
import { getAtomicPartSpecs, formatNioshErgonomicStatus, buildWizardUrl } from '../../scripts/workbenchBus.js';
import { SMAT_SUPPLY_DOORS } from '../../scripts/i18nDomainLabels.js';

interface Props {
  locale?: 'es' | 'en';
  mode?: 'standalone' | 'embedded';
}

const { locale = 'es', mode = 'standalone' } = Astro.props;
const isEs = locale === 'es';
const showVerticalShell = mode === 'standalone';
const quoteBase = isEs ? '/cotizar/' : '/en/quote/';

const kits = [
  {
    badgeEs: 'ALTO CROMO Cr27% • ≥650 HB',
    badgeEn: 'HIGH CHROME Cr27% • ≥650 HB',
