    ctaEn: 'Quote Polyurethane Kit →',
    sku: 'SMAT-PUMP-KIT-554-U01',
    code: 'LOTE-554-U01',
    trayTitleEs: 'Kit Lote 5-5-4 Poliuretano U01',
    trayTitleEn: '5-5-4 Polyurethane Wet-End Kit U01',
    material: 'U01',
    isHybrid: false,
  },
  {
    badgeEs: 'CERÁMICA SiC • ≥2200 HV (MOHS 9.2)',
    badgeEn: 'SiC CERAMIC • ≥2200 HV (MOHS 9.2)',
    titleEs: 'Kit Carburo de Silicio Compuesto (Sílice Fina y pH Extremo)',
    titleEn: 'Silicon Carbide Composite Kit (Fine Silica & Extreme pH)',
    partsEs: 'Voluta Compuesta SiC + Plato Succión SiC + Impulsor Cr27/SiC.',
    partsEn: 'SiC Composite Volute + SiC Throatbush + Cr27/SiC Impeller.',
    envEs: 'Sílice severa d₈₀ ≤ 800 µm, u₂ ≤ 28.0 m/s, K_Ic = 4.1 MPa·√m, pH 1.0–13.5.',
    envEn: 'Severe silica d₈₀ ≤ 800 µm, u₂ ≤ 28.0 m/s, K_Ic = 4.1 MPa·√m, pH 1.0–13.5.',
    href: `${quoteBase}?circuito=bombeo&equipo=bombeo_hule_cromo&pieza=lote_554&material=ceramica_sic&estacion=S4#rfq`,
    ctaEs: 'Cotizar Kit Cerámica SiC →',
    ctaEn: 'Quote SiC Ceramic Kit →',
    sku: 'SMAT-PUMP-KIT-554-SIC',
    code: 'LOTE-554-SIC',
    trayTitleEs: 'Kit Lote 5-5-4 Carburo de Silicio Compuesto',
    trayTitleEn: '5-5-4 Silicon Carbide Composite Wet-End Kit',
    material: 'SiC',
    isHybrid: false,
  },
  {
    badgeEs: 'RAMA HÍBRIDA D • IMPULSOR A05 + LINERS R55',
    badgeEn: 'HYBRID BRANCH D • A05 IMPELLER + R55 LINERS',
    titleEs: 'Kit Híbrido Finnie-Hutchings (Nicho Alimentación Ciclones)',
    titleEn: 'Finnie-Hutchings Hybrid Kit (Cyclone Feed Niche)',
    partsEs: 'Impulsor cerrado Alto Cromo 27% (A05 ≥650 HB, rasante α ≤ 25°) + Revestimientos Hule Natural R55 FPL/CPL (55 Shore A, impacto cuasi-normal α = 75°–90°).',
    partsEn: '27% High Chrome Closed Impeller (A05 ≥650 HB, leading-edge grazing shear α ≤ 25°) + Split R55 Natural Rubber Liners FPL/CPL (55 Shore A, quasi-normal impact α = 75°–90°).',
    envEs: 'Alimentación mixta a ciclones d₈₀ = 150–400 µm, u₂ ≤ 24.5 m/s, -28% reducción de masa y maniobra ergonómica.',
    envEn: 'Mixed cyclone feed d₈₀ = 150–400 µm, u₂ ≤ 24.5 m/s, -28% mass reduction & ergonomic rigging.',
