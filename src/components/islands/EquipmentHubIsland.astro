---
/**
 * EquipmentHubIsland.astro
 * ---------------------------------------------------------------------------
 * Isla Canónica Bilingüe para /equipos/ y /en/process-equipment/ (D2-V50, D4-V50, DEB-V50-05).
 * Centraliza los 5 bloques de Equipos de Proceso, buscador instantáneo Drop-In
 * (#equipos-sku-search + #equipos-dropin-match-banner), cajones 1-clic con
 * avenidas reales (AV-01, AV-02/AV-03/AV-6A, AV-04, AV-05, AV-05-LAB) y zero inline styles.
 */
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import CircuitNavigator from '../CircuitNavigator.astro';
import CaseCards from '../CaseCards.astro';
import SharePurchasing from '../SharePurchasing.astro';
import DropInVerifierCore from '../cores/DropInVerifierCore.astro';
import { getQuickProductsCatalog, AVENUE_METADATA } from '../../scripts/quickProductsCatalog.js';
import { SMAT_SUPPLY_DOORS } from '../../scripts/i18nDomainLabels.js';

interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const isEs = locale === 'es';
const lang = locale;

const allQuickSkus: any[] = getQuickProductsCatalog() as any[];
const avenueCount = Object.keys(AVENUE_METADATA).length;
const skusByVertical: Record<string, any[]> = {
  flotacion: allQuickSkus.filter((s) => s.vertical === 'flotacion'),
  filtracion: allQuickSkus.filter((s) => s.vertical === 'filtracion'),
  bombeo: allQuickSkus.filter((s) => s.vertical === 'bombeo'),
  clasificacion: allQuickSkus.filter((s) => s.vertical === 'clasificacion'),
  control: allQuickSkus.filter((s) => s.vertical === 'control'),
};

const quoteBase = isEs ? '/cotizar/' : '/en/quote/';
const catalogBase = isEs ? '/catalogo/' : '/en/catalog/';
const pumpingPath = isEs ? '/bombeo/' : '/en/pumping/';
const classificationPath = isEs ? '/clasificacion/' : '/en/classification/';
const flotationPath = isEs ? '/flotacion/' : '/en/flotation/';
const filtrationPath = isEs ? '/filtracion/' : '/en/filtration/';
const controlPath = isEs ? '/control-de-procesos/' : '/en/process-control/';
const productsBase = isEs ? '/productos/' : '/en/products/';

const renderSkuHref = (sku: any) => `${productsBase}${isEs ? sku.slug_es : sku.slug_en}/`;
const renderSkuTitle = (sku: any) => (isEs ? sku.title_es : sku.title_en);
---

<section class="page-hero smat-compact-hero">
  <div class="container">
    <span class="badge badge-copper">
      {isEs ? SMAT_SUPPLY_DOORS.door1.badgeEs : SMAT_SUPPLY_DOORS.door1.badgeEn}
    </span>
    <h1>{isEs ? 'Equipos de Proceso' : 'Process Equipment'}</h1>
    <p class="hero-lead">
      {isEs
        ? 'Flotación (50–300 ft³), Filtros Prensa (16 bar), Hidrociclones y Motobombas de Proyecto.'
        : 'Flotation Mechanisms (50–300 ft³), 16-Bar Filter Presses, Hydrocyclone Clusters & Slurry Pump Packages.'}
    </p>
  </div>
</section>

<section class="section smat-stage-compact" id="stage-diagnostic">
  <div class="container">
    <div id="stratum1-equipos-search" data-stratum-1-instrument class="equipos-toolbar">
      <div class="toolbar-search-col">
        <label class="search-label" for="equipos-circuit-select">
          {isEs
            ? 'ARQUITECTURA DE CIRCUITOS DE PLANTA (SELECCIÓN POR PROCESO)'
            : 'PLANT PROCESS CIRCUIT ARCHITECTURE (FILTER BY CIRCUIT)'}
        </label>
        <select
          id="equipos-circuit-select"
          class="wb-select smat-mt-sm"
          aria-label={isEs ? 'Filtrar equipos por circuito' : 'Filter equipment by circuit'}
        >
          <option value="all" data-catalog-avenue="all" selected>
            {isEs ? 'Todos los Circuitos (5)' : 'All Circuits (5)'}
          </option>
          <option value="flotacion" data-catalog-avenue="avenida_4_flotacion_y_valvulas">
            {isEs ? 'Flotación (Celdas 50–300 ft³)' : 'Flotation (50–300 ft³ Cells)'}
          </option>
          <option value="filtracion" data-catalog-avenue="avenida_5_desaguado_y_prensa">
            {isEs ? 'Filtración (Filtros Prensa 16 bar)' : 'Filtration (16-Bar Filter Presses)'}
          </option>
          <option value="bombeo" data-catalog-avenue="avenida_1_bombas_y_desgaste">
            {isEs ? 'Bombeo (Motobombas y Extremo Húmedo)' : 'Pumping (Slurry Pumps & Wet-End)'}
          </option>
          <option value="clasificacion" data-catalog-avenue="avenida_2_hidrociclones_y_mallas">
            {isEs ? 'Clasificación (Hidrociclones y Mallas)' : 'Classification (Cyclones & Screens)'}
          </option>
          <option value="control" data-catalog-avenue="avenida_5_laboratorio">
            {isEs ? 'Control / Lab (Balanza Marcy y Tamices)' : 'Process Control (Marcy Scale & Sieves)'}
          </option>
        </select>
      </div>
      <div class="toolbar-meta-col">
        <span data-equipos-search-count class="search-count-pill">
          {isEs
            ? `Mostrando ${allQuickSkus.length} SKUs en ${avenueCount} Avenidas`
            : `Showing ${allQuickSkus.length} SKUs across ${avenueCount} Avenues`}
        </span>
        <a id="equipos-catalog-deep-link" href={catalogBase} class="matrix-link-solar" data-catalog-base={catalogBase}>
          {isEs
            ? `Abrir Catálogo Omnicanal (${allQuickSkus.length} SKUs) →`
            : `Open Omnibox Catalog (${allQuickSkus.length} SKUs) →`}
        </a>
      </div>
    </div>

    <div class="smat-mb-md" id="equipos-catalog-blocks-drawer">
    <div class="process-equipment-grid">
      <article class="card equipment-block" data-equipment-block="flotacion" data-equipment-block-blob="flotacion flotation celdas cells mecanismos mechanisms acondicionadores 18sp av-04">
        <div class="equipment-block-header">
          <span class="badge badge-copper">
            {isEs ? 'CIRCUITO DE CONCENTRACIÓN • 50 A 300 FT³ • AV-04' : 'CONCENTRATION CIRCUIT • 50 TO 300 FT³ • AV-04'}
          </span>
          <h2>{isEs ? 'Mecanismos para Celdas de Flotación y Acondicionadores' : 'Flotation Cell Mechanisms & Pulp Conditioners'}</h2>
          <p class="eq-lead-desc">
            {isEs
              ? 'Cabezales motrices, flechas concéntricas de acero aleado, tubos de aire (standpipes), difusores estatores, impulsores rotores y acondicionadores de pulpa de alta intensidad para bancos Rougher, Cleaner y Scavenger.'
              : 'Complete drive heads, concentric alloy steel shafts, standpipes, stator diffusers, rotor impellers, and high-intensity pulp conditioners for Rougher, Cleaner, and Scavenger flotation banks.'}
          </p>
        </div>
        <TechnicalDiagrams diagram="flotation" lang={lang} />
        <div class="specs-strip">
          <div><strong>{isEs ? 'Capacidades:' : 'Cell Capacities:'}</strong> 50 ft³, 100 ft³, 160 ft³ &amp; 300 ft³</div>
          <div><strong>{isEs ? 'Aireación:' : 'Aeration:'}</strong> {isEs ? 'Auto-aspirada o aire forzado a baja presión' : 'Self-aspirated or low-pressure forced air'}</div>
          <div><strong>{isEs ? 'Elastómeros:' : 'Wear Elastomers:'}</strong> {isEs ? 'Hule natural antiabrasivo y Poliuretano moldeado' : 'Abrasion-resistant natural rubber & molded Polyurethane'}</div>
        </div>
        <details class="eq-drawer" data-equipment-ssot-drawer>
          <summary class="eq-drawer-summary">
            <span>
              {isEs
                ? `▾ SKUs de Flotación (${skusByVertical.flotacion.length} SKU • AV-04)`
                : `▾ Flotation SKUs (${skusByVertical.flotacion.length} SKU • AV-04)`}
            </span>
            <span class="eq-drawer-badge">{isEs ? '+ BANDEJA DIRECTA ▾' : '+ DIRECT TRAY ▾'}</span>
          </summary>
          <div class="eq-drawer-skus">
            {skusByVertical.flotacion.map((sku) => (
              <div
                class="eq-sku-pill"
                data-equipos-sku-pill={sku.id}
                data-equipos-search-blob={`${sku.id} ${sku.title_es} ${sku.title_en} ${(sku.atomic_codes || []).join(' ')} ${sku.avenueCode} ${sku.vertical}`}
              >
                <div>
                  <a href={renderSkuHref(sku)} class="eq-sku-link">{sku.id} — {renderSkuTitle(sku)}</a>
                  <div class="eq-sku-meta">{sku.avenueCode} · {sku.mass_kg} kg · {isEs ? 'Reorden' : 'Reorder'} {sku.reorder_window_days}d</div>
                </div>
                <button type="button" class="btn btn-outline btn-avenue-tray eq-tray-btn" data-add-tray-sku={sku.id} data-tray-part-code={sku.id} data-tray-title={renderSkuTitle(sku)}>
                  {isEs ? '+ Bandeja' : '+ Tray'}
                </button>
              </div>
            ))}
            <div class="equipment-actions">
              <a href={flotationPath} class="btn btn-outline">{isEs ? 'Ver Línea de Flotación' : 'View Flotation Line'}</a>
              <a href={`${flotationPath}${isEs ? 'celdas/' : 'cells/'}`} class="btn btn-outline">{isEs ? 'Mecanismos 50-300 ft³' : 'Mechanisms 50-300 ft³'}</a>
              <a href={`${flotationPath}${isEs ? 'mecanismos/' : 'mechanisms/'}`} class="btn btn-outline">{isEs ? 'Rotores y Estatores' : 'Rotors & Stators'}</a>
            </div>
          </div>
        </details>
        <div class="equipment-actions">
          <a href={`${quoteBase}?circuito=flotacion&equipo=celda_flotacion&serie=100ft#rfq`} class="btn btn-primary">
            {isEs ? 'Cotizar Mecanismo o Celda →' : 'Quote Mechanism or Cell →'}
          </a>
        </div>
      </article>

      <details class="eq-drawer smat-mt-sm" id="equipos-secondary-circuits-drawer">
        <summary class="eq-drawer-summary">
          <span>
            {isEs
              ? 'Ver 4 Circuitos Adicionales (Filtración 16 bar, Bombeo CV, Hidrociclones y Lab Marcy)'
              : 'View 4 Additional Circuits (16-Bar Filtration, CV Slurry Pumps, Cyclones & Lab)'}
          </span>
          <span class="eq-drawer-badge">{isEs ? '4 CIRCUITOS ▾' : '4 CIRCUITS ▾'}</span>
        </summary>
        <div class="process-equipment-grid smat-mt-sm">
      <article class="card equipment-block" data-equipment-block="filtracion" data-equipment-block-blob="filtracion filtration filtros prensa filter press lonas cloths placas plates shifter 800 1500 av-05">
        <div class="equipment-block-header">
          <span class="badge badge-copper">
            {isEs ? 'FILTRACIÓN DE CONCENTRADOS Y JALES SECOS • 800 A 1500 MM • AV-05' : 'CONCENTRATE & DRY TAILINGS DEWATERING • 800 TO 1500 MM • AV-05'}
          </span>
          <h2>{isEs ? 'Filtros Prensa de Cámara Empotrada (Hasta 16 bar)' : 'Recessed-Chamber Filter Presses (Up to 16 bar)'}</h2>
          <p class="eq-lead-desc">
            {isEs
              ? 'Filtros prensa completos con bastidor de acero estructural, cierre electrohidráulico automático, placas de polipropileno virgen copolímero y telas filtrantes para recuperación de agua y apilamiento en seco (Dry Stacking).'
              : 'Complete filter presses with structural steel frame, automated electro-hydraulic closure, virgin copolymer polypropylene plates, and filter cloths for process water recovery and dry stacking.'}
          </p>
        </div>
        <TechnicalDiagrams diagram="filter" lang={lang} />
        <div class="specs-strip">
          <div><strong>{isEs ? 'Formatos de Placa:' : 'Plate Sizes:'}</strong> 800×800 mm, 1000×1000 mm, 1200×1200 mm &amp; 1500×1500 mm</div>
          <div><strong>{isEs ? 'Presión:' : 'Pressure:'}</strong> {isEs ? 'Hasta 16 bar con soplado de torta' : 'Up to 16 bar with air cake blowdown'}</div>
          <div><strong>{isEs ? 'Humedad Residual:' : 'Residual Moisture:'}</strong> 10% – 14%</div>
        </div>
        <details class="eq-drawer" data-equipment-ssot-drawer>
          <summary class="eq-drawer-summary">
            <span>
              {isEs
                ? `▾ SKUs de Filtración y Accesos (${skusByVertical.filtracion.length} SKUs • AV-05)`
                : `▾ Filtration SKUs & Links (${skusByVertical.filtracion.length} SKUs • AV-05)`}
            </span>
            <span class="eq-drawer-badge">{isEs ? '+ BANDEJA DIRECTA ▾' : '+ DIRECT TRAY ▾'}</span>
          </summary>
          <div class="eq-drawer-skus">
            {skusByVertical.filtracion.map((sku) => (
              <div
                class="eq-sku-pill"
                data-equipos-sku-pill={sku.id}
                data-equipos-search-blob={`${sku.id} ${sku.title_es} ${sku.title_en} ${(sku.atomic_codes || []).join(' ')} ${sku.avenueCode} ${sku.vertical}`}
              >
                <div>
                  <a href={renderSkuHref(sku)} class="eq-sku-link">{sku.id} — {renderSkuTitle(sku)}</a>
                  <div class="eq-sku-meta">{sku.avenueCode} · {sku.mass_kg} kg · {isEs ? 'Reorden' : 'Reorder'} {sku.reorder_window_days}d</div>
                </div>
                <button type="button" class="btn btn-outline btn-avenue-tray eq-tray-btn" data-add-tray-sku={sku.id} data-tray-part-code={sku.id} data-tray-title={renderSkuTitle(sku)}>
                  {isEs ? '+ Bandeja' : '+ Tray'}
                </button>
              </div>
            ))}
            <div class="equipment-actions">
              <a href={filtrationPath} class="btn btn-outline">{isEs ? 'Ver Línea de Filtración' : 'View Filtration Line'}</a>
              <a href={`${filtrationPath}${isEs ? 'prensa/' : 'press/'}`} class="btn btn-outline">{isEs ? 'Filtros Prensa 800-1500 mm' : 'Filter Presses 800-1500 mm'}</a>
              <a href={`${filtrationPath}${isEs ? 'repuestos/' : 'parts/'}`} class="btn btn-outline">{isEs ? 'Placas y Telas Filtrantes' : 'Plates & Filter Cloths'}</a>
            </div>
          </div>
        </details>
        <div class="equipment-actions">
          <a href={`${quoteBase}?circuito=filtracion&equipo=filtro_prensa&serie=1200#rfq`} class="btn btn-primary">
            {isEs ? 'Cotizar Filtro Prensa →' : 'Quote Filter Press →'}
          </a>
        </div>
      </article>

      <article class="card equipment-block" data-equipment-block="bombeo" data-equipment-block-blob="bombeo pumping bombas lodos slurry pumps wet end impulsor impeller forros expeller cartucho 005m av-01">
        <div class="equipment-block-header">
          <span class="badge badge-copper">
            {isEs ? 'BOMBEO DE PULPA EN PROYECTO • 1.5X1" A 14X12" • AV-01' : 'PROJECT SLURRY PUMPING • 1.5X1" TO 14X12" • AV-01'}
          </span>
          <h2>{isEs ? 'Bombas Horizontales y Verticales para Lodos (Paquete Completo)' : 'Horizontal & Vertical Slurry Pumps (Complete Package)'}</h2>
          <p class="eq-lead-desc">
            {isEs
              ? 'Bombas centrífugas completas sobre base estructural con conjunto motriz Bearing Assembly / Housing, transmisión por poleas y bandas, guarda de seguridad y extremo húmedo configurado en Alto Cromo (≥650 HB), Hule o Poliuretano.'
              : 'Complete centrifugal slurry pumps on structural skid base with Bearing Assembly / Housing, V-belt drive guard, and wet-end configured in High Chrome (≥650 HB), Rubber, or Polyurethane.'}
          </p>
        </div>
        <TechnicalDiagrams diagram="pump" lang={lang} />
        <TechnicalDiagrams diagram="drive_arrangements" lang={lang} compact={true} />
        <div class="specs-strip">
          <div><strong>{isEs ? 'Descarga:' : 'Discharge:'}</strong> 1.5x1" – 14x12"</div>
          <div><strong>{isEs ? 'Arreglos:' : 'Arrangements:'}</strong> CV, ZVZ, CRZ &amp; DC</div>
          <div><strong>{isEs ? 'Sellado:' : 'Sealing:'}</strong> {isEs ? 'Expulsor seco y prensaestopa' : 'Dry expeller & packed gland'}</div>
        </div>
        <details class="eq-drawer" data-equipment-ssot-drawer>
          <summary class="eq-drawer-summary">
            <span>
              {isEs
                ? `▾ SKUs de Bombeo, Arreglos y Repuestos (${skusByVertical.bombeo.length} SKUs • AV-01)`
                : `▾ Slurry Pump SKUs, Drives & Wear Spares (${skusByVertical.bombeo.length} SKUs • AV-01)`}
            </span>
            <span class="eq-drawer-badge">{isEs ? '+ BANDEJA DIRECTA ▾' : '+ DIRECT TRAY ▾'}</span>
          </summary>
          <div class="eq-drawer-skus">
            {skusByVertical.bombeo.map((sku) => (
              <div
                class="eq-sku-pill"
                data-equipos-sku-pill={sku.id}
                data-equipos-search-blob={`${sku.id} ${sku.title_es} ${sku.title_en} ${(sku.atomic_codes || []).join(' ')} ${sku.avenueCode} ${sku.vertical}`}
              >
                <div>
                  <a href={renderSkuHref(sku)} class="eq-sku-link">{sku.id} — {renderSkuTitle(sku)}</a>
                  <div class="eq-sku-meta">{sku.avenueCode} · {sku.mass_kg} kg · {isEs ? 'Reorden' : 'Reorder'} {sku.reorder_window_days}d · {(sku.atomic_codes || []).slice(0, 4).join(', ')}</div>
                </div>
                <button type="button" class="btn btn-outline btn-avenue-tray eq-tray-btn" data-add-tray-sku={sku.id} data-tray-part-code={sku.id} data-tray-title={renderSkuTitle(sku)}>
                  {isEs ? '+ Bandeja' : '+ Tray'}
                </button>
              </div>
            ))}
            <div class="equipment-actions">
              <a href={pumpingPath} class="btn btn-outline">{isEs ? 'Ir a Refacciones de Bombeo (/bombeo/)' : 'Go to Slurry Pump Spares (/en/pumping/)'}</a>
              <a href={`${pumpingPath}${isEs ? 'skid/#arreglos-transmision' : 'skid/#drive-arrangements'}`} class="btn btn-outline">
                {isEs ? 'Ver Arreglos CV / ZVZ / CRZ / DC' : 'View CV / ZVZ / CRZ / DC Arrangements'}
              </a>
              <a href={`${pumpingPath}#${isEs ? 'como-se-arma-una-bomba' : 'how-a-slurry-pump-is-assembled'}`} class="btn btn-outline">
                {isEs ? 'Ver Reporte de Armado y Despiece' : 'View Assembly & Exploded BOM'}
              </a>
            </div>
          </div>
        </details>
        <div class="equipment-actions">
          <a href={`${quoteBase}?circuito=bombeo&equipo=skid_bomba&serie=6x4&transmision=CV#rfq`} class="btn btn-primary">
            {isEs ? 'Cotizar Motobomba Arreglo CV →' : 'Quote CV Drive Pump Package →'}
          </a>
        </div>
      </article>

      <article class="card equipment-block" data-equipment-block="clasificacion" data-equipment-block-blob="clasificacion classification hidrociclones hydrocyclones apex vortex finder mallas screens th48 d6 d20 av-02 av-03 av-6a">
        <div class="equipment-block-header">
          <span class="badge badge-copper">
            {isEs ? 'CLASIFICACIÓN Y CRIBADO • PLITT d50c • AV-02 / AV-03 / AV-6A' : 'CLASSIFICATION & SCREENING • PLITT d50c • AV-02 / AV-03 / AV-6A'}
          </span>
          <h2>{isEs ? 'Hidrociclones de Clasificación, Boquillas Apex y Mallas de Uretano' : 'Classification Hydrocyclones, Apex Nozzles & Urethane Screens'}</h2>
          <p class="eq-lead-desc">
            {isEs
              ? 'Baterías de hidrociclones y consumibles de corte granulométrico (Apex en SiC y Cr27, Vortex Finder y mallas TH48-30 / 1x1) calibrados por balance metalúrgico de 3 Vasos Marcy para eliminar el acordonamiento (roping).'
              : 'Hydrocyclone clusters and precision wear liners (SiC & Cr27 Apex/Spigot, Vortex Finder, TH48-30 & 1x1 urethane panels) tuned via 3-Cup Marcy balance to eliminate roping.'}
          </p>
        </div>
        <TechnicalDiagrams diagram="cyclone-apex-vortex" lang={lang} />
        <div class="specs-strip">
          <div><strong>{isEs ? 'Metalurgia de Corte:' : 'Cut-Point Alloys:'}</strong> SiC, Alto Cromo 27% Cr &amp; Poliuretano U01</div>
          <div><strong>{isEs ? 'Control:' : 'Control:'}</strong> Du/Do &amp; Plitt d<sub>50c</sub></div>
          <div><strong>{isEs ? 'Diagnóstico:' : 'Diagnostics:'}</strong> C<sub>v,u</sub> ≥ 56% &amp; spray geometry</div>
        </div>
        <details class="eq-drawer" data-equipment-ssot-drawer>
          <summary class="eq-drawer-summary">
            <span>
              {isEs
                ? `▾ SKUs de Clasificación y Simulador (${skusByVertical.clasificacion.length} SKUs • AV-02 / AV-03 / AV-6A)`
                : `▾ Classification SKUs & Simulator (${skusByVertical.clasificacion.length} SKUs • AV-02 / AV-03 / AV-6A)`}
            </span>
            <span class="eq-drawer-badge">{isEs ? '+ BANDEJA DIRECTA ▾' : '+ DIRECT TRAY ▾'}</span>
          </summary>
          <div class="eq-drawer-skus">
            {skusByVertical.clasificacion.map((sku) => (
              <div
                class="eq-sku-pill"
                data-equipos-sku-pill={sku.id}
                data-equipos-search-blob={`${sku.id} ${sku.title_es} ${sku.title_en} ${(sku.atomic_codes || []).join(' ')} ${sku.avenueCode} ${sku.vertical}`}
              >
                <div>
                  <a href={renderSkuHref(sku)} class="eq-sku-link">{sku.id} — {renderSkuTitle(sku)}</a>
                  <div class="eq-sku-meta">{sku.avenueCode} · {sku.mass_kg} kg · {isEs ? 'Reorden' : 'Reorder'} {sku.reorder_window_days}d</div>
                </div>
                <button type="button" class="btn btn-outline btn-avenue-tray eq-tray-btn" data-add-tray-sku={sku.id} data-tray-part-code={sku.id} data-tray-title={renderSkuTitle(sku)}>
                  {isEs ? '+ Bandeja' : '+ Tray'}
                </button>
              </div>
            ))}
            <div class="equipment-actions">
              <a href={classificationPath} class="btn btn-outline">{isEs ? 'Abrir Simulador 3 Vasos Marcy' : 'Open 3-Cup Marcy Simulator'}</a>
              <a href={`${productsBase}${isEs ? 'hidrociclon-completo-y-boquillas-d6-d20/' : 'hydrocyclone-assembly-and-spigots-d6-d20/'}`} class="btn btn-outline">SMAT-CYC-D6-D20</a>
              <a href={`${productsBase}${isEs ? 'paquete-casado-bomba-hidrociclon/' : 'coupled-pump-hydrocyclone-package/'}`} class="btn btn-outline">SMAT-COUPLED-PUMP-CYC</a>
            </div>
          </div>
        </details>
        <div class="equipment-actions">
          <a href={`${quoteBase}?circuito=clasificacion&equipo=hidrociclon&sku=SMAT-CYC-D6-D20#rfq`} class="btn btn-primary">
            {isEs ? 'Cotizar Hidrociclón / Apex →' : 'Quote Hydrocyclone / Apex →'}
          </a>
        </div>
      </article>

      <article class="card equipment-block" data-equipment-block="control" data-equipment-block-blob="control metrology marcy balanza scale filtro batch filter tamices astm e11 rotap pulverizador av-05-lab">
        <div class="equipment-block-header">
          <span class="badge badge-copper">
            {isEs ? 'METROLOGÍA DE PULPA Y CONMINUCIÓN LAB • AV-05-LAB' : 'PULP METROLOGY & LAB COMMINUTION • AV-05-LAB'}
          </span>
