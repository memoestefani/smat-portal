<script>
  import { bindEquipmentCatalogSearchAndTray } from '../../scripts/homeAndEquipmentCatalogFilter.js';
  import { bindDropInEquivalenceVerifier } from '../../scripts/catalogDropInAndJrpProjector.js';

  function initEquipmentHubIsland() {
    const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
    bindEquipmentCatalogSearchAndTray(document, lang);
    bindDropInEquivalenceVerifier(document, lang);

    const circuitSelect = document.getElementById('equipos-circuit-select') as HTMLSelectElement | null;
    const secDrawer = document.getElementById('equipos-secondary-circuits-drawer') as HTMLDetailsElement | null;
    const blocks = Array.from(document.querySelectorAll('[data-equipment-block]'));
    const deepLink = document.getElementById('equipos-catalog-deep-link') as HTMLAnchorElement | null;
    const catBase = deepLink?.getAttribute('data-catalog-base') || (lang === 'en' ? '/en/catalog/' : '/catalogo/');

    if (circuitSelect && circuitSelect.dataset.eqSelectBound !== '1') {
      circuitSelect.dataset.eqSelectBound = '1';
      circuitSelect.addEventListener('change', () => {
        const selectedOpt = circuitSelect.options[circuitSelect.selectedIndex];
        const circuit = circuitSelect.value || 'all';
        const avenue = selectedOpt?.getAttribute('data-catalog-avenue') || 'all';
        if (secDrawer && circuit !== 'flotacion') secDrawer.open = true;
        blocks.forEach((blk) => {
          const el = blk as HTMLElement;
          const match = circuit === 'all' || el.getAttribute('data-equipment-block') === circuit;
          el.style.display = match ? '' : 'none';
          const drawer = el.querySelector('details.eq-drawer') as HTMLDetailsElement | null;
          if (drawer && circuit !== 'all' && match) drawer.open = true;
        });
        if (deepLink) {
          deepLink.href = avenue === 'all' ? catBase : `${catBase}?avenida=${encodeURIComponent(avenue)}`;
        }
      });
    }
  }

  initEquipmentHubIsland();
  document.addEventListener('astro:page-load', initEquipmentHubIsland);
</script>

