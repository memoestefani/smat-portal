---
/**
 * FlotationCalculatorIsland.astro
 * ---------------------------------------------------------------------------
 * Isla Canónica Bilingüe Única de Flotación JKMRC Gorain (Sb = 6 Jg / d32, k = P * Sb * Rf)
 * y Suspensión Zwietering Njs (`D1-V50`, `D2-V50`, `D5-V50`).
 * Soporta `mode: 'standalone' | 'embedded'` y `variant: 'hub' | 'cells' | 'mechanisms'`.
 */
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import CircuitNavigator from '../CircuitNavigator.astro';
import SharePurchasing from '../SharePurchasing.astro';
import rolesData from '../../../data/roles.json';

interface Props {
  locale?: 'es' | 'en';
  variant?: 'hub' | 'cells' | 'mechanisms';
  mode?: 'standalone' | 'embedded';
}

const {
  locale = 'es',
  variant = 'hub',
  mode = 'standalone',
} = Astro.props;

const isEs = locale === 'es';
const lang = locale;
const isEmbedded = mode === 'embedded';

const flotVertical = rolesData.verticals.find((v) => v.id === 'flotacion');
const roleIdTarget = variant === 'mechanisms' ? 'mecanismos_flotacion' : 'celda_completa';
const activeRole =
  flotVertical?.capex?.find((r) => r.role_id === roleIdTarget) ||
  flotVertical?.opex?.find((r) => r.role_id === roleIdTarget) ||
  flotVertical?.capex?.[0];
const criteria = activeRole?.decision_criteria;

const stratumId =
  variant === 'cells'
    ? 'stratum1-cells-sim'
    : variant === 'mechanisms'
      ? 'stratum1-mechanisms-sim'
      : 'stratum1-flotation-sim';

const quoteBase = isEs ? '/cotizar/' : '/en/quote/';
const flotBase = isEs ? '/flotacion/' : '/en/flotation/';
const productsBase = isEs ? '/productos/' : '/en/products/';
const quoteEquipo = variant === 'mechanisms' ? 'rotor_estator' : 'celda_flotacion';
---

{isEmbedded ? (
  <div id="wb-flot-gorain-live-box" data-testid="wb-flot-gorain-live-box" class="hidden embedded-flot-box">
    <div class="smat-flex-between">
      <strong class="embedded-title">
        {isEs
          ? 'SIMULADOR EN VIVO: AIREACIÓN DE CELDA, FLUJO DE BURBUJA (Sb) Y SUSPENSIÓN (Njs)'
          : 'LIVE SIMULATOR: CELL AERATION, BUBBLE FLUX (Sb) & SOLIDS SUSPENSION (Njs)'}
      </strong>
      <span class="embedded-badge">Drop-In #18 SP / #24 / #30</span>
    </div>

    <div class="smat-inputs-2col smat-mt-sm">
      <div class="form-group">
        <label class="smat-field-label" for="wb-flot-jg">
          {isEs ? 'Gas Superficial Jg (cm/s):' : 'Superficial Gas Jg (cm/s):'}
        </label>
        <input type="number" id="wb-flot-jg" min="0.5" max="3.5" step="0.1" value="1.5" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
      </div>
      <div class="form-group">
        <label class="smat-field-label" for="wb-flot-d32">
          {isEs ? 'Burbuja Sauter d32 (mm):' : 'Sauter Bubble d32 (mm):'}
        </label>
        <input type="number" id="wb-flot-d32" min="0.8" max="3.0" step="0.1" value="1.6" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
      </div>
      <div class="form-group">
        <label class="smat-field-label" for="wb-flot-dia">
          {isEs ? 'Ø Rotor Dr (m):' : 'Rotor Ø Dr (m):'}
        </label>
        <input type="number" id="wb-flot-dia" min="0.25" max="1.50" step="0.05" value="0.61" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
      </div>
      <div class="form-group">
        <label class="smat-field-label" for="wb-flot-rpm">
          {isEs ? 'Velocidad Rotor (RPM):' : 'Rotor Speed (RPM):'}
        </label>
        <input type="number" id="wb-flot-rpm" min="100" max="450" step="5" value="215" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
      </div>
    </div>

    <details class="tier2-flot-details smat-mt-sm">
      <summary class="tier2-flot-summary">
        {isEs
          ? 'Parámetros Cinéticos de Yacimiento: Flotabilidad P, Espuma Rf, d80 y %Cw'
          : 'Ore Kinetic Parameters: Floatability P, Froth Recovery Rf, d80 & %Cw'}
      </summary>
      <div class="smat-inputs-2col smat-mt-sm">
        <div class="form-group">
          <label class="smat-field-label" for="wb-flot-p">
            {isEs ? 'Flotabilidad Mineral P:' : 'Ore Floatability P:'}
          </label>
          <input type="number" id="wb-flot-p" min="0.0005" max="0.020" step="0.0005" value="0.0045" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
        </div>
        <div class="form-group">
          <label class="smat-field-label" for="wb-flot-rf">
            {isEs ? 'Recuperación en Espuma Rf:' : 'Froth Recovery Rf:'}
          </label>
          <input type="number" id="wb-flot-rf" min="0.20" max="1.00" step="0.02" value="0.78" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
        </div>
        <div class="form-group">
          <label class="smat-field-label" for="wb-flot-d80">
            {isEs ? 'Granulometría d80 (µm):' : 'Grind Size d80 (µm):'}
          </label>
          <input type="number" id="wb-flot-d80" min="15" max="600" step="5" value="110" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
        </div>
        <div class="form-group">
          <label class="smat-field-label" for="wb-flot-cw">
            {isEs ? 'Sólidos Pulpa Cw (%):' : 'Pulp Solids Cw (%):'}
          </label>
          <input type="number" id="wb-flot-cw" min="10" max="65" step="1" value="35" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
        </div>
      </div>
    </details>

    <div class="embedded-res-grid font-mono-tech smat-mt-sm">
      <div class="embedded-res-cell"><strong>{isEs ? 'Flujo Burbuja Sb:' : 'Bubble Flux Sb:'}</strong> <span id="wb-flot-res-sb" data-testid="wb-flot-res-sb">56.25 s⁻¹</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Tasa Cinética k:' : 'Kinetic Rate k:'}</strong> <span id="wb-flot-res-k" data-testid="wb-flot-res-k">0.197 min⁻¹</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Suspensión Njs:' : 'Min Suspension Njs:'}</strong> <span id="wb-flot-res-njs" data-testid="wb-flot-res-njs">156 RPM</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Vel. Periférica u₂:' : 'Tip Speed u₂:'}</strong> <span id="wb-flot-res-vtip" data-testid="wb-flot-res-vtip">6.87 m/s</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Vida PU vs Hule:' : 'PU vs Rubber Life:'}</strong> <span id="wb-flot-res-pu-life" data-testid="wb-flot-res-pu-life">{isEs ? 'Vida PU vs Hule: 2.1× · u₂ óptima' : 'PU vs Rubber Life: 2.1× · optimal u₂'}</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Estado Zwietering:' : 'Zwietering Status:'}</strong> <span id="wb-flot-res-susp-status" data-testid="wb-flot-res-susp-status">{isEs ? 'Suspensión Completa' : 'Full Suspension'}</span></div>
      <div class="embedded-res-cell"><strong>P (Gorain):</strong> <span id="wb-flot-res-p" data-testid="wb-flot-res-p">0.0045</span></div>
      <div class="embedded-res-cell"><strong>R_f (Espuma):</strong> <span id="wb-flot-res-rf" data-testid="wb-flot-res-rf">0.78</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'SKU Mecanismo:' : 'Mechanism SKU:'}</strong> <span id="wb-flot-res-sku" data-testid="wb-flot-res-sku">SMAT-FLOT-MECH-18SP</span></div>
    </div>
  </div>
) : (
  <div class="flot-standalone-wrap" data-island-standalone="flotation">
    <section class={`page-hero ${variant !== 'hub' ? 'smat-compact-hero' : ''}`}>
      <div class="container">
        <div class="smat-flex-between">
          <h1>
            {variant === 'mechanisms'
              ? (isEs ? 'Impulsores y Difusores de Flotación' : 'Flotation Impellers, Diffusers & Spares')
              : (isEs ? 'Mecanismos para Celdas de Flotación y Acondicionadores' : 'Flotation Cell Mechanisms & Conditioners')}
          </h1>
          <span class={`badge ${variant === 'cells' ? 'badge-opex' : 'badge-copper'}`}>
            {variant === 'mechanisms'
              ? (isEs ? 'REFACCIONES DE FLOTACIÓN • POLIURETANO Y HULE' : 'FLOTATION WEAR PARTS • POLYURETHANE & RUBBER')
              : variant === 'cells'
                ? (isEs ? 'MECANISMOS SUSPENDIDOS Y RETROFIT DROP-IN • 50 A 300 FT³' : 'SUSPENDED MECHANISMS & DROP-IN RETROFIT • 50 TO 300 FT³')
                : (isEs ? 'FLOTACIÓN Y ACONDICIONAMIENTO' : 'FLOTATION & CONDITIONING')}
          </span>
        </div>
        <p class={variant !== 'hub' ? 'smat-hero-sub' : 'hero-lead'}>
          {variant === 'mechanisms'
            ? (isEs
                ? 'Repuestos en poliuretano y hule para mecanismos de celdas de flotación y acondicionadores (50 a 300 ft³).'
                : 'Polyurethane and molded rubber replacement rotors, diffusers, and coated shafts for 50 to 300 ft³ cells.')
            : (isEs
                ? 'Calibre flujo superficial de burbuja Gorain (Sb = 6 Jg / d32), tasa cinética (k = P·Sb·Rf) y suspensión Zwietering Njs sin obra civil.'
                : 'Calibrate Gorain bubble surface area flux (Sb = 6 Jg / d32), kinetic rate (k = P·Sb·Rf), and Zwietering solids suspension speed Njs.')}
        </p>
      </div>
    </section>

    <section class={`section ${variant !== 'hub' ? 'section-spacing smat-stage-compact' : ''}`} id="flotacion-main-section">
      <div class={`container ${variant !== 'hub' ? 'content-container' : ''}`}>
        <div class={variant !== 'hub' ? 'card detail-card' : ''}>
          <div
            class="flotation-5zone-box"
            id={stratumId}
            data-cell-dropin-matrix="gorain-1997"
            data-stratum-1-instrument
          >
            <span class={`badge ${variant === 'cells' ? 'badge-opex' : 'badge-copper'}`}>
              {isEs
                ? 'SIMULADOR HIDRODINÁMICO EN VIVO · GORAIN Sb & ZWIETERING Njs'
                : 'LIVE HYDRODYNAMIC SIMULATOR · GORAIN Sb & ZWIETERING Njs'}
            </span>
            <h2 class="calc-heading">
              {variant === 'mechanisms'
                ? (isEs ? 'Cálculo de Rotor Estrella y Difusor Drop-In (PU vs Hule R55)' : 'Star Rotor & Drop-In Diffuser Sizing (PU vs R55 Rubber)')
                : (isEs ? 'Calibración de Flujo Superficial de Burbuja (Sb) y Suspensión de Sólidos' : 'Bubble Surface Flux (Sb) & Solids Suspension Calibration')}
            </h2>

            <div class="smat-stratum1-display">
              <div id="celdas-gorain-readout" class="gorain-readout-banner">
                S<sub>b</sub> (s<sup>-1</sup>): <span id="celdas-sb-output">56.25</span> ·{' '}
                {isEs ? 'Vel. Periférica u₂' : 'Tip Speed u₂'} (m/s): <span id="celdas-vtip-output">6.87</span> ·{' '}
                k (min<sup>-1</sup>): <span id="celdas-k-output">1.195</span> ·{' '}
                N<sub>js</sub>: <span id="celdas-njs-output">156</span> RPM ·{' '}
                P: <span id="celdas-p-output">0.0045</span> · R<sub>f</sub>: <span id="celdas-rf-output">0.78</span>{' '}
                (<span id="celdas-status-output">{isEs ? 'Gorain ≥ 50 s⁻¹ ÓPTIMO · Zwietering SUSPENSIÓN COMPLETA' : 'Gorain ≥ 50 s⁻¹ OPTIMAL · Zwietering FULL SUSPENSION'}</span>)
              </div>
            </div>

            <div class="smat-inputs-2col smat-panel-soft">
              <label class="calc-field">
                <span>{isEs ? 'Modelo / Ø Rotor (m):' : 'Cell Model / Rotor Ø (m):'}</span>
                <select id="celdas-dia-select" class="smat-input-control">
                  <option value="0.46">#18 SP (Ø 0.46 m · 50 ft³)</option>
                  <option value="0.61" selected>#24 (Ø 0.61 m · 100 ft³)</option>
                  <option value="0.76">#30 (Ø 0.76 m · 300 ft³)</option>
                </select>
              </label>
              <label class="calc-field">
                <span>{isEs ? 'Velocidad Gas Jg (cm/s):' : 'Gas Velocity Jg (cm/s):'}</span>
                <input type="number" id="celdas-jg-input" min="0.6" max="3.0" step="0.1" value="1.5" class="smat-input-control" />
              </label>
              <label class="calc-field">
                <span>{isEs ? 'Burbuja Sauter d32 (mm):' : 'Sauter Bubble d32 (mm):'}</span>
                <input type="number" id="celdas-d32-input" min="0.9" max="2.8" step="0.1" value="1.6" class="smat-input-control" />
              </label>
              <label class="calc-field">
                <span>{isEs ? 'Velocidad Rotor (RPM):' : 'Rotor Speed (RPM):'}</span>
                <input type="number" id="celdas-rpm-input" min="120" max="380" step="5" value="215" class="smat-input-control" />
              </label>
              <label class="calc-field">
                <span>{isEs ? 'Granulometría d80 (µm):' : 'Grind Size d80 (µm):'}</span>
                <input type="number" id="celdas-d80-input" min="25" max="850" step="10" value="150" class="smat-input-control" />
              </label>
              <label class="calc-field">
                <span>{isEs ? 'Sólidos Pulpa Cw (%):' : 'Pulp Solids Cw (%):'}</span>
                <input type="number" id="celdas-cw-input" min="15" max="65" step="1" value="35" class="smat-input-control" />
              </label>
            </div>

            <details class="tier2-flot-details smat-mt-sm">
              <summary class="tier2-flot-summary">
                {isEs
                  ? 'Calibración Cinética Avanzada (Flotabilidad P y Recuperación en Espuma Rf)'
                  : 'Advanced Ore Kinetics (Floatability P & Froth Recovery Rf)'}
              </summary>
              <div class="smat-inputs-2col smat-panel-soft smat-mt-sm">
                <label class="calc-field">
                  <span>{isEs ? 'Flotabilidad Mineral P:' : 'Ore Floatability P:'}</span>
                  <input type="number" id="celdas-p-input" min="0.0005" max="0.020" step="0.0005" value="0.0045" class="smat-input-control" />
                </label>
                <label class="calc-field">
                  <span>{isEs ? 'Recuperación Espuma Rf:' : 'Froth Recovery Rf:'}</span>
                  <input type="number" id="celdas-rf-input" min="0.20" max="1.00" step="0.02" value="0.78" class="smat-input-control" />
                </label>
              </div>
            </details>

            <div class="smat-cta-row">
              <a
                href={`${quoteBase}?circuito=flotacion&equipo=${quoteEquipo}&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq`}
                data-quote-base={quoteBase}
                class="btn btn-primary smat-tap-btn"
              >
                {isEs ? 'Cotizar Calibrado →' : 'Quote Calibrated Unit →'}
              </a>
              <button
                type="button"
                class="btn btn-outline btn-avenue-tray smat-tap-btn"
                data-vertical-tray-btn
                data-add-tray-sku={variant === 'cells' ? 'SMAT-FLOT-CELL-100' : 'SMAT-FLOT-MECH-18SP'}
                data-tray-part-code="Ø0.61m"
                data-tray-title={isEs ? 'Mecanismo Rotor-Estator Flotación (Ø0.61 m)' : 'Flotation Rotor-Stator Assembly (Ø0.61 m)'}
                data-tray-series={variant === 'cells' ? '100ft' : '0.61m'}
                data-tray-material="PU_SHORE90"
                data-tray-circuit="flotacion"
                data-tray-source={`flotation_${variant}_stratum1_calc`}
              >
                {isEs ? '+ Bandeja Mecanismo 18SP' : '+ Tray 18SP Mechanism'}
              </button>
              {variant === 'cells' && (
                <>
                  <a href={`${productsBase}${isEs ? 'mecanismo-suspendido-flotacion-18sp/' : 'suspended-flotation-mechanism-18sp/'}`} class="btn btn-outline">
                    SMAT-FLOT-MECH-18SP →
                  </a>
                  <a href={`${quoteBase}?circuito=flotacion&equipo=rotor_estator&serie=100ft#rfq`} class="btn btn-outline">
                    {isEs ? 'Cotizar Kit Rotor + Estator →' : 'Quote Rotor + Stator Kit →'}
                  </a>
                </>
              )}
            </div>
          </div>

          <div class="smat-mb-md">
            <TechnicalDiagrams diagram="flotation" lang={lang} />
          </div>

          {variant === 'hub' ? (
            <>
              <div class="grid-2 smat-mb-md">
                <div class="card">
                  <h3>{isEs ? 'Mecanismos para Celdas de Flotación y Acondicionadores' : 'Flotation Cell & Conditioner Mechanisms'}</h3>
                  <p>
                    {isEs
                      ? 'Conjuntos motrices completos (cabezal vertical, polea, columna concéntrica y flecha) para bancos Rougher, Cleaner y Scavenger y acondicionadores.'
                      : 'Complete vertical drive units (bearing pedestal, pulley, concentric air column & shaft) for Rougher, Cleaner & Scavenger cells.'}
                  </p>
                  <p class="smat-mono-val">{isEs ? 'Capacidad: 50 ft³ a 300 ft³ • 15 a 60 HP' : 'Capacity: 50 ft³ to 300 ft³ • 15 to 60 HP'}</p>
                  <div class="smat-cta-row">
                    <a href={`${flotBase}${isEs ? 'celdas/' : 'cells/'}`} data-subroute-link={`${flotBase}${isEs ? 'celdas/' : 'cells/'}`} class="btn btn-outline">
                      {isEs ? 'Ficha Técnica' : 'Technical Sheet'}
                    </a>
                    <a href={`${quoteBase}?circuito=flotacion&equipo=celda_flotacion&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq`} class="btn btn-primary">
                      {isEs ? 'Cotizar →' : 'Quote →'}
                    </a>
                  </div>
                </div>

                <div class="card">
                  <h3>{isEs ? 'Rotores, Estatores, Propelas y Flechas' : 'Rotors, Stators, Propellers & Shafts'}</h3>
                  <p>
                    {isEs
                      ? 'Impulsores/rotores, difusores/estatores y propelas recubiertos en hule natural o poliuretano minero para resistir reactivos.'
                      : 'Wear-molded rotors, diffusers & agitator propellers in natural rubber or mining polyurethane.'}
                  </p>
                  <p class="smat-mono-val">{isEs ? 'Material: Hule R55 y Poliuretano U01' : 'Material: R55 Rubber & U01 Polyurethane'}</p>
                  <div class="smat-cta-row">
                    <a href={`${flotBase}${isEs ? 'mecanismos/' : 'mechanisms/'}`} class="btn btn-outline">
                      {isEs ? 'Ficha Técnica' : 'Technical Sheet'}
                    </a>
                    <a href={`${productsBase}${isEs ? 'mecanismo-suspendido-flotacion-18sp/' : 'suspended-flotation-mechanism-18sp/'}`} class="btn btn-outline">
                      SMAT-FLOT-MECH-18SP →
                    </a>
                  </div>
                </div>
              </div>

              <div class="card dropin-matrix-card" id="flotation-dropin-matrix">
                <span class="badge badge-copper" data-smat-decision="D8">
                  {isEs ? 'INTERCAMBIABILIDAD HIDRODINÁMICA 1:1' : '1:1 HYDRODYNAMIC DROP-IN FIT'}
                </span>
                <h2>{isEs ? 'Matriz de Compatibilidad Geométrica Drop-In (Rotor-Estator y Cabezales)' : 'Drop-In Dimensional Compatibility Matrix'}</h2>
                <p class="matrix-sub">
                  {isEs
                    ? 'Sustitución directa en bancos existentes sin modificar bridas de faldón ni centros de pernos. Conserva velocidad periférica u₂ y dispersión de gas Jg.'
                    : 'Direct drop-in replacement without tank or bridge modification, preserving peripheral tip speed u₂ and superficial gas flux Jg.'}
                </p>
                <div class="table-scroll">
                  <table class="spec-table">
                    <thead>
                      <tr>
                        <th>{isEs ? 'Arquitectura de Celda' : 'Cell Architecture'}</th>
                        <th>{isEs ? 'Volumen Nominal' : 'Nominal Volume'}</th>
                        <th>D<sub>r</sub> / D<sub>s</sub></th>
                        <th>N<sub>Q</sub></th>
                        <th>{isEs ? 'Vel. Periférica u₂' : 'Tip Speed u₂'}</th>
                        <th>J<sub>g</sub></th>
                        <th>SKU</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td><strong>{isEs ? 'Auto-Aspirantes Tipo 1+1' : '1+1 Self-Aspirating Cells'}</strong></td>
                        <td>50 – 100 ft³</td>
                        <td><code>0.70 ± 0.02</code></td>
                        <td><code>0.22</code></td>
                        <td><code>6.1 – 6.6 m/s</code></td>
                        <td><code>1.2 – 1.5 cm/s</code></td>
                        <td><a href={`${productsBase}${isEs ? 'mecanismo-suspendido-flotacion-18sp/' : 'suspended-flotation-mechanism-18sp/'}`}>SMAT-FLOT-MECH-18SP →</a></td>
                      </tr>
                      <tr>
                        <td><strong>{isEs ? 'Aire Forzado TankCell Industrial' : 'Industrial TankCell Forced Air'}</strong></td>
                        <td>100 – 300 ft³</td>
                        <td><code>0.72 ± 0.02</code></td>
                        <td><code>0.26</code></td>
                        <td><code>6.3 – 6.8 m/s</code></td>
                        <td><code>1.4 – 1.8 cm/s</code></td>
                        <td><a href={`${productsBase}${isEs ? 'mecanismo-suspendido-flotacion-18sp/' : 'suspended-flotation-mechanism-18sp/'}`}>SMAT-FLOT-MECH-18SP →</a></td>
                      </tr>
                      <tr>
                        <td><strong>{isEs ? 'Tanques Acondicionadores' : 'High-Shear Conditioners'}</strong></td>
                        <td>5x5 – 12x12 ft</td>
                        <td><code>0.68 ± 0.02</code></td>
                        <td><code>0.48</code></td>
                        <td><code>5.8 – 6.4 m/s</code></td>
                        <td><code>{isEs ? 'Flujo Axial' : 'Axial Flow'}</code></td>
                        <td><a href={`${productsBase}${isEs ? 'mecanismo-suspendido-flotacion-18sp/' : 'suspended-flotation-mechanism-18sp/'}`}>SMAT-FLOT-MECH-18SP →</a></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </>
          ) : (
            <>
              <h2>{variant === 'cells'
                ? (isEs ? 'Ingeniería de Dispersión de Aire y Suspensión de Pulpa' : 'Air Dispersion & Solids Suspension Engineering')
                : (isEs ? 'Geometría de Impulsor y Difusor' : 'Impeller & Diffuser Geometry')}</h2>
              <p>
                {variant === 'cells'
                  ? (isEs
                      ? 'Los mecanismos para celdas de flotación y acondicionadores SMAT maximizan el contacto partícula-burbuja y evitan sedimentación de sulfuros gruesos.'
                      : 'SMAT flotation mechanisms and conditioners maximize particle-bubble collision and suspend coarse sulfides without dead zones.')
                  : (isEs
                      ? 'El desgaste en las aristas del impulsor y difusor eleva el tamaño de burbuja y reduce la recuperación metalúrgica.'
                      : 'Edge wear increases bubble Sauter diameter and hurts recovery; SMAT steel-cored PU and R55 parts hold tight hydrodynamic shear.')}
              </p>

              <table class="tech-table">
                <thead>
                  <tr>
                    <th>{isEs ? 'Parámetro' : 'Parameter'}</th>
                    <th>{isEs ? 'Especificación Técnica SMAT' : 'SMAT Engineering Specification'}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>{isEs ? 'Rango de Celda' : 'Cell Volume Range'}</td>
                    <td>50 ft³ (1.4 m³), 100 ft³ (2.8 m³), 200 ft³ (5.6 m³), 300 ft³ (8.5 m³)</td>
                  </tr>
                  <tr>
                    <td>{isEs ? 'Despiece en 5 Zonas Drop-In' : '5-Zone Drop-In Retrofit'}</td>
                    <td>{isEs ? 'Cabezal, Eje Hueco, Tubo de Tiro, Rotor Estrella y Difusor/Estator (#18 SP, #24, #30)' : 'Pedestal, Hollow Shaft, Draft Tube, Star Rotor & Stator (#18 SP, #24, #30)'}</td>
                  </tr>
                  <tr>
                    <td>{isEs ? 'Elastómeros en Contacto Húmedo' : 'Wet-End Elastomers'}</td>
                    <td>{isEs ? 'Poliuretano U01 (85–95 Shore A) y Hule Natural R55 (60–65 Shore A)' : 'U01 Polyurethane (85–95 Shore A) & R55 Natural Rubber (60–65 Shore A)'}</td>
                  </tr>
                  <tr>
                    <td>{isEs ? 'Cinética JKMRC Gorain (1997)' : 'JKMRC Gorain Kinetics (1997)'}</td>
