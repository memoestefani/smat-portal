---
/**
 * FlotationCalculatorIsland.astro
 * ---------------------------------------------------------------------------
 * Isla Canónica Bilingüe Única de Flotación (`D3-V51` / `SLICE-V51-14`):
 *   - Cero bifurcaciones duales `{mode}`.
 *   - Monta `<FlotationCore />` único compartido exponiendo `P`, `R_f` y `recommendedSkuId`.
 */
import FlotationCore from '../cores/FlotationCore.astro';
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import CircuitNavigator from '../CircuitNavigator.astro';
import SharePurchasing from '../SharePurchasing.astro';
import rolesData from '../../../data/roles.json';

interface Props {
  locale?: 'es' | 'en';
  variant?: 'hub' | 'cells' | 'mechanisms';
  mode?: 'standalone' | 'embedded';
}

const {
  locale = 'es',
  variant = 'hub',
  mode = 'standalone',
} = Astro.props;

const isEs = locale === 'es';
const lang = locale;
const showVerticalShell = mode === 'standalone';

const flotVertical = rolesData.verticals.find((v) => v.id === 'flotacion');
const roleIdTarget = variant === 'mechanisms' ? 'mecanismos_flotacion' : 'celda_completa';
const activeRole =
  flotVertical?.capex?.find((r) => r.role_id === roleIdTarget) ||
  flotVertical?.opex?.find((r) => r.role_id === roleIdTarget) ||
  flotVertical?.capex?.[0];
const criteria = activeRole?.decision_criteria;

const stratumId =
  variant === 'cells'
    ? 'stratum1-cells-sim'
    : variant === 'mechanisms'
      ? 'stratum1-mechanisms-sim'
      : 'stratum1-flotation-sim';

const quoteBase = isEs ? '/cotizar/' : '/en/quote/';
const flotBase = isEs ? '/flotacion/' : '/en/flotation/';
const productsBase = isEs ? '/productos/' : '/en/products/';
const quoteEquipo = variant === 'mechanisms' ? 'rotor_estator' : 'celda_flotacion';
---

{showVerticalShell && (
  <div class="flot-standalone-wrap" data-island-standalone="flotation">
    <section class={`page-hero ${variant !== 'hub' ? 'smat-compact-hero' : ''}`}>
      <div class="container">
        <div class="smat-flex-between">
          <h1>
            {variant === 'mechanisms'
              ? (isEs ? 'Impulsores y Difusores de Flotación' : 'Flotation Impellers, Diffusers & Spares')
              : (isEs ? 'Mecanismos para Celdas de Flotación y Acondicionadores' : 'Flotation Cell Mechanisms & Conditioners')}
          </h1>
          <span class={`badge ${variant === 'cells' ? 'badge-opex' : 'badge-copper'}`}>
            {variant === 'mechanisms'
              ? (isEs ? 'REFACCIONES DE FLOTACIÓN • POLIURETANO Y HULE' : 'FLOTATION WEAR PARTS • POLYURETHANE & RUBBER')
              : variant === 'cells'
                ? (isEs ? 'MECANISMOS SUSPENDIDOS Y RETROFIT DROP-IN • 50 A 300 FT³' : 'SUSPENDED MECHANISMS & DROP-IN RETROFIT • 50 TO 300 FT³')
                : (isEs ? 'FLOTACIÓN Y ACONDICIONAMIENTO' : 'FLOTATION & CONDITIONING')}
          </span>
        </div>
        <p class={variant !== 'hub' ? 'smat-hero-sub' : 'hero-lead'}>
          {variant === 'mechanisms'
            ? (isEs
                ? 'Repuestos en poliuretano y hule para mecanismos de celdas de flotación y acondicionadores (50 a 300 ft³).'
                : 'Polyurethane and molded rubber replacement rotors, diffusers, and coated shafts for 50 to 300 ft³ cells.')
            : (isEs
                ? 'Calibre flujo superficial de burbuja Gorain (Sb = 6 Jg / d32), tasa cinética (k = P·Sb·Rf) y suspensión Zwietering Njs sin obra civil.'
                : 'Calibrate Gorain bubble surface area flux (Sb = 6 Jg / d32), kinetic rate (k = P·Sb·Rf), and Zwietering solids suspension speed Njs.')}
        </p>
      </div>
    </section>

    <section class={`section ${variant !== 'hub' ? 'section-spacing smat-stage-compact' : ''}`} id="flotacion-main-section">
      <div class={`container ${variant !== 'hub' ? 'content-container' : ''}`}>
        <div class={variant !== 'hub' ? 'card detail-card' : ''}>
          <div class="flotation-5zone-box" id={stratumId} data-cell-dropin-matrix="gorain-1997" data-stratum-1-instrument>
            <FlotationCore locale={locale} variant={variant} showVerticalActions={true} panelClass="flot-core-standalone" />
          </div>

          <div class="smat-mb-md">
            <TechnicalDiagrams diagram="flotation" lang={lang} />
          </div>

          {variant === 'hub' ? (
            <>
              <div class="grid-2 smat-mb-md">
                <div class="card">
                  <h3>{isEs ? 'Mecanismos para Celdas de Flotación y Acondicionadores' : 'Flotation Cell & Conditioner Mechanisms'}</h3>
                  <p>
                    {isEs
                      ? 'Conjuntos motrices completos (cabezal vertical, polea, columna concéntrica y flecha) para bancos Rougher, Cleaner y Scavenger y acondicionadores.'
                      : 'Complete vertical drive units (bearing pedestal, pulley, concentric air column & shaft) for Rougher, Cleaner & Scavenger cells.'}
                  </p>
                  <p class="smat-mono-val">{isEs ? 'Capacidad: 50 ft³ a 300 ft³ • 15 a 60 HP' : 'Capacity: 50 ft³ to 300 ft³ • 15 to 60 HP'}</p>
                  <div class="smat-cta-row">
                    <a href={`${flotBase}${isEs ? 'celdas/' : 'cells/'}`} data-subroute-link={`${flotBase}${isEs ? 'celdas/' : 'cells/'}`} class="btn btn-outline">
                      {isEs ? 'Ficha Técnica' : 'Technical Sheet'}
                    </a>
                    <a href={`${quoteBase}?circuito=flotacion&equipo=celda_flotacion&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq`} class="btn btn-primary">
                      {isEs ? 'Cotizar →' : 'Quote →'}
                    </a>
                  </div>
                </div>

                <div class="card">
                  <h3>{isEs ? 'Rotores, Estatores, Propelas y Flechas' : 'Rotors, Stators, Propellers & Shafts'}</h3>
                  <p>
                    {isEs
                      ? 'Impulsores/rotores, difusores/estatores y propelas recubiertos en hule natural o poliuretano minero para resistir reactivos.'
                      : 'Wear-molded rotors, diffusers & agitator propellers in natural rubber or mining polyurethane.'}
                  </p>
                  <p class="smat-mono-val">{isEs ? 'Material: Hule R55 y Poliuretano U01' : 'Material: R55 Rubber & U01 Polyurethane'}</p>
                  <div class="smat-cta-row">
                    <a href={`${flotBase}${isEs ? 'mecanismos/' : 'mechanisms/'}`} class="btn btn-outline">
                      {isEs ? 'Ficha Técnica' : 'Technical Sheet'}
                    </a>
                    <a href={`${productsBase}${isEs ? 'mecanismo-suspendido-flotacion-18sp/' : 'suspended-flotation-mechanism-18sp/'}`} class="btn btn-outline">
                      SMAT-FLOT-MECH-18SP →
                    </a>
                  </div>
                </div>
              </div>

              <div class="card dropin-matrix-card" id="flotation-dropin-matrix">
                <span class="badge badge-copper" data-smat-decision="D8">
                  {isEs ? 'INTERCAMBIABILIDAD HIDRODINÁMICA 1:1' : '1:1 HYDRODYNAMIC DROP-IN FIT'}
                </span>
                <h2>{isEs ? 'Matriz de Compatibilidad Geométrica Drop-In (Rotor-Estator y Cabezales)' : 'Drop-In Dimensional Compatibility Matrix'}</h2>
                <p class="matrix-sub">
                  {isEs
                    ? 'Sustitución directa en bancos existentes sin modificar bridas de faldón ni centros de pernos. Conserva velocidad periférica u₂ y dispersión de gas Jg.'
                    : 'Direct drop-in replacement without tank or bridge modification, preserving peripheral tip speed u₂ and superficial gas flux Jg.'}
                </p>
                <div class="table-scroll">
                  <table class="spec-table">
                    <thead>
                      <tr>
                        <th>{isEs ? 'Arquitectura de Celda' : 'Cell Architecture'}</th>
                        <th>{isEs ? 'Volumen Nominal' : 'Nominal Volume'}</th>
                        <th>D<sub>r</sub> / D<sub>s</sub></th>
                        <th>N<sub>Q</sub></th>
                        <th>{isEs ? 'Vel. Periférica u₂' : 'Tip Speed u₂'}</th>
                        <th>J<sub>g</sub></th>
                        <th>SKU</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td><strong>{isEs ? 'Auto-Aspirantes Tipo 1+1' : '1+1 Self-Aspirating Cells'}</strong></td>
                        <td>50 – 100 ft³</td>
                        <td><code>0.70 ± 0.02</code></td>
                        <td><code>0.22</code></td>
                        <td><code>6.1 – 6.6 m/s</code></td>
                        <td><code>1.2 – 1.5 cm/s</code></td>
                        <td><a href={`${productsBase}${isEs ? 'mecanismo-suspendido-flotacion-18sp/' : 'suspended-flotation-mechanism-18sp/'}`}>SMAT-FLOT-MECH-18SP →</a></td>
                      </tr>
                      <tr>
                        <td><strong>{isEs ? 'Aire Forzado TankCell Industrial' : 'Industrial TankCell Forced Air'}</strong></td>
                        <td>100 – 300 ft³</td>
                        <td><code>0.72 ± 0.02</code></td>
                        <td><code>0.26</code></td>
                        <td><code>6.3 – 6.8 m/s</code></td>
                        <td><code>1.4 – 1.8 cm/s</code></td>
                        <td><a href={`${productsBase}${isEs ? 'mecanismo-suspendido-flotacion-18sp/' : 'suspended-flotation-mechanism-18sp/'}`}>SMAT-FLOT-MECH-18SP →</a></td>
                      </tr>
                      <tr>
                        <td><strong>{isEs ? 'Tanques Acondicionadores' : 'High-Shear Conditioners'}</strong></td>
                        <td>5x5 – 12x12 ft</td>
                        <td><code>0.68 ± 0.02</code></td>
                        <td><code>0.48</code></td>
                        <td><code>5.8 – 6.4 m/s</code></td>
                        <td><code>{isEs ? 'Flujo Axial' : 'Axial Flow'}</code></td>
                        <td><a href={`${productsBase}${isEs ? 'mecanismo-suspendido-flotacion-18sp/' : 'suspended-flotation-mechanism-18sp/'}`}>SMAT-FLOT-MECH-18SP →</a></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </>
          ) : (
            <>
              <h2>{variant === 'cells'
                ? (isEs ? 'Ingeniería de Dispersión de Aire y Suspensión de Pulpa' : 'Air Dispersion & Solids Suspension Engineering')
                : (isEs ? 'Geometría de Impulsor y Difusor' : 'Impeller & Diffuser Geometry')}</h2>
              <p>
                {variant === 'cells'
                  ? (isEs
                      ? 'Los mecanismos para celdas de flotación y acondicionadores SMAT maximizan el contacto partícula-burbuja y evitan sedimentación de sulfuros gruesos.'
                      : 'SMAT flotation mechanisms and conditioners maximize particle-bubble collision and suspend coarse sulfides without dead zones.')
                  : (isEs
                      ? 'El desgaste en las aristas del impulsor y difusor eleva el tamaño de burbuja y reduce la recuperación metalúrgica.'
                      : 'Edge wear increases bubble Sauter diameter and hurts recovery; SMAT steel-cored PU and R55 parts hold tight hydrodynamic shear.')}
              </p>

              <table class="tech-table">
                <thead>
                  <tr>
                    <th>{isEs ? 'Parámetro' : 'Parameter'}</th>
                    <th>{isEs ? 'Especificación Técnica SMAT' : 'SMAT Engineering Specification'}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>{isEs ? 'Rango de Celda' : 'Cell Volume Range'}</td>
                    <td>50 ft³ (1.4 m³), 100 ft³ (2.8 m³), 200 ft³ (5.6 m³), 300 ft³ (8.5 m³)</td>
                  </tr>
                  <tr>
                    <td>{isEs ? 'Despiece en 5 Zonas Drop-In' : '5-Zone Drop-In Retrofit'}</td>
                    <td>{isEs ? 'Cabezal, Eje Hueco, Tubo de Tiro, Rotor Estrella y Difusor/Estator (#18 SP, #24, #30)' : 'Pedestal, Hollow Shaft, Draft Tube, Star Rotor & Stator (#18 SP, #24, #30)'}</td>
                  </tr>
                  <tr>
                    <td>{isEs ? 'Elastómeros en Contacto Húmedo' : 'Wet-End Elastomers'}</td>
                    <td>{isEs ? 'Poliuretano U01 (85–95 Shore A) y Hule Natural R55 (60–65 Shore A)' : 'U01 Polyurethane (85–95 Shore A) & R55 Natural Rubber (60–65 Shore A)'}</td>
                  </tr>
                  <tr>
                    <td>{isEs ? 'Cinética JKMRC Gorain (1997)' : 'JKMRC Gorain Kinetics (1997)'}</td>
                    <td>S<sub>b</sub> = 6 J<sub>g</sub> / d<sub>32</sub> (50–65 s⁻¹) · k = P · S<sub>b</sub> · R<sub>f</sub></td>
                  </tr>
                </tbody>
              </table>

              {criteria && (
                <div class="decision-criteria-panel" data-testid="role-decision-criteria">
                  <span class={`badge ${variant === 'cells' ? 'badge-opex' : 'badge-copper'}`}>{isEs ? 'CRITERIOS DE DECISIÓN METALÚRGICA EN PLANTA' : 'PLANT METALLURGICAL SELECTION MATRIX'}</span>
                  <h3>{isEs ? `Matriz de Selección (${activeRole?.series})` : `Selection Matrix (${activeRole?.series})`}</h3>
                  <div class="smat-grid-3">
                    <div class="smat-panel-soft">
                      <strong class="criteria-label">{isEs ? 'Variables Requeridas' : 'Required Slurry Vars'}</strong>
                      <span>{isEs ? criteria.required_slurry_vars_es : criteria.required_slurry_vars_en}</span>
                    </div>
                    <div class="smat-panel-soft">
                      <strong class="criteria-label-solar">{isEs ? 'Regla de Elastómero y Eje' : 'Elastomer & Shaft Rule'}</strong>
                      <span>{isEs ? criteria.metallurgy_rule_es : criteria.metallurgy_rule_en}</span>
                    </div>
                    <div class="smat-panel-soft">
                      <strong class="criteria-label-emerald">{isEs ? 'Riesgo Mitigado' : 'Mitigated Plant Risk'}</strong>
                      <span>{isEs ? criteria.risk_avoided_es : criteria.risk_avoided_en}</span>
                    </div>
                  </div>
                </div>
              )}

              <div class="flotation-selector-box" data-testid="flotation-contextual-selector">
                <span class={`badge ${variant === 'cells' ? 'badge-opex' : 'badge-copper'}`}>{isEs ? 'PRE-SELECCIÓN CONTEXTUAL • PUENTE A COTIZADOR' : 'CONTEXTUAL PRE-SELECTION • QUOTE BRIDGE'}</span>
                <h3>{isEs ? 'Seleccione Volumen de Celda y Condición Operativa' : 'Select Cell Volume & Duty Regime'}</h3>
                <div class="smat-cta-row">
                  <a href={`${quoteBase}?circuito=flotacion&equipo=${quoteEquipo}&serie=50ft&flot_condition=sulfuros_alta_agitacion#rfq`} class="btn btn-outline">50 ft³ • {isEs ? 'Sulfuros' : 'Sulfides'}</a>
                  <a href={`${quoteBase}?circuito=flotacion&equipo=${quoteEquipo}&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq`} class="btn btn-outline">100 ft³ • {isEs ? 'Sulfuros' : 'Sulfides'}</a>
                  <a href={`${quoteBase}?circuito=flotacion&equipo=${quoteEquipo}&serie=200ft&flot_condition=reactivos_espuma#rfq`} class="btn btn-outline">200 ft³ • {isEs ? 'Reactivos' : 'Reagents'}</a>
                  <a href={`${quoteBase}?circuito=flotacion&equipo=${quoteEquipo}&serie=300ft&flot_condition=arena_gruesa_fondo#rfq`} class="btn btn-outline">300 ft³ • {isEs ? 'Arena Gruesa' : 'Coarse Sand'}</a>
                </div>
              </div>
            </>
          )}

          <SharePurchasing
            roleTitle={variant === 'mechanisms'
              ? (isEs ? 'Impulsor y Difusor de Celda de Flotación' : 'Flotation Cell Impeller & Diffuser')
              : (isEs ? 'Mecanismos para Celdas de Flotación y Rotor-Estator' : 'Flotation Cell Mechanisms & Rotor-Stator')}
            partCode="SMAT-FLOT-MECH-18SP"
            specs={isEs ? 'Cotejo Drop-In 1:1 en 5 zonas (#18 SP, #24, #30) · Gorain Sb ≥ 50 s⁻¹' : 'Drop-In 1:1 across 5 zones (#18 SP, #24, #30) · Gorain Sb ≥ 50 s⁻¹'}
            metallurgy={isEs ? 'Poliuretano U01 (85–95 Shore A) / Hule Natural R55' : 'Polyurethane U01 (85–95 Shore A) / R55 Natural Rubber'}
            series="50 ft³ – 300 ft³"
            roleId={variant === 'mechanisms' ? 'rotor_estator' : 'celda_flotacion'}
            circuit="flotacion"
            lang={lang}
          />
        </div>
      </div>
    </section>

    {variant === 'hub' && (
      <section class="section circuit-nav-band">
        <div class="container">
          <CircuitNavigator lang={lang} defaultCircuit="flotacion_polimetalica" />
        </div>
      </section>
    )}
  </div>
)}

{!showVerticalShell && (
  <FlotationCore locale={locale} variant={variant} showVerticalActions={false} panelClass="hidden embedded-flot-box" />
)}

<script>
  import { bindCanonicalFlotationCalculator } from '../../scripts/verticalCalculatorsAndLabelsBridge.js';

  function initFlotationIsland() {
    const standaloneRoot = document.querySelector('[data-island-standalone="flotation"]');
    if (!standaloneRoot) return;
    const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
    bindCanonicalFlotationCalculator(standaloneRoot, lang);
  }

  initFlotationIsland();
  document.addEventListener('astro:page-load', initFlotationIsland);
</script>

<style>
  .page-hero { background-color: #ffffff; color: var(--smat-text-primary); padding: 1rem 0; border-bottom: 2px solid var(--smat-solar-accent, #7c2d12); }
  .page-hero h1 { color: var(--smat-text-primary); margin: 0; font-size: 1.65rem; }
  .hero-lead { font-size: 0.94rem; max-width: 760px; color: var(--smat-text-secondary); margin: 0.35rem 0 0; }
  .content-container { max-width: 920px; margin: 0 auto; }
  .flotation-5zone-box {
    margin-bottom: 1.25rem;
    padding: clamp(0.75rem, 1.5vw, 1.2rem);
    border-radius: 10px;
    background: #f8fafc;
    color: var(--smat-text-primary);
    border: 1.5px solid #cbd5e1;
    border-left: 4px solid #7c2d12;
  }
  .gorain-readout-banner {
    padding: 0.6rem 0.8rem;
    border-radius: 6px;
    background: #ecfdf5;
    border: 1px solid #059669;
    color: #064e3b;
    font-family: var(--smat-font-mono);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .tier2-flot-details { border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.4rem 0.75rem; background: #ffffff; }
  .tier2-flot-summary { cursor: pointer; font-weight: 700; font-size: 0.8rem; color: #7c2d12; min-height: 48px; display: flex; align-items: center; }
  .smat-tap-btn { min-height: 48px; display: inline-flex; align-items: center; }
  .dropin-matrix-card { margin-top: 1.5rem; padding: 1.4rem; }
  .matrix-sub { color: var(--smat-text-secondary); margin-bottom: 1rem; font-size: 0.9rem; }
  .table-scroll { overflow-x: auto; }
  .spec-table, .tech-table { width: 100%; border-collapse: collapse; font-size: 0.86rem; margin-bottom: 1.25rem; }
  .spec-table th, .spec-table td, .tech-table th, .tech-table td { padding: 0.65rem; border-bottom: 1px solid #e2e8f0; text-align: left; }
  .spec-table thead tr, .tech-table thead tr { background: #f8fafc; border-bottom: 2px solid #cbd5e1; }
  .decision-criteria-panel { margin-bottom: 1.5rem; padding: 1.2rem; border-radius: 10px; background: #f8fafc; border: 1px solid #cbd5e1; border-left: 4px solid #7c2d12; }
  .criteria-label { display: block; color: #0f172a; margin-bottom: 0.2rem; }
  .criteria-label-solar { display: block; color: #7c2d12; margin-bottom: 0.2rem; }
  .criteria-label-emerald { display: block; color: #064e3b; margin-bottom: 0.2rem; }
  .flotation-selector-box { margin-bottom: 1.5rem; padding: 1.2rem; border-radius: 10px; background: #fffbeb; border: 1px solid #fde68a; }
  .circuit-nav-band { background-color: #ffffff; border-top: 1px solid var(--smat-border-light); border-bottom: 1px solid var(--smat-border-light); }
  .embedded-flot-box { margin-top: 0.65rem; padding: 0.75rem 0.9rem; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px; }
  .embedded-title { font-family: var(--smat-font-mono); font-size: 0.74rem; color: #0c4a6e; }
  .embedded-badge { font-family: var(--smat-font-mono); font-size: 0.68rem; background: #064e3b; color: #ffffff; padding: 0.15rem 0.5rem; border-radius: 4px; }
  .embedded-res-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.35rem; font-size: 0.72rem; color: #0f172a; }
  .embedded-res-cell { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px; padding: 0.3rem 0.45rem; }
</style>
