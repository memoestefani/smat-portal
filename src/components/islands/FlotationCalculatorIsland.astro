                  </tr>
                </tbody>
              </table>

              {criteria && (
                <div class="decision-criteria-panel" data-testid="role-decision-criteria">
                  <span class={`badge ${variant === 'cells' ? 'badge-opex' : 'badge-copper'}`}>{isEs ? 'CRITERIOS DE DECISIÓN METALÚRGICA EN PLANTA' : 'PLANT METALLURGICAL SELECTION MATRIX'}</span>
                  <h3>{isEs ? `Matriz de Selección (${activeRole?.series})` : `Selection Matrix (${activeRole?.series})`}</h3>
                  <div class="smat-grid-3">
                    <div class="smat-panel-soft">
                      <strong class="criteria-label">{isEs ? 'Variables Requeridas' : 'Required Slurry Vars'}</strong>
                      <span>{isEs ? criteria.required_slurry_vars_es : criteria.required_slurry_vars_en}</span>
                    </div>
                    <div class="smat-panel-soft">
                      <strong class="criteria-label-solar">{isEs ? 'Regla de Elastómero y Eje' : 'Elastomer & Shaft Rule'}</strong>
                      <span>{isEs ? criteria.metallurgy_rule_es : criteria.metallurgy_rule_en}</span>
                    </div>
                    <div class="smat-panel-soft">
                      <strong class="criteria-label-emerald">{isEs ? 'Riesgo Mitigado' : 'Mitigated Plant Risk'}</strong>
                      <span>{isEs ? criteria.risk_avoided_es : criteria.risk_avoided_en}</span>
                    </div>
                  </div>
                </div>
              )}

              <div class="flotation-selector-box" data-testid="flotation-contextual-selector">
                <span class={`badge ${variant === 'cells' ? 'badge-opex' : 'badge-copper'}`}>{isEs ? 'PRE-SELECCIÓN CONTEXTUAL • PUENTE A COTIZADOR' : 'CONTEXTUAL PRE-SELECTION • QUOTE BRIDGE'}</span>
                <h3>{isEs ? 'Seleccione Volumen de Celda y Condición Operativa' : 'Select Cell Volume & Duty Regime'}</h3>
                <div class="smat-cta-row">
                  <a href={`${quoteBase}?circuito=flotacion&equipo=${quoteEquipo}&serie=50ft&flot_condition=sulfuros_alta_agitacion#rfq`} class="btn btn-outline">50 ft³ • {isEs ? 'Sulfuros' : 'Sulfides'}</a>
                  <a href={`${quoteBase}?circuito=flotacion&equipo=${quoteEquipo}&serie=100ft&flot_condition=sulfuros_alta_agitacion#rfq`} class="btn btn-outline">100 ft³ • {isEs ? 'Sulfuros' : 'Sulfides'}</a>
                  <a href={`${quoteBase}?circuito=flotacion&equipo=${quoteEquipo}&serie=200ft&flot_condition=reactivos_espuma#rfq`} class="btn btn-outline">200 ft³ • {isEs ? 'Reactivos' : 'Reagents'}</a>
                  <a href={`${quoteBase}?circuito=flotacion&equipo=${quoteEquipo}&serie=300ft&flot_condition=arena_gruesa_fondo#rfq`} class="btn btn-outline">300 ft³ • {isEs ? 'Arena Gruesa' : 'Coarse Sand'}</a>
                </div>
              </div>
            </>
          )}

          <SharePurchasing
            roleTitle={variant === 'mechanisms'
              ? (isEs ? 'Impulsor y Difusor de Celda de Flotación' : 'Flotation Cell Impeller & Diffuser')
              : (isEs ? 'Mecanismos para Celdas de Flotación y Rotor-Estator' : 'Flotation Cell Mechanisms & Rotor-Stator')}
            partCode="SMAT-FLOT-MECH-18SP"
            specs={isEs ? 'Cotejo Drop-In 1:1 en 5 zonas (#18 SP, #24, #30) · Gorain Sb ≥ 50 s⁻¹' : 'Drop-In 1:1 across 5 zones (#18 SP, #24, #30) · Gorain Sb ≥ 50 s⁻¹'}
            metallurgy={isEs ? 'Poliuretano U01 (85–95 Shore A) / Hule Natural R55' : 'Polyurethane U01 (85–95 Shore A) / R55 Natural Rubber'}
            series="50 ft³ – 300 ft³"
            roleId={variant === 'mechanisms' ? 'rotor_estator' : 'celda_flotacion'}
            circuit="flotacion"
            lang={lang}
          />
        </div>
      </div>
    </section>

    {variant === 'hub' && (
      <section class="section circuit-nav-band">
        <div class="container">
          <CircuitNavigator lang={lang} defaultCircuit="flotacion_polimetalica" />
        </div>
      </section>
    )}
  </div>
)}

<script>
