---
/**
 * CatalogFacetedIsland.astro
 * ---------------------------------------------------------------------------
 * Isla Canónica Bilingüe para /catalogo/ y /en/catalog/ (D2-V50, D4-V50, D7-V50, SLICE-V53-05).
 */
import CatalogAvenuesMatrix from '../CatalogAvenuesMatrix.astro';
import atomicParts from '../../../data/atomic_parts.json';
import rolesData from '../../../data/roles.json';
import { buildCatalogFacetedViewModel } from '../../scripts/catalogFacetedViewModel.js';

interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const isEs = locale === 'es';
const lang = locale;
const quoteBaseHref = isEs ? '/cotizar/#rfq' : '/en/quote/#rfq';

const {
  atomicPartsCount: ATOMIC_PARTS_SSOT_COUNT,
  quickByAvenue,
  catalogIntegrity,
  diagramSurjectivity,
  totalCatalogSkusCount,
  enrichedAtomicParts,
} = buildCatalogFacetedViewModel({ atomicParts, rolesData, locale });
---

<div
  class="catalog-page-container"
  data-domain-root="catalogFacet dropIn"
  data-catalog-integrity={catalogIntegrity.valid ? '1' : '0'}
  data-diagram-surjectivity={diagramSurjectivity.surjective ? '1' : '0'}
  data-avenues-count={String(Object.keys(quickByAvenue).length)}
>
  <section id="stratum1-dropin-verifier" class="card no-print smat-island-card smat-mb-sm" data-stratum-1-instrument data-dropin-verifier data-domain-root="dropIn">
    <div class="smat-flex-between">
      <h1 class="verifier-title">{isEs ? 'Catálogo SMAT Minerals y Buscador 1:1' : 'SMAT Minerals Catalog & 1:1 Search'}</h1>
      <div class="smat-chip-row">
        <button type="button" class="smat-badge-solar part-chip is-active" data-family-chip="all" aria-pressed="true">
          <strong>{totalCatalogSkusCount}</strong> {isEs ? 'Equipos/Kits' : 'Equipment/Kits'}
        </button>
        <button type="button" class="smat-badge-solar part-chip" data-family-chip="atomicas" aria-pressed="false">
          {ATOMIC_PARTS_SSOT_COUNT} {isEs ? 'Piezas Atómicas' : 'Atomic Parts'}
        </button>
      </div>
    </div>

    <div class="catalog-omnibox-bar smat-mt-sm">
      <div class="smat-cta-row compact-row dropin-input-row">
        <input
          id="catalog-facet-search"
          type="search"
          data-dropin-input
          data-omnibox-dropin
          data-schema-input="catalogFacet.searchQuery"
          aria-label={isEs ? 'Buscar producto, SKU o código de pieza' : 'Search product, SKU, or part code'}
          placeholder={isEs ? 'SKU, código o malla ASTM...' : 'SKU, part code, or sieve...'}
          class="smat-search-input full-width-input"
        />
        <button type="button" data-dropin-btn class="smat-btn-primary smat-tap-btn smat-buy-cta">
          {isEs ? 'Verificar 1:1 →' : 'Verify 1:1 Fit →'}
        </button>
      </div>
      <div class="smat-dropin-root-badge font-mono-tech smat-mt-sm hidden" hidden>
        <span>{isEs ? 'Compatibilidad 1:1:' : '1:1 Fit Match:'}</span>
        <code data-dropin-root data-schema-output="dropIn.normalizedRoot">—</code>
        <span data-dropin-alloy data-schema-output="dropIn.alloySuffix" class="smat-dropin-meta-pill">—</span>
        <span data-dropin-sat data-schema-output="dropIn.satTuple" class="smat-dropin-meta-pill">—</span>
      </div>
      <div data-dropin-result data-schema-output="dropIn.canonicalSkuId" class="smat-result-box dropin-result-banner smat-hidden-init" hidden></div>
    </div>
  </section>

  <!-- Grid Visual Abierto V9.0: 19 Equipos/Kits con Foto Real y Botón de Compra Directo -->
  <CatalogAvenuesMatrix lang={lang} />

  <section class="atomic-parts-catalog-block smat-mb-md" id="fichas-atomicas" aria-labelledby="atomic-parts-heading">
    <div class="table-header-flex">
      <div>
        <h2 id="atomic-parts-heading" class="table-title">
          {isEs ? `Refacciones Individuales por Código (${enrichedAtomicParts.length} Piezas)` : `Individual Spares by Part Code (${enrichedAtomicParts.length} Parts)`}
        </h2>
        <span class="table-subtitle">
          {isEs ? 'Piezas sueltas listas para cotejo dimensional 1:1 y cotización directa desde Durango.' : 'Individual wear parts ready for 1:1 fit check and direct quote from Durango.'}
        </span>
      </div>
      <span class="matrix-badge">{enrichedAtomicParts.length} {isEs ? 'PARTES ATÓMICAS' : 'ATOMIC PARTS'}</span>
    </div>
    <div class="smat-sf-grid">
      {enrichedAtomicParts.map((part) => {
        const partTitle = isEs ? part.name_es : part.name_en;
        const partHref = isEs ? `/catalogo/${part.code}/` : `/en/catalog/${part.code}/`;
        const partImg = `/images/partes/${String(part.code || part.part_number).toLowerCase()}.webp`;
        return (
          <article
            class="smat-sf-card"
            data-ergos-homogeneous-card="1"
            data-part-code={part.part_number}
            data-niosh-tier={part.niosh.tier}
            data-select-catalog-sku={part.spec.smat_code || part.part_number}
          >
            <a href={partHref} class="smat-sf-media-link" aria-label={partTitle}>
              <img
                src={partImg}
                alt={`${partTitle} (${part.part_number})`}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
                class="smat-sf-photo"
              />
            </a>
            <div class="smat-sf-body">
              <div class="smat-sf-meta-row">
                <span class="smat-sf-badge smat-sf-badge--hay smat-stock-badge">
                  {isEs ? 'Disponible · Durango' : 'Available · Durango'}
                </span>
                <span class="smat-sf-sku-code">{part.part_number}</span>
                <span class="smat-sf-mass">{part.spec.weight_kg} kg</span>
              </div>
              <h3 class="smat-sf-title">
                <a href={partHref} class="smat-sf-title-link">{partTitle}</a>
              </h3>
              <p class="smat-sf-compat">
                {isEs ? 'Serie' : 'Series'} {part.frame} · {part.hardness} · {part.spec.station_number}
              </p>
              <div class="smat-sf-actions">
                <button
                  type="button"
                  class="smat-sf-btn-add smat-buy-cta"
                  data-add-tray-sku={part.spec.smat_code || part.part_number}
                  data-quick-tray-add={part.spec.smat_code || part.part_number}
                  data-sku-title={partTitle}
                  data-sku-code={part.part_number}
                  data-sku-material="A05"
                  data-sku-regime="hay"
                  data-sku-mass={String(part.spec.weight_kg || 12)}
                >
                  {isEs ? '+ Agregar' : '+ Add'}
                </button>
                <a href={partHref} class="smat-sf-btn-detail smat-nav-cta">
                  {isEs ? 'Ver ficha →' : 'View specs →'}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="catalog-section" id={isEs ? 'logistica' : 'logistics'}>
    <div class="section-title-wrap">
      <span class="section-num">05</span>
      <div>
        <h2>{isEs ? 'Protocolo de Calidad, Almacén Central y Despacho' : 'Quality Protocol, Central Warehouse & Mine Dispatch'}</h2>
        <span class="section-subtitle">{isEs ? 'Cotejo dimensional en Durango, certificación metalúrgica PMI y modalidades de entrega en mina' : 'Dimensional verification in Durango, metallurgical certification & nationwide mine logistics'}</span>
      </div>
    </div>
    <div class="trust-charter-grid">
      <div class="trust-box">
        <span class="t-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg></span>
        <h4>{isEs ? 'Cotejo Dimensional de Tripleta Geométrica (ISO 2768-m)' : 'Geometric Triplet Verification (ISO 2768-m)'}</h4>
        <p>{isEs ? 'Todo impulsor y componente de desgaste pasa por verificación física de Tripleta Geométrica (A, B, C) y dureza Brinell/Rockwell en nuestro Almacén Central en Durango.' : 'Every wear component undergoes physical Geometric Triplet (A, B, C) inspection and Brinell/Rockwell testing in Durango before dispatch.'}</p>
      </div>
      <div class="trust-box">
        <span class="t-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg></span>
        <h4>{isEs ? 'Alto Cromo 27% Cr (A05), Hule y Poliuretano' : '27% Cr High Chrome (A05), Rubber & Polyurethane'}</h4>
        <p>{isEs ? 'Coladas de fundición al 27% Cr (≥650 HB) y elastómeros seleccionados según abrasión, tamaño de partícula y pH.' : '27% Cr white iron heats (≥650 HB) and abrasion elastomers engineered for slurry pH and particle size.'}</p>
      </div>
      <div class="trust-box">
        <span class="t-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="16" height="13" x="1" y="3" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span>
        <h4>{isEs ? '3 Modalidades de Despacho Nacional' : '3 Nationwide Dispatch Modes'}</h4>
        <p>{isEs ? '1. Retiro directo en Almacén Central Durango. 2. Fletera consolidada nacional (ocurre). 3. Flete dedicado directo a mina o multimodal marítimo.' : '1. Durango Central Warehouse pickup. 2. Consolidated freight terminal. 3. Dedicated direct-to-mine flatbeds.'}</p>
      </div>
      <div class="trust-box">
        <span class="t-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
        <h4>{isEs ? 'Atención Técnica Especializada' : 'Dedicated Plant Engineering Support'}</h4>
        <p>{isEs ? 'Lunes a Viernes de 08:00 a 18:00 CST. Atención directa para cotizaciones por lote y programación de embarques.' : 'Mon–Fri 08:00–18:00 CST. Direct plant support for batch requisitions and mine dispatch.'}</p>
      </div>
    </div>
  </section>

  <footer class="catalog-official-footer">
    <div class="footer-contacts">
      <strong>{isEs ? 'SMAT MINERALS — Suministro Minero e Ingeniería Hidráulica' : 'SMAT MINERALS — Mining Supply & Hydraulic Engineering'}</strong>
      <p>{isEs ? 'Domicilio Fiscal: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166 | Tel: (618) 810-4408 | ventas@smatminerals.com' : 'Fiscal HQ: Mariano Salas #114, Durango, Mexico CP 34166 | Phone: +52 (618) 810-4408 | ventas@smatminerals.com'}</p>
    </div>
    <div class="footer-cta no-print">
      <a href={quoteBaseHref} class="btn-footer-rfq">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="smat-inline-svg-icon"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        <span>{isEs ? 'Generar Requisición con Folio Oficial en Línea' : 'Generate Official Requisition Online'}</span>
      </a>
    </div>
  </footer>
</div>

<script>
  import { bindAtomicPartTrayButtons } from '../../scripts/verticalStateAndCtaSyncBridge.js';
  import { bindHomeCatalogDrawerAndDropIn } from '../../scripts/homeAndEquipmentCatalogFilter.js';
  import { bindDropInEquivalenceVerifier } from '../../scripts/catalogDropInAndJrpProjector.js';
  import { bindVendorPassportDownloadButtons } from '../../scripts/vendorPassportAndTradeInController.js';
  import { getDomainLabel } from '../../scripts/i18nDomainLabels.js';

  function initCatalogIslandInstruments() {
    const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
    const rootEl = document.querySelector('.catalog-page-container');
    if (rootEl) rootEl.setAttribute('data-domain-title', getDomainLabel('catalogFacet', 'title', lang));
    bindAtomicPartTrayButtons(document);
    bindHomeCatalogDrawerAndDropIn(document, lang);
    bindDropInEquivalenceVerifier(document, lang);
    bindVendorPassportDownloadButtons(document, lang);

    const switchCatalogFamily = (family: string) => {
      const equipSection = document.getElementById('indice-19-skus-7-avenidas');
      const atomicSection = document.getElementById('fichas-atomicas');
      const isAtomicOnly = family === 'atomicas';
      if (equipSection) {
        (equipSection as HTMLElement).hidden = isAtomicOnly;
      }
      if (atomicSection) {
        (atomicSection as HTMLElement).hidden = false;
        if (isAtomicOnly) {
          atomicSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    };

    document.querySelectorAll('[data-family-chip]').forEach((btn) => {
      const el = btn as HTMLElement;
      if (el.dataset.familyBound === '1') return;
      el.dataset.familyBound = '1';
      el.addEventListener('click', () => {
        document.querySelectorAll('[data-family-chip]').forEach((c) => {
          c.setAttribute('aria-pressed', c === el ? 'true' : 'false');
        });
        switchCatalogFamily(el.dataset.familyChip || 'all');
      });
    });

    document.querySelectorAll('[data-facet-avenue-btn]').forEach((btn) => {
      const el = btn as HTMLElement;
      if (el.dataset.avenueBound === '1') return;
      el.dataset.avenueBound = '1';
      el.addEventListener('click', () => switchCatalogFamily('all'));
    });

    const searchInput = document.getElementById('catalog-facet-search') as HTMLInputElement | null;
    if (searchInput && searchInput.dataset.drawerAutoBound !== '1') {
      searchInput.dataset.drawerAutoBound = '1';
      searchInput.addEventListener('input', () => {
        if (searchInput.value.trim().length > 0) switchCatalogFamily('all');
      });
    }

    const urlAvenue = typeof window !== 'undefined' ? new URLSearchParams(window.location.search).get('avenida') : null;
    if (urlAvenue && urlAvenue !== 'all') {
      const filtersDrawer = document.getElementById('catalog-filters-drawer') as HTMLDetailsElement | null;
      if (filtersDrawer) filtersDrawer.open = true;
      const targetAvBtn = document.querySelector(`[data-facet-avenue-btn="${urlAvenue}"]`) as HTMLElement | null;
      if (targetAvBtn) targetAvBtn.click();
    }
  }

  initCatalogIslandInstruments();
  document.addEventListener('astro:page-load', initCatalogIslandInstruments);
</script>

<style>
  .wb-progressive-drawer {
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    background: #ffffff;
    padding: 0.5rem 0.9rem;
  }
  .wb-progressive-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    list-style: none;
  }
  .wb-progressive-body {
    margin-top: 0.75rem;
  }
</style>
