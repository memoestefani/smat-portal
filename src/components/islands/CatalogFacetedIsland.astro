---
/**
 * CatalogFacetedIsland.astro
 * ---------------------------------------------------------------------------
 * Isla Canónica Bilingüe para /catalogo/ y /en/catalog/ (D2-V50, D4-V50, D7-V50).
 * Expone buscador dimensional 1:1 (Drop-In), descarga directa de Pasaporte de Proveedor,
 * filtro facetado por 7 Avenidas / Familias y proyección única de los 19 SKUs canónicos.
 */
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import CatalogAvenuesMatrix from '../CatalogAvenuesMatrix.astro';
import atomicParts from '../../../data/atomic_parts.json';
import rolesData from '../../../data/roles.json';
import { PIPE_SERIES_DIAMETER_MM, PIPE_DIAMETERS_MM, WET_END_MATERIAL_MATRIX } from '../../scripts/slurryEngine.js';
import { ATOMIC_PARTS_SSOT_COUNT, getAtomicPartSpecs, formatNioshErgonomicStatus, buildWizardUrl } from '../../scripts/workbenchBus.js';
import { AVENUE_METADATA, getQuickProductsByAvenue, verifyCatalogReferentialIntegrity, verifyDiagramSurjectivity } from '../../scripts/quickProductsCatalog.js';

interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const isEs = locale === 'es';
const lang = locale;
const homeHref = isEs ? '/' : '/en/';
const quoteBaseHref = isEs ? '/cotizar/#rfq' : '/en/quote/#rfq';

const wetEndMaterialsList = [
  ...Object.values(WET_END_MATERIAL_MATRIX),
  ...((WET_END_MATERIAL_MATRIX as any).hybrid_a05_r55 ? [(WET_END_MATERIAL_MATRIX as any).hybrid_a05_r55] : []),
];
const quickByAvenue = getQuickProductsByAvenue();
const avenueMetaMap: Record<string, any> = AVENUE_METADATA as any;
const avenueKeys = Object.keys(AVENUE_METADATA);
const catalogIntegrity = verifyCatalogReferentialIntegrity();
const diagramSurjectivity = verifyDiagramSurjectivity();
const canonicalSeriesCount = Object.keys(PIPE_DIAMETERS_MM).length;
const totalCatalogSkusCount = Object.values(quickByAvenue).reduce(
  (sum, arr) => sum + (Array.isArray(arr) ? arr.length : 0),
  0,
);
const controlVertical = rolesData.verticals.find((v) => v.id === 'control_procesos' || v.id === 'balanzas_marcy');
const controlProcessItems = controlVertical ? [...(controlVertical.capex || []), ...(controlVertical.opex || [])] : [];
const enrichedAtomicParts = atomicParts.map((part) => {
  const spec = getAtomicPartSpecs(part.part_number, '6x4');
  const niosh = formatNioshErgonomicStatus(spec, lang);
  const quoteHref = buildWizardUrl({
    lang,
    circuit: 'bombeo',
    role: spec.role,
    code: part.part_number,
    series: spec.pipe_size || '6x4',
    station: spec.station,
    material: part.part_number === 'DAM005' ? undefined : 'alto_cromo_cr27',
    weightKg: spec.weight_kg,
    arrangement: 'CV',
  });
  return { ...part, spec, niosh, quoteHref };
});

const seriesRows = [
  {
    key: '1.5x1',
    label: '1.5x1"',
    dimsEs: `1.5" (${PIPE_SERIES_DIAMETER_MM['1.5x1']} mm) × 1" (25 mm)`,
    dimsEn: `1.5" (${PIPE_SERIES_DIAMETER_MM['1.5x1']} mm) × 1" (25 mm)`,
    flow: '7 – 28 m³/h',
    head: '8 – 35 m',
    topSize: '14 mm',
    power: '5 – 15 HP (3.7-11 kW)',
    materialsEs: 'Alto Cromo (>650 HB) / Hule / Poliuretano / SiC',
    materialsEn: 'High Chrome (>650 HB) / Rubber / Polyurethane / SiC',
    appEs: 'Muestreo metalúrgico, plantas piloto y rebose de espuma.',
    appEn: 'Metallurgical sampling, pilot plants, and froth overflow.',
  },
  {
    key: '2x1.5',
    label: '2x1.5"',
    dimsEs: `2" (${PIPE_SERIES_DIAMETER_MM['2x1.5']} mm) × 1.5" (40 mm)`,
    dimsEn: `2" (${PIPE_SERIES_DIAMETER_MM['2x1.5']} mm) × 1.5" (40 mm)`,
    flow: '15 – 55 m³/h',
    head: '10 – 40 m',
    topSize: '19 mm',
    power: '10 – 20 HP (7.5-15 kW)',
    materialsEs: 'Alto Cromo (>650 HB) / Hule / Poliuretano / SiC',
    materialsEn: 'High Chrome (>650 HB) / Rubber / Polyurethane / SiC',
    appEs: 'Dosificación de lechada de cal, reactivos y limpieza cleaner.',
    appEn: 'Milk-of-lime dosing, reagents, and cleaner circuit duty.',
  },
  {
    key: '3x2',
    label: '3x2"',
    dimsEs: `3" (${PIPE_SERIES_DIAMETER_MM['3x2']} mm) × 2" (50 mm)`,
    dimsEn: `3" (${PIPE_SERIES_DIAMETER_MM['3x2']} mm) × 2" (50 mm)`,
    flow: '25 – 105 m³/h',
    head: '12 – 45 m',
    topSize: '22 mm',
    power: '15 – 30 HP (11-22 kW)',
    materialsEs: 'Alto Cromo (>650 HB) / Hule / Poliuretano / SiC',
    materialsEn: 'High Chrome (>650 HB) / Rubber / Polyurethane / SiC',
    appEs: 'Transferencia de concentrados finales y sumideros de piso.',
    appEn: 'Final concentrate transfer and plant floor sump service.',
  },
  {
    key: '4x3',
    label: '4x3"',
    dimsEs: `4" (${PIPE_SERIES_DIAMETER_MM['4x3']} mm) × 3" (75 mm)`,
    dimsEn: `4" (${PIPE_SERIES_DIAMETER_MM['4x3']} mm) × 3" (75 mm)`,
    flow: '50 – 180 m³/h',
    head: '10 – 45 m',
    topSize: '28 mm',
    power: '30 – 50 HP (22-37 kW)',
    materialsEs: 'Alto Cromo (>650 HB) / Hule / Poliuretano / SiC',
    materialsEn: 'High Chrome (>650 HB) / Rubber / Polyurethane / SiC',
    appEs: 'Alimentación a celdas, sumideros y circuitos de finos.',
    appEn: 'Flotation cell feed, sumps, and fine slurry circuits.',
  },
  {
    key: '6x4',
    label: '6x4"',
    highlight: true,
    dimsEs: `6" (${PIPE_SERIES_DIAMETER_MM['6x4']} mm) × 4" (100 mm)`,
    dimsEn: `6" (${PIPE_SERIES_DIAMETER_MM['6x4']} mm) × 4" (100 mm)`,
    flow: '150 – 450 m³/h',
    head: '15 – 60 m',
    topSize: '45 mm',
    power: '50 – 100 HP (37-75 kW)',
    materialsEs: 'Alto Cromo (>650 HB) / Hule / Poliuretano / SiC',
    materialsEn: 'High Chrome (>650 HB) / Rubber / Polyurethane / SiC',
    appEs: 'Descarga de molinos SAG a batería de hidrociclones.',
    appEn: 'SAG and ball mill discharge to hydrocyclone cluster.',
  },
  {
    key: '8x6',
    label: '8x6"',
    dimsEs: `8" (${PIPE_SERIES_DIAMETER_MM['8x6']} mm) × 6" (150 mm)`,
    dimsEn: `8" (${PIPE_SERIES_DIAMETER_MM['8x6']} mm) × 6" (150 mm)`,
    flow: '350 – 900 m³/h',
    head: '20 – 70 m',
    topSize: '63 mm',
    power: '100 – 200 HP (75-150 kW)',
    materialsEs: 'Alto Cromo (>650 HB) / Hule / SiC',
    materialsEn: 'High Chrome (>650 HB) / Rubber / SiC',
    appEs: 'Molienda primaria y bombeo de jales espesados.',
    appEn: 'Primary grinding circuit and thickened tailings transfer.',
  },
  {
    key: '10x8',
    label: '10x8"',
    dimsEs: `10" (${PIPE_SERIES_DIAMETER_MM['10x8']} mm) × 8" (200 mm)`,
    dimsEn: `10" (${PIPE_SERIES_DIAMETER_MM['10x8']} mm) × 8" (200 mm)`,
    flow: '700 – 1,200 m³/h',
    head: '25 – 80 m',
    topSize: '86 mm',
    power: '150 – 250 HP (110-185 kW)',
    materialsEs: 'Alto Cromo (>650 HB) / Hule / SiC',
    materialsEn: 'High Chrome (>650 HB) / Rubber / SiC',
    appEs: 'Gran caudal de relaves y concentradoras >1,500 t/d.',
    appEn: 'High-volume tailings duty and concentrators >1,500 t/d.',
  },
  {
    key: '12x10',
    label: '12x10"',
    dimsEs: `12" (${PIPE_SERIES_DIAMETER_MM['12x10']} mm) × 10" (250 mm)`,
    dimsEn: `12" (${PIPE_SERIES_DIAMETER_MM['12x10']} mm) × 10" (250 mm)`,
    flow: '1,100 – 2,200 m³/h',
    head: '25 – 85 m',
    topSize: '95 mm',
    power: '250 – 450 HP (185-335 kW)',
    materialsEs: 'Alto Cromo (>650 HB) / Hule / SiC',
    materialsEn: 'High Chrome (>650 HB) / Rubber / SiC',
    appEs: 'Alimentación primaria a hidrociclones y descarga de molinos SAG.',
    appEn: 'Primary hydrocyclone cluster feed and SAG mill discharge.',
  },
  {
    key: '14x12',
    label: '14x12"',
    dimsEs: `14" (${PIPE_SERIES_DIAMETER_MM['14x12']} mm) × 12" (300 mm)`,
    dimsEn: `14" (${PIPE_SERIES_DIAMETER_MM['14x12']} mm) × 12" (300 mm)`,
    flow: '1,600 – 3,400 m³/h',
    head: '25 – 90 m',
    topSize: '110 mm',
    power: '400 – 650 HP (300-485 kW)',
    materialsEs: 'Alto Cromo (>650 HB) / Hule / SiC',
    materialsEn: 'High Chrome (>650 HB) / Rubber / SiC',
    appEs: 'Mega-concentradoras y conducción principal de relaves espesados.',
    appEn: 'Large-scale concentrators and main thickened tailings pipelines.',
  },
];

const familyChips = [
  { id: 'all', labelEs: 'Todas las Líneas (19)', labelEn: 'All Lines (19)' },
  { id: 'bombeo', labelEs: 'Bombas y Extremo Húmedo', labelEn: 'Pumps & Wet-End' },
  { id: 'sello_potencia', labelEs: 'Sello Expulsor y Soporte', labelEn: 'Expeller Seal & Bearing' },
  { id: 'clasificacion', labelEs: 'Hidrociclones y Cribas', labelEn: 'Cyclones & Screens' },
  { id: 'flotacion', labelEs: 'Flotación', labelEn: 'Flotation' },
  { id: 'filtracion', labelEs: 'Filtros Prensa', labelEn: 'Filter Presses' },
  { id: 'control', labelEs: 'Metrología y Balanzas', labelEn: 'Metrology & Scales' },
  { id: 'tamices', labelEs: 'Tamices ASTM E11 y Ro-Tap', labelEn: 'ASTM E11 Sieves & Ro-Tap' },
];
---

<div
  class="catalog-page-container"
  data-catalog-integrity={catalogIntegrity.valid ? '1' : '0'}
  data-diagram-surjectivity={diagramSurjectivity.surjective ? '1' : '0'}
  data-avenues-count={String(Object.keys(quickByAvenue).length)}
>
  <div class="catalog-action-bar no-print">
    <div class="action-bar-left">
      <a href={homeHref} class="btn-back">{isEs ? '← Volver al Inicio' : '← Back to Home'}</a>
      <span class="catalog-edition-pill">{isEs ? 'EDICIÓN TÉCNICA V5.0 • 2026' : 'TECHNICAL EDITION V5.0 • 2026'}</span>
    </div>
    <div class="action-bar-right">
      <button
        type="button"
        id="catalog-download-passport-btn"
        data-passport-kind="json"
        class="btn-action btn-print"
      >
        {isEs ? 'Pasaporte Proveedor CFDI (JSON)' : 'Vendor Passport CFDI (JSON)'}
      </button>
      <button type="button" class="btn-action btn-print" onclick="window.print()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="smat-inline-svg-icon"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        <span>{isEs ? 'Imprimir / Guardar PDF (A4)' : 'Print / Save PDF (A4)'}</span>
      </button>
      <a href={quoteBaseHref} class="btn-action btn-rfq">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="smat-inline-svg-icon"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        <span>{isEs ? 'Cotizar Requisición' : 'Generate Requisition'}</span>
      </a>
    </div>
  </div>

  <p id="sap-vendor-passport-status" data-passport-status class="passport-status-line no-print"></p>

  <header class="catalog-official-header">
    <div class="header-brand-block">
      <h1 class="brand-title">SMAT MINERALS</h1>
      <span class="brand-tagline">
        {isEs
          ? 'BOMBAS PARA LODOS, CONTACTO HÚMEDO, FLOTACIÓN, FILTROS PRENSA Y BALANZAS'
          : 'SLURRY PUMPS, WET-END PARTS, FLOTATION, FILTER PRESSES & PULP SCALES'}
      </span>
      <span class="brand-location">
        {isEs
          ? 'Domicilio Fiscal: Mariano Salas #114, Durango, Dgo. CP 34166 | Almacén Central Durango'
          : 'Fiscal HQ: Mariano Salas #114, Durango, Mexico. CP 34166 | Durango Central Warehouse'}
      </span>
    </div>
    <div class="header-meta-block">
      <span class="doc-badge">{isEs ? 'CATÁLOGO TÉCNICO CON DIAGRAMAS CAD' : 'TECHNICAL CATALOG WITH CAD DIAGRAMS'}</span>
      <span class="doc-code">{isEs ? 'REF: SMAT-CAT-2026' : 'REF: SMAT-CAT-2026-EN'}</span>
      <span class="doc-contact">
        {isEs
          ? 'Tel: (618) 810-4408 • Guardia: (618) 367-0664 • ventas@smatminerals.com'
          : 'Phone: +52 (618) 810-4408 • Hotline: +52 (618) 367-0664 • ventas@smatminerals.com'}
      </span>
    </div>
  </header>

  <section
    id="stratum1-dropin-verifier"
    class="card no-print smat-island-card smat-mb-md"
    data-stratum-1-instrument
    data-dropin-verifier
  >
    <div class="smat-stratum1-display">
      <div class="smat-flex-between">
        <div>
          <span class="smat-kicker">
            {isEs ? 'HERRAMIENTA DE INGENIERÍA DE COMPATIBILIDAD' : 'DIMENSIONAL COMPATIBILITY INSTRUMENT'}
          </span>
          <h2 class="verifier-title">
            {isEs ? 'Verificador de Equivalencia Dimensional (Drop-In)' : 'Dimensional Drop-In Equivalence Verifier'}
          </h2>
          <p class="verifier-sub">
            {isEs
              ? 'Valide el intercambio 1:1 de códigos de plano (ej. E4147, D3147, DAM005, SMAT-PUMP-IMP-AH) por brida y geometría sin modificar bancada.'
              : 'Validate 1:1 plant drawing code fit (e.g., E4147, D3147, DAM005, SMAT-PUMP-IMP-AH) without modifying existing baseplates or piping.'}
          </p>
        </div>
        <div class="smat-chip-row">
          <span class="smat-badge-solar">
            {ATOMIC_PARTS_SSOT_COUNT} {isEs ? 'Piezas Atómicas' : 'Atomic Parts'}
          </span>
          <span class="smat-badge-solar">
            {canonicalSeriesCount} {isEs ? 'Series Hidráulicas' : 'Hydraulic Series'}
          </span>
          <span data-ssot-integrity-badge class="smat-badge-emerald">
            {isEs
              ? catalogIntegrity.valid ? 'Integridad Referencial: Verificada' : 'Integridad Referencial: Revisar'
              : catalogIntegrity.valid ? 'Referential Integrity: Verified' : 'Referential Integrity: Review'}
          </span>
          <span data-ssot-surjectivity-badge class="smat-badge-emerald">
            {isEs
              ? diagramSurjectivity.surjective ? 'Cobertura CAD: 100%' : 'Cobertura CAD: Parcial'
              : diagramSurjectivity.surjective ? 'CAD Coverage: 100%' : 'CAD Coverage: Partial'}
          </span>
          <span class="smat-badge-solar">
            {isEs ? 'SKUs Visibles:' : 'Visible SKUs:'} <strong id="catalog-visible-sku-count">{totalCatalogSkusCount}</strong>
          </span>
        </div>
      </div>
    </div>

    <div class="smat-inputs-2col">
      <div>
        <label class="smat-field-label" for="catalog-dropin-input-field">
          {isEs ? 'Código de Plano / Equivalencia 1:1' : 'Drawing Code / 1:1 Drop-In Query'}
        </label>
        <div class="smat-cta-row compact-row">
          <input
            id="catalog-dropin-input-field"
            type="text"
            data-dropin-input
            placeholder={isEs
              ? 'Código o SKU (ej. E4147, D3147, DAM005, SMAT-PUMP-IMP-AH)...'
              : 'Code or SKU (e.g. E4147, D3147, DAM005, SMAT-PUMP-IMP-AH)...'}
            class="smat-search-input"
          />
          <button type="button" class="smat-btn-primary" data-dropin-btn>
            {isEs ? 'Verificar Equivalencia →' : 'Verify Fit →'}
          </button>
        </div>
      </div>

      <div>
        <label class="smat-field-label" for="catalog-facet-search">
          {isEs ? 'Filtro Rápido del Catálogo (19 SKUs en 7 Avenidas)' : 'Instant Catalog Filter (19 SKUs across 7 Avenues)'}
        </label>
        <input
          id="catalog-facet-search"
          type="search"
          placeholder={isEs
            ? 'Filtrar por SKU, aleación, malla ASTM, prensa o marcy...'
            : 'Filter by SKU, alloy, ASTM sieve, filter press or Marcy...'}
          class="smat-search-input full-width-input"
        />
      </div>
    </div>

    <div data-dropin-result class="smat-result-box smat-hidden-init"></div>

    <div class="faceted-filters-block">
      <div class="smat-chip-row smat-mt-sm" role="group" aria-label={isEs ? 'Filtro por Familia' : 'Filter by Family'}>
        {familyChips.map((chip, idx) => (
          <button
            type="button"
            class={`smat-chip ${idx === 0 ? 'part-chip--highlight' : ''}`}
            data-family-chip={chip.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {isEs ? chip.labelEs : chip.labelEn}
          </button>
        ))}
      </div>

      <div class="smat-chip-row smat-mt-sm" role="group" aria-label={isEs ? 'Filtro por Avenida Industrial' : 'Filter by Industrial Avenue'}>
        <button type="button" class="smat-chip is-active" data-facet-avenue-btn="all" aria-pressed="true">
          {isEs ? '7 Avenidas (Todas)' : 'All 7 Avenues'}
        </button>
        {avenueKeys.map((avKey) => {
          const meta = avenueMetaMap[avKey];
          return (
            <button type="button" class="smat-chip" data-facet-avenue-btn={avKey} aria-pressed="false">
              {meta.code} · {isEs ? meta.labelEs.split('(')[0].trim() : meta.labelEn.split('(')[0].trim()}
            </button>
          );
        })}
      </div>
    </div>
  </section>

  <div class="catalog-intro-banner no-print">
    <div class="intro-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
    </div>
    <div class="intro-text">
      <strong>
        {isEs
          ? 'Catálogo Técnico con Diagramas de Despiece para Ingeniería de Planta y Compras Mineras'
          : 'Technical Catalog with Exploded CAD Diagrams for Plant Engineering & Mining Procurement'}
      </strong>
      <p>
        {isEs
          ? 'Consulte bombas para lodos (1.5x1" a 14x12"), lotes en contacto húmedo (5 impulsores, 5 cuellos y 4 volutas en Alto Cromo, Hule y Poliuretano), Bearing Assembly / Housing completos, mecanismos de flotación, filtros prensa (800 a 1500 mm) y metrología Marcy.'
          : 'Browse heavy-duty slurry pumps (1.5x1" to 14x12"), wet-end wear lots (5 impellers, 5 throatbushes & 4 volute liners in High Chrome, Rubber & Polyurethane), complete Bearing Assembly / Housing, flotation mechanisms, filter presses (800 to 1500 mm) & Marcy metrology.'}
      </p>
    </div>
  </div>

  <section class="catalog-section" id={isEs ? 'bombeo' : 'pumping'}>
    <div class="section-title-wrap">
      <span class="section-num">01</span>
      <div>
        <h2>
          {isEs
            ? 'Bombas para Lodos y Piezas en Contacto Húmedo (Circuito de Bombeo)'
            : 'Slurry Pumps & Wet-End Wear Parts (Pumping Circuit)'}
        </h2>
        <span class="section-subtitle">
          {isEs
            ? 'Bombas horizontales para lodos, lotes 5-5-4 en Alto Cromo, Hule y Poliuretano, y Bearing Assembly / Housing completo'
            : 'Horizontal centrifugal slurry pumps, balanced 5-5-4 wet-end lots, and pre-assembled Bearing Assembly / Housing units'}
        </span>
      </div>
    </div>

    <div class="catalog-grid-2">
      <article class="catalog-card">
        <div class="card-tag">{isEs ? 'Bombas Horizontales y Conjunto Motriz' : 'Horizontal Slurry Pumps & Drive Train'}</div>
        <h3>
          {isEs
            ? 'Bombas para Lodos (1.5x1" a 14x12") y Bearing Assembly / Housing'
            : 'Slurry Pumps (1.5x1" to 14x12") & Bearing Assembly / Housing'}
        </h3>
        <p class="card-desc">
          {isEs
            ? 'Bombas centrífugas horizontales de servicio pesado para descarga de molino, alimentación a ciclones, flotación y jales, junto con Bearing Assembly / Housing completos listos para montaje rápido en campo.'
            : 'Heavy-duty horizontal slurry pumps engineered for mill discharge, cyclone feed, flotation, and tailings pipelines, plus factory-shimmed Bearing Assembly / Housing modules.'}
        </p>
        <ul class="card-specs">
          <li>
            <strong>{isEs ? 'Rango de Bombas:' : 'Pump Series Range:'}</strong>{' '}
            {isEs ? 'Desde 1.5x1" hasta 14x12" (Series 4x3", 6x4", 8x6", 10x8" con acople 1:1).' : '1.5x1" through 14x12" (4x3", 6x4", 8x6", 10x8" with 1:1 interchangeability).'}
          </li>
          <li>
            <strong>Bearing Assembly / Housing:</strong>{' '}
            {isEs ? 'Conjunto completo ensamblado (carcasa cilíndrica, flecha de acero aleado, rodamientos cónicos Timken y sellos laberinto).' : 'Complete cartridge assembly with alloy shaft, tapered roller bearings & labyrinth seals.'}
          </li>
          <li>
            <strong>{isEs ? 'Sellado de Flecha:' : 'Shaft Sealing:'}</strong>{' '}
            {isEs ? 'Expulsor centrífugo en seco y prensaestopa con anillo linterna. No vendemos sello mecánico por alta abrasión.' : 'Dry centrifugal expeller and packed gland with lantern ring. Mechanical seals excluded due to severe abrasion.'}
          </li>
          <li>
            <strong>{isEs ? 'Intercambiabilidad:' : 'Compatibility:'}</strong>{' '}
            {isEs ? 'Acople dimensional 1:1 con bancadas y bridas ANSI estándar.' : 'Direct 1:1 drop-in mounting onto existing plant baseplates and ANSI flanges.'}
          </li>
        </ul>
        <div class="card-footer-action no-print smat-cta-row">
          <a href={isEs ? '/cotizar/?circuito=bombeo&equipo=skid_bomba&serie=6x4#rfq' : '/en/quote/?circuito=bombeo&equipo=skid_bomba&serie=6x4#rfq'} class="btn-card-quote">
            {isEs ? 'Cotizar Bomba para Lodos →' : 'Quote Slurry Pump →'}
          </a>
