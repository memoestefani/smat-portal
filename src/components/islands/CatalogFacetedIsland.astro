<script is:inline>
  (function() {
    var table = document.getElementById('parametric-pumps-table');
    var svg = document.querySelector('.pump-svg-scheme');
    if (!table || !svg) return;

    var rows = table.querySelectorAll('tbody tr');
    var dimA = svg.querySelector('.svg-dim-a');
    var dimB = svg.querySelector('.svg-dim-b');
    var dimC = svg.querySelector('.svg-dim-c');
    var dimD = svg.querySelector('.svg-dim-d');
    var isEn = document.documentElement.lang === 'en';
    var defaultA = isEn ? 'Ø A (Suction)' : 'Ø A (Succión)';
    var defaultB = isEn ? 'Ø B (Discharge)' : 'Ø B (Descarga)';
    var defaultC = isEn ? 'Dim C: Hold-Down Bolt Centers' : 'Cota C: Distancia entre Barrenos';
    var defaultD = isEn ? 'Dim D' : 'Cota D';

    var seriesDims = {
      '1.5x1"': { a: 'Ø 40 mm (1.5")', b: 'Ø 25 mm (1")', c: 'C: 260 mm', d: 'D: 185 mm' },
      '2x1.5"': { a: 'Ø 50 mm (2")', b: 'Ø 40 mm (1.5")', c: 'C: 310 mm', d: 'D: 210 mm' },
      '3x2"': { a: 'Ø 80 mm (3")', b: 'Ø 50 mm (2")', c: 'C: 370 mm', d: 'D: 245 mm' },
      '4x3"': { a: 'Ø 100 mm (4")', b: 'Ø 75 mm (3")', c: 'C: 420 mm', d: 'D: 280 mm' },
      '6x4"': { a: 'Ø 150 mm (6")', b: 'Ø 100 mm (4")', c: 'C: 580 mm', d: 'D: 355 mm' },
      '8x6"': { a: 'Ø 200 mm (8")', b: 'Ø 150 mm (6")', c: 'C: 740 mm', d: 'D: 450 mm' },
      '10x8"': { a: 'Ø 250 mm (10")', b: 'Ø 200 mm (8")', c: 'C: 920 mm', d: 'D: 560 mm' },
      '12x10"': { a: 'Ø 300 mm (12")', b: 'Ø 250 mm (10")', c: 'C: 1120 mm', d: 'D: 680 mm' },
      '14x12"': { a: 'Ø 350 mm (14")', b: 'Ø 300 mm (12")', c: 'C: 1280 mm', d: 'D: 790 mm' }
    };

    rows.forEach(function(row) {
      var seriesPill = row.querySelector('.series-pill');
      var seriesKey = seriesPill ? seriesPill.textContent.trim() : '';
      var data = seriesDims[seriesKey];
      row.addEventListener('mouseenter', function() {
        if (!data) return;
        if (dimA) { dimA.textContent = data.a; dimA.style.fill = '#1d4ed8'; }
        if (dimB) { dimB.textContent = data.b; dimB.style.fill = '#1d4ed8'; }
        if (dimC) { dimC.textContent = data.c; dimC.style.fill = '#1d4ed8'; }
        if (dimD) { dimD.textContent = data.d; dimD.style.fill = '#1d4ed8'; }
      });
      row.addEventListener('mouseleave', function() {
        if (dimA) { dimA.textContent = defaultA; dimA.style.fill = '#0f172a'; }
        if (dimB) { dimB.textContent = defaultB; dimB.style.fill = '#0f172a'; }
        if (dimC) { dimC.textContent = defaultC; dimC.style.fill = '#7c2d12'; }
        if (dimD) { dimD.textContent = defaultD; dimD.style.fill = '#1d4ed8'; }
      });
    });
  })();
</script>

<script>
  import { bindAtomicPartTrayButtons } from '../../scripts/verticalStateAndCtaSyncBridge.js';
  import { bindHomeCatalogDrawerAndDropIn } from '../../scripts/homeAndEquipmentCatalogFilter.js';
  import { bindDropInEquivalenceVerifier } from '../../scripts/catalogDropInAndJrpProjector.js';
  import { bindVendorPassportDownloadButtons } from '../../scripts/vendorPassportAndTradeInController.js';

  function initCatalogIslandInstruments() {
    const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
    bindAtomicPartTrayButtons(document);
    bindHomeCatalogDrawerAndDropIn(document, lang);
    bindDropInEquivalenceVerifier(document, lang);
    bindVendorPassportDownloadButtons(document, lang);
  }

  initCatalogIslandInstruments();
  document.addEventListener('astro:page-load', initCatalogIslandInstruments);
</script>
