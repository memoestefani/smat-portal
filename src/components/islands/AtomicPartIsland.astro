---
// src/components/islands/AtomicPartIsland.astro — Isla Canónica Única de Ficha Atómica Universal (SLICE-V50-33)
import SharePurchasing from '../SharePurchasing.astro';
import JrpReorderCore from '../cores/JrpReorderCore.astro';
import { getAtomicPartSpecs } from '../../scripts/workbenchBus.js';

interface Props {
  locale?: 'es' | 'en';
  part: Record<string, any>;
  routeSlug?: string;
}

const { locale = 'es', part, routeSlug } = Astro.props;
const isEs = locale === 'es';
const fullSpec: any = getAtomicPartSpecs(part.part_number, part.pipe_size || '6x4') || part;

const sanitizeOemFrameText = (str: string) =>
  isEs
    ? String(str || '')
        .replace(/4\/3\s*C/gi, '4x3')
        .replace(/6\/4\s*D/gi, '6x4')
        .replace(/8\/6\s*E/gi, '8x6')
        .replace(/\bmarco\s+[CDE]\b/gi, 'bastidor estándar')
    : String(str || '')
        .replace(/4\/3\s*C/gi, '4x3')
        .replace(/6\/4\s*D/gi, '6x4')
        .replace(/8\/6\s*E/gi, '8x6')
        .replace(/\b[CDE][- ]frame\b/gi, 'standard frame');

const cleanName = sanitizeOemFrameText(isEs ? part.name_es : part.name_en);
const cleanSummary = sanitizeOemFrameText(isEs ? part.summary_es : part.summary_en);
const cleanCircuit = sanitizeOemFrameText(isEs ? part.circuit_es : part.circuit_en);
const pipeSizeUpper = String(fullSpec.pipe_size || '6x4').toUpperCase();

const nioshModeLabel = isEs
  ? fullSpec.niosh_ergonomic_tier === 'MANUAL_1P_SAFE'
    ? `Manejo Manual 1 Operador (${fullSpec.niosh_handling_mode} • LI=${fullSpec.niosh_lifting_index_shaft})`
    : fullSpec.niosh_ergonomic_tier === 'ASSISTED_SHAFT_MOUNT_2P'
      ? `Montaje Asistido 2 Operadores en Voladizo (${fullSpec.niosh_handling_mode} • LI=${fullSpec.niosh_lifting_index_shaft} vs RWL=${fullSpec.niosh_rwl_shaft_kg} kg)`
      : `Polipasto / Grúa Obligatorio (${fullSpec.niosh_handling_mode} • LI=${fullSpec.niosh_lifting_index_shaft} ≥ 23 kg)`
  : fullSpec.niosh_ergonomic_tier === 'MANUAL_1P_SAFE'
    ? `1-Operator Manual Safe (${fullSpec.niosh_handling_mode} • LI=${fullSpec.niosh_lifting_index_shaft})`
    : fullSpec.niosh_ergonomic_tier === 'ASSISTED_SHAFT_MOUNT_2P'
      ? `2-Person Assisted Shaft Mount (${fullSpec.niosh_handling_mode} • LI=${fullSpec.niosh_lifting_index_shaft} vs RWL=${fullSpec.niosh_rwl_shaft_kg} kg)`
      : `Hoist / Crane Mandatory (${fullSpec.niosh_handling_mode} • LI=${fullSpec.niosh_lifting_index_shaft} ≥ 23 kg)`;

const quoteBase = isEs ? '/cotizar/' : '/en/quote/';
const rfqDeepLink = `${quoteBase}?codigo=${part.part_number}&circuito=bombeo&equipo=${fullSpec.role || 'impulsor'}&serie=${fullSpec.pipe_size || '6x4'}&peso_kg=${fullSpec.weight_kg}&estacion=S${fullSpec.station_number}#rfq`;
const siteUrl = 'https://smatminerals.com';
const waText = encodeURIComponent(
  isEs
    ? `Hola SMAT Minerals, requiero cotización y disponibilidad en Almacén Durango de la refacción ${part.part_number} para Bastidor Estándar (${pipeSizeUpper}).`
    : `Hello SMAT Minerals, I require quotation and stock availability at Durango Central Warehouse for part ${part.part_number} (Standard Frame ${pipeSizeUpper}).`
);
const waUrl = `https://wa.me/526183670664?text=${waText}`;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${part.part_number} — ${cleanName}`,
  image: `${siteUrl}/images/og-card.jpg`,
  description: cleanSummary,
  sku: part.part_number,
  mpn: part.part_number,
  brand: {
    '@type': 'Brand',
    name: 'SMAT Minerals',
  },
  material: part.metallurgy,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: {
      '@type': 'Organization',
      name: 'SMAT Minerals',
      url: siteUrl,
    },
  },
};
---

<section class="part-page-main" data-island-standalone="atomicPart" data-lang={locale} data-route-slug={routeSlug || part.code}>
  <div class="container">
    <nav class="breadcrumb-nav" aria-label="Breadcrumbs">
      <a href={isEs ? '/' : '/en/'}>{isEs ? 'Inicio' : 'Home'}</a>
      <span class="breadcrumb-sep">/</span>
      <a href={isEs ? '/catalogo/' : '/en/catalog/'}>{isEs ? 'Catálogo' : 'Catalog'}</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">{part.part_number}</span>
    </nav>

    <div class="part-layout-grid">
      <article class="part-spec-card">
        <div class="spec-header">
          <span class="part-badge">{isEs ? 'REFACCIÓN ESTÁNDAR UNIVERSAL' : 'UNIVERSAL STANDARD SPARE'}</span>
          <h1 class="part-title">{part.part_number}</h1>
          <p class="part-subtitle">{cleanName}</p>
        </div>

        <div class="spec-body">
          <div id="stratum1-atomic-code-card" data-stratum-1-instrument class="smat-atomic-cta-bar">
            <a href={rfqDeepLink} class="btn btn-primary smat-atomic-cta-btn">
              {isEs ? `Cotizar ${part.part_number} →` : `Quote ${part.part_number} →`}
            </a>
            <button
              type="button"
              class="btn btn-rfq-wizard smat-atomic-cta-btn"
              data-add-tray-sku={part.part_number === 'DAM005' ? 'SMAT-PUMP-BRG-005M' : `SMAT-PUMP-${part.part_number}`}
              data-tray-part-code={part.part_number}
              data-tray-title={isEs ? part.name_es : part.name_en}
              data-tray-series={pipeSizeUpper}
              data-tray-material={part.part_number === 'DAM005' ? 'GGG40' : 'A05'}
              data-tray-circuit="bombeo"
              data-tray-source="catalog_code_stratum1"
            >
              {isEs ? `+ Bandeja (${part.part_number})` : `+ Add ${part.part_number} to Tray`}
            </button>
          </div>

          <details class="wb-progressive-drawer smat-mt-sm" id="atomic-jrp-drawer">
            <summary class="wb-progressive-summary">
              <span>{isEs ? 'Planificador preventivo de reorden (3 etapas)' : 'Preventive reorder planner (3 stages)'}</span>
              <span class="wb-step1-more-arrow">▾</span>
            </summary>
            <JrpReorderCore
              lang={locale}
              mode="atomic"
              skuId={part.part_number === 'DAM005' ? 'SMAT-PUMP-BRG-005M' : `SMAT-PUMP-${part.part_number}`}
              partCode={part.part_number}
              title={isEs ? part.name_es : part.name_en}
              series={pipeSizeUpper}
              material={part.part_number === 'DAM005' ? 'GGG40' : 'A05'}
              circuit="bombeo"
              coupledSkuId="SMAT-PUMP-TB-083"
              coupledTitle={isEs ? 'Throatbush Emparejado 1:1 (Cuello de Succión)' : '1:1 Matched Throatbush (Suction Liner)'}
              reorderDays={90}
              traySource="catalog_code_stratum1"
              showTradeIn={String(part.part_number || '').toUpperCase() === 'DAM005'}
            />
          </details>

          <p class="part-lead">{cleanSummary}</p>

          <div class="atomic-engineering-cards smat-atomic-eng-grid" data-testid="atomic-engineering-cards">
            <div class="atomic-eng-card smat-atomic-eng-card">
              <span class="font-mono-tech smat-atomic-kicker-copper">{isEs ? '[1. MASA E IZAJE NIOSH]' : '[1. MASS & NIOSH RIGGING]'}</span>
              <div class="smat-atomic-eng-val" data-testid="spec-weight-kg">{fullSpec.weight_kg} kg</div>
              <div class="smat-atomic-eng-sub" data-testid="spec-niosh-mode">{nioshModeLabel}</div>
              <div class="font-mono-tech smat-atomic-eng-meta">
                {isEs ? 'Espesor pared:' : 'Wall thickness:'} <strong data-testid="spec-wall-thickness">{fullSpec.wall_thickness_mm} mm</strong>
              </div>
            </div>
            <div class="atomic-eng-card smat-atomic-eng-card">
              <span class="font-mono-tech smat-atomic-kicker-navy">{isEs ? '[2. GEOMETRÍA HIDRÁULICA]' : '[2. HYDRAULIC GEOMETRY]'}</span>
              <div class="smat-atomic-eng-val" data-testid="spec-impeller-dia">
                {fullSpec.impeller_diameter_mm
                  ? `∅D₂ = ${fullSpec.impeller_diameter_mm} mm`
                  : (isEs ? `Serie ${pipeSizeUpper} (Bastidor Estándar ${pipeSizeUpper})` : `Series ${pipeSizeUpper} (Standard Frame ${pipeSizeUpper})`)}
              </div>
              <div class="smat-atomic-eng-sub" data-testid="spec-max-particle">
                {fullSpec.max_particle_mm
                  ? (isEs ? `Paso máximo de esfera: ${fullSpec.max_particle_mm} mm` : `Max sphere passage: ${fullSpec.max_particle_mm} mm`)
                  : (isEs ? `Acople directo eje / sello serie ${pipeSizeUpper}` : `Direct shaft / seal fit series ${pipeSizeUpper}`)}
              </div>
              <div class="font-mono-tech smat-atomic-eng-meta">
                {isEs ? 'Código SMAT:' : 'SMAT Code:'} <strong>{fullSpec.smat_code}</strong>
              </div>
            </div>
            <div class="atomic-eng-card smat-atomic-eng-card">
              <span class="font-mono-tech smat-atomic-kicker-green">{isEs ? '[3. ESTACIÓN DE ENSAMBLE BOM]' : '[3. BOM ASSEMBLY STATION]'}</span>
              <div class="smat-atomic-eng-val" data-testid="spec-station-number">
                {isEs ? `Estación 0${fullSpec.station_number} (S${fullSpec.station_number})` : `Station 0${fullSpec.station_number} (S${fullSpec.station_number})`}
              </div>
              <div class="smat-atomic-eng-sub" data-testid="spec-assembly-note">{fullSpec.assembly_order_note}</div>
            </div>
          </div>

          <h2 class="section-title">
            {isEs
              ? 'Parámetros Metalúrgicos y Compatibilidad Dimensional'
              : 'Metallurgical Specifications & Dimensional Interchangeability'}
          </h2>
          <div class="table-responsive">
            <table class="spec-table">
              <tbody>
                <tr>
                  <th>{isEs ? 'Código Universal:' : 'Universal Code:'}</th>
                  <td><strong>{part.part_number}</strong> ({fullSpec.smat_code})</td>
                </tr>
                <tr>
                  <th>{isEs ? 'Bastidor y Tubería Compatible:' : 'Compatible Frame & Pipe Series:'}</th>
                  <td>{isEs ? `Bomba centrífuga de lodos Bastidor Estándar (${pipeSizeUpper})` : `Slurry pump Standard Frame (${pipeSizeUpper})`}</td>
                </tr>
                <tr>
                  <th>{isEs ? 'Tipo de Componente:' : 'Component Type:'}</th>
                  <td>{isEs ? part.type_es : part.type_en}</td>
                </tr>
                <tr>
                  <th>{isEs ? 'Metalurgia:' : 'Metallurgy:'}</th>
                  <td>{part.metallurgy}</td>
                </tr>
                <tr>
                  <th>{isEs ? 'Dureza Verificada:' : 'Verified Hardness:'}</th>
                  <td><span class="hardness-badge">{part.hardness}</span></td>
                </tr>
                {part.vanes > 0 && (
                  <tr>
                    <th>{isEs ? 'Geometría de Álabes:' : 'Vane Geometry:'}</th>
                    <td>
                      {isEs
                        ? `${part.vanes} álabes cerrados con bombeo trasero dinámico`
                        : `${part.vanes} closed vanes with dynamic expeller back vanes`}
                    </td>
                  </tr>
                )}
                <tr>
                  <th>{isEs ? 'Aplicación Crítica:' : 'Critical Application:'}</th>
                  <td>{cleanCircuit}</td>
                </tr>
                <tr>
                  <th>{isEs ? 'Garantía de Ensamble:' : 'Assembly Guarantee:'}</th>
                  <td>
                    {isEs ? part.fit_guarantee_es : part.fit_guarantee_en}{' '}
                    ({isEs ? 'Kits asociados:' : 'Linked Kits:'} #{(part.kit_ids || [1]).join(', #')})
                  </td>
                </tr>
                <tr data-iso7810-ref="0.76mm">
                  <th>{isEs ? 'Escala Física Cotidiana (ISO/IEC 7810):' : 'Everyday Physical Scale (ISO/IEC 7810):'}</th>
                  <td>
                    {(isEs ? part.everyday_equivalence_es : part.everyday_equivalence_en)
                      ? `${isEs ? part.everyday_equivalence_es : part.everyday_equivalence_en} • `
                      : ''}
                    {isEs
                      ? 'Claro axial óptimo de referencia δ = 0.76 mm (equivalente al espesor exacto de 1 tarjeta bancaria estándar ISO 7810).'
                      : 'Optimal reference axial clearance δ = 0.76 mm (exact thickness of 1 standard ISO 7810 bank card).'}
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="assurance-block">
            <div class="assurance-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <polyline points="9 11 12 14 22 4" />
              </svg>
            </div>
            <div class="assurance-text">
              <h3>{isEs ? 'Garantía de Compatibilidad Dimensional 1:1 (ISO 2768-m)' : '1:1 Dimensional Fit Assurance (ISO 2768-m)'}</h3>
              <p>
                {isEs
                  ? `Cada pieza ${part.part_number} es verificada físicamente en Tripleta Geométrica (A, B, C) antes de ser despachada desde nuestro Almacén Central en Durango. Aseguramos el acople 1:1 en bastidores estándar de la industria. Si una refacción estándar presenta desviación dimensional respecto al plano confirmado, se gestiona su reposición prioritaria bajo protocolo de Almacén Durango.`
                  : `Every ${part.part_number} unit is physically matched against standard frame dimensions before dispatch from our Durango Central Warehouse. We ensure 100% drop-in interchangeability with industry-standard frames. Should a standard replacement part deviate from confirmed drawings, priority replacement is coordinated under our Durango supply regime.`}
              </p>
            </div>
          </div>

          <div class="anti-scraping-notice">
            <span class="notice-label">{isEs ? 'PROTECCIÓN TÉCNICA CONFIDENCIAL:' : 'CONFIDENTIAL ENGINEERING NOTICE:'}</span>
            <p>
              {isEs
                ? 'Las cotas finas de tolerancia milimétrica y planos de ensamble no se exponen en tablas masivas públicas para proteger el proceso operativo de nuestros clientes. La memoria técnica dimensional se entrega de forma confidencial a solicitud del área de ingeniería o compras.'
                : 'Fine-tolerance manufacturing prints and complete internal dimensional matrices are kept off public tables to safeguard intellectual property. Detailed mechanical drawings and compliance dossiers are shared privately with authorized mine plant engineering and procurement teams.'}
            </p>
          </div>
        </div>
      </article>

      <aside class="part-action-dock">
        <div class="action-card">
          <span class="dock-badge">{isEs ? 'RÉGIMEN DE SUMINISTRO DURANGO' : 'DURANGO SUPPLY REGIME'}</span>
          <h3>{isEs ? `Requisición de ${part.part_number}` : `Requisition for ${part.part_number}`}</h3>
          <p class="dock-desc">
            {isEs
              ? 'Atención directa con nuestro equipo de ingeniería en Durango para cotización inmediata, verificación de existencias y logística de embarque.'
              : 'Direct consultation with our engineering team in Durango, Mexico for prompt pricing, stock allocation, and direct carrier dispatch to your mine site.'}
          </p>

          <div class="dock-ctas">
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp-king">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              </svg>
              <span>{isEs ? 'Consultar Disponibilidad vía WhatsApp' : 'Check Availability via WhatsApp'}</span>
            </a>

            <a href={rfqDeepLink} class="btn btn-rfq-wizard" data-testid="btn-atomic-rfq">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
              </svg>
              <span>{isEs ? 'Generar Requisición Formal / Acuse A4' : 'Generate Formal RFQ / A4 Slip'}</span>
            </a>

            <button
              type="button"
              class="btn btn-rfq-wizard"
              data-add-atomic-to-tray
              data-atomic-code={part.part_number}
              data-name-es={part.name_es}
              data-name-en={part.name_en}
              data-weight-kg={fullSpec.weight_kg}
            >
              <span>{isEs ? `+ Agregar ${part.part_number} a Bandeja B2B` : `+ Add ${part.part_number} to B2B Tray`}</span>
            </button>
            <p data-atomic-tray-msg hidden class="smat-atomic-tray-msg"></p>
          </div>

          <div class="dock-facts">
            <div class="fact-item">
              <span class="fact-label">{isEs ? 'Ciclo Preventivo Sugerido:' : 'Suggested Preventive Cycle:'}</span>
              <span class="fact-val" data-client-reorder-days={String(fullSpec.client_reorder_window_days || 90)}>
                {isEs
                  ? `Cada ${fullSpec.client_reorder_window_days || 90} días operativos`
                  : `Every ${fullSpec.client_reorder_window_days || 90} operating days`}
              </span>
            </div>
            <div class="fact-item">
              <span class="fact-label">{isEs ? 'Centro de Distribución:' : 'Distribution Hub:'}</span>
              <span class="fact-val">{isEs ? 'Durango, Dgo., México' : 'Durango, Dgo., Mexico'}</span>
            </div>
            <div class="fact-item">
              <span class="fact-label">{isEs ? 'Modalidad de Retiro:' : 'Collection Method:'}</span>
              <span class="fact-val">{isEs ? 'Carga en patio o fletera a mina' : 'Warehouse yard pickup or freight'}</span>
            </div>
            <div class="fact-item">
              <span class="fact-label">{isEs ? 'Facturación:' : 'Tax Compliance:'}</span>
              <span class="fact-val">{isEs ? 'Facturación Nacional Directa (CFDI 4.0)' : 'Direct Domestic Tax Invoice (CFDI 4.0)'}</span>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <SharePurchasing
      lang={locale}
      circuit="bombeo"
      role={fullSpec.role || 'impulsor'}
      partName={`${part.part_number} — ${isEs ? part.name_es : part.name_en}`}
      partCode={part.part_number}
    />
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

<script>
  import { addTrayItem, calculateCoupledReorderWindowDays } from '../../scripts/requisitionTrayBus.js';
  import { initCoreTradeInWidgets } from '../../scripts/vendorPassportAndTradeInController.js';
  import { initHarmonicJrpWindowAndPairCard } from '../../scripts/catalogDropInAndJrpProjector.js';

  function bootAtomicPartIsland() {
    const root = document.querySelector('[data-island-standalone="atomicPart"]') as HTMLElement | null;
    if (!root) return;
    const lang = root.dataset.lang === 'en' ? 'en' : 'es';
    const isEn = lang === 'en';
    initCoreTradeInWidgets(root, lang);
    initHarmonicJrpWindowAndPairCard(root, lang);

    const wearEl = root.querySelector('#wb-jrp-wear-hours') as HTMLInputElement | null;
    const dailyEl = root.querySelector('#wb-jrp-daily-hours') as HTMLInputElement | null;
    const critEl = root.querySelector('#wb-jrp-criticality') as HTMLSelectElement | null;
    const s1El = root.querySelector('#jrp-stage-1-days');
    const s2El = root.querySelector('#jrp-stage-2-days');
    const s3El = root.querySelector('#jrp-stage-3-days');
    const winEl = root.querySelector('#wb-jrp-window-days');
    const rawEl = root.querySelector('#wb-jrp-raw-life-days');

    const syncCustomJrp = () => {
      if (!wearEl || !dailyEl || !critEl) return;
      const hours = Math.max(720, Math.min(18000, Number(wearEl.value) || 2400));
      const perDay = Math.max(1, Math.min(24, Number(dailyEl.value) || 24));
      const baseDays = Math.round(hours / perDay);
      const jrp = calculateCoupledReorderWindowDays({
        predictedWearHours: hours,
        operatingHoursPerDay: perDay,
        baseCycleDays: baseDays,
        criticalityMode: critEl.value === 'paro_planta' ? 'paro_planta' : 'normal',
      });
      if (s1El) s1El.textContent = isEn ? `Day ${jrp.sleeveInspectionDay}` : `Día ${jrp.sleeveInspectionDay}`;
      if (s2El) s2El.textContent = isEn ? `Day ${jrp.impellerThroatbushSwapDay}` : `Día ${jrp.impellerThroatbushSwapDay}`;
      if (s3El) s3El.textContent = isEn ? `Day ${jrp.voluteLinerOverhaulDay}` : `Día ${jrp.voluteLinerOverhaulDay}`;
      if (winEl) winEl.textContent = isEn ? `${jrp.recommendedWindowDays} d window` : `${jrp.recommendedWindowDays} d ventana`;
      if (rawEl) rawEl.textContent = `${jrp.rawLifeDays || baseDays} d`;
    };

    if (root.dataset.jrpInputsBound !== '1') {
      root.dataset.jrpInputsBound = '1';
      [wearEl, dailyEl, critEl].forEach((el) => {
        if (el) {
          el.addEventListener('input', syncCustomJrp);
          el.addEventListener('change', syncCustomJrp);
        }
      });
    }

    const btn = root.querySelector('[data-add-atomic-to-tray]') as HTMLButtonElement | null;
    const msg = root.querySelector('[data-atomic-tray-msg]') as HTMLElement | null;
    if (btn && btn.dataset.atomicTrayBound !== '1') {
      btn.dataset.atomicTrayBound = '1';
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-atomic-code') || 'E4147';
        const updated = addTrayItem({
          skuId: code,
          atomicCode: code,
          nameEs: btn.getAttribute('data-name-es') || code,
          nameEn: btn.getAttribute('data-name-en') || code,
          unitWeightKg: Number(btn.getAttribute('data-weight-kg')) || 18.0,
          qty: 1,
          criticalityMode: 'PARO_DE_LINEA',
        });
        if (msg) {
          msg.hidden = false;
          msg.textContent = isEn
            ? `${code} added to B2B Tray (${updated.items.length} active lines).`
            : `${code} agregado a la Bandeja B2B (${updated.items.length} partidas activas).`;
        }
      });
    }
  }

  bootAtomicPartIsland();
  document.addEventListener('astro:page-load', bootAtomicPartIsland);
</script>
