---
/**
 * FiltrationCalculatorIsland.astro
 * ---------------------------------------------------------------------------
 * Isla Canónica Bilingüe Única de Filtración (Timoshenko ΔP > 3.5 bar,
 * ciclo Darcy-Ruth y cumplimiento SEMARNAT NOM-141) para /filtracion/* y
 * modo embebido en /cotizar/ (`D1-V50`, `D2-V50`, DEB-V50-10).
 */
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import CircuitNavigator from '../CircuitNavigator.astro';
import SharePurchasing from '../SharePurchasing.astro';
import rolesData from '../../../data/roles.json';

interface Props {
  locale?: 'es' | 'en';
  variant?: 'hub' | 'press' | 'parts';
  mode?: 'standalone' | 'embedded';
}

const {
  locale = 'es',
  variant = 'hub',
  mode = 'standalone',
} = Astro.props;

const isEs = locale === 'es';
const lang = locale;
const isEmbedded = mode === 'embedded';

const filtVertical = rolesData.verticals.find((v) => v.id === 'filtracion');
const roleIdTarget = variant === 'parts' ? 'repuestos_prensa' : 'prensa_completa';
const activeRole =
  filtVertical?.capex?.find((r) => r.role_id === roleIdTarget) ||
  filtVertical?.opex?.find((r) => r.role_id === roleIdTarget) ||
  filtVertical?.capex?.[0];
const criteria = activeRole?.decision_criteria;

const stratumId =
  variant === 'press'
    ? 'stratum1-press-sim'
    : variant === 'parts'
      ? 'stratum1-parts-sim'
      : 'stratum1-filtration-sim';

const quoteBase = isEs ? '/cotizar/' : '/en/quote/';
const filtBase = isEs ? '/filtracion/' : '/en/filtration/';
const productsBase = isEs ? '/productos/' : '/en/products/';
const quoteEquipo = variant === 'parts' ? 'placas_telas' : 'filtro_prensa';
const defaultPressureBar = variant === 'press' ? '16' : '12';
const defaultPlateWidth = variant === 'press' ? '1500' : '1200';
---

{isEmbedded ? (
  <div id="wb-filt-timoshenko-live-box" data-testid="wb-filt-timoshenko-live-box" class="hidden embedded-filt-box">
    <div class="smat-flex-between">
      <strong class="embedded-filt-title">
        {isEs
          ? 'VERIFICADOR EN VIVO: RESISTENCIA DE PLACAS A 16 BAR Y CICLO DE FILTRADO'
          : 'LIVE VERIFIER: 16-BAR PLATE STRENGTH & FILTRATION CYCLE'}
      </strong>
      <span class="embedded-filt-badge">{isEs ? 'Jales Secos NOM-141' : 'NOM-141 Dry Stacking'}</span>
    </div>

    <div class="smat-inputs-2col smat-mt-sm">
      <div class="form-group">
        <label class="smat-field-label" for="wb-filt-width">
          {isEs ? 'Ancho Placa (mm):' : 'Plate Width (mm):'}
        </label>
        <select id="wb-filt-width" class="smat-input-control wb-select font-mono-tech" data-wb-circuit-calc-input>
          <option value="800">800 × 800 mm</option>
          <option value="1200">1200 × 1200 mm</option>
          <option value="1500" selected>1500 × 1500 mm</option>
          <option value="2000">2000 × 2000 mm</option>
        </select>
      </div>
      <div class="form-group">
        <label class="smat-field-label" for="wb-filt-pressure">
          {isEs ? 'Presión Alim. (bar):' : 'Feed Press. (bar):'}
        </label>
        <input type="number" id="wb-filt-pressure" min="4" max="25" step="1" value="12" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
      </div>
      <div class="form-group">
        <label class="smat-field-label" for="wb-filt-clogged">
          {isEs ? 'Puertos Obstr. (0–4):' : 'Clogged Ports (0–4):'}
        </label>
        <input type="number" id="wb-filt-clogged" min="0" max="4" step="1" value="0" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
      </div>
      <div class="form-group">
        <label class="smat-field-label" for="wb-filt-thickness">
          {isEs ? 'Espesor Placa (mm):' : 'Plate Thick. (mm):'}
        </label>
        <input type="number" id="wb-filt-thickness" min="40" max="120" step="5" value="65" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
      </div>
      <div class="form-group">
        <label class="smat-field-label" for="wb-filt-moisture">
          {isEs ? 'Humedad Meta (%):' : 'Target Moisture (%):'}
        </label>
        <input type="number" id="wb-filt-moisture" min="8" max="28" step="0.5" value="14" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
      </div>
    </div>

    <div class="embedded-filt-res font-mono-tech smat-mt-sm">
      <div class="embedded-res-cell"><strong>{isEs ? 'Esfuerzo σ_max:' : 'Bending σ_max:'}</strong> <span id="wb-filt-res-stress" data-testid="wb-filt-res-stress">3.54 MPa</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Seguridad Placa:' : 'Plate Safety:'}</strong> <span id="wb-filt-res-fs" data-testid="wb-filt-res-fs">FS 4.10</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Capacidad Ciclo:' : 'Cycle Capacity:'}</strong> <span id="wb-filt-res-cycles" data-testid="wb-filt-res-cycles">36 c/d</span> · <span id="wb-filt-res-tpd" data-testid="wb-filt-res-tpd">285 t/d</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Dictamen NOM-141:' : 'NOM-141 Ruling:'}</strong> <span id="wb-filt-res-nom141" data-testid="wb-filt-res-nom141">{isEs ? 'Cumple NOM-141' : 'NOM-141 OK'}</span> (<span id="wb-filt-res-status" data-testid="wb-filt-res-status">{isEs ? 'NOM-141 Segura' : 'NOM-141 Safe'}</span>)</div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Desglose Ciclo:' : 'Cycle Timing:'}</strong> <span id="wb-filt-res-cycle-min" data-testid="wb-filt-res-cycle-min">{isEs ? 'Filtrado 18.0 min + Descarga 12 min = 30.0 min' : 'Filtration 18.0 min + Turnaround 12 min = 30.0 min'}</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'ΔP Asimétrica / Fatiga:' : 'Asymmetric ΔP / Fatigue:'}</strong> <span id="wb-filt-res-asym-dp" data-testid="wb-filt-res-asym-dp">ΔP = 0.00 MPa | σ_adm,PP = 14.5 MPa</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'SKUs Placa y Tela:' : 'Plate & Cloth SKUs:'}</strong> <span id="wb-filt-res-skus" data-testid="wb-filt-res-skus">Placa: SMAT-FILT-CLOTH-PLATE | Tela: SMAT-CL-PP750</span></div>
    </div>
  </div>
) : (
  <div class="filt-standalone-wrap" data-island-standalone="filtration">
    <section class={`page-hero ${variant !== 'hub' ? 'smat-compact-hero' : ''}`}>
      <div class="container">
        <div class="smat-flex-between">
          <h1>
            {variant === 'press'
              ? (isEs ? 'Filtros Prensa — Simulador Darcy-Ruth & Timoshenko 16 bar' : 'Filter Presses — Darcy-Ruth & Timoshenko 16 bar')
              : variant === 'parts'
                ? (isEs ? 'Placas Filtrantes, Telas y Repuestos Hidráulicos' : 'Filter Plates, Cloths & Hydraulic Spares')
                : (isEs ? 'Filtros Prensa — Flexión Timoshenko & Torta Seca NOM-141' : 'Filter Presses — Timoshenko Flexure & NOM-141 Dry Cake')}
          </h1>
          <span class="badge badge-copper">
            {variant === 'parts'
              ? (isEs ? 'CÁMARA EMPOTRADA • 800 A 1500 MM' : 'RECESSED CHAMBER • 800 TO 1500 MM')
              : (isEs ? 'FILTRACIÓN Y DESAGUADO • 800 A 1500 MM' : 'FILTRATION & DEWATERING • 800 TO 1500 MM')}
          </span>
        </div>
        <p class={variant !== 'hub' ? 'smat-hero-sub' : 'hero-lead'}>
          {variant === 'parts'
            ? (isEs
                ? 'Telas filtrantes cortadas por láser con sellado perimetral térmico y placas de polipropileno virgen de 800 a 1500 mm.'
                : 'Laser-cut filter cloths with thermal perimeter sealing and virgin polypropylene plates from 800 to 1500 mm.')
            : (isEs
                ? 'Calibre presión de alimentación (hasta 16 bar), formato de placa (800–1500 mm) y humedad objetivo (≤ 16% NOM-141) en tiempo real.'
                : 'Calibrate feed pressure (up to 16 bar), plate dimensions (800–1500 mm), and target cake moisture (≤ 16% NOM-141).')}
        </p>
      </div>
    </section>

    <section class={`section ${variant !== 'hub' ? 'section-spacing smat-stage-compact' : ''}`} id="filtracion-main-section">
      <div class={`container ${variant !== 'hub' ? 'content-container' : ''}`}>
        <div class={variant !== 'hub' ? 'card detail-card' : ''}>
          <div id="nom141-plate-flexure-verifier" data-smat-calc={variant === 'hub' ? 'filtration' : undefined}>
            <div
              class="filtration-5family-box"
              id={stratumId}
              data-plate-flexure-panel="timoshenko-g5"
              data-stratum-1-instrument
            >
              <div class="smat-flex-between smat-mb-md">
                <span class="badge badge-copper">
                  {variant === 'parts'
                    ? (isEs ? 'DESPIECE EN 5 FAMILIAS · TIMOSHENKO 16 BAR' : '5-FAMILY BREAKDOWN · TIMOSHENKO 16 BAR')
                    : (isEs ? 'CUMPLIMIENTO SEMARNAT NOM-141 & TIMOSHENKO DARCY-RUTH' : 'SEMARNAT NOM-141 & DARCY-RUTH TIMOSHENKO SIMULATOR')}
                </span>
                <div class="smat-chip-row">
                  <span id="filt-nom141-badge" class="smat-badge-emerald">
                    {isEs ? 'NOM-141 Humedad OK (14% ≤ 16%)' : 'NOM-141 Moisture OK (14% ≤ 16%)'}
                  </span>
                  <span id="filt-shifter-sku-badge" class="smat-badge-solar">
                    SMAT-FILT-SHIFTER-CHAIN
                  </span>
                </div>
              </div>

              <h2 class="calc-heading">
                {variant === 'parts'
                  ? (isEs
                      ? '#01 Placas PP · #02 Lonas Calandradas · #03 Plate Shifter · #04 Cadenas · #05 Hidráulica'
                      : '#01 PP Plates · #02 Filter Cloths · #03 Plate Shifter · #04 Chains · #05 Hydraulics')
                  : (isEs
                      ? 'Simulador de Tonelaje Seco (t/d), Ciclos y Esfuerzo de Placa a 16 bar'
                      : 'Dry Tonnage (t/d), Cycle Capacity & 16-Bar Plate Flexure Simulator')}
              </h2>

              <div class="smat-stratum1-display">
                <div id="filt-res-summary" class="filt-summary-banner">
                  {isEs
                    ? 'Operación estructural segura. Cumple criterio de torta seca NOM-141.'
                    : 'Structurally safe operation. Meets NOM-141 dry cake criteria.'}
                </div>
                <div class="smat-grid-2">
                  <div class="smat-readout-box">
                    <span class="readout-label">{isEs ? 'ESFUERZO TIMOSHENKO (σ_max)' : 'TIMOSHENKO BENDING STRESS (σ_max)'}</span>
                    <strong id="filt-res-stress" class="smat-readout-kpi">3.54 MPa</strong>
                  </div>
                  <div class="smat-readout-box">
                    <span class="readout-label">{isEs ? 'FACTOR DE SEGURIDAD (FS)' : 'SAFETY FACTOR (FS)'}</span>
                    <strong id="filt-res-fs" class="smat-readout-kpi">FS 4.10</strong>
                  </div>
                </div>
                <div id="filt-res-secondary" class="filt-secondary-banner">
                  ΔP = 0.216 MPa · σ_adm = 14.5 MPa · 45 ciclos/d · 512 t/d
                </div>
              </div>

              <div class="smat-inputs-2col smat-panel-soft">
                <label class="calc-field">
                  <span>{isEs ? 'Formato Placa (mm):' : 'Plate Size (mm):'}</span>
                  <select id="filt-plate-width" class="smat-input-control">
                    <option value="800">800 × 800 mm</option>
                    <option value="1000">1000 × 1000 mm</option>
                    <option value="1200" selected={defaultPlateWidth === '1200'}>1200 × 1200 mm</option>
                    <option value="1500" selected={defaultPlateWidth === '1500'}>1500 × 1500 mm</option>
                  </select>
                </label>
                <label class="calc-field">
                  <span>{isEs ? 'Presión Alimentación (bar):' : 'Feed Pressure (bar):'}</span>
                  <input type="number" id="filt-pressure-bar" min="4" max="25" step="1" value={defaultPressureBar} class="smat-input-control" />
                </label>
                <label class="calc-field">
                  <span>{isEs ? 'Puertos Obstruidos (0–4):' : 'Clogged Ports (0–4):'}</span>
                  <input type="number" id="filt-clogged-ports" min="0" max="4" step="1" value="0" class="smat-input-control" />
                </label>
                <label class="calc-field">
                  <span>{isEs ? 'Espesor Alma Placa (mm):' : 'Plate Thickness (mm):'}</span>
                  <input type="number" id="filt-plate-thickness" min="45" max="110" step="5" value="65" class="smat-input-control" />
                </label>
                <label class="calc-field">
                  <span>{isEs ? 'Humedad Residual Meta (%):' : 'Target Moisture (%):'}</span>
                  <input type="number" id="filt-cake-moisture" min="8" max="26" step="0.5" value="14" class="smat-input-control" />
                </label>
              </div>

              <div class="smat-cta-row">
                <a
                  href={`${quoteBase}?circuito=filtracion&equipo=${quoteEquipo}&serie=${defaultPlateWidth}&filt_condition=${variant === 'parts' ? 'fuga_chorreo' : 'jales_secos'}#rfq`}
                  data-quote-base={quoteBase}
                  class="btn btn-primary smat-tap-btn"
                >
                  {isEs ? 'Cotizar Calibrado →' : 'Quote Calibrated Unit →'}
                </a>
                <button
                  type="button"
                  class="btn btn-outline btn-avenue-tray smat-tap-btn"
                  data-vertical-tray-btn
                  data-add-tray-sku="SMAT-FILT-CLOTH-PLATE"
                  data-tray-part-code={`PP-${defaultPlateWidth}`}
                  data-tray-title={isEs ? `Placas Polipropileno y Telas ${defaultPlateWidth} mm (16 bar)` : `16 bar PP Plates & Filter Cloths ${defaultPlateWidth} mm`}
                  data-tray-series={defaultPlateWidth}
                  data-tray-material="PP"
                  data-tray-circuit="filtracion"
                  data-tray-source={`filtration_${variant}_stratum1_calc`}
                >
                  {isEs ? '+ Bandeja Lonas / Placas' : '+ Tray Cloths / Plates'}
                </button>
                <a href={`${productsBase}${isEs ? 'lonas-y-placas-filtro-prensa-16bar/' : 'filter-press-cloths-and-pp-plates-16bar/'}`} class="btn btn-outline">
                  SMAT-FILT-CLOTH-PLATE →
                </a>
                <a href={`${productsBase}${isEs ? 'mecanismo-plate-shifter-y-cadenas/' : 'filter-press-plate-shifter-and-chains/'}`} class="btn btn-outline">
                  SMAT-FILT-SHIFTER-CHAIN →
                </a>
              </div>
            </div>
          </div>

          <div class="smat-mb-md">
            <TechnicalDiagrams diagram="filter" lang={lang} />
          </div>

          {variant === 'hub' ? (
            <div class="grid-2 smat-mb-md">
              <div class="card">
                <h3>{isEs ? 'Filtros Prensa Electrohidráulicos' : 'Electro-Hydraulic Filter Presses'}</h3>
                <p>
                  {isEs
                    ? 'Filtros prensa de placas empotradas con cierre electrohidráulico para desaguado de concentrados y jales hasta 16 bar.'
                    : 'Recessed chamber filter presses with automated hydraulic closure up to 16 bar for concentrates and dry tailings.'}
                </p>
                <p class="smat-mono-val">{isEs ? 'Cámara empotrada: 800 mm a 1500 mm • Ciclos 20–40 min' : 'Recessed plates: 800 mm to 1500 mm • 20–40 min cycles'}</p>
                <div class="smat-cta-row">
                  <a href={`${filtBase}${isEs ? 'prensa/' : 'press/'}`} class="btn btn-outline">
                    {isEs ? 'Ficha Técnica' : 'Technical Sheet'}
                  </a>
                  <a href={`${quoteBase}?circuito=filtracion&equipo=filtro_prensa&serie=1500&filt_condition=jales_secos#rfq`} class="btn btn-primary">
                    {isEs ? 'Cotizar →' : 'Quote →'}
                  </a>
                </div>
              </div>

              <div class="card">
                <h3>{isEs ? 'Placas Filtrantes, Telas y Repuestos Hidráulicos' : 'Filter Plates, Cloths & Hydraulic Spares'}</h3>
                <p>
                  {isEs
                    ? 'Telas filtrantes cortadas por láser con termosellado perimetral y placas en polipropileno virgen copolímero.'
                    : 'Laser-cut filter cloths with thermally sealed borders and virgin copolymer polypropylene chamber plates.'}
                </p>
                <p class="smat-mono-val">{isEs ? 'Polipropileno Virgen y Fieltro Agujado Calibrado al P80' : 'Virgin Polypropylene & P80-Matched Needlefelt'}</p>
                <div class="smat-cta-row">
                  <a href={`${filtBase}${isEs ? 'repuestos/' : 'parts/'}`} data-subroute-link={`${filtBase}${isEs ? 'repuestos/' : 'parts/'}`} class="btn btn-outline">
                    {isEs ? 'Ficha Técnica' : 'Technical Sheet'}
                  </a>
                  <a href={`${quoteBase}?circuito=filtracion&equipo=placas_telas&serie=1500&filt_condition=fuga_chorreo#rfq`} class="btn btn-primary">
                    {isEs ? 'Cotizar →' : 'Quote →'}
                  </a>
                </div>
              </div>
            </div>
          ) : (
            <>
              <h2>
                {variant === 'press'
                  ? (isEs ? 'Especificaciones del Filtro Prensa' : 'Filter Press Engineering Specifications')
                  : (isEs ? 'Telas Filtrantes, Placas PP y Mecanismo Corre-Placas' : 'Filter Cloths, PP Plates & Plate Shifter')}
              </h2>
              <p>
                {variant === 'press'
                  ? (isEs
                      ? 'Diseñados para lograr humedades residuales del 12% al 16% con máxima recuperación de agua en circuito cerrado.'
                      : 'Engineered to reach 12%–16% residual cake moisture with maximum closed-circuit water recovery.')
                  : (isEs
                      ? 'Protección estructural contra flexión asimétrica (Timoshenko, σ_adm = 18 MPa) y fabricación especial bajo plano confirmado (50% anticipo).'
                      : 'Structural sizing against asymmetric pressure differential (Timoshenko, σ_allow = 18 MPa) and custom runs under confirmed drawing (50% advance).')}
              </p>

              <table class="tech-table">
                <thead>
                  <tr>
                    <th>{isEs ? 'Parámetro de Diseño' : 'Design Parameter'}</th>
                    <th>{isEs ? 'Especificación SMAT' : 'SMAT Specification'}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>{isEs ? 'Tamaños de Placa' : 'Plate Dimensions'}</td>
                    <td>800×800 mm, 1000×1000 mm, 1200×1200 mm, 1500×1500 mm</td>
                  </tr>
                  <tr>
                    <td>{isEs ? 'Presión de Alimentación / Cierre' : 'Feed / Clamping Pressure'}</td>
                    <td>{isEs ? 'Pulpa hasta 16 bar · Cierre hidráulico hasta 350 bar' : 'Slurry up to 16 bar · Hydraulic closure up to 350 bar'}</td>
                  </tr>
                  <tr>
                    <td>{isEs ? 'Resistencia Darcy-Ruth & NOM-141' : 'Darcy-Ruth & NOM-141'}</td>
                    <td>α = α₀ (ΔP)ˢ (s = 0.65) · SEMARNAT NOM-141 (&le; 16% {isEs ? 'humedad' : 'moisture'})</td>
                  </tr>
                  <tr>
                    <td>{isEs ? 'Transporte de Placas' : 'Plate Shifting'}</td>
                    <td>{isEs ? 'Corre-placas automático, cadenas y sellos hidráulicos' : 'Automated plate shifter carriage, chains & cylinder seals'}</td>
                  </tr>
                </tbody>
              </table>

              {criteria && (
                <div class="decision-criteria-panel" data-testid="role-decision-criteria">
                  <span class="badge badge-copper">{isEs ? 'CRITERIOS DE DECISIÓN METALÚRGICA EN PLANTA' : 'PLANT METALLURGICAL SELECTION MATRIX'}</span>
                  <h3>{isEs ? `Matriz de Selección (${activeRole?.series})` : `Selection Matrix (${activeRole?.series})`}</h3>
                  <div class="smat-grid-3">
                    <div class="smat-panel-soft">
                      <strong class="criteria-label">{isEs ? 'Variables Requeridas' : 'Required Slurry Vars'}</strong>
                      <span>{isEs ? criteria.required_slurry_vars_es : criteria.required_slurry_vars_en}</span>
                    </div>
                    <div class="smat-panel-soft">
                      <strong class="criteria-label-solar">{isEs ? 'Regla de Cámara y Compresión' : 'Chamber & Weave Rule'}</strong>
                      <span>{isEs ? criteria.metallurgy_rule_es : criteria.metallurgy_rule_en}</span>
                    </div>
                    <div class="smat-panel-soft">
                      <strong class="criteria-label-emerald">{isEs ? 'Riesgo Mitigado' : 'Mitigated Risk'}</strong>
                      <span>{isEs ? criteria.risk_avoided_es : criteria.risk_avoided_en}</span>
                    </div>
                  </div>
                </div>
              )}

              <div class="filtration-selector-box" data-testid="filtration-contextual-selector">
                <span class="badge badge-copper">{isEs ? 'PRE-SELECCIÓN CONTEXTUAL • PUENTE A COTIZADOR' : 'CONTEXTUAL PRE-SELECTION • QUOTE BRIDGE'}</span>
                <h3>{isEs ? 'Seleccione Dimensión de Placa y Condición' : 'Select Plate Format & Dewatering Duty'}</h3>
                <div class="smat-cta-row">
                  <a href={`${quoteBase}?circuito=filtracion&equipo=${quoteEquipo}&serie=800&filt_condition=ciclo_lento#rfq`} class="btn btn-outline">800×800 mm</a>
                  <a href={`${quoteBase}?circuito=filtracion&equipo=${quoteEquipo}&serie=1200&filt_condition=${variant === 'parts' ? 'fuga_chorreo' : 'jales_secos'}#rfq`} class="btn btn-outline">1200×1200 mm</a>
                  <a href={`${quoteBase}?circuito=filtracion&equipo=${quoteEquipo}&serie=1500&filt_condition=jales_secos#rfq`} class="btn btn-outline">1500×1500 mm (Dry Stacking)</a>
                </div>
              </div>
            </>
          )}

          <SharePurchasing
            roleTitle={variant === 'parts'
              ? (isEs ? 'Placas Filtrantes, Telas y Repuestos Hidráulicos' : 'Filter Plates, Cloths & Hydraulic Spares')
              : (isEs ? 'Filtro Prensa Electrohidráulico (800 a 1500 mm)' : 'Electro-Hydraulic Filter Press (800 to 1500 mm)')}
            partCode={variant === 'parts' ? 'SMAT-FILT-CLOTH-PLATE' : 'SMAT-FILT-SHIFTER-CHAIN'}
            specs={isEs ? 'Cámara empotrada 800–1500 mm · Hasta 16 bar · Cumplimiento NOM-141' : 'Recessed chamber 800–1500 mm · Up to 16 bar · NOM-141 Compliant'}
            metallurgy={isEs ? 'Acero Estructural / Polipropileno Virgen / Fieltro Agujado' : 'Structural Steel / Virgin Polypropylene / Needlefelt'}
            series="800 mm – 1500 mm"
            roleId={variant === 'parts' ? 'placas_telas' : 'filtro_prensa'}
            circuit="filtracion"
            lang={lang}
          />
        </div>
      </div>
    </section>

    {variant === 'hub' && (
      <section class="section circuit-nav-band">
        <div class="container">
          <CircuitNavigator lang={lang} defaultCircuit="jales_filtracion" />
        </div>
      </section>
    )}
  </div>
)}

<script>
  import { bindCanonicalFiltrationCalculator } from '../../scripts/verticalCalculatorsAndLabelsBridge.js';

  function initFiltrationIsland() {
    const standaloneRoot = document.querySelector('[data-island-standalone="filtration"]');
    if (!standaloneRoot) return;
    const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
    bindCanonicalFiltrationCalculator(standaloneRoot, lang);
  }

  initFiltrationIsland();
