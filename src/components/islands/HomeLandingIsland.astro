---
/**
 * HomeLandingIsland.astro — Escaparate Compra-First SMAT Minerals V6.0
 * Cowan scrollY=0 <= 4 bloques focales (Hero foto real + Buscador Drop-In + 1 CTA).
 */
import TrustMatrix from '../TrustMatrix.astro';
import ProductStorefrontCard from '../ProductStorefrontCard.astro';
import DropInVerifierCore from '../cores/DropInVerifierCore.astro';
import { getQuickProductsCatalog } from '../../scripts/quickProductsCatalog.js';

interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const isEs = locale === 'es';
const lang = locale;

const quickCatalog = getQuickProductsCatalog();
const featuredIds = [
  'SMAT-PUMP-IMP-AH',
  'SMAT-PUMP-WETKIT-554',
  'SMAT-PUMP-BRG-005M',
  'SMAT-CYC-D6-D20',
  'SMAT-FILT-CLOTH-PLATE',
  'SMAT-LAB-MARCY-1000',
];
const featuredSkus = featuredIds
  .map((id) => quickCatalog.find((s) => s.id === id))
  .filter(Boolean);

const catalogPath = isEs ? '/catalogo/' : '/en/catalog/';
const quotePath = isEs ? '/cotizar/' : '/en/quote/';

const plantAreas = [
  {
    href: isEs ? '/bombeo/' : '/en/pumping/',
    img: '/images/productos/impulsor-bomba-lodos-serie-ah.webp',
    titleEs: 'Bombas y Extremo Húmedo',
    titleEn: 'Slurry Pumps & Wet-End',
    subEs: 'Impulsores Cr27%, volutas, sellos secos y Bearing Assembly.',
    subEn: '27% Cr impellers, volutes, dry expellers & Bearing Assemblies.',
  },
  {
    href: isEs ? '/clasificacion/' : '/en/classification/',
    img: '/images/productos/hidrociclon-completo-y-boquillas-d6-d20.webp',
    titleEs: 'Hidrociclones y Cribas',
    titleEn: 'Hydrocyclones & Screens',
    subEs: 'Baterías D6–D20, boquillas SiC, mallas TH48-30 y módulos 1\'x1\'.',
    subEn: 'D6–D20 clusters, SiC spigots, TH48-30 mats & 1\'x1\' panels.',
  },
  {
    href: isEs ? '/flotacion/' : '/en/flotation/',
    img: '/images/productos/mecanismo-suspendido-flotacion-18sp.webp',
    titleEs: 'Flotación y Acondicionamiento',
    titleEn: 'Flotation & Conditioners',
    subEs: 'Mecanismos #18 SP / #24 / #30 y kits rotor-estator en poliuretano.',
    subEn: '#18 SP / #24 / #30 mechanisms & drop-in urethane rotor-stators.',
  },
  {
    href: isEs ? '/filtracion/' : '/en/filtration/',
    img: '/images/productos/lonas-y-placas-filtro-prensa-16bar.webp',
    titleEs: 'Filtración Prensa 16 bar',
    titleEn: '16-Bar Filter Press',
    subEs: 'Placas de polipropileno 800–1500 mm, lonas y corre-placas.',
    subEn: '800–1500 mm virgin PP plates, cloths & shifter mechanisms.',
  },
  {
    href: isEs ? '/control-de-procesos/' : '/en/process-control/',
    img: '/images/productos/balanza-marcy.webp',
    titleEs: 'Laboratorio y Control',
    titleEn: 'Metallurgical Lab & Control',
    subEs: 'Balanzas Marcy, filtros batch, tamices ASTM E11 y pulverizadores.',
    subEn: 'Marcy scales, batch filters, ASTM E11 sieves & pulverizers.',
  },
];
---

<!-- Pliegue Principal (Cowan N <= 4): Título + Buscador + 1 CTA + Foto Real -->
<section class="hero-home">
  <div class="container smat-home-hero-grid">
    <div class="smat-home-hero-copy">
      <div class="hero-badge-pill">
        <span class="live-dot" aria-hidden="true"></span>
        <span>{isEs ? 'Almacén Central en Durango · Despacho 24–48 h' : 'Durango Central Warehouse · 24–48h Dispatch'}</span>
      </div>

      <h1>
        {isEs
          ? 'Refacciones para Bombas de Lodos, Hidrociclones, Flotación y Filtración'
          : 'Slurry Pump Spares, Hydrocyclones, Flotation & Filter Press Parts'}
      </h1>
      <p class="smat-home-lead">
        {isEs
          ? 'Compatibilidad dimensional 1:1, facturación nacional CFDI 4.0 u Orden de Compra SAP y envío directo a unidad minera.'
          : '1:1 dimensional drop-in interchangeability, domestic CFDI 4.0 or SAP PO procurement, and direct mine-site dispatch.'}
      </p>

      <div id="workbench" class="dropin-verifier-solar">
        <DropInVerifierCore lang={lang} variant="home" />
      </div>

      <div class="hero-actions">
        <a href={catalogPath} class="btn btn-primary btn-lg">
          {isEs ? `Ver catálogo completo (${quickCatalog.length} productos) →` : `Browse full catalog (${quickCatalog.length} SKUs) →`}
        </a>
        <a href={`${quotePath}#rfq`} class="btn btn-outline btn-lg">
          {isEs ? 'Cotizar lista SAP / Excel' : 'Quote SAP / BOM list'}
        </a>
      </div>
    </div>

    <div class="smat-home-hero-media">
      <figure class="smat-home-hero-main-fig">
        <img
          src="/images/almacen/almacen-bomba-6x4-dah.webp"
          alt={isEs ? 'Bomba centrífuga de lodos 6x4 DAH en Almacén Central SMAT Durango' : '6x4 DAH slurry pump assembled at SMAT Durango Central Warehouse'}
          width="640"
          height="480"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
      <div class="smat-home-hero-thumbs">
        <img
          src="/images/almacen/almacen-volutas-cromo-caja.webp"
          alt={isEs ? 'Volutas de Alto Cromo 27% en Almacén Durango' : '27% High Chrome volutes staged in Durango'}
          width="640"
          height="480"
          loading="eager"
          decoding="async"
        />
        <img
          src="/images/almacen/almacen-rodamientos-ah.webp"
          alt={isEs ? 'Cartuchos de rodamientos Bearing Assembly armados' : 'Assembled Bearing Assembly cartridges in stock'}
          width="640"
          height="480"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<!-- Sección 2: Top 6 Productos de Despacho Directo desde Durango -->
<section class="equipment-showcase-section" id="home-quick-checkout-catalog" aria-label={isEs ? 'Más solicitados' : 'Most requested spares'}>
  <div class="container">
    <div class="showcase-header smat-flex-between">
      <div>
        <span class="section-eyebrow">{isEs ? 'INVENTARIO FÍSICO EN DURANGO' : 'IN-STOCK WAREHOUSE INVENTORY'}</span>
        <h2>{isEs ? 'Más solicitados · Despacho desde Durango' : 'Most requested · Dispatched from Durango'}</h2>
      </div>
      <a href={catalogPath} class="showcase-cta-primary">
        {isEs ? `Ver los ${quickCatalog.length} productos →` : `View all ${quickCatalog.length} products →`}
      </a>
    </div>

    <div class="smat-sf-grid">
      {featuredSkus.map((sku, idx) => (
        <ProductStorefrontCard sku={sku} lang={lang} eager={idx < 3} />
      ))}
    </div>
  </div>
</section>

<!-- Sección 3: Compra por Área de Planta (5 Verticales con Foto Real) -->
<section class="quick-sku-home-section" aria-label={isEs ? 'Áreas de planta' : 'Plant areas'}>
  <div class="container">
    <div class="showcase-header">
      <span class="section-eyebrow">{isEs ? 'NAVEGACIÓN POR CIRCUITO' : 'SHOP BY PLANT CIRCUIT'}</span>
      <h2>{isEs ? 'Compra por área de planta concentradora' : 'Shop by concentrator plant area'}</h2>
    </div>

    <div class="smat-home-areas-grid">
      {plantAreas.map((area) => (
        <a href={area.href} class="smat-home-area-card">
          <img src={area.img} alt={isEs ? area.titleEs : area.titleEn} width="640" height="480" loading="lazy" decoding="async" />
          <div class="smat-home-area-body">
            <h3>{isEs ? area.titleEs : area.titleEn}</h3>
            <p>{isEs ? area.subEs : area.subEn}</p>
            <span class="smat-home-area-cta">{isEs ? 'Ver refacciones y asistencia →' : 'Browse spares & sizing →'}</span>
          </div>
        </a>
      ))}
    </div>

    <details class="home-avenues-disclosure smat-mt-sm">
      <summary class="home-avenues-summary">
        {isEs ? 'Asistentes técnicos opcionales (hidráulica, hidrociclones 3 vasos, flotación y prensa 16 bar) ▾' : 'Optional engineering calculators (hydraulics, 3-cup cyclone, flotation & 16-bar filter press) ▾'}
      </summary>
      <div class="part-chip-strip smat-mt-sm">
        <a href={isEs ? '/bombeo/#bombeo-main-section' : '/en/pumping/#bombeo-main-section'} class="part-chip">{isEs ? 'Calculadora Hidráulica Bombeo →' : 'Slurry Pumping Calculator →'}</a>
        <a href={isEs ? '/clasificacion/#marcy-3cup-cyclone-calculator' : '/en/classification/#marcy-3cup-cyclone-calculator'} class="part-chip">{isEs ? 'Balance 3 Vasos Hidrociclón →' : '3-Cup Hydrocyclone Balance →'}</a>
        <a href={isEs ? '/flotacion/#flotacion-main-section' : '/en/flotation/#flotacion-main-section'} class="part-chip">{isEs ? 'Cinética de Flotación →' : 'Flotation Cell Sizing →'}</a>
        <a href={isEs ? '/filtracion/#filtracion-main-section' : '/en/filtration/#filtracion-main-section'} class="part-chip">{isEs ? 'Ciclo Filtro Prensa →' : 'Filter Press Cycle →'}</a>
      </div>
    </details>
  </div>
</section>

<TrustMatrix lang={lang} hideBoundaries={true} />

<script>
  import { bindHomeCatalogDrawerAndDropIn } from '../../scripts/homeAndEquipmentCatalogFilter.js';
  import { bindAtomicPartTrayButtons } from '../../scripts/verticalStateAndCtaSyncBridge.js';

  function initHomeIsland() {
    const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
    bindHomeCatalogDrawerAndDropIn(document, lang);
    bindAtomicPartTrayButtons(document);
  }

  initHomeIsland();
  document.addEventListener('astro:page-load', initHomeIsland);
</script>

<style>
  .hero-home { background-color: var(--smat-bg-canvas); color: var(--smat-text-primary); padding: 1.5rem 0; border-bottom: 1px solid var(--smat-border-light); }
  .smat-home-hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 1.5rem; align-items: center; }
  .smat-home-hero-copy { display: flex; flex-direction: column; gap: 0.75rem; }
  .hero-badge-pill { display: inline-flex; width: fit-content; align-items: center; gap: 0.5rem; background: #ffffff; border: 1px solid #cbd5e1; color: #334155; padding: 0.28rem 0.75rem; border-radius: 999px; font-size: 0.74rem; font-weight: 700; }
  .live-dot { width: 8px; height: 8px; background-color: #059669; border-radius: 50%; display: inline-block; }
  .hero-home h1 { color: var(--smat-text-primary); font-size: clamp(1.65rem, 2.7vw, 2.3rem); margin: 0; letter-spacing: -0.025em; line-height: 1.14; }
  .smat-home-lead { margin: 0; font-size: 0.96rem; color: #334155; line-height: 1.45; }
  .smat-home-hero-media { display: grid; gap: 0.65rem; }
  .smat-home-hero-main-fig { margin: 0; border-radius: 14px; overflow: hidden; border: 1px solid #cbd5e1; background: #ffffff; aspect-ratio: 4 / 3; }
  .smat-home-hero-main-fig img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .smat-home-hero-thumbs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem; }
  .smat-home-hero-thumbs img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; border: 1px solid #cbd5e1; }
  .dropin-verifier-solar { padding: 0.85rem 1rem; border-radius: 10px; background: #ffffff; border: 1.5px solid #cbd5e1; border-left: 4px solid #7c2d12; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .btn-lg { min-height: 48px; padding: 0.75rem 1.35rem; font-size: 0.92rem; }
  .equipment-showcase-section { padding: 2rem 0 2.5rem; background: #ffffff; border-bottom: 1px solid #e2e8f0; }
  .showcase-header { margin-bottom: 1.15rem; gap: 1rem; }
  .section-eyebrow { display: inline-block; font-family: var(--smat-font-mono, monospace); font-size: 0.72rem; font-weight: 800; color: #7c2d12; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.25rem; }
  .showcase-header h2 { font-size: clamp(1.35rem, 2.2vw, 1.85rem); margin: 0; color: #0f172a; }
  .showcase-cta-primary { display: inline-flex; align-items: center; min-height: 48px; font-size: 0.88rem; font-weight: 800; color: #7c2d12; text-decoration: none; white-space: nowrap; }
  .quick-sku-home-section { padding: 2rem 0; background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
  .smat-home-areas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; }
  .smat-home-area-card { display: flex; flex-direction: column; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 12px; overflow: hidden; text-decoration: none; color: #0f172a; transition: border-color 0.15s ease, transform 0.15s ease; }
  .smat-home-area-card:hover { border-color: #7c2d12; transform: translateY(-2px); }
  .smat-home-area-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; border-bottom: 1px solid #e2e8f0; }
  .smat-home-area-body { padding: 0.85rem 0.95rem; display: flex; flex-direction: column; flex: 1 1 auto; gap: 0.35rem; }
  .smat-home-area-body h3 { margin: 0; font-size: 1rem; color: #0f172a; }
  .smat-home-area-body p { margin: 0; font-size: 0.8rem; line-height: 1.4; color: #334155; }
  .smat-home-area-cta { margin-top: auto; padding-top: 0.4rem; font-size: 0.8rem; font-weight: 800; color: #7c2d12; }
  .home-avenues-disclosure { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 10px; padding: 0.4rem 0.95rem 0.85rem; }
  .home-avenues-summary { cursor: pointer; min-height: 48px; display: flex; align-items: center; font-weight: 700; font-size: 0.86rem; color: #0f172a; }
  .part-chip-strip { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .part-chip { display: inline-flex; align-items: center; min-height: 48px; min-width: 48px; padding: 0.45rem 0.85rem; border-radius: 8px; background: #f8fafc; border: 1px solid #cbd5e1; color: #0f172a; font-size: 0.8rem; font-weight: 700; text-decoration: none; }
  @media (max-width: 900px) {
    .hero-home { padding: 0.75rem 0 1rem; }
    .smat-home-hero-grid { grid-template-columns: 1fr; gap: 0.85rem; }
    .smat-home-hero-copy { gap: 0.5rem; }
    .hero-home h1 { font-size: clamp(1.35rem, 5.2vw, 1.8rem); }
    .smat-home-lead { font-size: 0.86rem; line-height: 1.38; }
    .dropin-verifier-solar { padding: 0.6rem 0.75rem; }
    .smat-home-hero-main-fig { max-height: 220px; }
  }
</style>
