---
/**
 * ProcessControlIsland.astro
 * ---------------------------------------------------------------------------
 * Isla Canónica Bilingüe Única de Control de Procesos (`D5-V51` / `SLICE-V51-12`):
 *   - Cero bifurcaciones duales `{mode}`.
 *   - Monta `<MetrologyLabCore />` único compartido entre `/control-de-procesos/` y `/cotizar/`.
 *   - Conserva envoltorio hero + fichas técnicas + `TechnicalDiagrams` + `CircuitNavigator` + `SharePurchasing`
 *     cuando `mode === 'standalone'`.
 */
import MetrologyLabCore from '../cores/MetrologyLabCore.astro';
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import CircuitNavigator from '../CircuitNavigator.astro';
import SharePurchasing from '../SharePurchasing.astro';
import rolesData from '../../../data/roles.json';
import { SMAT_SUPPLY_DOORS } from '../../scripts/i18nDomainLabels.js';

interface Props {
  locale?: 'es' | 'en';
  mode?: 'standalone' | 'embedded';
}

const { locale = 'es', mode = 'standalone' } = Astro.props;
const isEs = locale === 'es';
const lang = locale;
const showVerticalShell = mode === 'standalone';

const ctrlVertical = rolesData.verticals.find((v) => v.id === 'control_procesos');
const marcyRole = ctrlVertical?.capex?.find((r) => r.role_id === 'balanza_marcy');
const batchRole = ctrlVertical?.capex?.find((r) => r.role_id === 'filtro_batch_lab');
const tamizRole = ctrlVertical?.opex?.find((r) => r.role_id === 'tamices_laboratorio');

const quoteBase = isEs ? '/cotizar/' : '/en/quote/';
const classifHref = isEs ? '/clasificacion/#marcy-3cup-cyclone-calculator' : '/en/classification/#marcy-3cup-cyclone-calculator';
const marcySkuHref = isEs ? '/productos/balanza-marcy/' : '/en/products/marcy-pulp-density-scale/';
---

{showVerticalShell && (
  <div class="ctrl-standalone-wrap" data-island-standalone="metrology">
    <section class="page-hero smat-compact-hero">
      <div class="container">
        <span class="badge badge-copper">
          {isEs ? SMAT_SUPPLY_DOORS.door3.badgeEs : SMAT_SUPPLY_DOORS.door3.badgeEn}
        </span>
        <h1>{isEs ? 'Control de Procesos' : 'Process Control'}</h1>
        <p class="smat-hero-sub">
          {isEs
            ? 'Instrumentación de medición directa para control de molienda, clasificación, flotación y desaguado: Balanzas Marcy, Filtro de Presión Batch Lab (60–100 psi) y Tamices Certificados ASTM E11 / ISO 3310.'
            : 'Direct-reading metallurgical instrumentation for grinding, classification, flotation & dewatering: Marcy Pulp Density Scales, SMAT Batch Pressure Filters (60–100 psi) & ASTM E11 Test Sieves.'}
        </p>
        <div class="met-hero-actions smat-cta-row">
          <a href={`${quoteBase}?circuito=control_procesos#rfq`} class="btn btn-primary" data-ctrl-quote-link>
            {isEs ? 'Cotizar Instrumentación de Control →' : 'Quote Process Control Equipment →'}
          </a>
        </div>
      </div>
    </section>

    <section class="section smat-stage-compact" id="stage-diagnostic">
      <div class="container">
        <div id="metrology-calculator" class="card metrology-calc-card smat-mb-md" data-stratum-1-instrument>
          <div class="metrology-calc-header">
            <span class="badge badge-copper">
              {isEs ? 'HERRAMIENTA DE CONTROL METALÚRGICO EN PLANTA' : 'PLANT METALLURGICAL CONTROL INSTRUMENT'}
            </span>
            <h2>
              {isEs
                ? 'Simulador de Carátula Marcy, Filtro Prensa Lab y Serie √2 ASTM E11'
                : 'Marcy Dial Simulator, Lab Filter Press & ASTM E11 √2 Sieve Stack'}
            </h2>
            <p class="met-calc-sub">
              {isEs
                ? 'Calibre densidad de pulpa (Ss, Cw), masa mínima de muestreo y ciclos batch (Pierre Gy) o la serie de 7 tamices ASTM E11 (P80, Rosin-Rammler y\').'
                : 'Calibrate pulp density (Ss, Cw), minimum sampling mass and batch cycles (Pierre Gy), or the 7-sieve ASTM E11 stack (P80, Rosin-Rammler y\').'}
            </p>
          </div>

          <MetrologyLabCore locale={locale} showRoleSelectors={false} panelClass="metrology-core-standalone" />

          <div class="met-calc-footer">
            <a id="met-quote-cta" href={`${quoteBase}?circuito=control_procesos&equipo=balanza_marcy#rfq`} class="btn btn-primary">
              {isEs ? 'Cotizar con esta Calibración Metrológica →' : 'Quote With This Metrology Calibration →'}
            </a>
          </div>
        </div>

        <details class="metrology-circuit-drawer smat-mb-md" id="metrology-equipment-drawer">
          <summary class="metrology-circuit-drawer-summary">
            <span>
              <strong>
                {isEs
                  ? 'Fichas de Equipos (Balanza Marcy, Filtro Batch, Tamices ASTM) y Accesos Directos'
                  : 'Equipment Sheets (Marcy Scale, Batch Filter, ASTM Sieves) & Cross-Circuit Links'}
              </strong>
            </span>
            <span class="badge badge-copper">{isEs ? 'VER FICHAS ▾' : 'VIEW SHEETS ▾'}</span>
          </summary>

          <div class="met-calc-footer smat-mt-sm">
            <a id="met-pump-precal-cta" href={`${quoteBase}?circuito=bombeo#rfq`} class="btn btn-outline">
              {isEs ? 'Pre-calibrar Bomba con esta Densidad →' : 'Pre-Size Slurry Pump with This Density →'}
            </a>
            <a href={classifHref} class="btn btn-outline">
              {isEs ? 'Ver Balance 3 Vasos en Clasificación →' : 'View 3-Cup Cyclone Balance →'}
            </a>
          </div>

          <div class="metrology-segmented-bar smat-mt-sm" role="tablist" aria-label={isEs ? 'Equipos de laboratorio metalúrgico' : 'Metallurgical lab equipment'}>
            <button type="button" class="metrology-seg-btn is-active" data-met-station-tab="1" aria-selected="true">
              {isEs ? '1. Balanza Marcy (Ss / %Cw)' : '1. Marcy Scale (Ss / %Cw)'}
            </button>
            <button type="button" class="metrology-seg-btn" data-met-station-tab="2" aria-selected="false">
              {isEs ? '2. Filtro Batch Lab (60–100 psi)' : '2. Lab Batch Filter (60–100 psi)'}
            </button>
            <button type="button" class="metrology-seg-btn" data-met-station-tab="3" aria-selected="false">
              {isEs ? '3. Tamices ASTM E11 / √2' : '3. ASTM E11 Sieves / √2'}
            </button>
          </div>

          <div class="control-equipment-grid">
            <article id={isEs ? 'balanza-marcy' : 'marcy-scale'} class="card control-block" data-instrument-card="1">
              <div class="control-block-header">
                <span class="badge badge-copper">{isEs ? 'DENSIDAD DE PULPA • 12 ANILLOS' : 'PULP DENSITY • 12 DIAL RINGS'}</span>
                <h2>{isEs ? 'Balanza Marcy de Densidad de Pulpa y % de Sólidos' : 'Marcy Pulp Density & % Solids Scale'}</h2>
                <p class="block-lead">
                  {isEs
                    ? 'Medición gravimétrica en planta concentradora con vaso de 1000 cm³ y carátulas intercambiables calibradas según gravedad específica del mineral (Ss 2.2 a 4.4).'
                    : 'Gravimetric concentrator measurement with 1000 cm³ cup and interchangeable dial rings calibrated to ore specific gravity (Ss 2.2–4.4).'}
                </p>
              </div>
              <TechnicalDiagrams diagram="marcy" lang={lang} />
              <div class="specs-strip">
                <div><strong>{isEs ? 'Capacidad:' : 'Cup Volume:'}</strong> 1000 cm³ (Acero Inox 304 / Acrílico)</div>
                <div><strong>{isEs ? 'Anillos:' : 'Dials:'}</strong> 12 Carátulas (Ss 2.2 a 4.4)</div>
                {marcyRole?.decision_criteria && (
                  <div><strong>{isEs ? 'Regla:' : 'Rule:'}</strong> {isEs ? marcyRole.decision_criteria.metallurgy_rule_es : marcyRole.decision_criteria.metallurgy_rule_en}</div>
                )}
              </div>
              <div class="control-actions">
                <a href={marcySkuHref} class="btn btn-primary">{isEs ? 'Ver Ficha SKU Balanza Marcy →' : 'View Marcy Scale SKU →'}</a>
                <button type="button" class="btn btn-outline" data-add-tray-sku="SMAT-LAB-MARCY-1000" data-tray-circuit="control_procesos">{isEs ? '+ Bandeja' : '+ Tray'}</button>
              </div>
            </article>

            <article id={isEs ? 'filtro-batch' : 'batch-filter'} class="card control-block ctrl-hidden-tab" data-instrument-card="2">
              <div class="control-block-header">
                <span class="badge badge-copper">{isEs ? 'MUESTREO PIERRE GY • 60–100 PSI' : 'PIERRE GY SAMPLING • 60–100 PSI'}</span>
                <h2>{isEs ? 'Filtro de Presión Batch de Laboratorio' : 'Laboratory Batch Pressure Filter'}</h2>
                <p class="block-lead">
                  {isEs
                    ? 'Desaguado neumático rápido de muestras metalúrgicas para control de humedad y preparación hacia batería de tamizado ASTM E11.'
                    : 'Fast pneumatic dewatering of metallurgical samples for residual cake moisture testing and ASTM E11 sieve preparation.'}
                </p>
              </div>
              <TechnicalDiagrams diagram="batch_filter" lang={lang} />
              <div class="specs-strip">
                <div><strong>{isEs ? 'Presión:' : 'Pressure:'}</strong> 60–100 psi neumáticos</div>
                <div><strong>{isEs ? 'Criterio:' : 'Basis:'}</strong> Teoría de Muestreo Pierre Gy</div>
                {batchRole?.decision_criteria && (
                  <div><strong>{isEs ? 'Regla:' : 'Rule:'}</strong> {isEs ? batchRole.decision_criteria.metallurgy_rule_es : batchRole.decision_criteria.metallurgy_rule_en}</div>
                )}
              </div>
              <div class="control-actions">
                <a href={`${quoteBase}?circuito=control_procesos&equipo=filtro_batch_lab#rfq`} class="btn btn-primary">{isEs ? 'Cotizar Filtro Batch →' : 'Quote Batch Filter →'}</a>
                <button type="button" class="btn btn-outline" data-add-tray-sku="SMAT-LAB-FILTRO-BATCH" data-tray-circuit="control_procesos">{isEs ? '+ Bandeja' : '+ Tray'}</button>
              </div>
            </article>

            <article id={isEs ? 'tamices-astm' : 'astm-sieves'} class="card control-block ctrl-hidden-tab" data-instrument-card="3">
              <div class="control-block-header">
                <span class="badge badge-copper">{isEs ? 'GRANULOMETRÍA P80 • ASTM E11 / ISO 3310' : 'P80 PARTICLE SIZING • ASTM E11 / ISO 3310'}</span>
                <h2>{isEs ? 'Tamices de Laboratorio Certificados ASTM E11 y Tamizadores' : 'Certified ASTM E11 Test Sieves & Shakers'}</h2>
                <p class="block-lead">
                  {isEs
                    ? 'Tamices con malla tejida de precisión y marco embutido en Bronce o Acero Inoxidable (8" y 12") para control granulométrico P80.'
                    : 'Precision woven-wire test sieves with seamless Bronze or Stainless Steel frames (8" and 12") for tight P80 control.'}
                </p>
              </div>
              <TechnicalDiagrams diagram="sieves" lang={lang} />
              <div class="specs-strip">
                <div><strong>{isEs ? 'Aberturas:' : 'Aperture Range:'}</strong> 5" (125 mm) – #635 (20 µm) √2</div>
                <div><strong>{isEs ? 'Marcos:' : 'Frames:'}</strong> 8" / 12" Acero Inox 304/316 o Bronce</div>
                {tamizRole?.decision_criteria && (
                  <div><strong>{isEs ? 'Regla:' : 'Rule:'}</strong> {isEs ? tamizRole.decision_criteria.metallurgy_rule_es : tamizRole.decision_criteria.metallurgy_rule_en}</div>
                )}
              </div>
              <div class="control-actions">
                <a href={`${quoteBase}?circuito=control_procesos&equipo=tamices_laboratorio#rfq`} class="btn btn-primary">{isEs ? 'Cotizar Tamices ASTM →' : 'Quote ASTM Sieves →'}</a>
                <button type="button" class="btn btn-outline" data-add-tray-sku="SMAT-LAB-TAMIZ-E11" data-tray-circuit="control_procesos">{isEs ? '+ Bandeja' : '+ Tray'}</button>
              </div>
            </article>
          </div>

          <div class="stage2-compact smat-mt-sm" id="stage-2">
            <SharePurchasing
              roleTitle={isEs
                ? 'Paquete de Instrumentación de Control de Procesos (Balanza Marcy + Filtro Batch + Tamices ASTM E11)'
                : 'Process Control Instrumentation Package (Marcy Scale + Lab Batch Filter + ASTM E11 Sieves)'}
              specs={isEs
                ? 'Balanza Marcy vaso 1000 cm³ (12 anillos SG 2.2-4.4), Filtro Presión Batch 100 psi y Tamices ASTM E11'
                : 'Marcy Scale 1000 cm³ cup (12 dials SG 2.2-4.4), 100 psi Batch Pressure Filter & ASTM E11 Test Sieves'}
              metallurgy={isEs ? 'Acero Inoxidable 304 / 316 y Bronce sin costuras' : 'Seamless 304 / 316 Stainless Steel & Brass'}
              series={isEs ? 'Control Metalúrgico SMAT' : 'SMAT Metallurgical Control Line'}
              roleId="balanza_marcy"
              circuit="control_procesos"
              lang={lang}
            />
          </div>
        </details>
      </div>
    </section>

    <section class="section circuit-nav-band">
      <div class="container">
        <details class="metrology-circuit-drawer" id="metrology-circuit-drawer">
          <summary class="metrology-circuit-drawer-summary">
            <span>
              <strong>{isEs ? 'Explorador de Circuito P&ID Completo (9 Nodos Metalúrgicos)' : 'Complete Plant P&ID Explorer (9 Metallurgical Nodes)'}</strong>
            </span>
            <span class="badge badge-copper">{isEs ? 'EXPANDIR MAPA P&ID ▾' : 'EXPAND P&ID MAP ▾'}</span>
          </summary>
          <div class="smat-mt-sm">
            <CircuitNavigator lang={lang} />
          </div>
        </details>
      </div>
    </section>
  </div>
)}

{!showVerticalShell && (
  <MetrologyLabCore locale={locale} showRoleSelectors={true} panelClass="circuit-panel hidden embedded-ctrl-panel" />
)}

<script>
  import { MARCY_STANDARD_RINGS } from '../../scripts/slurryEngine.js';
  import { saveWorkbenchState, loadWorkbenchState } from '../../scripts/workbenchBus.js';
  import { bindDomainSchemaRoot, projectDomainOutputs, readAllCanonicalInputs } from '../../scripts/schemaRuntimeBinder.js';
  import { solveXdsmMultidisciplinaryDag } from '../../scripts/wizardXdsmDagSolver.js';
  import { saveEngineeringContextSnapshot } from '../../scripts/rfqSessionStore.js';
  import { projectProcessControlMetrologyInvariants } from '../../scripts/catalogDropInAndJrpProjector.js';
  import {
    bindAtomicPartTrayButtons,
    loadUnifiedEngineeringAndWorkbenchState,
  } from '../../scripts/verticalStateAndCtaSyncBridge.js';

  function renderSieveStackRowsSafe(tbody: HTMLElement, rows: any[]) {
    const trNodes = rows.map((s) => {
      const tr = document.createElement('tr');
      const isPrimary = Boolean(s.isPrimaryP80Control || s.isPrimaryCut);
      tr.setAttribute('data-primary-p80', isPrimary ? 'true' : 'false');
      tr.className = isPrimary ? 'sieve-row sieve-row--primary' : 'sieve-row';

      const cells = [
        `${s.mesh}${isPrimary ? ' *' : ''}`,
        `${s.apertureMicrons}`,
        `${s.retainedIndividualPct}%`,
        `${s.cumulativeRetainedPct}%`,
        `${s.cumulativePassingPct}%`,
        `${s.rosinRammlerY ?? '—'}`,
        `${s.estimatedMassRetainedGrams} g (${isPrimary ? 'P80' : 'Stack'})`,
      ];
      cells.forEach((txt) => {
        const td = document.createElement('td');
        td.textContent = txt;
        tr.appendChild(td);
      });
      return tr;
    });
    tbody.replaceChildren(...trNodes);
  }

  function updateMetrologyViaDag(root: HTMLElement, lang: 'es' | 'en', isUserEvent = false) {
    const isEn = lang === 'en';
    const canonical = readAllCanonicalInputs(root);
    const dag = solveXdsmMultidisciplinaryDag({
      ...canonical,
      circuit: 'control_procesos'
    });
    const marcy = dag.marcyEval || {};
    const gy = dag.gyEval || {};
    const sieveStack = dag.sieveEval || {};

    projectDomainOutputs(root, 'metrology', {
      marcyDensityKgL: marcy.pulpDensityKgL,
      cwPct: marcy.solidsWeightPercent,
      wrongRingBiasPoints: marcy.wrongRingBiasPoints,
      minimumSampleMassKg: gy.minDrySampleKg,
      topSizeD95Mm: gy.topSizeD95Mm,
      theoreticalGyGrams: gy.theoreticalGyGrams,
      minDrySampleGrams: gy.minDrySampleGrams,
      slurrySampleLiters: gy.slurrySampleLiters ?? gy.requiredPulpLiters,
      estimatedCycleMinutes: gy.estimatedCycleMinutes,
      residualCakeMoisturePct: gy.residualCakeMoisturePct,
      sieveNumber: sieveStack.primaryControlMesh,
      drySampleMassGrams: sieveStack.drySampleMassGrams,
      screeningMode: sieveStack.screeningMode,
      frameDiameterInches: sieveStack.frameDiameterInches,
      sieveTopSizeD95Mm: sieveStack.topSizeD95Mm,
      primaryApertureMicrons: sieveStack.primaryApertureMicrons,
      sieveStackSummary: sieveStack.sieveStackSummary,
      hoistRequired: Number(gy.minDrySampleKg) >= 23,
      twoPersonAssistRequired: Number(gy.minDrySampleKg) >= 15 && Number(gy.minDrySampleKg) < 23,
      rosinRammlerUniformityN: sieveStack.rosinRammlerSlopeN,
      rosinRammlerY: sieveStack.rosinRammlerY,
      recommendedContainerEs: isEn ? marcy.recommendedContainerEn : marcy.recommendedContainerEs
    }, lang);

    const liveBanner = root.querySelector('#wb-ctrl-live-metrics');
    if (liveBanner) {
      liveBanner.textContent = isEn
        ? `Marcy Ss=${marcy.solidsSpecificGravity} · Cw=${marcy.solidsWeightPercent}% · ρp=${marcy.pulpDensityKgL} kg/L | Pierre Gy Ms=${gy.minDrySampleKg} kg (${gy.batchFilterCycles} cycle(s) @ ${gy.recommendedAirPressurePsi}) | Control Mesh ${sieveStack.primaryControlMesh} (n=${sieveStack.rosinRammlerSlopeN}, y'=${sieveStack.rosinRammlerY})`
        : `Marcy Ss=${marcy.solidsSpecificGravity} · Cw=${marcy.solidsWeightPercent}% · ρp=${marcy.pulpDensityKgL} kg/L | Pierre Gy Ms=${gy.minDrySampleKg} kg (${gy.batchFilterCycles} ciclo(s) @ ${gy.recommendedAirPressurePsi}) | Tamiz Control ${sieveStack.primaryControlMesh} (n=${sieveStack.rosinRammlerSlopeN}, y'=${sieveStack.rosinRammlerY})`;
    }
    const pulpEl = root.querySelector('#wb-ctrl-gy-pulp-liters');
    if (pulpEl) pulpEl.textContent = `${gy.wetPulpVolumeLiters ?? gy.requiredPulpLiters ?? 0.39} L`;
    const frameEl = root.querySelector('#wb-ctrl-sieve-frame-rec');
    if (frameEl) frameEl.textContent = isEn ? (sieveStack.recommendedFrameMaterialEn || '') : (sieveStack.recommendedFrameMaterialEs || '');

    const ringStrip = root.querySelector('#wb-ctrl-marcy-rings-strip');
    if (ringStrip) {
      const ringsSummary = MARCY_STANDARD_RINGS.map((r: any, idx: number) => {
        const sgVal = Number(typeof r === 'object' && r !== null ? (r.oreSg ?? r.sg) : r);
        const mark = Math.abs(sgVal - Number(marcy.recommendedRingSg)) < 0.06 ? '*' : '';
        return `${mark}R${idx + 1}:${sgVal.toFixed(1)}`;
      }).join(' · ');
      ringStrip.textContent = isEn ? `12 Marcy Dials (SG 2.2–4.4): ${ringsSummary}` : `12 Carátulas Marcy (SG 2.2–4.4): ${ringsSummary}`;
    }

    const sieveTbody = root.querySelector('#wb-ctrl-sieve-tbody') as HTMLElement | null;
    if (sieveTbody && Array.isArray(sieveStack.sieveStack)) {
      renderSieveStackRowsSafe(sieveTbody, sieveStack.sieveStack);
    }

    const metrologiaStr = `Marcy SG=${Number(marcy.recommendedRingSg || 2.8).toFixed(1)} (${marcy.solidsWeightPercent}% Cw, ρp=${Number(marcy.pulpDensityKgL || 1.4).toFixed(3)} kg/L) | Gy=${gy.minDrySampleKg} kg | ASTM P80=${canonical.targetP80Microns} µm (${sieveStack.primaryControlMesh}, n=${sieveStack.rosinRammlerSlopeN})`;
    projectProcessControlMetrologyInvariants(document, lang, { marcy, gy, sieveStack });

    const quotePrefix = isEn ? '/en/quote/' : '/cotizar/';
    const quoteCta = root.querySelector('#met-quote-cta') as HTMLAnchorElement | null;
    const pumpPrecalCta = root.querySelector('#met-pump-precal-cta') as HTMLAnchorElement | null;
    if (quoteCta) {
      quoteCta.href = `${quotePrefix}?circuito=control_procesos&equipo=balanza_marcy&sg=${marcy.solidsSpecificGravity}&cw=${marcy.solidsWeightPercent}&rhop=${marcy.pulpDensityKgL}&p80=${canonical.targetP80Microns}&d95=${canonical.topSizeMm}&gy_kg=${gy.minDrySampleKg}&metrologia=${encodeURIComponent(metrologiaStr)}#rfq`;
    }
    if (pumpPrecalCta) {
      pumpPrecalCta.href = `${quotePrefix}?circuito=bombeo&flow=220&solids=${marcy.solidsWeightPercent}&d80=${canonical.targetP80Microns}&sg=${marcy.solidsSpecificGravity}&rhop=${marcy.pulpDensityKgL}&metrologia=${encodeURIComponent(metrologiaStr)}#rfq`;
    }

    if (!isUserEvent) return;
    const prev = loadWorkbenchState() || {};
    saveWorkbenchState({
      ...prev,
      rhop: marcy.pulpDensityKgL,
      metrologia: metrologiaStr,
      metrology: {
        specificGravity: marcy.solidsSpecificGravity,
        solidsPctCw: marcy.solidsWeightPercent,
        pulpDensityKgL: marcy.pulpDensityKgL,
        targetP80Microns: canonical.targetP80Microns,
        primaryControlMesh: sieveStack.primaryControlMesh,
        drySampleMassGrams: sieveStack.drySampleMassGrams,
      },
    });
    saveEngineeringContextSnapshot('control_procesos', {
      specificGravity: marcy.solidsSpecificGravity,
      solidsPctCw: marcy.solidsWeightPercent,
      pulpDensityKgL: marcy.pulpDensityKgL,
      recommendedRingSg: marcy.recommendedRingSg,
      wetPulpVolumeLiters: gy.wetPulpVolumeLiters ?? gy.requiredPulpLiters,
      wetScreeningRequired: sieveStack.wetScreeningRequired,
      minDrySampleKg: gy.minDrySampleKg,
      targetP80Microns: canonical.targetP80Microns,
      rosinRammlerSlopeN: sieveStack.rosinRammlerSlopeN,
      rosinRammlerY: sieveStack.rosinRammlerY,
    });
  }

  function initProcessControlIsland() {
    const standaloneRoot = document.querySelector('[data-island-standalone="metrology"]') as HTMLElement | null;
    if (!standaloneRoot) return;
    const lang: 'es' | 'en' = document.documentElement.lang === 'en' ? 'en' : 'es';
    const isEn = lang === 'en';
    const calcRoot = standaloneRoot.querySelector('#metrology-calculator') as HTMLElement | null;
    if (!calcRoot) return;

    const stationTabs = Array.from(standaloneRoot.querySelectorAll('[data-met-station-tab]'));
    const instrumentCards = Array.from(standaloneRoot.querySelectorAll('[data-instrument-card]'));

    const activateStation = (stationId: string) => {
      stationTabs.forEach((tab) => {
        const isMatch = tab.getAttribute('data-met-station-tab') === stationId;
        tab.classList.toggle('is-active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });
      instrumentCards.forEach((card) => {
        const isMatch = card.getAttribute('data-instrument-card') === stationId;
        card.classList.toggle('ctrl-hidden-tab', !isMatch);
      });
    };

    if (calcRoot.dataset.smatCtrlInit !== '1') {
      calcRoot.dataset.smatCtrlInit = '1';
      const unified = loadUnifiedEngineeringAndWorkbenchState();
      if (unified?.hasPersistedState && unified.persistedFields) {
        const sgInput = standaloneRoot.querySelector('#wb-ctrl-sg') as HTMLInputElement | null;
        const cwInput = standaloneRoot.querySelector('#wb-ctrl-cw') as HTMLInputElement | null;
        const p80Input = standaloneRoot.querySelector('#wb-ctrl-p80') as HTMLInputElement | null;
        const fSg = Number(unified.persistedFields.sg);
        if (sgInput && Number.isFinite(fSg) && fSg >= 2.2 && fSg <= 4.5) sgInput.value = String(fSg);
        const fCw = Number(unified.persistedFields.cw);
        if (cwInput && Number.isFinite(fCw) && fCw >= 10 && fCw <= 75) cwInput.value = String(fCw);
        const fP80 = Number(unified.persistedFields.d80Um);
        if (p80Input && Number.isFinite(fP80) && fP80 >= 25 && fP80 <= 2000) p80Input.value = String(fP80);
      }

      bindAtomicPartTrayButtons(standaloneRoot);
      stationTabs.forEach((tab) => {
        tab.addEventListener('click', () => activateStation(tab.getAttribute('data-met-station-tab') || '1'));
      });
      bindDomainSchemaRoot(standaloneRoot, ['metrology'], () => updateMetrologyViaDag(standaloneRoot, lang, true));

      const applyBtn = standaloneRoot.querySelector('#btn-apply-ss-to-circuit');
      applyBtn?.addEventListener('click', () => {
        updateMetrologyViaDag(standaloneRoot, lang, true);
        const inputs = readAllCanonicalInputs(standaloneRoot);
        const prev = loadWorkbenchState() || {};
        saveWorkbenchState({
          ...prev,
          sg: inputs.solidsSpecificGravity,
          cw: inputs.solidsWeightPercent,
          solidsSg: inputs.solidsSpecificGravity,
          solidsPct: inputs.solidsWeightPercent
        });
        applyBtn.textContent = isEn
          ? `Ss = ${Number(inputs.solidsSpecificGravity).toFixed(2)} & Cw = ${Number(inputs.solidsWeightPercent).toFixed(0)}% synced`
          : `Ss = ${Number(inputs.solidsSpecificGravity).toFixed(2)} y Cw = ${Number(inputs.solidsWeightPercent).toFixed(0)}% sincronizados`;
      });
    }

    updateMetrologyViaDag(standaloneRoot, lang, false);
  }

  initProcessControlIsland();
  document.addEventListener('astro:page-load', initProcessControlIsland);
</script>

