---
/**
 * ProcessControlIsland.astro
 * ---------------------------------------------------------------------------
 * Isla Canónica Bilingüe Única de Control de Procesos (Balanza Marcy 3-Vías,
 * Masa Mínima de Muestra Pierre Gy / Filtro Lab y Serie √2 ASTM E11 / Rosin-Rammler).
 * Soporta `mode: 'standalone' | 'embedded'` y expone `sieveNumber` + `drySampleMassGrams`.
 */
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import CircuitNavigator from '../CircuitNavigator.astro';
import SharePurchasing from '../SharePurchasing.astro';
import rolesData from '../../../data/roles.json';

interface Props {
  locale?: 'es' | 'en';
  mode?: 'standalone' | 'embedded';
}

const { locale = 'es', mode = 'standalone' } = Astro.props;
const isEs = locale === 'es';
const lang = locale;
const isEmbedded = mode === 'embedded';

const ctrlVertical = rolesData.verticals.find((v) => v.id === 'control_procesos');
const marcyRole = ctrlVertical?.capex?.find((r) => r.role_id === 'balanza_marcy');
const batchRole = ctrlVertical?.capex?.find((r) => r.role_id === 'filtro_batch_lab');
const tamizRole = ctrlVertical?.opex?.find((r) => r.role_id === 'tamices_laboratorio');

const quoteBase = isEs ? '/cotizar/' : '/en/quote/';
const classifHref = isEs ? '/clasificacion/#marcy-3cup-cyclone-calculator' : '/en/classification/#marcy-3cup-cyclone-calculator';
const marcySkuHref = isEs ? '/productos/balanza-marcy/' : '/en/products/marcy-pulp-density-scale/';
---

{isEmbedded ? (
  <div id="circuit-panel-control" class="circuit-panel hidden embedded-ctrl-panel">
    <div class="form-group smat-mb-md">
      <label class="smat-field-label" for="wb-role-ctrl">
        {isEs ? 'Instrumento o Paquete de Control Requerido:' : 'Required Process Control Instrument or Package:'}
      </label>
      <select id="wb-role-ctrl" name="role_id_ctrl" class="smat-input-control wb-select">
        <option value="balanza_marcy" selected>{isEs ? 'Balanza de Densidad de Pulpa (Tipo Marcy) — Vaso 1000 cm³ + 12 Anillos' : 'Pulp Density & % Solids Scale (Marcy Type) — 1000 cm³ Cup + 12 Rings'}</option>
        <option value="filtro_batch_lab">{isEs ? 'Filtro de Presión Batch de Laboratorio (60–100 psi)' : 'Laboratory Batch Pressure Filter (60–100 psi)'}</option>
        <option value="tamices_laboratorio">{isEs ? 'Tamices Certificados ASTM E11 / ISO 3310 y Tamizadores' : 'Certified ASTM E11 / ISO 3310 Test Sieves & Shakers'}</option>
      </select>
    </div>

    <div class="form-group smat-mb-md">
      <label class="smat-field-label" for="wb-ctrl-spec">
        {isEs ? 'Rango de Gravedad Específica (Ss) o Serie de Mallas:' : 'Ore Specific Gravity (Ss) Range or Sieve Series:'}
      </label>
      <select id="wb-ctrl-spec" name="ctrl_spec" class="smat-input-control wb-select">
        <option value="marcy_12_rings" selected>{isEs ? 'Juego Completo 12 Carátulas (Ss 2.2–4.4) + Vaso Inox 304' : 'Full 12-Ring Dial Set (Ss 2.2–4.4) + 304 Stainless Cup'}</option>
        <option value="batch_100psi">{isEs ? 'Cámara de Presión Batch (60–100 psi) + Columnas Guía' : 'Heavy-Duty Steel Batch Pressure Barrel (60–100 psi)'}</option>
        <option value="astm_8in_inox">{isEs ? 'Columna Tamices 8" Inox (P80 #40–#400/#635) + Tapa' : '8" Stainless Steel Sieve Stack (#40–#400/#635) + Cover'}</option>
        <option value="astm_12in_bronce">{isEs ? 'Columna Tamices 12" Bronce/Inox + Tamizador Mecánico' : '12" Brass/Inox Sieve Stack + Mechanical Shaker'}</option>
      </select>
    </div>

    <div class="smat-flex-between smat-mb-md">
      <div class="ctrl-mode-group">
        <label class="smat-field-label" for="wb-ctrl-solve-mode">
          {isEs ? 'Inversión Algebraica Balanza Marcy (3 Vías):' : '3-Way Marcy Algebraic Inversion:'}
        </label>
        <select id="wb-ctrl-solve-mode" data-testid="wb-ctrl-solve-mode" class="smat-input-control wb-select font-mono-tech">
          <option value="cw" selected>{isEs ? 'Modo 1: Ss y %Cw → Calcular ρp (kg/L)' : 'Mode 1: Ss & %Cw → Solve ρp (kg/L)'}</option>
          <option value="rhop">{isEs ? 'Modo 2: Ss y ρp → Calcular %Cw' : 'Mode 2: Ss & ρp → Solve %Cw'}</option>
          <option value="ore_density_rhop">{isEs ? 'Modo 3: ρp y %Cw → Despejar Ss Real' : 'Mode 3: ρp & %Cw → Solve True Ss'}</option>
        </select>
      </div>
      <button type="button" id="btn-apply-ss-to-circuit" data-testid="btn-apply-ss-to-circuit" class="smat-btn-secondary">
        {isEs ? 'Aplicar Ss al Circuito →' : 'Apply Ss to Circuit →'}
      </button>
    </div>

    <div class="smat-inputs-2col smat-panel-soft">
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-sg">{isEs ? 'SG Mineral (Ss):' : 'Ore SG (Ss):'}</label><input type="number" id="wb-ctrl-sg" min="2.2" max="4.4" step="0.1" value="2.8" class="smat-input-control wb-input font-mono-tech" /></div>
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-cw">{isEs ? '% Sólidos (Cw):' : 'Solids (% Cw):'}</label><input type="number" id="wb-ctrl-cw" min="10" max="75" step="1" value="45" class="smat-input-control wb-input font-mono-tech" /></div>
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-rhop">{isEs ? 'Densidad ρp (kg/L):' : 'Pulp ρp (kg/L):'}</label><input type="number" id="wb-ctrl-rhop" min="1.05" max="2.40" step="0.005" value="1.406" class="smat-input-control wb-input font-mono-tech" /></div>
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-d95">{isEs ? 'Top d95 Gy (mm):' : 'Gy d95 (mm):'}</label><input type="number" id="wb-ctrl-d95" min="0.04" max="25.0" step="0.01" value="6.5" class="smat-input-control wb-input font-mono-tech" /></div>
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-lib">{isEs ? 'Liberación dl (µm):' : 'Lib. dl (µm):'}</label><input type="number" id="wb-ctrl-lib" min="10" max="1000" step="5" value="100" class="smat-input-control wb-input font-mono-tech" /></div>
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-grade">{isEs ? 'Ley Mineral (aL):' : 'Ore Grade (aL):'}</label><input type="number" id="wb-ctrl-grade" min="0.001" max="0.95" step="0.005" value="0.05" class="smat-input-control wb-input font-mono-tech" /></div>
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-air-psi">{isEs ? 'Presión Batch (psi):' : 'Batch Air (psi):'}</label><select id="wb-ctrl-air-psi" class="smat-input-control wb-select font-mono-tech"><option value="60">60 psi</option><option value="80">80 psi</option><option value="90" selected>90 psi</option><option value="100">100 psi</option></select></div>
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-gy-c">{isEs ? 'Constante Gy c:' : 'Gy Constant c:'}</label><input type="number" id="wb-ctrl-gy-c" min="0.05" max="50" step="0.05" value="1.35" class="smat-input-control wb-input font-mono-tech" /></div>
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-gy-err">{isEs ? 'Error Rel. Gy (s):' : 'Gy Rel. Err (s):'}</label><select id="wb-ctrl-gy-err" class="smat-input-control wb-select font-mono-tech"><option value="0.01">1% (0.01)</option><option value="0.05" selected>5% (0.05)</option><option value="0.10">10% (0.10)</option></select></div>
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-p80">{isEs ? 'Corte P80 (µm):' : 'Target P80 (µm):'}</label><input type="number" id="wb-ctrl-p80" min="25" max="2000" step="5" value="150" class="smat-input-control wb-input font-mono-tech" /></div>
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-rr-n">{isEs ? 'Pendiente RR (n):' : 'RR Slope (n):'}</label><input type="number" id="wb-ctrl-rr-n" min="0.50" max="2.50" step="0.05" value="1.15" class="smat-input-control wb-input font-mono-tech" /></div>
      <div class="form-group"><label class="smat-field-label" for="wb-ctrl-ret-p80">{isEs ? '% Ret. en P80:' : '% Ret. at P80:'}</label><input type="number" id="wb-ctrl-ret-p80" min="5" max="40" step="1" value="20" class="smat-input-control wb-input font-mono-tech" /></div>
    </div>

    <details class="smat-mt-sm smat-panel-soft">
      <summary class="smat-field-label">
        {isEs
          ? 'Parámetros Estequiométricos y Metrología Avanzada (Anillo Marcy, Gy β/m y Masa Retenida)'
          : 'Advanced Stoichiometry & Metrology Inputs (Marcy Ring, Gy β/m & Retained Mass)'}
      </summary>
      <div class="smat-inputs-2col smat-mt-sm">
        <div class="form-group"><label class="smat-field-label" for="wb-ctrl-ring">{isEs ? 'Anillo Marcy (Ss):' : 'Marcy Ring (Ss):'}</label><select id="wb-ctrl-ring" class="smat-input-control wb-select font-mono-tech"><option value="2.5">2.5</option><option value="2.6">2.6</option><option value="2.7" selected>2.7</option><option value="2.8">2.8</option><option value="3.0">3.0</option><option value="3.2">3.2</option></select></div>
        <div class="form-group"><label class="smat-field-label" for="wb-ctrl-marcy-mode">{isEs ? 'Modo Ecuación Marcy:' : 'Marcy Equation Mode:'}</label><select id="wb-ctrl-marcy-mode" class="smat-input-control wb-select font-mono-tech"><option value="cw_pct" selected>%Cw</option><option value="slurry_sg">SG_m</option><option value="solids_sg">Ss</option></select></div>
        <div class="form-group"><label class="smat-field-label" for="wb-ctrl-density">{isEs ? 'Densidad Medida (SG_m):' : 'Measured SG (SG_m):'}</label><input type="number" id="wb-ctrl-density" min="1.0" max="4.5" step="0.01" value="1.45" class="smat-input-control wb-input font-mono-tech" /></div>
        <div class="form-group"><label class="smat-field-label" for="wb-ctrl-ss">{isEs ? 'Gravedad Sólidos (Ss):' : 'Solids SG (Ss):'}</label><input type="number" id="wb-ctrl-ss" min="1.8" max="5.5" step="0.1" value="2.7" class="smat-input-control wb-input font-mono-tech" /></div>
        <div class="form-group"><label class="smat-field-label" for="wb-ctrl-topsize">{isEs ? 'Tamaño Máximo d95 (mm):' : 'Top Size d95 (mm):'}</label><input type="number" id="wb-ctrl-topsize" min="0.05" max="150" step="0.1" value="12.7" class="smat-input-control wb-input font-mono-tech" /></div>
        <div class="form-group"><label class="smat-field-label" for="wb-ctrl-gy-beta">{isEs ? 'Factor Liberación Gy (β):' : 'Gy Liberation Factor (β):'}</label><input type="number" id="wb-ctrl-gy-beta" min="0.1" max="2.0" step="0.05" value="0.5" class="smat-input-control wb-input font-mono-tech" /></div>
        <div class="form-group"><label class="smat-field-label" for="wb-ctrl-gy-m">{isEs ? 'Factor Mineralógico Gy (m):' : 'Gy Mineralogical Factor (m):'}</label><input type="number" id="wb-ctrl-gy-m" min="0.5" max="50.0" step="0.5" value="20.0" class="smat-input-control wb-input font-mono-tech" /></div>
        <div class="form-group"><label class="smat-field-label" for="wb-ctrl-mass-retained">{isEs ? 'Masa Retenida Tamiz (g):' : 'Retained Sieve Mass (g):'}</label><input type="number" id="wb-ctrl-mass-retained" min="1" max="5000" step="5" value="180" class="smat-input-control wb-input font-mono-tech" /></div>
      </div>
    </details>

    <div id="wb-ctrl-live-metrics" class="embedded-ctrl-metrics font-mono-tech smat-mt-sm"></div>

    <div class="embedded-ctrl-res font-mono-tech smat-mt-sm">
      <div class="embedded-res-cell"><strong>{isEs ? 'Pulpa / Anillo:' : 'Pulp / Ring:'}</strong> <span id="wb-ctrl-res-sm">1.406 kg/L (Ss 2.8)</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? '% Sólidos Calc.:' : 'Calc % Solids:'}</strong> <span id="wb-ctrl-res-cw">45.0%</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Sesgo Anillo:' : 'Ring Bias:'}</strong> <span id="wb-ctrl-res-bias">±0.0 pts %Cw</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Muestra Gy / Batch:' : 'Gy / Batch:'}</strong> <span id="wb-ctrl-res-gy">0.25 kg (1 ciclo Batch)</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Malla Control RR:' : 'RR Control Mesh:'}</strong> <span id="wb-ctrl-res-rr">#100 • n = 1.15</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Número de Tamiz:' : 'Sieve Number:'}</strong> <span id="wb-ctrl-res-sieve">#100</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Masa Seca ASTM:' : 'ASTM Dry Mass:'}</strong> <span id="wb-ctrl-res-drysample">250 g</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Polipasto:' : 'Hoist Lift:'}</strong> <span id="wb-ctrl-res-hoist">{isEs ? 'No requerido' : 'Not required'}</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Manejo 2 Personas:' : '2-Person Assist:'}</strong> <span id="wb-ctrl-res-two-person">{isEs ? 'Estándar' : 'Standard'}</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Volumen Pulpa Gy:' : 'Gy Wet Pulp Vol:'}</strong> <span id="wb-ctrl-gy-pulp-liters" data-testid="wb-ctrl-gy-pulp-liters">{isEs ? 'Volumen Pulpa Húmeda: 0.39 L' : 'Wet Pulp Volume: 0.39 L'}</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Bastidor ASTM E11:' : 'ASTM E11 Frame:'}</strong> <span id="wb-ctrl-sieve-frame-rec" data-testid="wb-ctrl-sieve-frame-rec">{isEs ? 'Acero Inox 304/316' : '304/316 Stainless Steel'}</span></div>
    </div>

    <div id="wb-ctrl-marcy-rings-strip" data-testid="wb-ctrl-marcy-rings-strip" class="rings-strip font-mono-tech smat-mt-sm">
      {isEs ? '12 Anillos Marcy (Ss 2.2–4.4): Anillo #4 [Ss 2.8] activo' : '12 Marcy Rings (Ss 2.2–4.4): Ring #4 [Ss 2.8] active'}
    </div>

    <div class="sieve-table-shell smat-mt-sm">
      <span class="sieve-table-kicker">
        {isEs ? 'SERIE DE TAMICES ASTM E11 / ROSIN-RAMMLER EN VIVO (7 MALLAS)' : 'LIVE ASTM E11 / ROSIN-RAMMLER SIEVE STACK (7 MESHES)'}
      </span>
      <table id="wb-ctrl-sieve-table" class="embedded-sieve-table">
        <thead>
          <tr>
            <th>{isEs ? 'Malla (Tyler)' : 'Mesh (Tyler)'}</th>
            <th>µm</th>
            <th>{isEs ? '% Ret. Indiv.' : '% Indiv. Ret.'}</th>
            <th>{isEs ? '% Ret. Acum.' : '% Cum. Ret.'}</th>
            <th>{isEs ? '% Pasante' : '% Passing'}</th>
            <th>{isEs ? 'Masa (g) / Rol' : 'Mass (g) / Role'}</th>
          </tr>
        </thead>
        <tbody id="wb-ctrl-sieve-tbody"></tbody>
      </table>
    </div>
  </div>
) : (
  <div class="ctrl-standalone-wrap" data-island-standalone="metrology">
    <section class="page-hero smat-compact-hero">
      <div class="container">
        <span class="badge badge-copper">
          {isEs ? 'PUERTA 3 • CONTROL METALÚRGICO Y LABORATORIO' : 'DOOR 3 • METALLURGICAL CONTROL & LABORATORY'}
        </span>
        <h1>{isEs ? 'Control de Procesos' : 'Process Control'}</h1>
        <p class="smat-hero-sub">
          {isEs
            ? 'Instrumentación de medición directa para control de molienda, clasificación, flotación y desaguado: Balanzas Marcy, Filtro de Presión Batch Lab (60–100 psi) y Tamices Certificados ASTM E11 / ISO 3310.'
            : 'Direct-reading metallurgical instrumentation for grinding, classification, flotation & dewatering: Marcy Pulp Density Scales, SMAT Batch Pressure Filters (60–100 psi) & ASTM E11 Test Sieves.'}
        </p>
        <div class="met-hero-actions smat-cta-row">
          <a href={`${quoteBase}?circuito=control_procesos#rfq`} class="btn btn-primary" data-ctrl-quote-link>
            {isEs ? 'Cotizar Instrumentación de Control →' : 'Quote Process Control Equipment →'}
          </a>
          <a href="#metrology-calculator" class="btn btn-outline">
            {isEs ? 'Calculadora Marcy, Gy y Serie √2 ASTM ↓' : 'Marcy, Gy & ASTM √2 Calculator ↓'}
          </a>
        </div>
      </div>
    </section>

    <section class="section smat-stage-compact" id="stage-diagnostic">
      <div class="container">
        <div id="metrology-calculator" class="card metrology-calc-card smat-mb-md" data-stratum-1-instrument>
          <div class="metrology-calc-header">
            <span class="badge badge-copper">
              {isEs ? 'HERRAMIENTA DE CONTROL METALÚRGICO EN PLANTA' : 'PLANT METALLURGICAL CONTROL INSTRUMENT'}
            </span>
            <h2>
              {isEs
                ? 'Simulador de Carátula Marcy, Filtro Prensa Lab (Pierre Gy) y Serie √2 ASTM E11'
                : 'Marcy Dial Simulator, Lab Filter Press (Pierre Gy) & ASTM E11 √2 Sieve Stack'}
            </h2>
            <p class="met-calc-sub">
              {isEs
                ? 'Calibre densidad de pulpa (Ss, Cw), masa mínima de muestreo y ciclos batch (Pierre Gy) o la serie de 7 tamices ASTM E11 (P80, Rosin-Rammler y\').'
                : 'Calibrate pulp density (Ss, Cw), minimum sampling mass and batch cycles (Pierre Gy), or the 7-sieve ASTM E11 stack (P80, Rosin-Rammler y\').'}
            </p>
          </div>

          <div class="metrology-stations-stack">
            <details class="metrology-station-accordion" data-station-accordion="1" open>
              <summary class="metrology-station-summary">
                <span>
                  <strong>{isEs ? '1. Balanza Marcy:' : '1. Marcy Scale:'}</strong>{' '}
                  {isEs ? 'Gravedad Específica del Mineral Seco (Ss) y % Sólidos (Cw)' : 'Dry Ore Specific Gravity (Ss) & Solids % (Cw)'}
                </span>
                <span class="metrology-station-tag">{isEs ? 'ESTACIÓN 01 • ACTIVA' : 'STATION 01 • ACTIVE'}</span>
              </summary>
              <div class="metrology-inputs-grid">
                <label class="metrology-field">
                  <span>{isEs ? 'Modo de Inversión de 3 Vías (Marcy):' : '3-Way Marcy Inversion Mode:'}</span>
                  <select id="met-marcy-mode">
                    <option value="cw" selected>{isEs ? '1. Dadas Ss + %Cw → Calcular ρp (kg/L)' : '1. Given Ss + %Cw → Solve ρp (kg/L)'}</option>
                    <option value="rhop">{isEs ? '2. Dadas Ss + ρp → Calcular %Cw' : '2. Given Ss + ρp → Solve %Cw'}</option>
                    <option value="ore_density_rhop">{isEs ? '3. Dadas ρp + %Cw → Inferir Ss Real' : '3. Given ρp + %Cw → Solve True Ss'}</option>
                  </select>
                </label>
                <label class="metrology-field">
                  <span>{isEs ? 'Gravedad Específica Mineral Seco (Ss):' : 'Dry Ore Specific Gravity (Ss):'}</span>
                  <input type="number" id="met-sg-input" min="2.2" max="4.4" step="0.05" value="2.8" />
                </label>
                <label class="metrology-field">
                  <span>{isEs ? 'Porcentaje Sólidos Peso (Cw %):' : 'Solids by Weight (Cw %):'}</span>
                  <input type="number" id="met-cw-input" min="5" max="80" step="1" value="50" />
                </label>
                <label class="metrology-field">
                  <span>{isEs ? 'Densidad Pulpa (ρp kg/L):' : 'Pulp Density (ρp kg/L):'}</span>
                  <input type="number" id="met-rhop-input" min="1.05" max="2.60" step="0.005" value="1.474" />
                </label>
              </div>
              <div class="metrology-result-box">
                <span class="met-res-label">
                  {isEs ? 'Lectura Vaso Marcy (1000 cm³) y Auditoría de Anillo' : 'Marcy Cup Reading (1000 cm³) & Ring Bias Audit'}
                </span>
                <strong id="met-res-marcy-main" class="met-res-value">1474 g netos • ρp = 1.474 kg/L</strong>
                <small id="met-res-marcy-sub">{isEs ? 'Anillo recomendado: SG 2.8 (Rango 2.2 a 4.4)' : 'Recommended dial ring: SG 2.8 (Range 2.2–4.4)'}</small>
                <small id="met-res-marcy-bias" class="met-bias-line">
                  {isEs
                    ? 'Sólidos secos en vaso: 737 g • Cw aparente: 50.0% (Sesgo ΔC_bias = 0.0 pts) • Vaso Acero Inox 304 (1000 cm³)'
                    : 'Dry solids in cup: 737 g • Apparent Cw: 50.0% (Bias ΔC_bias = 0.0 pts) • 304 Stainless Cup (1000 cm³)'}
                </small>
                <div class="smat-chip-row smat-mt-sm">
                  <span class="smat-badge-solar" data-met-defuse-water-ml>{isEs ? 'Agua: 526 mL' : 'Water: 526 mL'}</span>
                  <span class="smat-badge-solar" data-met-defuse-cv-pct>Cv: 26.3%</span>
                  <span class="smat-badge-solar" data-met-defuse-cup-mass>{isEs ? 'Vaso: 1474 g' : 'Cup: 1474 g'}</span>
                  <span class="smat-badge-solar" data-met-defuse-dry-solids>{isEs ? 'Sólidos secos: 737 g' : 'Dry solids: 737 g'}</span>
                </div>
                <div data-marcy-rings-list class="smat-chip-row smat-mt-sm"></div>
                <div class="smat-cta-row">
                  <button type="button" id="met-apply-ss-btn" class="btn btn-outline">
                    {isEs ? 'Sincronizar Ss y Cw Calibrados al Circuito →' : 'Sync Calibrated Ss & Cw to Circuit →'}
                  </button>
                  <button type="button" class="btn btn-outline" data-add-tray-sku="SMAT-LAB-MARCY-1000" data-tray-circuit="control_procesos">
                    {isEs ? '+ Bandeja (Kit Marcy)' : '+ Tray (Marcy Kit)'}
                  </button>
                </div>
              </div>
            </details>

            <details class="metrology-station-accordion" data-station-accordion="2">
              <summary class="metrology-station-summary">
                <span>
                  <strong>{isEs ? '2. Filtro Prensa Lab + Pierre Gy:' : '2. Lab Batch Filter + Pierre Gy:'}</strong>{' '}
                  {isEs ? 'Masa Mínima de Muestra (Ms) y Ciclos Batch (60–100 psi)' : 'Minimum Sample Mass (Ms) & Batch Cycles (60–100 psi)'}
                </span>
                <span class="metrology-station-tag">{isEs ? 'ESTACIÓN 02 ▾' : 'STATION 02 ▾'}</span>
              </summary>
              <div class="metrology-inputs-grid">
                <label class="metrology-field">
