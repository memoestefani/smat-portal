<script>
  import {
    calculateMarcyScaleReading,
    calculateGyMinimumSampleMass,
    recommendAstmSieveSeries,
    MARCY_STANDARD_RINGS,
    ASTM_E11_SIEVE_TABLE,
  } from '../../scripts/slurryEngine.js';
  import { saveWorkbenchState, loadWorkbenchState } from '../../scripts/workbenchBus.js';
  import { saveEngineeringContextSnapshot } from '../../scripts/wizardCircuitPhysicsController.js';
  import { projectProcessControlMetrologyInvariants } from '../../scripts/catalogDropInAndJrpProjector.js';
  import {
    bindAtomicPartTrayButtons,
    loadUnifiedEngineeringAndWorkbenchState,
  } from '../../scripts/verticalStateAndCtaSyncBridge.js';

  function renderSieveStackRowsSafe(tbody: HTMLElement, rows: any[]) {
    const trNodes = rows.map((s) => {
      const tr = document.createElement('tr');
      const isPrimary = Boolean(s.isPrimaryP80Control || s.isPrimaryCut);
      tr.setAttribute('data-primary-p80', isPrimary ? 'true' : 'false');
      tr.className = isPrimary ? 'sieve-row sieve-row--primary' : 'sieve-row';

      const cells = [
        `${s.mesh || s.sieveNumber || ''} (${s.tylerEquivalent || ''})${isPrimary ? ' • P80' : ''}`,
        `${s.apertureMicrons} µm`,
        `${Number(s.retainedIndividualPct || 0).toFixed(1)}%`,
        `${Number(s.cumulativeRetainedPct ?? (100 - Number(s.cumulativePassingPct || 0))).toFixed(1)}%`,
        `${Number(s.cumulativePassingPct || 0).toFixed(1)}%`,
        `${Number(s.estimatedMassRetainedGrams ?? 0).toFixed(1)} g${s.roleEs ? ` • ${s.roleEs}` : ''}`,
      ];
      cells.forEach((txt) => {
        const td = document.createElement('td');
        td.textContent = txt;
        tr.appendChild(td);
      });
      return tr;
    });
    tbody.replaceChildren(...trNodes);
  }

  function updateMetrologyCalculator(root: HTMLElement, lang: 'es' | 'en', evt?: Event) {
    const isEn = lang === 'en';
    const sgEl = root.querySelector('#met-sg-input') as HTMLInputElement | null;
    const cwEl = root.querySelector('#met-cw-input') as HTMLInputElement | null;
    const rhopEl = root.querySelector('#met-rhop-input') as HTMLInputElement | null;
    const marcyModeEl = root.querySelector('#met-marcy-mode') as HTMLSelectElement | null;
    const p80El = root.querySelector('#met-p80-input') as HTMLInputElement | null;
    const rrNEl = root.querySelector('#met-rr-n-input') as HTMLInputElement | null;
    const frameEl = root.querySelector('#met-frame-select') as HTMLSelectElement | null;
    const pressureEl = root.querySelector('#met-gy-pressure-select') as HTMLSelectElement | null;
    const d95El = root.querySelector('#met-gy-d95-input') as HTMLInputElement | null;
    const libEl = root.querySelector('#met-gy-lib-input') as HTMLInputElement | null;
    const gradeEl = root.querySelector('#met-gy-grade-input') as HTMLInputElement | null;
    const gyCEl = root.querySelector('#met-gy-c-input') as HTMLInputElement | null;
    const gyErrEl = root.querySelector('#met-gy-error-select') as HTMLSelectElement | null;
    const modeEl = root.querySelector('#met-screening-mode') as HTMLSelectElement | null;
    const sieveTbody = root.querySelector('#met-sieve-stack-tbody') as HTMLElement | null;

    if (!sgEl || !cwEl || !p80El || !frameEl) return;

    const targetId = (evt && (evt.target as HTMLElement)?.id) || '';
    const marcySolveMode = marcyModeEl ? marcyModeEl.value : 'cw';
    const rawSg = parseFloat(sgEl.value) || 2.8;
    const rawCw = parseFloat(cwEl.value) || 50;
    const rawRhop = rhopEl ? (parseFloat(rhopEl.value) || 1.474) : 1.474;

    let marcy = calculateMarcyScaleReading({
      solidsSpecificGravity: rawSg,
      solidsWeightPercent: rawCw,
      pulpDensityKgL: rawRhop,
      solveFor: marcySolveMode,
    });
    if (marcySolveMode === 'ore_density_rhop') {
      marcy = calculateMarcyScaleReading({
        solidsSpecificGravity: rawSg,
        solidsWeightPercent: rawCw,
        pulpDensityKgL: rawRhop,
        solveFor: 'ore_density_rhop',
      });
      if (document.activeElement !== sgEl) {
        sgEl.value = marcy.oreDensitySg.toFixed(2);
      }
    } else if (marcySolveMode === 'rhop' || targetId === 'met-rhop-input') {
      marcy = calculateMarcyScaleReading({
        solidsSpecificGravity: rawSg,
        pulpDensityKgL: rawRhop,
        solveFor: 'rhop',
      });
      if (document.activeElement !== cwEl) {
        cwEl.value = String(Math.round(marcy.solidsWeightPercent));
      }
    } else if (rhopEl && document.activeElement !== rhopEl) {
      rhopEl.value = marcy.pulpDensityKgL.toFixed(3);
    }

    const sg = marcy.oreDensitySg;
    const cw = marcy.solidsWeightPercent;
    const p80 = parseFloat(p80El.value) || 75;
    const frame = frameEl.value;

    if (targetId === 'met-p80-input' && d95El) {
      d95El.value = ((p80 * 1.4) / 1000).toFixed(3);
    }

    const topSizeD95Mm = d95El ? (parseFloat(d95El.value) || (p80 * 1.4) / 1000) : (p80 * 1.4) / 1000;
    const liberationSizeMicrons = libEl ? (parseFloat(libEl.value) || 100) : 100;
    const oreGradeDecimal = gradeEl ? (parseFloat(gradeEl.value) || 0.05) : 0.05;
    const samplingConstantC = gyCEl && targetId === 'met-gy-c-input' ? (parseFloat(gyCEl.value) || undefined) : undefined;
    const targetRelativeStdError = gyErrEl ? (parseFloat(gyErrEl.value) || 0.05) : 0.05;
    const airPressurePsi = pressureEl ? (parseFloat(pressureEl.value) || 90) : 90;
    const frameDiameterInches = frame.includes('12"') ? 12 : 8;
    const screeningMode = modeEl ? modeEl.value : 'auto';
    const rosinRammlerSlopeN = rrNEl && rrNEl.value ? parseFloat(rrNEl.value) : undefined;

    const gy = calculateGyMinimumSampleMass({
      topSizeD95Mm,
      liberationSizeMicrons,
      oreGradeDecimal,
      samplingConstantC,
      targetRelativeStdError,
      solidsWeightPercent: cw,
      solidsSpecificGravity: sg,
      airPressurePsi,
    });
    if (gyCEl && targetId !== 'met-gy-c-input' && document.activeElement !== gyCEl) {
      gyCEl.value = String(gy.samplingConstantC);
    }

    const sieveStack = recommendAstmSieveSeries({
      targetP80Microns: p80,
      frameDiameterInches,
      screeningMode,
      rosinRammlerSlopeN,
      drySampleMassGrams: gy.minDrySampleGrams,
    });

    const marcyMain = root.querySelector('#met-res-marcy-main');
    const marcySub = root.querySelector('#met-res-marcy-sub');
    const marcyBias = root.querySelector('#met-res-marcy-bias');
    const gyMain = root.querySelector('#met-res-gy-main');
    const gySub = root.querySelector('#met-res-gy-sub');
    const sievesMain = root.querySelector('#met-res-sieves-main');
    const sievesSub = root.querySelector('#met-res-sieves-sub');
    const sieveNumBadge = root.querySelector('#met-res-sieve-number');
    const drySampleBadge = root.querySelector('#met-res-dry-sample-mass');
    const quoteCta = root.querySelector('#met-quote-cta') as HTMLAnchorElement | null;
    const pumpPrecalCta = root.querySelector('#met-pump-precal-cta') as HTMLAnchorElement | null;

    if (marcyMain) {
      marcyMain.textContent = isEn
        ? `${marcy.cupNetMassGrams} g net • ρp = ${marcy.pulpDensityKgL.toFixed(3)} kg/L`
        : `${marcy.cupNetMassGrams} g netos • ρp = ${marcy.pulpDensityKgL.toFixed(3)} kg/L`;
    }
    if (marcySub) {
      const ringIdx = MARCY_STANDARD_RINGS.findIndex((r: any) => Math.abs(Number(r?.oreSg ?? r) - Number(marcy.recommendedRingSg)) < 0.06);
      const ringNum = ringIdx >= 0 ? ringIdx + 1 : 4;
      marcySub.textContent = isEn
        ? `Active Marcy ring: #${ringNum} SG ${marcy.recommendedRingSg.toFixed(1)} (of ${MARCY_STANDARD_RINGS.length} dials • Cv = ${marcy.solidsVolumePercent}%)`
        : `Anillo Marcy activo: #${ringNum} SG ${marcy.recommendedRingSg.toFixed(1)} (de ${MARCY_STANDARD_RINGS.length} anillos • Cv = ${marcy.solidsVolumePercent}%)`;
    }
    if (marcyBias) {
      marcyBias.textContent = isEn
        ? `Dry solids in cup: ${marcy.drySolidsMassGramsInCup} g • Ring Cw: ${marcy.ringApparentCw}% (ΔC_bias = ${marcy.wrongRingBiasPoints} pts)`
        : `Sólidos secos en vaso: ${marcy.drySolidsMassGramsInCup} g • Cw aparente: ${marcy.ringApparentCw}% (ΔC_bias = ${marcy.wrongRingBiasPoints} pts)`;
    }
    if (gyMain) {
      const wetLiters = gy.wetPulpVolumeLiters ?? gy.slurrySampleLiters;
      const wetLabel = sieveStack.screeningMode === 'wet'
        ? (isEn ? 'Wet + Dry Sieving' : 'Tamizado Húmedo + Seco')
        : (isEn ? 'Dry Sieving' : 'Tamizado en Seco');
      gyMain.textContent = `${gy.minDrySampleGrams} g (${wetLabel}) • ${wetLiters} L`;
    }
    if (gySub) {
      gySub.textContent = isEn
        ? `Pierre Gy mass: ${gy.theoreticalGyGrams} g (d95=${gy.topSizeD95Mm} mm, c=${gy.samplingConstantC}) • ${gy.batchFilterCycles} batch cycle(s) @ ${gy.recommendedAirPressurePsi} (${gy.estimatedCycleMinutes} min, ~${gy.residualCakeMoisturePct}% moisture)`
        : `Masa Pierre Gy: ${gy.theoreticalGyGrams} g (d95=${gy.topSizeD95Mm} mm, c=${gy.samplingConstantC}) • ${gy.batchFilterCycles} ciclo(s) a ${gy.recommendedAirPressurePsi} (${gy.estimatedCycleMinutes} min, humedad ~${gy.residualCakeMoisturePct}%)`;
    }
    if (sievesMain) {
      sievesMain.textContent = `${sieveStack.sieveStackSummary} (${ASTM_E11_SIEVE_TABLE.length} ASTM E11)`;
    }
    if (sievesSub) {
      sievesSub.textContent = isEn
        ? `Control cut: ${sieveStack.primaryControlMesh} (${sieveStack.primaryApertureMicrons} µm) • y'=${sieveStack.rosinRammlerYPrime} (n=${sieveStack.rosinRammlerSlopeN})`
        : `Corte central: ${sieveStack.primaryControlMesh} (${sieveStack.primaryApertureMicrons} µm) • y'=${sieveStack.rosinRammlerYPrime} (n=${sieveStack.rosinRammlerSlopeN})`;
    }
    if (sieveNumBadge) {
      const firstSieveNum = sieveStack.sieveStack?.[0]?.sieveNumber || sieveStack.primaryControlMesh;
      sieveNumBadge.textContent = isEn
        ? `Control Mesh: ${sieveStack.primaryControlMesh} (${firstSieveNum})`
        : `Tamiz Control: ${sieveStack.primaryControlMesh} (${firstSieveNum})`;
    }
    if (drySampleBadge) {
      drySampleBadge.textContent = isEn
        ? `ASTM Dry Mass: ${sieveStack.drySampleMassGrams} g`
        : `Masa Seca ASTM: ${sieveStack.drySampleMassGrams} g`;
    }
    if (sieveTbody && Array.isArray(sieveStack.sieveStack)) {
      renderSieveStackRowsSafe(sieveTbody, sieveStack.sieveStack);
    }

    const metrologiaStr = `Marcy SG=${marcy.recommendedRingSg.toFixed(1)} (${cw}% Cw, ρp=${marcy.pulpDensityKgL.toFixed(3)} kg/L) | Gy=${gy.minDrySampleKg} kg | ASTM P80=${p80} µm (${sieveStack.primaryControlMesh}, n=${sieveStack.rosinRammlerSlopeN})`;
    projectProcessControlMetrologyInvariants(document, lang, { marcy, gy, sieveStack });

    const quotePrefix = isEn ? '/en/quote/' : '/cotizar/';
    if (quoteCta) {
      quoteCta.href = `${quotePrefix}?circuito=control_procesos&equipo=balanza_marcy&sg=${sg}&cw=${cw}&rhop=${marcy.pulpDensityKgL}&p80=${p80}&d95=${gy.topSizeD95Mm}&lib_um=${gy.liberationSizeMicrons}&grade=${gy.oreGradeDecimal}&air_psi=${gy.airPressurePsi}&gy_c=${gy.samplingConstantC}&gy_err=${gy.targetRelativeStdError}&rr_n=${sieveStack.rosinRammlerSlopeN}&ret_p80=${sieveStack.retainedPercentAtP80}&gy_kg=${gy.minDrySampleKg}&metrologia=${encodeURIComponent(metrologiaStr)}#rfq`;
    }
    if (pumpPrecalCta) {
      pumpPrecalCta.href = `${quotePrefix}?circuito=bombeo&flow=220&solids=${cw}&d80=${p80}&sg=${sg}&rhop=${marcy.pulpDensityKgL}&metrologia=${encodeURIComponent(metrologiaStr)}#rfq`;
    }

    if (!evt) return;
    const prev = loadWorkbenchState() || {};
    saveWorkbenchState({
      ...prev,
      rhop: marcy.pulpDensityKgL,
      metrologia: metrologiaStr,
      metrology: {
        specificGravity: sg,
        solidsPctCw: cw,
        pulpDensityKgL: marcy.pulpDensityKgL,
        targetP80Microns: p80,
        primaryControlMesh: sieveStack.primaryControlMesh,
        drySampleMassGrams: sieveStack.drySampleMassGrams,
      },
    });
    saveEngineeringContextSnapshot('control_procesos', {
      specificGravity: sg,
      solidsPctCw: cw,
      pulpDensityKgL: marcy.pulpDensityKgL,
      recommendedRingSg: marcy.recommendedRingSg,
      wetPulpVolumeLiters: gy.wetPulpVolumeLiters ?? gy.slurrySampleLiters,
      wetScreeningRequired: sieveStack.wetScreeningRequired,
      summary: metrologiaStr,
    });
  }

  function initProcessControlIsland() {
    const standaloneRoot = document.querySelector('[data-island-standalone="metrology"]') as HTMLElement | null;
    if (!standaloneRoot) return;
    const lang: 'es' | 'en' = document.documentElement.lang === 'en' ? 'en' : 'es';
    const isEn = lang === 'en';
    const calcRoot = standaloneRoot.querySelector('#metrology-calculator') as HTMLElement | null;
    if (!calcRoot) return;

    const stationTabs = Array.from(standaloneRoot.querySelectorAll('[data-met-station-tab]'));
    const instrumentCards = Array.from(standaloneRoot.querySelectorAll('[data-instrument-card]'));
    const accordions = Array.from(standaloneRoot.querySelectorAll('[data-station-accordion]'));

    const activateStation = (stationId: string) => {
      stationTabs.forEach((tab) => {
        const isMatch = tab.getAttribute('data-met-station-tab') === stationId;
        tab.classList.toggle('is-active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });
      instrumentCards.forEach((card) => {
        const isMatch = card.getAttribute('data-instrument-card') === stationId;
        (card as HTMLElement).style.display = isMatch ? 'block' : 'none';
      });
      accordions.forEach((acc) => {
        const isMatch = acc.getAttribute('data-station-accordion') === stationId;
        (acc as HTMLDetailsElement).open = isMatch;
        const tag = acc.querySelector('.metrology-station-tag');
        if (tag) {
          tag.textContent = isEn
            ? (isMatch ? `STATION 0${stationId} • ACTIVE` : `STATION 0${stationId} ▾`)
            : (isMatch ? `ESTACIÓN 0${stationId} • ACTIVA` : `ESTACIÓN 0${stationId} ▾`);
        }
      });
    };

    if (calcRoot.dataset.smatCtrlInit !== '1') {
      calcRoot.dataset.smatCtrlInit = '1';
      const unified = loadUnifiedEngineeringAndWorkbenchState();
      if (unified?.hasPersistedState && unified.persistedFields) {
        const sgInput = standaloneRoot.querySelector('#met-sg-input') as HTMLInputElement | null;
        const cwInput = standaloneRoot.querySelector('#met-cw-input') as HTMLInputElement | null;
        const p80Input = standaloneRoot.querySelector('#met-p80-input') as HTMLInputElement | null;
        const fSg = Number(unified.persistedFields.sg);
        if (sgInput && Number.isFinite(fSg) && fSg >= 2.2 && fSg <= 4.5) sgInput.value = String(fSg);
        const fCw = Number(unified.persistedFields.cw);
        if (cwInput && Number.isFinite(fCw) && fCw >= 5 && fCw <= 80) cwInput.value = String(fCw);
        const fP80 = Number(unified.persistedFields.d80Um);
        if (p80Input && Number.isFinite(fP80) && fP80 >= 25 && fP80 <= 2000) p80Input.value = String(fP80);
      }
      bindAtomicPartTrayButtons(standaloneRoot);

      stationTabs.forEach((tab) => {
        tab.addEventListener('click', () => activateStation(tab.getAttribute('data-met-station-tab') || '1'));
      });
      standaloneRoot.querySelectorAll('[data-open-station]').forEach((btn) => {
        btn.addEventListener('click', () => activateStation(btn.getAttribute('data-open-station') || '1'));
      });
      accordions.forEach((acc) => {
        acc.addEventListener('toggle', () => {
          if ((acc as HTMLDetailsElement).open) activateStation(acc.getAttribute('data-station-accordion') || '1');
        });
      });

      [
        '#met-marcy-mode', '#met-sg-input', '#met-cw-input', '#met-rhop-input',
        '#met-gy-pressure-select', '#met-gy-d95-input', '#met-gy-lib-input', '#met-gy-grade-input',
        '#met-gy-c-input', '#met-gy-error-select', '#met-p80-input', '#met-rr-n-input',
        '#met-frame-select', '#met-screening-mode',
      ].forEach((sel) => {
        const el = standaloneRoot.querySelector(sel);
        if (el) {
          el.addEventListener('input', (e) => updateMetrologyCalculator(standaloneRoot, lang, e));
          el.addEventListener('change', (e) => updateMetrologyCalculator(standaloneRoot, lang, e));
        }
      });

      const applySsBtn = standaloneRoot.querySelector('#met-apply-ss-btn');
      if (applySsBtn) {
        applySsBtn.addEventListener('click', (e) => {
          updateMetrologyCalculator(standaloneRoot, lang, e);
          const sgEl = standaloneRoot.querySelector('#met-sg-input') as HTMLInputElement | null;
          const cwEl = standaloneRoot.querySelector('#met-cw-input') as HTMLInputElement | null;
          const sg = sgEl ? (parseFloat(sgEl.value) || 2.8) : 2.8;
          const cw = cwEl ? (parseFloat(cwEl.value) || 50) : 50;
          const prev = loadWorkbenchState() || {};
          saveWorkbenchState({ ...prev, sg, cw, solidsSg: sg, solidsPct: cw });
          applySsBtn.textContent = isEn
            ? `Ss = ${sg.toFixed(2)} & Cw = ${cw.toFixed(0)}% synced`
            : `Ss = ${sg.toFixed(2)} y Cw = ${cw.toFixed(0)}% sincronizados`;
        });
      }
    }

    updateMetrologyCalculator(standaloneRoot, lang);
  }

  initProcessControlIsland();
  document.addEventListener('astro:page-load', initProcessControlIsland);
</script>

