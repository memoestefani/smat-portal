---
/**
 * CycloneScreenIsland.astro
 * ---------------------------------------------------------------------------
 * Isla Canónica Bilingüe Única de Clasificación Hidrociclónica (`D3-V51` / `SLICE-V51-13`):
 *   - Cero bifurcaciones duales `{mode}`.
 *   - Monta `<CycloneScreenCore />` único compartido entre `/clasificacion/` y `/cotizar/`.
 */
import CycloneScreenCore from '../cores/CycloneScreenCore.astro';
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import SharePurchasing from '../SharePurchasing.astro';
import CycloneAndScreenReport from '../CycloneAndScreenReport.astro';
import { SMAT_SUPPLY_DOORS } from '../../scripts/i18nDomainLabels.js';

interface Props {
  locale?: 'es' | 'en';
  mode?: 'standalone' | 'embedded';
}

const { locale = 'es', mode = 'standalone' } = Astro.props;
const isEs = locale === 'es';
const lang = locale;
const showVerticalShell = mode === 'standalone';
const productsBase = isEs ? '/productos/' : '/en/products/';
---

{showVerticalShell && (
  <div class="cyc-main" id="stage-diagnostic" data-island-standalone="cycloneScreen">
    <div class="container">
      <header class="cyc-hero">
        <div class="smat-flex-between">
          <h1>{isEs ? 'Clasificación por Hidrociclones y Diagnóstico de Roping' : 'Hydrocyclone Classification & Roping Diagnostics'}</h1>
          <span class="cyc-badge" data-smat-decision="D7">
            {isEs ? SMAT_SUPPLY_DOORS.classificationSubEs : SMAT_SUPPLY_DOORS.classificationSubEn}
          </span>
        </div>
        <p class="cyc-lead">
          {isEs
            ? 'Audite su batería de hidrociclones y criba de uretano midiendo únicamente 3 vasos con Balanza Marcy (Alimentación, Ápex y Vortex) sin báscula de banda ni flujómetro.'
            : 'Audit your hydrocyclone cluster and urethane screen using only 3 Marcy Scale cups (Feed, Underflow Apex, Overflow Vortex) with zero belt scale or flowmeter.'}
        </p>
      </header>

      <section class="cyc-sim-card" id="marcy-3cup-cyclone-calculator" data-stratum-1-instrument aria-labelledby="cyc-sim-heading">
        <div class="cyc-sim-header">
          <h2 id="cyc-sim-heading">
            {isEs ? 'Calculadora de Balance 3 Vasos Marcy, Plitt (d50c) y Criba Weibull' : '3-Cup Marcy Mass Balance, Plitt (d50c) & Weibull Screen Simulator'}
          </h2>
          <span class="cyc-sim-tag">{isEs ? 'CERO BÁSCULA • CERO FLUJÓMETRO' : 'ZERO BELT SCALE • ZERO FLOWMETER'}</span>
        </div>

        <CycloneScreenCore locale={locale} showVerticalActions={true} panelClass="cyc-core-standalone" />
      </section>

      <TechnicalDiagrams diagram="cyclone-apex-vortex" lang={lang} showXrayOverlay={true} />

      <details class="wb-progressive-drawer smat-mt-sm" id="cyc-report-and-spares-drawer">
        <summary class="tier2-cyc-summary">
          {isEs ? 'Repuestos Críticos (Ápex / Vortex / Malla TH48-30) y Reporte de Geometría ▾' : 'Critical Spares (Apex / Vortex / TH48-30 Screen) & Geometry Report ▾'}
        </summary>
        <section class="cyc-sku-catalog" aria-label={isEs ? 'Repuestos críticos de hidrociclón' : 'Critical Hydrocyclone Spares'}>
          <h2>
            {isEs
              ? 'Repuestos Críticos de Hidrociclón con Cotejo Dimensional 1:1 en Durango'
              : 'Critical Hydrocyclone Spares Verified 1:1 in Durango'}
          </h2>
          <div class="cyc-sku-cards">
            <article class="cyc-sku-card">
              <span class="cyc-sku-code">SMAT-CYC-D6-D20 • UNDERFLOW</span>
              <h3>{isEs ? 'Boquilla Ápex / Spigot (SiC / Cr27)' : 'Apex Spigot Nozzle (SiC / Cr27)'}</h3>
              <p>
                {isEs
                  ? 'Geometría cónica rectificada para conservar descarga semi-paraguas y prevenir acordonamiento (roping).'
                  : 'Precision taper bore preserving semi-umbrella spray angle and preventing roping.'}
              </p>
              <a href={`${productsBase}${isEs ? 'hidrociclon-completo-y-boquillas-d6-d20/' : 'hydrocyclone-assembly-and-spigots-d6-d20/'}`}>
                SMAT-CYC-D6-D20 →
              </a>
            </article>

            <article class="cyc-sku-card">
              <span class="cyc-sku-code">SMAT-COUPLED-PUMP-CYC • OVERFLOW</span>
              <h3>{isEs ? 'Paquete Casado Bomba + Hidrociclón' : 'Coupled Slurry Pump + Hydrocyclone Package'}</h3>
              <p>
                {isEs
                  ? 'Emparejamiento hidráulico bomba-ciclón con presión estable en nido (10–12 psi) y cero cortocircuito de gruesos.'
                  : 'Matched pump-cluster hydraulic sizing keeping 10–12 psi feed pressure and curbing coarse bypass.'}
              </p>
              <a href={`${productsBase}${isEs ? 'paquete-casado-bomba-hidrociclon/' : 'coupled-pump-hydrocyclone-package/'}`}>
                SMAT-COUPLED-PUMP-CYC →
              </a>
            </article>

            <article class="cyc-sku-card">
              <span class="cyc-sku-code">SMAT-SCR-TH48-30 • SCREENING</span>
              <h3>{isEs ? 'Mallas Finas de Uretano TH48-30 y Conos' : 'TH48-30 Fine Urethane Screens & Cone Liners'}</h3>
              <p>
                {isEs
                  ? 'Aberturas calibradas de alta nitidez (α ≥ 4.2) y ángulo de alivio anti-cegamiento para descarga de molienda.'
                  : 'Sharp partition aperture profiles (α ≥ 4.2) with anti-blinding tapered relief slots.'}
              </p>
              <a href={`${productsBase}${isEs ? 'mallas-finas-uretano-th48-30/' : 'high-frequency-urethane-screens-th48-30/'}`}>
                SMAT-SCR-TH48-30 →
              </a>
            </article>
          </div>
        </section>

        <CycloneAndScreenReport lang={lang} />
      </details>

      <SharePurchasing
        lang={lang}
        circuit="clasificacion"
        role="hidrociclon_apex_vortex"
        partName={isEs ? 'Batería de Hidrociclones — Ápex, Vortex Finder y Conos' : 'Hydrocyclone Cluster — Apex, Vortex Finder & Cones'}
        partCode="SMAT-CYC-D6-D20"
      />
    </div>
  </div>
)}

{!showVerticalShell && (
  <CycloneScreenCore locale={locale} showVerticalActions={false} panelClass="circuit-panel hidden embedded-cyc-panel" />
)}

<script>
  import { bindCoupledClassificationStation } from '../../scripts/verticalCalculatorsAndLabelsBridge.js';

  function initCycloneScreenIsland() {
    const standaloneRoot = document.querySelector('[data-island-standalone="cycloneScreen"]');
    if (!standaloneRoot) return;
    const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
    bindCoupledClassificationStation(standaloneRoot, lang);
  }

  initCycloneScreenIsland();
  document.addEventListener('astro:page-load', initCycloneScreenIsland);
</script>

<style>
  .cyc-main { padding: clamp(0.4rem, 1.2vw, 0.9rem) 0 3.25rem; background: #f8fafc; }
  .cyc-hero { margin-bottom: 0.5rem; }
  .cyc-hero h1 { margin: 0; font-size: clamp(1.15rem, 3.6vw, 1.65rem); line-height: 1.2; color: #0f172a; }
  .cyc-badge {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    background: #f0f9ff;
    color: #082f49;
    border: 1px solid #bae6fd;
    border-radius: 4px;
    font-family: var(--smat-font-mono, monospace);
    font-size: 0.74rem;
    font-weight: 800;
  }
  .cyc-lead { font-size: 0.85rem; color: #334155; max-width: 78ch; margin: 0.25rem 0 0; }
  .cyc-sim-card { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 12px; padding: 1.45rem; margin: 0 0 1.5rem; }
  .cyc-sim-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.75rem; }
  .cyc-sim-tag { background: #ecfdf5; color: #064e3b; border: 1px solid #059669; padding: 0.25rem 0.6rem; border-radius: 4px; font-family: var(--smat-font-mono, monospace); font-size: 0.75rem; font-weight: 800; }
  .cyc-coupling-badge { margin-bottom: 0.75rem; padding: 0.55rem 0.75rem; background: #ecfdf5; border: 1px solid #059669; border-radius: 6px; font-family: var(--smat-font-mono); font-size: 0.78rem; font-weight: 700; color: #064e3b; }
  .csr-weibull-readout { font-family: var(--smat-font-mono); font-weight: 700; color: #064e3b; font-size: 0.8rem; }
  .cyc-cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; align-items: center; }
  .smat-tap-btn { min-height: 48px; }
  .btn-cyc-sku, .btn-cyc-rfq { display: inline-flex; align-items: center; min-height: 48px; padding: 0.7rem 1.1rem; border-radius: 8px; font-weight: 700; font-size: 0.86rem; text-decoration: none; }
  .btn-cyc-sku { background: #7c2d12; color: #ffffff; }
  .btn-cyc-rfq { background: #0f172a; color: #ffffff; }
  .cyc-sku-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin: 1rem 0 2rem; }
  .cyc-sku-card { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 10px; padding: 1.25rem; }
  .cyc-sku-code { display: block; font-family: var(--smat-font-mono, monospace); font-size: 0.72rem; font-weight: 800; color: #7c2d12; margin-bottom: 0.35rem; }
  .cyc-sku-card a { display: inline-block; margin-top: 0.65rem; font-weight: 700; color: #0c4a6e; }
  .embedded-cyc-panel { margin-top: 0.75rem; padding: 0.85rem; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; }
  .tier2-cyc-details { border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.45rem 0.75rem; background: #ffffff; }
  .tier2-cyc-summary { cursor: pointer; font-weight: 700; font-size: 0.78rem; color: #0c4a6e; min-height: 48px; display: flex; align-items: center; }
  .embedded-cyc-res { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.38rem; font-size: 0.72rem; color: #0f172a; }
  .embedded-res-cell { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px; padding: 0.32rem 0.48rem; }
</style>
