---
// src/components/islands/SealDriveBearingIsland.astro — Isla Canónica Unificada de Sellado, Tren Motriz y Soporte ISO 281 (SLICE-V50-30..32)
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import SharePurchasing from '../SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../scripts/workbenchBus.js';
import { DRIVE_ARRANGEMENT_CATALOG } from '../../scripts/slurryEngine.js';
import rolesData from '../../../data/roles.json';

interface Props {
  locale?: 'es' | 'en';
  variant?: 'seal' | 'skid' | 'bearing';
  mode?: 'standalone' | 'embedded';
}

const { locale = 'es', variant = 'seal', mode = 'standalone' } = Astro.props;
const isEs = locale === 'es';
const isStandalone = mode === 'standalone';
const quoteBase = isEs ? '/cotizar/' : '/en/quote/';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const roleLookupId = variant === 'seal' ? 'sello' : (variant === 'skid' ? 'skid_bomba' : 'soporte');
const roleObj = allRoles.find((r) => r.role_id === roleLookupId);
const dc = roleObj?.decision_criteria;

const sealParts = variant === 'seal' ? [getAtomicPartSpecs('DAM028'), getAtomicPartSpecs('EAM028')].filter(Boolean) : [];
const driveArrangements = variant === 'skid' ? Object.values(DRIVE_ARRANGEMENT_CATALOG) : [];
---

{isStandalone && (
  <div data-island-standalone="sealDrive" data-variant={variant} data-lang={locale}>
    <section class="page-hero smat-compact-hero">
      <div class="container">
        <a href={isEs ? '/bombeo/' : '/en/pumping/'} class="back-link">
          {isEs ? '← Volver a Bombas para Lodos' : '← Back to Slurry Pumps'}
        </a>
        <div class="smat-sdb-badge-wrap">
          <span class="badge badge-copper">
            {variant === 'seal'
              ? (isEs ? 'ESTACIÓN 02 · SELLADO CENTRÍFUGO Y PRENSAESTOPA' : 'STATION 02 · CENTRIFUGAL EXPELLER & STUFFING BOX')
              : variant === 'skid'
                ? (isEs ? 'EQUIPO COMPLETO • ARREGLOS CV / ZVZ / CRZ / DC' : 'COMPLETE PUMP • CV / ZVZ / CRZ / DC DRIVES')
                : (isEs ? 'ESTACIÓN 01 · BEARING ASSEMBLY / HOUSING' : 'STATION 01 · BEARING ASSEMBLY / HOUSING')}
          </span>
        </div>
        <h1>
          {variant === 'seal'
            ? (isEs ? 'Expulsor Centrífugo y Prensaestopa' : 'Centrifugal Expeller & Stuffing Box')
            : variant === 'skid'
              ? (isEs ? 'Bombas para Lodos — Calibrador Cinemático & Tren Motriz' : 'Slurry Pumps — V-Belt Kinematics & Drive Assembly')
              : 'Bearing Assembly / Housing'}
        </h1>
        <p class="smat-hero-sub">
          {variant === 'seal'
            ? (isEs
              ? 'Calibración en vivo de contrapresión Expeller (02A Seco) vs Agua de Prensaestopas (02B Húmedo) sin sello mecánico.'
              : 'Live sealing pressure calibration: Dry Expeller (02A Zero Flush Water) vs Flushed Stuffing Box (02B) — no mechanical seals.')
            : variant === 'skid'
              ? (isEs
                ? 'Calibre poleas V-Belt, velocidad periférica (u₂ ≤ 24.5 m/s en Hule R55 vs A05) y vida ISO 281 L₁₀h antes de cotizar su bomba o skid.'
                : 'Calibrate V-Belt sheave ratio, peripheral tip speed (u₂ ≤ 24.5 m/s Rubber R55 vs A05), and ISO 281 L₁₀h life before requesting your skid quote.')
              : (isEs
                ? 'Calibración en vivo de vida modificada ISO 281 L₁₀ₘₕ, bastidor recomendado e intercambio Core Trade-In DAM005 (-22% / -12%).'
                : 'Live ISO 281 L₁₀ₘₕ bearing life calibration, recommended frame sizing, and DAM005 Core Trade-In exchange (-22% / -12%).')}
        </p>
      </div>
    </section>

    <section class="section smat-stage-compact" id={variant === 'skid' ? 'skid-main-section' : undefined}>
      <div class="container">
        {variant === 'seal' && (
          <div class="card smat-sdb-sim-card" id="stratum1-seal-sim" data-seal-branch-comparator data-stratum-1-instrument>
            <div class="smat-sdb-sim-head">
              <span class="badge badge-copper">{isEs ? 'BIFURCACIÓN DE SELLADO ESTACIÓN 02' : 'STATION 02 SEALING BIFURCATION'}</span>
              <span class="font-mono-tech smat-sdb-formula">ΔP_exp = ½·ρ_m·k_ω²·ω²·(R_exp² - R_h²) &gt; P_s + ΔP_back</span>
            </div>
            <h2 class="smat-sdb-sim-title">
              {isEs
                ? 'Calculadora en Vivo: Contrapresión de Expeller (02A Seco) vs Agua de Prensaestopas (02B Húmedo)'
                : 'Live Calculator: Expeller Counter-Pressure (02A Dry) vs Stuffing Box Flush Water (02B Wet)'}
            </h2>

            <div class="smat-stratum1-display">
              <div id="seal-status-out" class="smat-sdb-status-ok">
                {isEs
                  ? 'Rama 02A Viable (Sellado Seco Expeller • 0 L/min agua • Hs/Hd = 11.4%): Margen centrífugo positivo.'
                  : 'Branch 02A Viable (Dry Expeller Seal • 0 L/min gland water • Hs/Hd = 11.4%): Positive centrifugal margin.'}
              </div>
              <div class="smat-sdb-kpi-grid">
                <div class="smat-sdb-kpi-card"><strong>{isEs ? 'Contrapresión Expeller:' : 'Expeller Pressure:'}</strong> <span id="seal-pexp-out">118.4 kPa</span></div>
                <div class="smat-sdb-kpi-card"><strong>{isEs ? 'Presión Caja Estopas:' : 'Stuffing Box Pressure:'}</strong> <span id="seal-pbox-out">88.8 kPa</span></div>
                <div class="smat-sdb-kpi-card"><strong>{isEs ? 'Agua de Sello Req.:' : 'Flush Water Req.:'}</strong> <span id="seal-pwater-out">{isEs ? '0 L/min (Seco 02A)' : '0 L/min (Dry 02A)'}</span></div>
                <div class="smat-sdb-kpi-card"><strong>{isEs ? 'Rama Recomendada:' : 'Recommended Branch:'}</strong> <span id="seal-branch-out">{isEs ? '02A · Expeller Centrífugo Seco' : '02A · Dry Expeller Seal'}</span></div>
              </div>
            </div>

            <div class="smat-inputs-2col smat-sdb-inputs-box">
              <label class="smat-sdb-field">
                <span>{isEs ? 'Carga Total TDH (m):' : 'Total Head TDH (m):'}</span>
                <input type="number" id="seal-hd-m" min="5" max="110" step="1" value="28" class="smat-sdb-ctrl" />
              </label>
              <label class="smat-sdb-field">
                <span>{isEs ? 'Carga Succión Hs (m):' : 'Suction Head Hs (m):'}</span>
                <input type="number" id="seal-hs-m" min="0" max="25" step="0.5" value="3.2" class="smat-sdb-ctrl" />
              </label>
              <label class="smat-sdb-field">
                <span>Ø Expeller (mm):</span>
                <input type="number" id="seal-exp-dia" min="140" max="520" step="10" value="280" class="smat-sdb-ctrl" />
              </label>
              <label class="smat-sdb-field">
                <span>{isEs ? 'Velocidad Bomba (RPM):' : 'Pump Speed (RPM):'}</span>
                <input type="number" id="seal-rpm" min="400" max="2200" step="25" value="1150" class="smat-sdb-ctrl" />
              </label>
              <label class="smat-sdb-field">
                <span>{isEs ? 'Densidad Pulpa (SG_m):' : 'Slurry Density (SG_m):'}</span>
                <input type="number" id="seal-sg" min="1.05" max="2.20" step="0.02" value="1.38" class="smat-sdb-ctrl" />
              </label>
            </div>

            <div class="smat-sdb-actions">
              <a href={`${quoteBase}?circuito=bombeo&equipo=kit_sellado&pieza=expeller_sello&seal_branch=expeller_dry&estacion=S2#rfq`} class="btn btn-primary smat-sdb-btn-tall">
                {isEs ? 'Cotizar Sellado Calibrado →' : 'Quote Calibrated Sealing →'}
              </a>
              <button
                type="button"
                class="btn btn-outline btn-avenue-tray smat-sdb-btn-tall"
                data-vertical-tray-btn
                data-add-tray-sku="SMAT-SEAL-EXPELLER"
                data-tray-part-code="E4028"
                data-tray-title={isEs ? 'Sistema Sellado Expeller Calibrado (02A)' : 'Calibrated Expeller Seal System (02A)'}
                data-tray-series="02A"
                data-tray-material="A05"
                data-tray-circuit="bombeo"
                data-tray-source="seal_stratum1_calc"
              >
                {isEs ? '+ Sumar SKU Calibrado a Bandeja' : '+ Add Calibrated SKU to Tray'}
              </button>
            </div>

            <div class="grid-2 smat-sdb-branch-grid">
              <div class="smat-sdb-branch-card">
                <span class="font-mono-tech smat-sdb-branch-ok">{isEs ? '[ESTACIÓN 02A — SELLADO SECO EXPELLER]' : '[STATION 02A — DRY EXPELLER SEAL]'}</span>
                <strong class="smat-sdb-card-title">{isEs ? 'Expulsor Centrífugo Seco (Cero Agua de Sello)' : 'Dry Centrifugal Expeller (Zero Gland Water)'}</strong>
                <p class="smat-sdb-branch-copy">
                  {isEs
                    ? 'Recomendado cuando la presión de succión P_s ≤ 18% de la carga total H y velocidad fija o VFD ≥ 70% RPM nominal. Evita diluir el %Cw hacia hidrociclones y flotación.'
                    : 'Recommended when suction head P_s ≤ 18% of total head H and fixed speed or VFD ≥ 70% nominal RPM. Prevents %Cw dilution feeding hydrocyclones and flotation.'}
                </p>
                <a href={`${quoteBase}?circuito=bombeo&equipo=kit_sellado&seal_branch=expeller_dry&estacion=S2#rfq`} data-card-fixed-params="seal_branch" class="btn btn-primary smat-sdb-branch-cta">
                  {isEs ? 'Configurar Estación 02A (Seco) →' : 'Configure Station 02A (Dry) →'}
                </a>
              </div>
              <div class="smat-sdb-branch-card">
                <span class="font-mono-tech smat-sdb-branch-wet">{isEs ? '[ESTACIÓN 02B — PRENSAESTOPAS HÚMEDO]' : '[STATION 02B — FLUSHED GLAND PACKING]'}</span>
                <strong class="smat-sdb-card-title">{isEs ? 'Prensaestopa Húmedo (Flushing con Anillo Linterna)' : 'Wet Packed Stuffing Box (Lantern Ring Flushing)'}</strong>
                <p class="smat-sdb-branch-copy">
                  {isEs
                    ? 'Requerido en bombas en serie (etapa 2+), carga positiva de succión P_s > 18% H o variador de frecuencia VFD a baja velocidad donde cae ω² del expulsor.'
                    : 'Required in multi-stage pumps (stage 2+), high suction head P_s > 18% H, or low-speed VFD service where ω² expeller head drops.'}
                </p>
                <a href={`${quoteBase}?circuito=bombeo&equipo=kit_sellado&seal_branch=gland_water&estacion=S2#rfq`} data-card-fixed-params="seal_branch" class="btn btn-outline smat-sdb-branch-cta">
                  {isEs ? 'Configurar Estación 02B (Húmedo) →' : 'Configure Station 02B (Wet) →'}
                </a>
              </div>
            </div>
          </div>
        )}

        {variant === 'skid' && (
          <details class="skid-kinematics-calibrator" id="stratum1-skid-sim" data-skid-kinematics open data-stratum-1-instrument>
            <summary class="skid-kinematics-calibrator__summary">
              <span class="skid-kinematics-calibrator__badge">{isEs ? 'SIMULADOR CINEMÁTICO ISO 281' : 'ISO 281 KINEMATICS SIMULATOR'}</span>
              <span class="skid-kinematics-calibrator__title">
                {isEs
                  ? 'Relación de Poleas V-Belt, Velocidad Periférica u₂, Material Húmedo (A05 / R55 / U01 / SiC / Híbrido) y Vida L₁₀h'
                  : 'V-Belt Sheave Ratio, Tip Speed u₂, Wet-End Metallurgy (A05 / R55 / U01 / SiC / Hybrid) & Bearing Life L₁₀h'}
              </span>
              <span class="skid-kinematics-calibrator__hint">{isEs ? 'Instrumento activo ▾' : 'Active instrument ▾'}</span>
            </summary>

            <div class="skid-kinematics-calibrator__body">
              <div class="smat-stratum1-display">
                <div class="skid-kinematics-calibrator__metrics">
                  <div class="kin-metric-card">
                    <span class="kin-metric-card__kicker">{isEs ? 'VELOCIDAD EN EJE BOMBA' : 'PUMP SHAFT SPEED'}</span>
                    <strong id="wb-kin-pump-rpm" class="kin-metric-card__val" data-kin-rpm data-kin-pump-rpm>1001 RPM</strong>
                    <span class="kin-metric-card__sub" data-kin-ratio>{isEs ? 'Motor 1780 RPM • Relación 0.56×' : 'Motor 1780 RPM • Ratio 0.56×'}</span>
                  </div>
                  <div class="kin-metric-card">
                    <span class="kin-metric-card__kicker">{isEs ? 'VELOCIDAD PERIFÉRICA (u₂)' : 'PERIPHERAL TIP SPEED (u₂)'}</span>
                    <strong id="wb-kin-u2" class="kin-metric-card__val" data-kin-u2>19.92 m/s</strong>
                    <span class="kin-metric-card__sub" data-kin-u2-status>{isEs ? 'Dentro de límite elástico de Hule y A05' : 'Within Rubber & A05 elastic envelope'}</span>
                    <div class="kin-metric-card__sub smat-sdb-hybrid-note" data-kin-hybrid-note></div>
                  </div>
                  <div class="kin-metric-card">
                    <span class="kin-metric-card__kicker">{isEs ? 'CARGA RADIAL BANDAS (Fᵣ)' : 'RADIAL BELT LOAD (Fᵣ)'}</span>
                    <strong id="wb-kin-fr" class="kin-metric-card__val" data-kin-fr>6.71 kN</strong>
                    <span class="kin-metric-card__sub" data-kin-fr-sub data-kin-load-p>{isEs ? 'Carga eq. P = 14.37 kN • Huella 1.00×' : 'Eq. load P = 14.37 kN • Footprint 1.00×'}</span>
                  </div>
                  <div class="kin-metric-card">
                    <span class="kin-metric-card__kicker">{isEs ? 'VIDA ISO 281 (L₁₀h / L₁₀ₘₕ LABERINTO)' : 'ISO 281 BEARING LIFE (L₁₀h / LABYRINTH)'}</span>
                    <strong id="wb-kin-l10h" class="kin-metric-card__val" data-kin-l10h>42,800 h</strong>
                    <span class="kin-metric-card__sub" data-kin-l10mh>{isEs ? 'L₁₀ₘₕ Laberinto: 53,500 h vs Fieltro: 9,416 h' : 'L₁₀ₘₕ Labyrinth: 53,500 h vs Felt: 9,416 h'}</span>
                  </div>
                </div>
              </div>

              <div class="smat-inputs-2col skid-kinematics-calibrator__controls">
                <label class="kin-field">
                  <span>{isEs ? 'Arreglo de Transmisión:' : 'Drive Arrangement:'}</span>
                  <select id="wb-drive-arrangement" data-kin-arrangement>
                    <option value="CV" selected>{isEs ? 'CV — Motor Superior (Overhead)' : 'CV — Overhead Piggyback Motor'}</option>
                    <option value="ZVZ">{isEs ? 'ZVZ — Motor Trasero Elevado' : 'ZVZ — Elevated Rear Motor'}</option>
                    <option value="CRZ">{isEs ? 'CRZ — Motor Lateral en Base' : 'CRZ — Side-by-Side Base Motor'}</option>
                    <option value="DC">{isEs ? 'DC — Acoplamiento Directo (Fr = 0 kN)' : 'DC — Direct Inline Coupling (Fr = 0 kN)'}</option>
                  </select>
                </label>
                <label class="kin-field">
                  <span>{isEs ? 'Velocidad Motor Eléctrico (RPM):' : 'Electric Motor Speed (RPM):'}</span>
                  <select id="wb-motor-rpm" data-kin-motor-rpm>
                    <option value="1780" selected>{isEs ? '1780 RPM (4 Polos • 60 Hz)' : '1780 RPM (4-Pole • 60 Hz)'}</option>
                    <option value="1480">{isEs ? '1480 RPM (4 Polos • 50 Hz / VFD)' : '1480 RPM (4-Pole • 50 Hz / VFD)'}</option>
                    <option value="1180">{isEs ? '1180 RPM (6 Polos • 60 Hz)' : '1180 RPM (6-Pole • 60 Hz)'}</option>
                  </select>
                </label>
                <label class="kin-field">
                  <span>{isEs ? 'Polea Motriz Motor (mm):' : 'Driver Motor Sheave (mm):'} <strong data-kin-driver-val>180 mm</strong></span>
                  <input type="range" id="wb-driver-pulley" min="120" max="380" step="10" value="180" data-kin-driver data-kin-driver-mm="true" />
                </label>
                <label class="kin-field">
                  <span>{isEs ? 'Polea Conducida Bomba (mm):' : 'Driven Pump Sheave (mm):'} <strong data-kin-driven-val>320 mm</strong></span>
                  <input type="range" id="wb-driven-pulley" min="160" max="560" step="10" value="320" data-kin-driven data-kin-driven-mm="true" />
                </label>
                <label class="kin-field">
                  <span>{isEs ? 'Potencia en Flecha (kW):' : 'Shaft Power (kW):'} <strong data-kin-power-val>45 kW (60 HP)</strong></span>
                  <input type="range" id="wb-shaft-power" min="15" max="315" step="5" value="45" data-kin-power data-kin-power-kw="true" />
                </label>
                <label class="kin-field">
                  <span>{isEs ? 'Diámetro Impulsor ØD₂:' : 'Impeller Diameter ØD₂:'}</span>
                  <select data-kin-impeller>
                    <option value="270">{isEs ? '270 mm — Serie 3x2 / 4x3 (D3147)' : '270 mm — 3x2 / 4x3 Series (D3147)'}</option>
                    <option value="380" selected>{isEs ? '380 mm — Serie 6x4 (E4147)' : '380 mm — 6x4 Series (E4147)'}</option>
                    <option value="510">{isEs ? '510 mm — Serie 8x6 (F6147)' : '510 mm — 8x6 Series (F6147)'}</option>
                    <option value="640">{isEs ? '640 mm — Serie 10x8 (G8147)' : '640 mm — 10x8 Series (G8147)'}</option>
                  </select>
                </label>
                <label class="kin-field">
                  <span>{isEs ? 'Material en Contacto Húmedo (5/5):' : 'Wet-End Material (5/5):'}</span>
                  <select data-kin-material>
                    <option value="alto_cromo_cr27" selected>{isEs ? 'Alto Cromo 27% A05 (u₂ máx 32.0 m/s)' : '27% High Chrome A05 (u₂ max 32.0 m/s)'}</option>
                    <option value="hule_natural">{isEs ? 'Hule Natural R55 (u₂ máx 24.5 m/s)' : 'Natural Rubber R55 (u₂ max 24.5 m/s)'}</option>
                    <option value="poliuretano">{isEs ? 'Poliuretano U01 (u₂ máx 26.0 m/s)' : 'Polyurethane U01 (u₂ max 26.0 m/s)'}</option>
                    <option value="ceramica_sic">{isEs ? 'Cerámica Carburo Silicio SiC (u₂ máx 28.0 m/s)' : 'Silicon Carbide SiC (u₂ max 28.0 m/s)'}</option>
                    <option value="hybrid_a05_r55">{isEs ? 'Rama D Híbrida (A05 + R55 • u₂ máx 24.5 m/s)' : 'Hybrid Branch D (A05 + R55 • u₂ max 24.5 m/s)'}</option>
                  </select>
                </label>
                <label class="kin-field">
                  <span>{isEs ? 'Capacidad Dinámica Rodamiento C (kN):' : 'Dynamic Bearing Capacity C (kN):'}</span>
                  <input type="number" min="60" max="450" step="5" value="145" data-kin-capacity-c />
                </label>
              </div>

              <div class="smat-sdb-actions">
                <a
                  href={`${quoteBase}?circuito=bombeo&equipo=skid_bomba&transmision=CV&material=alto_cromo_cr27&u2_ms=19.92&l10h=42800#rfq`}
                  class="btn btn-primary smat-sdb-btn-tall"
                  data-kin-cta
                  data-quote-base={quoteBase}
                >
                  {isEs ? 'Cotizar Bomba con esta Cinemática →' : 'Quote Pump with This Kinematics →'}
                </a>
                <button
                  type="button"
                  class="btn btn-outline btn-avenue-tray smat-sdb-btn-tall"
                  data-vertical-tray-btn
                  data-add-tray-sku="SMAT-PUMP-DRIVE-SKID"
                  data-tray-part-code="CV-6x4"
                  data-tray-title={isEs ? 'Tren Motriz Bomba CV (6x4, 45 kW)' : 'Motor-Pump Skid CV (6x4, 45 kW)'}
                  data-tray-series="6x4"
                  data-tray-material="alto_cromo_cr27"
                  data-tray-circuit="bombeo"
                  data-tray-source="skid_stratum1_calc"
                >
                  {isEs ? '+ Bandeja Tren Motriz' : '+ Add Drive Assembly to Tray'}
                </button>
              </div>

              <div data-core-tradein-widget="DAM005" data-lang={locale} class="smat-sdb-tradein-box">
                <div class="smat-sdb-tradein-title">
                  {isEs
                    ? 'CANJE POR REPARABILIDAD DE NÚCLEO DAM005 (-22% / -12% REMANUFACTURA H7)'
                    : 'SMAT DAM005 CORE TRADE-IN PROGRAM (-22% / -12% H7 REMANUFACTURING)'}
                </div>
                <div class="smat-sdb-tradein-grid">
                  <label class="smat-sdb-tradein-lbl">
                    <span>{isEs ? 'Estado de Carcasa Usada' : 'Used Housing Condition'}</span>
                    <select data-tradein-condition data-core-tradein-condition class="smat-sdb-tradein-sel">
                      <option value="h7_intact" selected>{isEs ? 'Carcasa Intacta Sin Fisuras (-22% • 0.78x)' : 'Intact Crack-Free Housing (-22% • 0.78x)'}</option>
                      <option value="minor_bearing_seizure">{isEs ? 'Roce de Rodamiento / Alojamiento Recuperable (-12% • 0.88x)' : 'Bearing Seizure / Recoverable Bore (-12% • 0.88x)'}</option>
                      <option value="cracked_housing">{isEs ? 'Carcasa Fisurada o Soldada (0% • 1.00x)' : 'Cracked or Welded Housing (0% • 1.00x)'}</option>
                    </select>
                  </label>
                  <label class="smat-sdb-tradein-chk">
                    <input type="checkbox" data-tradein-not-welded data-core-tradein-toggle checked />
                    <span>{isEs ? 'Alojamiento H7 Sin Soldadura (ISO IT6)' : 'Unwelded H7 Bearing Bore (ISO IT6)'}</span>
                  </label>
                </div>
                <div data-tradein-result data-core-tradein-badge class="smat-sdb-tradein-res">
                  {isEs ? 'Activo: -22% Crédito por Núcleo Usado (Factor 0.78x • RMA-CORE-DAM005-INTACT)' : 'Active: -22% Core Trade-In Credit (Factor 0.78x • RMA-CORE-DAM005-INTACT)'}
                </div>
                <div data-tradein-co2 data-core-tradein-note class="smat-sdb-tradein-note">
                  {isEs
                    ? 'Retorno en Almacén Central: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166 (35 kg CO₂e ahorrados)'
                    : 'Physical return at Central Warehouse: Mariano Salas #114, Col. Primer Presidente, Durango, Dgo. CP 34166 (35 kg CO₂e saved)'}
                </div>
              </div>

              <div class="skid-kinematics-calibrator__alert" data-kin-rubber-alert>
                <div>
                  <strong>{isEs ? 'ALERTA DE VELOCIDAD PERIFÉRICA:' : 'PERIPHERAL TIP SPEED ALERT:'}</strong>{' '}
                  {isEs
                    ? 'La velocidad periférica supera 24.5 m/s en Hule Natural (R55), provocando delaminación térmica por histéresis viscoelástica.'
                    : 'Peripheral tip speed exceeds 24.5 m/s in Natural Rubber (R55), causing viscoelastic hysteresis blistering.'}
                </div>
                <button type="button" class="btn btn-primary" data-kin-switch-a05>
                  {isEs ? 'Cambiar a Alto Cromo A05 (≥650 HB)' : 'Switch to High Chrome A05 (≥650 HB)'}
                </button>
              </div>
            </div>
          </details>
        )}

        {variant === 'bearing' && (
