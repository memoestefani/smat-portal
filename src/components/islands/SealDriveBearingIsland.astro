        const root = document.querySelector('[data-island-standalone="sealDrive"]');
        if (!root) return;
        const el = root as HTMLElement;
        const variant = el.dataset.variant || 'seal';
        const lang = el.dataset.lang === 'en' ? 'en' : 'es';
        if (variant === 'seal') {
          if (el.dataset.sealBound === 'true') return;
          el.dataset.sealBound = 'true';
          bindCanonicalSealBalanceCalculator(root, lang);
          bindAtomicPartTrayButtons(root);
        } else if (variant === 'skid') {
          initSkidKinematicsInspector(root, lang);
        } else {
