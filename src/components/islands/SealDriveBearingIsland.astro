---
/**
 * SealDriveBearingIsland.astro
 * ---------------------------------------------------------------------------
 * Isla Canónica Unificada de Sellado 02A/02B, Tren Motriz V-Belt y Soporte ISO 281
 * (`D3-V51` / `SLICE-V51-16`): Cero bifurcaciones duales, monta `<SealDriveBearingCore />`
 * exponiendo las 3 sub-estaciones de forma idéntica en rutas verticales y `/cotizar/`.
 */
import SealDriveBearingCore from '../cores/SealDriveBearingCore.astro';
import TechnicalDiagrams from '../TechnicalDiagrams.astro';
import SharePurchasing from '../SharePurchasing.astro';
import { getAtomicPartSpecs } from '../../scripts/workbenchBus.js';
import { DRIVE_ARRANGEMENT_CATALOG } from '../../scripts/slurryEngine.js';
import rolesData from '../../../data/roles.json';

interface Props {
  locale?: 'es' | 'en';
  variant?: 'seal' | 'skid' | 'bearing';
  mode?: 'standalone' | 'embedded';
}

const { locale = 'es', variant = 'seal', mode = 'standalone' } = Astro.props;
const isEs = locale === 'es';
const showVerticalShell = mode === 'standalone';
const quoteBase = isEs ? '/cotizar/' : '/en/quote/';

const allRoles = (rolesData.verticals || []).flatMap((v) => [...(v.capex || []), ...(v.opex || [])]);
const roleLookupId = variant === 'seal' ? 'sello' : (variant === 'skid' ? 'skid_bomba' : 'soporte');
const roleObj = allRoles.find((r) => r.role_id === roleLookupId);
const dc = roleObj?.decision_criteria;

const sealParts = variant === 'seal' ? [getAtomicPartSpecs('DAM028'), getAtomicPartSpecs('EAM028')].filter(Boolean) : [];
const driveArrangements = variant === 'skid' ? Object.values(DRIVE_ARRANGEMENT_CATALOG) : [];
const stratumSimId = variant === 'seal'
  ? 'stratum1-seal-sim'
  : (variant === 'skid' ? 'stratum1-skid-sim' : 'stratum1-bearing-inspector');
---

{showVerticalShell && (
  <div data-island-standalone="sealDrive" data-variant={variant} data-lang={locale}>
    <section class="page-hero smat-compact-hero">
      <div class="container">
        <a href={isEs ? '/bombeo/' : '/en/pumping/'} class="back-link">
          {isEs ? '← Volver a Bombas para Lodos' : '← Back to Slurry Pumps'}
        </a>
        <div class="smat-sdb-badge-wrap">
          <span class="badge badge-copper">
            {variant === 'seal'
              ? (isEs ? 'ESTACIÓN 02 · SELLADO CENTRÍFUGO Y PRENSAESTOPA' : 'STATION 02 · CENTRIFUGAL EXPELLER & STUFFING BOX')
              : variant === 'skid'
                ? (isEs ? 'EQUIPO COMPLETO • ARREGLOS CV / ZVZ / CRZ / DC' : 'COMPLETE PUMP • CV / ZVZ / CRZ / DC DRIVES')
                : (isEs ? 'ESTACIÓN 01 · BEARING ASSEMBLY / HOUSING' : 'STATION 01 · BEARING ASSEMBLY / HOUSING')}
          </span>
        </div>
        <h1>
          {variant === 'seal'
            ? (isEs ? 'Expulsor Centrífugo y Prensaestopa' : 'Centrifugal Expeller & Stuffing Box')
            : variant === 'skid'
              ? (isEs ? 'Bombas para Lodos — Calibrador Cinemático & Tren Motriz' : 'Slurry Pumps — V-Belt Kinematics & Drive Assembly')
              : 'Bearing Assembly / Housing'}
        </h1>
        <p class="smat-hero-sub">
          {variant === 'seal'
            ? (isEs
              ? 'Calibración en vivo de contrapresión Expeller (02A Seco) vs Agua de Prensaestopas (02B Húmedo), cinemática V-Belt y vida ISO 281 L₁₀ₘₕ.'
              : 'Live sealing pressure calibration (02A Dry Expeller vs 02B Flushed Stuffing Box), V-Belt kinematics and ISO 281 L₁₀ₘₕ bearing life.')
            : variant === 'skid'
              ? (isEs
                ? 'Calibre poleas V-Belt, velocidad periférica u₂, sellado centrífugo y vida ISO 281 L₁₀ₘₕ en un solo instrumento.'
                : 'Calibrate V-Belt sheave ratio, peripheral tip speed u₂, centrifugal sealing and ISO 281 L₁₀ₘₕ life in one unified instrument.')
              : (isEs
                ? 'Calibración en vivo de vida modificada ISO 281 L₁₀ₘₕ, bastidor recomendado, sellado e intercambio Core Trade-In DAM005 (-22% / -12%).'
                : 'Live ISO 281 L₁₀ₘₕ bearing life calibration, frame sizing, sealing and DAM005 Core Trade-In exchange (-22% / -12%).')}
        </p>
      </div>
    </section>

    <section class="section smat-stage-compact" id={variant === 'skid' ? 'skid-main-section' : undefined}>
      <div class="container">
        <div
          class="card smat-sdb-sim-card"
          id={stratumSimId}
          data-stratum-1-instrument
          data-seal-branch-comparator={variant === 'seal' ? '1' : undefined}
          data-skid-kinematics={variant === 'skid' ? '1' : undefined}
          data-bearing-inspector={variant === 'bearing' ? '1' : undefined}
        >
          <SealDriveBearingCore locale={locale} initialTab={variant} showVerticalActions={true} />

          {variant === 'seal' && (
            <div class="grid-2 smat-sdb-branch-grid">
              <div class="smat-sdb-branch-card">
                <span class="font-mono-tech smat-sdb-branch-ok">{isEs ? '[ESTACIÓN 02A — SELLADO SECO EXPELLER]' : '[STATION 02A — DRY EXPELLER SEAL]'}</span>
                <strong class="smat-sdb-card-title">{isEs ? 'Expulsor Centrífugo Seco (Cero Agua de Sello)' : 'Dry Centrifugal Expeller (Zero Gland Water)'}</strong>
                <p class="smat-sdb-branch-copy">
                  {isEs
                    ? 'Recomendado cuando P_s ≤ 18% de carga total H y velocidad fija o VFD ≥ 70%. Evita diluir el %Cw hacia hidrociclones y flotación.'
                    : 'Recommended when suction head P_s ≤ 18% of total head H and speed ≥ 70%. Prevents %Cw dilution feeding hydrocyclones and flotation.'}
                </p>
                <a href={`${quoteBase}?circuito=bombeo&equipo=kit_sellado&seal_branch=expeller_dry&estacion=S2#rfq`} data-card-fixed-params="seal_branch" class="btn btn-primary smat-sdb-branch-cta">
                  {isEs ? 'Configurar Estación 02A (Seco) →' : 'Configure Station 02A (Dry) →'}
                </a>
              </div>
              <div class="smat-sdb-branch-card">
                <span class="font-mono-tech smat-sdb-branch-wet">{isEs ? '[ESTACIÓN 02B — PRENSAESTOPAS HÚMEDO]' : '[STATION 02B — FLUSHED GLAND PACKING]'}</span>
                <strong class="smat-sdb-card-title">{isEs ? 'Prensaestopa Húmedo (Anillo Linterna)' : 'Wet Packed Stuffing Box (Lantern Ring)'}</strong>
                <p class="smat-sdb-branch-copy">
                  {isEs
                    ? 'Requerido en bombas en serie (etapa 2+), carga positiva de succión P_s > 18% H o VFD a baja velocidad.'
                    : 'Required in multi-stage pumps (stage 2+), high suction head P_s > 18% H, or low-speed VFD service.'}
                </p>
                <a href={`${quoteBase}?circuito=bombeo&equipo=kit_sellado&seal_branch=gland_water&estacion=S2#rfq`} data-card-fixed-params="seal_branch" class="btn btn-outline smat-sdb-branch-cta">
                  {isEs ? 'Configurar Estación 02B (Húmedo) →' : 'Configure Station 02B (Wet) →'}
                </a>
              </div>
            </div>
          )}
        </div>

        <TechnicalDiagrams diagram={variant === 'seal' ? 'expeller' : variant === 'skid' ? 'pump' : 'bearing'} lang={locale} />

        {variant === 'seal' && (
          <>
            <div class="grid-2 smat-sdb-two-col">
              <div>
                <h2>{isEs ? 'Por Qué Empleamos Expulsor y Prensaestopa (Sin Sello Mecánico)' : 'Why We Use Centrifugal Expellers & Stuffing Boxes (No Mechanical Seals)'}</h2>
                <p>
                  {isEs
                    ? 'En el bombeo de lodos minerales con sólidos abrasivos, los sellos mecánicos de caras planas se fracturan rápidamente. Nuestras bombas emplean expulsor centrífugo en seco o prensaestopa trenzado con camisa protegida.'
                    : 'In abrasive mineral slurry service, flat-face mechanical seals fail prematurely. Our pumps rely on dry centrifugal expellers or braided stuffing boxes over hardened sleeves.'}
                </p>
                <h3 class="smat-sdb-table-heading">{isEs ? 'Componentes del Conjunto de Sellado' : 'Sealing Assembly Components'}</h3>
                <div class="table-wrapper">
                  <table>
                    <tbody>
                      <tr><th>{isEs ? 'Expulsor Centrífugo' : 'Centrifugal Expeller'}</th><td>{isEs ? 'Alto Cromo o Hule; genera contrapresión dinámica' : 'High Chrome or Rubber; generates dynamic counter-pressure'}</td></tr>
                      <tr><th>{isEs ? 'Anillo y Prensaestopa' : 'Expeller Ring & Stuffing Box'}</th><td>{isEs ? 'Cámara para empaquetadura y anillo linterna' : 'Heavy casting housing packing & lantern ring'}</td></tr>
                      <tr><th>{isEs ? 'Camisa de Flecha' : 'Shaft Sleeve'}</th><td>{isEs ? 'Acero inoxidable endurecido / recubrimiento HVOF' : 'Hardened stainless steel / HVOF sleeve'}</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
              <div>
                {dc && (
                  <div class="card smat-sdb-criteria-card" data-testid="role-decision-criteria">
                    <span class="font-mono-tech smat-sdb-criteria-eyebrow">
                      {isEs ? '[CRITERIO DE DECISIÓN E INGENIERÍA — ESTACIÓN 02]' : '[ENGINEERING DECISION CRITERIA — STATION 02]'}
                    </span>
                    <p class="smat-sdb-criteria-line"><strong>{isEs ? 'Regla Metalúrgica:' : 'Metallurgical Rule:'}</strong> {isEs ? dc.metallurgy_rule_es : dc.metallurgy_rule_en}</p>
                    <p class="smat-sdb-criteria-line"><strong>{isEs ? 'Variables Críticas:' : 'Critical Variables:'}</strong> {isEs ? dc.required_slurry_vars_es : dc.required_slurry_vars_en}</p>
                    <p class="smat-sdb-criteria-risk"><strong>{isEs ? 'Riesgo Evitado:' : 'Avoided Risk:'}</strong> {isEs ? dc.risk_avoided_es : dc.risk_avoided_en}</p>
                  </div>
                )}
              </div>
            </div>

            <div class="smat-sdb-diagram-gap" data-testid="seal-atomic-parts">
              <h2>{isEs ? 'Refacciones Atómicas de Sellado (DAM028 / EAM028)' : 'Atomic Sealing Spares (DAM028 / EAM028)'}</h2>
              <div class="grid-2 smat-sdb-atomic-grid">
                {sealParts.map((sp) => (
                  <div class="card smat-sdb-atomic-card">
                    <div class="smat-sdb-atomic-head">
                      <span class="badge badge-copper">{sp.part_number} ({sp.smat_code})</span>
                      <span class="font-mono-tech smat-sdb-atomic-mass">{sp.weight_kg} kg • {sp.niosh_handling_mode}</span>
                    </div>
                    <strong class="smat-sdb-card-title">{isEs ? sp.name_es : sp.name_en}</strong>
                    <p class="smat-sdb-atomic-copy">{isEs ? sp.summary_es : sp.summary_en}</p>
                    <div class="smat-sdb-atomic-actions">
                      <a href={isEs ? `/catalogo/${sp.code}/` : `/en/catalog/${sp.code}/`} class="btn btn-outline">
                        {isEs ? `Ver Ficha ${sp.part_number} →` : `View ${sp.part_number} →`}
                      </a>
                      <button
                        type="button"
                        class="btn btn-outline btn-avenue-tray smat-sdb-btn-tall"
                        data-add-tray-sku="SMAT-PUMP-EXP-028"
                        data-tray-part-code={sp.part_number}
                        data-tray-title={isEs ? sp.name_es : sp.name_en}
                        data-tray-series={sp.pipe_size}
                        data-tray-material="A05"
                        data-tray-category="BOMBA_SLURRY"
                        data-tray-source="seal_atomic_card"
                      >
                        {isEs ? '+ Bandeja' : '+ Tray'}
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </>
        )}

        {variant === 'skid' && (
          <div id={isEs ? 'arreglos-transmision' : 'drive-arrangements'} class="smat-sdb-diagram-gap">
            <span id={isEs ? 'drive-arrangements' : 'arreglos-transmision'} aria-hidden="true"></span>
            <h2>{isEs ? 'Arreglos de Transmisión y Montaje (CV / ZVZ / CRZ / DC)' : 'Base Frame Drive Arrangements (CV / ZVZ / CRZ / DC)'}</h2>
            <TechnicalDiagrams diagram="drive_arrangements" lang={locale} />
            <div class="grid-2 smat-sdb-arr-grid" data-drive-links="transmision=CV transmision=ZVZ transmision=CRZ transmision=DC">
              {driveArrangements.map((arr) => (
                <div class="card">
                  <h3>{isEs ? arr.nameEs : arr.nameEn}</h3>
                  <p>{isEs ? arr.descriptionEs : arr.descriptionEn}</p>
                  <small class="smat-sdb-flood-meta" data-kin-flood>
                    {isEs ? 'Huella:' : 'Footprint:'} {arr.footprintFactor.toFixed(2)}× • {Boolean(arr.sumpFloodImmunity) ? (isEs ? 'Motor Elevado' : 'Elevated Motor') : (isEs ? 'Nivel de base' : 'Baseplate level')}
                  </small>
                  <a href={`${quoteBase}?equipo=skid_bomba&transmision=${arr.code}#rfq`} class="btn btn-primary" data-card-fixed-params="transmision">
                    {isEs ? `Cotizar Arreglo ${arr.code} →` : `Quote ${arr.code} Arrangement →`}
                  </a>
                </div>
              ))}
            </div>
            {dc && (
              <div class="card smat-sdb-criteria-card" data-testid="role-decision-criteria">
                <span class="font-mono-tech smat-sdb-criteria-eyebrow">{isEs ? '[CRITERIO DE DECISIÓN E INGENIERÍA]' : '[ENGINEERING DECISION CRITERIA]'}</span>
                <p class="smat-sdb-criteria-line"><strong>{isEs ? 'Regla Metalúrgica:' : 'Metallurgical Rule:'}</strong> {isEs ? dc.metallurgy_rule_es : dc.metallurgy_rule_en}</p>
                <p class="smat-sdb-criteria-line"><strong>{isEs ? 'Variables Críticas:' : 'Critical Variables:'}</strong> {isEs ? dc.required_slurry_vars_es : dc.required_slurry_vars_en}</p>
                <p class="smat-sdb-criteria-risk"><strong>{isEs ? 'Riesgo Evitado:' : 'Avoided Risk:'}</strong> {isEs ? dc.risk_avoided_es : dc.risk_avoided_en}</p>
              </div>
            )}
          </div>
        )}

        {variant === 'bearing' && (
          <div class="grid-2 smat-sdb-two-col">
            <div>
              <h2>{isEs ? 'Cartucho Completo Listo para Montaje Drop-In' : 'Complete Cartridge Unit Ready for Drop-In Mounting'}</h2>
              <p>
                {isEs
                  ? 'El Bearing Assembly / Housing integra cuerpo cilíndrico nodular, flecha maquinada SAE 4140, doble hilera de rodamientos cónicos y sellos laberinto.'
                  : 'The Bearing Assembly / Housing combines a ductile iron barrel, SAE 4140 shaft, back-to-back tapered rollers, and labyrinth seals.'}
              </p>
            </div>
            <div>
              {dc && (
                <div class="card smat-sdb-criteria-card" data-testid="role-decision-criteria">
                  <span class="font-mono-tech smat-sdb-criteria-eyebrow">{isEs ? '[CRITERIO DE DECISIÓN E INGENIERÍA — ESTACIÓN 01]' : '[ENGINEERING DECISION CRITERIA — STATION 01]'}</span>
                  <p class="smat-sdb-criteria-line"><strong>{isEs ? 'Regla Metalúrgica:' : 'Metallurgical Rule:'}</strong> {isEs ? dc.metallurgy_rule_es : dc.metallurgy_rule_en}</p>
                  <p class="smat-sdb-criteria-line"><strong>{isEs ? 'Variables Críticas:' : 'Critical Variables:'}</strong> {isEs ? dc.required_slurry_vars_es : dc.required_slurry_vars_en}</p>
                  <p class="smat-sdb-criteria-risk"><strong>{isEs ? 'Riesgo Evitado:' : 'Avoided Risk:'}</strong> {isEs ? dc.risk_avoided_es : dc.risk_avoided_en}</p>
                </div>
              )}
            </div>
          </div>
        )}

        <SharePurchasing
          roleTitle={variant === 'seal'
            ? (isEs ? 'Expulsor Centrífugo y Prensaestopa' : 'Centrifugal Expeller & Stuffing Box')
            : variant === 'skid'
              ? (isEs ? 'Bomba Centrífuga Horizontal para Lodos' : 'Horizontal Centrifugal Slurry Pump')
              : (isEs ? 'Bearing Assembly / Housing Completo' : 'Complete Bearing Assembly / Housing')}
          series={variant === 'bearing'
            ? (isEs ? 'Series 4x3 a 10x8' : '4x3 to 10x8 Series')
            : (isEs ? '1.5x1 a 14x12' : '1.5x1 to 14x12 Series')}
          metallurgy={variant === 'seal'
            ? (isEs ? 'Alto Cromo 27% (A05) y Acero Inoxidable' : '27% High Chrome (A05) & Stainless Steel')
            : variant === 'skid'
              ? (isEs ? 'Alto Cromo 27% (A05), Hule R55 y Poliuretano U01' : 'High Chrome A05, R55 Rubber & U01 Polyurethane')
              : (isEs ? 'Fundición Nodular, Flecha SAE 4140 y Rodamientos Cónicos' : 'Ductile Iron Housing, SAE 4140 Shaft & Tapered Bearings')}
          specs={variant === 'seal'
            ? (isEs ? 'Sellado centrífugo en seco y prensaestopa sin sello mecánico.' : 'Dry centrifugal expeller and braided-packing stuffing box (no mechanical seals).')
            : variant === 'skid'
              ? (isEs ? 'Bomba horizontal pesada con Bearing Assembly completo y expulsor centrífugo.' : 'Heavy-duty horizontal slurry pump with complete Bearing Assembly and dry expeller.')
              : (isEs ? 'Cartucho cilíndrico ensamblado con flecha y sellos laberinto ISO 281.' : 'Pre-assembled cartridge with machined shaft and ISO 281 labyrinth seals.')}
          roleId={variant === 'seal' ? 'kit_sellado' : variant === 'skid' ? 'skid_bomba' : 'kit_rodamientos'}
          circuit="bombeo"
          lang={locale}
        />
      </div>
    </section>

    <script>
      import { bindCanonicalSealBalanceCalculator } from '../../scripts/verticalCalculatorsAndLabelsBridge.js';
      import { bindAtomicPartTrayButtons } from '../../scripts/verticalStateAndCtaSyncBridge.js';
      import { initSkidKinematicsInspector, initBearingSupportInspector } from '../../scripts/verticalBidirectionalHydrationLens.js';
      import { bindDomainSchemaRoot, projectDomainOutputs, readAllCanonicalInputs } from '../../scripts/schemaRuntimeBinder.js';
      import { solveXdsmMultidisciplinaryDag } from '../../scripts/wizardXdsmDagSolver.js';

      function initSealDriveStandalone() {
        const root = document.querySelector('[data-island-standalone="sealDrive"]') as HTMLElement | null;
        if (!root) return;
        const lang = root.dataset.lang === 'en' ? 'en' : 'es';
        if (root.dataset.sdbAllBound !== '1') {
          root.dataset.sdbAllBound = '1';
          bindCanonicalSealBalanceCalculator(root, lang);
          initSkidKinematicsInspector(root, lang);
          initBearingSupportInspector(root, lang);
          bindAtomicPartTrayButtons(root);
          bindDomainSchemaRoot(root, ['sealDrive'], () => {
            const inputs = readAllCanonicalInputs(root);
            const dag = solveXdsmMultidisciplinaryDag(inputs);
            projectDomainOutputs(root, 'sealDrive', { ...(dag.sealBalanceEval || {}), ...(dag.driveEval || {}) }, lang);
          });
        }
      }

      initSealDriveStandalone();
      document.addEventListener('astro:page-load', initSealDriveStandalone);
    </script>
  </div>
)}

{!showVerticalShell && (
  <SealDriveBearingCore locale={locale} initialTab="skid" showVerticalActions={false} />
)}

<style>
  .back-link { color: #7c2d12; font-size: 0.88rem; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  .smat-sdb-badge-wrap { margin-top: 0.3rem; }
  .smat-sdb-sim-card { margin-bottom: 1.5rem; background: #f8fafc; border: 1.5px solid #cbd5e1; padding: clamp(0.7rem, 1.4vw, 1.1rem); }
  .sdb-subtabs { display: flex; flex-wrap: wrap; gap: 0.4rem; border-bottom: 1px solid #cbd5e1; padding-bottom: 0.5rem; }
  .sdb-tab-btn { border: 1px solid #cbd5e1; background: #ffffff; color: #0f172a; font-weight: 700; font-size: 0.78rem; padding: 0.45rem 0.8rem; border-radius: 6px; cursor: pointer; min-height: 44px; }
  .sdb-tab-btn.is-active { background: #0f172a; color: #ffffff; border-color: #0f172a; }
  .smat-sdb-status-ok { padding: 0.55rem 0.75rem; border-radius: 6px; background: #ecfdf5; border: 1px solid #059669; color: #064e3b; font-family: var(--smat-font-mono); font-size: 0.79rem; font-weight: 700; }
  .smat-sdb-kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.45rem; font-family: var(--smat-font-mono); font-size: 0.78rem; }
  .smat-sdb-kpi-card { background: #ffffff; padding: 0.45rem 0.65rem; border-radius: 6px; border: 1px solid #cbd5e1; }
  .smat-sdb-inputs-box { margin: 0.5rem 0 0.65rem; padding: 0.6rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.8rem; }
  .smat-sdb-field { display: flex; flex-direction: column; gap: 0.2rem; font-weight: 700; }
  .smat-sdb-ctrl { padding: 0.35rem; border: 1px solid #cbd5e1; border-radius: 6px; }
  .smat-sdb-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center; margin-bottom: 0.85rem; }
  .smat-sdb-btn-tall { min-height: 48px; display: inline-flex; align-items: center; }
  .smat-sdb-branch-grid { margin-top: 0.75rem; }
  .smat-sdb-branch-card { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 1rem; display: flex; flex-direction: column; }
  .smat-sdb-branch-ok { font-size: 0.72rem; font-weight: 800; color: #064e3b; }
  .smat-sdb-branch-wet { font-size: 0.72rem; font-weight: 800; color: #0c4a6e; }
  .smat-sdb-card-title { display: block; margin: 0.35rem 0; font-size: 0.98rem; font-weight: 800; color: var(--smat-text-primary); }
  .smat-sdb-branch-copy { font-size: 0.85rem; color: #334155; }
  .smat-sdb-branch-cta { margin-top: 0.5rem; }
  .skid-kinematics-calibrator__metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.6rem; margin-bottom: 0.75rem; }
  .skid-kinematics-calibrator__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.75rem; margin-bottom: 0.85rem; }
  .kin-field { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.78rem; font-weight: 700; color: #1c1917; }
  .kin-metric-card { background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.65rem; display: flex; flex-direction: column; gap: 0.2rem; }
  .kin-metric-card__kicker { font-family: var(--smat-font-mono, monospace); font-size: 0.66rem; font-weight: 800; color: #334155; }
  .kin-metric-card__val { font-size: 0.98rem; font-weight: 800; color: #1c1917; }
  .kin-metric-card__sub { font-size: 0.72rem; color: #334155; }
  .smat-sdb-bear-ok { background: #ecfdf5; border: 1px solid #059669; border-radius: 8px; padding: 0.5rem 0.65rem; }
