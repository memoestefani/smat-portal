---
import miningGroupsData from '../../data/mining_groups.json';
import companyData from '../../data/company.json';
import rolesData from '../../data/roles.json';
import atomicPartsData from '../../data/atomic_parts.json';
import { SLURRY_PRESETS, MECHANICAL_DIAGNOSTICS, calculateSlurryMetrics, calculateAltitudeCorrection } from '../scripts/slurryEngine.js';
import { SMAT_WORKBENCH_EVENT } from '../scripts/workbenchBus.js';

interface Props {
  lang?: 'es' | 'en';
  defaultRole?: string;
  defaultType?: 'capex' | 'opex';
}

const { lang = 'es', defaultRole = '', defaultType = 'opex' } = Astro.props;
const isEs = lang === 'es';
const miningGroupsJson = JSON.stringify(miningGroupsData.groups);
const atomicPartsJson = JSON.stringify(atomicPartsData);
const leadEndpointUrl = import.meta.env.PUBLIC_LEAD_INTAKE_URL || '';
const mechDiagnosticsList = Object.values(MECHANICAL_DIAGNOSTICS);
const defaultSimMetrics = calculateSlurryMetrics({ flowM3H: 180, solidsWeightPercent: 45, particleSizeD80Microns: 180, altitudeM: 2400 });
const defaultAltData = calculateAltitudeCorrection(2400);

const rolesCriteriaMap: Record<string, { rule_es: string; rule_en: string; risk_es: string; risk_en: string }> = {};
for (const v of rolesData.verticals) {
  for (const r of [...(v.capex || []), ...(v.opex || [])]) {
    if (r.decision_criteria) {
      rolesCriteriaMap[r.role_id] = {
        rule_es: r.decision_criteria.metallurgy_rule_es,
        rule_en: r.decision_criteria.metallurgy_rule_en,
        risk_es: r.decision_criteria.risk_avoided_es,
        risk_en: r.decision_criteria.risk_avoided_en,
      };
    }
  }
}
const rolesCriteriaJson = JSON.stringify(rolesCriteriaMap);
---

<div class="workbench-container" id="rfq" data-default-role={defaultRole} data-default-type={defaultType} data-mining-groups={miningGroupsJson} data-atomic-parts={atomicPartsJson} data-lead-endpoint={leadEndpointUrl} data-roles-criteria={rolesCriteriaJson} data-lang={lang} data-workbench-event={SMAT_WORKBENCH_EVENT} data-hq-city={companyData.address.city} data-presets={JSON.stringify(SLURRY_PRESETS)}>
  <!-- Cabecera de la Estación de Trabajo -->
  <div class="workbench-header">
    <div class="badge-row">
      <span class="badge badge-copper">
        <span class="live-dot"></span>
        {isEs ? 'CONSOLA DE INGENIERÍA Y ALMACÉN DURANGO' : 'DURANGO ENGINEERING & CENTRAL WAREHOUSE'}
      </span>
      <span class="badge badge-emerald">
        {isEs ? 'ATENCIÓN AL CLIENTE: LUN-VIE 08:00 A 18:00 CST' : 'CUSTOMER SERVICE: MON-FRI 08:00 TO 18:00 CST'}
      </span>
    </div>
    <h2 class="workbench-title">
      {isEs ? 'Solicitar Cotización de Equipos y Refacciones' : 'Request a Quotation for Equipment & Spares'}
    </h2>
    <p class="workbench-subtitle">
      {isEs 
        ? 'Seleccione las piezas, lotes de contacto húmedo (impulsores, cuellos y volutas), balanzas o equipos que requiere cotizar.'
        : 'Select the wear parts, wet-end lots (impellers, throatbushes, and volutes), pulp scales, or equipment you need to quote.'}
    </p>
  </div>

  <!-- Contenedor Dividido (Split-Screen Workbench) -->
  <div class="workbench-split">
    
    <!-- PANEL IZQUIERDO: Muelle de Instrumentación Slate (Decisión 1-C / GOLD-174) -->
    <div class="workbench-controls-panel console-bay">
      <div class="console-bay-banner">{isEs ? '1. PANEL DE ENTRADA • CONFIGURACIÓN DE EQUIPO' : '1. INPUT CONTROL PANEL • EQUIPMENT CONFIGURATION'}</div>
      
      <!-- Indicador de Red para Campamento en Sierra (Decisión 7-C / GOLD-180) -->
      <div id="offline-network-pill" class="offline-network-pill hidden" role="status">
        <span class="offline-dot"></span>
        <span>{isEs ? 'RED DE MINA: MODO DESCONECTADO • FICHA GUARDADA EN MEMORIA LOCAL' : 'MINE NETWORK: OFFLINE MODE • SPEC SAVED TO LOCAL STORAGE'}</span>
      </div>
      <div id="returning-user-chip" class="returning-user-chip hidden">
        <div class="user-chip-content">
          <span class="user-chip-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          <span class="user-chip-text" id="user-chip-text">{isEs ? 'Reconociendo a:' : 'Recognized user:'} <strong></strong></span>
        </div>
        <button type="button" class="user-chip-reset" id="user-chip-reset" title={isEs ? 'Cambiar de usuario' : 'Switch user'}>
          [{isEs ? 'Cambiar perfil' : 'Change profile'}]
        </button>
      </div>

      <!-- Sección 1: Selección de Equipo o Refacción (Decisión 1-C, 3-A) -->
      <div class="control-card">
        <div class="control-card-header">
          <span class="step-num">01</span>
          <h3>{isEs ? 'Selección de Equipo o Refacción' : 'Equipment or Replacement Part'}</h3>
        </div>

        <div class="intent-selector">
          <label class="intent-btn selected" id="btn-intent-opex">
            <input type="radio" name="intent" value="opex_paro" checked />
            <span class="intent-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            </span>
            <div class="intent-info">
              <strong>{isEs ? 'Refacciones de Desgaste / Paro' : 'Wear Spares / Plant Shutdown'}</strong>
              <small>{isEs ? 'Impulsores A05, volutas, rotores, estatores y telas' : 'A05 impellers, volutes, rotors, stators & cloths'}</small>
            </div>
          </label>

          <label class="intent-btn" id="btn-intent-capex">
            <input type="radio" name="intent" value="capex_proyecto" />
            <span class="intent-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/></svg>
            </span>
            <div class="intent-info">
              <strong>{isEs ? 'Equipos Completos / Circuito' : 'Complete Equipment / Circuit Package'}</strong>
              <small>{isEs ? 'Bombas en skid con motor, celdas o filtros prensa' : 'Skid pumps with motor, cells or filter presses'}</small>
            </div>
          </label>
        </div>

        <!-- Panel de Paquete de Circuito Completo (Decisión 3-C) -->
        <div id="package-bundle-panel" class="package-bundle-panel hidden">
          <div class="package-bundle-header">
            <strong>{isEs ? 'Seleccione las partidas requeridas para su circuito:' : 'Select required circuit equipment:'}</strong>
            <small>{isEs ? 'Puede marcar varias opciones para recibir una cotización consolidada.' : 'Check all items you need quoted as a consolidated package.'}</small>
          </div>
          <div class="package-bundle-grid">
            <label class="package-check-label">
              <input type="checkbox" name="pkg_item" value="bomba_skid" checked />
              <span>{isEs ? 'Bomba para Lodos en Skid con Motor' : 'Slurry Pump Skid with Motor'}</span>
            </label>
            <label class="package-check-label">
              <input type="checkbox" name="pkg_item" value="celdas_flotacion" />
              <span>{isEs ? 'Batería de Celdas de Flotación' : 'Flotation Cell Bank'}</span>
            </label>
            <label class="package-check-label">
              <input type="checkbox" name="pkg_item" value="filtro_prensa" />
              <span>{isEs ? 'Filtro Prensa para Jales Secos' : 'Filter Press for Dry Tailings'}</span>
            </label>
            <label class="package-check-label">
              <input type="checkbox" name="pkg_item" value="refacciones_inicio" />
              <span>{isEs ? 'Paquete Inicial de Refacciones A05' : 'Initial A05 Wear Spares Pack'}</span>
            </label>
          </div>
        </div>



        <!-- Selector de Circuito de Planta (Decisión 8-C: Arquitectura Multi-Equipo) -->
        <div class="circuit-selector-group">
          <label id="circuit-selector-label" class="circuit-selector-label">
            <strong>{isEs ? 'Circuito de Proceso en Planta:' : 'Plant Mineral Processing Circuit:'}</strong>
          </label>
          <div class="circuit-pills-grid" role="group" aria-labelledby="circuit-selector-label">
            <button type="button" class="circuit-pill active" data-circuit="bombeo" aria-pressed="true">
              [ {isEs ? 'BOMBEO DE PULPA' : 'SLURRY PUMPING'} ]
            </button>
            <button type="button" class="circuit-pill" data-circuit="flotacion" aria-pressed="false">
              [ {isEs ? 'FLOTACIÓN DE MINERALES' : 'MINERAL FLOTATION'} ]
            </button>
            <button type="button" class="circuit-pill" data-circuit="filtracion" aria-pressed="false">
              [ {isEs ? 'FILTRACIÓN / JALES SECOS' : 'FILTRATION / DRY TAILINGS'} ]
            </button>
            <button type="button" class="circuit-pill" data-circuit="control_procesos" aria-pressed="false">
              [ {isEs ? 'CONTROL DE PROCESOS' : 'PROCESS CONTROL'} ]
            </button>
          </div>
          <input type="hidden" name="process_circuit" id="wb-process-circuit" value="bombeo" />
        </div>

        <!-- PANEL CIRCUITO 1: BOMBEO DE PULPA (Kits Agnósticos y Síntomas de Desgaste) -->
        <div id="circuit-panel-bombeo" class="circuit-panel">
          <div class="circuit-context-banner">
            <span class="context-tag font-mono-tech">[PARÁMETROS DE BOMBEO]</span>
            <span>{isEs ? 'Selección exclusiva por línea de tubería y condición de desgaste en planta.' : 'Slurry pipeline diameter and plant wear condition parameters.'}</span>
          </div>

          <div class="form-group">
            <label for="wb-role"><strong>{isEs ? 'Lote de Contacto Húmedo o Equipo Requerido:' : 'Required Wet-End Lot or Equipment:'}</strong></label>
            <select id="wb-role" name="role_id" class="wb-select">
              <option value="kit_wet_end" selected>{isEs ? 'Lote de Contacto Húmedo (ej. 5 Impulsores + 5 Cuellos + 4 Volutas)' : 'Wet-End Lot (e.g. 5 Impellers + 5 Throatbushes + 4 Volutes)'}</option>
              <option value="kit_sellado">{isEs ? 'Expulsor Centrífugo y Prensaestopa (Sin Sello Mecánico)' : 'Centrifugal Expeller & Stuffing Box (No Mechanical Seal)'}</option>
              <option value="kit_rodamientos">{isEs ? 'Bearing Assembly / Housing Completo (Cartucho Ensamblado)' : 'Complete Bearing Assembly / Housing (Assembled Cartridge)'}</option>
              <option value="skid_bomba">{isEs ? 'Bomba Completa para Lodos' : 'Complete Slurry Pump'}</option>
              <option value="solo_impulsor">{isEs ? 'Solo Impulsor [Desglose asistido]' : 'Impeller Only [Assisted breakdown]'}</option>
              <option value="solo_voluta">{isEs ? 'Solo Voluta / Cuello [Desglose asistido]' : 'Volute / Throatbush Only [Assisted breakdown]'}</option>
              <option value="balanza_marcy">{isEs ? 'Balanza de Densidad de Pulpa (Tipo Marcy) — 1000 cm³ y 12 Diales' : 'Pulp Density Scale (Marcy Type) — 1000 cm³ & 12 Dials'}</option>
            </select>
          </div>

          <!-- Micro-Alerta Fiduciaria de Recirculación (Decisión 1-C) -->
          <div id="recirculation-alert-box" class="recirculation-alert-box hidden">
            <span class="recirc-icon font-mono-tech">[AVISO]</span>
            <p class="recirc-text">
              {isEs 
                ? 'Nota técnica fiduciaria: Montar un impulsor nuevo sobre una voluta con más de 30% de desgaste acelera la recirculación y reduce la vida útil en más del 40%. SMAT recomienda el Kit Extremo Húmedo para restaurar tolerancias hidráulicas en una sola intervención.' 
                : 'Technical fiduciary note: Installing a new impeller inside a volute with over 30% wear accelerates internal recirculation and cuts wear life by over 40%. SMAT recommends the Complete Wet-End Kit to restore hydraulic clearances in a single maintenance window.'}
            </p>
          </div>

          <!-- Selector de Tubería Nominal Agnóstica de Proceso (Decisión 2-C / Cero Fugas de Marco) -->
          <div class="form-group" style="margin-top: 0.75rem;">
            <label for="wb-pipe-size"><strong>{isEs ? 'Diámetro de Tubería de la Línea:' : 'Process Line Pipe Diameter:'}</strong></label>
            <select id="wb-pipe-size" name="pipe_size" class="wb-select">
              <option value="1.5x1">{isEs ? 'Tubería 1.5" a 2" (Línea Ligera / Muestreo / Rebose)' : '1.5" to 2" Piping (Light Slurry / Sampling / Sump)'}</option>
              <option value="3x2">{isEs ? 'Tubería 3" a 4" (Línea Intermedia / Flotación / Concentrados)' : '3" to 4" Piping (Medium Slurry / Concentrates / Flotation)'}</option>
              <option value="6x4" selected>{isEs ? 'Tubería 6" a 4" (Línea Principal de Proceso / Cabecera)' : '6" to 4" Piping (Main Process Slurry / Header)'}</option>
              <option value="8x6">{isEs ? 'Tubería 8" a 6" (Línea de Gran Capacidad / Relaves)' : '8" to 6" Piping (High-Capacity Slurry / Tailings)'}</option>
              <option value="10x8">{isEs ? 'Tubería 10" a 8" (Línea de Alto Caudal / Presa de Jales)' : '10" to 8" Piping (High Flow / Tailings Dam)'}</option>
            </select>
          </div>

          <!-- Píldoras Táctiles de Síntoma Clínico de Destrucción (Decisión 3-C / Cero Fugas de Aleación) -->
          <div class="form-group" style="margin-top: 0.75rem;">
            <label id="stress-chips-label"><strong>{isEs ? 'Condición de Operación / Síntoma de Desgaste en Planta:' : 'Operating Condition / Field Wear Symptom:'}</strong></label>
            <div class="stress-chips-grid" role="group" aria-labelledby="stress-chips-label">
              <button type="button" class="stress-chip chip-ghost" data-symptom="roca_dura" data-confirmed="false" aria-pressed="false">
                [ {isEs ? 'ROCA DURA Y GOLPETEO CONTINUO' : 'HARD ROCK & IMPACT'} ]
              </button>
              <button type="button" class="stress-chip" data-symptom="acido_quimica" data-confirmed="false" aria-pressed="false">
                [ {isEs ? 'AGUA ÁCIDA / ATAQUE QUÍMICO' : 'ACID SLURRY / CHEMICAL ATTACK'} ]
              </button>
              <button type="button" class="stress-chip" data-symptom="arena_fina" data-confirmed="false" aria-pressed="false">
                [ {isEs ? 'ARENA FINA Y CORTE A VELOCIDAD' : 'FINE SLURRY & HIGH VELOCITY'} ]
              </button>
              <button type="button" class="stress-chip" data-symptom="fuga_sello" data-confirmed="false" aria-pressed="false">
                [ {isEs ? 'FUGA CONSTANTE EN SELLO / INUNDACIÓN' : 'SEAL LEAKAGE / SUMP FLOOD'} ]
              </button>
              <button type="button" class="stress-chip" data-symptom="mixta_duda" data-confirmed="false" aria-pressed="false">
                [ {isEs ? 'CONDICIÓN MIXTA / PULPA COMPLEJA' : 'MIXED SLURRY / COMPLEX PULP'} ]
              </button>
            </div>
            <input type="hidden" name="stress_symptom" id="wb-stress-symptom" value="" />
          </div>
        </div>

        <!-- PANEL CIRCUITO 2: FLOTACIÓN DE MINERALES (Parámetros Exclusivos de Celda) -->
        <div id="circuit-panel-flotacion" class="circuit-panel hidden">
          <div class="circuit-context-banner">
            <span class="context-tag font-mono-tech">[PARÁMETROS DE FLOTACIÓN]</span>
            <span>{isEs ? 'Parámetros cinéticos exclusivos para celdas mecánicas y mecanismos de agitación.' : 'Flotation kinetic parameters for mechanical cells and agitator mechanisms.'}</span>
          </div>

          <div class="form-group">
            <label for="wb-role-flot"><strong>{isEs ? 'Equipo o Componente Requerido en Flotación:' : 'Required Flotation Equipment or Part:'}</strong></label>
            <select id="wb-role-flot" name="role_id_flot" class="wb-select">
              <option value="rotor_estator" selected>{isEs ? 'Mecanismo Rotor y Estator de Elastómero (Desgaste)' : 'Elastomer Rotor & Stator Mechanism (Wear Spares)'}</option>
              <option value="celda_flotacion">{isEs ? 'Mecanismo para Celda de Flotación Completa y Acondicionador' : 'Complete Flotation Cell Mechanism & Pulp Conditioner'}</option>
              <option value="bateria_celdas">{isEs ? 'Batería Modular de Celdas Rougher / Scavenger' : 'Rougher / Scavenger Modular Cell Bank'}</option>
              <option value="manto_difusor">{isEs ? 'Difusor de Fondo y Manto de Protección Antidesgaste' : 'Bottom Diffuser & Protective Wear Shroud'}</option>
            </select>
          </div>

          <div class="form-group" style="margin-top: 0.75rem;">
            <label for="wb-flot-capacity"><strong>{isEs ? 'Capacidad / Volumen de Celda de Flotación:' : 'Flotation Cell Volume / Capacity:'}</strong></label>
            <select id="wb-flot-capacity" name="flot_capacity" class="wb-select">
              <option value="50ft">{isEs ? 'Celda 50 ft³ (1.4 m³ — Banco Cleaner / Limpieza / Piloto)' : '50 ft³ Cell (1.4 m³ — Cleaner Bank / Pilot Plant)'}</option>
              <option value="100ft" selected>{isEs ? 'Celda 100 ft³ (2.8 m³ — Circuito Intermedio / Concentración)' : '100 ft³ Cell (2.8 m³ — Intermediate Concentration Circuit)'}</option>
              <option value="200ft">{isEs ? 'Celda 200 ft³ (5.7 m³ — Rougher Primario / Desbaste)' : '200 ft³ Cell (5.7 m³ — Primary Rougher Stage)'}</option>
              <option value="300ft">{isEs ? 'Celda 300 ft³ (8.5 m³ — Gran Capacidad / Scavenger)' : '300 ft³ Cell (8.5 m³ — High Capacity / Scavenger)'}</option>
            </select>
          </div>

          <div class="form-group" style="margin-top: 0.75rem;">
            <label id="flot-chips-label"><strong>{isEs ? 'Condición de Operación en Celda / Agitación:' : 'Cell Operating Condition / Agitation:'}</strong></label>
            <div class="flot-chips-grid" role="group" aria-labelledby="flot-chips-label">
              <button type="button" class="flot-chip chip-ghost" data-flot-cond="sulfuros_alta_agitacion" data-confirmed="false" aria-pressed="false">
                [ {isEs ? 'SULFUROS MASIVOS / ALTA VELOCIDAD DE AGITACIÓN' : 'MASSIVE SULFIDES & HIGH SHEAR'} ]
              </button>
              <button type="button" class="flot-chip" data-flot-cond="reactivos_ph_extremo" data-confirmed="false" aria-pressed="false">
                [ {isEs ? 'ATAQUE POR REACTIVOS / PH EXTREMO' : 'REAGENT ATTACK & EXTREME PH'} ]
              </button>
              <button type="button" class="flot-chip" data-flot-cond="espumado_intenso" data-confirmed="false" aria-pressed="false">
                [ {isEs ? 'ESPUMADO INTENSO / DESGASTE POR IMPACTO' : 'INTENSE FROTH & SLURRY IMPACT'} ]
              </button>
              <button type="button" class="flot-chip" data-flot-cond="vibracion_flecha" data-confirmed="false" aria-pressed="false">
                [ {isEs ? 'VIBRACIÓN EN FLECHA / CAMBIO PREVENTIVO' : 'SHAFT VIBRATION & PREVENTIVE OVERHAUL'} ]
              </button>
            </div>
            <input type="hidden" name="flot_condition" id="wb-flot-condition" value="" />
          </div>
        </div>

        <!-- PANEL CIRCUITO 3: FILTRACIÓN Y JALES SECOS (Parámetros Exclusivos de Prensa) -->
        <div id="circuit-panel-filtracion" class="circuit-panel hidden">
          <div class="circuit-context-banner">
            <span class="context-tag font-mono-tech">[PARÁMETROS DE FILTRACIÓN]</span>
            <span>{isEs ? 'Parámetros de deshidratación de jales secos y paquetes de placas filtrantes.' : 'Dry tailings dewatering parameters and filter plate packs.'}</span>
          </div>

          <div class="form-group">
            <label for="wb-role-filt"><strong>{isEs ? 'Equipo o Refacción Requerida en Filtración e Instrumentación:' : 'Required Filtration or Instrumentation Equipment:'}</strong></label>
            <select id="wb-role-filt" name="role_id_filt" class="wb-select">
              <option value="placas_telas" selected>{isEs ? 'Paquete de Placas de Polipropileno y Telas Filtrantes' : 'Polypropylene Plates & Filter Cloths Pack'}</option>
              <option value="filtro_prensa">{isEs ? 'Filtro Prensa Hidráulico Automático (16 bar)' : 'Automatic Hydraulic Filter Press (16 bar)'}</option>
              <option value="placas_membrana">{isEs ? 'Placas de Membrana para Exprimido a Alta Presión' : 'Membrane Squeeze Plates Pack'}</option>
              <option value="bomba_prensa">{isEs ? 'Bomba de Pulpa para Alimentación de Filtro Prensa' : 'Slurry Feed Pump for Filter Press'}</option>
              <option value="balanza_marcy">{isEs ? 'Balanza de Densidad de Pulpa (Tipo Marcy) — Recipiente 1000 cm³ y 12 Diales' : 'Pulp Density Scale (Marcy Type) — 1000 cm³ Container & 12 Dials'}</option>
            </select>
          </div>

          <div class="form-group" style="margin-top: 0.75rem;">
            <label for="wb-filt-capacity"><strong>{isEs ? 'Dimensión de Placa / Capacidad de Filtrado:' : 'Plate Dimension / Filtration Capacity:'}</strong></label>
            <select id="wb-filt-capacity" name="filt_capacity" class="wb-select">
              <option value="800">{isEs ? 'Placas 800 x 800 mm (Planta Piloto / Concentrados Preciosos)' : '800 x 800 mm Plates (Pilot Plant / Precious Concentrates)'}</option>
              <option value="1200">{isEs ? 'Placas 1200 x 1200 mm (Planta Media / Concentrados Bulk)' : '1200 x 1200 mm Plates (Mid-Size Plant / Bulk Concentrates)'}</option>
              <option value="1500" selected>{isEs ? 'Placas 1500 x 1500 mm (Alta Capacidad / Jales Secos 16 bar)' : '1500 x 1500 mm Plates (High Capacity / Dry Tailings 16 bar)'}</option>
              <option value="2000">{isEs ? 'Placas 2000 x 2000 mm (Mega-Filtración / Presas de Jales)' : '2000 x 2000 mm Plates (Mega-Filtration / Tailings Dams)'}</option>
            </select>
          </div>

          <div class="form-group" style="margin-top: 0.75rem;">
            <label id="filt-chips-label"><strong>{isEs ? 'Objetivo Operativo de Filtrado / Ciclo:' : 'Filtration Operational Target / Cycle:'}</strong></label>
            <div class="filt-chips-grid" role="group" aria-labelledby="filt-chips-label">
              <button type="button" class="filt-chip chip-ghost" data-filt-cond="jales_secos" data-confirmed="false" aria-pressed="false">
                [ {isEs ? 'JALES SECOS (<15% HUMEDAD RESIDUAL)' : 'DRY STACK TAILINGS (<15% MOISTURE)'} ]
              </button>
              <button type="button" class="filt-chip" data-filt-cond="recuperacion_agua" data-confirmed="false" aria-pressed="false">
                [ {isEs ? 'RECUPERACIÓN RÁPIDA DE AGUA DE PROCESO' : 'PROCESS WATER RECOVERY'} ]
              </button>
