              <div class="slider-label-row">
                <span>{isEs ? 'Claro Axial Frontal Impulsor–Throatbush (δ_frontal):' : 'Front Impeller–Throatbush Clearance (δ_frontal):'}</span>
                <strong class="slider-value pro-tabular-nums" id="wb-val-clearance">{defaultClearanceEval.frontClearanceMm.toFixed(2)} mm (Δη_v = -{defaultClearanceEval.volumetricEffLossPct}%)</strong>
              </div>
              <input type="range" id="wb-clearance-slider" data-testid="wb-clearance-slider" min="0.20" max="4.00" step="0.05" value="0.75" class="wb-slider" />
              <div class="clearance-kinematics-meta"><span id="metric-clearance-loss">{isEs ? defaultClearanceEval.wearRatioImpact554 : defaultClearanceEval.wearRatioImpact554En}</span> • <span>{isEs ? 'Pérdida margen Vc:' : 'Vc margin loss:'} <strong id="wb-clearance-vel-loss" data-testid="wb-clearance-vel-loss">-{defaultClearanceEval.pipeVelocityMarginLossPct ?? 1.2}%</strong></span></div>
              <div class="clearance-kinematics-meta" style="margin-top:0.25rem; font-size:0.72rem; color:#0c4a6e;"><span id="metric-structural-reason">{isEs ? defaultClearanceEval.structuralReasonEs : defaultClearanceEval.structuralReasonEn}</span></div>

              <div class="form-row" style="margin-top:0.65rem; display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:0.55rem;">
                <div>
                  <label for="wb-driver-pulley" style="font-size:0.72rem; font-weight:700; display:flex; justify-content:space-between;"><span>{isEs ? 'Polea Motriz:' : 'Driver Sheave:'}</span><strong id="wb-val-driver-pulley" class="font-mono-tech">220 mm</strong></label>
                  <input type="range" id="wb-driver-pulley" min="120" max="380" step="10" value="220" class="wb-slider" />
                </div>
                <div>
                  <label for="wb-driven-pulley" style="font-size:0.72rem; font-weight:700; display:flex; justify-content:space-between;"><span>{isEs ? 'Polea Conducida:' : 'Driven Sheave:'}</span><strong id="wb-val-driven-pulley" class="font-mono-tech">340 mm</strong></label>
                  <input type="range" id="wb-driven-pulley" min="160" max="560" step="10" value="340" class="wb-slider" />
                </div>
                <div>
                  <label for="wb-motor-rpm" style="font-size:0.72rem; font-weight:700;">{isEs ? 'Motor Eléctrico (RPM):' : 'Motor Speed (RPM):'}</label>
                  <select id="wb-motor-rpm" class="wb-select" style="min-height:34px; padding:0.25rem 0.5rem; font-size:0.76rem;">
                    <option value="1775" selected>1775 RPM (4P NEMA)</option>
                    <option value="1780">1780 RPM (4P IEC)</option>
                    <option value="1480">1480 RPM (50Hz/VFD)</option>
                    <option value="1180">1180 RPM (6 Polos)</option>
                  </select>
                </div>
                <div>
                  <label for="wb-shaft-power" style="font-size:0.72rem; font-weight:700;">{isEs ? 'Potencia Flecha (kW):' : 'Shaft Power (kW):'}</label>
                  <input type="number" id="wb-shaft-power" min="5" max="560" step="5" value="55" class="wb-input font-mono-tech" style="min-height:34px; padding:0.25rem 0.5rem; font-size:0.76rem;" />
                </div>
                <div>
                  <label for="wb-impeller-b2" style="font-size:0.72rem; font-weight:700;">{isEs ? 'Ancho Salida b₂ (mm):' : 'Exit Width b₂ (mm):'}</label>
                  <input type="number" id="wb-impeller-b2" data-wb-bind="b2_mm" min="20" max="120" step="2" value="48" class="wb-input font-mono-tech" style="min-height:34px; padding:0.25rem 0.5rem; font-size:0.76rem;" />
                </div>
                <div>
                  <label for="wb-bearing-c" style="font-size:0.72rem; font-weight:700;">{isEs ? 'Cap. Dinámica C (kN):' : 'Dynamic Cap. C (kN):'}</label>
                  <input type="number" id="wb-bearing-c" data-wb-bind="cap_c_kn" min="60" max="450" step="5" value="145" class="wb-input font-mono-tech" style="min-height:34px; padding:0.25rem 0.5rem; font-size:0.76rem;" />
                </div>
              </div>

              <div class="form-row" style="margin-top:0.55rem; display:grid; grid-template-columns:1fr; gap:0.4rem;">
                <div>
                  <label for="wb-assembly-sequence-test" style="font-size:0.72rem; font-weight:700;">{isEs ? 'Validador de Secuencia de Montaje (Estaciones 01–05):' : 'Assembly Sequence Validator (Stations 01–05):'}</label>
                  <select id="wb-assembly-sequence-test" class="wb-select" style="min-height:34px; padding:0.25rem 0.5rem; font-size:0.75rem;">
                    <option value="canonical" selected>{isEs ? 'Canónica: EST-01 ➔ EST-02 ➔ EST-03 ➔ EST-04 ➔ EST-05 (Sin colisión)' : 'Canonical: EST-01 ➔ EST-02 ➔ EST-03 ➔ EST-04 ➔ EST-05 (Zero collision)'}</option>
                    <option value="impeller_before_rear_liner">{isEs ? 'Simular Error A: Impulsor (EST-03) antes de Sello/FPL (EST-02)' : 'Simulate Error A: Impeller (EST-03) before Seal/FPL (EST-02)'}</option>
                    <option value="cover_before_throatbush">{isEs ? 'Simular Error B: Tapa Succión (EST-05) sin Throatbush (EST-04)' : 'Simulate Error B: Cover Plate (EST-05) without Throatbush (EST-04)'}</option>
                  </select>
                </div>
                <small id="metric-assembly-mass-seq" class="font-mono-tech" style="font-size:0.72rem; color:#0f172a;">{isEs ? `Masa total de rama: ${defaultClearanceEval.totalAssemblyMassKg} kg (${defaultClearanceEval.nioshHoistPartsCount} izajes NIOSH ≥23 kg) • Secuencia 01–05 válida` : `Total branch mass: ${defaultClearanceEval.totalAssemblyMassKg} kg (${defaultClearanceEval.nioshHoistPartsCount} NIOSH hoists ≥23 kg) • Sequence 01–05 valid`}</small>
              </div>

              <div id="wb-rubber-u2-lock" class="rubber-u2-lock-banner hidden">
                <strong id="wb-rubber-u2-text">{isEs ? 'ALERTA VISCOELÁSTICA: Hule Natural con velocidad periférica u₂ > 24.5 m/s sufre ampollamiento térmico (reversión de caucho).' : 'VISCOELASTIC ALERT: Natural Rubber at peripheral tip speed u₂ > 24.5 m/s suffers thermal blistering (reversion).'}</strong>
                <button type="button" id="wb-switch-cr27-btn" class="switch-cr27-btn">{isEs ? 'Cambiar a Alto Cromo Cr27% (≥650 HB) →' : 'Switch to High Chrome Cr27% (≥650 HB) →'}</button>
              </div>
            </div>

            <div class="sim-rationale-banner" id="metric-rationale">{isEs ? defaultSimMetrics.results.rationaleEs : defaultSimMetrics.results.rationaleEn}</div>

            <div class="flow-regime-bar-wrap">
              <span class="regime-label">{isEs ? 'Semáforo de Transporte Hidráulico (Durand):' : 'Hydraulic Transport Regime (Durand):'}</span>
              <div class="regime-status-bar" id="regime-status-bar">
                <span class="regime-pill safe" id="regime-pill"><span class="pulsing-dot pulsing-dot-green"></span>{isEs ? 'Régimen Seguro / Flujo Homogéneo (V > 1.25 Vc)' : 'Safe Regime / Homogeneous Flow (V > 1.25 Vc)'}</span>
                <small class="regime-detail" id="regime-detail">{isEs ? `Velocidad recomendada: >${defaultSimMetrics.results.recommendedPipeVelocityMs} m/s (Patm ${(defaultAltData as any).pAtmHeadMca} mca)` : `Recommended velocity: >${defaultSimMetrics.results.recommendedPipeVelocityMs} m/s (Patm ${(defaultAltData as any).pAtmHeadMca} mca)`}</small>
              </div>
            </div>

            <div class="mech-diagnostics-inline-box" id="mech-diagnostics-inline">
              <span class="regime-label">{isEs ? 'Guía Rápida de Síntomas Mecánicos y Correctivos:' : 'Quick Mechanical Symptom & Action Guide:'}</span>
              <div class="mech-diag-mini-grid">
                {mechDiagnosticsList.map((diag) => (
                  <div class="mech-diag-mini-item" data-diag-id={diag.id} data-diag-role={diag.recommendedRole}>
                    <strong>{isEs ? diag.symptomEs : diag.symptomEn}</strong>
                    <small>{isEs ? diag.actionEs : diag.actionEn}</small>
                  </div>
                ))}
              </div>
            </div>

            <div class="tco-integrated-card" id="tco-accordion">
              <div class="tco-integrated-header">
                <span class="tco-integrated-badge font-mono-tech"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>{isEs ? 'ANÁLISIS DE COSTO DE PARO Y AHORRO EN TURNO' : 'SHUTDOWN COST & SHIFT SAVINGS ANALYSIS'}</span>
                <h4 class="tco-integrated-title">{isEs ? 'Horas de Molienda Protegidas vs Paro No Programado' : 'Protected Milling Hours vs Unscheduled Shutdown'}</h4>
              </div>
              <div class="tco-body">
                <div class="form-group" style="margin-bottom: 0.75rem;">
                  <div class="slider-label-row"><span>{isEs ? 'Horas Estimadas de Paro Evitadas con Stock Local:' : 'Estimated Downtime Hours Prevented with Local Stock:'}</span><strong class="slider-value pro-tabular-nums" id="val-downtime">4 hrs</strong></div>
                  <input type="range" id="slider-downtime" min="1" max="24" step="1" value="4" class="wb-slider" />
                </div>
                <div class="tco-output-box">
                  <div class="tco-metric-row"><span>{isEs ? 'Mineral / Sólidos en Riesgo por Paro:' : 'Ore / Solids at Risk per Downtime Event:'}</span><strong class="tco-metric-val pro-tabular-nums" id="tco-tonnage-val">~475 ton</strong></div>
                  <div class="tco-alloy-row">
                    <span class="tco-alloy-label">{isEs ? 'Comparativa de Frecuencia de Mantenimiento:' : 'Maintenance Frequency Comparison:'}</span>
                    <div class="tco-alloy-toggle-wrap" id="tco-alloy-toggle">
                      <button type="button" class="tco-alloy-btn active" id="tco-alloy-a05" data-alloy="A05">High Chrome A05 (>650 HB)</button>
                      <button type="button" class="tco-alloy-btn" id="tco-alloy-std" data-alloy="STD">{isEs ? 'Fundición Convencional' : 'Standard Iron'}</button>
                    </div>
                    <div class="tco-savings-note" id="tco-savings-box">
                      <span id="tco-savings-val"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>{isEs ? 'Aleación A05 (>650 HB) proyecta ~2,400 hrs de vida útil, evitando hasta ~7 paros al año frente a fundición estándar.' : 'A05 Alloy (>650 HB) projects ~2,400 hrs wear life, avoiding up to ~7 unscheduled shutdowns/yr vs standard iron.'}</span>
                    </div>
                  </div>
                  <small class="tco-note">{isEs ? 'Cálculo de caudal y concentración de sólidos. Contar con refaccionamiento verificado en Durango evita paros de línea y pérdidas en molienda.' : 'Slurry flow and solids concentration calculation. Having verified spares in Durango prevents line shutdowns and milling losses.'}</small>
                </div>
              </div>
            </div>
          </div>
        </details>
      </div>

      <!-- Sección 3: Identificación del Solicitante y Despacho (Acordeón Nativo <details>) -->
      <div class="control-card contact-card-priority" data-wb-step-panel="3">
        <details class="step3-dispatch-accordion" id="wb-step3-accordion" data-testid="wb-step3-accordion">
          <summary class="control-card-header" style="cursor: pointer; list-style: none;">
            <span class="step-num">03</span>
            <h3>{isEs ? 'Identificación del Solicitante y Despacho' : 'Requester Identification & Logistics'}</h3>
          </summary>

          <div class="form-row">
            <div class="form-group col-half">
              <label for="wb-name"><strong>{isEs ? 'Nombre del Solicitante / Ingeniero:' : 'Requester / Engineer Name:'} *</strong></label>
              <input type="text" id="wb-name" name="contact_name" class="wb-input" required placeholder={isEs ? 'Ej. Ing. J. Pérez / Residente' : 'e.g. Lead Process Engineer'} />
            </div>
            <div class="form-group col-half">
              <label for="wb-company"><strong>{isEs ? 'Mina o Empresa:' : 'Mine or Company:'} *</strong></label>
              <input type="text" id="wb-company" name="company_name" class="wb-input" required placeholder={isEs ? 'Ej. Unidad Minera / Compañía' : 'e.g. Mining Operation / Company'} />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-half">
              <label for="wb-phone"><strong>{isEs ? 'Teléfono / WhatsApp Directo:' : 'Direct Phone / WhatsApp:'} *</strong></label>
              <input type="tel" id="wb-phone" name="phone_number" class="wb-input" required placeholder={isEs ? '(618) 810-4408' : '+1 (555) 012-3456'} />
            </div>
            <div class="form-group col-half">
              <label for="wb-email"><strong>{isEs ? 'Correo Corporativo:' : 'Corporate Email:'} *</strong></label>
              <input type="email" id="wb-email" name="email_address" class="wb-input" required placeholder={isEs ? 'ejemplo@unidadminera.com' : 'procurement@miningco.com'} />
              <div id="mining-group-hint" class="mining-group-hint hidden">
                <span class="hint-label"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline-block; vertical-align:middle; margin-right:4px;"><rect width="16" height="20" x="4" y="2" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>{isEs ? 'Grupo Detectado:' : 'Detected Group:'} <strong id="hint-group-name"></strong></span>
                <div class="unit-chips" id="unit-chips-container"></div>
                <div id="unit-pulp-profile-badge" class="unit-pulp-profile-badge hidden"></div>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="wb-destination"><strong>{isEs ? 'Modalidad de Entrega / Despacho:' : 'Delivery / Logistics Mode:'}</strong></label>
            <select id="wb-destination" name="destination" class="wb-select">
              <option value="Retiro en Almacén Central Durango (Coordinación con Folio)" selected>{isEs ? 'Retiro en Almacén Durango (Coordinación con Folio)' : 'Durango Central Warehouse Pickup (Folio Scheduled)'}</option>
              <option value="Envío por fletera consolidada nacional (Ocurre en destino)">{isEs ? 'Envío por Fletera Consolidada (Ocurre en su ciudad)' : 'Consolidated National Freight Carrier (Ocurre Terminal)'}</option>
              <option value="Flete dedicado directo o enlace multimodal marítimo a penínsulas">{isEs ? 'Flete Directo a Mina / Enlace Marítimo' : 'Dedicated Direct Freight to Mine / Maritime Link'}</option>
            </select>
          </div>

          <div class="form-group" style="margin-top: 0.75rem;">
            <label><strong>{isEs ? 'Canal de Respuesta Preferido:' : 'Preferred Response Channel:'}</strong></label>
            <div class="segmented-control" id="wb-channel-selector" role="radiogroup" aria-label={isEs ? 'Canal de respuesta preferido' : 'Preferred response channel'}>
              <label class="segment-btn active" id="btn-chan-wa">
                <input type="radio" name="channel_pref" value="whatsapp" checked />
                <span class="segment-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></span>
                <span class="segment-label">WhatsApp</span>
              </label>
              <label class="segment-btn" id="btn-chan-call">
                <input type="radio" name="channel_pref" value="llamada" />
                <span class="segment-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
                <span class="segment-label">{isEs ? 'Llamada' : 'Phone'}</span>
              </label>
              <label class="segment-btn" id="btn-chan-mail">
                <input type="radio" name="channel_pref" value="correo" />
                <span class="segment-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
                <span class="segment-label">{isEs ? 'Correo PDF' : 'Email PDF'}</span>
              </label>
            </div>
          </div>

          <input type="text" name="website" id="wb-website" tabindex="-1" autocomplete="off" style="position: absolute; left: -9999px; opacity: 0;" aria-hidden="true" />
        </details>
      </div>
    </div>

    <LiveEngineeringDossier lang={lang} defaultKinematics={defaultKinematics} defaultPartSpecs={defaultPartSpecs} />
  </div>
</div>

<script>
  import { initQuoteWizardController } from '../scripts/quoteWizardController.js';
  initQuoteWizardController();
</script>
