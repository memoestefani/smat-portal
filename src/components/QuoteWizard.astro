    // Generador de Código de Configuración Inteligente SMAT (Blindfold Comercial Estricto)
    function buildSmatCode(arg1, arg2, arg3, arg4) {
      var circuit = 'bombeo';
      var roleVal = '';
      var sizeVal = '';
      var conditionVal = '';

      if (arg1 === 'bombeo' || arg1 === 'flotacion' || arg1 === 'filtracion' || arg1 === 'control_procesos') {
        circuit = arg1;
        roleVal = String(arg2 || '').toLowerCase();
        sizeVal = String(arg3 || '').toLowerCase();
        conditionVal = String(arg4 || '').toLowerCase();
      } else {
        roleVal = String(arg1 || '').toLowerCase();
        var detailsStr = String(arg2 || '').toUpperCase();
        if (roleVal.includes('marcy') || roleVal.includes('balanza') || roleVal.includes('batch') || roleVal.includes('tamiz') || roleVal.includes('tamices')) {
          circuit = 'control_procesos';
        } else if (roleVal.includes('celda') || roleVal.includes('flotacion') || roleVal.includes('rotor')) {
          circuit = 'flotacion';
          sizeVal = detailsStr.includes('50') ? '50ft' : (detailsStr.includes('200') ? '200ft' : (detailsStr.includes('300') ? '300ft' : '100ft'));
        } else if (roleVal.includes('filtro') || roleVal.includes('prensa') || roleVal.includes('placa')) {
          circuit = 'filtracion';
          sizeVal = detailsStr.includes('800') ? '800' : (detailsStr.includes('1200') ? '1200' : (detailsStr.includes('2000') ? '2000' : '1500'));
        } else {
          circuit = 'bombeo';
          if (detailsStr.includes('1.5') || detailsStr.includes('2X1.5')) sizeVal = '1.5x1';
          else if (detailsStr.includes('4X3') || detailsStr.includes('3X2')) sizeVal = '3x2';
          else if (detailsStr.includes('8X6')) sizeVal = '8x6';
          else if (detailsStr.includes('10X8')) sizeVal = '10x8';
          else sizeVal = '6x4';
        }
      }

      if (circuit === 'control_procesos') {
        if (roleVal.includes('batch')) return 'SMAT-CTRL-BATCH-LAB';
        if (roleVal.includes('tamiz') || roleVal.includes('tamices') || roleVal.includes('sieve')) return 'SMAT-CTRL-SIEVE-ASTM';
        return 'SMAT-CTRL-MARCY-1000';
      }

      if (circuit === 'flotacion') {
        var capTag = (sizeVal || '100ft').toUpperCase();
        if (!capTag.includes('FT')) capTag += 'FT';
        if (roleVal === 'celda_flotacion') return 'SMAT-FLOT-' + capTag + '-CELL';
        if (roleVal === 'bateria_celdas') return 'SMAT-FLOT-' + capTag + '-BANK';
        if (roleVal === 'manto_difusor') return 'SMAT-FLOT-' + capTag + '-SHROUD';
        return 'SMAT-FLOT-' + capTag + '-MECH';
      }

      if (circuit === 'filtracion') {
        var pTag = sizeVal || '1500';
        if (roleVal === 'filtro_prensa') return 'SMAT-FILT-' + pTag + '-PRESS';
        if (roleVal === 'placas_membrana') return 'SMAT-FILT-' + pTag + '-MEMBR';
        if (roleVal === 'bomba_prensa') return 'SMAT-FILT-' + pTag + '-PUMP';
        return 'SMAT-FILT-' + pTag + '-CLOTH';
      }

      var pipeTag = (sizeVal || '6x4').toUpperCase().replace(/[^0-9X]/g, '');
      if (!pipeTag) pipeTag = '6X4';
      if (roleVal === 'kit_sellado' || roleVal === 'sello') return 'SMAT-SEAL-' + pipeTag + '-EXP';
      if (roleVal === 'kit_rodamientos' || roleVal === 'soporte') return 'SMAT-BEAR-' + pipeTag + '-ASSY';
      if (roleVal === 'skid_bomba') return 'SMAT-SKID-' + pipeTag + '-STD';
      if (roleVal === 'solo_impulsor' || roleVal === 'impulsor') return 'SMAT-PUMP-' + pipeTag + '-IMP';
      if (roleVal === 'solo_voluta' || roleVal === 'revestimientos') return 'SMAT-PUMP-' + pipeTag + '-VOL';
      return 'SMAT-PUMP-' + pipeTag + '-WETKIT';
    }

    // Catálogo de Piezas Atómicas Universales (D3147..E4083) y Estado de Métricas
    var atomicPartsList = [];
    try {
      var rawAtomic = container?.getAttribute('data-atomic-parts');
      if (rawAtomic) atomicPartsList = JSON.parse(rawAtomic);
