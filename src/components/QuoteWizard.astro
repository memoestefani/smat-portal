---
import miningGroupsData from '../../data/mining_groups.json';
import companyData from '../../data/company.json';
import rolesData from '../../data/roles.json';
import atomicPartsData from '../../data/atomic_parts.json';
import '../styles/workbench.css';
import LiveEngineeringDossier from './LiveEngineeringDossier.astro';
import WizardCircuitCalculators from './WizardCircuitCalculators.astro';
import ProcessControlIsland from './islands/ProcessControlIsland.astro';
import PumpingHydraulicsCore from './cores/PumpingHydraulicsCore.astro';
import TribologyAlloyIsland from './islands/TribologyAlloyIsland.astro';
import JrpReorderCore from './cores/JrpReorderCore.astro';
import { buildRolesCriteriaMap } from '../scripts/i18nDomainLabels.js';
import { sanitizePublicAtomicPartSpecs } from '../scripts/vendorPassportAndTradeInController.js';
import { SLURRY_PRESETS, calculateDriveAndBearingKinematics } from '../scripts/slurryEngine.js';
import { SMAT_WORKBENCH_EVENT, getAtomicPartSpecs, formatNioshErgonomicStatus } from '../scripts/workbenchBus.js';

interface Props { lang?: 'es' | 'en'; defaultRole?: string; defaultType?: 'capex' | 'opex'; }
interface RoleCriteriaEntry { rule_es?: string; rule_en?: string; risk_es?: string; risk_en?: string; vars_es?: string; vars_en?: string; series?: string; }

const { lang = 'es', defaultRole = '', defaultType = 'opex' } = Astro.props;
const isEs = lang === 'es';
const miningGroupsJson = JSON.stringify(miningGroupsData.groups);
const atomicPartsJson = JSON.stringify(sanitizePublicAtomicPartSpecs(atomicPartsData));
const leadEndpointUrl = import.meta.env.PUBLIC_LEAD_INTAKE_URL || '';
const defaultKinematics = calculateDriveAndBearingKinematics({ arrangementCode: 'CV', motorRpm: 1775, driverPulleyMm: 220, drivenPulleyMm: 340, motorPowerKw: 55, impellerDiameterMm: 381 });
const defaultPartSpecs = getAtomicPartSpecs('kit_wet_end', '6x4');
const defaultNioshEval = formatNioshErgonomicStatus(defaultPartSpecs, isEs ? 'es' : 'en');
const rolesCriteriaMap: Record<string, RoleCriteriaEntry> = buildRolesCriteriaMap(rolesData);
const rolesCriteriaJson = JSON.stringify(rolesCriteriaMap);
---

<div class="workbench-container" id="rfq" data-default-role={defaultRole} data-default-type={defaultType} data-mining-groups={miningGroupsJson} data-atomic-parts={atomicPartsJson} data-lead-endpoint={leadEndpointUrl} data-roles-criteria={rolesCriteriaJson} data-lang={lang} data-workbench-event={SMAT_WORKBENCH_EVENT} data-hq-city={companyData.address.city} data-presets={JSON.stringify(SLURRY_PRESETS)}>
  <section class="workbench-header">
    <div class="badge-row">
      <span class="badge badge-copper"><span class="live-dot"></span>{isEs ? 'CONSOLA DE INGENIERÍA Y ALMACÉN DURANGO' : 'DURANGO ENGINEERING & CENTRAL WAREHOUSE'}</span>
      <span class="badge badge-emerald">{isEs ? 'ATENCIÓN AL CLIENTE: LUN-VIE 08:00 A 18:00 CST' : 'CUSTOMER SERVICE: MON-FRI 08:00 TO 18:00 CST'}</span>
    </div>
    <h1 class="workbench-title">{isEs ? 'Solicitar Cotización de Equipos y Refacciones' : 'Request a Quotation for Equipment & Spares'}</h1>
    <p class="workbench-subtitle">
      {isEs
        ? 'Seleccione las piezas, lotes de contacto húmedo (impulsores, cuellos y volutas), balanzas o equipos que requiere cotizar.'
        : 'Select the wear parts, wet-end lots (impellers, throatbushes, and volutes), pulp scales, or equipment you need to quote.'}
    </p>
  </section>

  <div class="workbench-split">
    <div class="workbench-controls-panel console-bay">
      <div class="console-bay-banner">{isEs ? '1. PANEL DE ENTRADA • CONFIGURACIÓN DE EQUIPO' : '1. INPUT CONTROL PANEL • EQUIPMENT CONFIGURATION'}</div>

      <div id="offline-network-pill" class="offline-network-pill hidden" role="status">
        <span class="offline-dot"></span>
        <span>{isEs ? 'RED DE MINA: MODO DESCONECTADO • FICHA GUARDADA EN MEMORIA LOCAL' : 'MINE NETWORK: OFFLINE MODE • SPEC SAVED TO LOCAL STORAGE'}</span>
      </div>
      <div id="returning-user-chip" class="returning-user-chip hidden">
        <div class="user-chip-content">
          <span class="user-chip-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
          <span class="user-chip-text" id="user-chip-text">{isEs ? 'Reconociendo a:' : 'Recognized user:'} <strong></strong></span>
        </div>
        <button type="button" class="user-chip-reset" id="user-chip-reset" title={isEs ? 'Cambiar de usuario' : 'Switch user'}>[{isEs ? 'Cambiar perfil' : 'Change profile'}]</button>
      </div>

      <!-- PASO 01: Selección de Circuito, Pieza o Refacción -->
      <section class="control-card" id="stage-diagnostic" data-testid="stage-diagnostic" data-stage="stage-diagnostic" data-fsm-state="stage-diagnostic" data-wb-step-panel="1">
        <div class="control-card-header">
          <span class="step-num">01</span>
          <h3>{isEs ? 'Selección de Circuito, Equipo o Refacción' : 'Circuit, Equipment or Replacement Part'}</h3>
        </div>

        <div class="circuit-selector-group qw-gap-bottom" id="wb-step1-xor-circuit-bar">
          <label id="circuit-selector-label" class="circuit-selector-label"><strong>{isEs ? 'Circuito de Proceso en Planta:' : 'Plant Mineral Processing Circuit:'}</strong></label>
          <div class="circuit-pills-grid" role="group" aria-labelledby="circuit-selector-label">
            <button type="button" class="circuit-pill active" data-circuit="bombeo" aria-pressed="true">{isEs ? 'Bombeo de Pulpa' : 'Slurry Pumping'}</button>
            <button type="button" class="circuit-pill" data-circuit="clasificacion" aria-pressed="false">{isEs ? 'Clasificación / Ciclones' : 'Classification / Cyclones'}</button>
            <button type="button" class="circuit-pill" data-circuit="flotacion" aria-pressed="false">{isEs ? 'Flotación de Minerales' : 'Mineral Flotation'}</button>
            <button type="button" class="circuit-pill" data-circuit="filtracion" aria-pressed="false">{isEs ? 'Filtración / Jales Secos' : 'Filtration / Dry Tailings'}</button>
            <button type="button" class="circuit-pill" data-circuit="control_procesos" aria-pressed="false">{isEs ? 'Control de Procesos' : 'Process Control'}</button>
          </div>
          <input type="hidden" name="process_circuit" id="wb-process-circuit" value="bombeo" />
        </div>

        <div id="circuit-panel-bombeo" class="circuit-panel">
          <div class="form-group">
            <label for="wb-role"><strong>{isEs ? 'Lote de Contacto Húmedo o Equipo Requerido:' : 'Required Wet-End Lot or Equipment:'}</strong></label>
            <select id="wb-role" name="role_id" class="wb-select">
              <option value="kit_wet_end" selected>{isEs ? 'Lote de Contacto Húmedo (5 Impulsores + 5 Cuellos + 4 Volutas)' : 'Wet-End Lot (5 Impellers + 5 Throatbushes + 4 Volutes)'}</option>
              <option value="kit_sellado">{isEs ? 'Expulsor Centrífugo y Prensaestopa (Sin Sello Mecánico)' : 'Centrifugal Expeller & Stuffing Box (No Mechanical Seal)'}</option>
              <option value="kit_rodamientos">{isEs ? 'Bearing Assembly / Housing Completo (Cartucho)' : 'Complete Bearing Assembly / Housing (Cartridge)'}</option>
              <option value="skid_bomba">{isEs ? 'Bomba Completa para Lodos' : 'Complete Slurry Pump'}</option>
              <option value="solo_impulsor">{isEs ? 'Solo Impulsor [Desglose asistido]' : 'Impeller Only [Assisted breakdown]'}</option>
              <option value="solo_voluta">{isEs ? 'Solo Voluta / Cuello [Desglose asistido]' : 'Volute / Throatbush Only [Assisted breakdown]'}</option>
              <option value="hidrociclon_apex_vortex">{isEs ? 'Hidrociclones D4"–D26", Ápex SiC y Vortex Finder' : 'D4"–D26" Hydrocyclones, SiC Apex & Vortex Finder'}</option>
              <option value="malla_criba_poliuretano">{isEs ? 'Mallas Modulares de Poliuretano (30×30 cm / 1×2 m)' : 'Modular Polyurethane Screen Panels (30×30 cm / 1×2 m)'}</option>
              <option value="balanza_marcy">{isEs ? 'Balanza de Densidad de Pulpa (Tipo Marcy) — 1000 cm³ y 12 Diales' : 'Pulp Density Scale (Marcy Type) — 1000 cm³ & 12 Dials'}</option>
            </select>
          </div>
          <div id="recirculation-alert-box" class="recirculation-alert-box hidden">
            <span class="recirc-icon font-mono-tech">[AVISO]</span>
            <p class="recirc-text">
              {isEs
                ? 'Nota técnica fiduciaria: Montar un impulsor nuevo sobre una voluta con más de 30% de desgaste acelera la recirculación. SMAT recomienda el Kit Extremo Húmedo 5-5-4.'
                : 'Technical note: Installing a new impeller inside a worn volute accelerates internal recirculation. SMAT recommends the Complete 5-5-4 Wet-End Kit.'}
            </p>
          </div>
          <div class="form-group qw-pipe-group" data-domain-root="pumping">
            <label for="wb-pipe-size"><strong>{isEs ? 'Diámetro de Tubería de la Línea:' : 'Process Line Pipe Diameter:'}</strong></label>
            <select id="wb-pipe-size" name="pipe_size" class="wb-select" data-wb-bind="pipe_size" data-schema-input="pumping.pipeSeries">
              <option value="1.5x1">{isEs ? 'Serie 1.5"x1" (D=40 mm — Muestreo)' : '1.5"x1" Series (D=40 mm — Sampling)'}</option>
              <option value="2x1.5">{isEs ? 'Serie 2"x1.5" (D=50 mm — Reactivos)' : '2"x1.5" Series (D=50 mm — Reagents)'}</option>
              <option value="3x2">{isEs ? 'Serie 3"x2" (D=80 mm — Concentrados)' : '3"x2" Series (D=80 mm — Concentrates)'}</option>
              <option value="4x3">{isEs ? 'Serie 4"x3" (D=100 mm — Remolienda)' : '4"x3" Series (D=100 mm — Regrind)'}</option>
              <option value="6x4" selected>{isEs ? 'Serie 6"x4" (D=150 mm — Línea Principal)' : '6"x4" Series (D=150 mm — Main Header)'}</option>
              <option value="8x6">{isEs ? 'Serie 8"x6" (D=200 mm — Relaves)' : '8"x6" Series (D=200 mm — Tailings)'}</option>
              <option value="10x8">{isEs ? 'Serie 10"x8" (D=250 mm — Ciclones)' : '10"x8" Series (D=250 mm — Cyclones)'}</option>
              <option value="12x10">{isEs ? 'Serie 12"x10" (D=300 mm — Descarga Molino)' : '12"x10" Series (D=300 mm — Mill Discharge)'}</option>
              <option value="14x12">{isEs ? 'Serie 14"x12" (D=350 mm — Mega-Concentradora)' : '14"x12" Series (D=350 mm — Mega-Concentrator)'}</option>
            </select>
            <small id="val-pipe-mm" class="font-mono-tech qw-pipe-hint">{isEs ? 'Diámetro interno hidráulico (D): 150 mm (Serie 6x4)' : 'Internal hydraulic diameter (D): 150 mm (6x4 Series)'}</small>
          </div>
        </div>

        <div id="circuit-panel-flotacion" class="circuit-panel hidden qw-top-gap">
          <div class="form-group">
            <label for="wb-role-flot"><strong>{isEs ? 'Equipo o Componente en Flotación:' : 'Required Flotation Equipment or Part:'}</strong></label>
            <select id="wb-role-flot" name="role_id_flot" class="wb-select">
              <option value="rotor_estator" selected>{isEs ? 'Mecanismo Rotor y Estator de Elastómero (Desgaste)' : 'Elastomer Rotor & Stator Mechanism (Wear Spares)'}</option>
              <option value="celda_flotacion">{isEs ? 'Mecanismo para Celda Completa y Acondicionador' : 'Complete Flotation Cell Mechanism & Conditioner'}</option>
              <option value="bateria_celdas">{isEs ? 'Batería Modular Rougher / Scavenger' : 'Rougher / Scavenger Modular Cell Bank'}</option>
              <option value="manto_difusor">{isEs ? 'Difusor de Fondo y Manto de Protección' : 'Bottom Diffuser & Protective Wear Shroud'}</option>
            </select>
          </div>
          <div class="form-group qw-top-gap">
            <label for="wb-flot-capacity"><strong>{isEs ? 'Capacidad / Volumen de Celda:' : 'Flotation Cell Volume / Capacity:'}</strong></label>
            <select id="wb-flot-capacity" name="flot_capacity" class="wb-select">
              <option value="50ft">{isEs ? 'Celda 50 ft³ (1.4 m³ — Limpieza / Piloto)' : '50 ft³ Cell (1.4 m³ — Cleaner / Pilot)'}</option>
              <option value="100ft" selected>{isEs ? 'Celda 100 ft³ (2.8 m³ — Circuito Intermedio)' : '100 ft³ Cell (2.8 m³ — Intermediate)'}</option>
              <option value="200ft">{isEs ? 'Celda 200 ft³ (5.7 m³ — Rougher Primario)' : '200 ft³ Cell (5.7 m³ — Primary Rougher)'}</option>
              <option value="300ft">{isEs ? 'Celda 300 ft³ (8.5 m³ — Gran Capacidad)' : '300 ft³ Cell (8.5 m³ — High Capacity)'}</option>
            </select>
          </div>
        </div>

        <div id="circuit-panel-filtracion" class="circuit-panel hidden qw-top-gap">
          <div class="form-group">
            <label for="wb-role-filt"><strong>{isEs ? 'Equipo en Filtración e Instrumentación:' : 'Required Filtration or Instrument:'}</strong></label>
            <select id="wb-role-filt" name="role_id_filt" class="wb-select">
              <option value="placas_telas" selected>{isEs ? 'Paquete de Placas de Polipropileno y Telas' : 'Polypropylene Plates & Filter Cloths'}</option>
              <option value="filtro_prensa">{isEs ? 'Filtro Prensa Hidráulico (16 bar)' : 'Automatic Filter Press (16 bar)'}</option>
              <option value="placas_membrana">{isEs ? 'Placas de Membrana Alta Presión' : 'High-Pressure Membrane Plates'}</option>
              <option value="bomba_prensa">{isEs ? 'Bomba de Alimentación a Filtro Prensa' : 'Filter Press Slurry Feed Pump'}</option>
              <option value="balanza_marcy">{isEs ? 'Balanza de Densidad Marcy (1000 cm³)' : 'Marcy Pulp Density Scale (1000 cm³)'}</option>
            </select>
          </div>
          <div class="form-group qw-top-gap">
            <label for="wb-filt-capacity"><strong>{isEs ? 'Dimensión de Placa:' : 'Plate Dimension:'}</strong></label>
            <select id="wb-filt-capacity" name="filt_capacity" class="wb-select">
              <option value="800">{isEs ? 'Placas 800 x 800 mm (Piloto)' : '800 x 800 mm Plates (Pilot)'}</option>
              <option value="1200">{isEs ? 'Placas 1200 x 1200 mm (Concentrados)' : '1200 x 1200 mm Plates (Concentrates)'}</option>
              <option value="1500" selected>{isEs ? 'Placas 1500 x 1500 mm (Jales Secos 16 bar)' : '1500 x 1500 mm Plates (Dry Tailings 16 bar)'}</option>
              <option value="2000">{isEs ? 'Placas 2000 x 2000 mm (Mega-Filtración)' : '2000 x 2000 mm Plates (Mega-Filtration)'}</option>
            </select>
          </div>
        </div>

        <!-- Ficha Física de Pieza Atómica -->
        <div id="wb-atomic-part-card" data-testid="wb-atomic-part-card" class="atomic-part-spec-card qw-card-gap">
          <div class="atomic-part-spec-header">
            <span class="atomic-part-spec-tag font-mono-tech" id="wb-part-station-tag">{defaultPartSpecs.station_number} • {defaultPartSpecs.code}</span>
            <span class="atomic-part-niosh-badge" id="wb-part-niosh-badge">{isEs ? `Peso: ${defaultPartSpecs.weight_kg} kg • ${defaultNioshEval.badgeEs}` : `Weight: ${defaultPartSpecs.weight_kg} kg • ${defaultNioshEval.badgeEn}`}</span>
          </div>
          <div class="atomic-part-spec-grid">
            <div><small>{isEs ? 'Geometría Hidráulica:' : 'Hydraulic Geometry:'}</small> <strong id="wb-part-geom-val">ØD₂ {defaultPartSpecs.impeller_diameter_mm} mm • {defaultPartSpecs.vanes} {isEs ? 'álabes' : 'vanes'} • Paso {defaultPartSpecs.max_particle_mm} mm</strong></div>
            <div><small>{isEs ? 'Secuencia de Montaje:' : 'Assembly Sequence:'}</small> <strong id="wb-part-order-val">{defaultPartSpecs.assembly_order} ({isEs ? 'Lote' : 'Kit'} {defaultPartSpecs.wet_end_kit_ratio})</strong></div>
            <div><small>{isEs ? 'Dureza Certificada:' : 'Certified Hardness:'}</small> <strong id="wb-part-hardness-val">{defaultPartSpecs.hardness}</strong></div>
            <div><small>{isEs ? 'Garantía Dimensional:' : 'Fit Guarantee:'}</small> <strong id="wb-part-fit-val">{isEs ? defaultPartSpecs.fit_guarantee_es : defaultPartSpecs.fit_guarantee_en}</strong></div>
            <div><small>{isEs ? 'Planeación Preventiva en Planta:' : 'Preventive Plant Cycle:'}</small> <strong id="wb-part-reorder-window-val" data-testid="wb-part-reorder-window-val">{isEs ? (defaultPartSpecs.dispatchSlaLabelEs || 'Ciclo sugerido: cada 90 días • Despacho Durango') : (defaultPartSpecs.dispatchSlaLabelEn || 'Suggested cycle: every 90 days • Durango Dispatch')}</strong></div>
          </div>
        </div>

        <details class="wb-progressive-drawer smat-mt-sm" id="wb-circuit-calculators-drawer">
          <summary class="wb-progressive-summary">
            <span>{isEs ? 'Calibrador físico y condiciones del circuito activo' : 'Active Circuit Physics Calibrator & Operating Conditions'}</span>
            <span>▾</span>
          </summary>
          <div class="smat-mt-sm">
            <details id="wb-mining-preset-details" class="wb-progressive-drawer qw-preset-disclosure">
              <summary class="wb-progressive-summary"><span>{isEs ? '+ Pre-calibrar Pulpa por Unidad Minera (44 minas)' : '+ Pre-calibrate District Slurry (44 mines)'}</span><span class="wb-step1-more-arrow">▾</span></summary>
              <div id="wb-mining-preset-bar" class="mining-preset-step1-bar qw-preset-bar">
                <div class="qw-preset-grid">
                  <div><label for="wb-mining-group-select" class="qw-mini-label">{isEs ? 'Grupo Minero / Operador (Opcional):' : 'Mining Group / Operator (Optional):'}</label><select id="wb-mining-group-select" class="wb-select qw-compact-select"><option value="">{isEs ? `— Seleccionar grupo (${miningGroupsData.total_groups}) —` : `— Select group (${miningGroupsData.total_groups}) —`}</option>{miningGroupsData.groups.map((grp) => (<option value={grp.id}>{grp.name}</option>))}</select></div>
                  <div><label for="wb-mining-unit-select" class="qw-mini-label">{isEs ? 'Unidad Minera y Perfil de Pulpa (44 minas):' : 'Mining Unit & Pulp Profile (44 mines):'}</label><select id="wb-mining-unit-select" class="wb-select qw-compact-select"><option value="">{isEs ? '— Pre-cargar perfil de pulpa —' : '— Load mine slurry profile —'}</option>{miningGroupsData.groups.flatMap((grp) => (grp.units || []).map((u) => (<option value={`${grp.id}::${u.name}`} data-group-id={grp.id} data-group-name={grp.name} data-unit-name={u.name} data-pulp-profile={u.pulp_profile || ''}>{grp.name} — {u.name}</option>)))}</select></div>
                </div>
                <div class="qw-preset-footer"><div id="wb-step1-pulp-profile-badge" class="unit-pulp-profile-badge hidden qw-pulp-badge"></div><button type="button" id="btn-apply-mining-preset" data-testid="btn-apply-mining-preset" class="assist-pill-btn qw-preset-btn">{isEs ? 'Pre-calibrar Pulpa del Distrito →' : 'Pre-calibrate District Slurry →'}</button></div>
                <div id="wb-mining-preset-telemetry" data-mining-preset-telemetry class="qw-mining-telemetry hidden"></div>
              </div>
            </details>
            <div class="form-group qw-top-gap">
              <label id="flot-chips-label"><strong>{isEs ? 'Condición de Operación en Celda:' : 'Cell Operating Condition:'}</strong></label>
              <div class="flot-chips-grid" role="group" aria-labelledby="flot-chips-label">
                <button type="button" class="flot-chip chip-ghost" data-flot-cond="sulfuros_alta_agitacion" data-confirmed="false" aria-pressed="false">{isEs ? 'Sulfuros y alta agitación' : 'Sulfides & high shear'}</button>
                <button type="button" class="flot-chip" data-flot-cond="reactivos_ph_extremo" data-confirmed="false" aria-pressed="false">{isEs ? 'Reactivos / pH extremo' : 'Reagents / extreme pH'}</button>
                <button type="button" class="flot-chip" data-flot-cond="espumado_intenso" data-confirmed="false" aria-pressed="false">{isEs ? 'Espumado intenso' : 'Intense froth'}</button>
                <button type="button" class="flot-chip" data-flot-cond="vibracion_flecha" data-confirmed="false" aria-pressed="false">{isEs ? 'Vibración en flecha' : 'Shaft vibration'}</button>
              </div>
              <input type="hidden" name="flot_condition" id="wb-flot-condition" value="" />
            </div>
            <div class="form-group qw-top-gap">
              <label id="filt-chips-label"><strong>{isEs ? 'Objetivo Operativo:' : 'Filtration Target:'}</strong></label>
              <div class="filt-chips-grid" role="group" aria-labelledby="filt-chips-label">
                <button type="button" class="filt-chip chip-ghost" data-filt-cond="jales_secos" data-confirmed="false" aria-pressed="false">{isEs ? 'Jales secos (<15% humedad)' : 'Dry stack (<15% moisture)'}</button>
                <button type="button" class="filt-chip" data-filt-cond="recuperacion_agua" data-confirmed="false" aria-pressed="false">{isEs ? 'Recuperación de agua' : 'Water recovery'}</button>
                <button type="button" class="filt-chip" data-filt-cond="colmatacion_telas" data-confirmed="false" aria-pressed="false">{isEs ? 'Colmatación / telas' : 'Blinding / cloths'}</button>
                <button type="button" class="filt-chip" data-filt-cond="alta_presion_16bar" data-confirmed="false" aria-pressed="false">{isEs ? 'Alta presión (16 bar)' : 'High pressure (16 bar)'}</button>
              </div>
              <input type="hidden" name="filt_condition" id="wb-filt-condition" value="" />
            </div>
            <ProcessControlIsland locale={lang} mode="embedded" />
            <WizardCircuitCalculators lang={lang} />
            <details class="wb-progressive-drawer" id="wb-jrp-planner-drawer">
              <summary class="wb-progressive-summary">
                <span>{isEs ? 'Planificador preventivo de reorden (3 etapas)' : 'Preventive reorder planner (3 stages)'}</span>
                <span class="wb-step1-more-arrow">▾</span>
              </summary>
              <JrpReorderCore lang={lang} mode="wizard" showTradeIn={false} showPrimaryTrayBtn={false} showPairBtn={false} />
            </details>
            <details class="wb-progressive-drawer" id="wb-symptom-context-details" data-domain-root="pumping">
              <summary class="wb-progressive-summary">
                <span>{isEs ? '+ Condición de Operación / Síntoma de Desgaste en Planta (5 condiciones)' : '+ Operating Condition / Field Wear Symptom (5 conditions)'}</span>
                <span class="wb-step1-more-arrow">▾</span>
              </summary>
              <div class="wb-progressive-body">
                <div class="form-group">
                  <label id="stress-chips-label"><strong>{isEs ? 'Condición de Operación / Síntoma en Planta:' : 'Operating Condition / Field Wear Symptom:'}</strong></label>
                  <div class="stress-chips-grid" role="group" aria-labelledby="stress-chips-label">
                    <button type="button" class="stress-chip chip-ghost" data-symptom="roca_dura" data-confirmed="false" aria-pressed="false">{isEs ? 'Roca dura y golpeteo' : 'Hard rock & impact'}</button>
                    <button type="button" class="stress-chip" data-symptom="acido_quimica" data-confirmed="false" aria-pressed="false">{isEs ? 'Agua ácida / química' : 'Acid / chemical slurry'}</button>
                    <button type="button" class="stress-chip" data-symptom="arena_fina" data-confirmed="false" aria-pressed="false">{isEs ? 'Arena fina / velocidad' : 'Fine sand / high speed'}</button>
                    <button type="button" class="stress-chip" data-symptom="fuga_sello" data-confirmed="false" aria-pressed="false">{isEs ? 'Fuga constante en sello' : 'Seal leakage'}</button>
                    <button type="button" class="stress-chip" data-symptom="mixta_duda" data-confirmed="false" aria-pressed="false">{isEs ? 'Pulpa mixta / compleja' : 'Mixed complex pulp'}</button>
                  </div>
                  <input type="hidden" name="stress_symptom" id="wb-stress-symptom" data-schema-input="pumping.stressSymptom" value="roca_dura" />
                </div>
              </div>
            </details>
            <details class="wb-progressive-drawer" id="wb-engineering-config-details">
              <summary class="wb-progressive-summary">
                <span id="wb-engineering-config-summary-text">{isEs ? '+ Alcance (Refacciones / CAPEX), Sellado Est. 02 y Cédula Metrológica' : '+ Scope (Spares / CAPEX), St. 02 Sealing & Metrology Schedule'}</span>
                <span class="wb-step1-more-arrow">▾</span>
              </summary>
              <div class="wb-progressive-body">
                <div class="intent-selector">
                  <label class="intent-btn selected" id="btn-intent-opex">
                    <input type="radio" name="intent" value="opex_paro" checked />
                    <span class="intent-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
                    <div class="intent-info"><strong>{isEs ? 'Refacciones de Desgaste / Paro' : 'Wear Spares / Plant Shutdown'}</strong><small>{isEs ? 'Impulsores A05, volutas, rotores y telas' : 'A05 impellers, volutes, rotors & cloths'}</small></div>
                  </label>
                  <label class="intent-btn" id="btn-intent-capex">
                    <input type="radio" name="intent" value="capex_proyecto" />
                    <span class="intent-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/></svg></span>
                    <div class="intent-info"><strong>{isEs ? 'Equipos Completos / Circuito' : 'Complete Equipment / Circuit Package'}</strong><small>{isEs ? 'Bombas con motor, celdas o filtros prensa' : 'Pumps with motor, flotation cells or presses'}</small></div>
                  </label>
                </div>
                <div id="package-bundle-panel" class="package-bundle-panel hidden">
                  <div class="package-bundle-header"><strong>{isEs ? 'Seleccione las partidas del circuito:' : 'Select required circuit equipment:'}</strong></div>
                  <div class="package-bundle-grid">
                    <label class="package-check-label"><input type="checkbox" name="pkg_item" value="bomba_skid" checked /><span>{isEs ? 'Bomba sobre Base con Motor' : 'Base-Mounted Pump w/ Motor'}</span></label>
                    <label class="package-check-label"><input type="checkbox" name="pkg_item" value="celdas_flotacion" /><span>{isEs ? 'Batería de Celdas de Flotación' : 'Flotation Cell Bank'}</span></label>
                    <label class="package-check-label"><input type="checkbox" name="pkg_item" value="filtro_prensa" /><span>{isEs ? 'Filtro Prensa Jales Secos' : 'Dry Tailings Filter Press'}</span></label>
                    <label class="package-check-label"><input type="checkbox" name="pkg_item" value="refacciones_inicio" /><span>{isEs ? 'Paquete Inicial A05' : 'Initial A05 Spares'}</span></label>
                  </div>
                </div>
                <div id="wb-pump-only-engineering-controls" data-only-circuit="bombeo" class="qw-top-gap">
                  <label for="wb-seal-branch"><strong>{isEs ? 'Rama de Sellado de Eje (Estación 02):' : 'Shaft Sealing Branch (Station 02):'}</strong></label>
                  <select id="wb-seal-branch" name="seal_branch" class="wb-select" data-wb-bind="seal_branch">
                    <option value="expeller_dry" selected>{isEs ? 'Est. 02A — Expulsor Centrífugo Seco (Sin agua de sello)' : 'St. 02A — Dry Centrifugal Expeller (Zero gland water)'}</option>
                    <option value="gland_water">{isEs ? 'Est. 02B — Prensaestopa Húmedo (Anillo Linterna)' : 'St. 02B — Wet Gland Packing (Lantern Ring)'}</option>
                  </select>
                </div>
                <div id="wb-metrology-bridge-card" data-testid="wb-metrology-bridge-card" class="metrology-bridge-card hidden">
                  <div class="metrology-bridge-header">
                    <span class="metrology-bridge-tag font-mono-tech">[{isEs ? 'CÉDULA METROLÓGICA DE LABORATORIO' : 'LAB METROLOGY SCHEDULE'}]</span>
                    <button type="button" id="wb-apply-metrology-btn" class="metrology-apply-btn">{isEs ? 'Pre-calibrar Hidráulica con Cédula →' : 'Pre-calibrate Hydraulics from Lab Spec →'}</button>
                  </div>
                  <p id="wb-metrology-bridge-text" class="metrology-bridge-text">Ss=2.80 | Cw=40% | Sm=1.346 kg/L | M_min=201 g | P80=106 µm (#140, n=1.12)</p>
                </div>
              </div>
            </details>
            <div class="wb-step1-secondary-wrap" data-domain-root="erpExport">
              <details class="wb-progressive-drawer wb-step1-more-drawer" id="wb-smart-paste-details">
                <summary class="wb-step1-more-summary" id="wb-step1-more-drawer">
                  <span>{isEs ? '+ Tag de Planta, Folio Interno, Flexómetro 1:1 o Código SMAT' : '+ Plant Tag, Internal Folio, 1:1 Tape Measure or SMAT Code'}</span>
                  <span class="wb-step1-more-arrow">▾</span>
                </summary>
                <div class="wb-step1-more-body qw-top-gap">
                  <div class="form-group"><label for="wb-details"><strong>{isEs ? 'Tag de Planta / Ubicación de Línea:' : 'Plant Tag / Line Location:'}</strong></label><input type="text" id="wb-details" name="spec_details" class="wb-input" placeholder={isEs ? 'Ej. Bomba #2 / Tag B-201' : 'e.g. Header Pump #2 / Tag B-201'} /></div>
                  <div class="assist-pills-bar" role="group" aria-label={isEs ? 'Herramientas de identificación' : 'Identification tools'}>
                    <span class="assist-pills-label font-mono-tech">{isEs ? 'ASISTENCIA:' : 'ASSIST:'}</span>
                    <button type="button" class="assist-pill-btn" data-assist-target="worn-piece-details" aria-expanded="false">{isEs ? 'Flexómetro 1:1' : '1:1 Tape'}</button>
                    <button type="button" class="assist-pill-btn" data-assist-target="smat-decoder-details" aria-expanded="false">{isEs ? 'Código SMAT' : 'SMAT Code'}</button>
                    <button type="button" class="assist-pill-btn" data-assist-target="custom-equip-details" aria-expanded="false">{isEs ? 'Equipo Especial' : 'Custom Spec'}</button>
                  </div>
                  <details class="worn-piece-details" id="worn-piece-details">
                    <summary class="worn-piece-summary"><span>{isEs ? 'Cotejo 1:1 con Flexómetro o Foto' : '1:1 Tape Measure Check or Photo'}</span><span class="worn-arrow">▾</span></summary>
                    <div class="worn-piece-body">
                      <div class="photo-upload-row" id="photo-upload-row"><label class="photo-btn"><span>{isEs ? 'Adjuntar foto' : 'Attach photo'}</span><input type="file" id="wb-photo-input" accept="image/*" class="file-input-hidden" /></label><span id="photo-status" class="photo-status-text"></span></div>
                      <div class="form-row"><div class="form-group col-half"><label for="wb-dim-dia"><strong>{isEs ? 'Ø Exterior (mm):' : 'Outer Ø (mm):'}</strong></label><input type="text" id="wb-dim-dia" name="dim_outer_dia" class="wb-input font-mono-tech" placeholder="370 mm" /></div><div class="form-group col-half"><label for="wb-dim-bore"><strong>{isEs ? 'Barreno (mm):' : 'Shaft Bore (mm):'}</strong></label><input type="text" id="wb-dim-bore" name="dim_shaft_bore" class="wb-input font-mono-tech" placeholder="65 mm" /></div></div>
                    </div>
                  </details>
                  <div class="form-group qw-top-gap"><label for="wb-client-ref"><strong>{isEs ? 'Folio de Requisición / Orden de Mantenimiento:' : 'Requisition Folio / Work Order:'}</strong></label><input type="text" id="wb-client-ref" name="client_reference" data-schema-input="erpExport.placa_ref" class="wb-input" placeholder={isEs ? 'Ej. REQ-2026-084' : 'e.g. REQ-2026-084'} /></div>
                  <details class="smat-decoder-details" id="smat-decoder-details">
                    <summary class="smat-decoder-summary"><span>{isEs ? 'Cargar Código SMAT Previo' : 'Load Previous SMAT Code'}</span><span class="decoder-arrow">▾</span></summary>
                    <div class="smat-decoder-bar" id="smat-decoder-bar"><div class="decoder-input-group"><input type="text" id="wb-code-decoder-input" class="decoder-input" placeholder="SMAT-PUMP-6X4-WETKIT" /><button type="button" class="btn-decoder-load" id="wb-code-decode-btn">{isEs ? 'Cargar' : 'Load'}</button></div><small class="decoder-status" id="decoder-status"></small></div>
                  </details>
                  <details class="custom-equip-details" id="custom-equip-details">
                    <summary class="custom-equip-summary"><span>+ {isEs ? 'Equipo fuera de catálogo' : 'Non-catalog custom equipment'}</span><span class="custom-arrow">▾</span></summary>
                    <div class="custom-equip-body"><div class="form-row"><div class="form-group col-half"><label for="custom-equip-type"><strong>{isEs ? 'Equipo:' : 'Equipment:'}</strong></label><input type="text" id="custom-equip-type" class="wb-input" /></div><div class="form-group col-half"><label for="custom-equip-capacity"><strong>{isEs ? 'Capacidad:' : 'Capacity:'}</strong></label><input type="text" id="custom-equip-capacity" class="wb-input" /></div></div><div class="form-group"><label for="custom-equip-notes"><strong>{isEs ? 'Notas:' : 'Notes:'}</strong></label><textarea id="custom-equip-notes" class="wb-input custom-textarea" rows="2"></textarea></div></div>
                  </details>
                </div>
              </details>
              <div class="qw-fsm-nav-row">
                <button type="button" id="btn-open-step2" class="assist-pill-btn qw-fsm-nav-btn" data-target="stage-2" data-fsm-next="stage-2">{isEs ? '02. Calibrar Hidráulica y Tribología ↓' : '02. Calibrate Hydraulics & Tribology ↓'}</button>
                <button type="button" id="btn-open-step3" class="assist-pill-btn active qw-fsm-nav-btn" data-target="stage-3" data-fsm-next="stage-3">{isEs ? '03. Continuar a Despacho y Folio ↓' : '03. Continue to Dispatch & Folio ↓'}</button>
              </div>
            </div>
          </div>
        </details>

        <div id="wb-role-criteria-bar" class="role-criteria-inline-bar">
          <div class="criteria-inline-row"><span class="criteria-inline-tag font-mono-tech">{isEs ? 'REGLA METALÚRGICA' : 'METALLURGY RULE'}</span><span id="wb-criteria-rule">{isEs ? rolesCriteriaMap.revestimientos?.rule_es : rolesCriteriaMap.revestimientos?.rule_en}</span></div>
          <div class="criteria-inline-row"><span class="criteria-inline-tag criteria-tag-risk font-mono-tech">{isEs ? 'RIESGO EVITADO' : 'AVOIDED RISK'}</span><span id="wb-criteria-risk">{isEs ? rolesCriteriaMap.revestimientos?.risk_es : rolesCriteriaMap.revestimientos?.risk_en}</span></div>
          <div class="criteria-inline-row"><span class="criteria-inline-tag font-mono-tech">{isEs ? 'VARIABLES CRÍTICAS' : 'CRITICAL VARIABLES'}</span><span id="wb-criteria-vars">{isEs ? rolesCriteriaMap.revestimientos?.vars_es : rolesCriteriaMap.revestimientos?.vars_en}</span> <strong id="wb-criteria-series" class="font-mono-tech qw-series-tag">({rolesCriteriaMap.revestimientos?.series})</strong></div>
        </div>
      </section>

      <!-- PASO 02: Núcleos Únicos de Hidráulica (Pumping) y Tribología -->
      <div class="control-card simulator-card" id="stage-2" data-stage="stage-2" data-fsm-state="stage-2" data-wb-step-panel="2">
        <details class="durand-accordion" id="durand-accordion">
          <summary class="durand-summary">
            <div class="durand-summary-header">
              <span class="step-num">02</span>
              <div class="sim-header-title">
                <h3 id="sim-headline-text">{isEs ? 'Transporte hidráulico, altitud y tribología de desgaste' : 'Slurry Hydraulics, Altitude & Wear Tribology'}</h3>
                <span class="sim-pill" id="sim-circuit-context-pill">{isEs ? 'Asistente de Planta' : 'Plant Assistant'}</span>
              </div>
            </div>
            <span class="accordion-arrow">▼</span>
          </summary>

          <div class="durand-accordion-body">
            <div class="pre-engineering-hint-box">
              <span class="hint-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg></span>
              <div class="hint-text">
                <strong id="wb-step2-hint-title">{isEs ? '¿Cuenta con datos de laboratorio del mineral o tonelaje diario?' : 'Working from mineral lab tests or daily tonnage?'}</strong>
                <p id="wb-step2-hint-body">{isEs ? 'No requiere planos de ingeniería de detalle para cotizar. Nuestro equipo en Durango valida la compatibilidad de bombeo y refacciones sin costo.' : 'No detailed engineering drawings required to request a quote. Our Durango engineering team verifies pump & spares compatibility at zero cost.'}</p>
              </div>
            </div>

            <div id="wb-step2-control-summary" class="hidden qw-metrology-summary">
              <strong class="font-mono-tech qw-block-label">{isEs ? '[ESTACIÓN METROLÓGICA ACTIVA — MARCY + PIERRE GY + ASTM E11]' : '[ACTIVE METROLOGY STATION — MARCY + PIERRE GY + ASTM E11]'}</strong>
              <span id="wb-step2-control-summary-text">{isEs ? 'Cédula de laboratorio sincronizada con el circuito.' : 'Laboratory schedule synchronized with the circuit.'}</span>
            </div>

            <PumpingHydraulicsCore locale={lang} showPipeAndSymptom={false} showTcoBlock={true} panelClass="pumping-core-wizard" />
            <TribologyAlloyIsland locale={lang} variant="impeller" mode="embedded" />

            <div class="qw-fsm-nav-row">
              <button type="button" id="btn-step2-back-step1" class="assist-pill-btn qw-fsm-nav-btn" data-target="stage-diagnostic" data-fsm-prev="stage-diagnostic">{isEs ? '← 01. Selección de Circuito' : '← 01. Circuit Selection'}</button>
              <button type="button" id="btn-step2-to-step3" class="assist-pill-btn active qw-fsm-nav-btn" data-target="stage-3" data-fsm-next="stage-3">{isEs ? '03. Datos de Despacho ERP →' : '03. ERP Dispatch Details →'}</button>
            </div>
          </div>
        </details>
      </div>

      <!-- PASO 03: Identificación del Solicitante y Despacho ERP Único -->
      <div class="control-card contact-card-priority" id="stage-3" data-stage="stage-3" data-fsm-state="stage-3" data-wb-step-panel="3" data-domain-root="erpExport">
        <details class="step3-dispatch-accordion" id="wb-step3-accordion" data-testid="wb-step3-accordion">
          <summary class="control-card-header qw-step3-summary">
            <span class="step-num">03</span>
            <h3>{isEs ? 'Identificación del Solicitante y Despacho' : 'Requester Identification & Logistics'}</h3>
          </summary>

          <div class="form-row">
            <div class="form-group col-half"><label for="wb-name"><strong>{isEs ? 'Nombre del Solicitante / Ingeniero:' : 'Requester / Engineer Name:'} *</strong></label><input type="text" id="wb-name" name="contact_name" class="wb-input" required placeholder={isEs ? 'Ej. Ing. J. Pérez / Residente' : 'e.g. Lead Process Engineer'} /></div>
            <div class="form-group col-half"><label for="wb-company"><strong>{isEs ? 'Mina o Empresa:' : 'Mine or Company:'} *</strong></label><input type="text" id="wb-company" name="company_name" class="wb-input" required placeholder={isEs ? 'Ej. Unidad Minera / Compañía' : 'e.g. Mining Operation / Company'} /></div>
          </div>
          <div class="form-row">
            <div class="form-group col-half"><label for="wb-phone"><strong>{isEs ? 'Teléfono / WhatsApp Directo:' : 'Direct Phone / WhatsApp:'} *</strong></label><input type="tel" id="wb-phone" name="phone_number" class="wb-input" required placeholder={isEs ? '(618) 810-4408' : '+1 (555) 012-3456'} /></div>
            <div class="form-group col-half">
              <label for="wb-email"><strong>{isEs ? 'Correo Corporativo:' : 'Corporate Email:'} *</strong></label>
              <input type="email" id="wb-email" name="email_address" class="wb-input" required placeholder={isEs ? 'ejemplo@unidadminera.com' : 'procurement@miningco.com'} />
              <div id="mining-group-hint" class="mining-group-hint hidden">
                <span class="hint-label">{isEs ? 'Grupo Detectado:' : 'Detected Group:'} <strong id="hint-group-name"></strong></span>
                <div class="unit-chips" id="unit-chips-container"></div>
                <div id="unit-pulp-profile-badge" class="unit-pulp-profile-badge hidden"></div>
              </div>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-half">
              <label for="wb-destination"><strong>{isEs ? 'Modalidad de Entrega / Despacho:' : 'Delivery / Dispatch Mode:'}</strong></label>
              <select id="wb-destination" name="destination" data-schema-input="erpExport.logistics_mode" class="wb-select">
                <option value="Retiro en Almacén Central Durango (Coordinación con Folio)" selected>{isEs ? 'Retiro en Almacén Durango' : 'Durango Central Warehouse Pickup'}</option>
                <option value="Envío por fletera consolidada nacional (Ocurre en destino)">{isEs ? 'Fletera Consolidada Nacional' : 'Consolidated National Carrier'}</option>
                <option value="Flete dedicado directo o enlace multimodal marítimo a penínsulas">{isEs ? 'Flete Directo a Unidad Minera' : 'Direct Freight to Mine Site'}</option>
              </select>
            </div>
            <div class="form-group col-half">
              <label for="wb-erp-quantity"><strong>{isEs ? 'Cantidad de Lotes / Piezas:' : 'Lot / Unit Quantity:'}</strong></label>
              <input type="number" id="wb-erp-quantity" data-schema-input="erpExport.quantity" min="1" max="500" step="1" value="1" class="wb-input font-mono-tech" />
            </div>
          </div>
          <div class="form-group">
            <label for="wb-erp-destination"><strong>{isEs ? 'Ciudad o Unidad Minera Destino (ERP):' : 'Destination City or Mine Site (ERP):'}</strong></label>
            <input type="text" id="wb-erp-destination" data-schema-input="erpExport.delivery_destination" class="wb-input" value="Durango" placeholder={isEs ? 'Ej. Fresnillo, Zac. / Durango' : 'e.g. Durango / Sonora Mine'} />
          </div>

          <div class="form-group qw-g5-terms">
            <label class="qw-g5-label">
              <input type="checkbox" id="wb-g5-advance-confirm" name="g5_advance_confirm" data-g5-advance-confirm checked />
              <span><strong>{isEs ? 'Condición Comercial G5 (Partidas [SE FABRICA]):' : 'Gate G5 Commercial Terms ([MADE TO ORDER]):'}</strong> {isEs ? '50% anticipo para fundición/maquinado y 50% contra aviso de embarque con reporte dimensional.' : '50% advance for casting/machining and 50% upon ready-to-ship notice with dimensional report.'}</span>
            </label>
          </div>

          <div class="form-group">
            <label><strong>{isEs ? 'Canal de Respuesta Preferido:' : 'Preferred Response Channel:'}</strong></label>
            <div class="segmented-control" id="wb-channel-selector" role="radiogroup" aria-label={isEs ? 'Canal de respuesta preferido' : 'Preferred response channel'}>
              <label class="segment-btn active" id="btn-chan-wa"><input type="radio" name="channel_pref" value="whatsapp" checked /><span class="segment-label">WhatsApp</span></label>
              <label class="segment-btn" id="btn-chan-call"><input type="radio" name="channel_pref" value="llamada" /><span class="segment-label">{isEs ? 'Llamada' : 'Phone'}</span></label>
              <label class="segment-btn" id="btn-chan-mail"><input type="radio" name="channel_pref" value="correo" /><span class="segment-label">{isEs ? 'Correo PDF' : 'Email PDF'}</span></label>
            </div>
          </div>
          <input type="text" name="website" id="wb-website" tabindex="-1" autocomplete="off" class="wb-honeypot-field" aria-hidden="true" />

          <div class="qw-step3-submit-wrap">
            <button
              type="button"
              id="wb-submit-outbox-btn"
              class="btn btn-primary qw-submit-outbox-btn"
            >
              {isEs ? 'Enviar Solicitud a Ingeniería Durango' : 'Submit Request to Durango Engineering'}
            </button>
            <p id="wb-outbox-status-msg" class="wb-outbox-status font-mono-tech" role="status" aria-live="polite"></p>
          </div>

          <div class="qw-fsm-nav-row">
            <button type="button" id="btn-step3-back-step2" class="assist-pill-btn qw-fsm-nav-btn" data-target="stage-2" data-fsm-prev="stage-2">{isEs ? '← 02. Ajustar Parámetros' : '← 02. Adjust Parameters'}</button>
            <button type="button" id="btn-step3-back-step1" class="assist-pill-btn qw-fsm-nav-btn" data-target="stage-diagnostic" data-fsm-prev="stage-diagnostic">{isEs ? '↺ 01. Cambiar Circuito' : '↺ 01. Change Circuit'}</button>
          </div>
        </details>
      </div>
    </div>

    <LiveEngineeringDossier lang={lang} defaultKinematics={defaultKinematics} defaultPartSpecs={defaultPartSpecs} />
  </div>
</div>

<script>
  import { initQuoteWizardController } from '../scripts/quoteWizardController.js';
  import { initMiningPresetTelemetryBridge } from '../scripts/wizardMiningAndCodeDecoder.js';
  import { initQuoteOutboxController } from '../scripts/quoteOutboxDomBinder.js';

  initQuoteWizardController();
  initMiningPresetTelemetryBridge();
  initQuoteOutboxController();
</script>
