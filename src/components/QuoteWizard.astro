      // Persistencia Síncrona en localStorage (Decisión 7-C y 7-B)
      try {
        var sessState = {
          name: nameVal, company: compVal, phone: phoneVal, email: emailVal,
          destination: destVal, details: detailsText, clientRef: clientRefVal,
          circuit: currentCircuit,
