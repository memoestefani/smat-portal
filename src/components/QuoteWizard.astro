---
import miningGroupsData from '../../data/mining_groups.json';
import companyData from '../../data/company.json';
import rolesData from '../../data/roles.json';
import atomicPartsData from '../../data/atomic_parts.json';
import '../styles/workbench.css';
import LiveEngineeringDossier from './LiveEngineeringDossier.astro';
import {
  SLURRY_PRESETS,
  MECHANICAL_DIAGNOSTICS,
  WET_END_MATERIAL_MATRIX,
  calculateSlurryMetrics,
  calculateAltitudeCorrection,
  evaluateWetEndAssemblyInterference,
  calculateDriveAndBearingKinematics
} from '../scripts/slurryEngine.js';
import {
  SMAT_WORKBENCH_EVENT,
  getAtomicPartSpecs,
  formatNioshErgonomicStatus
} from '../scripts/workbenchBus.js';

interface Props {
  lang?: 'es' | 'en';
  defaultRole?: string;
  defaultType?: 'capex' | 'opex';
}

const { lang = 'es', defaultRole = '', defaultType = 'opex' } = Astro.props;
const isEs = lang === 'es';
const miningGroupsJson = JSON.stringify(miningGroupsData.groups);
const atomicPartsJson = JSON.stringify(atomicPartsData);
const leadEndpointUrl = import.meta.env.PUBLIC_LEAD_INTAKE_URL || '';
const mechDiagnosticsList = Object.values(MECHANICAL_DIAGNOSTICS);
const defaultSimMetrics = calculateSlurryMetrics({ flowM3H: 180, solidsWeightPercent: 45, particleSizeD80Microns: 180, altitudeM: 2400 });
const defaultAltData = calculateAltitudeCorrection(2400);
const defaultClearanceEval = evaluateWetEndAssemblyInterference({ frontClearanceMm: 0.75, impellerExitWidthMm: 48 });
const defaultKinematics = calculateDriveAndBearingKinematics({ arrangementCode: 'CV', motorRpm: 1775, driverPulleyMm: 220, drivenPulleyMm: 340, motorPowerKw: 55, impellerDiameterMm: 381 });
const defaultPartSpecs = getAtomicPartSpecs('kit_wet_end', '6x4');
const defaultNioshEval = formatNioshErgonomicStatus(defaultPartSpecs, isEs ? 'es' : 'en');
const defaultMatSpec = WET_END_MATERIAL_MATRIX.alto_cromo_cr27;

const rolesCriteriaMap: Record<string, { rule_es: string; rule_en: string; risk_es: string; risk_en: string; vars_es: string; vars_en: string; series: string; spec_es: string; spec_en: string; }> = {};
for (const v of rolesData.verticals) {
  for (const r of [...(v.capex || []), ...(v.opex || [])]) {
    if (r.decision_criteria) {
      rolesCriteriaMap[r.role_id] = {
        rule_es: r.decision_criteria.metallurgy_rule_es, rule_en: r.decision_criteria.metallurgy_rule_en,
        risk_es: r.decision_criteria.risk_avoided_es, risk_en: r.decision_criteria.risk_avoided_en,
        vars_es: r.decision_criteria.required_slurry_vars_es || '', vars_en: r.decision_criteria.required_slurry_vars_en || '',
        series: r.series || '', spec_es: r.spec_summary_es || '', spec_en: r.spec_summary_en || '',
      };
    }
  }
}
const rolesCriteriaJson = JSON.stringify(rolesCriteriaMap);
---

<div class="workbench-container" id="rfq" data-default-role={defaultRole} data-default-type={defaultType} data-mining-groups={miningGroupsJson} data-atomic-parts={atomicPartsJson} data-lead-endpoint={leadEndpointUrl} data-roles-criteria={rolesCriteriaJson} data-lang={lang} data-workbench-event={SMAT_WORKBENCH_EVENT} data-hq-city={companyData.address.city} data-presets={JSON.stringify(SLURRY_PRESETS)}>
  <section class="workbench-header">
    <div class="badge-row">
      <span class="badge badge-copper">
        <span class="live-dot"></span>
        {isEs ? 'CONSOLA DE INGENIERÍA Y ALMACÉN DURANGO' : 'DURANGO ENGINEERING & CENTRAL WAREHOUSE'}
      </span>
      <span class="badge badge-emerald">
        {isEs ? 'ATENCIÓN AL CLIENTE: LUN-VIE 08:00 A 18:00 CST' : 'CUSTOMER SERVICE: MON-FRI 08:00 TO 18:00 CST'}
      </span>
    </div>
    <h2 class="workbench-title">
      {isEs ? 'Solicitar Cotización de Equipos y Refacciones' : 'Request a Quotation for Equipment & Spares'}
    </h2>
    <p class="workbench-subtitle">
      {isEs 
        ? 'Seleccione las piezas, lotes de contacto húmedo (impulsores, cuellos y volutas), balanzas o equipos que requiere cotizar.'
        : 'Select the wear parts, wet-end lots (impellers, throatbushes, and volutes), pulp scales, or equipment you need to quote.'}
    </p>
  </section>

  <div class="workbench-split">
    <div class="workbench-controls-panel console-bay">
      <div class="console-bay-banner">{isEs ? '1. PANEL DE ENTRADA • CONFIGURACIÓN DE EQUIPO' : '1. INPUT CONTROL PANEL • EQUIPMENT CONFIGURATION'}</div>
      
      <div id="offline-network-pill" class="offline-network-pill hidden" role="status">
        <span class="offline-dot"></span>
        <span>{isEs ? 'RED DE MINA: MODO DESCONECTADO • FICHA GUARDADA EN MEMORIA LOCAL' : 'MINE NETWORK: OFFLINE MODE • SPEC SAVED TO LOCAL STORAGE'}</span>
      </div>
      <div id="returning-user-chip" class="returning-user-chip hidden">
        <div class="user-chip-content">
          <span class="user-chip-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          <span class="user-chip-text" id="user-chip-text">{isEs ? 'Reconociendo a:' : 'Recognized user:'} <strong></strong></span>
        </div>
        <button type="button" class="user-chip-reset" id="user-chip-reset" title={isEs ? 'Cambiar de usuario' : 'Switch user'}>
          [{isEs ? 'Cambiar perfil' : 'Change profile'}]
        </button>
      </div>

      <!-- Sección 1: Selección de Equipo o Refacción (Capa 1 <= 4 Controles Activos — Ley de Cowan 4±1) -->
      <section class="control-card" id="stage-diagnostic" data-testid="stage-diagnostic" data-wb-step-panel="1">
        <div class="control-card-header">
          <span class="step-num">01</span>
          <h3>{isEs ? 'Selección de Circuito, Equipo o Refacción' : 'Circuit, Equipment or Replacement Part'}</h3>
        </div>

        <div class="circuit-selector-group" id="wb-step1-xor-circuit-bar" style="margin-bottom: 0.75rem;">
          <label id="circuit-selector-label" class="circuit-selector-label"><strong>{isEs ? 'Circuito de Proceso en Planta (Statechart XOR):' : 'Plant Mineral Processing Circuit (XOR Statechart):'}</strong></label>
          <div class="circuit-pills-grid" role="group" aria-labelledby="circuit-selector-label">
            <button type="button" class="circuit-pill active" data-circuit="bombeo" aria-pressed="true">[ {isEs ? 'BOMBEO DE PULPA' : 'SLURRY PUMPING'} ]</button>
            <button type="button" class="circuit-pill" data-circuit="flotacion" aria-pressed="false">[ {isEs ? 'FLOTACIÓN DE MINERALES' : 'MINERAL FLOTATION'} ]</button>
            <button type="button" class="circuit-pill" data-circuit="filtracion" aria-pressed="false">[ {isEs ? 'FILTRACIÓN / JALES SECOS' : 'FILTRATION / DRY TAILINGS'} ]</button>
            <button type="button" class="circuit-pill" data-circuit="control_procesos" aria-pressed="false">[ {isEs ? 'CONTROL DE PROCESOS' : 'PROCESS CONTROL'} ]</button>
          </div>
          <input type="hidden" name="process_circuit" id="wb-process-circuit" value="bombeo" />
        </div>

        <!-- CAPA 1: Selección Inmediata de Pieza / Lote y Tubería Nominal (Input First, Readout Second — Sección 3.2.3) -->
        <div id="circuit-panel-bombeo" class="circuit-panel">
          <div class="form-group">
            <label for="wb-role"><strong>{isEs ? 'Lote de Contacto Húmedo o Equipo Requerido:' : 'Required Wet-End Lot or Equipment:'}</strong></label>
            <select id="wb-role" name="role_id" class="wb-select">
              <option value="kit_wet_end" selected>{isEs ? 'Lote de Contacto Húmedo (ej. 5 Impulsores + 5 Cuellos + 4 Volutas)' : 'Wet-End Lot (e.g. 5 Impellers + 5 Throatbushes + 4 Volutes)'}</option>
              <option value="kit_sellado">{isEs ? 'Expulsor Centrífugo y Prensaestopa (Sin Sello Mecánico)' : 'Centrifugal Expeller & Stuffing Box (No Mechanical Seal)'}</option>
              <option value="kit_rodamientos">{isEs ? 'Bearing Assembly / Housing Completo (Cartucho Ensamblado)' : 'Complete Bearing Assembly / Housing (Assembled Cartridge)'}</option>
              <option value="skid_bomba">{isEs ? 'Bomba Completa para Lodos' : 'Complete Slurry Pump'}</option>
              <option value="solo_impulsor">{isEs ? 'Solo Impulsor [Desglose asistido]' : 'Impeller Only [Assisted breakdown]'}</option>
              <option value="solo_voluta">{isEs ? 'Solo Voluta / Cuello [Desglose asistido]' : 'Volute / Throatbush Only [Assisted breakdown]'}</option>
              <option value="balanza_marcy">{isEs ? 'Balanza de Densidad de Pulpa (Tipo Marcy) — 1000 cm³ y 12 Diales' : 'Pulp Density Scale (Marcy Type) — 1000 cm³ & 12 Dials'}</option>
            </select>
          </div>

          <div id="recirculation-alert-box" class="recirculation-alert-box hidden">
            <span class="recirc-icon font-mono-tech">[AVISO]</span>
            <p class="recirc-text">
              {isEs 
                ? 'Nota técnica fiduciaria: Montar un impulsor nuevo sobre una voluta con más de 30% de desgaste acelera la recirculación y reduce la vida útil en más del 40%. SMAT recomienda el Kit Extremo Húmedo para restaurar tolerancias hidráulicas en una sola intervención.' 
                : 'Technical fiduciary note: Installing a new impeller inside a volute with over 30% wear accelerates internal recirculation and cuts wear life by over 40%. SMAT recommends the Complete Wet-End Kit to restore hydraulic clearances in a single maintenance window.'}
            </p>
          </div>

          <div class="form-group" style="margin-top: 0.65rem; margin-bottom: 0.65rem;">
            <label for="wb-pipe-size"><strong>{isEs ? 'Diámetro de Tubería de la Línea:' : 'Process Line Pipe Diameter:'}</strong></label>
            <select id="wb-pipe-size" name="pipe_size" class="wb-select" data-wb-bind="pipe_size">
              <option value="1.5x1">{isEs ? 'Serie 1.5"x1" (D=40 mm — Muestreo / Rebose Espuma)' : '1.5"x1" Series (D=40 mm — Sampling / Froth Sump)'}</option>
              <option value="2x1.5">{isEs ? 'Serie 2"x1.5" (D=50 mm — Reactivos / Laboratorio)' : '2"x1.5" Series (D=50 mm — Reagents / Pilot Lab)'}</option>
              <option value="3x2">{isEs ? 'Serie 3"x2" (D=80 mm — Flotación / Concentrados)' : '3"x2" Series (D=80 mm — Flotation / Concentrates)'}</option>
              <option value="4x3">{isEs ? 'Serie 4"x3" (D=100 mm — Intermedia / Remolienda)' : '4"x3" Series (D=100 mm — Intermediate / Regrind)'}</option>
              <option value="6x4" selected>{isEs ? 'Serie 6"x4" (D=150 mm — Línea Principal de Proceso)' : '6"x4" Series (D=150 mm — Main Process Header)'}</option>
              <option value="8x6">{isEs ? 'Serie 8"x6" (D=200 mm — Gran Capacidad / Relaves)' : '8"x6" Series (D=200 mm — High-Capacity / Tailings)'}</option>
              <option value="10x8">{isEs ? 'Serie 10"x8" (D=250 mm — Alto Caudal / Ciclones)' : '10"x8" Series (D=250 mm — High Flow / Cyclones)'}</option>
              <option value="12x10">{isEs ? 'Serie 12"x10" (D=300 mm — Descarga Molino SAG)' : '12"x10" Series (D=300 mm — SAG Mill Discharge)'}</option>
              <option value="14x12">{isEs ? 'Serie 14"x12" (D=350 mm — Mega-Concentradora / Jales)' : '14"x12" Series (D=350 mm — Mega-Concentrator / Tailings)'}</option>
            </select>
            <small id="val-pipe-mm" class="font-mono-tech" style="display:block; margin-top:0.25rem; font-size:0.74rem; color:#475569;">
              {isEs ? 'Diámetro interno hidráulico (D): 150 mm (Serie 6x4)' : 'Internal hydraulic diameter (D): 150 mm (6x4 Series)'}
            </small>
          </div>

          <!-- Ficha Física de Pieza Atómica y Ergonomía NIOSH (Readout Reactivo Pos-Selección) -->
          <div id="wb-atomic-part-card" data-testid="wb-atomic-part-card" class="atomic-part-spec-card" style="margin-bottom: 0.65rem;">
            <div class="atomic-part-spec-header">
              <span class="atomic-part-spec-tag font-mono-tech" id="wb-part-station-tag">{defaultPartSpecs.station_number} • {defaultPartSpecs.code}</span>
              <span class="atomic-part-niosh-badge" id="wb-part-niosh-badge">
                {isEs ? `Peso: ${defaultPartSpecs.weight_kg} kg • ${defaultNioshEval.badgeEs}` : `Weight: ${defaultPartSpecs.weight_kg} kg • ${defaultNioshEval.badgeEn}`}
              </span>
            </div>
            <div class="atomic-part-spec-grid">
              <div><small>{isEs ? 'Geometría Hidráulica:' : 'Hydraulic Geometry:'}</small> <strong id="wb-part-geom-val">ØD₂ {defaultPartSpecs.impeller_diameter_mm} mm • {defaultPartSpecs.vanes} {isEs ? 'álabes' : 'vanes'} • Paso {defaultPartSpecs.max_particle_mm} mm</strong></div>
              <div><small>{isEs ? 'Secuencia de Montaje:' : 'Assembly Sequence:'}</small> <strong id="wb-part-order-val">{defaultPartSpecs.assembly_order} ({isEs ? 'Lote' : 'Kit'} {defaultPartSpecs.wet_end_kit_ratio})</strong></div>
              <div><small>{isEs ? 'Dureza Certificada:' : 'Certified Hardness:'}</small> <strong id="wb-part-hardness-val">{defaultPartSpecs.hardness}</strong></div>
              <div><small>{isEs ? 'Garantía Dimensional:' : 'Fit Guarantee:'}</small> <strong id="wb-part-fit-val">{isEs ? defaultPartSpecs.fit_guarantee_es : defaultPartSpecs.fit_guarantee_en}</strong></div>
            </div>
          </div>
        </div>

        <!-- Criterio Metalúrgico y Riesgo Evitado en Vivo (Conectado a data/roles.json) -->
        <div id="wb-role-criteria-bar" class="role-criteria-inline-bar">
          <div class="criteria-inline-row">
            <span class="criteria-inline-tag font-mono-tech">[REGLA METALÚRGICA]</span>
            <span id="wb-criteria-rule">{isEs ? rolesCriteriaMap.revestimientos?.rule_es : rolesCriteriaMap.revestimientos?.rule_en}</span>
          </div>
          <div class="criteria-inline-row">
            <span class="criteria-inline-tag criteria-tag-risk font-mono-tech">[RIESGO EVITADO]</span>
            <span id="wb-criteria-risk">{isEs ? rolesCriteriaMap.revestimientos?.risk_es : rolesCriteriaMap.revestimientos?.risk_en}</span>
          </div>
          <div class="criteria-inline-row">
            <span class="criteria-inline-tag font-mono-tech">[VARIABLES CRÍTICAS Y SERIE]</span>
            <span id="wb-criteria-vars">{isEs ? rolesCriteriaMap.revestimientos?.vars_es : rolesCriteriaMap.revestimientos?.vars_en}</span>
            <strong id="wb-criteria-series" class="font-mono-tech" style="font-size:0.72rem; color:#082f49;">({rolesCriteriaMap.revestimientos?.series})</strong>
          </div>
        </div>

        <!-- CAPA 2A: Gaveta Progresiva de Síntoma Clínico de Destrucción en Campo (Decisión 2-C+) -->
        <details class="wb-progressive-drawer" id="wb-symptom-context-details">
          <summary class="wb-progressive-summary">
            <span>{isEs ? '+ Condición de Operación / Síntoma de Desgaste en Planta (5 condiciones)' : '+ Operating Condition / Field Wear Symptom (5 conditions)'}</span>
            <span class="wb-step1-more-arrow">▾</span>
          </summary>
          <div class="wb-progressive-body">
            <div class="form-group">
              <label id="stress-chips-label"><strong>{isEs ? 'Condición de Operación / Síntoma de Desgaste en Planta:' : 'Operating Condition / Field Wear Symptom:'}</strong></label>
              <div class="stress-chips-grid" role="group" aria-labelledby="stress-chips-label">
                <button type="button" class="stress-chip chip-ghost" data-symptom="roca_dura" data-confirmed="false" aria-pressed="false">
                  [ {isEs ? 'ROCA DURA Y GOLPETEO CONTINUO' : 'HARD ROCK & IMPACT'} ]
                </button>
                <button type="button" class="stress-chip" data-symptom="acido_quimica" data-confirmed="false" aria-pressed="false">
                  [ {isEs ? 'AGUA ÁCIDA / ATAQUE QUÍMICO' : 'ACID SLURRY / CHEMICAL ATTACK'} ]
                </button>
                <button type="button" class="stress-chip" data-symptom="arena_fina" data-confirmed="false" aria-pressed="false">
                  [ {isEs ? 'ARENA FINA Y CORTE A VELOCIDAD' : 'FINE SLURRY & HIGH VELOCITY'} ]
                </button>
                <button type="button" class="stress-chip" data-symptom="fuga_sello" data-confirmed="false" aria-pressed="false">
                  [ {isEs ? 'FUGA CONSTANTE EN SELLO / INUNDACIÓN' : 'SEAL LEAKAGE / SUMP FLOOD'} ]
                </button>
                <button type="button" class="stress-chip" data-symptom="mixta_duda" data-confirmed="false" aria-pressed="false">
                  [ {isEs ? 'CONDICIÓN MIXTA / PULPA COMPLEJA' : 'MIXED SLURRY / COMPLEX PULP'} ]
                </button>
              </div>
              <input type="hidden" name="stress_symptom" id="wb-stress-symptom" value="" />
            </div>
          </div>
        </details>

        <!-- CAPA 2B: Gaveta Progresiva de Configuración de Circuito, Unidad Minera, Material y Arreglo (Decisión 2-C+) -->
        <details class="wb-progressive-drawer" id="wb-engineering-config-details">
          <summary class="wb-progressive-summary">
            <span>{isEs ? '+ Configuración de Circuito (Flotación / Filtración / Lab), Material Cr27/Hule, Arreglo V-Belt y Unidad Minera' : '+ Circuit Config (Flotation / Filtration / Lab), Cr27/Rubber Material, V-Belt Arrangement & Mining Unit'}</span>
            <span class="wb-step1-more-arrow">▾</span>
          </summary>
          <div class="wb-progressive-body">
            <div class="intent-selector">
              <label class="intent-btn selected" id="btn-intent-opex">
                <input type="radio" name="intent" value="opex_paro" checked />
                <span class="intent-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
                <div class="intent-info"><strong>{isEs ? 'Refacciones de Desgaste / Paro' : 'Wear Spares / Plant Shutdown'}</strong><small>{isEs ? 'Impulsores A05, volutas, rotores, estatores y telas' : 'A05 impellers, volutes, rotors, stators & cloths'}</small></div>
              </label>
              <label class="intent-btn" id="btn-intent-capex">
                <input type="radio" name="intent" value="capex_proyecto" />
                <span class="intent-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/></svg></span>
                <div class="intent-info"><strong>{isEs ? 'Equipos Completos / Circuito' : 'Complete Equipment / Circuit Package'}</strong><small>{isEs ? 'Bombas en skid con motor, celdas o filtros prensa' : 'Skid pumps with motor, cells or filter presses'}</small></div>
              </label>
            </div>

            <div id="package-bundle-panel" class="package-bundle-panel hidden">
              <div class="package-bundle-header">
                <strong>{isEs ? 'Seleccione las partidas requeridas para su circuito:' : 'Select required circuit equipment:'}</strong>
                <small>{isEs ? 'Puede marcar varias opciones para recibir una cotización consolidada.' : 'Check all items you need quoted as a consolidated package.'}</small>
              </div>
              <div class="package-bundle-grid">
                <label class="package-check-label"><input type="checkbox" name="pkg_item" value="bomba_skid" checked /><span>{isEs ? 'Bomba para Lodos en Skid con Motor' : 'Slurry Pump Skid with Motor'}</span></label>
                <label class="package-check-label"><input type="checkbox" name="pkg_item" value="celdas_flotacion" /><span>{isEs ? 'Batería de Celdas de Flotación' : 'Flotation Cell Bank'}</span></label>
                <label class="package-check-label"><input type="checkbox" name="pkg_item" value="filtro_prensa" /><span>{isEs ? 'Filtro Prensa para Jales Secos' : 'Filter Press for Dry Tailings'}</span></label>
                <label class="package-check-label"><input type="checkbox" name="pkg_item" value="refacciones_inicio" /><span>{isEs ? 'Paquete Inicial de Refacciones A05' : 'Initial A05 Wear Spares Pack'}</span></label>
              </div>
            </div>

            <div id="wb-mining-preset-bar" class="mining-preset-step1-bar" style="margin-top: 0.75rem; padding: 0.65rem 0.85rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px;">
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.6rem;">
                <div>
                  <label for="wb-mining-group-select" style="font-size: 0.74rem; font-weight: 700; color: #0f172a; display: block; margin-bottom: 0.2rem;">{isEs ? 'Grupo Minero / Operador (Pre-calibración opcional):' : 'Mining Group / Operator (Optional preset):'}</label>
                  <select id="wb-mining-group-select" class="wb-select" style="min-height: 36px; padding: 0.3rem 0.55rem; font-size: 0.78rem;">
                    <option value="">{isEs ? '— Seleccionar grupo minero (25 grupos) —' : '— Select mining group (25 groups) —'}</option>
                    {miningGroupsData.groups.map((grp) => (<option value={grp.id}>{grp.name}</option>))}
                  </select>
                </div>
                <div>
                  <label for="wb-mining-unit-select" style="font-size: 0.74rem; font-weight: 700; color: #0f172a; display: block; margin-bottom: 0.2rem;">{isEs ? 'Unidad Minera y Perfil de Pulpa (44 minas):' : 'Mining Unit & Pulp Profile (44 mines):'}</label>
                  <select id="wb-mining-unit-select" class="wb-select" style="min-height: 36px; padding: 0.3rem 0.55rem; font-size: 0.78rem;">
                    <option value="">{isEs ? '— Seleccionar unidad minera para pre-cargar pulpa —' : '— Select mining unit to pre-load slurry profile —'}</option>
                    {miningGroupsData.groups.flatMap((grp) => (grp.units || []).map((u) => (<option value={`${grp.id}::${u.name}`} data-group-id={grp.id} data-group-name={grp.name} data-unit-name={u.name} data-pulp-profile={u.pulp_profile || ''}>{grp.name} — {u.name}</option>)))}
                  </select>
                </div>
              </div>
              <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.4rem; margin-top:0.45rem;">
