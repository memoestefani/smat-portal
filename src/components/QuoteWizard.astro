    var currentTcoMetrics = {};

    var atomicRolePipeMap = {
      D3147: { role: 'solo_impulsor', size: '3x2', smat: 'SMAT-PUMP-3X2-IMP' },
      E4147: { role: 'solo_impulsor', size: '6x4', smat: 'SMAT-PUMP-6X4-IMP' },
      F6147: { role: 'solo_impulsor', size: '8x6', smat: 'SMAT-PUMP-8X6-IMP' },
      DAM028: { role: 'kit_sellado', size: '3x2', smat: 'SMAT-SEAL-3X2-EXP' },
      EAM028: { role: 'kit_sellado', size: '6x4', smat: 'SMAT-SEAL-6X4-EXP' },
      E4083: { role: 'solo_voluta', size: '6x4', smat: 'SMAT-PUMP-6X4-VOL' }
    };

    // Decodificador de Código SMAT y Refacciones Atómicas (Decisión 6-A & 4-B)
    function decodeSmatCode(codeStr) {
      if (!codeStr) return null;
      var c = codeStr.toUpperCase().trim();

      if (atomicRolePipeMap[c]) {
        var mapEntry = atomicRolePipeMap[c];
        var foundPart = atomicPartsList.find(function(p) { return p.part_number === c || p.code.toUpperCase() === c; });
        var partLabel = foundPart ? (isEs ? foundPart.name_es : foundPart.name_en) : ('Refacción ' + c);
        return {
          circuit: 'bombeo',
          role: mapEntry.role,
          size: mapEntry.size,
          code: mapEntry.smat,
          atomic_code: c,
          atomic_label: partLabel,
          atomic_metallurgy: foundPart ? foundPart.metallurgy : 'High Chrome A05 (27% Cr, ≥ 650 HB)'
        };
      }

      if (!c.startsWith('SMAT-')) return null;

      var circuit = 'bombeo';
      var role = 'kit_wet_end';
      var size = '6x4';

      if (c.includes('FLOT')) {
        circuit = 'flotacion';
        role = c.includes('CELL') ? 'celda_flotacion' : 'rotor_estator';
        if (c.includes('50FT')) size = '50ft';
        else if (c.includes('200FT')) size = '200ft';
        else if (c.includes('300FT')) size = '300ft';
        else size = '100ft';
      } else if (c.includes('FILT')) {
        circuit = 'filtracion';
        role = c.includes('PRESS') ? 'filtro_prensa' : 'placas_telas';
        if (c.includes('800')) size = '800';
        else if (c.includes('1200')) size = '1200';
        else if (c.includes('2000')) size = '2000';
        else size = '1500';
      } else {
        circuit = 'bombeo';
        if (c.includes('SKID')) role = 'skid_bomba';
        else if (c.includes('SEAL') || c.includes('EXP')) role = 'kit_sellado';
        else if (c.includes('BEAR') || c.includes('TIMKEN')) role = 'kit_rodamientos';
        else if (c.includes('IMP')) role = 'solo_impulsor';
        else if (c.includes('VOL') || c.includes('LINER')) role = 'solo_voluta';
        else role = 'kit_wet_end';

        if (c.includes('1.5X1') || c.includes('2X1.5')) size = '1.5x1';
        else if (c.includes('4X3') || c.includes('3X2')) size = '3x2';
        else if (c.includes('8X6')) size = '8x6';
        else if (c.includes('10X8')) size = '10x8';
        else size = '6x4';
      }

      return { circuit: circuit, role: role, size: size, code: c, atomic_code: '' };
    }

    function handleDecodeAction() {
      var rawCode = inputDecoder?.value.trim();
      if (!rawCode) {
        if (decoderStatus) {
          decoderStatus.textContent = isEs ? 'Ingrese un código SMAT o refacción válido (ej. E4083 o SMAT-PUMP-6X4-WETKIT)' : 'Enter a valid SMAT or part code (e.g. E4083 or SMAT-PUMP-6X4-WETKIT)';
          decoderStatus.className = 'decoder-status error';
        }
        return;
      }

      var decoded = decodeSmatCode(rawCode);
      if (decoded) {
        currentAtomicCode = decoded.atomic_code || '';
        setCircuit(decoded.circuit);
        if (decoded.circuit === 'bombeo') {
          if (selectRole) selectRole.value = decoded.role;
          if (selectPipeSize) selectPipeSize.value = decoded.size;
        } else if (decoded.circuit === 'flotacion') {
          if (selectRoleFlot) selectRoleFlot.value = decoded.role;
          if (selectFlotCapacity) selectFlotCapacity.value = decoded.size;
        } else if (decoded.circuit === 'filtracion') {
          if (selectRoleFilt) selectRoleFilt.value = decoded.role;
          if (selectFiltCapacity) selectFiltCapacity.value = decoded.size;
        }
        if (inputDetails) {
          if (decoded.atomic_code) {
            inputDetails.value = (isEs ? 'Refacción específica ' : 'Specific spare ') + decoded.atomic_code + ' (' + decoded.atomic_label + ') - ' + decoded.atomic_metallurgy + '. Verificación dimensional 1:1 en banco Durango.';
          } else {
            inputDetails.value = 'Configuración según código institucional ' + decoded.code + '. Verificación dimensional 1:1 en banco Durango.';
          }
        }
        if (decoderStatus) {
          var statusLabel = decoded.atomic_code ? (decoded.atomic_code + ' → ' + decoded.code) : decoded.code;
          decoderStatus.textContent = isEs ? 'Configuración cargada: ' + statusLabel : 'Configuration loaded: ' + statusLabel;
          decoderStatus.className = 'decoder-status success';
        }
        updateRoleCriteriaBar();
        runSlurryCalculation();
        updateDossier();
      } else {
        if (decoderStatus) {
          decoderStatus.textContent = isEs ? 'Código no reconocido. Verifique el formato institucional SMAT.' : 'Unrecognized code. Please verify SMAT standard format.';
          decoderStatus.className = 'decoder-status error';
        }
      }
    }

