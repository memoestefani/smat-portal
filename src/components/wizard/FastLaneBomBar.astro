---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<dialog id="smat-bom-import-dialog" class="smat-bom-dialog" aria-labelledby="fastlane-bom-heading">
  <div class="smat-bom-dialog-head">
    <strong id="fastlane-bom-heading" class="fastlane-title">
      {isEs ? 'Importar lista de códigos (Excel / SAP)' : 'Import SKU / Part List (Excel / SAP)'}
    </strong>
    <button
      type="button"
      id="wb-close-bom-modal-btn"
      class="smat-bom-dialog-close"
      aria-label={isEs ? 'Cerrar ventana' : 'Close dialog'}
    >
      ×
    </button>
  </div>

  <div id="bom-fastlane" class="fastlane-modal-inner">
    <section class="fastlane-bom-bar" id="fastlane-bom-bar" aria-labelledby="fastlane-bom-heading">
      <p class="fastlane-sub">
        {isEs
          ? 'Pega tu lista de códigos SMAT o equivalencias con cantidad (ej. SMAT-PUMP-WETKIT-554 2) desde Excel o SAP.'
          : 'Paste one or more SMAT SKUs or part references with quantity (e.g. SMAT-PUMP-WETKIT-554 2) from Excel or SAP.'}
      </p>

      <div class="fastlane-bom-input-row">
        <textarea
          id="fastlane-bom-input"
          class="wb-input font-mono-tech fastlane-textarea"
          rows="4"
          aria-label={isEs ? 'Pegar lista de códigos desde Excel o SAP' : 'Paste codes from Excel or SAP'}
          placeholder={isEs ? "SMAT-PUMP-WETKIT-554\t2\n4x SMAT-CYC-D6-D20" : "SMAT-PUMP-WETKIT-554\t2\n4x SMAT-CYC-D6-D20"}
        ></textarea>
        <button type="button" id="fastlane-bom-apply-btn" class="btn btn-primary smat-buy-cta fastlane-apply-btn">
          {isEs ? 'Agregar partidas al pedido' : 'Add Items to Order'}
        </button>
      </div>
      <p id="fastlane-bom-summary" class="fastlane-feedback font-mono-tech hidden" role="status" aria-live="polite"></p>
      <p id="fastlane-bom-feedback" class="fastlane-feedback font-mono-tech hidden" role="status" aria-live="polite"></p>
      <p id="share-purchasing-feedback" class="fastlane-feedback font-mono-tech hidden" role="status" aria-live="polite"></p>
    </section>
  </div>
</dialog>

<style>
  .fastlane-modal-inner {
    padding: 0.9rem 1rem 1.15rem;
  }
  .fastlane-bom-bar {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 0.9rem 1rem;
  }
  .fastlane-title {
    display: block;
    font-size: 0.95rem;
    color: #0f172a;
  }
  .fastlane-sub {
    margin: 0 0 0.65rem;
    font-size: 0.82rem;
    color: #334155;
  }
  .fastlane-bom-input-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.6rem;
    align-items: stretch;
  }
  .fastlane-textarea {
    min-height: 92px;
    resize: vertical;
  }
  .fastlane-apply-btn {
    min-height: 48px;
    min-width: 48px;
    white-space: nowrap;
  }
  .fastlane-feedback {
    margin: 0.45rem 0 0;
    font-size: 0.78rem;
    color: #065f46;
  }
  @media (max-width: 640px) {
    .fastlane-bom-input-row {
      grid-template-columns: 1fr;
    }
  }
</style>
