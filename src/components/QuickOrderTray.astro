---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const quoteHref = isEs ? '/cotizar/#rfq' : '/en/quote/#rfq';
---

<aside
  id="smat-quick-order-tray"
  data-quick-order-tray
  data-lang={lang}
  class="smat-qtray-root"
  aria-label={isEs ? 'Bandeja de Cotización SMAT' : 'SMAT Quote Tray'}
>
  <dialog
    id="smat-qtray-drawer"
    class="smat-qtray-drawer smat-qtray-dialog hidden"
    aria-labelledby="smat-qtray-modal-title"
    aria-modal="true"
    hidden
  >
    <div class="smat-qtray-drawer-head">
      <div>
        <div id="smat-qtray-modal-title" class="smat-qtray-title">
          {isEs ? 'Bandeja de Cotización' : 'Quote Tray'}
          <span id="smat-qtray-count" class="smat-qtray-count-pill">0</span>
        </div>
        <div id="smat-qtray-priority-badge" class="smat-qtray-priority">
          {isEs ? 'Compra directa CFDI 4.0 o OC SAP' : 'CFDI 4.0 Direct or SAP PO'}
        </div>
      </div>
      <button type="button" id="smat-qtray-close" class="smat-qtray-close-btn" aria-label={isEs ? 'Cerrar' : 'Close'}>×</button>
    </div>

    <div class="smat-qtray-lane-grid">
      <button type="button" data-qtray-lane="CAJA_CHICA_CFDI40" class="qtray-lane-btn is-active">
        {isEs ? 'Compra Directa CFDI 4.0' : 'Direct CFDI 4.0'}
      </button>
      <button type="button" data-qtray-lane="ORDEN_COMPRA_SAP" class="qtray-lane-btn">
        {isEs ? 'Orden de Compra SAP' : 'SAP Purchase Order'}
      </button>
    </div>

    <ul id="smat-qtray-items" class="smat-qtray-items-list">
      <li class="smat-qtray-empty-item">
        {isEs
          ? 'Tu bandeja está vacía. Agrega refacciones desde el catálogo.'
          : 'Your quote tray is empty. Add spares from the catalog.'}
      </li>
    </ul>

    <!-- Condicional: solo visible si hay cartucho de rodamientos DAM005 en la bandeja -->
    <div id="smat-qtray-tradein-wrap" class="smat-qtray-tradein-box hidden" hidden data-smat-invariant="INV-SMAT-SCI-06">
      <label class="smat-qtray-tradein-label">
        <input type="checkbox" id="smat-qtray-core-tradein" data-core-tradein-toggle class="smat-qtray-checkbox" />
        <span>
          <strong>{isEs ? 'Intercambio de Casco DAM005 (-22%)' : 'DAM005 Core Trade-In (-22%)'}</strong>
          <span id="smat-qtray-core-badge" class="smat-qtray-tradein-note">
            {isEs ? 'Bonificación al retornar tambor en Durango' : 'Credit when returning housing in Durango'}
          </span>
        </span>
      </label>
    </div>

    <!-- Condicional: solo visible si hay partidas bajo fabricación -->
    <div id="smat-qtray-g5-wrap" class="smat-qtray-tradein-box hidden" hidden>
      <label class="smat-qtray-tradein-label">
        <input type="checkbox" id="smat-qtray-g5-advance" data-g5-advance-confirm class="smat-qtray-checkbox" checked />
        <span>
          <strong>{isEs ? 'Programación bajo plano (50% / 50%)' : 'Made-to-Order Terms (50% / 50%)'}</strong>
          <span id="smat-qtray-g5-badge" class="smat-qtray-tradein-note">
            {isEs ? 'Aplica a placas 16 bar, celdas o fabricación especial' : 'Applies to 16-bar plates, cells or custom items'}
          </span>
        </span>
      </label>
    </div>

    <div class="smat-qtray-actions">
      <a id="smat-qtray-pdf-link" data-qtray-pdf-btn href={quoteHref} class="smat-qtray-wa-btn smat-buy-cta">
        {isEs ? 'Ir al cotizador y confirmar →' : 'Proceed to quote checkout →'}
      </a>
      <a href={isEs ? '/cotizar/?openBom=1#rfq' : '/en/quote/?openBom=1#rfq'} class="smat-qtray-share-btn">
        {isEs ? 'Importar lista Excel / SAP' : 'Import Excel / SAP list'}
      </a>
      <a
        id="smat-qtray-wa-link"
        href="https://wa.me/526183670664?text=Hola%20SMAT%2C%20solicito%20cotizaci%C3%B3n%20desde%20mi%20bandeja%20web."
        target="_blank"
        rel="noopener noreferrer"
        class="smat-qtray-pdf-btn"
      >
        {isEs ? 'Enviar lista por WhatsApp' : 'Send List via WhatsApp'}
      </a>
      <button type="button" id="smat-qtray-clear-btn" class="smat-qtray-share-btn hidden" hidden>
        {isEs ? 'Vaciar bandeja' : 'Clear tray'}
      </button>
    </div>
  </dialog>
</aside>

<script>
  import {
    getTrayState,
    saveTrayState,
    addTrayItem,
    removeTrayItem,
    updateTrayItemQty,
    clearTray,
    encodeReorderUrlQuery,
    hydrateTrayFromReorderQuery,
    buildCmuPrioritySubjectLine,
    evaluateBearingCartridgeCoreTradeIn,
    syncTrayToWorkbenchStateLens,
    SMAT_TRAY_UPDATE_EVENT
  } from '../scripts/requisitionTrayBus.js';
  import { formatCheckoutLaneHuman } from '../scripts/i18nDomainLabels.js';
  import { hydrateRfqSessionFromUrl, buildShareableRfqUrl } from '../scripts/rfqSessionStore.js';

  function initQuickOrderTray() {
    const root = document.getElementById('smat-quick-order-tray');
    if (!root || root.getAttribute('data-qtray-bound') === '1') return;
    root.setAttribute('data-qtray-bound', '1');
    if (typeof window !== 'undefined' && window.location) {
      if (window.location.search.includes('rfq_v3=')) hydrateRfqSessionFromUrl(window.location.search);
      else if (window.location.search.includes('tray=')) hydrateTrayFromReorderQuery(window.location.search);
    }

    const lang: 'es' | 'en' = root.getAttribute('data-lang') === 'en' ? 'en' : 'es';
    const isEs = lang === 'es';
    const closeBtn = document.getElementById('smat-qtray-close');
    const drawer = document.getElementById('smat-qtray-drawer') as HTMLDialogElement | null;
    const countEl = document.getElementById('smat-qtray-count');
    const itemsEl = document.getElementById('smat-qtray-items');
    const waLink = document.getElementById('smat-qtray-wa-link') as HTMLAnchorElement | null;
    const pdfLink = document.getElementById('smat-qtray-pdf-link') as HTMLAnchorElement | null;
    const shareBtn = document.getElementById('smat-qtray-share-btn') as HTMLButtonElement | null;
    const clearBtn = document.getElementById('smat-qtray-clear-btn') as HTMLButtonElement | null;
    const coreWrap = document.getElementById('smat-qtray-tradein-wrap');
    const coreToggle = document.getElementById('smat-qtray-core-tradein') as HTMLInputElement | null;
    const g5Wrap = document.getElementById('smat-qtray-g5-wrap');
    const g5Toggle = document.getElementById('smat-qtray-g5-advance') as HTMLInputElement | null;
    let selectedLane = 'CAJA_CHICA_CFDI40';

    function setDrawerHidden(isHidden: boolean) {
      if (!drawer) return;
      drawer.classList.toggle('hidden', isHidden);
      if (isHidden) {
        drawer.setAttribute('hidden', '');
        if (typeof drawer.close === 'function' && drawer.open) drawer.close();
      } else {
        drawer.removeAttribute('hidden');
        if (typeof drawer.showModal === 'function' && !drawer.open) drawer.showModal();
      }
      document.getElementById('header-qtray-trigger')?.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
    }

    shareBtn?.addEventListener('click', async () => {
      const origin = typeof window !== 'undefined' && window.location ? window.location.origin : 'https://smatminerals.com';
      const url = buildShareableRfqUrl({ origin, pathname: isEs ? '/cotizar/' : '/en/quote/' });
      try { await navigator.clipboard?.writeText(url); } catch {}
      shareBtn.textContent = isEs ? 'Enlace copiado' : 'Link copied';
      window.setTimeout(() => { shareBtn.textContent = isEs ? 'Copiar enlace para Compras' : 'Copy Link for Purchasing'; }, 2200);
    });

    drawer?.addEventListener('close', () => setDrawerHidden(true));
    drawer?.addEventListener('click', (ev) => { if (ev.target === drawer) setDrawerHidden(true); });
    window.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && drawer && (drawer.open || !drawer.hasAttribute('hidden'))) setDrawerHidden(true);
    });

    function renderTray() {
      const state = getTrayState();
      const totalQty = state.items.reduce((acc: number, it: any) => acc + (Number(it.qty) || 1), 0);
      if (countEl) countEl.textContent = String(totalQty);
      const headerCountEl = document.getElementById('header-qtray-count');
      if (headerCountEl) headerCountEl.textContent = String(totalQty);

      const hasCoreSku = state.items.some((i: any) => String(i.id || '').includes('005M') || String(i.atomicCode || '').includes('DAM005'));
      if (coreWrap) {
        coreWrap.classList.toggle('hidden', !hasCoreSku);
        coreWrap.hidden = !hasCoreSku;
      }
      const hasMtoSku = state.items.some((i: any) => i.stockRegime === 'se_fabrica' || i.stockRegime === 'se_pide' || String(i.id || '').includes('FILT') || String(i.id || '').includes('FLOT'));
      if (g5Wrap) {
        g5Wrap.classList.toggle('hidden', !hasMtoSku);
        g5Wrap.hidden = !hasMtoSku;
      }

      const tradeIn = evaluateBearingCartridgeCoreTradeIn(state, coreToggle ? coreToggle.checked : state.coreReturnEnabled);
      if (coreToggle) coreToggle.checked = Boolean(tradeIn.coreReturnEnabled);

      if (itemsEl) {
        if (!state.items.length) {
          itemsEl.innerHTML = `<li class="smat-qtray-empty-item">${
            isEs ? 'Tu bandeja está vacía. Agrega refacciones desde el catálogo.' : 'Your quote tray is empty. Add spares from the catalog.'
          }</li>`;
        } else {
          itemsEl.innerHTML = state.items.map((item: any) => {
            const regimeTag = item.stockRegime === 'se_fabrica' || item.stockRegime === 'se_pide'
              ? (isEs ? 'Bajo fabricación' : 'Made to order')
              : (isEs ? 'Rotación Durango' : 'Durango rotation');
            return `
            <li class="smat-qtray-item-row">
              <div>
                <div class="smat-qtray-item-code">${item.id} × ${item.qty}</div>
                <div class="smat-qtray-item-name">${isEs ? item.nameEs : item.nameEn}</div>
                <div class="smat-qtray-priority">${regimeTag}</div>
              </div>
              <div class="smat-qtray-item-controls">
                <button type="button" data-qtray-qty-delta="-1" data-qtray-item-id="${item.id}" data-qtray-current-qty="${item.qty}" class="smat-qtray-qty-btn" aria-label="Disminuir">−</button>
                <button type="button" data-qtray-qty-delta="1" data-qtray-item-id="${item.id}" data-qtray-current-qty="${item.qty}" class="smat-qtray-qty-btn" aria-label="Aumentar">+</button>
                <button type="button" data-qtray-remove="${item.id}" class="smat-qtray-remove-btn" aria-label="Eliminar">×</button>
              </div>
            </li>`;
          }).join('');

          itemsEl.querySelectorAll('[data-qtray-qty-delta]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const id = btn.getAttribute('data-qtray-item-id') || '';
              const delta = Number(btn.getAttribute('data-qtray-qty-delta') || 0);
              const curr = Number(btn.getAttribute('data-qtray-current-qty') || 1);
              updateTrayItemQty(id, Math.max(0, curr + delta));
              renderTray();
            });
          });
          itemsEl.querySelectorAll('[data-qtray-remove]').forEach((btn) => {
            btn.addEventListener('click', () => {
              removeTrayItem(btn.getAttribute('data-qtray-remove') || '');
              renderTray();
            });
          });
        }
      }

      if (waLink) {
        const subject = buildCmuPrioritySubjectLine(state, { cvPct: 48 });
        const summary = state.items.map((i: any) => `${i.id} (x${i.qty} ${i.material})`).join(', ');
        const msg = `[SMAT-DGO] ${subject} | ${formatCheckoutLaneHuman(selectedLane, lang)} | ${summary || 'Consulta directa'}`;
        waLink.href = `https://wa.me/526183670664?text=${encodeURIComponent(msg)}`;
      }

      if (pdfLink) {
        const basePath = isEs ? '/cotizar/' : '/en/quote/';
        pdfLink.href = state.items.length
          ? `${basePath}${encodeReorderUrlQuery(state)}&lane=${encodeURIComponent(selectedLane)}#rfq`
          : `${basePath}#rfq`;
      }
      if (clearBtn) {
        const empty = state.items.length === 0;
        clearBtn.classList.toggle('hidden', empty);
        clearBtn.hidden = empty;
      }
    }

    clearBtn?.addEventListener('click', () => {
      clearTray();
      renderTray();
    });

    coreToggle?.addEventListener('change', () => {
      const updated = saveTrayState({ ...getTrayState(), coreReturnEnabled: Boolean(coreToggle.checked) });
      syncTrayToWorkbenchStateLens(updated);
      renderTray();
    });
    g5Toggle?.addEventListener('change', renderTray);
    closeBtn?.addEventListener('click', () => setDrawerHidden(true));
    root.querySelectorAll('[data-qtray-lane]').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedLane = btn.getAttribute('data-qtray-lane') || 'CAJA_CHICA_CFDI40';
        root.querySelectorAll('[data-qtray-lane]').forEach((b) => b.classList.toggle('is-active', b === btn));
        renderTray();
      });
    });

    document.querySelectorAll('[data-quick-tray-add]').forEach((btn) => {
      if (btn.getAttribute('data-qtray-btn-bound') === '1') return;
      btn.setAttribute('data-qtray-btn-bound', '1');
      btn.addEventListener('click', () => {
        const skuId = btn.getAttribute('data-quick-tray-add') || '';
        if (!skuId) return;
        const title = btn.getAttribute('data-sku-title') || skuId;
        const code = btn.getAttribute('data-sku-code') || skuId;
        const material = btn.getAttribute('data-sku-material') || 'A05';
        const mass = Number(btn.getAttribute('data-sku-mass') || 15);
        const qty = Math.max(1, Number(btn.getAttribute('data-sku-qty') || 1));
        addTrayItem({ id: skuId, skuId, atomicCode: code, nameEs: title, nameEn: title, material, unitWeightKg: mass, qty });
        setDrawerHidden(false);
        renderTray();
      });
    });

    window.addEventListener(SMAT_TRAY_UPDATE_EVENT, renderTray);
    renderTray();
  }

  initQuickOrderTray();
  document.addEventListener('astro:page-load', initQuickOrderTray);
</script>

<style>
  .smat-qtray-root { display: contents; }
  .smat-qtray-count-pill { display: inline-flex; height: 20px; min-width: 20px; align-items: center; justify-content: center; padding: 0 0.375rem; margin-left: 0.4rem; border-radius: 9999px; background: #7c2d12; color: #ffffff; font-size: 0.7rem; font-weight: 800; }
  .smat-qtray-dialog { width: min(420px, calc(100vw - 1.5rem)); margin: auto; padding: 1.15rem; border-radius: 16px; border: 1px solid #cbd5e1; background: #ffffff; color: #0f172a; box-shadow: 0 24px 48px rgba(15, 23, 42, 0.24); }
  .smat-qtray-dialog::backdrop { background: rgba(15, 23, 42, 0.55); backdrop-filter: blur(2px); }
  .smat-qtray-drawer.hidden, .smat-qtray-drawer[hidden] { display: none !important; }
  .smat-qtray-drawer-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.625rem; margin-bottom: 0.75rem; border-bottom: 1px solid #cbd5e1; }
  .smat-qtray-title { font-size: 0.9rem; font-weight: 800; color: #7c2d12; }
  .smat-qtray-priority { font-size: 0.72rem; font-weight: 600; color: #064e3b; }
  .smat-qtray-close-btn { min-height: 48px; min-width: 48px; border-radius: 8px; border: 1px solid #cbd5e1; background: #f8fafc; color: #0f172a; font-size: 1.1rem; cursor: pointer; }
  .smat-qtray-lane-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; margin-bottom: 0.75rem; font-size: 0.74rem; }
  .qtray-lane-btn { min-height: 48px; padding: 0.45rem 0.6rem; border-radius: 8px; border: 1px solid #cbd5e1; background: #f8fafc; color: #0f172a; font-weight: 700; cursor: pointer; }
  .qtray-lane-btn.is-active { border-color: #059669; background: #ecfdf5; color: #064e3b; }
  .smat-qtray-items-list { list-style: none; margin: 0 0 0.75rem 0; padding: 0; max-height: 13rem; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.78rem; }
  :global(.smat-qtray-empty-item) { padding: 0.75rem 0; text-align: center; color: #475569; }
  :global(.smat-qtray-item-row) { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.5rem 0.75rem; border-radius: 8px; background: #f8fafc; border: 1px solid #cbd5e1; }
  :global(.smat-qtray-item-code) { font-family: var(--smat-font-mono, monospace); font-weight: 700; color: #7c2d12; }
  :global(.smat-qtray-item-name) { font-size: 0.74rem; color: #0f172a; max-width: 210px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.smat-qtray-remove-btn) { padding: 0.25rem 0.5rem; border: none; background: transparent; font-size: 0.9rem; color: #9f1239; cursor: pointer; }
  .smat-qtray-tradein-box { padding: 0.55rem 0.7rem; margin-bottom: 0.65rem; border-radius: 10px; background: #ecfdf5; border: 1px solid #059669; font-size: 0.74rem; }
  .smat-qtray-tradein-label { display: flex; align-items: center; min-height: 44px; gap: 0.55rem; cursor: pointer; }
  .smat-qtray-tradein-note { display: block; font-size: 0.68rem; color: #064e3b; }
  .smat-qtray-actions { display: flex; flex-direction: column; gap: 0.45rem; }
  .smat-qtray-wa-btn, .smat-qtray-pdf-btn, .smat-qtray-share-btn { display: flex; align-items: center; justify-content: center; min-height: 48px; width: 100%; padding: 0.55rem 0.9rem; border-radius: 10px; text-decoration: none; font-size: 0.8rem; font-weight: 700; cursor: pointer; }
  .smat-qtray-wa-btn { background: #7c2d12; color: #ffffff; border: 1px solid #431407; }
  .smat-qtray-pdf-btn { background: #065f46; color: #ffffff; border: 1px solid #064e3b; }
  .smat-qtray-share-btn { background: #f8fafc; color: #0f172a; border: 1px solid #cbd5e1; }
  .smat-qtray-item-controls { display: inline-flex; align-items: center; gap: 0.25rem; }
  :global(.smat-qtray-qty-btn) { min-width: 48px; min-height: 48px; padding: 0.25rem 0.55rem; border-radius: 6px; border: 1px solid #cbd5e1; background: #ffffff; font-weight: 800; cursor: pointer; touch-action: manipulation; }
</style>
