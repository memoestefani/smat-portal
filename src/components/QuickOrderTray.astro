---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<aside
  id="smat-quick-order-tray"
  data-quick-order-tray
  data-lang={lang}
  class="smat-qtray-root"
  aria-label={isEs ? 'Bandeja Rápida de Cotización B2B' : 'Fast B2B Requisition Tray'}
>
  <!-- Botón flotante colapsado (Fitts >= 48x48px) -->
  <button
    type="button"
    id="smat-qtray-toggle"
    class="smat-qtray-toggle-btn"
    aria-expanded="false"
    aria-controls="smat-qtray-drawer"
  >
    <span>🛒 {isEs ? 'Bandeja B2B (cμ)' : 'B2B Tray (cμ)'}</span>
    <span
      id="smat-qtray-count"
      class="smat-qtray-count-pill"
    >
      0
    </span>
  </button>

  <!-- Panel desplegable de Bandeja Dual (< 25,000 MXN Caja Chica vs > 25,000 MXN OC SAP) -->
  <div
    id="smat-qtray-drawer"
    class="smat-qtray-drawer hidden"
    hidden
  >
    <div class="smat-qtray-drawer-head">
      <div>
        <div class="smat-qtray-title">
          {isEs ? 'Bandeja Rápida B2B · Regla cμ' : 'Fast B2B Requisition Tray · cμ Rule'}
        </div>
        <div id="smat-qtray-priority-badge" class="smat-qtray-priority">
          {isEs ? '⚡ P1 · CAJA CHICA (< 25,000 MXN) / OC SAP' : '⚡ P1 · PETTY CASH (< 25,000 MXN) / SAP PO'}
        </div>
      </div>
      <button
        type="button"
        id="smat-qtray-close"
        class="smat-qtray-close-btn"
        aria-label={isEs ? 'Cerrar bandeja' : 'Close tray'}
      >
        ✕
      </button>
    </div>

    <!-- Selector de Carril de Compra -->
    <div class="smat-qtray-lane-grid">
      <button
        type="button"
        data-qtray-lane="CAJA_CHICA_CFDI40"
        class="qtray-lane-btn is-active"
      >
        {isEs ? '⚡ < 25k MXN Caja Chica' : '⚡ < 25k MXN Petty Cash'}
      </button>
      <button
        type="button"
        data-qtray-lane="ORDEN_COMPRA_SAP"
        class="qtray-lane-btn"
      >
        {isEs ? '🏢 > 25k MXN OC SAP' : '🏢 > 25k MXN SAP PO'}
      </button>
    </div>

    <!-- Lista de Partidas -->
    <ul id="smat-qtray-items" class="smat-qtray-items-list">
      <li class="smat-qtray-empty-item">
        {isEs
          ? 'Sin SKUs aún. Haz clic en "+ Agregar a Bandeja" en cualquier ficha.'
          : 'No SKUs yet. Click "+ Add to Quote Tray" on any product card.'}
      </li>
    </ul>

    <!-- Ventana de Reorden Acoplado (s, S) -->
    <div class="smat-qtray-reorder-box">
      <div class="smat-qtray-reorder-title">
        {isEs ? '⏱️ Política de Reorden Acoplado 5:5:4 (s, S):' : '⏱️ Coupled 5:5:4 Reorder Policy (s, S):'}
      </div>
      <div>
        {isEs
          ? 'Día 90: Camisa D075C21 · Día 150: Impulsor E4147 · Día 180: Voluta D3110'
          : 'Day 90: D075C21 Sleeve · Day 150: E4147 Impeller · Day 180: D3110 Volute'}
      </div>
    </div>

    <!-- Intercambio de Casco / Core Trade-In (-22% Remanufactura ISO 281 · D4 / INV-SMAT-SCI-06) -->
    <div class="smat-qtray-tradein-box">
      <label class="smat-qtray-tradein-label">
        <input
          type="checkbox"
          id="smat-qtray-core-tradein"
          data-core-tradein-toggle
          class="smat-qtray-checkbox"
        />
        <span>
          <strong>{isEs ? '♻️ Intercambio de Casco DAM005 (-22% Core Trade-In)' : '♻️ DAM005 Bearing Cartridge Core Trade-In (-22%)'}</strong>
          <span id="smat-qtray-core-badge" class="smat-qtray-tradein-note">
            {isEs
              ? 'Bonificación -22% al entregar tambor GGG40 en tolerancia H7 (INV-SMAT-SCI-06)'
              : '22% credit when returning crack-free GGG40 barrel in H7 tolerance (INV-SMAT-SCI-06)'}
          </span>
        </span>
      </label>
    </div>

    <!-- Acciones de Despacho -->
    <div class="smat-qtray-actions">
      <a
        id="smat-qtray-wa-link"
        href="https://wa.me/526183670664?text=Hola%20SMAT%2C%20solicito%20cotizaci%C3%B3n%20prioritaria%20B2B%20%5BSMAT-DGO%5D"
        target="_blank"
        rel="noopener noreferrer"
        class="smat-qtray-wa-btn"
      >
        {isEs ? '🚀 Enviar Requisición Prioritaria (WhatsApp / Correo)' : '🚀 Dispatch Priority Requisition (WhatsApp / Email)'}
      </a>
      <a
        id="smat-qtray-pdf-link"
        data-qtray-pdf-btn
        href={isEs ? '/acuse/?reorder=1&tray=SMAT-PUMP-IMP-AH:1:PARO_DE_LINEA' : '/en/thank-you/?reorder=1&tray=SMAT-PUMP-IMP-AH:1:PARO_DE_LINEA'}
        class="smat-qtray-pdf-btn"
      >
        {isEs ? '📄 Emitir Hoja PDF / Folio SAP' : '📄 Issue PDF Sheet / SAP Folio'}
      </a>
    </div>
  </div>
</aside>

<script>
  import {
    getTrayState,
    saveTrayState,
    addTrayItem,
    removeTrayItem,
    updateTrayItemQty,
    encodeReorderUrlQuery,
    hydrateTrayFromReorderQuery,
    buildCmuPrioritySubjectLine,
    computeCmuPriorityDescriptor,
    evaluateBearingCartridgeCoreTradeIn,
    syncTrayToWorkbenchStateLens,
    SMAT_TRAY_UPDATE_EVENT
  } from '../scripts/requisitionTrayBus.js';

  function initQuickOrderTray() {
    const root = document.getElementById('smat-quick-order-tray');
    if (!root) return;
    if (typeof window !== 'undefined' && window.location && window.location.search.includes('tray=')) {
      hydrateTrayFromReorderQuery(window.location.search);
    }
    const isEs = root.getAttribute('data-lang') !== 'en';
    const toggleBtn = document.getElementById('smat-qtray-toggle');
    const closeBtn = document.getElementById('smat-qtray-close');
    const drawer = document.getElementById('smat-qtray-drawer');
    const countEl = document.getElementById('smat-qtray-count');
    const itemsEl = document.getElementById('smat-qtray-items');
    const badgeEl = document.getElementById('smat-qtray-priority-badge');
    const waLink = document.getElementById('smat-qtray-wa-link') as HTMLAnchorElement | null;
    const pdfLink = document.getElementById('smat-qtray-pdf-link') as HTMLAnchorElement | null;
    const coreToggle = document.getElementById('smat-qtray-core-tradein') as HTMLInputElement | null;
    const coreBadge = document.getElementById('smat-qtray-core-badge');

    let selectedLane = 'CAJA_CHICA_CFDI40';

    function setDrawerHidden(isHidden: boolean) {
      if (!drawer) return;
      drawer.classList.toggle('hidden', isHidden);
      drawer.hidden = isHidden;
      toggleBtn?.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
    }

    function renderTray() {
      const state = getTrayState();
      const tradeIn = evaluateBearingCartridgeCoreTradeIn(state, coreToggle ? coreToggle.checked : state.coreReturnEnabled);
      if (coreToggle) coreToggle.checked = Boolean(tradeIn.coreReturnEnabled);
      if (coreBadge) {
        coreBadge.textContent = tradeIn.discountPct > 0
          ? (isEs ? `ACTIVO: -${tradeIn.discountPct}% Core Trade-In (${tradeIn.housingMaterial})` : `ACTIVE: -${tradeIn.discountPct}% Core Trade-In (${tradeIn.housingMaterial})`)
          : (isEs ? tradeIn.inspectionGateEs : tradeIn.inspectionGateEn);
      }
      const totalQty = state.items.reduce((acc: number, it: any) => acc + (Number(it.qty) || 1), 0);
      if (countEl) countEl.textContent = String(totalQty);

      const desc = computeCmuPriorityDescriptor({
        urgency: state.criticalityMode === 'PARO_DE_LINEA' ? 'emergency' : 'normal',
        estimatedTotalMxn: selectedLane === 'CAJA_CHICA_CFDI40' ? 18500 : 65000,
        stockRegime: 'hay'
      });
      if (badgeEl) {
        badgeEl.textContent = isEs ? desc.labelEs : desc.labelEn;
      }

      if (itemsEl) {
        if (!state.items.length) {
          itemsEl.innerHTML = `<li class="smat-qtray-empty-item">${
            isEs
              ? 'Sin SKUs aún. Haz clic en "+ Agregar a Bandeja" en cualquier ficha.'
              : 'No SKUs yet. Click "+ Add to Quote Tray" on any product card.'
          }</li>`;
        } else {
          itemsEl.innerHTML = state.items
            .map(
              (item: any) => `
              <li class="smat-qtray-item-row">
                <div>
                  <div class="smat-qtray-item-code">${item.id} × ${item.qty}</div>
                  <div class="smat-qtray-item-name">${isEs ? item.nameEs : item.nameEn}</div>
                </div>
                <div class="smat-qtray-item-controls">
                  <button type="button" data-qtray-qty-delta="-1" data-qtray-item-id="${item.id}" data-qtray-current-qty="${item.qty}" class="smat-qtray-qty-btn" aria-label="Disminuir cantidad">−</button>
                  <button type="button" data-qtray-qty-delta="1" data-qtray-item-id="${item.id}" data-qtray-current-qty="${item.qty}" class="smat-qtray-qty-btn" aria-label="Aumentar cantidad">+</button>
                  <button type="button" data-qtray-remove="${item.id}" class="smat-qtray-remove-btn">✕</button>
                </div>
              </li>`
            )
            .join('');

          itemsEl.querySelectorAll('[data-qtray-qty-delta]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const id = btn.getAttribute('data-qtray-item-id') || '';
              const delta = Number(btn.getAttribute('data-qtray-qty-delta') || 0);
              const currentQty = Number(btn.getAttribute('data-qtray-current-qty') || 1);
              updateTrayItemQty(id, Math.max(0, currentQty + delta));
              renderTray();
            });
          });

          itemsEl.querySelectorAll('[data-qtray-remove]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const id = btn.getAttribute('data-qtray-remove') || '';
              removeTrayItem(id);
              renderTray();
            });
          });
        }
      }

      if (waLink) {
        const subject = buildCmuPrioritySubjectLine(state, { cvPct: 48 });
        const summary = state.items.map((i: any) => `${i.id}(x${i.qty} ${i.material})`).join(', ');
        const coreNote = tradeIn.discountPct > 0 ? ` | Core Trade-In: -${tradeIn.discountPct}%` : '';
        const msg = `[SMAT-DGO] ${subject} | Carril: ${selectedLane}${coreNote} | Partidas: ${summary || 'Consulta directa'}`;
        waLink.href = `https://wa.me/526183670664?text=${encodeURIComponent(msg)}`;
      }

      if (pdfLink) {
        const reorderQuery = encodeReorderUrlQuery(state);
        const basePath = isEs ? '/acuse/' : '/en/thank-you/';
        pdfLink.href = `${basePath}${reorderQuery}&lane=${encodeURIComponent(selectedLane)}`;
      }
    }

    coreToggle?.addEventListener('change', () => {
      const st = getTrayState();
      const updated = saveTrayState({ ...st, coreReturnEnabled: Boolean(coreToggle.checked) });
      syncTrayToWorkbenchStateLens(updated);
      renderTray();
    });

    toggleBtn?.addEventListener('click', () => {
      if (!drawer) return;
      const nextHidden = !drawer.classList.contains('hidden');
      setDrawerHidden(nextHidden);
    });

    closeBtn?.addEventListener('click', () => {
      setDrawerHidden(true);
    });

    root.querySelectorAll('[data-qtray-lane]').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedLane = btn.getAttribute('data-qtray-lane') || 'CAJA_CHICA_CFDI40';
        root.querySelectorAll('[data-qtray-lane]').forEach((b) => {
          b.classList.toggle('is-active', b === btn);
        });
        renderTray();
      });
    });

    document.querySelectorAll('[data-quick-tray-add]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const skuId = btn.getAttribute('data-quick-tray-add') || 'SMAT-PUMP-IMP-AH';
        const title = btn.getAttribute('data-sku-title') || skuId;
        const code = btn.getAttribute('data-sku-code') || skuId;
        const material = btn.getAttribute('data-sku-material') || 'A05';
        const mass = Number(btn.getAttribute('data-sku-mass') || 15);
        addTrayItem({
          id: skuId,
          skuId,
          atomicCode: code,
          nameEs: title,
          nameEn: title,
          material,
          unitWeightKg: mass,
          qty: 1
        });
        setDrawerHidden(false);
        renderTray();
      });
    });

    window.addEventListener(SMAT_TRAY_UPDATE_EVENT, renderTray);
    renderTray();
  }

  initQuickOrderTray();
  document.addEventListener('astro:page-load', initQuickOrderTray);
</script>

<style>
  .smat-qtray-root {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 50;
    max-width: 28rem;
  }

  .smat-qtray-toggle-btn {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1rem;
    border-radius: 9999px;
    border: 2px solid var(--smat-solar-amber-border, #d97706);
    background: var(--smat-solar-surface, #ffffff);
    color: var(--smat-solar-ink, #0f172a);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.16);
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .smat-qtray-toggle-btn:hover {
    background: var(--smat-solar-amber-bg, #fffbeb);
  }

  .smat-qtray-count-pill {
    display: inline-flex;
    height: 20px;
    min-width: 20px;
    align-items: center;
    justify-content: center;
    padding: 0 0.375rem;
    border-radius: 9999px;
    background: #d97706;
    color: #ffffff;
    font-size: 0.6875rem;
    font-weight: 800;
  }

  .smat-qtray-drawer {
    margin-top: 0.5rem;
    width: 340px;
    padding: 1rem;
    border-radius: 16px;
    border: 1px solid var(--smat-solar-border, #cbd5e1);
    background: var(--smat-solar-surface, #ffffff);
    color: var(--smat-solar-ink, #0f172a);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.18);
  }

  @media (min-width: 640px) {
    .smat-qtray-drawer {
      width: 400px;
    }
  }

  .smat-qtray-drawer.hidden,
  .smat-qtray-drawer[hidden] {
    display: none !important;
  }

  .smat-qtray-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.625rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--smat-solar-border, #cbd5e1);
  }

  .smat-qtray-title {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--smat-solar-accent, #b45309);
  }

  .smat-qtray-priority {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--smat-solar-emerald, #047857);
  }

  .smat-qtray-close-btn {
    min-height: 48px;
    min-width: 48px;
    border-radius: 8px;
    border: 1px solid var(--smat-solar-border, #cbd5e1);
    background: var(--smat-solar-bg, #f8fafc);
    color: var(--smat-solar-muted, #334155);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .smat-qtray-close-btn:hover {
    color: var(--smat-solar-ink, #0f172a);
    border-color: #94a3b8;
  }

  .smat-qtray-lane-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.6875rem;
  }

  .qtray-lane-btn {
    padding: 0.5rem 0.625rem;
    border-radius: 8px;
    border: 1px solid var(--smat-solar-border, #cbd5e1);
    background: var(--smat-solar-bg, #f8fafc);
    color: var(--smat-solar-muted, #334155);
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
  }

  .qtray-lane-btn.is-active {
    border-color: var(--smat-solar-emerald-border, #059669);
    background: var(--smat-solar-emerald-bg, #ecfdf5);
    color: var(--smat-solar-emerald, #047857);
    font-weight: 700;
  }

  .smat-qtray-items-list {
    list-style: none;
    margin: 0 0 0.75rem 0;
    padding: 0;
    max-height: 12rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.75rem;
  }

  :global(.smat-qtray-empty-item) {
    padding: 0.5rem 0;
    text-align: center;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    color: var(--smat-solar-muted, #334155);
  }

  :global(.smat-qtray-item-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    background: var(--smat-solar-bg, #f8fafc);
    border: 1px solid var(--smat-solar-border, #cbd5e1);
  }

  :global(.smat-qtray-item-code) {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-weight: 700;
    color: var(--smat-solar-accent, #b45309);
  }

  :global(.smat-qtray-item-name) {
    font-size: 0.6875rem;
    color: var(--smat-solar-ink, #0f172a);
    max-width: 210px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.smat-qtray-remove-btn) {
    padding: 0.25rem 0.5rem;
    border: none;
    background: transparent;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    color: #be123c;
    cursor: pointer;
  }

  .smat-qtray-reorder-box {
    padding: 0.625rem;
    margin-bottom: 0.75rem;
    border-radius: 12px;
    background: var(--smat-solar-bg, #f8fafc);
    border: 1px solid var(--smat-solar-border, #cbd5e1);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.6875rem;
    color: var(--smat-solar-muted, #334155);
  }

  .smat-qtray-reorder-title {
    margin-bottom: 0.125rem;
    font-weight: 700;
    color: var(--smat-solar-accent, #b45309);
  }

  .smat-qtray-tradein-box {
    padding: 0.625rem;
    margin-bottom: 0.75rem;
    border-radius: 12px;
    background: var(--smat-solar-emerald-bg, #ecfdf5);
    border: 1px solid var(--smat-solar-emerald-border, #059669);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.6875rem;
    color: var(--smat-solar-ink, #0f172a);
  }

  .smat-qtray-tradein-label {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    cursor: pointer;
  }

  .smat-qtray-checkbox {
    margin-top: 0.125rem;
    width: 1rem;
    height: 1rem;
    accent-color: #059669;
  }

  .smat-qtray-tradein-note {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.625rem;
    color: var(--smat-solar-emerald, #047857);
  }

  .smat-qtray-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .smat-qtray-wa-btn {
    display: block;
    width: 100%;
    padding: 0.625rem 1rem;
    border-radius: 12px;
    background: #d97706;
    color: #ffffff;
    text-align: center;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    transition: background 0.15s ease;
  }

  .smat-qtray-wa-btn:hover {
    background: #b45309;
  }

  .smat-qtray-pdf-btn {
    display: block;
    width: 100%;
    padding: 0.625rem 1rem;
    border-radius: 12px;
    background: #0f172a;
    color: #ffffff;
    text-align: center;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    transition: background 0.15s ease;
  }

  .smat-qtray-pdf-btn:hover {
    background: #1e293b;
  }

  .smat-qtray-item-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .smat-qtray-qty-btn {
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }
</style>
