---
// src/components/TechnicalDiagrams.astro
// Diagramas técnicos esquemáticos en línea (CAD/corte técnico) para bombas para lodos, piezas de contacto húmedo,
// Bearing Assembly / Housing, mecanismos de flotación/acondicionadores, filtros prensa y balanzas Marcy.

type DiagramKind =
  | 'pump'
  | 'impeller'
  | 'liners'
  | 'bearing'
  | 'expeller'
  | 'flotation'
  | 'filter'
  | 'marcy'
  | 'batch_filter'
  | 'sieves'
  | 'drive_arrangements'
  | 'material_kit_grid'
  | 'suction_throatbush';

interface Props {
  diagram?: DiagramKind;
  type?: DiagramKind;
  lang?: 'es' | 'en';
  compact?: boolean;
}

const { lang = 'es', compact = false } = Astro.props;
const diagram: DiagramKind = Astro.props.diagram ?? Astro.props.type ?? 'pump';
const isEs = lang === 'es';
---

<figure class={`tech-diagram-frame ${compact ? 'tech-diagram-compact' : ''}`} role="img" aria-label={isEs ? `Diagrama técnico: ${diagram}` : `Technical diagram: ${diagram}`}>
  <div class="tech-diagram-header">
    <span class="tech-diagram-code">
      {diagram === 'pump' && (isEs ? 'ESQUEMA DE CORTE • BOMBA PARA LODOS' : 'CROSS-SECTION • SLURRY PUMP')}
      {diagram === 'impeller' && (isEs ? 'DIAGRAMA AXIAL Y FRONTAL • IMPULSOR' : 'AXIAL & FRONT DIAGRAM • IMPELLER')}
      {diagram === 'liners' && (isEs ? 'DESPIECE DE CONTACTO HÚMEDO • ALTO CROMO / HULE / POLIURETANO' : 'WET-END EXPLODED VIEW • HIGH CHROME / RUBBER / POLYURETHANE')}
      {diagram === 'bearing' && (isEs ? 'CONJUNTO COMPLETO • BEARING ASSEMBLY / HOUSING' : 'COMPLETE CARTRIDGE • BEARING ASSEMBLY / HOUSING')}
      {diagram === 'expeller' && (isEs ? 'SELLADO CENTRÍFUGO • EXPULSOR Y PRENSAESTOPA' : 'CENTRIFUGAL SEALING • EXPELLER & STUFFING BOX')}
      {diagram === 'flotation' && (isEs ? 'ESQUEMA MECÁNICO • MECANISMO DE FLOTACIÓN Y ACONDICIONADOR' : 'MECHANICAL DIAGRAM • FLOTATION & CONDITIONER MECHANISM')}
      {diagram === 'filter' && (isEs ? 'ESQUEMA TÉCNICO • FILTRO PRENSA Y PLACAS (800–1500 MM)' : 'TECHNICAL DIAGRAM • FILTER PRESS & PLATES (800–1500 MM)')}
      {diagram === 'marcy' && (isEs ? 'INSTRUMENTACIÓN DE PLANTA • BALANZA DE DENSIDAD DE PULPA (MARCY)' : 'PLANT INSTRUMENTATION • PULP DENSITY SCALE (MARCY)')}
      {diagram === 'batch_filter' && (isEs ? 'CONTROL METALÚRGICO • FILTRO DE PRESIÓN BATCH DE LABORATORIO' : 'METALLURGICAL CONTROL • LABORATORY BATCH PRESSURE FILTER')}
      {diagram === 'sieves' && (isEs ? 'GRANULOMETRÍA • TAMICES CERTIFICADOS ASTM E11 / ISO 3310' : 'PARTICLE SIZING • ASTM E11 / ISO 3310 CERTIFIED TEST SIEVES')}
      {diagram === 'drive_arrangements' && (isEs ? 'CONFIGURACIÓN DE TRANSMISIÓN EN SKID • ARREGLOS CV / ZVZ / CRZ / DC' : 'SKID DRIVE CONFIGURATIONS • CV / ZVZ / CRZ / DC ARRANGEMENTS')}
      {diagram === 'material_kit_grid' && (isEs ? 'COMPARATIVA DE LOTES 5-5-4 • ALTO CROMO (≥650 HB) VS. HULE NATURAL VS. POLIURETANO' : '5-5-4 WET-END KIT COMPARISON • HIGH CHROME (≥650 HB) VS. NATURAL RUBBER VS. POLYURETHANE')}
      {diagram === 'suction_throatbush' && (isEs ? 'GEOMETRÍA DE SUCCIÓN Y CALIBRACIÓN AXIAL • THROATBUSH + IMPULSOR (δ = 0.5–1.0 MM)' : 'SUCTION GEOMETRY & AXIAL CALIBRATION • THROATBUSH + IMPELLER (δ = 0.5–1.0 MM)')}
    </span>
    <span class="tech-diagram-scale">CAD 1:1 REF</span>
  </div>

  <div class="tech-diagram-canvas">
    {diagram === 'pump' && (
      <svg viewBox="0 0 680 280" class="cad-svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-pump" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.6" />
          </pattern>
        </defs>
        <rect width="680" height="280" fill="url(#grid-pump)" />
        <!-- Eje central -->
        <line x1="40" y1="150" x2="640" y2="150" stroke="#94a3b8" stroke-width="1" stroke-dasharray="8 4 2 4" />
        <!-- Succión (Izquierda) -->
        <rect x="65" y="105" width="45" height="90" fill="#f1f5f9" stroke="#0f172a" stroke-width="2" />
        <!-- Cuello (Throatbush) -->
        <polygon points="110,95 145,95 145,120 110,115" fill="#cbd5e1" stroke="#0d78c6" stroke-width="2" />
        <polygon points="110,205 145,205 145,180 110,185" fill="#cbd5e1" stroke="#0d78c6" stroke-width="2" />
        <!-- Voluta (Carcasa espiral) -->
        <path d="M 145 55 L 235 55 L 235 235 L 145 235 Z" fill="#e2e8f0" stroke="#0f172a" stroke-width="2.2" />
        <!-- Descarga Superior -->
        <rect x="165" y="20" width="52" height="35" fill="#e2e8f0" stroke="#0f172a" stroke-width="2" />
        <!-- Impulsor -->
        <rect x="155" y="82" width="55" height="136" rx="4" fill="#fff7ed" stroke="#c25e00" stroke-width="2.4" />
        <line x1="165" y1="95" x2="200" y2="115" stroke="#c25e00" stroke-width="2" />
        <line x1="165" y1="205" x2="200" y2="185" stroke="#c25e00" stroke-width="2" />
        <!-- Plato posterior y Prensaestopa/Expulsor -->
        <rect x="235" y="80" width="38" height="140" fill="#cbd5e1" stroke="#0f172a" stroke-width="1.8" />
        <!-- Flecha (Shaft) -->
        <rect x="210" y="138" width="370" height="24" fill="#94a3b8" stroke="#0f172a" stroke-width="1.8" />
        <!-- Bearing Assembly / Housing -->
        <rect x="330" y="92" width="210" height="116" rx="6" fill="#f8fafc" stroke="#0f172a" stroke-width="2.4" />
        <!-- Rodamientos cónicos -->
        <rect x="348" y="102" width="36" height="36" fill="#dbeafe" stroke="#0d78c6" stroke-width="1.8" />
        <rect x="348" y="162" width="36" height="36" fill="#dbeafe" stroke="#0d78c6" stroke-width="1.8" />
        <rect x="486" y="102" width="36" height="36" fill="#dbeafe" stroke="#0d78c6" stroke-width="1.8" />
        <rect x="486" y="162" width="36" height="36" fill="#dbeafe" stroke="#0d78c6" stroke-width="1.8" />
        <!-- Callouts -->
        <g font-family="SF Mono, Roboto Mono, monospace" font-size="10.5" font-weight="700" fill="#0f172a">
          <line x1="125" y1="95" x2="95" y2="48" stroke="#0d78c6" stroke-width="1.2" />
          <text x="32" y="42" fill="#0d78c6">{isEs ? '1. CUELLO' : '1. THROATBUSH'}</text>
          <text x="165" y="15">{isEs ? '2. VOLUTA / DESCARGA' : '2. VOLUTE / DISCHARGE'}</text>
          <line x1="182" y1="218" x2="182" y2="258" stroke="#c25e00" stroke-width="1.2" />
          <text x="135" y="270" fill="#c25e00">{isEs ? '3. IMPULSOR' : '3. IMPELLER'}</text>
          <line x1="254" y1="80" x2="285" y2="42" stroke="#475569" stroke-width="1.2" />
          <text x="260" y="35">{isEs ? '4. EXPULSOR / PRENSAESTOPA' : '4. EXPELLER / STUFFING BOX'}</text>
          <text x="345" y="82" fill="#0f172a">{isEs ? '5. BEARING ASSEMBLY / HOUSING' : '5. BEARING ASSEMBLY / HOUSING'}</text>
          <text x="352" y="232" fill="#475569">{isEs ? '6. BASE Y AJUSTE AXIAL' : '6. BASE & AXIAL ADJUSTMENT'}</text>
        </g>
      </svg>
    )}

    {diagram === 'impeller' && (
      <svg viewBox="0 0 680 260" class="cad-svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-imp" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.6" />
          </pattern>
        </defs>
        <rect width="680" height="260" fill="url(#grid-imp)" />
        <!-- Vista Frontal (Izquierda) -->
        <circle cx="185" cy="130" r="92" fill="#fff7ed" stroke="#c25e00" stroke-width="2.5" />
        <circle cx="185" cy="130" r="42" fill="#ffffff" stroke="#0f172a" stroke-width="2" />
        <circle cx="185" cy="130" r="18" fill="#e2e8f0" stroke="#0f172a" stroke-width="2" stroke-dasharray="3 2" />
        <!-- 5 Álabes evolventes -->
        <path d="M 185 88 Q 225 75 262 85" fill="none" stroke="#c25e00" stroke-width="3.5" />
        <path d="M 225 118 Q 252 148 242 195" fill="none" stroke="#c25e00" stroke-width="3.5" />
        <path d="M 200 168 Q 168 205 125 198" fill="none" stroke="#c25e00" stroke-width="3.5" />
        <path d="M 145 145 Q 112 125 110 78" fill="none" stroke="#c25e00" stroke-width="3.5" />
        <path d="M 162 95 Q 185 55 225 52" fill="none" stroke="#c25e00" stroke-width="3.5" />
        <!-- Corte Axial (Derecha) -->
        <path d="M 410 42 L 495 42 L 495 102 L 535 102 L 535 158 L 495 158 L 495 218 L 410 218 L 410 168 L 445 168 L 445 92 L 410 92 Z" fill="#fff7ed" stroke="#0f172a" stroke-width="2.2" />
        <!-- Álabes expulsores traseros -->
        <rect x="495" y="46" width="8" height="22" fill="#c25e00" />
        <rect x="495" y="192" width="8" height="22" fill="#c25e00" />
        <!-- Labels -->
        <g font-family="SF Mono, Roboto Mono, monospace" font-size="10.5" font-weight="700" fill="#0f172a">
          <text x="115" y="242">{isEs ? 'VISTA FRONTAL (5 ÁLABES)' : 'FRONT VIEW (5 VANES)'}</text>
          <text x="395" y="242">{isEs ? 'CORTE AXIAL DE IMPULSOR' : 'IMPELLER AXIAL SECTION'}</text>
          <text x="512" y="60" fill="#c25e00">{isEs ? 'ÁLABES EXPULSORES' : 'PUMP-OUT VANES'}</text>
          <text x="545" y="134" fill="#0d78c6">{isEs ? 'ROSCA DE FLECHA' : 'SHAFT THREAD'}</text>
          <text x="315" y="134">{isEs ? 'OJO DE SUCCIÓN' : 'SUCTION EYE'}</text>
        </g>
      </svg>
    )}

    {diagram === 'liners' && (
      <svg viewBox="0 0 680 260" class="cad-svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-lin" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.6" />
          </pattern>
        </defs>
        <rect width="680" height="260" fill="url(#grid-lin)" />
        <line x1="40" y1="135" x2="640" y2="135" stroke="#94a3b8" stroke-width="1" stroke-dasharray="6 4" />
        <!-- 1. Cuello (Throatbush) -->
        <g transform="translate(70, 65)">
          <path d="M 10 0 L 65 10 L 65 45 L 10 45 Z" fill="#dbeafe" stroke="#0d78c6" stroke-width="2.2" />
          <path d="M 10 140 L 65 130 L 65 95 L 10 95 Z" fill="#dbeafe" stroke="#0d78c6" stroke-width="2.2" />
          <text x="0" y="168" font-family="SF Mono, monospace" font-size="11" font-weight="700" fill="#0d78c6">
            {isEs ? '1. CUELLO (x5)' : '1. THROATBUSH (x5)'}
          </text>
        </g>
        <!-- 2. Impulsor -->
        <g transform="translate(230, 58)">
          <rect x="10" y="0" width="68" height="154" rx="5" fill="#fff7ed" stroke="#c25e00" stroke-width="2.4" />
          <line x1="20" y1="28" x2="68" y2="52" stroke="#c25e00" stroke-width="2" />
          <line x1="20" y1="126" x2="68" y2="102" stroke="#c25e00" stroke-width="2" />
          <text x="-5" y="175" font-family="SF Mono, monospace" font-size="11" font-weight="700" fill="#c25e00">
            {isEs ? '2. IMPULSOR (x5)' : '2. IMPELLER (x5)'}
          </text>
        </g>
        <!-- 3. Voluta / Revestimiento -->
        <g transform="translate(390, 42)">
          <path d="M 10 0 L 95 0 L 95 185 L 10 185 L 10 145 L 65 145 L 65 40 L 10 40 Z" fill="#f1f5f9" stroke="#0f172a" stroke-width="2.4" />
          <text x="-5" y="205" font-family="SF Mono, monospace" font-size="11" font-weight="700" fill="#0f172a">
            {isEs ? '3. VOLUTA (x4)' : '3. VOLUTE LINER (x4)'}
          </text>
        </g>
        <!-- 4. Plato posterior (Frame Plate Liner Insert) -->
        <g transform="translate(545, 65)">
          <rect x="10" y="0" width="36" height="140" fill="#e2e8f0" stroke="#475569" stroke-width="2.2" />
          <text x="-15" y="168" font-family="SF Mono, monospace" font-size="11" font-weight="700" fill="#475569">
            {isEs ? '4. PLATO POSTERIOR' : '4. BACK LINER'}
          </text>
        </g>
        <text x="70" y="28" font-family="SF Mono, monospace" font-size="10.5" font-weight="700" fill="#0f172a">
          {isEs ? 'MATERIALES DISPONIBLES: ALTO CROMO • HULE • POLIURETANO' : 'MATERIALS: HIGH CHROME • RUBBER • POLYURETHANE'}
        </text>
      </svg>
    )}

    {diagram === 'bearing' && (
      <svg viewBox="0 0 680 270" class="cad-svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-bear" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.6" />
          </pattern>
        </defs>
        <rect width="680" height="270" fill="url(#grid-bear)" />
        <!-- Eje de simetría -->
        <line x1="30" y1="135" x2="650" y2="135" stroke="#94a3b8" stroke-width="1" stroke-dasharray="8 4 2 4" />
        <!-- Flecha completa con rosca lado impulsor y cuñero lado motor -->
        <rect x="55" y="118" width="565" height="34" fill="#cbd5e1" stroke="#0f172a" stroke-width="2" />
        <!-- Rosca de impulsor (Izquierda) -->
        <rect x="55" y="121" width="48" height="28" fill="#94a3b8" stroke="#0f172a" stroke-width="1.5" />
        <!-- Cuñero lado polea (Derecha) -->
        <rect x="555" y="124" width="52" height="10" fill="#64748b" />
        <!-- Cuerpo cilíndrico del Housing (Cartucho completo) -->
        <rect x="165" y="62" width="340" height="146" rx="6" fill="#f8fafc" stroke="#0f172a" stroke-width="2.6" />
        <!-- Orejas de izaje superiores -->
        <path d="M 225 62 L 240 42 L 260 42 L 275 62" fill="#e2e8f0" stroke="#0f172a" stroke-width="1.8" />
        <path d="M 395 62 L 410 42 L 430 42 L 445 62" fill="#e2e8f0" stroke="#0f172a" stroke-width="1.8" />
        <!-- Tapas de retén y laberintos (End Covers & Labyrinths) -->
        <rect x="150" y="76" width="18" height="118" fill="#0d78c6" stroke="#0f172a" stroke-width="1.8" />
        <rect x="502" y="76" width="18" height="118" fill="#0d78c6" stroke="#0f172a" stroke-width="1.8" />
        <!-- Rodamientos de rodillos cónicos espalda con espalda -->
        <rect x="185" y="74" width="55" height="44" fill="#fff7ed" stroke="#c25e00" stroke-width="2" />
        <rect x="185" y="152" width="55" height="44" fill="#fff7ed" stroke="#c25e00" stroke-width="2" />
        <line x1="185" y1="74" x2="240" y2="118" stroke="#c25e00" stroke-width="1.5" />
        <line x1="185" y1="196" x2="240" y2="152" stroke="#c25e00" stroke-width="1.5" />

        <rect x="430" y="74" width="55" height="44" fill="#fff7ed" stroke="#c25e00" stroke-width="2" />
        <rect x="430" y="152" width="55" height="44" fill="#fff7ed" stroke="#c25e00" stroke-width="2" />
        <line x1="485" y1="74" x2="430" y2="118" stroke="#c25e00" stroke-width="1.5" />
        <line x1="485" y1="196" x2="430" y2="152" stroke="#c25e00" stroke-width="1.5" />
        <!-- Orejeta inferior para tornillo de ajuste axial -->
        <rect x="305" y="208" width="60" height="28" fill="#cbd5e1" stroke="#0f172a" stroke-width="2" />
        <!-- Callouts -->
        <g font-family="SF Mono, Roboto Mono, monospace" font-size="10.5" font-weight="700" fill="#0f172a">
          <text x="48" y="102">{isEs ? 'ROSCA IMPULSOR' : 'IMPELLER THREAD'}</text>
          <text x="140" y="28" fill="#0d78c6">{isEs ? 'SELLOS LABERINTO + END COVERS' : 'LABYRINTH SEALS + END COVERS'}</text>
          <text x="275" y="52" fill="#0f172a">{isEs ? 'HOUSING CILÍNDRICO' : 'CYLINDRICAL HOUSING'}</text>
          <text x="175" y="248" fill="#c25e00">{isEs ? 'RODAMIENTOS CÓNICOS' : 'TAPERED ROLLER BEARINGS'}</text>
          <text x="380" y="248">{isEs ? 'SOPORTE DE AJUSTE AXIAL' : 'AXIAL ADJUSTMENT LUG'}</text>
          <text x="530" y="102">{isEs ? 'FLECHA LADO MOTOR' : 'DRIVE END SHAFT'}</text>
        </g>
      </svg>
    )}

    {diagram === 'expeller' && (
      <svg viewBox="0 0 680 240" class="cad-svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-exp" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.6" />
          </pattern>
        </defs>
        <rect width="680" height="240" fill="url(#grid-exp)" />
        <line x1="50" y1="120" x2="630" y2="120" stroke="#94a3b8" stroke-width="1" stroke-dasharray="6 4" />
        <!-- Flecha y Camisa -->
        <rect x="100" y="102" width="460" height="36" fill="#cbd5e1" stroke="#0f172a" stroke-width="2" />
        <rect x="240" y="92" width="190" height="10" fill="#fff7ed" stroke="#c25e00" stroke-width="1.8" />
        <rect x="240" y="138" width="190" height="10" fill="#fff7ed" stroke="#c25e00" stroke-width="1.8" />
        <!-- Expulsor Centrífugo -->
        <rect x="170" y="48" width="46" height="144" fill="#dbeafe" stroke="#0d78c6" stroke-width="2.2" />
        <!-- Anillo Expulsor / Prensaestopa -->
        <rect x="255" y="60" width="130" height="32" fill="#e2e8f0" stroke="#0f172a" stroke-width="2" />
        <rect x="255" y="148" width="130" height="32" fill="#e2e8f0" stroke="#0f172a" stroke-width="2" />
        <!-- Empaquetadura trenzada -->
        <rect x="295" y="72" width="70" height="20" fill="#fde68a" stroke="#b45309" stroke-width="1.5" />
        <rect x="295" y="148" width="70" height="20" fill="#fde68a" stroke="#b45309" stroke-width="1.5" />
        <g font-family="SF Mono, monospace" font-size="10.5" font-weight="700" fill="#0f172a">
          <text x="125" y="36" fill="#0d78c6">{isEs ? '1. EXPULSOR CENTRÍFUGO' : '1. CENTRIFUGAL EXPELLER'}</text>
          <text x="275" y="45">{isEs ? '2. PRENSAESTOPA Y EMPAQUETADURA' : '2. STUFFING BOX & PACKING'}</text>
          <text x="240" y="215" fill="#c25e00">{isEs ? '3. CAMISA DE FLECHA (SIN SELLO MECÁNICO)' : '3. SHAFT SLEEVE (NO MECHANICAL SEAL)'}</text>
        </g>
      </svg>
    )}

    {diagram === 'flotation' && (
      <svg viewBox="0 0 680 270" class="cad-svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-flot" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.6" />
          </pattern>
        </defs>
        <rect width="680" height="270" fill="url(#grid-flot)" />
        <!-- Cabezal y Polea Superior -->
        <rect x="255" y="22" width="170" height="38" rx="4" fill="#cbd5e1" stroke="#0f172a" stroke-width="2.2" />
        <!-- Housing de rodamientos vertical -->
        <rect x="305" y="60" width="70" height="65" fill="#f8fafc" stroke="#0f172a" stroke-width="2.2" />
        <!-- Tubo de aire concéntrico y flecha -->
        <rect x="318" y="125" width="44" height="82" fill="#dbeafe" stroke="#0d78c6" stroke-width="2" />
        <line x1="340" y1="22" x2="340" y2="245" stroke="#0f172a" stroke-width="2" stroke-dasharray="6 3" />
        <!-- Rotor / Impulsor y Estator / Difusor inferior -->
        <rect x="245" y="198" width="190" height="44" rx="4" fill="#fff7ed" stroke="#c25e00" stroke-width="2.4" />
        <rect x="285" y="204" width="110" height="32" fill="#fde68a" stroke="#b45309" stroke-width="2" />
        <!-- Callouts -->
        <g font-family="SF Mono, monospace" font-size="10.5" font-weight="700" fill="#0f172a">
          <text x="440" y="45">{isEs ? '1. TRANSMISIÓN Y POLEA' : '1. DRIVE & PULLEY HEAD'}</text>
          <text x="390" y="95">{isEs ? '2. PORTA-RODAMIENTOS VERTICAL' : '2. VERTICAL BEARING HOUSING'}</text>
          <text x="378" y="165" fill="#0d78c6">{isEs ? '3. COLUMNA / TUBO DE AIRE' : '3. STANDPIPE / AIR COLUMN'}</text>
          <text x="448" y="225" fill="#c25e00">{isEs ? '4. ROTOR - ESTATOR / IMPULSOR' : '4. ROTOR - STATOR / IMPELLER'}</text>
          <text x="55" y="225">{isEs ? 'CELDAS Y ACONDICIONADORES' : 'CELLS & CONDITIONERS'}</text>
        </g>
      </svg>
    )}

    {diagram === 'filter' && (
      <svg viewBox="0 0 680 250" class="cad-svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-filt" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e2e8f0" stroke-width="0.6" />
          </pattern>
        </defs>
        <rect width="680" height="250" fill="url(#grid-filt)" />
        <!-- Vigas laterales -->
        <line x1="75" y1="85" x2="605" y2="85" stroke="#0f172a" stroke-width="4" />
        <line x1="75" y1="175" x2="605" y2="175" stroke="#0f172a" stroke-width="4" />
        <!-- Cabezal fijo -->
