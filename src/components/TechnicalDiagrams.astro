---
// src/components/TechnicalDiagrams.astro — Despachador Tipado < 120 LOC (D2-V50 / SLICE-V50-13)
import PumpDiagrams from './diagrams/PumpDiagrams.astro';
import CycloneScreenDiagrams from './diagrams/CycloneScreenDiagrams.astro';
import FlotationFiltrationDiagrams from './diagrams/FlotationFiltrationDiagrams.astro';
import LabMetrologyDiagrams from './diagrams/LabMetrologyDiagrams.astro';

type DiagramKind = 'pump' | 'impeller' | 'liners' | 'bearing' | 'expeller' | 'flotation' | 'filter' | 'marcy' | 'batch_filter' | 'sieves' | 'drive_arrangements' | 'material_kit_grid' | 'suction_throatbush' | 'impulsor' | 'revestimientos' | 'throatbush' | 'sello' | 'soporte' | 'bombeo' | 'clasificacion' | 'desaguado' | 'flotacion' | 'impeller-5-vane-d4147a05' | 'throatbush-d4083a05' | 'volute-liner-d4110a05' | 'fpl-insert-d4041a05' | 'cover-plate-liner-d4018r55' | 'back-liner-d4032r55' | 'shaft-sleeve-d075c21' | 'expeller-d4028a05' | 'expeller-ring-d4029a05' | 'bearing-cartridge-d005m' | 'cyclone-apex-vortex' | 'cyclone-liners-kit' | 'flotation-rotor-stator' | 'flotation-cell-assembly' | 'pinch-knife-valve' | 'filter-press-plate-cloth' | 'marcy-scale-kit' | 'cyclone_d6_d20' | 'coupled_pump_cyclone' | 'urethane_screen_th48' | 'lab_comminution_pan' | 'filter_plate_shifter' | 'marcy_scale' | 'astm_sieves' | 'impeller_5vane' | 'wet_kit_554' | 'expeller_seal' | 'bearing_cartridge' | 'volute_liner' | 'filter_press' | 'flotation_cell' | 'urethane_screen_panel_305';

interface Props {
  diagram?: DiagramKind | string;
  type?: DiagramKind | string;
  lang?: 'es' | 'en';
  compact?: boolean;
  showXrayOverlay?: boolean;
  instanceId?: string;
}

const { lang = 'es', compact = false, showXrayOverlay = true, instanceId } = Astro.props;
const seq = ((globalThis as any).__smatSvgInstanceSeq = ((globalThis as any).__smatSvgInstanceSeq || 0) + 1);
const uid = instanceId || `s${seq}`;
const rawDiagram = (Astro.props.diagram ?? Astro.props.type ?? 'pump') as string;
const DIAGRAM_ALIAS_MAP: Record<string, string> = {
  impulsor: 'impeller', revestimientos: 'liners', throatbush: 'suction_throatbush', sello: 'expeller',
  soporte: 'marcy', bombeo: 'pump', clasificacion: 'cyclone-apex-vortex', desaguado: 'sieves',
  'urethane_screen_panel_305': 'urethane_screen_th48', flotacion: 'flotation',
  'impeller-5-vane-d4147a05': 'impeller', 'throatbush-d4083a05': 'suction_throatbush',
  'volute-liner-d4110a05': 'liners', 'fpl-insert-d4041a05': 'back-liner-d4032r55',
  'cover-plate-liner-d4018r55': 'liners', 'expeller-d4028a05': 'expeller',
  'bearing-cartridge-d005m': 'bearing', 'cyclone-liners-kit': 'cyclone-apex-vortex',
  'flotation-cell-assembly': 'flotation', 'marcy-scale-kit': 'marcy', marcy_scale: 'marcy',
  astm_sieves: 'sieves', impeller_5vane: 'impeller', wet_kit_554: 'material_kit_grid',
  expeller_seal: 'expeller', bearing_cartridge: 'bearing', volute_liner: 'liners',
  filter_press: 'filter', flotation_cell: 'flotation'
};
const diagram = (DIAGRAM_ALIAS_MAP[rawDiagram] || rawDiagram) as DiagramKind;
const isEs = lang === 'es';
const xrayWearClass = showXrayOverlay ? 'smat-xray-visible' : 'smat-xray-hidden';
const TITLES: Record<string, [string, string]> = {
  pump: ['ESQUEMA DE CORTE • BOMBA PARA LODOS', 'CROSS-SECTION • SLURRY PUMP'],
  impeller: ['DIAGRAMA AXIAL Y FRONTAL • IMPULSOR 5 ÁLABES', 'AXIAL & FRONT DIAGRAM • 5-VANE IMPELLER'],
  liners: ['DESPIECE DE CONTACTO HÚMEDO • ALTO CROMO / HULE / POLIURETANO', 'WET-END EXPLODED VIEW • HIGH CHROME / RUBBER / POLYURETHANE'],
  bearing: ['CONJUNTO COMPLETO • BEARING ASSEMBLY / HOUSING', 'COMPLETE CARTRIDGE • BEARING ASSEMBLY / HOUSING'],
  expeller: ['SELLADO CENTRÍFUGO • EXPULSOR Y PRENSAESTOPA', 'CENTRIFUGAL SEALING • EXPELLER & STUFFING BOX'],
  flotation: ['ESQUEMA MECÁNICO • MECANISMO DE FLOTACIÓN Y ACONDICIONADOR', 'MECHANICAL DIAGRAM • FLOTATION & CONDITIONER MECHANISM'],
  filter: ['ESQUEMA TÉCNICO • FILTRO PRENSA Y PLACAS (800–1500 MM)', 'TECHNICAL DIAGRAM • FILTER PRESS & PLATES (800–1500 MM)'],
  marcy: ['INSTRUMENTACIÓN DE PLANTA • BALANZA DE DENSIDAD DE PULPA (MARCY)', 'PLANT INSTRUMENTATION • PULP DENSITY SCALE (MARCY)'],
  batch_filter: ['CONTROL METALÚRGICO • FILTRO DE PRESIÓN BATCH DE LABORATORIO', 'METALLURGICAL CONTROL • LABORATORY BATCH PRESSURE FILTER'],
  sieves: ['GRANULOMETRÍA • TAMICES CERTIFICADOS ASTM E11 / ISO 3310', 'PARTICLE SIZING • ASTM E11 / ISO 3310 CERTIFIED TEST SIEVES'],
  drive_arrangements: ['TRANSMISIÓN EN BASE • ARREGLOS CV / ZVZ / CRZ / DC', 'BASE DRIVE CONFIGURATIONS • CV / ZVZ / CRZ / DC'],
  material_kit_grid: ['LOTES 5-5-4 • ALTO CROMO (≥650 HB) VS. HULE VS. POLIURETANO', '5-5-4 WET-END KITS • HIGH CHROME (≥650 HB) VS. RUBBER VS. PU'],
  suction_throatbush: ['GEOMETRÍA DE SUCCIÓN • THROATBUSH + IMPULSOR (δ = 0.5–1.0 MM)', 'SUCTION GEOMETRY • THROATBUSH + IMPELLER (δ = 0.5–1.0 MM)'],
  'shaft-sleeve-d075c21': ['CORTE TÉCNICO • CAMISA DE FLECHA (D075C21)', 'TECHNICAL SECTION • SHAFT SLEEVE (D075C21)'],
  'expeller-ring-d4029a05': ['CORTE LABERINTO SECO • ANILLO EXPULSOR (D4029)', 'DRY LABYRINTH • EXPELLER RING (D4029)'],
  'back-liner-d4032r55': ['CORTE POSTERIOR • FORRO DE PLATO / FPL INSERT (D4041)', 'REAR LINER • FRAME PLATE LINER / FPL (D4041)'],
  'cyclone-apex-vortex': ['HIDROCICLÓN • BOQUILLA APEX Y VORTEX FINDER', 'HYDROCYCLONE • APEX SPIGOT & VORTEX FINDER'],
  'flotation-rotor-stator': ['CELDA • ROTOR-ESTATOR DROP-IN (Dr/Ds)', 'CELL • DROP-IN ROTOR-STATOR (Dr/Ds)'],
  'pinch-knife-valve': ['CONTROL DE FLUJO • VÁLVULA PINCH Y CUCHILLA', 'FLOW CONTROL • PINCH & KNIFE GATE VALVE'],
  'filter-press-plate-cloth': ['DESHIDRATACIÓN NOM-141 • PLACA PP Y TELA', 'NOM-141 DEWATERING • PP PLATE & CLOTH'],
  cyclone_d6_d20: ['HIDROCICLÓN 5 ZONAS (D6–D20) • CORTE PLITT d50c', '5-ZONE HYDROCYCLONE (D6–D20) • PLITT d50c CUT'],
  coupled_pump_cyclone: ['PAQUETE CASADO BOMBA + HIDROCICLÓN 5:5:4', 'COUPLED PUMP + HYDROCYCLONE 5:5:4 PACKAGE'],
  urethane_screen_th48: ['MALLA URETANO TH48-30 Y MÓDULO 1\'X1\' • 3°–5°', 'TH48-30 URETHANE SCREEN & 1\'X1\' DECK • 3°–5°'],
  lab_comminution_pan: ['CONMINUCIÓN Y TENTADURA • DISCOS CR27 Y BATEA', 'LAB COMMINUTION & PANNING • CR27 DISCS & PAN'],
  filter_plate_shifter: ['CINEMÁTICA CORRE-PLACAS • INDEXADOR Y CADENA', 'PLATE SHIFTER KINEMATICS • PAWL & DRIVE CHAIN']
};
const activeTitle = (TITLES[diagram] || TITLES.pump)[isEs ? 0 : 1];
---
<figure class={`tech-diagram-frame ${compact ? 'tech-diagram-compact' : ''}`} role="img" data-diagram-id={rawDiagram} data-resolved-diagram={diagram} aria-label={isEs ? `Diagrama técnico: ${rawDiagram}` : `Technical diagram: ${rawDiagram}`}>
  <div class="tech-diagram-header">
    <span class="tech-diagram-code">{activeTitle}</span>
    <span class="tech-diagram-scale" data-iso7810-scale="0.76mm">{isEs ? 'CAD 1:1 • REF. TARJETA ISO 7810 (0.76 MM)' : 'CAD 1:1 • ISO 7810 CARD REF (0.76 MM)'}</span>
  </div>
  <div class="tech-diagram-canvas">
    <PumpDiagrams diagram={diagram} isEs={isEs} xrayWearClass={xrayWearClass} uid={uid} />
    <CycloneScreenDiagrams diagram={diagram} isEs={isEs} xrayWearClass={xrayWearClass} uid={uid} />
    <FlotationFiltrationDiagrams diagram={diagram} isEs={isEs} xrayWearClass={xrayWearClass} uid={uid} />
    <LabMetrologyDiagrams diagram={diagram} isEs={isEs} xrayWearClass={xrayWearClass} uid={uid} />
  </div>
  {showXrayOverlay && (
    <figcaption class="tech-diagram-xray-bar" data-layer="xray-wear">
      <span class="xray-band xray-band--critical"><i class="xray-dot smat-xray-red"></i>{isEs ? 'Rojo (#dc2626): Zona Abrasión Crítica / Claro δ' : 'Red (#dc2626): Critical Wear / δ Gap'}</span>
      <span class="xray-band xray-band--medium"><i class="xray-dot smat-xray-solar"></i>{isEs ? 'Ámbar (#7c2d12): Desgaste Secundario / Sellado' : 'Amber (#7c2d12): Secondary Wear / Sealing'}</span>
      <span class="xray-band xray-band--structural"><i class="xray-dot smat-xray-blue"></i>{isEs ? 'Azul (#0284c7): Soporte / Ajuste 1:1' : 'Blue (#0284c7): Support / 1:1 Fit'}</span>
      <span class="xray-band xray-band--iso">{isEs ? 'Escala cotidiana: 1 Tarjeta ISO/IEC 7810 = 0.76 mm' : 'Everyday scale: 1 ISO/IEC 7810 Card = 0.76 mm'}</span>
    </figcaption>
  )}
</figure>
<style>
  .tech-diagram-frame { margin: 1.5rem 0; background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 6px rgba(15,23,42,.04); }
  .tech-diagram-compact { margin: .75rem 0 1rem; }
  .tech-diagram-header { display: flex; justify-content: space-between; align-items: center; padding: .5rem .9rem; background: #f8fafc; border-bottom: 1px solid #e2e8f0; font-family: var(--smat-font-mono, monospace); font-size: .72rem; font-weight: 700; color: #334155; letter-spacing: .04em; }
  .tech-diagram-scale { color: #075985; background: #f0f9ff; padding: .1rem .45rem; border-radius: 4px; border: 1px solid #bae6fd; }
  .tech-diagram-canvas { padding: .5rem; background: #fff; }
  :global(.cad-svg) { width: 100%; height: auto; display: block; }
  .tech-diagram-xray-bar { display: flex; flex-wrap: wrap; gap: .65rem 1.1rem; align-items: center; padding: .45rem .9rem; background: #f8fafc; border-top: 1px solid #e2e8f0; font-family: var(--smat-font-mono, monospace); font-size: .7rem; color: #334155; }
  .xray-band { display: inline-flex; align-items: center; gap: .35rem; font-weight: 600; }
  .xray-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; }
  .smat-xray-red { background: #dc2626; } .smat-xray-solar { background: #7c2d12; } .smat-xray-blue { background: #0284c7; }
  .xray-band--iso { margin-left: auto; color: #0f172a; background: #fef3c7; padding: .1rem .45rem; border-radius: 4px; border: 1px solid #fde68a; }
</style>
