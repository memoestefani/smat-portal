---
/**
 * FiltrationCore.astro
 * ---------------------------------------------------------------------------
 * Núcleo Único Compartido de Filtración y Desaguado (`D3-V51` / `D4-V57`):
 * Refactorizado en `<InstrumentShell>` Input-First con CTA y SKU principal único por vista.
 */
import InstrumentShell from './InstrumentShell.astro';

interface Props {
  locale?: 'es' | 'en';
  variant?: 'hub' | 'press' | 'parts';
  showVerticalActions?: boolean;
  panelClass?: string;
}

const { locale = 'es', variant = 'hub', showVerticalActions = false, panelClass = '' } = Astro.props;
const isEs = locale === 'es';
const quoteBase = isEs ? '/cotizar/' : '/en/quote/';
const productsBase = isEs ? '/productos/' : '/en/products/';
const quoteEquipo = variant === 'parts' ? 'placas_telas' : 'filtro_prensa';
const defaultPressureBar = variant === 'press' ? '16' : '12';
const defaultPlateWidth = variant === 'press' ? '1500' : '1200';
---

<InstrumentShell
  id="wb-filt-timoshenko-live-box"
  dataTestId="wb-filt-timoshenko-live-box"
  domainRoot="filtration"
  shellClass={panelClass}
  locale={locale}
  detailsSummaryEs="Ver desglose de ciclo, ΔP asimétrica, fichas 16 bar y memoria Darcy-Ruth / Timoshenko"
  detailsSummaryEn="View cycle breakdown, asymmetric ΔP, 16-bar sheets & Darcy-Ruth / Timoshenko basis"
>
  <div slot="header" class="smat-flex-between">
    <strong class="embedded-filt-title">
      {isEs
        ? 'VERIFICADOR EN VIVO: RESISTENCIA DE PLACAS A 16 BAR Y CICLO DE FILTRADO'
        : 'LIVE VERIFIER: 16-BAR PLATE STRENGTH & FILTRATION CYCLE'}
    </strong>
    <div class="smat-chip-row">
      <span id="filt-nom141-badge" class="smat-badge-emerald">
        {isEs ? 'NOM-141 Humedad OK (14% ≤ 16%)' : 'NOM-141 Moisture OK (14% ≤ 16%)'}
      </span>
    </div>
  </div>

  <!-- Entradas primarias arriba -->
  <div slot="inputs">
    <div class="smat-inputs-2col smat-mt-sm">
      <div class="form-group">
        <label class="smat-field-label" for="filt-plate-width">
          {isEs ? 'Formato Placa (mm):' : 'Plate Format (mm):'}
        </label>
        <select id="filt-plate-width" data-schema-input="filtration.plateWidthMm" class="smat-input-control wb-select font-mono-tech" data-wb-circuit-calc-input>
          <option value="800">800 × 800 mm</option>
          <option value="1000">1000 × 1000 mm</option>
          <option value="1200" selected={defaultPlateWidth === '1200'}>1200 × 1200 mm</option>
          <option value="1500" selected={defaultPlateWidth === '1500'}>1500 × 1500 mm</option>
          <option value="2000">2000 × 2000 mm</option>
        </select>
      </div>
      <div class="form-group">
        <label class="smat-field-label" for="wb-filt-pressure">
          {isEs ? 'Presión Alimentación (bar):' : 'Feed Pressure (bar):'}
        </label>
        <input type="number" id="wb-filt-pressure" data-schema-input="filtration.feedPressureBar" min="4" max="25" step="1" value={defaultPressureBar} class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
      </div>
      <div class="form-group">
        <label class="smat-field-label" for="filt-cake-moisture">
          {isEs ? 'Humedad Residual Meta (%):' : 'Target Moisture (%):'}
        </label>
        <input type="number" id="filt-cake-moisture" data-schema-input="filtration.cakeMoistureTargetPct" min="8" max="28" step="0.5" value="14" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
      </div>
    </div>

    <details class="wb-progressive-drawer smat-mt-sm" id="filt-tier2-params">
      <summary class="wb-progressive-summary">
        <span>
          {isEs
            ? 'Parámetros estructurales avanzados: Puertos obstruidos y espesor de placa'
            : 'Advanced Structural Parameters: Clogged Ports & Plate Thickness'}
        </span>
        <span>▾</span>
      </summary>
      <div class="smat-inputs-2col smat-mt-sm">
        <div class="form-group">
          <label class="smat-field-label" for="wb-filt-clogged">
            {isEs ? 'Puertos Obstruidos (0–4):' : 'Clogged Ports (0–4):'}
          </label>
          <input type="number" id="wb-filt-clogged" data-schema-input="filtration.cloggedPortsCount" min="0" max="4" step="1" value="0" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
        </div>
        <div class="form-group">
          <label class="smat-field-label" for="wb-filt-thickness">
            {isEs ? 'Espesor Alma Placa (mm):' : 'Plate Thickness (mm):'}
          </label>
          <input type="number" id="wb-filt-thickness" data-schema-input="filtration.plateThicknessMm" min="40" max="120" step="5" value="65" class="smat-input-control wb-input font-mono-tech" data-wb-circuit-calc-input />
        </div>
      </div>
    </details>
  </div>

  <!-- Veredicto compacto: 4 KPIs + CTAs -->
  <div slot="verdict">
    <div class="instrument-kpi-bar font-mono-tech">
      <div class="instrument-kpi-cell">
        <strong>{isEs ? 'Esfuerzo σ_max:' : 'Bending σ_max:'}</strong>
        <span id="wb-filt-res-stress" data-testid="wb-filt-res-stress" data-schema-output="filtration.maxBendingStressMpa">3.54 MPa</span>
      </div>
      <div class="instrument-kpi-cell">
        <strong>{isEs ? 'Seguridad Placa:' : 'Plate Safety:'}</strong>
        <span id="wb-filt-res-fs" data-testid="wb-filt-res-fs" data-schema-output="filtration.flexuralSafetyFactor">FS 4.10</span>
      </div>
      <div class="instrument-kpi-cell">
        <strong>{isEs ? 'Capacidad / NOM-141:' : 'Capacity / NOM-141:'}</strong>
        <span id="wb-filt-res-cycles" data-testid="wb-filt-res-cycles" data-schema-output="filtration.cyclesPerDay">36 c/d</span> · <span id="wb-filt-res-tpd" data-testid="wb-filt-res-tpd" data-schema-output="filtration.dryTonnesPerDay">285 t/d</span> · <span id="wb-filt-res-nom141" data-testid="wb-filt-res-nom141" data-schema-output="filtration.nom141Compliant">{isEs ? 'Cumple NOM-141' : 'NOM-141 OK'}</span>
      </div>
      <div class="instrument-kpi-cell">
        <strong>{isEs ? 'Placas / Tela / Corre-Placas:' : 'Plates / Cloth / Shifter:'}</strong>
        <span id="wb-filt-res-skus" data-testid="wb-filt-res-skus">{isEs ? `Placa PP ${defaultPlateWidth} mm · Lona 750 g/m² · Corre-Placas` : `${defaultPlateWidth} mm PP Plate · 750 g/m² Cloth · Shifter`}</span>
      </div>
    </div>

    {showVerticalActions && (
      <div class="smat-cta-row smat-mt-sm">
        <a
          href={`${quoteBase}?circuito=filtracion&equipo=${quoteEquipo}&serie=${defaultPlateWidth}&filt_condition=${variant === 'parts' ? 'fuga_chorreo' : 'jales_secos'}#rfq`}
          data-quote-base={quoteBase}
          class="btn btn-primary smat-tap-btn"
        >
          {isEs ? 'Cotizar Calibrado →' : 'Quote Calibrated Unit →'}
        </a>
        <button
          type="button"
          class="btn btn-outline btn-avenue-tray smat-tap-btn"
          data-vertical-tray-btn
          data-add-tray-sku="SMAT-FILT-CLOTH-PLATE"
          data-tray-part-code={`PP-${defaultPlateWidth}`}
          data-tray-title={isEs ? `Placas Polipropileno y Telas ${defaultPlateWidth} mm (16 bar)` : `16 bar PP Plates & Filter Cloths ${defaultPlateWidth} mm`}
          data-tray-series={defaultPlateWidth}
          data-tray-material="PP"
          data-tray-circuit="filtracion"
          data-tray-source={`filtration_${variant}_stratum1_calc`}
        >
          {isEs ? '+ Bandeja Lonas / Placas' : '+ Tray Cloths / Plates'}
        </button>
      </div>
    )}
  </div>

  <div slot="details">
    <p class="smat-basis-note font-mono-tech smat-mb-sm">
      {isEs ? 'Base de cálculo: filtración a presión constante (Darcy-Ruth) y flexión de placa (Timoshenko).' : 'Calculation basis: constant-pressure filtration (Darcy-Ruth) & plate flexure (Timoshenko).'}
    </p>
    <div class="embedded-filt-res smat-stratum1-display font-mono-tech">
      <div class="embedded-res-cell"><strong>{isEs ? 'Desglose Ciclo:' : 'Cycle Timing:'}</strong> <span id="wb-filt-res-cycle-min" data-testid="wb-filt-res-cycle-min">{isEs ? 'Filtrado 18.0 min + Descarga 12 min = 30.0 min' : 'Filtration 18.0 min + Turnaround 12 min = 30.0 min'}</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'ΔP Asimétrica / Fatiga:' : 'Asymmetric ΔP / Fatigue:'}</strong> <span id="wb-filt-res-asym-dp" data-testid="wb-filt-res-asym-dp">ΔP = 0.00 MPa | σ_adm,PP = 14.5 MPa</span></div>
      <div class="embedded-res-cell"><strong>{isEs ? 'Resumen Operativo:' : 'Operating Summary:'}</strong> <span id="wb-filt-res-status" data-testid="wb-filt-res-status">{isEs ? 'Cumple NOM-141 · Ciclo estable Darcy-Ruth / Timoshenko' : 'NOM-141 OK · Stable Darcy-Ruth / Timoshenko cycle'}</span></div>
    </div>
    {showVerticalActions && (
      <div class="smat-cta-row smat-mt-sm">
        <a href={`${productsBase}${isEs ? 'lonas-y-placas-filtro-prensa-16bar/' : 'filter-press-cloths-and-pp-plates-16bar/'}`} class="btn btn-outline smat-tap-btn">
          {isEs ? 'Ver Placas y Lonas 16 bar →' : 'View 16 bar Plates & Cloths →'}
        </a>
        <a href={`${productsBase}${isEs ? 'mecanismo-plate-shifter-y-cadenas/' : 'filter-press-plate-shifter-and-chains/'}`} class="btn btn-outline smat-tap-btn">
          {isEs ? 'Ver Corre-Placas y Cadenas →' : 'View Plate Shifter & Chains →'}
        </a>
      </div>
    )}
  </div>
</InstrumentShell>
