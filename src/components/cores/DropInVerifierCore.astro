---
/**
 * DropInVerifierCore.astro
 * ---------------------------------------------------------------------------
 * Primitiva Compartida Única del Verificador Dimensional Drop-In (`SLICE-V51-22`, `D7-V51`).
 * Montada en `/`, `/equipos/` y `/catalogo/` (ES & EN) sin bifurcaciones condicionales de modo ni estilos inline.
 */
interface Props {
  lang?: 'es' | 'en';
  variant?: 'catalog' | 'home' | 'equipment';
  containerId?: string;
  inputId?: string;
  attachVerifierAttr?: boolean;
}

const {
  lang = 'es',
  variant = 'catalog',
  containerId,
  inputId,
  attachVerifierAttr = true,
} = Astro.props;

const isEs = lang === 'es';
const resolvedInputId =
  inputId ||
  (variant === 'catalog'
    ? 'catalog-dropin-input-field'
    : variant === 'home'
      ? 'home-dropin-input-field'
      : 'equipment-dropin-input-field');
---

<div
  id={containerId}
  class={`smat-dropin-core smat-dropin-core--${variant}`}
  data-domain-root="dropIn"
  data-dropin-verifier={attachVerifierAttr ? '' : undefined}
  data-dropin-variant={variant}
>
  <div class="dropin-copy">
    <strong class="smat-kicker">
      {isEs
        ? 'VERIFICADOR DE EQUIVALENCIA GEOMÉTRICA DROP-IN (ISO 2768-m)'
        : 'DROP-IN GEOMETRIC EQUIVALENCE VERIFIER (ISO 2768-m)'}
    </strong>
    <p class="dropin-helper-text">
      {isEs
        ? 'Ingresa el código de plano o número fundido en tu pieza actual (ej. E4147A05, D075C21, DAM005, TH48-30, SMAT-PUMP-IMP-AH):'
        : 'Enter the casting code or drawing number on your wear part (e.g. E4147A05, D075C21, DAM005, TH48-30, SMAT-PUMP-IMP-AH):'}
    </p>
  </div>

  <div class="smat-cta-row compact-row dropin-input-row">
    <label for={resolvedInputId} class="smat-sr-only">
      {isEs ? 'Código de plano o parte para verificar equivalencia 1:1' : 'Drawing or part code to check 1:1 drop-in fit'}
    </label>
    <input
      id={resolvedInputId}
      type="text"
      data-dropin-input
      data-schema-input="dropIn.rawPartQuery"
      placeholder={isEs
        ? 'Código o SKU (ej. E4147A05, D075C21, DAM005)...'
        : 'Code or SKU (e.g. E4147A05, D075C21, DAM005)...'}
      aria-label={isEs ? 'Código de parte para verificar equivalencia Drop-In' : 'Part code to check Drop-In fit'}
      class="smat-search-input"
    />
    <button type="button" data-dropin-btn class="smat-btn-primary">
      {isEs ? 'Verificar Equivalencia 1:1 →' : 'Verify 1:1 Fit →'}
    </button>
  </div>

  <div class="smat-dropin-root-badge font-mono-tech">
    <span>{isEs ? 'Compatibilidad 1:1:' : '1:1 Fit Match:'}</span>
    <code data-dropin-root data-schema-output="dropIn.normalizedRoot">—</code>
    <span data-dropin-alloy data-schema-output="dropIn.alloySuffix" class="smat-dropin-meta-pill">—</span>
    <span data-dropin-sat data-schema-output="dropIn.satTuple" class="smat-dropin-meta-pill">—</span>
  </div>

  <div
    data-dropin-result
    data-schema-output="dropIn.canonicalSkuId"
    class="smat-result-box dropin-result-banner smat-hidden-init"
    hidden
  ></div>
</div>
