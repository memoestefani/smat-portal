---
// src/components/CircuitNavigator.astro
// Decisión 1-A + Consolidación 3.2.2: Navegador Unificado de Circuitos y Reglas Metalúrgicas por Rol (Zero-Debris)
import circuitsData from '../../data/circuits.json';
import rolesData from '../../data/roles.json';

interface Props {
  lang?: 'es' | 'en';
  defaultCircuit?: 'bombeo_ciclones' | 'flotacion_polimetalica' | 'jales_filtracion';
  currentCircuit?: string;
}

const { lang = 'es', defaultCircuit, currentCircuit } = Astro.props;
const isEn = lang === 'en';
const circuits = circuitsData.circuits;

const resolvedDefaultCircuit = defaultCircuit || (
  currentCircuit === 'flotacion' || currentCircuit === 'flotacion_polimetalica'
    ? 'flotacion_polimetalica'
    : currentCircuit === 'filtracion' || currentCircuit === 'jales_filtracion'
      ? 'jales_filtracion'
      : 'bombeo_ciclones'
);

// Mapa unificado de criterios metalúrgicos y variables de pulpa por role_id (absorbe DualHubView.astro)
const roleDecisionMap = new Map<string, any>();
for (const vert of rolesData.verticals || []) {
  for (const item of [...(vert.capex || []), ...(vert.opex || [])]) {
    if (item && item.role_id) {
      roleDecisionMap.set(item.role_id, {
        ...item,
        vertical_id: vert.id,
        vertical_name_es: vert.name_es,
        vertical_name_en: vert.name_en,
      });
    }
  }
}

function mapNodeRfqHref(circuitId: string, roleId: string, en: boolean) {
  const basePath = en ? '/en/quote/' : '/cotizar/';
  if (roleId === 'skid_bomba') {
    return `${basePath}?circuito=bombeo&equipo=skid_bomba#rfq`;
  }
  const roleAliasMap: Record<string, { circuit: string; equipo: string }> = {
    impulsor: { circuit: 'bombeo', equipo: 'solo_impulsor' },
    revestimientos: { circuit: 'bombeo', equipo: 'kit_wet_end' },
    sello: { circuit: 'bombeo', equipo: 'kit_sellado' },
    celda_completa: { circuit: 'flotacion', equipo: 'celda_flotacion' },
    mecanismos_flotacion: { circuit: 'flotacion', equipo: 'rotor_estator' },
    prensa_completa: { circuit: 'filtracion', equipo: 'filtro_prensa' },
    repuestos_prensa: { circuit: 'filtracion', equipo: 'placas_telas' }
  };
  const mapped = roleAliasMap[roleId] || {
    circuit: circuitId.includes('flotacion') ? 'flotacion' : (circuitId.includes('filtracion') ? 'filtracion' : 'bombeo'),
    equipo: roleId
  };
  return `${basePath}?circuito=${mapped.circuit}&equipo=${mapped.equipo}#rfq`;
}
---

<section class="circuit-navigator-section" aria-label={isEn ? "Mining Process Circuit Navigator" : "Navegador de Circuitos de Proceso Mineral"}>
  <div class="circuit-container">
    <div class="circuit-header">
      <div class="badge-tag">
        <span class="pulse-dot"></span>
        {isEn ? "CIRCUIT-LEVEL GROUNDING & METALLURGICAL RULES" : "MAPEO DIRECTO DE PROCESO Y REGLAS METALÚRGICAS"}
      </div>
      <h2 class="circuit-title">
        {isEn ? "Select Your Plant Circuit" : "Identifique su Circuito de Planta"}
      </h2>
      <p class="circuit-lead">
        {isEn 
          ? "Map your grinding classification, flotation, or filtration equipment and wear parts with 1:1 dimensional verification in Durango." 
          : "Identifique los equipos y refacciones requeridos en su circuito de molienda, flotación o filtración con verificación dimensional 1:1 en Durango."}
      </p>

      <!-- Selector de Pestañas de Circuito -->
      <div class="circuit-tabs" role="tablist">
        {circuits.map((circ, idx) => {
          const isActive = circ.id === resolvedDefaultCircuit;
          return (
            <button 
              type="button"
              role="tab"
              class={`circuit-tab-btn ${isActive ? 'active' : ''}`}
              data-circuit-id={circ.id}
              aria-selected={isActive ? "true" : "false"}
              id={`tab-${circ.id}`}
            >
              <span class="tab-index">0{idx + 1}</span>
              <span class="tab-label">{isEn ? circ.name_en : circ.name_es}</span>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Paneles de Circuito -->
    <div class="circuit-panels">
      {circuits.map((circ) => {
        const isActive = circ.id === resolvedDefaultCircuit;
        return (
          <div 
            class={`circuit-panel ${isActive ? 'active' : ''}`}
            id={`panel-${circ.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${circ.id}`}
          >
          <div class="circuit-meta">
            <span class="circuit-subtitle-text">
              {isEn ? circ.subtitle_en : circ.subtitle_es}
            </span>
          </div>

          <!-- P&ID Schematic Vectorial Minimalista -->
          <div class="schematic-canvas">
            <div class="schematic-flow-line"></div>
            
            <div class="nodes-grid">
              {circ.nodes.map((node, nIdx) => {
                const roleMeta = roleDecisionMap.get(node.role_id);
                const criteria = roleMeta?.decision_criteria;
                return (
                <div class="node-card" data-node-id={node.id} data-role-id={node.role_id} data-circuit-id={circ.id}>
                  <div class="node-header">
                    <span class="node-badge">{nIdx + 1}</span>
                    <h3 class="node-name">{isEn ? node.name_en : node.name_es}</h3>
                  </div>

                  <div class="node-equipment">
                    <strong class="equipment-highlight">{isEn ? node.equipment_en : node.equipment_es}</strong>
                  </div>

                  <div class="node-challenge">
                    <span class="node-label-small">{isEn ? "PULP CONDITION & CHALLENGE:" : "CONDICIÓN Y RETO DE PULPA:"}</span>
                    <p class="challenge-text">{isEn ? node.challenge_en : node.challenge_es}</p>
                  </div>

                  <div class="node-solution">
                    <span class="node-label-small">{isEn ? "ENGINEERING SPECIFICATION:" : "ESPECIFICACIÓN DE INGENIERÍA:"}</span>
                    <p class="solution-text">{isEn ? node.solution_en : node.solution_es}</p>
                  </div>

                  {criteria && (
                    <div class="decision-criteria-box cn-criteria-chip" data-criteria-role={node.role_id}>
                      <span class="criteria-badge">
                        {isEn ? "METALLURGICAL RULE & SLURRY VARIABLES:" : "REGLA METALÚRGICA Y VARIABLES DE PULPA:"}
                      </span>
                      <p class="criteria-vars">
                        <strong>{isEn ? "Process Inputs:" : "Datos de Proceso:"}</strong> {isEn ? criteria.required_slurry_vars_en : criteria.required_slurry_vars_es}
                      </p>
                      <p class="criteria-rule">
                        <strong>{isEn ? "Metallurgy Rule:" : "Criterio Metalúrgico:"}</strong> {isEn ? criteria.metallurgy_rule_en : criteria.metallurgy_rule_es}
                      </p>
                      <span class="criteria-risk">
                        <strong>{isEn ? "Risk Prevented:" : "Riesgo Evitado:"}</strong> {isEn ? criteria.risk_avoided_en : criteria.risk_avoided_es}
                      </span>
                    </div>
                  )}

                  <div class="node-footer">
                    <span class="stock-badge">
                      <span class="stock-dot"></span>
                      {isEn ? node.stock_en : node.stock_es}
                    </span>
                    <div class="node-actions-group">
                      <a href={isEn ? node.link_en : node.link_es} class="node-cta node-cta-sheet">
                        {isEn ? "View Specs →" : "Ver Ficha →"}
                      </a>
                      <a
                        href={mapNodeRfqHref(circ.id, node.role_id, isEn)}
                        class="node-cta node-cta-rfq"
                        data-role-id={node.role_id}
                        data-circuit-id={circ.id}
                        data-node-name={isEn ? node.name_en : node.name_es}
                      >
                        {isEn ? "Quote" : "Cotizar"}
                      </a>
                    </div>
                  </div>
                </div>
                );
              })}
            </div>
          </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .circuit-navigator-section {
    padding: 4.5rem 1.5rem;
    background: #fafaf9;
    border-top: 1px solid var(--smat-border-light);
    border-bottom: 1px solid var(--smat-border-light);
  }

  .circuit-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .circuit-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 2.5rem;
  }

  .badge-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.85rem;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    border-radius: var(--smat-radius-pill);
    color: #9a3412;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--smat-font-mono);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: #c25e00;
    border-radius: 50%;
  }

  .circuit-title {
    font-size: 2.15rem;
    color: #090d16;
    line-height: 1.25;
    margin-bottom: 0.85rem;
  }

  .circuit-lead {
    font-size: 1.05rem;
    color: #475569;
    line-height: 1.6;
  }

  .circuit-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .circuit-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.35rem;
    background: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: var(--smat-radius-md);
    color: #334155;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .circuit-tab-btn:hover {
    background: #f1f5f9;
    color: #090d16;
    border-color: #cbd5e1;
  }

  .circuit-tab-btn.active {
    background: #0b132b;
    color: #ffffff;
    border-color: #0b132b;
    box-shadow: 0 4px 12px rgba(11, 19, 43, 0.2);
  }

  .tab-index {
    font-family: var(--smat-font-mono);
    font-size: 0.75rem;
    opacity: 0.85;
  }

  .circuit-panel {
    display: none;
    animation: fadeIn 0.3s ease;
  }

  .circuit-panel.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .circuit-meta {
    background: #ffffff;
    border-left: 3px solid #c25e00;
    border: 1px solid var(--smat-border-light);
    border-left-width: 4px;
    padding: 1rem 1.5rem;
    border-radius: var(--smat-radius-sm);
    margin-bottom: 2rem;
    box-shadow: var(--smat-shadow-sm);
  }

  .circuit-subtitle-text {
    font-size: 0.98rem;
    color: #334155;
    font-style: italic;
  }

  .nodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .node-card {
    background: #ffffff;
    border: 1px solid var(--smat-border-light);
    border-radius: var(--smat-radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    box-shadow: var(--smat-shadow-card);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .node-card:hover {
    transform: translateY(-2px);
    border-color: #cbd5e1;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
  }

  .node-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .node-badge {
    width: 24px;
    height: 24px;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    border-radius: 50%;
    color: #c25e00;
    font-size: 0.75rem;
    font-weight: 800;
    font-family: var(--smat-font-mono);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node-name {
    font-size: 1rem;
    font-weight: 700;
    color: #090d16;
    margin: 0;
  }

  .node-equipment {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--smat-border-light);
  }

  .equipment-highlight {
    color: #0b132b;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .node-label-small {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .challenge-text, .solution-text {
    font-size: 0.88rem;
    color: #334155;
    line-height: 1.5;
    margin: 0;
  }

  .node-footer {
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--smat-border-light);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .stock-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: #065f46;
    font-weight: 700;
    font-family: var(--smat-font-mono);
  }

  .stock-dot {
    width: 6px;
    height: 6px;
    background-color: #10b981;
    border-radius: 50%;
  }

  .node-actions-group {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .node-cta {
    display: inline-block;
    text-align: center;
    padding: 0.45rem 0.75rem;
    border-radius: var(--smat-radius-sm);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .node-cta-sheet {
    background: #f8fafc;
    border: 1px solid var(--smat-border-light);
    color: #334155;
  }

  .node-cta-sheet:hover {
    background: #f1f5f9;
    color: #090d16;
  }

  .node-cta-rfq {
    background: #7c2d12;
    border: 1px solid #7c2d12;
    color: #ffffff;
  }

  .node-cta-rfq:hover {
    background: #60220d;
  }

  .decision-criteria-box {
    background: #fffaf5;
    border: 1px solid #fed7aa;
    border-left: 3px solid #c25e00;
    border-radius: 6px;
    padding: 0.65rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .criteria-badge {
    font-family: var(--smat-font-mono);
    font-size: 0.66rem;
    font-weight: 800;
    color: #9a3412;
    letter-spacing: 0.04em;
  }

  .criteria-vars,
  .criteria-rule {
    font-size: 0.76rem;
    color: #334155;
    line-height: 1.4;
    margin: 0;
  }

  .criteria-risk {
    font-size: 0.74rem;
    color: #065f46;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    padding: 0.3rem 0.45rem;
    border-radius: 4px;
    font-weight: 600;
    line-height: 1.35;
  }

  .node-card.role-card-highlighted {
    border-color: #c25e00;
    box-shadow: 0 0 0 2px rgba(194, 94, 0, 0.18);
  }
</style>

<script>
  import { publishWorkbenchUpdate, subscribeWorkbenchUpdate, loadWorkbenchState } from '../scripts/workbenchBus.js';

  function mapShortCircuitToNavigatorId(shortCircuit: string): string {
    if (shortCircuit === 'flotacion' || shortCircuit === 'flotacion_polimetalica') return 'flotacion_polimetalica';
    if (shortCircuit === 'filtracion' || shortCircuit === 'jales_filtracion') return 'jales_filtracion';
    return 'bombeo_ciclones';
  }

  function mapNavigatorIdToShortCircuit(navId: string): string {
    if (navId.includes('flotacion')) return 'flotacion';
    if (navId.includes('filtracion')) return 'filtracion';
    return 'bombeo';
  }

  function setupCircuitTabs() {
    const tabButtons = document.querySelectorAll('.circuit-tab-btn');
    const panels = document.querySelectorAll('.circuit-panel');
    const allNodes = document.querySelectorAll('.circuit-navigator-section .node-card');

    function activateCircuitTab(targetId: string, emit = false) {
      if (!targetId) return;
      tabButtons.forEach(b => {
        const isMatch = b.getAttribute('data-circuit-id') === targetId;
        b.classList.toggle('active', isMatch);
        b.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });
      panels.forEach(p => {
        p.classList.toggle('active', p.id === `panel-${targetId}`);
      });
      if (emit) {
        publishWorkbenchUpdate({
          circuit: mapNavigatorIdToShortCircuit(targetId),
          source: 'CircuitNavigator'
        });
      }
    }

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-circuit-id') || 'bombeo_ciclones';
        activateCircuitTab(targetId, true);
      });
    });

    document.querySelectorAll('.node-cta-rfq').forEach(btn => {
      btn.addEventListener('click', () => {
        const role = btn.getAttribute('data-role-id') || '';
        const navCircuit = btn.getAttribute('data-circuit-id') || 'bombeo_ciclones';
        publishWorkbenchUpdate({
          circuit: mapNavigatorIdToShortCircuit(navCircuit),
          role,
          source: 'CircuitNavigator'
        });
      });
    });

    subscribeWorkbenchUpdate((detail: any) => {
      if (!detail || detail.source === 'CircuitNavigator') return;
      if (detail.circuit) {
        activateCircuitTab(mapShortCircuitToNavigatorId(detail.circuit), false);
      }
      if (detail.role) {
        allNodes.forEach(card => {
          const isMatch = card.getAttribute('data-role-id') === detail.role;
          card.classList.toggle('role-card-highlighted', isMatch);
        });
      }
    });

    const initialCtx: any = loadWorkbenchState();
    if (initialCtx && initialCtx.role) {
      allNodes.forEach(card => {
        const isMatch = card.getAttribute('data-role-id') === initialCtx.role;
        card.classList.toggle('role-card-highlighted', isMatch);
      });
    }
  }

  setupCircuitTabs();
  document.addEventListener('astro:page-load', setupCircuitTabs);
</script>
