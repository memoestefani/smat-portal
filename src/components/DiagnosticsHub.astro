      padding: 0.5rem 0.75rem;
      font-size: 0.72rem;
    }
    .diag-search-count {
      display: none;
    }
  }
</style>

<script>
  import { saveWorkbenchState, loadWorkbenchState } from '../scripts/workbenchBus.js';
  import { saveEngineeringContextSnapshot } from '../scripts/rfqSessionStore.js';
  import { bindAtomicPartTrayButtons } from '../scripts/verticalStateAndCtaSyncBridge.js';

  function initDiagFilters() {
    bindAtomicPartTrayButtons(document);
    const filterSelect = document.getElementById('diag-category-filter') as HTMLSelectElement | null;
    const pills = document.querySelectorAll<HTMLButtonElement>('.diag-pill');
    const cards = document.querySelectorAll<HTMLElement>('.diag-card');
    const countEl = document.getElementById('diag-search-count');
    const isEnDiag = document.documentElement.lang === 'en';

    const applyDiagFilter = (filter: string) => {
      let visible = 0;

      cards.forEach(card => {
        const tags = card.getAttribute('data-tags') || card.textContent?.toLowerCase() || '';
        if (filter === 'all') {
          card.style.display = '';
          visible++;
        } else if (filter === 'impulsor' && (tags.includes('impulsor') || tags.includes('álabes') || tags.includes('impeller'))) {
          card.style.display = '';
          visible++;
        } else if (filter === 'cavitacion' && (tags.includes('cavitación') || tags.includes('cavitacion') || tags.includes('ruido') || tags.includes('cavitation'))) {
          card.style.display = '';
          visible++;
        } else if (filter === 'fuga' && (tags.includes('fuga') || tags.includes('prensaestopa') || tags.includes('sello') || tags.includes('leak'))) {
          card.style.display = '';
          visible++;
        } else if (filter === 'vibracion' && (tags.includes('vibración') || tags.includes('vibracion') || tags.includes('eje') || tags.includes('flecha') || tags.includes('bearing'))) {
          card.style.display = '';
          visible++;
        } else if (filter === 'rotor' && (tags.includes('rotor') || tags.includes('flotación') || tags.includes('flotacion') || tags.includes('flotation'))) {
          card.style.display = '';
          visible++;
        } else if (filter === 'filtro' && (tags.includes('filtro') || tags.includes('tela') || tags.includes('prensa') || tags.includes('cloth'))) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countEl) {
        if (filter === 'all') {
          countEl.textContent = isEnDiag ? 'Showing all diagnostics' : 'Mostrando todos los diagnósticos';
        } else {
          countEl.textContent = isEnDiag
            ? `${visible} filtered diagnostic(s)`
            : `${visible} diagnóstico(s) filtrado(s)`;
        }
      }
    };

    filterSelect?.addEventListener('change', () => {
      applyDiagFilter(filterSelect.value || 'all');
    });

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => {
          p.classList.remove('active');
          p.setAttribute('aria-pressed', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-pressed', 'true');
        applyDiagFilter(pill.getAttribute('data-filter') || 'all');
      });
    });

    // Conexión fluida con el cotizador (Decisión 6 & 9-C + V4.5 Engineering Context Mirror)
    const quoteBtns = document.querySelectorAll<HTMLAnchorElement>('.diag-quote-btn');
    quoteBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const claroMm = Number(btn.getAttribute('data-claro-mm')) || 0.75;
        const symptom = btn.getAttribute('data-symptom') || '';
        const material = btn.getAttribute('data-material') || '';
        const station = btn.getAttribute('data-station') || '';
        const role = btn.getAttribute('data-role') || '';
        const prev: Record<string, any> = loadWorkbenchState() || {};
        saveWorkbenchState({
          ...prev,
          frontClearanceMm: claroMm,
          claro_mm: claroMm,
          stressSymptom: symptom,
          sintoma: symptom,
          material: material || prev.material,
          estacion: station || prev.estacion,
          equipo: role || prev.equipo
        });
        saveEngineeringContextSnapshot('bombeo', {
          source: 'diagnostics_hub',
          frontClearanceMm: claroMm,
          stressSymptom: symptom,
          material: material || prev.material,
          station: station || prev.estacion,
          role: role || prev.equipo
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDiagFilters);
  } else {
    initDiagFilters();
  }
  document.addEventListener('astro:page-load', initDiagFilters);
</script>
